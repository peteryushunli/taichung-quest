Taichung_Text_Welcome::
	.string "Welcome to TAICHUNG!\n"
	.string "Your city adventure starts here.$"

Taichung_Text_ChooseStarter::
	.string "Choose one POKéMON partner.\n"
	.string "Then explore at your own pace.$"

Taichung_Text_StarterChosen::
	.string "{STR_VAR_1} is your partner!\n"
	.string "Your BAG has supplies. Let's go!$"

Taichung_Text_TeaRequest::
	.string "A sunny day calls for iced tea!\p"
	.string "Could you take this tea parcel\n"
	.string "to the GREENWAY GUIDE?\p"
	.string "She's by the flowers in the\n"
	.string "southwest garden.$"

Taichung_Text_TeaAccepted::
	.string "You tuck the tea parcel away.\p"
	.string "Follow the path south, then\n"
	.string "look for the guide by the flowers.\p"
	.string "Take your time. This is TAICHUNG!$"

Taichung_Text_TeaDeclined::
	.string "No rush! Come back when you've\n"
	.string "had a look around the Greenway.$"

Taichung_Text_TeaReminder::
	.string "The GREENWAY GUIDE is waiting\n"
	.string "in the southwest flower garden.\p"
	.string "Her tea is in your parcel!$"

Taichung_Text_TeaThanks::
	.string "The guide loved her tea!\p"
	.string "Good tea, green streets, and\n"
	.string "POKéMON. A lovely TAICHUNG day.$"

Taichung_Text_GuideWaiting::
	.string "Welcome to CALLIGRAPHY GREENWAY!\p"
	.string "I'm waiting for my afternoon tea.\n"
	.string "The TEA HOUSE is northeast.\p"
	.string "Say hello to the vendor for me!$"

Taichung_Text_GuideThanks::
	.string "My tea! Thank you for bringing\n"
	.string "a little kindness down the path.\p"
	.string "Here, a POTION for your buddy.$"

Taichung_Text_QuestComplete::
	.string "GREENWAY DELIVERY complete!\n"
	.string "You received a POTION.\p"
	.string "Ready for an encounter? Head\n"
	.string "north to the tall grass.$"

Taichung_Text_BagFull::
	.string "Your BAG is full. Make room\n"
	.string "for a POTION and come back!$"

Taichung_Text_GuideDone::
	.string "The northern path leads to\n"
	.string "wild POKéMON in the tall grass.\p"
	.string "Weaken one, then choose a\n"
	.string "POKé BALL from your BAG.\p"
	.string "Press START to save your walk.$"

Taichung_Text_FieldStation::
	.string "GREENWAY FIELD STATION\n"
	.string "OAK's POKéMON research outpost$"

Taichung_Text_GuestHouse::
	.string "GREENWAY GUEST HOUSE\n"
	.string "A little rest for every traveler$"

Taichung_Text_TeaHouse::
	.string "TAICHUNG TEA HOUSE\n"
	.string "Slow down. Have a little tea.$"

Taichung_Text_TownSign::
	.string "TAICHUNG - WEST DISTRICT\n"
	.string "Follow the green, find your story.$"

Taichung_Text_GreenwaySign::
	.string "CALLIGRAPHY GREENWAY\n"
	.string "Walk, wander, and say hello.\p"
	.string "TEA HOUSE: northeast\n"
	.string "GREENWAY GUIDE: southwest$"

Taichung_Text_LanguagePrompt::
	.string "Language / 語言\n"
	.string "Choose English or 繁體中文.$"

Taichung_Text_LanguageChanged::
	.string "Language set to English.\n"
	.string "Change it from the START menu.$"
