+#!/usr/bin/env python3
+"""Check source/draft separation and reciprocal section-port sizing contracts."""
+import argparse
+import json
+from pathlib import Path
+
+
+def require(ok,message):
+    if not ok:raise SystemExit('GEOGRAPHY DRAFT FAILED: '+message)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--draft',type=Path,default=Path('docs/city-v2-streets.json'))
+    p.add_argument('--baseline-contract',type=Path,default=Path('docs/taichung-city-contract.json'))
+    args=p.parse_args();d=json.loads(args.draft.read_text());base=json.loads(args.baseline_contract.read_text())
+    require(len(d['sections'])==16,'Expected provisional4×4 sections')
+    require({g['id'] for g in d['landmarks']}=={g['id'] for g in base['landmarks']},'Approved10-gym IDs differ from native baseline')
+    baseline={g['id']:g for g in base['landmarks']}
+    for gym in d['landmarks']:
+        require(gym['authoredGameEntrance'] is None,'GPS point promoted prematurely to game entrance')
+        native=gym['baselineNative'];actual=baseline[gym['id']]
+        require(native['exteriorMap']==actual['exteriorMap'] and native['entrance']==actual['entrance'] and native['arrival']==actual['arrival'],'Existing native entrance/arrival altered')
+    sections={s['id']:s for s in d['sections']}
+    for s in sections.values():
+        require(s['nativeMapId'] is None and not s['nativeMapRegistration'],'Draft registered a native map')
+        require((s['width']+15)*(s['height']+14)<=0x2800,'Section exceeds current native virtual-map buffer')
+    south,west,north,east=d['coordinateContract']['wgs84BoundsSWNE']
+    for street in d['streets']:
+        require(street['sourceLayer']=='R0002','Unexpected unsourced street layer')
+        require(street['authoredGameCenterline'] is None,'Raw source trace is mislabeled final game route')
+        for lon,lat in street['sourceGeometryWgs84']:
+            require(west-1e-6<=lon<=east+1e-6 and south-1e-6<=lat<=north+1e-6,'Source trace escaped clipping bounds')
+        require(all(0<=x<=256 and 0<=y<=256 for x,y in street['projectedCenterline']),'Projected trace outside world')
+    for port in d['seamCandidates']:
+        require(port['fromSection'] in sections and port['toSection'] in sections,'Port links nonexistent section')
+        a,b=sections[port['fromSection']],sections[port['toSection']]
+        x,y=port['fromLocalCenter'];u,v=port['toLocalCenter']
+        if port['direction']=='right':
+            require(a['gridRow']==b['gridRow'] and a['gridCol']+1==b['gridCol'] and x==63 and u==0 and y==v,'Horizontal seam mismatch')
+        else:
+            require(a['gridCol']==b['gridCol'] and a['gridRow']+1==b['gridRow'] and y==63 and v==0 and x==u,'Vertical seam mismatch')
+        require(port['nativeConnectionOffset']==0,'Aligned64×64 draft should use zero connection offset')
+    for lot in d['unpaintedLotCandidates']:
+        s=sections[lot['section']];x,y=lot['localOrigin']
+        require(0<=x and 0<=y and x+lot['width']<=64 and y+lot['height']<=64,'Lot outside section')
+        require(lot['sourceBuildingId'] is None and lot['selectedPrefabId'] is None,'Candidate lot presented as real/final building')
+    require(len(d['landmarkReserveConflicts'])>=1,'Uniform projection unexpectedly concealed landmark footprint pressure')
+    require(any(m['layer']=='waterway geometry' for m in d['missingLayers']),'Missing water geometry not disclosed')
+    require(any(m['layer']=='rail centerlines' for m in d['missingLayers']),'Missing rail geometry not disclosed')
+    print(f"GEOGRAPHY DRAFT PASSED: {len(sections)} sections, {len(d['streets'])} sourced road parts, {len(d['seamCandidates'])} reciprocal port candidates,10 preserved gym IDs.")
+
+
+if __name__=='__main__':main()
