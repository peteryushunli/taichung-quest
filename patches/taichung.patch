+    sStartup = startup;
+    sCursor = 2; // A single A accepts the current/default pair.
+    for (setting = 0; setting < TAICHUNG_EXPLORATION_SETTING_COUNT; setting++)
+        sModes[setting] = TaichungExplorationGetMode(setting);
