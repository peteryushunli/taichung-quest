@@ -0,0 +1,25 @@
+#include "global.h"
+#include "event_data.h"
+#include "string_util.h"
+#include "taichung_landmark_gym.h"
+#include "taichung_language.h"
+
+void TaichungGym_ScriptConsumeLandmarkLossNotice(void)
+{
+    gSpecialVar_Result = TaichungGymConsumeLossNotice(gSpecialVar_0x8004);
+}
+
+void TaichungGymCopyLandmarkMessage(u16 gymId, const u8 *const messages[][2])
+{
+    u16 message = gSpecialVar_0x8005;
+    if (message > TAICHUNG_GYM_MESSAGE_LOSS)
+        message = TAICHUNG_GYM_MESSAGE_UNAVAILABLE;
+    if (message == TAICHUNG_GYM_MESSAGE_COMPLETE
+     && (TaichungGymGetLastResult() != TAICHUNG_GYM_RESULT_WON
+      || !TaichungGymIsComplete(gymId)))
+        message = TAICHUNG_GYM_MESSAGE_NOT_RECORDED;
+    if (message == TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE
+     && !TaichungGymIsComplete(gymId))
+        message = TAICHUNG_GYM_MESSAGE_NOT_RECORDED;
+    StringCopy(gStringVar4, TaichungText(messages[message][0], messages[message][1]));
+}
