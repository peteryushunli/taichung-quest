+#!/usr/bin/env python3
+"""Compile shared-bank roof colorways into native indexed graphics/metatiles."""
+import argparse
+from copy import deepcopy
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image
+
+from library import ROOT,Library,parse_words,require
+
+
+def flip(pixels,h=False,v=False):
+    return tuple(pixels[(7-y if v else y)*8+(7-x if h else x)] for y in range(8) for x in range(8))
+
+
+def compile_colorways(source=ROOT,catalog=None,colorways=None,variant_metatile_start=None):
+    """Return encodable bank arrays; caller owns final native registration/merging.
+
+    graphics are64 indexed pixels each; entries contain global graphics IDs.
+    secondary metatile IDs preserve the original source-entry range. The
+    variant start can be moved by the integrator to avoid landmark allocations.
+    """
+    library=Library(source,catalog or ROOT/'data/taichung/prefabs/catalog.json');library.validate()
+    recipe=json.loads(Path(colorways or ROOT/'data/taichung/prefabs/colorways.json').read_text())
+    images=[Image.open(Path(source)/'data/tilesets'/folder/'tiles.png') for folder in ('primary/general','secondary/pewter_city')]
+    def source_pixels(graphic):
+        bank,n=(0,graphic) if graphic<640 else (1,graphic-640)
+        sx,sy=n%16*8,n//16*8
+        return tuple(images[bank].getpixel((sx+x,sy+y)) for y in range(8) for x in range(8))
+    graphics=[];graphic_lookup={};source_graphics={}
+    def pack(pixels):
+        variants=[(pixels,0),(flip(pixels,True),0x400),(flip(pixels,False,True),0x800),(flip(pixels,True,True),0xc00)]
+        canonical,flags=min(variants,key=lambda p:(p[0],p[1]))
+        if canonical not in graphic_lookup:
+            graphic_lookup[canonical]=len(graphics);graphics.append(canonical)
+        return 640+graphic_lookup[canonical],flags
+    def base_entry(entry):
+        graphic=entry&0x3ff
+        if graphic<640:return entry
+        new,flags=pack(source_pixels(graphic));source_graphics[str(graphic-640)]=new-640
+        return new|((entry&0xc00)^flags)|(entry&0xf000)
+    used=set(w&0x3ff for p in library.prefabs.values() for row in parse_words(p) for w in row)
+    count=len(library.attributes[1]);metatiles=[[0]*8 for _ in range(count)];attributes=[0]*count
+    for tile in sorted(t for t in used if t>=640):
+        i=tile-640;metatiles[i]=[base_entry(e) for e in library.metatiles[1][i*8:i*8+8]];attributes[i]=library.attributes[1][i]
+    base_graphics_count=len(graphics)
+    palettes=[]
+    for bank in range(13):
+        folder='primary/general' if bank<7 else 'secondary/pewter_city'
+        lines=(Path(source)/'data/tilesets'/folder/'palettes'/f'{bank:02}.pal').read_text().splitlines()[3:]
+        palettes.append([tuple(map(int,line.split())) for line in lines if line.strip()])
+    palette12=[tuple(item['rgb8']) for item in recipe['palette']]
+    require(len(palette12)==16 and all(all(0<=v<=248 and v%8==0 for v in c) for c in palette12),'Palette12 must be exactly16 native5-bit-aligned colors')
+    palettes[12]=palette12
+    source_material=recipe['sourceMaterial'];shades=source_material['sourceShadeIndicesLightToDark'];allowed=set(source_material['allowedSourcePixelIndices'])
+    def recolorable(entry):
+        colors=set(source_pixels(entry&0x3ff))
+        return entry>>12 in source_material['sourcePaletteBanks'] and colors<=allowed and bool(colors&set(shades))
+    eligible=set()
+    for identity in recipe['eligiblePrefabs']:
+        for y,row in enumerate(parse_words(library.prefabs[identity])):
+            if y not in recipe['roofRows']:continue
+            for word in row:
+                tile=word&0x3ff;bank,index=(0,tile) if tile<640 else (1,tile-640)
+                if any(recolorable(e) for e in library.metatiles[bank][index*8:index*8+8]):eligible.add(tile)
+    start=variant_metatile_start if variant_metatile_start is not None else 640+len(metatiles)
+    require(start>=640+len(metatiles),'Variant metatiles overlap source range')
+    while len(metatiles)<start-640:metatiles.append([0]*8);attributes.append(0)
+    remaps={};variant_entries={};source_roof_graphics=set()
+    for family,ramp in recipe['families'].items():
+        mapping={int(k):v for k,v in source_material['neutralIndexRemap'].items()};mapping.update(zip(shades,ramp));remaps[family]={}
+        for tile in sorted(eligible):
+            bank,index=(0,tile) if tile<640 else (1,tile-640);entries=[]
+            for entry in library.metatiles[bank][index*8:index*8+8]:
+                if recolorable(entry):
+                    source_roof_graphics.add(entry&0x3ff)
+                    pixels=tuple(mapping[i] for i in source_pixels(entry&0x3ff));g,flags=pack(pixels)
+                    entries.append(g|((entry&0xc00)^flags)|(recipe['paletteBank']<<12))
+                else:entries.append(base_entry(entry))
+            new=640+len(metatiles);metatiles.append(entries);attributes.append(library.attr(tile));remaps[family][tile]=new
+            variant_entries[new]=dict(sourceMetatile=tile,colorway=family)
+    require(len(graphics)<=384,'Combined source/roof graphics exceed384 secondary slots')
+    require(len(metatiles)<=384,'Combined source/roof metatiles exceed384 secondary slots')
+    budget=dict(primaryGraphicsUnchanged=640,sourceKitGraphicsAfterFlipDedup=base_graphics_count,
+        sourceRoofGraphics=len(source_roof_graphics),coloredRoofGraphicsAdded=len(graphics)-base_graphics_count,
+        secondaryGraphicsTotal=len(graphics),secondaryGraphicsCapacity=384,
+        secondaryMetatiles=len(metatiles),newColorMetatiles=len(variant_entries),paletteBank=12,
+        sourceGraphicsIndexMap=source_graphics,
+        colorMetatileRemaps={name:{f'0x{k:03X}':f'0x{v:03X}' for k,v in mapping.items()} for name,mapping in remaps.items()})
+    return dict(library=library,recipe=recipe,graphics=graphics,metatiles=metatiles,attributes=attributes,
+        palettes=palettes,remaps=remaps,budget=budget)
+
+
+def color_grid(compiled,composition,placements):
+    """Keep source collision/apron semantics; change only selected roof IDs."""
+    words=composition['words'][:];library=compiled['library'];recipe=compiled['recipe']
+    for placement in placements:
+        family=placement.get('colorway');identity=placement['prefab']
+        if not family or family=='source':continue
+        require(family in compiled['remaps'] and identity in recipe['eligiblePrefabs'],f'Unsupported colorway:{identity}/{family}')
+        p=library.prefabs[identity]
+        for y,row in enumerate(parse_words(p)):
+            if y not in recipe['roofRows']:continue
+            for x,source in enumerate(row):
+                tile=source&0x3ff;new=compiled['remaps'][family].get(tile)
+                if new is not None and p['masks']['paint'][y][x]=='1':
+                    i=(placement['y']+y)*composition['width']+placement['x']+x
+                    words[i]=(words[i]&0xfc00)|new
+    return words
+
+
+def native_tile_images(compiled,needed=None):
+    """Render indexed native data, including tile flips and palette references."""
+    library=compiled['library'];images=[Image.open(library.source/'data/tilesets'/folder/'tiles.png') for folder in ('primary/general','secondary/pewter_city')]
+    def pixels(g):
+        if g>=640:return compiled['graphics'][g-640]
+        sx,sy=g%16*8,g//16*8
+        return tuple(images[0].getpixel((sx+x,sy+y)) for y in range(8) for x in range(8))
+    if needed is None:
+        needed={w&0x3ff for p in library.prefabs.values() for row in parse_words(p) for w in row}|{1,0x175}
+        needed|={v for mapping in compiled['remaps'].values() for v in mapping.values()}
+    tiles={}
+    for tile in sorted(needed):
+        entries=library.metatiles[0][tile*8:tile*8+8] if tile<640 else compiled['metatiles'][tile-640]
+        image=Image.new('RGB',(16,16))
+        for layer in range(2):
+            for q in range(4):
+                entry=entries[layer*4+q];data=pixels(entry&0x3ff);palette=compiled['palettes'][entry>>12]
+                for y in range(8):
+                    for x in range(8):
+                        index=data[(7-y if entry&0x800 else y)*8+(7-x if entry&0x400 else x)]
+                        if index or layer==0:image.putpixel((q%2*8+x,q//2*8+y),palette[index])
+        tiles[tile]=image
+    return tiles
+
+
+def save_native(compiled,out):
+    out=Path(out);out.mkdir(parents=True,exist_ok=True)
+    pixels=compiled['graphics'];raw=bytes(row[i]|row[i+1]<<4 for row in pixels for i in range(0,64,2))
