@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""One progressive, game-scale block study with native indexed roof colorways."""
+import argparse
+from collections import deque
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image,ImageDraw
+
+from color_compile import compile_colorways,color_grid,native_tile_images,save_native
+from library import ROOT,WALK,require
+
+
+def pilot_plan():
+    return dict(schemaVersion=1,status='single unregistered source block study; palette-index colors; not installed in ROM',
+        width=32,height=24,profileId='city-v2-r2-c2',archetype='old-mixed-residential',spawn=[29,14],
+        exits=[[0,13],[31,13],[29,0],[29,23]],
+        groundRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,16,26,23]],
+        protectedRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,23,31,23],[0,0,0,23],[31,0,31,23]],
+        placements=[
+            dict(id='old-home-a',prefab='building-rowhouse-compact',x=1,y=0,colorway='terracotta',context='residential'),
+            dict(id='old-home-b',prefab='building-rowhouse-compact',x=7,y=0,colorway='source',context='residential'),
+            dict(id='old-home-c',prefab='building-rowhouse-compact',x=13,y=0,colorway='slate',context='residential'),
+            dict(id='old-home-pair',prefab='building-rowhouse-pair',x=1,y=6,colorway='terracotta',context='residential'),
+            dict(id='old-home-d',prefab='building-rowhouse-compact',x=13,y=6,colorway='source',context='residential'),
+            dict(id='new-walkup',prefab='building-walkup-tall',x=21,y=2,colorway='teal',context='residential'),
+            dict(id='shop-corner',prefab='building-corner-store',x=1,y=18,colorway='mustard',context='shopping'),
+            dict(id='shop-wide',prefab='building-shopfront-wide',x=8,y=17,colorway='source',context='shopping'),
+            dict(id='market-a',prefab='stall-market-red',x=17,y=19,colorway='source',context='market'),
+            dict(id='market-b',prefab='stall-market-red',x=22,y=19,colorway='source',context='market'),
+            dict(id='front-lawn-shrub',prefab='prop-shrub',x=19,y=0,context='residential'),
+            dict(id='side-lawn-shrub',prefab='prop-shrub',x=26,y=1,context='residential'),
+            dict(id='front-flowers',prefab='prop-flower-bed',x=19,y=10,context='residential'),
+            dict(id='corner-sign',prefab='prop-sign-board',x=26,y=10,context='street')])
+
+
+def make_pilot(compiled,plan):
+    width,height=plan['width'],plan['height'];base=[0x3001]*(width*height);protected=set()
+    for x0,y0,x1,y1 in plan['groundRects']:
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):base[y*width+x]=0x3175
+    for x0,y0,x1,y1 in plan['protectedRects']:
+        protected|={(x,y) for y in range(y0,y1+1) for x in range(x0,x1+1)}
+    source_placements=[{k:v for k,v in p.items() if k!='colorway'} for p in plan['placements']]
+    composed=compiled['library'].compose(width,height,source_placements,base=base,protected_paths=protected)
+    words=color_grid(compiled,composed,plan['placements'])
+    def attr(word):
+        t=word&1023
+        return compiled['library'].attr(t) if t<640 else compiled['attributes'][t-640]
+    def walk(x,y):
+        if not(0<=x<width and 0<=y<height):return False
+        w=words[y*width+x]
+        return not w&0xc00 and w>>12==3 and attr(w)&0x1ff in WALK
+    spawn=tuple(plan['spawn']);seen={spawn};queue=deque([spawn]);require(walk(*spawn),'Player reference is not on clear ground')
+    while queue:
+        x,y=queue.popleft()
+        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
+            n=(x+dx,y+dy)
+            if n not in seen and walk(*n):seen.add(n);queue.append(n)
+    for exit in plan['exits']:require(tuple(exit) in seen,f'Blocked pilot egress:{exit}')
+    for e in composed['entrances']:
+        require(e['status']=='dormant-reservation','Pilot cannot contain an active unregistered door')
+        require(tuple(e['southApproach']) in seen,f'Unreachable building approach:{e}')
+    for i,w in enumerate(words):
+        require((w&0xfc00)==(composed['words'][i]&0xfc00),'Coloring changed collision/elevation')
+        require(attr(w)&0x1ff not in range(0x60,0x70),'Pilot contains accidental warp behavior')
+    colors=sorted({p['colorway'] for p in plan['placements'] if p.get('colorway') not in (None,'source')})
+    require({'terracotta','teal','mustard'}<=set(colors),'Pilot needs three new material colors simultaneously')
+    result=dict(result='pass',dimensions=[width,height],reachableCells=len(seen),solidCells=composed['solidCells'],
+        exits=plan['exits'],reservedEntrances=len(composed['entrances']),colorwaysSimultaneous=colors,
+        profileId=plan['profileId'],status='source fixture checked; native ROM registration/playtest remains with mapping integrator',
+        nativeBankBudget=compiled['budget'])
+    return words,result
+
+
+def player_reference(source):
+    path=Path(source)/'graphics/object_events/pics/people/red_normal.png'
+    palette_path=Path(source)/'graphics/object_events/palettes/player.pal'
+    if not(path.exists() and palette_path.exists()):return None
+    source_image=Image.open(path);palette=[tuple(map(int,s.split())) for s in palette_path.read_text().splitlines()[3:] if s.strip()]
+    image=Image.new('RGBA',(16,32))
+    for y in range(32):
+        for x in range(16):
+            i=source_image.getpixel((x,y))
+            if i:image.putpixel((x,y),(*palette[i],255))
+    return image
+
+
+def write_pilot(output):
+    output=Path(output);output.mkdir(parents=True,exist_ok=True)
+    compiled=compile_colorways();plan=pilot_plan();words,validation=make_pilot(compiled,plan)
+    tiles=native_tile_images(compiled,{w&1023 for w in words});image=Image.new('RGB',(32*16,24*16))
+    for i,w in enumerate(words):image.paste(tiles[w&1023],(i%32*16,i//32*16))
+    player=player_reference(compiled['library'].source)
+    if player:
+        x,y=plan['spawn'];image.paste(player,(x*16,y*16-16),player)
+    image.save(output/'pilot-block-native.png')
+    # The frame is an engineering caption; the inner map is exact native pixels.
+    board=Image.new('RGB',(image.width*2,image.height*2+96),'#e9efeb');board.paste(image.resize((image.width*2,image.height*2),Image.Resampling.NEAREST),(0,64))
+    draw=ImageDraw.Draw(board);draw.text((12,10),'OLD CORE BLOCK STUDY / actual indexed roof colors / source prefabs',fill='#18382d')
+    draw.text((12,28),'Older homes + new walk-up above; close retail and market frontage below. Player is a native16x32 scale reference.',fill='#36594b')
+    draw.text((12,46),'32x24 metatiles. Preview only; regional profile weights are authored, not a parcel survey.',fill='#36594b')
+    draw.text((12,board.height-24),'One palette12 supports terracotta / teal / mustard / slate together; existing blue / red / cream remain.',fill='#36594b')
+    board.save(output/'pilot-block-overview.png')
+    # A native-resolution camera crop for scale, rather than a fabricated emulator frame.
+    image.crop((11*16,8*16,26*16,18*16)).save(output/'pilot-camera-crop-240x160.png')
+    (output/'pilot-map.bin').write_bytes(struct.pack(f'<{len(words)}H',*words))
+    (output/'pilot-plan.json').write_text(json.dumps(plan,indent=2)+'\n')
+    profile=ROOT/'data/taichung/neighborhoods/pilot-profile.json'
+    validation['sourceProfile']=str(profile.relative_to(ROOT)) if profile.exists() else None
+    if profile.exists():validation['authoredProfileTargets']=json.loads(profile.read_text())['section']['authoredVisualTargets']
+    (output/'pilot-validation.json').write_text(json.dumps(validation,indent=2)+'\n')
+    save_native(compiled,output/'native-color-bank')
+    print(json.dumps({k:v for k,v in validation.items() if k not in ('nativeBankBudget','authoredProfileTargets')},indent=2))
+    print(output/'pilot-block-overview.png')
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--output',type=Path,required=True);args=parser.parse_args();write_pilot(args.output)
