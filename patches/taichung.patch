@@ -0,0 +1,81 @@
+"""Taichung Park's stone landing and railings, drawn on the native tile grid."""
+
+from PIL import Image, ImageDraw
+
+
+PLATFORM = (326, 76, 339, 85)
+CAUSEWAY = (331, 84, 334, 91)
+SIGN_TILE = (331, 82)
+TILE = 16
+
+DARK = "#404868"
+SHADOW = "#585870"
+MORTAR = "#787880"
+STONE = "#90a0b0"
+PALE = "#c8d8e8"
+CAP = "#e0e8f8"
+
+
+def draw_deck(paving):
+    x0, y0, x1, y1 = PLATFORM
+    width = (x1 - x0) * TILE
+    height = (CAUSEWAY[3] - y0) * TILE
+    walk_left = (CAUSEWAY[0] - x0) * TILE
+    walk_right = (CAUSEWAY[2] - x0) * TILE
+    left, right = 3, width - 4
+    top = 3
+    rail_y = (y1 - y0 - 1) * TILE + 3
+    lip = rail_y + 6
+
+    deck = Image.new("RGBA", (width, height))
+    draw = ImageDraw.Draw(deck)
+    foundation = [
+        (left + 3, top), (right - 3, top), (right, top + 3),
+        (right, lip + 2), (right - 3, lip + 5), (left + 3, lip + 5),
+        (left, lip + 2), (left, top + 3),
+    ]
+    draw.polygon(foundation, fill=DARK)
+    draw.rectangle((left + 2, top + 2, right - 2, lip), fill=STONE)
+    for y in range(TILE, rail_y // TILE * TILE, TILE):
+        for x in range(TILE, width - TILE, TILE):
+            # The paved apron sits beneath the pavilion sprite.
+            deck.paste(paving, (x, y))
+    draw.rectangle((left + 3, top + 3, right - 3, TILE - 1), fill=PALE)
+    draw.line((left + 4, top + 2, right - 4, top + 2), fill=CAP)
+    draw.rectangle((left + 3, TILE, TILE - 1, rail_y - 1), fill=PALE)
+    draw.rectangle((width - TILE, TILE, right - 3, rail_y - 1), fill=PALE)
+
+    def post(x, y):
+        draw.rectangle((x - 3, y, x + 3, y + 6), fill=DARK)
+        draw.rectangle((x - 2, y + 1, x + 2, y + 4), fill=STONE)
+        draw.line((x - 2, y, x + 2, y), fill=CAP)
+
+    def side_rail(x, y_start, y_end):
+        draw.rectangle((x - 1, y_start, x + 2, y_end), fill=SHADOW)
+        draw.line((x, y_start, x, y_end), fill=CAP)
+        for y in range(y_start, y_end - 4, TILE):
+            post(x, y)
+        post(x, y_end - 6)
+
+    side_rail(left + 6, top + 8, rail_y + 1)
+    side_rail(right - 6, top + 8, rail_y + 1)
+
+    # The front balustrade leaves the full three-tile entrance open.
+    for start, end in ((left + 5, walk_left - 1), (walk_right, right - 5)):
+        draw.rectangle((start, lip - 1, end, lip + 1), fill=MORTAR)
+        draw.line((start, lip - 2, end, lip - 2), fill=PALE)
+        draw.rectangle((start, rail_y - 2, end, rail_y + 1), fill=SHADOW)
+        draw.line((start, rail_y - 2, end, rail_y - 2), fill=CAP)
+        for x in range(start + 3, end - 3, TILE):
+            post(x, rail_y - 3)
+
+    for start, end, post_x in ((walk_left - 9, walk_left - 1, walk_left - 5),
+                               (walk_right, walk_right + 8, walk_right + 4)):
+        draw.rectangle((start, rail_y, end, height - 2), fill=DARK)
+        draw.rectangle((start + 1, rail_y, end - 1, height - 3), fill=STONE)
+        side_rail(post_x, rail_y - 3, height - 3)
+
+    # Paving joins the bridge without a step or a fence over the route.
+    for x in range(walk_left, walk_right, TILE):
+        deck.paste(paving, (x, (CAUSEWAY[1] - y0) * TILE))
+    return deck
