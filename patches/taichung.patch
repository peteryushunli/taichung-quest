+        }
+    }
+    // Old Theater repairs that now land on a street tree chain into its v8 row.
+    Versioned(3); InXitun(18,39); before = sSave; TaichungSaveUpgradeOnContinue();
+    AssertXitunWarp(20,38); assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+    // v7 refreshes Xitun (streets) and OldCity (buildings); every interior and other district stays put.
+    for (map = 0; map < 3; map++)
+    {
+        bool8 expected = TRUE; // v8 reloads Xitun (streets), OldCity (buildings) and Greenway (Nantun seam pavers).
+        Versioned(7); InOldCity(positions[map][0],positions[map][1]); sSave.location.mapNum = map; before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(sHasContinueWarp == expected && sWarpRequests == (unsigned)expected);
+        if (map == MAP_NUM(MAP_TAICHUNG_XITUN))
+            AssertXitunWarp(before.pos.x,before.pos.y);
+        else if (map == MAP_NUM(MAP_TAICHUNG_GREENWAY))
+            AssertGreenwayWarp(before.pos.x,before.pos.y);
+        else if (expected)
+            AssertWarp(before.pos.x,before.pos.y);
+        else
+            assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        AssertSamePartyAndVars(&before);
+    }
+    for (map = 3; map <= 14; map++)
+    {
+        Versioned(7); if (map < 14) { InOldCity(6,9); sSave.location.mapNum = map; } before = sSave;
+        TaichungSaveUpgradeOnContinue(); assert(!sHasContinueWarp && sWarpRequests == 0);
+        assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        AssertSamePartyAndVars(&before);
+    }
+    // A v7 Greenway save reloads once as well: Nantun opened its seam cells into pavers.
+    Versioned(7); InGreenway(19,27); before = sSave; TaichungSaveUpgradeOnContinue();
+    AssertGreenwayWarp(19,27); assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+    // Keep an actual onboarding-stage value and all established save fields.
+    Versioned(7); V(0x40F6) = 0xA109; InXitun(31,30); before = sSave;
+    TaichungSaveUpgradeOnContinue(); AssertXitunWarp(31,32); AssertSamePartyAndVars(&before);
+    assert(V(0x40F6) == 0xA109);
+    // The earliest prototype chain also ends on the verified fallback.
+    Reset(); V(0x40FC) = SPECIES_PIKACHU; InXitun(31,30); before = sSave;
+    TaichungSaveUpgradeOnContinue(); AssertXitunWarp(31,32);
+    assert(V(0x40F7) == TAICHUNG_SAVE_VERSION && TaichungSaveUsesStationCheckpoint() && sChallengeCancels == 1); AssertProtected(&before,TRUE);
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+        for (pending = 0; pending < 2; pending++)
+        {
+            Versioned(version); InXitun(31,30); sHasContinueWarp = pending;
+            sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1;
+            sSave.continueGameWarp.x = 31; sSave.continueGameWarp.y = 30; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(memcmp(&sSave,&before,sizeof(sSave)) == 0);
+            assert(sWarpRequests == 0 && sVariableWrites == 0 && sChallengeCancels == 1 && sHasContinueWarp == pending);
+        }
+    Versioned(7); InXitun(31,30); TaichungSaveUpgradeOnContinue();
+    assert(sWarpRequests == 1 && sVariableWrites == 1 && sChallengeCancels == 1);
+    sHasContinueWarp = FALSE; before = sSave; TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && !sHasContinueWarp);
+    assert(sWarpRequests == 1 && sVariableWrites == 1 && sChallengeCancels == 2);
+}
