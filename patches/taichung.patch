+class Bank:
+    """Small independent renderer that resolves only requested metatiles."""
+    def __init__(self, files, primary, secondary, palette_overrides=None):
+        self.files, self.folders = files, (str(primary), str(secondary))
+        self.images = [files.image(f"{folder}/tiles.png") for folder in self.folders]
+        self.defs = [files.words(f"{folder}/metatiles.bin") for folder in self.folders]
+        self.attrs = [files.words(f"{folder}/metatile_attributes.bin", "I") for folder in self.folders]
+        for image, defs, attrs in zip(self.images, self.defs, self.attrs):
+            if image.mode != "P" or image.width % 8 or image.height % 8 or image.getextrema()[1] > 15:
+                raise ValueError("Bank graphics are not an indexed 4bpp tile sheet")
+            if len(defs) != len(attrs)*8:
+                raise ValueError("Metatile/attribute count mismatch")
+        self.palettes = []
+        for n in range(13):
+            folder = self.folders[0 if n < 7 else 1]
+            path = (palette_overrides or {}).get(n, f"{folder}/palettes/{n:02}.pal")
+            colors = [tuple(map(int, line.split())) for line in files.text(path).splitlines()[3:] if line.strip()]
+            if len(colors) != 16:
+                raise ValueError(f"Palette {n} does not have 16 colors")
+            self.palettes.append(colors)
+        self.render_cache = {}
+
+    def attr(self, metatile):
+        which, local = (0, metatile) if metatile < 640 else (1, metatile-640)
+        if not 0 <= local < len(self.attrs[which]):
+            raise ValueError(f"Undefined metatile {metatile:#x}")
+        return self.attrs[which][local]
+
+    def entries(self, metatile):
+        self.attr(metatile)
+        which, local = (0, metatile) if metatile < 640 else (1, metatile-640)
+        return self.defs[which][local*8:(local+1)*8]
+
+    def graphic(self, n):
+        which, local = (0, n) if n < 640 else (1, n-640)
+        image = self.images[which]
+        count = image.width*image.height//64
+        if not 0 <= local < count:
+            raise ValueError(f"Undefined graphic {n}")
+        sx, sy = local % (image.width//8)*8, local // (image.width//8)*8
+        return tuple(image.getpixel((sx+x, sy+y)) for y in range(8) for x in range(8))
+
+    def layer(self, metatile, layer):
+        entries = self.entries(metatile)
+        pixels = [0]*256
+        for q in range(4):
+            entry = entries[layer*4+q]
+            graphic, palette = entry & 1023, entry >> 12
+            if not 0 <= palette < 13:
+                raise ValueError(f"Invalid palette {palette} in {metatile:#x}")
+            tile = self.graphic(graphic)
+            for y in range(8):
+                for x in range(8):
+                    value = tile[(7-y if entry & 0x800 else y)*8+(7-x if entry & 0x400 else x)]
+                    pixels[(q//2*8+y)*16+q%2*8+x] = (value, self.palettes[palette][value])
+        return pixels
+
+    def render(self, metatile):
+        if metatile not in self.render_cache:
+            lower, upper = self.layer(metatile, 0), self.layer(metatile, 1)
+            self.render_cache[metatile] = tuple(top[1] if top[0] else bottom[1] for bottom, top in zip(lower, upper))
+        return self.render_cache[metatile]
+
