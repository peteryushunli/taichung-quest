+        for y in range(h):
+            for x in range(w):
+                if not any(art.getpixel((x*16+dx,y*16+dy)) for dy in range(16) for dx in range(16)):continue
+                gx,gy=ox+x,oy+y
+                assert 0<=gx<width and 0<=gy<height and (gx,gy) not in donated, f'Art overlaps a donated seam cell: {gx},{gy}'
+                ground_id=ground[gy*width+gx]&1023
+                assert ground_id in (0x001,0x175), f'Art needs explicit ground review at {gx},{gy}'
+                lower=baseline.entries(ground_id)
+                assert lower[4:]==[0]*4, 'Ground already has foreground; explicit composition required'
+                n=next(free)
+                while len(defs)<=n-640:defs.append([0]*8);attrs.append(0)
+                entries=[]
+                for dy in range(2):
+                    for dx in range(2):
+                        p=tuple(art.getpixel((x*16+dx*8+px,y*16+dy*8+py)) for py in range(8) for px in range(8))
+                        entries.append(pack(p)|spec['palette']<<12)
+                defs[n-640]=lower[:4]+entries;attrs[n-640]=0x20000000 if y==h-1 else 0
+                grid[gy*width+gx]=n|0x400;mapping[f'{x},{y}']=n;occupied.append([gx,gy])
+        if spec.get('door'):
+            x,y=spec['door'];assert original[y*width+x]==0x043d;grid[y*width+x]=0x043d
+        landmarks.append(dict(id=spec['id'],input=str(path.relative_to(ROOT)),inputSha256=digest(path.read_bytes()),
+                              origin=spec['origin'],size=[w,h],door=spec.get('door'),palette=spec['palette'],
+                              role=spec.get('role','landmark'),parent=spec.get('parent'),occupiedCells=occupied,localMetatileIds=mapping))
+    assert len(defs)<=384
+    DATA.mkdir(parents=True,exist_ok=True);OUT.mkdir(parents=True,exist_ok=True)
+    loaded=max(16,(len(secondary)+15)//16*16)
+    sheet=Image.new('P',(128,loaded//16*8));sheet.putpalette(primary.getpalette())
+    for n,p in enumerate(secondary):
+        for y in range(8):
+            for x in range(8):sheet.putpixel((n%16*8+x,n//16*8+y),p[y*8+x])
+    sheet.save(OUT/'tiles.png');words(OUT/'metatiles.bin',[e for group in defs for e in group]);words(OUT/'metatile_attributes.bin',attrs,'I')
+    (OUT/'palettes').mkdir(exist_ok=True)
+    for n in range(16):
+        raw=before.read(f'{CORE}/palettes/{n:02}.pal').replace(b'\r\n',b'\n').replace(b'\n',b'\r\n')
+        if n in palettes:raw=('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,palettes[n][i:i+3])) for i in range(0,48,3))+'\r\n').encode()
+        (OUT/f'palettes/{n:02}.pal').write_bytes(raw)
+    (DATA/'baseline-map.bin').write_bytes(before.read(own['layout']['blockdata_filepath']));words(DATA/'map.bin',grid)
+    manifest=dict(schemaVersion=1,baselineCommit=revision,primary='gTileset_TaichungOldCorePrimary',secondary='gTileset_TaichungGreenway',
+                  primaryFolder=PRIMARY,secondaryFolder=str(OUT.relative_to(ROOT)),mapFile=str((DATA/'map.bin').relative_to(ROOT)),
+                  baselineMapFile=str((DATA/'baseline-map.bin').relative_to(ROOT)),requiredSourceMetatiles=sorted(used),landmarks=landmarks,
+                  retiredFootprints=[s['retired'] for s in SPECS if s.get('retired')],sourceMapSha256=digest(before.read(own['layout']['blockdata_filepath'])),
+                  mapSha256=digest((DATA/'map.bin').read_bytes()),secondaryGraphics=len(secondary),loadedSecondaryGraphics=loaded,
+                  secondaryMetatiles=len(defs),doorScratch=[1016,1024],borrowedDonorCellsPreserved=len(donated),
+                  changedMapWords=sum(a!=b for a,b in zip(grid,original)),registeredInSource=False,runtimeVerifiedByCompiler=False)
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+    return manifest
+
+
+def install(manifest):
+    # Derive the small registration snippets from the same layout as the Theater
+    # installer without changing that already released tool or any primary bank.
+    folder=str(OUT.relative_to(ROOT));label='TaichungGreenway'
+    snippets={
+        'graphics.h':f'const u32 gTilesetTiles_{label}[] = INCBIN_U32("{folder}/tiles.4bpp.lz");\n\nconst u16 gTilesetPalettes_{label}[][16] =\n{{\n'+''.join(f'    INCBIN_U16("{folder}/palettes/{n:02}.gbapal"),\n' for n in range(16))+'};\n',
+        'metatiles.h':f'const u16 gMetatiles_{label}[] = INCBIN_U16("{folder}/metatiles.bin");\nconst u32 gMetatileAttributes_{label}[] = INCBIN_U32("{folder}/metatile_attributes.bin");\n',
+        'headers.h':f'const struct Tileset gTileset_{label} =\n{{\n    .isCompressed = TRUE,\n    .isSecondary = TRUE,\n    .tiles = gTilesetTiles_{label},\n    .palettes = gTilesetPalettes_{label},\n    .metatiles = gMetatiles_{label},\n    .metatileAttributes = gMetatileAttributes_{label},\n    .callback = NULL,\n}};\n'}
