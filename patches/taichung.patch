@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+"""Exact encounter-init layer above the unchanged save-v12 gym registration.
+
+Its four reviewed source edits reverse to the precise baseline SaveC. No map,
+header/version, anchor or historical registration is substituted by this layer.
+Current source and Gameplay dependencies are checked before yielding that view.
+Portable checks need no Git; the immutable feature commit is provenance only.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = 'data/taichung/encounter-save-init/registration.json'
+MANIFEST_SHA256 = 'fce4845b63ff1028f27d820ee74e0d658d610212f327767960d49e7c9aeebc56'
+SOURCE = 'src/taichung_save.c'
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def function(text, name):
+    match = re.search(r'^(?:static\s+)?\w+\s+' + re.escape(name) + r'\([^;]*?\)\s*\{', text, re.M)
+    require(match is not None, 'Missing encounter function: ' + name)
+    depth = 1
+    for end in range(match.end(), len(text)):
+        depth += (text[end] == '{') - (text[end] == '}')
+        if depth == 0:
+            return text[match.start():end + 1]
+    raise ValueError('Unclosed encounter function: ' + name)
+
+
+def reader(source, overrides=None):
+    def read(path):
+        if path in (overrides or {}):
+            raw = overrides[path]
+            if raw is None:
+                raise FileNotFoundError(path)
+            return raw
+        return (Path(source) / path).read_bytes()
+    return read
+
+
+def active(read):
+    try:
+        read(MANIFEST)
+        return True
+    except FileNotFoundError:
+        return b'InitVirginEncounterSaveState' in read(SOURCE)
+
+
+def verified(read):
+    require(active(read), 'Encounter save-init layer is absent')
+    raw = read(MANIFEST)
+    require(digest(raw) == MANIFEST_SHA256, 'Encounter init registration differs')
+    registration = json.loads(raw)
+    require(registration['schemaVersion'] == 1 and registration['saveVersion'] == 12
+            and registration['ownedSource'] == SOURCE, 'Encounter init scope/version differs')
+    current = read(SOURCE)
+    require(digest(current) == registration['installedSha256'], 'Encounter init SaveC differs from the reviewed feature')
+    for field in ('saveHeader', 'constants'):
+        item = registration[field]
+        require(digest(read(item['path'])) == item['sha256'], 'Encounter init dependency differs: ' + item['path'])
+    item = registration['encounterFunctions']
+    text = read(item['path']).decode()
+    for name, expected in item['sha256'].items():
+        require(digest(function(text, name).encode()) == expected, 'Encounter init function differs: ' + name)
+    item = registration['requiredDeclarations']
+    text = read(item['path']).decode()
+    for declaration in item['declarations']:
+        require(text.count(declaration) == 1, 'Encounter init declaration differs: ' + declaration)
+    restored = current.decode()
+    require(len(registration['edits']) == 4, 'Encounter init edit inventory differs')
+    for edit in reversed(registration['edits']):
+        require(restored.count(edit['after']) == 1, 'Encounter init reverse edit is missing/ambiguous')
+        restored = restored.replace(edit['after'], edit['before'], 1)
+    baseline = restored.encode()
+    require(digest(baseline) == registration['baselineSha256'], 'Encounter init does not restore the exact save-v12 baseline')
+    item = registration['fixture']
+    restored_fixture = read(item['path']).decode()
+    require(digest(restored_fixture.encode()) == item['installedSha256'], 'Encounter facing fixture differs')
+    require(len(item['edits']) == 2, 'Encounter facing fixture edit inventory differs')
+    for edit in reversed(item['edits']):
+        require(restored_fixture.count(edit['after']) == 1, 'Encounter facing fixture reverse edit is missing/ambiguous')
+        restored_fixture = restored_fixture.replace(edit['after'], edit['before'], 1)
+    fixture_baseline = restored_fixture.encode()
+    require(digest(fixture_baseline) == item['baselineSha256'], 'Encounter fixture does not restore the exact historical assertions')
+    return {'active': True, 'passed': True, 'featureCommit': registration['featureCommit'],
+            'baselineCommit': registration['baselineCommit'], 'saveVersion': 12,
+            'sourceSha256': digest(current), 'unchangedHistoricalSourceSha256': digest(baseline),
+            'reversedSourceEdits': 4, 'reversedFixtureEdits': 2,
+            'nativeRuntimeTested': False}, {SOURCE: baseline, item['path']: fixture_baseline}
+
+
+def peel(read):
+    """Fail closed for an active but invalid layer; leave older trees untouched."""
+    return verified(read)[1] if active(read) else {}
+
+
+def check(source=ROOT, overrides=None):
+    read = reader(source, overrides)
+    try:
+        return verified(read)[0] if active(read) else {'active': False, 'passed': True}
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        return {'active': True, 'passed': False, 'errors': [str(error)]}
+
+
+def self_test(source=ROOT):
+    read = reader(source)
+    positive = check(source)
+    if not positive['passed']:
+        return {'passed': False, 'current': positive}
+    registration = json.loads(read(MANIFEST))
+    probes = {}
+
+    def fault(name, path, before, after):
+        raw = read(path)
+        require(before in raw and before != after, 'No-op corruption probe: ' + name)
+        probes[name] = {path: raw.replace(before, after, 1)}
+
+    for name, before, after in (
