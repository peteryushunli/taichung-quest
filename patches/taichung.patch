+            pair = ("data/tilesets/primary/" + _folder(now, info["primary_tileset"]),
+                    "data/tilesets/secondary/" + _folder(now, info["secondary_tileset"]))
+            new, old = support.Bank(now, *pair), support.Bank(base, *pair)
+            words = now.words(info["blockdata_filepath"]) + now.words(info["border_filepath"])
+            differ = sorted({w & 0x3FF for w in words if new.render(w & 0x3FF) != old.render(w & 0x3FF)})
+            tests.require(not differ, f"{name} renders differently from BASE: {[hex(m) for m in differ[:8]]}")
+            cells += len(words)
+        return {"exteriors": len(EXTERIORS), "cellsRendered": cells}
+
+    tests.section("contract", contract)
+    tests.section("installer", installer)
+    tests.section("identity", identity)
+    tests.section("kitContent", kit_content)
+    tests.section("preserved", preserved)
+    tests.section("clearOfUse", clear_of_use)
+    tests.section("exteriors", exteriors)
+    tests.require(install.BASE == KIT_BASE and install.CONTRACT == KIT_CONTRACT, "Installer base or contract path moved")
+    return {"passed": not tests.errors, "errors": tests.errors, "checks": tests.results}
+
+
+KIT_BASE = "6366b9e5c037647ce4d2a007efa3d3dfbedcdb48"
+KIT_CONTRACT = "data/taichung/city-kit/kit.json"
+
+
+def underneath(files):
+    """{path: BASE bytes} for the nine primary files when the tree holds exactly
+    the registered kit (under the registered still-water layer, which is
+    stripped first and whose other files are returned as they were before it):
+    kit.json at its pinned hash and every primary file at its registered output
+    hash. Otherwise {}, so a guard reads the real bytes.
+    Guards that freeze a whole primary check this state underneath; this guard
+    proves the kit delta itself."""
+    support = load("city_kit_underneath_support", Path(files.source) / "tools/taichung/landmarks/check_old_core.py")
+    peeled = support.still_water_underneath(files)
+    read = lambda path: peeled[path] if path in peeled else files.read(path)
+    try:
+        raw = read(KIT_CONTRACT)
+    except (OSError, subprocess.CalledProcessError):
+        return {}
+    if hashlib.sha256(raw).hexdigest() != CONTRACT_SHA256:
+        return {}
+    outputs = json.loads(raw)["outputs"]
+    if any(hashlib.sha256(read(path)).hexdigest() != digest for path, digest in outputs.items()):
+        return {}
+    base = {path: subprocess.run(["git", "show", f"{KIT_BASE}:{path}"], cwd=files.source, check=True,
+                                 capture_output=True).stdout for path in outputs}
+    # Underneath the kit is also underneath the later still-water layer: its other
+    # files (General's water frames) read as they were before it.
+    return {**{path: data for path, data in peeled.items() if path not in base}, **base}
+
+
+def _folder(files, label):
+    """Tileset folder for a C label, from its tiles INCBIN path."""
+    import re
+    header = re.search(rf"\b{label}\s*=\s*\{{(.*?)\}};", files.text("src/data/tilesets/headers.h"), re.S).group(1)
+    symbol = re.search(r"\.tiles\s*=\s*(\w+)", header).group(1)
+    path = re.search(rf"\b{symbol}\[\]\s*=\s*INCBIN_U32\(\"([^\"]+)\"\)", files.text("src/data/tilesets/graphics.h")).group(1)
+    return path.split("/")[-2]
+
+
+def self_test(source):
+    source = Path(source).resolve()
+    install = load("city_kit_install", HERE / "install_city_kit.py")
+    read = lambda path: (source / path).read_bytes()
+    from io import BytesIO
+    from PIL import Image
+    xitun, greenway, oldcore = install.PRIMARIES
+
+    def png_with(folder, n, value):
+        image = Image.open(BytesIO(read(f"{folder}/tiles.png")))
+        image.load()
+        x, y = n % 16 * 8, n // 16 * 8
+        image.putpixel((x, y), value if image.getpixel((x, y)) != value else (value + 1) % 16)
+        out = BytesIO()
+        image.save(out, format="PNG", optimize=False)
+        return out.getvalue()
+
+    def word_with(path, index, kind, xor):
+        size = struct.calcsize(kind)
+        data = bytearray(read(path))
+        value = struct.unpack_from(f"<{kind}", data, index * size)[0] ^ xor
+        struct.pack_into(f"<{kind}", data, index * size, value)
+        return bytes(data)
+
+    def drawn(path, index, word):
+        data = bytearray(read(path))
+        struct.pack_into("<H", data, index * 2, word)
+        return bytes(data)
+
+    def everywhere(name, index, kind, xor):
+        return {f"{f}/{name}": word_with(f"{f}/{name}", index, kind, xor) for f in install.PRIMARIES}
+
+    kit = json.loads(read(install.CONTRACT))
+    a, b = list(kit["metatiles"])[:2]
+    kit["metatiles"][a], kit["metatiles"][b] = kit["metatiles"][b], kit["metatiles"][a]
+    palette = read(f"{greenway}/palettes/02.pal").replace(b"246 246 255", b"246 246 254", 1)
+    xitun_map = word_with("data/layouts/TaichungXitun/map.bin", 100, "H", 0x001)
+    water = install.art.ids()["wa-east-body"]
+    faults = {
+        "kitIdsSwapped": ("contract", {install.CONTRACT: (json.dumps(kit, indent=1) + "\n").encode()}),
+        "kitTileDiffersInOnePrimary": ("identity", {f"{oldcore}/tiles.png": png_with(oldcore, TILE_SLOTS[5], 3)}),
+        "kitDefinitionDiffersInOnePrimary": ("identity", {f"{greenway}/metatiles.bin": word_with(f"{greenway}/metatiles.bin", FIRST_METATILE * 8 + 1, "H", 0x400)}),
+        "kitArtEditedEverywhere": ("kitContent", {f"{f}/tiles.png": png_with(f, TILE_SLOTS[0], 9) for f in install.PRIMARIES}),
+        "surfableKitWater": ("kitContent", everywhere("metatile_attributes.bin", water, "I", 0x15)),
+        "usedTileOverwritten": ("preserved", {f"{xitun}/tiles.png": png_with(xitun, 0x22F, 7)}),
+        "animationSlotOverwritten": ("preserved", {f"{f}/tiles.png": png_with(f, 434, 2) for f in install.PRIMARIES}),
+        "usedDefinitionEdited": ("preserved", everywhere("metatiles.bin", 0x001 * 8, "H", 0x800)),
+        "primaryPaletteEdited": ("identity", {f"{greenway}/palettes/02.pal": palette}),
+        "secondaryEdited": ("preserved", {"data/tilesets/secondary/taichung_nantun/metatiles.bin":
+                                          word_with("data/tilesets/secondary/taichung_nantun/metatiles.bin", 8, "H", 1)}),
+        "exteriorMapEdited": ("preserved", {"data/layouts/TaichungXitun/map.bin": xitun_map}),
+        "secondaryDrawsKitSlot": ("clearOfUse", {"data/tilesets/secondary/taichung_nantun/metatiles.bin":
+                                                 drawn("data/tilesets/secondary/taichung_nantun/metatiles.bin", 8, TILE_SLOTS[0] | 2 << 12)}),
+    }
+    results = {}
+    for name, (section, edits) in faults.items():
+        changed = all(read(path) != content for path, content in edits.items())
+        report = check(source, edits)
+        results[name] = changed and not report["passed"] and not report["checks"].get(section, {}).get("passed", True)
+    return results
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
