+        if (size == 0 && sCategories[i].type != TEAM_CATEGORY_CAUGHT)
+            continue;
+        sCategoryIds[sCategoryCount] = i;
+        sCategorySizes[sCategoryCount] = size;
+        sCategoryCount++;
