+        "usedDefinitionEdited": ("preserved", everywhere("metatiles.bin", 0x001 * 8, "H", 0x800)),
+        "primaryPaletteEdited": ("identity", {f"{greenway}/palettes/02.pal": palette}),
+        "secondaryEdited": ("preserved", {"data/tilesets/secondary/taichung_nantun/metatiles.bin":
+                                          word_with("data/tilesets/secondary/taichung_nantun/metatiles.bin", 8, "H", 1)}),
+        "exteriorMapEdited": ("preserved", {"data/layouts/TaichungXitun/map.bin": xitun_map}),
+        "secondaryDrawsKitSlot": ("clearOfUse", {"data/tilesets/secondary/taichung_nantun/metatiles.bin":
+                                                 drawn("data/tilesets/secondary/taichung_nantun/metatiles.bin", 8, TILE_SLOTS[0] | 2 << 12)}),
+    }
+    results = {}
