index 00000000..c3aa6c5d
--- /dev/null
+++ b/tools/taichung/boulevard_city/qa/tour.mjs
@@ -0,0 +1,326 @@
+// Drive the complete Boulevard cartridge with the existing local mGBA harness.
+import assert from 'node:assert/strict';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { open } from '../../tile_limit_probe/qa/cdp.mjs';
+
+const [reportPath, outDir, navigation, streaming, startOrder, startCursor, mode] = process.argv.slice(2);
+const city = JSON.parse(readFileSync(reportPath, 'utf8'));
+const maps = new Map(city.maps.map(map => [map.number, map]));
+const mapIds = new Map(city.maps.map(map => [map.nativeId, map]));
+const station = city.maps.find(map => map.name === 'TaichungBlvdOldStation');
+const groups = JSON.parse(readFileSync(new URL('../../../../data/maps/map_groups.json', import.meta.url)));
+const mapGroup = groups.gMapGroup_Taichung;
+const stationGym = mapGroup.indexOf('TaichungOldStation_Gym');
+const qa = await open({ url: 'http://127.0.0.1:8831/', outDir });
+const directions = [['Right', 'right', 1, 0], ['Left', 'left', -1, 0],
+                    ['Down', 'down', 0, 1], ['Up', 'up', 0, -1]];
+const bikeBit = 1 << 5;
+const dialogueBit = 1 << 5;
+const menuOptions = 5;
+const menuSave = 4;
+const states = [];
+const visited = new Set();
+const districts = new Set();
+let moved = 0;
+
+// Review screenshots at landmarks and the hard western edge on the same bike tour.
+const reviewSpots = new Map([
+  [28, ['west-highway', 39, 111]],
+  [29, ['tiger-city', 63, 140]],
+  [32, ['rainbow-village', 55, 232]],
+  [34, ['central-park-promenade', 89, 42]],
+]);
+
+function tuple(state) {
+  return [state.map, state.x, state.y];
+}
+
+async function waitFor(predicate, label, duration = 12000) {
+  const limit = Date.now() + duration;
+  let state;
+  do {
+    state = await qa.state();
+    if (predicate(state)) return state;
+    await qa.sleep(70);
+  } while (Date.now() < limit);
+  await qa.shot('timeout');
+  throw new Error(label + ' timed out at ' + JSON.stringify({ at: tuple(state), context: state.context }));
+}
+
+async function boot() {
+  for (let i = 0; i < 60; i++) {
+    if ((await qa.state()).field) return;
+    await qa.press(i % 5 === 4 ? 'Start' : 'A', 75, 330);
+  }
+  throw new Error('The fixture did not reach the field');
+}
+
+async function settingsHighlight(x, y) {
+  // Read the highlighted cursor or choice on the native Options screen.
+  return qa.evaluate(`(() => {
+    const screen = document.getElementById('screen');
+    const area = new OffscreenCanvas(20, 10).getContext('2d');
+    area.drawImage(screen, ${x}, ${y}, 20, 10, 0, 0, 20, 10);
+    const pixels = area.getImageData(0, 0, 20, 10).data;
+    for (let i = 0; i < pixels.length; i += 4) {
+      if (pixels[i] === 41 && pixels[i + 1] === 156 && pixels[i + 2] === 82) return true;
+    }
+    return false;
+  })()`);
+}
+
+async function selectStartMenuAction(action) {
+  await qa.press('Start', 100, 650);
+  for (let i = 0; i < 12; i++) {
+    if (await qa.evaluate('qa.startMenuAction()') === action) {
+      await qa.press('A', 100, 950);
+      return;
+    }
+    await qa.press('Down', 95, 170);
+  }
+  throw new Error('Could not select Start menu item ' + action);
+}
+
+async function quietTour() {
+  // Keep random battles from interrupting the repeatable route.
+  await selectStartMenuAction(menuOptions);
+  for (let i = 0; i < 8 && !(await settingsHighlight(4, 54)); i++)
+    await qa.press('Up', 100, 180);
+  assert(await settingsHighlight(4, 54), 'Selected the wild encounter row');
+  for (let i = 0; i < 4 && !(await settingsHighlight(130, 54)); i++)
+    await qa.press('Right', 100, 180);
+  assert(await settingsHighlight(130, 54), 'Set random encounters to Off');
+  await qa.shot('quiet-tour-settings');
+  for (let i = 0; i < 5 && !(await qa.state()).field; i++) await qa.press('B', 100, 750);
+  await waitFor(s => s.field && s.map === 0, 'back from Options');
+}
+
+async function mark(label, expectedMap, screenshot = true) {
+  await qa.sleep(screenshot ? 510 : 310);
+  const state = await waitFor(value => value.field && value.map === expectedMap, label);
+  const map = maps.get(state.map);
+  if (map) {
+    assert(state.stream.active, 'A Boulevard map should use the streamed renderer');
+    assert.equal(state.stream.overflowTiles, 0, 'Graphics cache overflow at ' + label);
+    assert.equal(state.stream.overflowPals, 0, 'Palette cache overflow at ' + label);
+    visited.add(state.map);
+    districts.add(map.district);
+  } else {
+    assert(!state.stream.active, 'An existing map should use the regular renderer');
+  }
+  if (screenshot) await qa.shot(label);
+  states.push({ label, district: map?.district, ...state });
+  writeFileSync(join(outDir, 'tour.json'), JSON.stringify({
+    mapsVisited: [...visited], districtsVisited: [...districts], steps: moved, states,
+  }, null, 2));
+  console.log(label, tuple(state).join(' '), 'visited', visited.size,
+              'tiles', state.stream.residentTiles, 'palettes', state.stream.residentPals);
+  return state;
+}
+
+function openPoint(map, x, y) {
+  return map.localWalkable[y]?.[x] === '1'
+    && !map.people.some(person => person.x === x && person.y === y);
+}
+
+function route(start, goal) {
+  const pending = [start];
+  const parent = new Map([[start.join(','), null]]);
+  for (const point of pending) {
+    const [number, x, y] = point;
+    const map = maps.get(number);
+    if (goal(map, x, y)) {
+      const path = [];
+      for (let step = parent.get(point.join(',')); step; step = parent.get(step.from.join(','))) {
+        path.push(step.button);
+      }
+      const sequence = [];
+      for (const button of path.reverse()) {
+        if (sequence.at(-1)?.[0] === button) sequence.at(-1)[1]++;
+        else sequence.push([button, 1]);
+      }
+      return { sequence, destination: point, distance: path.length };
+    }
+    for (const [button, side, dx, dy] of directions) {
+      let next = map, nx = x + dx, ny = y + dy;
+      if (nx < 0 || ny < 0 || nx >= map.localWalkable[0].length || ny >= map.localWalkable.length) {
+        const wx = map.worldRect[0] + nx, wy = map.worldRect[1] + ny;
+        const edge = map.connections.find(connection => {
+          if (connection.direction !== side) return false;
+          const [x0, y0, x1, y1] = mapIds.get(connection.map).worldRect;
+          return wx >= x0 && wy >= y0 && wx < x1 && wy < y1;
+        });
+        if (!edge) continue;
+        next = mapIds.get(edge.map);
+        nx = wx - next.worldRect[0];
+        ny = wy - next.worldRect[1];
+      }
+      if (!openPoint(next, nx, ny)) continue;
+      const newPoint = [next.number, nx, ny], key = newPoint.join(',');
+      if (parent.has(key)) continue;
+      parent.set(key, { from: point, button });
+      pending.push(newPoint);
+    }
+  }
+  throw new Error('No road connects the destination to ' + start);
+}
+
+async function go(goal, label) {
+  const start = await waitFor(s => s.field && maps.has(s.map), label + ' start');
+  const next = route(tuple(start), goal);
+  const counts = await qa.evaluate('qa.run(' + JSON.stringify(next.sequence) + ', 1800)');
+  if (!counts.every((n, i) => n === next.sequence[i][1])) {
+    await qa.shot('interrupted');
+    throw new Error(label + ' stopped walking at ' + tuple(await qa.state())
+      + ' on route ' + JSON.stringify(next.sequence) + ' with counts ' + counts);
+  }
+  moved += next.distance;
+  return waitFor(s => s.field && tuple(s).join(',') === next.destination.join(','), label);
+}
+
+async function setBike(on) {
+  for (let i = 0; i < 3; i++) {
+    const state = await waitFor(value => value.field && (value.flags & 64), 'available bike');
+    if (Boolean(state.flags & bikeBit) === on) return;
+    await qa.press('B', 100, 1050);
+  }
+  assert.equal(Boolean((await qa.state()).flags & bikeBit), on, 'Bike input');
+}
+
+async function stationSignAndDoor() {
+  const sign = station.signs[0];
+  await go((map, x, y) => map === station && x === sign.x && y === sign.y + 1, 'station sign');
+  for (let i = 0; i < 3 && (await qa.state()).facing !== 2; i++) await qa.press('Up', 130, 500);
+  await waitFor(s => s.field && s.facing === 2, 'facing the sign');
+  await qa.press('A', 100, 750);
+  await waitFor(s => s.context & dialogueBit, 'station dialogue');
+  await qa.shot('station-sign');
+  for (let i = 0; i < 45 && !(await qa.state()).field; i++) {
+    await qa.press('A', 85, 460);
+    if (i === 2 || i === 7) await qa.shot('station-sign-page-' + (i + 2));
+  }
+  await waitFor(s => s.field, 'after the station sign');
+
+  const door = station.doors.find(event => event.dest_map === 'MAP_TAICHUNG_OLD_STATION_GYM');
+  await setBike(false);
+  await go((map, x, y) => map === station && x === door.x && y === door.y + 1, 'station door');
+  await qa.walk('Up', 1);
+  await mark('station-interior', stationGym);
+  await qa.walk('Down', 2);
+  await mark('back-on-boulevard', station.number);
+}
+
+async function reviewMap(number) {
+  const spot = reviewSpots.get(number);
+  if (!spot) return;
+  const [label, worldX, worldY] = spot;
+  const state = await go((map, x, y) => map.number === number
+    && map.worldRect[0] + x === worldX && map.worldRect[1] + y === worldY, label);
+  if (label === 'west-highway') {
+    await qa.press('Left', 350, 250);
+    assert.deepEqual(tuple(await qa.state()), tuple(state), 'The west highway blocks the bike');
+  }
+  await mark(label, number);
+}
+
+async function saveAndContinue() {
+  const before = await qa.state();
+  const previous = await qa.evaluate('qa.saveBase64()');
+  await selectStartMenuAction(menuSave);
+  await qa.shot('save-prompt');
+  for (let i = 0; i < 8 && !(await qa.state()).field; i++) await qa.press('A', 90, 650);
+  await waitFor(v => v.field, 'save');
+  const save = await qa.evaluate('qa.saveBase64()');
+  assert(save && save !== previous, 'The emulator wrote a new test save');
+  await qa.evaluate('qa.reset()');
+  await boot();
+  const after = await mark('continued-on-new-city', before.map);
+  assert.deepEqual(tuple(after), tuple(before), 'The city map and tile survive Continue');
+  writeFileSync(join(outDir, 'boulevard-preview.sav'), Buffer.from(save, 'base64'));
+}
+
+async function stepFrom(worldX, worldY, button, bike, label) {
+  const start = await go((map, x, y) => map.worldRect[0] + x === worldX
+    && map.worldRect[1] + y === worldY, label + ' approach');
+  await setBike(bike);
+  const [, , dx, dy] = directions.find(([key]) => key === button);
+  await qa.walk(button, 1);
+  const after = await mark(label, start.map);
+  assert.deepEqual(tuple(after), [start.map, start.x + dx, start.y + dy], label);
+  await setBike(true);
+}
+
+async function visitLandmark(place) {
+  const [worldX, worldY] = place.readFrom;
+  const [signX, signY] = place.signTile;
+  const onWorldTile = (map, x, y, wx, wy) => map.worldRect[0] + x === wx && map.worldRect[1] + y === wy;
+  await setBike(true);
+  const arrival = await go((map, x, y) => onWorldTile(map, x, y, worldX, worldY), place.id);
+  // The native sign also opens when approached directly from the south.
+  await qa.sleep(350);
+  if (!((await qa.state()).context & dialogueBit)) await qa.press('Up', 140, 710);
+  if (!((await qa.state()).context & dialogueBit)) await qa.press('A', 90, 920);
+  await waitFor(s => s.context & dialogueBit, 'Reading ' + place.id + ' sign');
+  await qa.sleep(1150);
+  await qa.shot(place.id + '-sign');
+  for (let i = 0; i < 12 && !(await qa.state()).field; i++)
+    await qa.press('A', 95, 450);
+  const closed = await waitFor(s => s.field, 'Closed ' + place.id + ' sign');
+  assert.deepEqual(tuple(closed), tuple(arrival), 'The sign tile blocks movement');
+  await setBike(false);
+  await mark(place.id, arrival.map);
+
+  const wall = await go((map, x, y) => [signX - 1, signX + 1]
+    .some(wx => onWorldTile(map, x, y, wx, signY)), place.id + ' frontage');
+  await qa.press('Up', 350, 440);
+  const after = await mark(place.id + '-collision', wall.map, false);
+  assert.deepEqual(tuple(after), tuple(wall), 'The exterior blocks movement at ' + place.id);
+}
+
+try {
+  await qa.load({
+    nav: Number(navigation), stats: Number(streaming),
+    startOrder: Number(startOrder), startCursor: Number(startCursor),
+  }, true);
+  await boot();
+  if (mode === '--landmarks') {
+    const start = await mark('continued-from-preview-save', station.number);
+    // The published preview save starts beside the station, four tiles north of the incoming warp.
+    const [stationX, stationY] = city.entry.boulevardWorld;
+    assert.deepEqual([start.x + station.worldRect[0], start.y + station.worldRect[1]], [stationX, stationY - 4]);
+    assert.equal(city.installedLandmarks.length, 3);
+    for (const place of [...city.installedLandmarks].reverse()) await visitLandmark(place);
+  } else {
+    const original = await mark('continued-old-city', 0);
+    assert.equal(original.x, city.entry.legacyOldCity[0]);
+    await quietTour();
+    await qa.walk('Down', city.entry.legacyOldCity[1] - original.y);
+    await mark('arrival-old-station', station.number);
+    await stationSignAndDoor();
+    await setBike(true);
+
+    if (mode === '--feedback') {
+      await stepFrom(252, 78, 'Up', false, 'botanical-garden-turf');
+      await stepFrom(173, 39, 'Left', true, 'ballpark-sidewalk');
+      await stepFrom(98, 166, 'Down', true, 'gongyi-enter-nantun');
+      await stepFrom(98, 167, 'Up', true, 'gongyi-return-xitun');
+    }
+
+    while (mode !== '--save-only' && mode !== '--feedback' && visited.size < city.maps.length) {
+      const snapshot = await go((map, x, y) => !visited.has(map.number)
+        && x >= 2 && y >= 2 && x < map.localWalkable[0].length - 2
+        && y < map.localWalkable.length - 2, 'city tour');
+      const map = maps.get(snapshot.map);
+      const firstInDistrict = !districts.has(map.district);
+      await mark(firstInDistrict ? 'district-' + map.district : 'map-' + map.number,
+                 map.number, firstInDistrict);
+      await reviewMap(map.number);
+    }
+    if (mode !== '--save-only' && mode !== '--feedback') assert.equal(districts.size, 9);
+  }
+  await saveAndContinue();
+  console.log('Complete:', visited.size, 'maps and', districts.size, 'districts,', moved, 'steps.');
+} finally {
+  qa.close();
+}
