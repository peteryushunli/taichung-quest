+                assert(sSave.continueGameWarp.mapGroup == 43 && sSave.continueGameWarp.mapNum == (s8)map);
+                assert(sSave.continueGameWarp.warpId == -1 && sSave.continueGameWarp.x == before.pos.x && sSave.continueGameWarp.y == before.pos.y);
+            }
+            else assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+            AssertSamePartyAndVars(&before);
