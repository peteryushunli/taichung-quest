index 0000000..a1e532a
--- /dev/null
+++ b/tools/taichung_gameplay/inspect-team-save.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""Read native SRAM party data without writing a save or emulator state.
+
+Validates matching SaveBlock1 sectors 1/2 and each encrypted BoxPokemon checksum.
+This is not a complete fourteen-sector save validator; native Continue is still
+the end-to-end acceptance check. An optional baseline compares saved 40F7–40FD.
+"""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import struct
+
+
+ROOT = Path(__file__).resolve().parents[2]
+VARIABLE_NAMES = ("version", "wild", "sight", "gyms", "language", "starter", "tea")
+
+
+def constants(path, prefix):
+    return {
+        int(value, 0): name
+        for name, value in re.findall(
+            rf"^#define ({prefix}\w+) (0x[0-9A-Fa-f]+|\d+)$",
+            (ROOT / path).read_text(), re.M,
+        )
+    }
+
+
+def read_save(path):
+    raw = path.read_bytes()
+    if len(raw) not in (0x20000, 0x20010):
+        raise ValueError(f"{path}: expected 128 KiB native SRAM, with optional 16-byte RTC trailer")
+    pairs = {}
+    # Two native slots of fourteen sectors; the final four are special saves.
+    for offset in range(0, 28 * 0x1000, 0x1000):
+        sector_id, stored, signature, counter = struct.unpack_from("<HHII", raw, offset + 0xFF4)
+        if sector_id not in (1, 2) or signature != 0x08012025:
+            continue
+        payload = raw[offset:offset + 0xF80]
+        total = sum(struct.unpack("<992I", payload)) & 0xFFFFFFFF
+        calculated = ((total >> 16) + total) & 0xFFFF
+        if calculated != stored:
+            continue
+        slot = offset // (14 * 0x1000)
+        pairs.setdefault((slot, counter), {})[sector_id] = {
+            "payload": payload, "offset": offset, "checksum": stored,
+        }
+    valid = [key for key, pair in pairs.items() if 1 in pair and 2 in pair]
+    if not valid:
+        raise ValueError(f"{path}: no checksum-valid sector 1/2 pair in the same slot and save counter; finish native Save first")
+    # Match FireRed's special handling for the uint32 counter rollover.
+    counters = {counter for _, counter in valid}
+    newest = 0 if 0 in counters and 0xFFFFFFFF in counters else max(counters)
+    slot, counter = next(key for key in valid if key[1] == newest)
+    pair = pairs[slot, counter]
+    block = pair[1]["payload"] + pair[2]["payload"]
+    variables = {
+        name: struct.unpack_from("<H", block, 0x1000 + (0xF7 + index) * 2)[0]
+        for index, name in enumerate(VARIABLE_NAMES)
+    }
+    metadata = {
+        "bytes": len(raw), "rtcTrailerBytes": len(raw) - 0x20000,
+        "sha256": hashlib.sha256(raw).hexdigest(), "saveCounter": counter, "saveSlot": slot,
+        "checkedSectors": [
+            {"id": sector, "offset": pair[sector]["offset"], "checksum": pair[sector]["checksum"], "checksumValid": True}
+            for sector in (1, 2)
+        ],
+        "position": {"x": struct.unpack_from("<h", block, 0)[0], "y": struct.unpack_from("<h", block, 2)[0],
+                     "mapGroup": block[4], "mapNumber": block[5]},
+        "rawVariables": variables,
+        "nativeVariables": {f"0x{0x40F7 + index:04X}": variables[name] for index, name in enumerate(VARIABLE_NAMES)},
+    }
+    return block, metadata
+
+
+def decode_mon(data, slot, permutations, species_names, move_names, item_names, move_pp):
+    personality, ot_id = struct.unpack_from("<II", data)
+    stored = struct.unpack_from("<H", data, 0x1C)[0]
+    decrypted = struct.pack("<12I", *(word ^ personality ^ ot_id for word in struct.unpack_from("<12I", data, 0x20)))
+    calculated = sum(struct.unpack("<24H", decrypted)) & 0xFFFF
+    order = permutations[personality % 24]
+    growth = decrypted[order[0] * 12:(order[0] + 1) * 12]
+    attacks = decrypted[order[1] * 12:(order[1] + 1) * 12]
+    species, held_item, experience = struct.unpack_from("<HHI", growth)
+    pp_bonuses = growth[8]
+    moves = []
+    for index, move in enumerate(struct.unpack_from("<4H", attacks)):
+        base_pp = move_pp.get(move)
+        maximum = None if base_pp is None else base_pp + base_pp * ((pp_bonuses >> (index * 2)) & 3) // 5
+        moves.append({"id": move, "symbol": move_names.get(move, "UNKNOWN"), "pp": attacks[8 + index], "maxPP": maximum})
+    status = struct.unpack_from("<I", data, 0x50)[0]
+    hp, max_hp = struct.unpack_from("<HH", data, 0x56)
+    return {
+        "slot": slot, "species": species, "speciesSymbol": species_names.get(species, "UNKNOWN"),
+        "level": data[0x54], "hp": hp, "maxHP": max_hp, "status": status,
+        "heldItem": held_item, "heldItemSymbol": item_names.get(held_item, "UNKNOWN"),
+        "experience": experience, "otId": ot_id, "personality": personality,
+        "ppBonuses": pp_bonuses, "moves": moves,
+        "boxChecksum": {"stored": stored, "calculated": calculated, "valid": stored == calculated},
+        "isBadEgg": bool(data[0x13] & 1), "hasSpecies": bool(data[0x13] & 2),
+        "fullyRecovered": hp == max_hp and max_hp > 0 and status == 0
+                          and all(move["maxPP"] is not None and move["pp"] == move["maxPP"] for move in moves),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("save", type=Path)
+    parser.add_argument("--expect-species", help="Exact ordered party species IDs, e.g. 6,94,134")
+    parser.add_argument("--expect-level", type=int, help="Require this level for every member, e.g. 50")
+    parser.add_argument("--baseline", type=Path, help="Require variables 40F7–40FD to equal this prior native save")
+    args = parser.parse_args()
+    block, result = read_save(args.save)
+    species_names = constants("include/constants/species.h", "SPECIES_")
+    move_names = constants("include/constants/moves.h", "MOVE_")
+    item_names = constants("include/constants/items.h", "ITEM_")
+    move_ids = {name: value for value, name in move_names.items()}
+    move_pp = {
+        move_ids[name]: int(pp)
+        for name, pp in re.findall(r"\[(MOVE_\w+)\]\s*=\s*\{.*?\.pp = (\d+),.*?\}", (ROOT / "src/data/battle_moves.h").read_text(), re.S)
+        if name in move_ids
+    }
+    # Read the actual GetSubstruct mappings instead of assuming a permutation convention.
+    permutations = {
+        int(number): tuple(map(int, values))
+        for number, *values in re.findall(
+            r"SUBSTRUCT_CASE\(\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\)",
+            (ROOT / "src/pokemon.c").read_text(),
+        )
+    }
+    if len(permutations) != 24 or any(set(order) != {0, 1, 2, 3} for order in permutations.values()):
+        raise ValueError("Native GetSubstruct mapping changed")
+    count = block[0x34]
+    if count not in range(1, 7):
+        raise ValueError(f"Invalid playable party count: {count}; expected 1–6")
+    party = [decode_mon(block[0x38 + index * 100:0x38 + (index + 1) * 100], index + 1,
+                        permutations, species_names, move_names, item_names, move_pp) for index in range(count)]
+    result.update({"readOnly": True, "partyCount": count, "party": party,
+                   "validationScope": "Matching native SaveBlock1 sectors 1/2 and party BoxPokemon checksums; native Continue remains required."})
+    errors = []
+    for mon in party:
+        if not mon["boxChecksum"]["valid"] or mon["isBadEgg"] or not mon["hasSpecies"]:
+            errors.append(f"Party slot {mon['slot']} has invalid BoxPokemon data")
+        if mon["speciesSymbol"] == "UNKNOWN" or mon["species"] == 0:
+            errors.append(f"Party slot {mon['slot']} has an unknown/empty species")
+        if any(move["maxPP"] is None or move["pp"] > move["maxPP"] for move in mon["moves"]):
+            errors.append(f"Party slot {mon['slot']} has invalid move/PP data")
+    if args.expect_species is not None:
+        expected = [int(value.strip(), 0) for value in args.expect_species.split(",")]
+        if [mon["species"] for mon in party] != expected:
+            errors.append(f"Unexpected ordered species; expected {expected}")
+    if args.expect_level is not None and any(mon["level"] != args.expect_level for mon in party):
+        errors.append(f"Expected every party member at level {args.expect_level}")
+    if args.baseline:
+        _, baseline = read_save(args.baseline)
+        unchanged = {name: value == baseline["rawVariables"][name] for name, value in result["rawVariables"].items()}
+        result["baselineVariables"] = {"sha256": baseline["sha256"], "saveCounter": baseline["saveCounter"],
+                                       "rawVariables": baseline["rawVariables"], "unchanged": unchanged,
+                                       "allUnchanged": all(unchanged.values())}
+        if not all(unchanged.values()):
+            errors.append("Saved variables changed from baseline: " + ", ".join(name for name, same in unchanged.items() if not same))
+    result["validationErrors"] = errors
+    print(json.dumps(result, indent=2))
+    return 1 if errors else 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (OSError, ValueError, struct.error) as error:
+        raise SystemExit(str(error))
