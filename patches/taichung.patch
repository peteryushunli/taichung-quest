+        generalMetatileRemap='identity',pewterMetatileRemap={str(n):n for n in retained},
+        colorMetatileRemaps=kit['budget']['colorMetatileRemaps'],
+        sourceGeneralHashes={name:hashlib.sha256((GENERAL/name).read_bytes()).hexdigest() for name in ('tiles.png','metatiles.bin','metatile_attributes.bin')},
