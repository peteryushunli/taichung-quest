+def banks(source, kit_ref=KIT_REF):
+    out = {name: Tiles(source, *spec[:2]) for name, spec in landmark_tiles.BANKS.items()}
+    kit, sha = kit_source(source, kit_ref)
+    out["Old City North"] = Tiles(kit, "gTileset_TaichungOldCorePrimary", "gTileset_TaichungOldCore", fresh=True)
+    out["Old City North"].kit = sha
+    return out
+
+
+def redraw(source, kit_ref=KIT_REF):
+    """Landmark number -> built Piece."""
+    b = banks(source, kit_ref)
+    return {n: fn(b[bank]) for n, (_, bank, fn) in LANDMARKS.items()}
+
+
+def sheet(rows):
+    """Plan art beside the tile-efficient redraw, at 3x, with the counts."""
+    s, f = 3, landmark_tiles.font
+    width = max(a.width + b.width for _, a, b, _ in rows) * s + 380
+    height = sum(max(a.height, b.height) * s + 60 for _, a, b, _ in rows) + 70
+    out = Image.new("RGB", (width, height), "#f4f5f2")
+    d = ImageDraw.Draw(out)
+    d.text((16, 14), "Tile-efficient redraws: board plan art (left) and the redraw on real tiles (right)", font=f(20), fill="#1e1e1e")
+    y = 60
+    for title, plan, real, lines in rows:
+        d.text((16, y), title, font=f(16), fill="#1e1e1e")
+        out.paste(plan.resize((plan.width * s, plan.height * s), Image.NEAREST), (16, y + 26))
+        out.paste(real.resize((real.width * s, real.height * s), Image.NEAREST), (32 + plan.width * s, y + 26))
+        for i, line in enumerate(lines):
+            d.text((48 + (plan.width + real.width) * s, y + 30 + i * 20), line, font=f(13), fill="#1e1e1e")
+        y += max(plan.height, real.height) * s + 60
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[3])
+    parser.add_argument("--plan-dir", type=Path, default=Path("/Users/peter/devday_hackathon/artifacts/city-rework"))
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--sheet", type=Path, help="also write the comparison sheet here")
+    parser.add_argument("--kit-ref", default=KIT_REF, help="git ref holding the city kit (default %(default)s)")
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    pieces = landmark_tiles.load_setpieces(args.plan_dir)
+    result, rows, banks_used = {}, [], {}
+    for n, piece in redraw(args.source, args.kit_ref).items():
+        name, bank, _ = LANDMARKS[n]
+        piece.render.save(args.output_dir / f"{n}-redraw.png")
+        result[n] = {"name": name, "bank": bank, **piece.stats}
+        if bank == "Old City North":
+            result[n]["kit"] = piece.bank.kit
+        print(n, name, piece.stats)
+        banks_used.setdefault(bank, set()).update(piece.secondary_tiles)
+        art = pieces[name](piece.w, piece.h)
+        plan = Image.alpha_composite(Image.new("RGBA", art.size, (234, 223, 196, 255)), art).convert("RGB")
+        lines = [f"{bank} bank", f"new 8x8 tiles: {piece.stats['newTiles']}", f"new metatiles: {piece.stats['newMetatiles']}",
+                 f"palette: {', '.join(map(str, piece.stats['palettes']))} (no new palette)"]
+        if bank == "Old City North":
+            lines += [f"copied from Old City: {piece.stats['copiedFromOldCore']}",
+                      f"slots in the new secondary: {piece.stats['newSecondaryTiles']}"]
+        rows.append((f"{n} {name}", plan, piece.render, lines))
+    totals = {bank: {"secondaryTilesShared": len(keys)} for bank, keys in banks_used.items()}
+    print(json.dumps(totals))
+    (args.output_dir / "landmark-redraw.json").write_text(json.dumps({"landmarks": result, "banks": totals}, indent=1) + "\n")
+    image = sheet(rows)
+    image.save(args.output_dir / "landmark-redraws.png")
+    if args.sheet:
+        image.save(args.sheet)
+
+
+if __name__ == "__main__":
+    main()
