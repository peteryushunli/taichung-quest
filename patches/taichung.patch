@@ -0,0 +1,321 @@
+#!/usr/bin/env python3
+"""Xitun on the city-rework master plan: the map words, cell for cell.
+
+Reads today's Xitun map, its signs and the installed city kit (all from BASE
+once installed: pass --rev) and the fill plan in data/taichung/xitun-rework/
+fill.json, and writes, to an output directory, the draft words, a PNG at 16 px
+per tile in the plan's world coordinates, and a labelled copy. It never writes
+to the source tree; install_xitun.py installs the same words.
+
+The map is 45x69, covering world tiles (-5,-5) to (40,64):
+  - the six-lane highway on world columns -5..0 and rows -5..0, the north one
+    crossing over the west one at the corner, raised behind the kit's
+    retaining wall on columns 1-2 and rows 1-2 (the 2026-11-09 board);
+  - S1 (asphalt rows 16-18) and S2 (rows 48-50) from a kerb at x 3, where
+    their sidewalk wraps across the end with bollards, to the Greenway seam,
+    and X26 (asphalt columns 26-28) from S1 to the Nantun North seam, all in
+    kit pieces with crosswalks where they meet;
+  - every other cell from fill.json's copy of the coordinator's plan-cells
+    (the 2026-11-09 fill pass): Fengjia, the Maple Garden pond and the Theater
+    keep today's art on the plan's landmark cells; city paving, the Maple
+    Garden park (tree ring, tall grass, the path to the pond's door), hedges
+    and the plan's trees take one fixed piece each; every building lot holds
+    one of fill.json's buildings, today's stall, kiosk or Shen Ji home art
+    stretched to the lot;
+  - signposts on today's sign cells, except Maple Garden's, which moves from
+    the park's tall grass to the path's mouth (SIGN_MOVES).
+The 7 columns and 7 rows beside the Greenway and Nantun North seams hold
+primary and kit pieces only, since those maps draw them with their own
+tilesets: no Shen Ji home stands there.
+
+  draft_xitun.py OUT_DIR [--rev REV]
+"""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+MAP = "data/layouts/TaichungXitun/map.bin"
+MAP_JSON = "data/maps/TaichungXitun/map.json"
+KIT = "data/taichung/city-kit/kit.json"
+FILL = "data/taichung/xitun-rework/fill.json"
+WIDTH, HEIGHT = 40, 64
+GROW = 5                      # columns west and rows north
+DRAFT_W, DRAFT_H = WIDTH + GROW, HEIGHT + GROW
+WALK, SOLID = 0x3000, 0x0400
+SIDEWALK = 0x175
+S1, S2, X26 = 16, 48, 26      # first asphalt row/column (master plan)
+FENGJIA_ARRIVAL = (24, 15)
+# One piece per plan class (today's words for them; city paving is new here).
+FILL_WORDS = {".": WALK | 0x16E, "p": WALK | SIDEWALK, "g": WALK | 0x001, "G": WALK | 0x00D, "h": SOLID | 0x005}
+TREE = ((SOLID | 0x00E, SOLID | 0x00F), (SOLID | 0x016, SOLID | 0x017))
+SIGNPOST = WALK | SOLID | 0x003
+# Building art in today's map (top-left, size): stretched across a lot by
+# repeating the middle columns, and a stall one row taller by doubling its roof.
+BUILDINGS = {"stall": ((34, 33), (4, 3)), "kiosk": ((34, 28), (4, 4)), "home": ((30, 20), (4, 4))}
+TALL_STALL_ROWS = (0, 0, 1, 2)
+# World cells: today's Maple Garden sign stands in what is now the park's tall
+# grass, so it moves to the short grass where the path meets X26's sidewalk.
+SIGN_MOVES = {(9, 34): (24, 33)}
+# The wall's kit piece for each world cell of the plan's W: the west wall's
+# top runs up to the highway at x 1 (the inner corner), its planted bank lies
+# at x 2, and the north wall's face fills rows 1 and 2.
+def wall_piece(x, y):
+    if x == 1:
+        return "wall-w-top"
+    if x == 2 and y >= 3:
+        return "wall-w-bank"
+    return "wall-n-upper" if y == 1 else "wall-n-lower"
+
+
+# Greenway draws Xitun's last 7 columns and Nantun North its last 7 rows with
+# their own tilesets (preview_carry.strip), so both strips hold primary and kit
+# pieces only, as Nantun keeps its own first 7 rows.
+EAST_STRIP, SOUTH_STRIP = WIDTH - 7, HEIGHT - 7
+VIEWERS = {"greenway": ("gTileset_TaichungGreenwayPrivate", "gTileset_TaichungGreenwayCmp", 40, 109, "left"),
+           "north": ("gTileset_TaichungGreenwayPrivate", "gTileset_TaichungNantunNorth", 45, 40, "up")}
+LABELS = {"Fengjia Night Market": (18, 8), "Maple Garden": (5, 24), "Taichung Theater": (5, 37),
+          "S1": (6, 17), "S2": (6, 49), "X26": (27, 34), "Freeway (unnamed)": (-4, 30), "Highway (unnamed)": (8, -4)}
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def columns(width):
+    """Template columns for a building `width` wide: the ends once, the middle
+    pair repeated, and the second middle column again for an odd width."""
+    return [0] + [1, 2] * ((width - 2) // 2) + [2] * (width % 2) + [3]
+
+
+def signs(read):
+    """World cells of today's signs, after SIGN_MOVES."""
+    return [SIGN_MOVES.get((e["x"], e["y"]), (e["x"], e["y"]))
+            for e in json.loads(read(MAP_JSON))["bg_events"] if e["type"] == "sign"]
+
+
+def draft(source=ROOT, read=None, fill=None):
+    """(words in draft order, kit IDs, changed cells inside today's map).
+    read(path) gives today's files (the tree's by default; install_xitun.py
+    reads its BASE); fill is fill.json (the tree's by default)."""
+    read = read or (lambda path: (source / path).read_bytes())
+    fill = fill or json.loads((source / FILL).read_text())
+    raw = read(MAP)
+    today = list(struct.unpack(f"<{len(raw) // 2}H", raw))
+    ids = {k: int(v, 16) for k, v in json.loads(read(KIT))["metatiles"].items()}
+    ox, oy = fill["origin"]
+    plan = {(x + ox, y + oy): c for y, row in enumerate(fill["rows"]) for x, c in enumerate(row)}
+    assert (ox, oy) == (-GROW, -GROW) and len(plan) == DRAFT_W * DRAFT_H, "fill.json does not cover Xitun"
+    grid = {}
+
+    def put(x, y, name_or_id, solid=False):
+        mid = ids[name_or_id] if isinstance(name_or_id, str) else name_or_id
+        grid[(x, y)] = (SOLID if solid else WALK) | mid
+
+    def east_west(row, x0, x1):
+        for x in range(x0, x1 + 1):
+            for i, name in enumerate((SIDEWALK, "st-asphalt", "st-ew-centre", "st-asphalt", SIDEWALK)):
+                put(x, row - 1 + i, name)
+
+    def north_south(col, y0, y1):
+        for y in range(y0, y1 + 1):
+            for i, name in enumerate((SIDEWALK, "st-asphalt", "st-ns-centre", "st-asphalt", SIDEWALK)):
+                put(col - 1 + i, y, name)
+
+    def crossing(row, col, north=True, south=True):
+        for x in range(col, col + 3):
+            for y in range(row, row + 3):
+                put(x, y, "st-asphalt")
+            for y, open_side in ((row - 1, north), (row + 3, south)):
+                put(x, y, "st-ns-crosswalk" if open_side else SIDEWALK)
+        for y in range(row, row + 3):
+            put(col - 1, y, "st-ew-crosswalk"); put(col + 3, y, "st-ew-crosswalk")
+        for x, y in ((col - 1, row - 1), (col + 3, row - 1), (col - 1, row + 3), (col + 3, row + 3)):
+            put(x, y, SIDEWALK)
+
+    east_west(S1, 3, 39)
+    east_west(S2, 3, 39)
+    north_south(X26, S1 + 4, HEIGHT - 1)
+    crossing(S1, X26, north=False)
+    crossing(S2, X26)
+    # S1 and S2 stop at a kerb against the west wall: bollards across x 3,
+    # facing the asphalt to the east.
+    for row in (S1, S2):
+        for y in range(row, row + 3):
+            put(3, y, "st-bollards-e")
+    streets = set(grid)
+    assert streets == {p for p, c in plan.items() if c in "Ss"}, "The plan's streets are not S1, S2 and X26"
+
+    # The highway: lanes 0-5 on world columns -5..0 and rows -5..0. Where they
+    # meet, the north highway crosses over the west one: a parapet on its
+    # south lane, the deck's shadow on row 1.
+    for (x, y), c in plan.items():
+        if x > 0 and y > 0:
+            assert c != "H", f"highway outside the band at {x},{y}"
+            continue
+        assert c == "H", f"the highway band holds {c!r} at {x},{y}"
+        lane_x, lane_y = x + GROW, y + GROW
+        if x <= 0 and y == 0:
+            name = "hw-ew-5-parapet"
+        elif x <= 0 and y == 1:
+            name = f"hw-ns-{lane_x}-under-n"
+        elif x <= 0 and y > 0:
+            car = {0: "blue", 1: "red", 2: "maroon", 3: "red", 4: "blue", 5: "maroon"}[lane_x]
+            name = f"hw-ns-{lane_x}-car-{car}" if (y * 3 + lane_x * 5) % 11 == 0 else f"hw-ns-{lane_x}"
+        else:
+            car = {0: "red", 1: "maroon", 2: "blue", 3: "blue", 4: "red", 5: "maroon"}[lane_y]
+            name = f"hw-ew-{lane_y}-car-{car}" if (x * 5 + lane_y * 3) % 13 == 0 else f"hw-ew-{lane_y}"
+        grid[(x, y)] = SOLID | ids[name]
+    # The retaining wall on the highway's city side.
+    for (x, y), c in plan.items():
+        on_wall = (x in (1, 2) and y >= 1) or (y in (1, 2) and x >= 1)
+        assert (c == "W") == on_wall, f"the wall is not columns 1-2 and rows 1-2 at {x},{y}"
+        if on_wall:
+            grid[(x, y)] = SOLID | ids[wall_piece(x, y)]
+
+    # Everything else follows the plan.
+    for (x, y), c in plan.items():
+        if (x, y) in grid or c == "B":
+            continue
+        if c == "L":
+            grid[(x, y)] = today[y * WIDTH + x]
+        elif c in FILL_WORDS:
+            grid[(x, y)] = FILL_WORDS[c]
+        elif c == "T":
+            for dy in (0, 1):
+                for dx in (0, 1):
+                    assert plan[(x + dx, y + dy)] == ("T" if dx == dy == 0 else "t"), f"broken tree at {x},{y}"
+                    grid[(x + dx, y + dy)] = TREE[dy][dx]
+        elif c != "t":
+            raise AssertionError(f"plan class {c!r} at {x},{y}")
+    for kind, x0, y0, w, h in fill["buildings"]:
+        (tx, ty), (tw, th) = BUILDINGS[kind]
+        rows = range(th) if h == th else TALL_STALL_ROWS if (kind, h) == ("stall", 4) else None
+        assert rows is not None and w >= tw, f"{kind} cannot be {w}x{h}"
+        for dy, ry in enumerate(rows):
+            for dx, rx in enumerate(columns(w)):
+                assert plan[(x0 + dx, y0 + dy)] == "B" and (x0 + dx, y0 + dy) not in grid, f"{kind} at {x0},{y0} leaves its lot"
+                grid[(x0 + dx, y0 + dy)] = SOLID | today[(ty + ry) * WIDTH + tx + rx] & 0x3FF
+    missing = [p for p, c in plan.items() if p not in grid]
+    assert not missing, f"lots without a building: {missing[:6]}"
+    for x, y in signs(read):
+        assert plan[(x, y)] in "L.g" and (x, y) not in streets, f"sign at {x},{y} on {plan[(x, y)]!r}"
+        grid[(x, y)] = SIGNPOST
+    changed = sorted(p for p in grid if 0 <= p[0] < WIDTH and 0 <= p[1] < HEIGHT and grid[p] != today[p[1] * WIDTH + p[0]])
+    words = [grid[(x - GROW, y - GROW)] for y in range(DRAFT_H) for x in range(DRAFT_W)]
+    return words, ids, changed
+
+
+def walkable(words, x, y):
+    return 0 <= x < DRAFT_W and 0 <= y < DRAFT_H and not words[y * DRAFT_W + x] & 0x0C00
+
+
+def check(words):
+    """Every walkable cell reachable from Fengjia's arrival; door approaches
+    and arrivals walkable."""
+    start = (FENGJIA_ARRIVAL[0] + GROW, FENGJIA_ARRIVAL[1] + GROW)
+    seen, todo = {start}, [start]
+    while todo:
+        x, y = todo.pop()
+        for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+            if n not in seen and walkable(words, *n):
+                seen.add(n); todo.append(n)
+    open_cells = {(x, y) for y in range(DRAFT_H) for x in range(DRAFT_W) if walkable(words, x, y)}
+    problems = []
+    if open_cells - seen:
+        problems.append(f"unreachable: {sorted(open_cells - seen)[:10]}")
+    for x, y in [(24, 13), (24, 15), (12, 33), (12, 35), (12, 45), (12, 47)]:
+        if not walkable(words, x + GROW, y + GROW):
+            problems.append(f"blocked approach or arrival at world {x},{y}")
+    east = [y - GROW for y in range(DRAFT_H) if walkable(words, DRAFT_W - 1, y)]
+    south = [x - GROW for x in range(DRAFT_W) if walkable(words, x, DRAFT_H - 1)]
+    return {"walkable": len(open_cells), "reachable": len(seen), "problems": problems,
+            "eastSeamWalkableRows": east, "southSeamWalkableColumns": south}
+
+
+def strips(words, source):
+    """Cells of the seam strips (world coordinates) that a neighbour would draw
+    differently: any secondary piece, or a primary piece its primary draws
+    otherwise."""
+    carry = load("preview_carry", source / "tools/taichung/nantun/preview_carry.py")
+    mine = (carry.Bank.load("gTileset_TaichungXitunPrivatePrimary", range(7)),
+            carry.Bank.load("gTileset_TaichungXitunFinal", carry.SECONDARY_PALETTES))
+    out = {}
+    for name, (primary, secondary, width, height, direction) in VIEWERS.items():
+        theirs = carry.Bank.load(primary, range(7)), carry.Bank.load(secondary, carry.SECONDARY_PALETTES)
+        bad = []
+        for x, y in carry.strip(width, height, DRAFT_W, DRAFT_H, direction, 0):
+            n = words[y * DRAFT_W + x] & 0x3FF
+            if n >= 640 or carry.render(*mine, n) != carry.render(*theirs, n):
+                bad.append([x - GROW, y - GROW])
+        out[name] = bad
+    return out
+
+
+def render(words, source, out_dir):
+    from PIL import Image, ImageDraw
+    maps = load("render_maps", source / "tools/taichung/render_maps.py")
+    layouts = json.loads((source / "data/layouts/layouts.json").read_text())["layouts"]
+    layout = next(l for l in layouts if l and l.get("id") == "LAYOUT_TAICHUNG_XITUN")
+    tiles = maps.render_metatiles(source, layout["primary_tileset"], layout["secondary_tileset"])
+    image = Image.new("RGB", (DRAFT_W * 16, DRAFT_H * 16))
+    for n, word in enumerate(words):
+        image.paste(tiles[word & 0x3FF], (n % DRAFT_W * 16, n // DRAFT_W * 16))
+    image.save(out_dir / "xitun.png")
+    labelled = image.resize((image.width * 2, image.height * 2), Image.NEAREST)
+    draw = ImageDraw.Draw(labelled)
+    for text, (x, y) in LABELS.items():
+        px, py = (x + GROW) * 32, (y + GROW) * 32
+        draw.text((px + 4, py + 4), text, fill="white", stroke_width=3, stroke_fill="black")
+    for x in range(0, DRAFT_W, 5):
+        draw.text(((x) * 32 + 2, 2), str(x - GROW), fill="yellow", stroke_width=2, stroke_fill="black")
+    for y in range(0, DRAFT_H, 5):
+        draw.text((2, y * 32 + 2), str(y - GROW), fill="yellow", stroke_width=2, stroke_fill="black")
+    labelled.save(out_dir / "xitun-labelled.png")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("out", type=Path)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--rev", help="read today's map, signs and kit from this git revision")
+    args = parser.parse_args()
+    read = None
+    if args.rev:
+        read = lambda path: subprocess.run(["git", "-C", str(args.source), "show", f"{args.rev}:{path}"],
+                                           check=True, capture_output=True).stdout
+    words, ids, changed = draft(args.source, read)
+    report = check(words)
+    report["seamStripMismatches"] = strips(words, args.source)
+    report["problems"] += [f"{name} strip draws {len(cells)} cells differently, e.g. {cells[:3]}"
+                           for name, cells in report["seamStripMismatches"].items() if cells]
+    args.out.mkdir(parents=True, exist_ok=True)
+    (args.out / "xitun-draft.bin").write_bytes(struct.pack(f"<{len(words)}H", *words))
+    raw = read(MAP) if read else (args.source / MAP).read_bytes()
+    today = struct.unpack(f"<{len(raw) // 2}H", raw)
+    # Cells walkable today and blocked in the draft (world coordinates), for
+    # the save relocation; positions otherwise shift by (+5, +5).
+    blocked = [[x, y] for y in range(HEIGHT) for x in range(WIDTH)
+               if not today[y * WIDTH + x] & 0x0C00 and not walkable(words, x + GROW, y + GROW)]
+    names = {v: k for k, v in ids.items()}
+    used = sorted({names[w & 0x3FF] for w in words if (w & 0x3FF) in names})
+    (args.out / "xitun-draft.json").write_text(json.dumps({
+        "planRect": [-GROW, -GROW, WIDTH, HEIGHT], "size": [DRAFT_W, DRAFT_H],
+        "localToWorld": [-GROW, -GROW], "words": "xitun-draft.bin (little-endian u16, row-major)",
+        "changedCellsInsideToday": len(changed), "kitPiecesUsed": used, "signMoves": {f"{x},{y}": list(v) for (x, y), v in SIGN_MOVES.items()},
+        "mapBufferCells": (DRAFT_W + 15) * (DRAFT_H + 14), "newlyBlocked": blocked, **report}, indent=1) + "\n")
+    render(words, args.source, args.out)
+    print(json.dumps({k: report[k] for k in ("walkable", "reachable", "problems")}))
+    raise SystemExit(1 if report["problems"] else 0)
+
+
+if __name__ == "__main__":
+    main()
