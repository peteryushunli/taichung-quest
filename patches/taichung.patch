+                struct SaveBlock1 before;
+                Reset(maps[m],x,y);before=sSave;
+                TaichungNorthXitunRepairOnContinue();
+                assert(sPending==(e!=NULL) && sRequests==(e!=NULL));
+                if (e)
+                    assert(sSave.continueGameWarp.mapGroup==43 && sSave.continueGameWarp.mapNum==maps[m]
+                           && sSave.continueGameWarp.warpId==-1 && sSave.continueGameWarp.x==e->toX && sSave.continueGameWarp.y==e->toY);
+                Protected(before,e!=NULL);
+                before=sSave;TaichungNorthXitunRepairOnContinue();Protected(before,FALSE);
+                assert(sRequests==(e!=NULL)); // Idempotent, no second warp request.
+
+                Reset(76,14,38);sPending=TRUE;
+                sSave.continueGameWarp=(struct WarpData){43,maps[m],-1,x,y};before=sSave;
+                TaichungNorthXitunRepairOnContinue();assert(sPending && !sRequests);
+                if (e) assert(sSave.continueGameWarp.x==e->toX && sSave.continueGameWarp.y==e->toY);
+                Protected(before,e!=NULL);
+            }
+    for (i=0;i<sizeof(sExpected)/sizeof(sExpected[0]);i++)
+    {
+        const struct Expected *e=&sExpected[i];struct SaveBlock1 before;
+        for (v=0;v<=13;v++)
+        {
+            if (v==12) continue;
+            Reset(e->map,e->x,e->y);sSave.vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START]=v;before=sSave;
+            TaichungNorthXitunRepairOnContinue();assert(!sPending && !sRequests);Protected(before,FALSE);
+        }
+        Reset(e->map,e->x,e->y);sSave.playerPartyCount=0;before=sSave;
+        TaichungNorthXitunRepairOnContinue();assert(!sPending && !sRequests);Protected(before,FALSE);
+        // A native pending door return wins even when the current tile is bad.
+        for (v=0;v<3;v++)
+        {
+            Reset(e->map,e->x,e->y);sPending=TRUE;
+            sSave.continueGameWarp=(struct WarpData){43,e->map,v,e->x,e->y};before=sSave;
+            TaichungNorthXitunRepairOnContinue();assert(sPending && !sRequests);Protected(before,FALSE);
+        }
+        // A safe pending destination wins over an invalid current position.
+        Reset(e->map,e->x,e->y);sPending=TRUE;
+        sSave.continueGameWarp=(struct WarpData){43,e->map,-1,e->toX,e->toY};before=sSave;
+        TaichungNorthXitunRepairOnContinue();assert(sPending && !sRequests);Protected(before,FALSE);
+        // The same x/y in every other map/group is outside this repair's scope.
+        for (m=0;m<128;m++)
+        {
+            if (m==27 || m==35 || m==36 || m==29) continue;
+            Reset(m,e->x,e->y);before=sSave;TaichungNorthXitunRepairOnContinue();
+            assert(!sPending && !sRequests);Protected(before,FALSE);
+        }
+        Reset(e->map,e->x,e->y);sSave.location.mapGroup=42;before=sSave;
+        TaichungNorthXitunRepairOnContinue();assert(!sPending && !sRequests);Protected(before,FALSE);
+        // A stale location.x/y never overrides a safe actual saved pos.
+        Reset(e->map,e->toX,e->toY);sSave.location.x=e->x;sSave.location.y=e->y;before=sSave;
+        TaichungNorthXitunRepairOnContinue();assert(!sPending && !sRequests);Protected(before,FALSE);
+    }
+    gSaveBlock1Ptr=NULL;TaichungNorthXitunRepairOnContinue();
+    printf("PASS: %u compiled native exact-cell Continue cases; exactly96 repairs preserving earlier95, current/pending paths, idempotence, native return priority, protected save bytes, other positions/versions/groups/no-party unchanged\n",sCases);
+    return 0;
+}
diff --git a/tests/taichung_optional_story_test.c b/tests/taichung_optional_story_test.c
new file mode 100644
index 00000000..3bf55d80
--- /dev/null
+++ b/tests/taichung_optional_story_test.c
@@ -0,0 +1,171 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_optional_story.h"
+
+u8 gStringVar4[1024];
+u16 gSpecialVar_0x8004, gSpecialVar_0x8005, gSpecialVar_0x8006, gSpecialVar_Result;
+static struct SaveBlock1 sSave, sBefore;
+static struct SaveBlock2 sOptions, sOptionsBefore;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct SaveBlock2 *gSaveBlock2Ptr = &sOptions;
+static u8 sStorage[0x83D0], sStorageBefore[0x83D0];
+static bool8 sChinese;
+static u16 sQuestionId;
+
+// Independent, fixed semantic roster. Maple history8 is informational/capture0;
+// Muqing gym8 selects Wanhe history11. These are not inferred from current data.
+static const u16 sExpectedLeader[] = {0,1,2,3,4,5,6,7,0xFFFF,9,0xFFFF,8,0xFFFF,0xFFFF,0xFFFF,0xFFFF,0xFFFF,0xFFFF,0xFFFF,0xFFFF};
+static const u8 sExpectedSite[] = {255,255,255,255,255,255,255,255,0,255,1,255,2,3,4,5,6,7,8,9};
+static const u16 sGymToHistory[] = {0,1,2,3,4,5,6,7,11,9};
+
+const u8 *TaichungText(const u8 *english, const u8 *chinese)
+{
+    return sChinese ? chinese : english;
+}
+
+u8 *StringCopy(u8 *dest, const u8 *src)
+{
+    size_t count = strlen((const char *)src);
+    assert(dest == gStringVar4 && count < sizeof(gStringVar4));
+    memcpy(dest, src, count + 1);
+    return dest + count;
+}
+
+static void Question(u16 gymId)
+{
+    assert(gSpecialVar_0x8004 == gymId);
+    assert(gSpecialVar_0x8006 == sGymToHistory[gymId]);
+    assert(gSpecialVar_0x8005 == 0);
+    sQuestionId = gymId;
+    StringCopy(gStringVar4, (const u8 *)"original question");
+}
+void TaichungGym_ScriptGetStationMessage(void) { Question(0); }
+void TaichungGym_ScriptGetParkMessage(void) { Question(1); }
+void TaichungGym_ScriptGetMiyaharaMessage(void) { Question(2); }
+void TaichungGym_ScriptGetScienceMessage(void) { Question(3); }
+void TaichungGym_ScriptGetGreenwayMessage(void) { Question(4); }
+void TaichungGym_ScriptGetShenJiMessage(void) { Question(5); }
+void TaichungGym_ScriptGetFineArtsMessage(void) { Question(6); }
+void TaichungGym_ScriptGetFengjiaMessage(void) { Question(7); }
+void TaichungGym_ScriptGetMapleGardenMessage(void) { Question(8); }
+void TaichungGym_ScriptGetTheaterMessage(void) { Question(9); }
+static void (*const sQuestionApis[])(void) = {TaichungGym_ScriptGetStationMessage,TaichungGym_ScriptGetParkMessage,TaichungGym_ScriptGetMiyaharaMessage,TaichungGym_ScriptGetScienceMessage,TaichungGym_ScriptGetGreenwayMessage,TaichungGym_ScriptGetShenJiMessage,TaichungGym_ScriptGetFineArtsMessage,TaichungGym_ScriptGetFengjiaMessage,TaichungGym_ScriptGetMapleGardenMessage,TaichungGym_ScriptGetTheaterMessage};
+
+static void AssertUnchanged(u16 callerId, u16 selectedHistory, u16 result)
+{
+    assert(memcmp(&sSave, &sBefore, sizeof(sSave)) == 0);
+    assert(memcmp(&sOptions, &sOptionsBefore, sizeof(sOptions)) == 0);
+    assert(memcmp(sStorage, sStorageBefore, sizeof(sStorage)) == 0);
+    assert(gSpecialVar_0x8004 == callerId);
+    assert(gSpecialVar_0x8005 == 0);
+    assert(gSpecialVar_0x8006 == selectedHistory);
+    assert(gSpecialVar_Result == result);
+}
+
+int main(void)
+{
+    u16 id, complete, namespaceCase, topic, selected;
+    u8 locale;
+    unsigned count = 0;
+    static const u16 gymMasks[] = {0, 1 << 8, 0x3FF};
+    static const u16 namespaces[][3] = {
+        {0,0,0}, {0xEC01,0,0}, {0xEC01,3,2}, {0xEC01,0x3FFF,0x3FFF},
+        {0xEC01,0x8001,0x4002}, {0xDEAD,0x8002,0x4001}, {0,3,2}
+    };
+    assert(gTaichungOptionalStoryCount == 20);
+    for (id = 0; id < 20; id++)
+    {
+        const struct TaichungOptionalStory *record = &gTaichungOptionalStories[id];
+        assert(record->historyId == id);
+        assert(record->leaderGymId == sExpectedLeader[id]);
+        assert(record->encounterSite == sExpectedSite[id]);
+        assert(record->leaderQuestion == (sExpectedLeader[id] == 0xFFFF ? NULL : sQuestionApis[sExpectedLeader[id]]));
+    }
+    for (locale = 0; locale < 2; locale++)
+    for (complete = 0; complete < ARRAY_COUNT(gymMasks); complete++)
+    for (namespaceCase = 0; namespaceCase < ARRAY_COUNT(namespaces); namespaceCase++)
+    {
+        memset(&sSave,0x5A,sizeof(sSave));
+        memset(&sOptions,0xA5,sizeof(sOptions));
+        memset(sStorage,0x69,sizeof(sStorage));
+        sSave.vars[0xF3] = namespaces[namespaceCase][0];
+        sSave.vars[0xF4] = namespaces[namespaceCase][1];
+        sSave.vars[0xF5] = namespaces[namespaceCase][2];
+        sSave.vars[0xFA] = gymMasks[complete];
+        sSave.vars[0xFB] = locale + 1;
+        sChinese = locale;
+        sBefore = sSave; sOptionsBefore = sOptions;
+        memcpy(sStorageBefore,sStorage,sizeof(sStorage));
+        for (id = 0; id < 25; id++)
+        {
+            gSpecialVar_0x8004 = id; gSpecialVar_0x8005 = 0;
+            gSpecialVar_0x8006 = 0xCAFE; gSpecialVar_Result = 0xBEEF;
+            TaichungStory_ScriptHasPackage();
+            selected = id < 20 ? id : 0xFFFF;
+            assert(gSpecialVar_Result == (id < 20));
+            assert(gSpecialVar_0x8006 == selected);
+            TaichungStory_ScriptHasGarden();
+            assert(gSpecialVar_Result == (id == 3));
+            gSpecialVar_Result = 0xBEEF;
+            for (topic = TAICHUNG_STORY_SIGN; topic <= TAICHUNG_STORY_STAFF_CREDIT; topic++)
+            {
+                const u8 *text = TaichungStoryGetText(id,topic);
+                assert(text != NULL && text[0] != 0);
+                if (id < 20 && (topic != TAICHUNG_STORY_GARDEN || id == 3))
+                {
+                    const struct TaichungOptionalStory *record = &gTaichungOptionalStories[id];
+                    const u8 *expected = topic == TAICHUNG_STORY_SIGN ? record->sign[locale]
+                        : topic == TAICHUNG_STORY_ABOUT ? record->about[locale]
+                        : topic == TAICHUNG_STORY_STAFF ? record->staff[locale]
+                        : topic == TAICHUNG_STORY_GARDEN ? record->garden[locale] : record->staffCredit[locale];
+                    assert(text == expected);
+                }
+            }
+            assert(TaichungStoryGetText(id,0xFF)[0] != 0);
+            TaichungStory_ScriptBufferSign();
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungStoryGetText(selected,TAICHUNG_STORY_SIGN)) == 0);
+            TaichungStory_ScriptBufferAbout();
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungStoryGetText(selected,TAICHUNG_STORY_ABOUT)) == 0);
+            TaichungStory_ScriptBufferStaff();
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungStoryGetText(selected,TAICHUNG_STORY_STAFF)) == 0);
+            TaichungStory_ScriptBufferGarden();
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungStoryGetText(selected,TAICHUNG_STORY_GARDEN)) == 0);
+            TaichungStory_ScriptBufferStaffCredit();
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungStoryGetText(selected,TAICHUNG_STORY_STAFF_CREDIT)) == 0);
+            sQuestionId = 0xFFFF;
+            TaichungStory_ScriptRestoreQuestion();
+            assert(sQuestionId == (id < 10 && id != 8 ? id : 0xFFFF));
+            AssertUnchanged(id,selected,0xBEEF);
+
+            // The same numeric input now denotes a gym. Gym8 MUST select11,
+            // while numeric11 is never a gym despite being a valid story ID.
+            TaichungStory_ScriptHasLeaderPackage();
+            selected = id < 10 ? sGymToHistory[id] : 0xFFFF;
+            assert(gSpecialVar_Result == (id < 10));
+            assert(gSpecialVar_0x8006 == selected);
+            gSpecialVar_Result = 0xBEEF;
+            sQuestionId = 0xFFFF;
+            TaichungStory_ScriptRestoreQuestion();
+            assert(sQuestionId == (id < 10 ? id : 0xFFFF));
+            TaichungStory_ScriptBufferAbout();
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungStoryGetText(selected,TAICHUNG_STORY_ABOUT)) == 0);
+            AssertUnchanged(id,selected,0xBEEF);
+            count++;
+        }
+        gSpecialVar_0x8004 = 0xFFFF;
+        TaichungStory_ScriptHasPackage(); assert(gSpecialVar_Result == FALSE);
+        TaichungStory_ScriptHasLeaderPackage(); assert(gSpecialVar_Result == FALSE);
+        TaichungStory_ScriptHasGarden(); assert(gSpecialVar_Result == FALSE);
+        gSpecialVar_Result = 0xBEEF;
+        TaichungStory_ScriptBufferSign(); TaichungStory_ScriptBufferAbout();
+        TaichungStory_ScriptBufferStaff(); TaichungStory_ScriptBufferGarden();
+        TaichungStory_ScriptBufferStaffCredit(); TaichungStory_ScriptRestoreQuestion();
+        AssertUnchanged(0xFFFF,0xFFFF,0xBEEF);
+    }
+    assert(TaichungStoryGetText(3,TAICHUNG_STORY_STAFF) != TaichungStoryGetText(3,TAICHUNG_STORY_GARDEN));
+    puts("PASS: actual20-place C; independent history/gym/site roster, all text buffers, question dispatch, Maple8/Wanhe11/gym8 and no future activation");
+    printf("PASS: %u protected-state combinations, both locales, mixed gym masks and7 capture namespaces; all saved sentinels unchanged\n",count);
+    return 0;
+}
diff --git a/tests/taichung_peiqi_test.c b/tests/taichung_peiqi_test.c
new file mode 100644
index 00000000..1c2d2d88
--- /dev/null
+++ b/tests/taichung_peiqi_test.c
@@ -0,0 +1,93 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_peiqi.h"
+#include "constants/maps.h"
+#include "constants/event_objects.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool32 sPendingWarp;
+static unsigned sHeaderReads;
+static const struct MapLayout sLayout = {13, 15};
+static const struct ObjectEventTemplate sObjects[] = {
+    {1, OBJ_EVENT_GFX_TAICHUNG_PEIQI}
+};
+static const struct MapEvents sEvents = {1, sObjects};
+static const struct MapHeader sHeader = {&sLayout, &sEvents};
+
+bool32 UseContinueGameWarp(void) { return sPendingWarp; }
+void SetContinueGameWarpStatus(void) { sPendingWarp = TRUE; }
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group, u16 number)
+{
+    assert(group == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(number == MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM));
+    sHeaderReads++;
+    return &sHeader;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.partyBadgesAndOtherSavedData, 0xA5, sizeof(sSave.partyBadgesAndOtherSavedData));
+    sSave.pos.x = 3; sSave.pos.y = 10;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM);
+    sSave.location.warpId = 1;
+    sSave.location.x = 6; sSave.location.y = 13;
+    sSave.objectEventTemplates[0].localId = 1;
+    sSave.objectEventTemplates[0].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+    gSaveBlock1Ptr = &sSave;
+    sPendingWarp = FALSE;
+    sHeaderReads = 0;
+}
+
+static void ExpectUnchanged(void)
+{
+    struct SaveBlock1 before = sSave;
+    TaichungPeiqiRefreshOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+}
+
+int main(void)
+{
+    struct SaveBlock1 before;
+    Reset();
+    before = sSave;
+    TaichungPeiqiRefreshOnContinue();
+    assert(sPendingWarp && sHeaderReads == 1);
+    assert(sSave.continueGameWarp.mapGroup == sSave.location.mapGroup);
+    assert(sSave.continueGameWarp.mapNum == sSave.location.mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == 3 && sSave.continueGameWarp.y == 10);
+    before.continueGameWarp = sSave.continueGameWarp;
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+
+    Reset();
+    sSave.objectEventTemplates[0].localId = 0;
+    TaichungPeiqiRefreshOnContinue();
+    assert(sPendingWarp); // Missing Miyahara host cache also reloads safely.
+
+    Reset();
+    sSave.objectEventTemplates[0] = sObjects[0];
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); sPendingWarp = TRUE;
+    sSave.continueGameWarp.mapGroup = 1;
+    ExpectUnchanged(); assert(sHeaderReads == 0);
+
+    Reset(); sSave.location.mapGroup = 1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.location.mapNum = -1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.pos.x = 13;
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); gSaveBlock1Ptr = NULL;
+    TaichungPeiqiRefreshOnContinue(); assert(sHeaderReads == 0);
+    puts("PASS: stale Peiqi cache refresh at saved position; party/badges preserved; current caches, pending warps, unrelated maps and invalid inputs untouched");
+    return 0;
+}
diff --git a/tests/taichung_player_text_test.c b/tests/taichung_player_text_test.c
new file mode 100644
index 00000000..132569ea
--- /dev/null
+++ b/tests/taichung_player_text_test.c
@@ -0,0 +1,78 @@
+#include "global.h"
+#include "strings.h"
+#include "taichung_language.h"
+#include "taichung_player_text.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static bool8 sChinese;
+const u8 *TaichungText(const u8 *en, const u8 *zh) { return sChinese ? zh : en; }
+const u8 gText_MenuPlayer[] = "{PLAYER}";
+const u8 gText_OakForbidsUseOfItemHere[] = "old-forbidden";
+const u8 gText_PlayerUsedVar2[] = "old-item";
+const u8 gText_UsedVar2WildLured[] = "old-lure";
+const u8 gText_UsedVar2WildRepelled[] = "old-repel";
+const u8 gText_OakThisIsListOfPokemon[] = "old-party";
+const u8 gText_SPc[] = "{PLAYER}'s PC";
+const u8 gString_BattleRecords_PlayersBattleResults[] = "{PLAYER}'s BATTLE RESULTS";
+const u8 gText_PlayerScurriedToCenter[] = "old-center";
+const u8 gText_PlayerScurriedBackHome[] = "old-home";
+const u8 gText_PlayerSavedTheGame[] = "{PLAYER} saved the game.";
+
+int main(void)
+{
+    static const struct { const u8 *original; u16 id; } cases[] = {
+        {gText_MenuPlayer, TAICHUNG_PLAYER_YOU},
+        {gText_OakForbidsUseOfItemHere, TAICHUNG_PLAYER_ITEM_FORBIDDEN},
+        {gText_PlayerUsedVar2, TAICHUNG_PLAYER_FIELD_ITEM},
+        {gText_UsedVar2WildLured, TAICHUNG_PLAYER_WILD_LURED},
+        {gText_UsedVar2WildRepelled, TAICHUNG_PLAYER_WILD_REPELLED},
+        {gText_OakThisIsListOfPokemon, TAICHUNG_PLAYER_PARTY_HELP},
+        {gText_SPc, TAICHUNG_PLAYER_YOUR_PC},
+        {gString_BattleRecords_PlayersBattleResults, TAICHUNG_PLAYER_YOUR_RECORDS},
+        {gText_PlayerScurriedToCenter, TAICHUNG_PLAYER_TO_CENTER},
+        {gText_PlayerScurriedBackHome, TAICHUNG_PLAYER_TO_HOME},
+        {gText_PlayerSavedTheGame, TAICHUNG_PLAYER_SAVED_GAME}
+    };
+    u8 unknown[] = "{PLAYER}'s PC";
+    u8 identity[] = "Walker";
+    u16 id, i;
+
+    for (sChinese = FALSE; sChinese <= TRUE; sChinese++)
+    {
+        for (id = 0; id < TAICHUNG_PLAYER_TEXT_COUNT; id++)
+        {
+            const char *text = (const char *)TaichungPlayerTextGet(id);
+            assert(text != NULL && text[0] != '\0');
+            assert(strstr(text, "{PLAYER}") == NULL);
+            assert(strstr(text, "{B_PLAYER_NAME}") == NULL);
+            assert(strstr(text, "Walker") == NULL);
+            assert(strstr(text, "you's") == NULL && strstr(text, "YOU's") == NULL);
+            assert(strstr(text, "You is") == NULL && strstr(text, "You has") == NULL);
+        }
+        for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+            assert(TaichungPlayerFieldText(cases[i].original) == TaichungPlayerTextGet(cases[i].id));
+        // Identical contents at an unrelated address are not a replacement target.
+        assert(TaichungPlayerFieldText(unknown) == unknown);
+        assert(TaichungPlayerFieldText(identity) == identity);
+        assert(TaichungPlayerFieldText(NULL) == NULL);
+        assert(TaichungPlayerTextGet(TAICHUNG_PLAYER_TEXT_COUNT)[0] == '\0');
+        assert(TaichungPlayerTextGet(0xFFFF)[0] == '\0');
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_GOT_MONEY), "{B_BUFF1}") != NULL);
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_USED_ITEM), "{B_LAST_ITEM}") != NULL);
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_FIELD_ITEM), "{STR_VAR_2}") != NULL);
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_TRAINER_WIN), "{B_TRAINER1_NAME}") != NULL);
+    }
+    sChinese = FALSE;
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_WHITEOUT), "You have no POKéMON\nleft to battle!p") == 0);
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOUR_PC), "YOUR PC") == 0);
+    assert(strcmp((const char *)TaichungPlayerFieldText(gText_PlayerSavedTheGame), "You saved the game.") == 0);
+    sChinese = TRUE;
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOU), "你") == 0);
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOUR_PC), "你的電腦") == 0);
+    assert(strcmp((const char *)TaichungPlayerFieldText(gText_PlayerSavedTheGame), "你儲存了遊戲。") == 0);
+    assert(strcmp((const char *)identity, "Walker") == 0);
+    puts("PASS: complete bilingual second-person templates, field pointer routing and untouched identity fallbacks");
+    return 0;
+}
