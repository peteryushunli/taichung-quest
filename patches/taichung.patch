+                continue
+            first, elevation = x, view.elevation(x, y)
+            while x + 1 < WIDTH and view.walkable(x + 1, y) and view.elevation(x + 1, y) == elevation:
+                x += 1
+            print(f"    {{{y},{first},{x},{elevation}}},")
+            x += 1
+    print("};")
+    print(f"// report passed={report['passed']}", file=sys.stderr)
