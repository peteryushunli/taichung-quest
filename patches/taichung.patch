+#!/usr/bin/env python3
+"""Author the native Taichung blockout, without touching legacy maps or gameplay.
+
+Run only in the mapping checkout. This owns the generated Taichung geometry and
+initial placeholder events; do not rerun over subsequent gameplay/localization
+work without reconciling those changes. Existing map/layout/section IDs are kept.
+"""
+import json
+import struct
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ELEVATION = 3
+GRASS, PAVING, TALL_GRASS, SIGN = 0x001, 0x175, 0x00D, 0x003
+
+DISTRICTS = [
+    ("TaichungOldCity", "OLD_CITY", 40, 72, (80, 48), "OLD TAICHUNG", "MUS_VERMILLION"),
+    ("TaichungGreenway", "GREENWAY", 40, 72, (40, 32), "TAICHUNG GREENWAY", "MUS_PALLET"),
+    ("TaichungXitun", "XITUN", 40, 64, (0, 0), "TAICHUNG XITUN", "MUS_CELADON"),
+]
+
+LANDMARKS = [
+    # Stable ID, room suffix, region, door, arrival, English, Traditional Chinese, source facade.
+    ("old-taichung-station", "OldStation", "OLD_CITY", (32, 64), (30, 66), "Old Taichung Station", "舊臺中車站", "museum"),
+    ("taichung-park", "Park", "OLD_CITY", (32, 30), (32, 34), "Taichung Park", "臺中公園", "house"),
+    ("miyahara", "Miyahara", "OLD_CITY", (20, 52), (20, 55), "Miyahara", "宮原眼科", "house"),
+    ("natural-science-museum", "ScienceMuseum", "GREENWAY", (24, 20), (24, 23), "Science Museum", "國立自然科學博物館", "museum"),
+    ("calligraphy-greenway", "Greenway", "GREENWAY", (22, 36), (22, 39), "Calligraphy Greenway", "草悟道／市民廣場", "gym"),
+    ("shen-ji-new-village", "ShenJi", "GREENWAY", (10, 44), (10, 47), "Shen Ji New Village", "審計新村", "house"),
+    ("fine-arts-museum", "FineArts", "GREENWAY", (10, 62), (10, 65), "Fine Arts Museum", "國立臺灣美術館", "museum"),
+    ("fengjia-night-market", "Fengjia", "XITUN", (24, 12), (24, 15), "Fengjia Night Market", "逢甲夜市", "gym"),
+    ("maple-garden", "MapleGarden", "XITUN", (12, 32), (12, 35), "Maple Garden", "秋紅谷", "house"),
+    ("taichung-theater", "Theater", "XITUN", (12, 44), (12, 47), "National Taichung Theater", "臺中國家歌劇院", "museum"),
+]
+
+
+def snake(name):
+    import re
+    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).upper()
+
+
+def save_json(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
+
+
+def read_words(path):
+    raw = path.read_bytes()
+    return list(struct.unpack(f"<{len(raw)//2}H", raw))
+
+
+def write_words(path, words):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(struct.pack(f"<{len(words)}H", *words))
+
+
+class Grid:
+    def __init__(self, width, height):
+        self.width, self.height = width, height
+        self.cells = [0x3000 | GRASS] * (width * height)
+        self.boundary()
+
+    def put(self, x, y, tile, blocked=False, elevation=3):
+        assert 0 <= x < self.width and 0 <= y < self.height, (x, y)
+        self.cells[y*self.width+x] = (elevation << 12) | (0x400 if blocked else 0) | tile
+
+    def rect(self, x0, y0, x1, y1, tile=PAVING, blocked=False, elevation=3):
+        for y in range(y0, y1+1):
+            for x in range(x0, x1+1):
+                self.put(x, y, tile, blocked, elevation)
+
+    def boundary(self):
+        for y in range(self.height):
+            for x in range(self.width):
+                if x < 2 or x >= self.width-2 or y < 2 or y >= self.height-2:
+                    self.put(x, y, ((0x00E, 0x00F), (0x016, 0x017))[y % 2][x % 2], True, 0)
+
+    def grove(self, x0, y0, cols, rows):
+        for y in range(rows*2):
+            for x in range(cols*2):
+                self.put(x0+x, y0+y, ((0x00E, 0x00F), (0x016, 0x017))[y % 2][x % 2], True, 0)
+
+    def pond(self, x0, y0, x1, y1):
+        # Fishing/encounter ownership comes later; water is not a walking route.
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):
+                row = 0 if y==y0 else 2 if y==y1 else 1
+                col = 0 if x==x0 else 2 if x==x1 else 1
+                tile=((0x1A0,0x1A1,0x1A2),(0x1A8,0x1A9,0x1AA),(0x1B0,0x1B1,0x1B2))[row][col]
+                self.put(x,y,tile,True,1)
+
+
+def object_event(local_id, x, y, script, graphics="OBJ_EVENT_GFX_WOMAN_1"):
+    return dict(local_id=local_id, type="object", graphics_id=graphics, x=x, y=y,
+                elevation=3, movement_type="MOVEMENT_TYPE_FACE_DOWN", movement_range_x=0,
+                movement_range_y=0, trainer_type="TRAINER_TYPE_NONE",
+                trainer_sight_or_berry_tree_id="0", script=script, flag="0")
+
+
+def map_data(name, key, layout=None, indoor=False):
+    return dict(id="MAP_TAICHUNG_"+key, name=name, layout=layout or "LAYOUT_TAICHUNG_"+key,
+                music="MUS_GYM" if indoor else next(d[6] for d in DISTRICTS if d[1]==key),
+                region_map_section="MAPSEC_TAICHUNG_"+key if not indoor else "MAPSEC_TAICHUNG_OLD_CITY",
+                requires_flash=False, weather="WEATHER_NONE" if indoor else "WEATHER_SUNNY",
+                map_type="MAP_TYPE_INDOOR" if indoor else "MAP_TYPE_CITY",
+                allow_cycling=not indoor, allow_escaping=False, allow_running=not indoor,
+                show_map_name=not indoor, floor_number=0, battle_scene="MAP_BATTLE_SCENE_GYM" if indoor else "MAP_BATTLE_SCENE_NORMAL",
+                connections=None if indoor else [], object_events=[], warp_events=[], coord_events=[], bg_events=[])
+
+
+def make_layout(name, key, width, height, primary="General", secondary="PewterCity"):
+    return dict(id="LAYOUT_TAICHUNG_"+key, name=name+"_Layout", width=width, height=height,
+                border_width=2, border_height=2, primary_tileset="gTileset_"+primary,
+                secondary_tileset="gTileset_"+secondary,
+                border_filepath=f"data/layouts/{name}/border.bin", blockdata_filepath=f"data/layouts/{name}/map.bin")
+
+
+def build():
+    layouts_path = ROOT/"data/layouts/layouts.json"
+    layouts = json.loads(layouts_path.read_text())
+    source_layout = next(l for l in layouts['layouts'] if l.get('id')=='LAYOUT_PEWTER_CITY')
+    source = read_words(ROOT/source_layout['blockdata_filepath'])
+    def facade(grid, kind, dx, dy):
+        rect, source_door = {
+            'museum': ((12,0,22,6), (17,6)),
+            'house': ((31,8,36,11), (33,11)),
+            'gym': ((12,12,18,16), (15,16)),
+        }[kind]
+        ox, oy = dx-source_door[0], dy-source_door[1]
+        for sy in range(rect[1],rect[3]+1):
+            for sx in range(rect[0],rect[2]+1):
+                grid.cells[(sy+oy)*grid.width+(sx+ox)] = source[sy*source_layout['width']+sx]
+        # Explicit native animated door: block north entry, warp handles opening.
+        grid.put(dx,dy,0x03D,True,0)
+        return [rect[0]+ox,rect[1]+oy,rect[2]+ox,rect[3]+oy]
+
+    grids = {key:Grid(w,h) for _,key,w,h,*_ in DISTRICTS}
+    old, green, west = (grids[key] for key in ('OLD_CITY','GREENWAY','XITUN'))
+    # Primary roads; clear cycling routes, with two distinct old-city crossings.
+    old.rect(12,2,15,69); old.rect(2,20,37,23); old.rect(0,20,15,23)
+    old.rect(0,50,23,53); old.rect(12,54,23,56); old.rect(12,66,37,69)
+    old.rect(30,31,33,69); old.rect(12,33,33,36)
+    # Park: lake and lawn surrounded by a legible promenade.
+    old.rect(19,9,37,32); old.rect(21,11,35,28,GRASS)
+    old.pond(23,13,34,23); old.rect(23,24,35,26)
+    old.rect(20,12,21,22,TALL_GRASS); old.rect(35,14,36,22,TALL_GRASS)
+    old.grove(3,3,4,5); old.grove(3,27,4,9); old.grove(17,2,3,3)
+    old.grove(23,38,7,4); old.grove(3,57,4,4)
+    old.rect(17,58,23,64,TALL_GRASS)
+    # Cultural axis: four landmarks along a broad green pedestrian belt.
+    green.rect(30,2,33,69); green.rect(0,24,37,27); green.rect(30,36,39,39)
+    green.rect(12,36,33,39); green.rect(2,66,39,69)
+    green.rect(8,28,11,65); green.rect(8,45,33,48); green.rect(8,63,33,66)
+    green.rect(17,29,27,54); green.rect(19,30,25,53,GRASS)
+    green.rect(21,38,23,53); green.rect(18,41,19,50,TALL_GRASS)
+    green.rect(25,42,26,50,TALL_GRASS)
+    green.grove(3,3,7,8); green.grove(35,3,1,14)
+    green.grove(14,2,3,4); green.grove(35,42,1,10)
+    green.rect(19,21,29,24); green.rect(5,63,15,66)
+    # Western district: market north, garden lake in the middle, theater south.
+    west.rect(26,2,29,61); west.rect(3,15,29,18); west.rect(3,35,29,38)
+    west.rect(3,47,29,50); west.rect(26,56,39,59)
+    west.rect(3,20,22,34); west.rect(5,22,20,30,GRASS); west.pond(6,23,19,28)
+    west.rect(3,39,22,46); west.rect(6,48,20,51)
+    west.rect(16,4,31,14); west.rect(3,5,6,13,TALL_GRASS)
+    west.grove(3,2,6,1); west.grove(32,2,2,23); west.grove(3,53,10,4)
+    # Market stalls keep the lane open; no unpaired decorative door tiles.
+    for sx in (8,15):
+        for sy in (5,10):
+            for yy, row in enumerate(((0x048,0x049,0x04A,0x04B),(0x050,0x051,0x052,0x053),(0x054,0x055,0x056,0x057))):
+                for xx,tile in enumerate(row): west.put(sx+xx,sy+yy,tile,True,0)
+
+    maps = {key:map_data(name,key) for name,key,*_ in DISTRICTS}
+    maps['OLD_CITY']['connections']=[dict(map='MAP_TAICHUNG_GREENWAY',offset=-16,direction='left')]
+    maps['GREENWAY']['connections']=[dict(map='MAP_TAICHUNG_OLD_CITY',offset=16,direction='right'),dict(map='MAP_TAICHUNG_XITUN',offset=-32,direction='left')]
+    maps['XITUN']['connections']=[dict(map='MAP_TAICHUNG_GREENWAY',offset=32,direction='right')]
+
+    contract = dict(version=1, status="native traversable blockout; gym battles and final art separate",
+                    coordinateSystem="zero-based local metatiles, 16x16 pixels, door faces south",
+                    spawn=dict(map='MAP_TAICHUNG_OLD_CITY',x=30,y=66,elevation=3,facing='south'),
+                    districts=[], landmarks=[], habitatRegions=[])
+    room_names=[]
+    for stable_id, suffix, key, door, arrival, en, zh, style in LANDMARKS:
+        grid, data = grids[key], maps[key]
+        # A generously paved apron gives doors/transport independent clear cells.
+        grid.rect(max(2,door[0]-4),door[1]+1,min(37,door[0]+4),door[1]+3)
+        footprint=facade(grid,style,*door)
+        warp_id=len(data['warp_events'])
+        room_name=f'Taichung{suffix}_Gym'; room_key=snake(suffix)+'_GYM'; room_id='MAP_TAICHUNG_'+room_key
+        room_names.append(room_name)
+        data['warp_events'].append(dict(x=door[0],y=door[1],elevation=0,dest_map=room_id,dest_warp_id='1'))
+        sign=(door[0]-3,door[1]+2)
+        grid.put(*sign,SIGN,True)
+        data['bg_events'].append(dict(type='sign',x=sign[0],y=sign[1],elevation=0,player_facing_dir='BG_EVENT_PLAYER_FACING_ANY',script=f'TaichungCity_Sign_{suffix}'))
+        room=map_data(room_name,room_key,'LAYOUT_TAICHUNG_LANDMARK_GYM',True)
+        room['region_map_section']='MAPSEC_TAICHUNG_'+key
+        room['warp_events']=[dict(x=x,y=14,elevation=3,dest_map=data['id'],dest_warp_id=str(warp_id)) for x in (5,6,7)]
+        room['object_events']=[object_event('LOCALID_TAICHUNG_'+snake(suffix)+'_HOST',6,5,f'TaichungCity_Host_{suffix}','OBJ_EVENT_GFX_GYM_GUY')]
+        save_json(ROOT/f'data/maps/{room_name}/map.json',room)
+        (ROOT/f'data/maps/{room_name}/scripts.inc').write_text(f'{room_name}_MapScripts::\n\t.byte 0\n')
+        contract['landmarks'].append(dict(id=stable_id,name=dict(en=en,zh=zh),exteriorMap=data['id'],
+            entrance=dict(x=door[0],y=door[1],warpId=warp_id,elevation=0),footprint=footprint,
+            approach=dict(x=door[0],y=door[1]+1,elevation=3),arrival=dict(x=arrival[0],y=arrival[1],elevation=3,facing='south'),
+            sign=dict(x=sign[0],y=sign[1]),gymMap=room_id,gymEntryWarpId=1,
+            interiorReturns=[dict(x=x,y=14,warpId=i) for i,x in enumerate((5,6,7))],
+            host=dict(localId='LOCALID_TAICHUNG_'+snake(suffix)+'_HOST',x=6,y=5,script=f'TaichungCity_Host_{suffix}')))
+    # Friendly guide offers healing without requiring any quest or battle.
+    maps['OLD_CITY']['object_events'].append(object_event('LOCALID_TAICHUNG_STATION_GUIDE',28,66,'TaichungCity_StationGuide'))
+    maps['GREENWAY']['object_events'].append(object_event('LOCALID_TAICHUNG_GREENWAY_GUIDE',25,40,'TaichungCity_GreenwayGuide'))
+
+    for name,key,w,h,origin,label,music in DISTRICTS:
+        grid=grids[key]; data=maps[key]
+        layout=make_layout(name,key,w,h)
+        layouts['layouts']=[l for l in layouts['layouts'] if l.get('id')!=layout['id']]+[layout]
+        write_words(ROOT/layout['blockdata_filepath'],grid.cells)
+        write_words(ROOT/layout['border_filepath'],[0x040E,0x040F,0x0416,0x0417])
+        save_json(ROOT/f'data/maps/{name}/map.json',data)
+        startup='\tmap_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition\n\tmap_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition\n'
+        if key=='OLD_CITY': startup+='\tmap_script MAP_SCRIPT_ON_FRAME_TABLE, Taichung_OnFrame\n'
+        (ROOT/f'data/maps/{name}/scripts.inc').write_text(f'{name}_MapScripts::\n'+startup+'\t.byte 0\n')
+        contract['districts'].append(dict(map=data['id'],name=name,layout=layout['id'],width=w,height=h,worldOrigin=origin,connections=data['connections']))
+    # A simple native lobby shared by all landmarks; battle worker owns content.
+    gym_source=next(l for l in layouts['layouts'] if l.get('id')=='LAYOUT_PEWTER_CITY_GYM')
+    gym=read_words(ROOT/gym_source['blockdata_filepath'])
+    for y in range(3,14):
+        for x in range(1,12): gym[y*13+x]=0x3294
+    lobby=make_layout('TaichungLandmarkGym','LANDMARK_GYM',13,16,'Building','PewterGym')
+    layouts['layouts']=[l for l in layouts['layouts'] if l.get('id')!=lobby['id']]+[lobby]
+    write_words(ROOT/lobby['blockdata_filepath'],gym)
+    write_words(ROOT/lobby['border_filepath'],read_words(ROOT/gym_source['border_filepath']))
+    save_json(layouts_path,layouts)
+
+    groups_path=ROOT/'data/maps/map_groups.json'; groups=json.loads(groups_path.read_text())
+    if 'gMapGroup_Taichung' not in groups['group_order']: groups['group_order'].append('gMapGroup_Taichung')
+    groups['gMapGroup_Taichung']=[d[0] for d in DISTRICTS]+room_names
+    save_json(groups_path,groups)
+    sections_path=ROOT/'src/data/region_map/region_map_sections.json'; sections=json.loads(sections_path.read_text())
+    # NONE was 197 in the baseline. Put the sentinel in the source list before
+    # additions rather than silently reinterpreting old saved met locations.
+    if not any(s['id']=='MAPSEC_NONE' for s in sections['map_sections']):
+        before=next((i for i,s in enumerate(sections['map_sections']) if s['id'].startswith('MAPSEC_TAICHUNG_')),len(sections['map_sections']))
+        sections['map_sections'].insert(before,dict(id='MAPSEC_NONE'))
+    for _,key,_,_,_,label,_ in DISTRICTS:
+        sid='MAPSEC_TAICHUNG_'+key
+        if not any(s['id']==sid for s in sections['map_sections']):
+            sections['map_sections'].append(dict(id=sid,name=label,x=0,y=0,width=1,height=1))
+    save_json(sections_path,sections)
+
+    events_path=ROOT/'data/event_scripts.s'; events=events_path.read_text()
+    include='\t.include "data/scripts/taichung_city.inc"'
+    if include not in events: events += '\n'+include+'\n'
+    events_path.write_text(events)
+    contract['habitatRegions']=[dict(id='park-lawns',map=maps['OLD_CITY']['id'],rect=[20,12,21,22],terrain='tall-grass'),
+        dict(id='station-urban-garden',map=maps['OLD_CITY']['id'],rect=[17,58,23,64],terrain='tall-grass'),
+        dict(id='greenway-lawns',map=maps['GREENWAY']['id'],rect=[18,41,19,50],terrain='tall-grass'),
+        dict(id='fengjia-pocket-garden',map=maps['XITUN']['id'],rect=[3,5,6,13],terrain='tall-grass')]
+    save_json(ROOT/'docs/taichung-city-contract.json',contract)
+
+    scripts=['@ Native city geometry; no trainer/badge/encounter implementation here.',
