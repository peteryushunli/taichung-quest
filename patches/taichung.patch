@@ -0,0 +1,152 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_onboarding.h"
+#include "taichung_language.h"
+#include "taichung_exploration.h"
+#include "constants/maps.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct Main gMain;
+struct PaletteFade gPaletteFade;
+u16 gSpecialVar_Result;
+bool8 sPlayback;
+u8 sPlaybackState;
+u8 gStringVar4[1024];
+static bool8 sField, sPartner, sLocked, sScriptRunning;
+static unsigned sResumes, sWrites, sHints, sStarts;
+const u8 TaichungOldCity_OnboardingStart[]={0};
+#define STAGE sSave.vars[TAICHUNG_ONBOARDING_STAGE_VAR - VARS_START]
+#define LANGUAGE sSave.vars[TAICHUNG_LANGUAGE_VAR - VARS_START]
+#define PACKET gTaichungOnboardingBridge
+
+bool8 VarSet(u16 id, u16 value) { assert(id == TAICHUNG_ONBOARDING_STAGE_VAR || id == TAICHUNG_LANGUAGE_VAR); sSave.vars[id - VARS_START] = value; sWrites++; return TRUE; }
+bool8 IsFieldMessageBoxHidden(void) { return TRUE; }
+bool8 ShowFieldMessage(const u8 *text) { (void)text; sHints++; return TRUE; }
+bool8 Overworld_IsMainFieldCallback(void) { return sField; }
+u8 QL_GetPlaybackState(void) { return sPlaybackState; }
+void ScriptContext_Enable(void) { sResumes++; }
+void ScriptContext_SetupScript(const u8 *script) { assert(script==TaichungOldCity_OnboardingStart); sStarts++; }
+bool8 ArePlayerFieldControlsLocked(void) { return sLocked; }
+bool8 ScriptContext_IsEnabled(void) { return sScriptRunning; }
+bool8 TaichungStarterHasPartner(void) { return sPartner; }
+const u8 *TaichungText(const u8 *en, const u8 *zh) { return LANGUAGE == 2 ? zh : en; }
+u8 *StringCopy(u8 *dest, const u8 *src) { return (u8 *)strcpy((char *)dest, (const char *)src); }
+static void SetMap(bool8 welcome) { sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY); sSave.location.mapNum = welcome ? MAP_NUM(MAP_TAICHUNG_STATION_WELCOME) : MAP_NUM(MAP_TAICHUNG_OLD_CITY); }
+static void Tick(void) { TaichungOnboarding_Tick(TRUE); assert(PACKET.frameCounter && !(PACKET.frameCounter & 1)); }
+static void Request(u32 seq,u8 cmd,u8 language) { PACKET.requestedContext=PACKET.contextSequence; PACKET.command=cmd; PACKET.requestedLanguage=language; PACKET.requestSequence=seq; }
+static void Reset(void)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    memset((void *)&PACKET, 0, sizeof(PACKET));
+    memset(&gMain,0,sizeof(gMain));
+    sField=TRUE; sPartner=FALSE; sLocked=TRUE; sScriptRunning=FALSE; sPlayback=FALSE; sPlaybackState=0; gPaletteFade.active=FALSE;
+    sWrites=sResumes=sHints=sStarts=0; LANGUAGE=0; SetMap(TRUE);
+    TaichungOnboarding_InitNewGame();
+}
+static void AssertProtected(const struct SaveBlock1 *before)
+{
+    struct SaveBlock1 expected=*before;
+    expected.vars[TAICHUNG_ONBOARDING_STAGE_VAR - VARS_START]=STAGE;
+    expected.vars[TAICHUNG_LANGUAGE_VAR - VARS_START]=LANGUAGE;
+    assert(memcmp(&expected,&sSave,sizeof(sSave))==0);
+}
+int main(void)
+{
+    unsigned language,phase,i,wild,sight;
+    u32 oldContext;
+    struct SaveBlock1 before;
+    for(language=1;language<=2;language++)
+    {
+        Reset();
+        sSave.vars[TAICHUNG_EXPLORATION_WILD_VAR-VARS_START]=0;
+        sSave.vars[TAICHUNG_EXPLORATION_SIGHT_VAR-VARS_START]=0;
+        before=sSave;
+        TaichungOnboarding_ScriptStartupEligible(); assert(gSpecialVar_Result==TRUE);
+        TaichungOnboarding_ScriptBeginStartup();
+        gMain.heldKeys=A_BUTTON; gMain.newKeys=A_BUTTON;
+        for(i=0;i<2000;i++)Tick(); // Slow browser and held launch input never open native picker.
+        assert(sResumes==0 && PACKET.phase==1 && LANGUAGE==0 && sHints==1);
+        gMain.heldKeys=gMain.newKeys=0;
+        Request(1,1,language); gPaletteFade.active=TRUE; Tick();
+        assert(LANGUAGE==0 && PACKET.ackSequence==0);
+        gPaletteFade.active=FALSE; sLocked=FALSE; Tick();
+        assert(LANGUAGE==0 && PACKET.ackSequence==0);
+        sLocked=TRUE; sScriptRunning=TRUE; Tick();
+        assert(LANGUAGE==0 && PACKET.ackSequence==0);
+        sScriptRunning=FALSE; Tick();
+        assert(LANGUAGE==language && sResumes==1 && PACKET.ackSequence==1 && PACKET.result==1);
+        assert(PACKET.phase==2 && !(PACKET.flags&2));
+        TaichungOnboarding_ScriptLanguageReady(); assert(STAGE==0xA102);
+        TaichungOnboarding_ScriptWelcome(); TaichungOnboarding_ScriptPartner(); assert(STAGE==0xA103);
+        TaichungOnboarding_ScriptGranted(); assert(STAGE==0xA103); // No party, no progress.
+        sPartner=TRUE; TaichungOnboarding_ScriptGranted(); assert(STAGE==0xA104);
+        TaichungOnboarding_ScriptGranted(); assert(STAGE==0xA104); // Idempotent.
+        AssertProtected(&before);
+        SetMap(FALSE); before=sSave;
+        for(phase=4;phase<=8;phase++)
+        {
+            sPlayback=TRUE; assert(!TaichungOnboarding_TryRunOutdoorScript());
+            sPlayback=FALSE; assert(TaichungOnboarding_TryRunOutdoorScript());
+            TaichungOnboarding_ScriptBufferTopic(); assert(PACKET.phase==phase && PACKET.flags==5);
+            oldContext=PACKET.contextSequence;
+            TaichungOnboarding_ScriptWaitCard(); assert(PACKET.flags==3 && PACKET.contextSequence!=oldContext);
+            Request(phase+10,2,0); PACKET.requestedContext=oldContext; Tick(); assert(PACKET.result==3);
+            assert(STAGE==0xA100+phase && sResumes==phase-3);
+            Request(phase+20,2,0); Tick(); assert(PACKET.result==1 && !(PACKET.flags&2));
+            TaichungOnboarding_ScriptAdvance(); assert(STAGE==0xA100+phase+1);
+            assert(gSpecialVar_Result==(phase==8));
+            AssertProtected(&before);
+        }
+        assert(STAGE==0xA109 && TaichungOnboarding_TryRunOutdoorScript());
+        TaichungOnboarding_ScriptIsRelease(); assert(gSpecialVar_Result==TRUE);
+        TaichungOnboarding_ScriptBufferRelease(); assert(PACKET.phase==9 && PACKET.flags==5);
+        TaichungOnboarding_ScriptFinish(); assert(PACKET.phase==9 && PACKET.flags==1 && STAGE==0xA1FF);
+        assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD)==TAICHUNG_EXPLORATION_NORMAL);
+        assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT)==TAICHUNG_EXPLORATION_NORMAL);
+        assert(sSave.vars[TAICHUNG_EXPLORATION_WILD_VAR-VARS_START]==0 && sSave.vars[TAICHUNG_EXPLORATION_SIGHT_VAR-VARS_START]==0);
+        assert(!TaichungOnboarding_TryRunOutdoorScript());
+        Request(90,2,0); Tick(); assert(PACKET.result==4);
+    }
+    Reset(); TaichungOnboarding_ScriptBeginStartup();
+    gMain.heldKeys=gMain.newKeys=A_BUTTON;
+    Tick();Tick();Tick(); assert(sResumes==0);
+    gMain.heldKeys=gMain.newKeys=0;Tick();
+    gMain.heldKeys=gMain.newKeys=B_BUTTON;Tick();
+    assert(sResumes==1 && PACKET.phase==10 && gSpecialVar_Result==FALSE);
+    assert(LANGUAGE==0); // Only the standalone chooser subsequently sets it.
+    Reset(); SetMap(FALSE); sPartner=TRUE;
+    for(i=0;i<65536;i++)
+    {
+        STAGE=i;
+        assert(TaichungOnboarding_TryRunOutdoorScript()==(i>=0xA104 && i<=0xA109));
+    }
+    STAGE=0; before=sSave; TaichungOnboarding_ScriptGranted();
+    assert(memcmp(&before,&sSave,sizeof(sSave))==0); // Old save never opts in.
+    for(wild=0;wild<=3;wild++)
+    for(sight=0;sight<=3;sight++)
+    {
+        STAGE=0;
+        sSave.vars[TAICHUNG_EXPLORATION_WILD_VAR-VARS_START]=wild;
+        sSave.vars[TAICHUNG_EXPLORATION_SIGHT_VAR-VARS_START]=sight;
+        before=sSave;
+        assert(!TaichungOnboarding_TryRunOutdoorScript());
+        TaichungOnboarding_ScriptGranted();
+        assert(TaichungExplorationGetMode(0)==(wild?wild:3));
+        assert(TaichungExplorationGetMode(1)==(sight?sight:3));
+        assert(memcmp(&before,&sSave,sizeof(sSave))==0);
+    }
+    for(phase=4;phase<=8;phase++)
+    {
+        STAGE=0xA100+phase; assert(TaichungOnboarding_TryRunOutdoorScript());
+        TaichungOnboarding_ScriptBufferTopic(); TaichungOnboarding_ScriptWaitCard();
+        gMain.newKeys=gMain.heldKeys=0; Tick();Tick();Tick();
+        gMain.newKeys=gMain.heldKeys=A_BUTTON; Tick();
+        assert(!(PACKET.flags&2));
+        TaichungOnboarding_ScriptAdvance(); assert(STAGE==0xA101+phase);
+    }
+    puts("PASS: both startup languages, slow/held input, busy gating, native fallback, card contexts, questlog deferral, resumable phases, completed/legacy save exemption and protected state.");
+    return 0;
+}
diff --git a/tests/test_taichung_onboarding_protocol.c b/tests/test_taichung_onboarding_protocol.c
new file mode 100644
index 0000000..f69aa8e
--- /dev/null
+++ b/tests/test_taichung_onboarding_protocol.c
@@ -0,0 +1,114 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "taichung_onboarding.h"
+
+static volatile struct TaichungOnboardingBridge p;
+static struct TaichungOnboardingRequest accepted;
+
+static void Request(u32 sequence, u32 context, u8 command, u8 language)
+{
+    p.requestedContext = context;
+    p.command = command;
+    p.requestedLanguage = language;
+    p.requestSequence = sequence;
+}
+
+int main(void)
+{
+    unsigned phase, value;
+    u32 prior, token;
+    TaichungOnboardingPacket_Init(&p, 0x0203F000);
+    assert(sizeof(p) == 48 && p.frameCounter == 2 && p.contextSequence == 1);
+    assert(p.magicA == 0x4E494354 && p.magicB == 0x314F5254);
+    assert(p.version == 1 && p.size == 48 && p.selfGbaAddress == 0x0203F000);
+    Request(1, p.contextSequence, 1, 2);
+    assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0);
+    assert(p.result == TAICHUNG_ONBOARDING_RESULT_NOT_READY && p.ackSequence == 1);
+    prior = p.contextSequence;
+    TaichungOnboardingPacket_Context(&p, 1, 3);
+    assert(p.contextSequence != prior && !(p.frameCounter & 1));
+    Request(2, prior, 1, 2);
+    assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0 && p.result == TAICHUNG_ONBOARDING_RESULT_STALE);
+    Request(3, p.contextSequence, 1, 3);
+    assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0 && p.result == TAICHUNG_ONBOARDING_RESULT_INVALID);
+    for (value = 1; value <= 2; value++)
+    {
+        Request(value + 3, p.contextSequence, 1, value);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 1);
+        assert(accepted.language == value && accepted.sequence == value + 3);
+        assert(p.ackSequence != accepted.sequence); // No promise before writer commits.
+        token = accepted.sequence;
+        p.requestSequence = 900; // A broken client replaces its request mid-action.
+        TaichungOnboardingPacket_Ack(&p, token, 1);
+        assert(p.ackSequence == token && p.ackSequence != 900);
+        p.requestSequence = token;
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0);
+    }
+    // A slow browser may apply either language while the startup hint prints.
+    TaichungOnboardingPacket_Context(&p, TAICHUNG_ONBOARDING_LANGUAGE,
+        TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+    for (value = 1; value <= 2; value++)
+    {
+        Request(200 + value, p.contextSequence, TAICHUNG_ONBOARDING_APPLY_LANGUAGE, value);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == TAICHUNG_ONBOARDING_APPLY_LANGUAGE);
+        assert(accepted.sequence == 200 + value && accepted.language == value);
+        TaichungOnboardingPacket_Ack(&p, accepted.sequence, TAICHUNG_ONBOARDING_RESULT_APPLIED);
+    }
+    for (phase = 4; phase <= 8; phase++)
+    {
+        TaichungOnboardingPacket_Context(&p, phase,
+            TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+        prior = p.contextSequence;
+        accepted.sequence = 0xBAD;
+        accepted.language = 0xFF;
+        Request(phase + 210, prior, TAICHUNG_ONBOARDING_ACK_CARD, 0);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0);
+        assert(p.result == TAICHUNG_ONBOARDING_RESULT_NOT_READY && p.ackSequence == phase + 210);
+        assert(p.phase == phase && p.contextSequence == prior);
+        assert(accepted.sequence == 0xBAD && accepted.language == 0xFF); // No accepted action to advance.
+        TaichungOnboardingPacket_Context(&p, phase, 5);
+        Request(phase + 10, p.contextSequence, 2, 0);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0 && p.result == 4);
+        prior = p.contextSequence;
+        TaichungOnboardingPacket_Context(&p, phase, 3);
+        Request(phase + 20, prior, 2, 0);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0 && p.result == 3);
+        Request(phase + 30, p.contextSequence, 1, 2);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0 && p.result == 2);
+        Request(phase + 40, p.contextSequence, 2, 2);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0 && p.result == 2);
+        Request(phase + 50, p.contextSequence, 2, 0);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 2);
+        token = accepted.sequence;
+        TaichungOnboardingPacket_Context(&p, phase, 5);
+        TaichungOnboardingPacket_Ack(&p, token, 1);
+        assert(!(p.frameCounter & 1));
+        Request(phase + 60, prior, 2, 0);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0);
+    }
+    for (phase = 0; phase <= 10; phase++)
+    {
+        TaichungOnboardingPacket_Context(&p, phase, 1);
+        Request(phase + 100, p.contextSequence, 2, 0);
+        assert(TaichungOnboardingPacket_Request(&p, &accepted) == 0);
+    }
+    p.contextSequence = 0xFFFFFFFF;
+    p.frameCounter = 0xFFFFFFFE;
+    TaichungOnboardingPacket_Context(&p, 1, 3);
+    assert(p.contextSequence == 1 && p.frameCounter == 2);
+    for (value = 0; value <= 0xFFFF; value++)
+    {
+        phase = TaichungOnboardingStage_Phase(value);
+        if (value > 0xA100 && value <= 0xA109)
+            assert(phase == value - 0xA100);
+        else
+            assert(phase == 0 && TaichungOnboardingStage_Advance(value) == value);
+        if (phase >= 4 && phase <= 8)
+            assert(TaichungOnboardingStage_Advance(value) == value + 1);
+        else
+            assert(TaichungOnboardingStage_Advance(value) == value);
+    }
+    puts("PASS: startup-only language, exact card contexts, stale/invalid/not-ready, duplicate ACK, writer ordering, seqlock/context wrap and all 65536 stage values.");
+    return 0;
+}
