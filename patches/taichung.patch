+            TaichungSaveUpgradeOnContinue(); AssertGreenwayWarp(sGreenwayV5Cases[i][2],sGreenwayV5Cases[i][3]);
+            assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+        }
+        // Each of four authored door IDs wins over ignored coordinate fields.
+        for (i = 0; i < 4; i++)
+        {
+            Versioned(version); InGreenway(24,23); sHasContinueWarp = TRUE;
+            sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = i;
+            sSave.continueGameWarp.x = 8; sSave.continueGameWarp.y = 41; before = sSave;
