new file mode 100644
index 0000000..b1ba3c1
--- /dev/null
+++ b/tools/taichung/landmarks/describe_old_core_delta.py
@@ -0,0 +1,358 @@
+#!/usr/bin/env python3
+"""Describe registered OldCity terrain versus exact Git 21c08cb source data.
+
+Writes only old-core-native/delta.json. It never reads a worktree baseline map,
+builds a ROM, mutates a save, changes startup scripts, or installs a proposed map.
+"""
+import argparse
+from collections import deque
+from datetime import datetime, timezone
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "21c08cb"
+OUTPUT = ROOT / "data/taichung/landmarks/old-core-native/delta.json"
+CITY = "MAP_TAICHUNG_OLD_CITY"
+WALK_RULE_PATH = ROOT / "tools/taichung/validate_city.py"
+WALK_RULE_BYTES = WALK_RULE_PATH.read_bytes()
+spec = importlib.util.spec_from_file_location("city_delta_walk_rules", WALK_RULE_PATH)
+rules = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(rules)
+if WALK_RULE_PATH.read_bytes() != WALK_RULE_BYTES:
+    raise ValueError("City validator changed while loading; recompute")
+WALK = rules.WALK_BEHAVIORS
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def git_show(revision, path, missing=False):
+    process = subprocess.run(["git", "show", f"{revision}:{path}"], cwd=ROOT, capture_output=True)
+    if process.returncode:
+        if missing:
+            return None
+        raise ValueError(f"Cannot read exact Git source {revision}:{path}: {process.stderr.decode().strip()}")
+    return process.stdout
+
+
+class Source:
+    def __init__(self, revision=None):
+        self.revision, self.raw = revision, {}
+
+    def read(self, path):
+        path = str(path)
+        if path not in self.raw:
+            self.raw[path] = git_show(self.revision, path) if self.revision else (ROOT / path).read_bytes()
+        return self.raw[path]
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        size = struct.calcsize(kind)
+        if len(raw) % size:
+            raise ValueError(f"Malformed native data at {path}")
+        return list(struct.unpack(f"<{len(raw)//size}{kind}", raw))
+
+    def tileset(self, label):
+        headers = self.text("src/data/tilesets/headers.h")
+        block = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", headers, re.S)
+        if not block:
+            raise ValueError(f"Unknown registered tileset {label} in {self.revision or 'current source'}")
+        declarations = self.text("src/data/tilesets/metatiles.h")
+        graphics = self.text("src/data/tilesets/graphics.h") + self.text("src/graphics.c")
+        paths = {}
+        for field in ("metatiles", "metatileAttributes", "tiles", "palettes"):
+            symbol = re.search(rf"\.{field}\s*=\s*(\w+)", block.group(1))
+            source = graphics if field in ("tiles", "palettes") else declarations
+            declaration = re.search(rf"\b{re.escape(symbol.group(1))}\s*\[.*?=\s*(.*?);", source, re.S) if symbol else None
+            path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1)) if declaration else None
+            if not path:
+                raise ValueError(f"Cannot resolve {label}.{field}")
+            paths[field] = path.group(1)
+        definitions = self.words(paths["metatiles"])
+        attributes = self.words(paths["metatileAttributes"], "I")
+        if len(definitions) != len(attributes)*8:
+            raise ValueError(f"Definition/attribute length mismatch: {label}")
+        # Consume the registered source artwork as provenance and ROM-freshness
+        # evidence. Generated .4bpp/.gbapal files are not a Git baseline source.
+        folder = Path(paths["tiles"]).parent
+        self.read(folder / "tiles.png")
+        palette_folder = Path(paths["palettes"]).parent
+        for n in range(16):
+            self.read(palette_folder / f"{n:02}.pal")
+        return {"label": label, "paths": paths, "definitions": definitions, "attributes": attributes}
+
+
+class CityMap:
+    def __init__(self, source, name="TaichungOldCity"):
+        self.source = source
+        self.data = source.json(f"data/maps/{name}/map.json")
+        self.layout = next(item for item in source.json("data/layouts/layouts.json")["layouts"]
+                           if item.get("id") == self.data["layout"])
+        self.width, self.height = self.layout["width"], self.layout["height"]
+        self.words = source.words(self.layout["blockdata_filepath"])
+        self.border = source.words(self.layout["border_filepath"])
+        if len(self.words) != self.width*self.height:
+            raise ValueError("Registered map length does not match registered dimensions")
+        self.banks = [source.tileset(self.layout[field]) for field in ("primary_tileset", "secondary_tileset")]
+        self.actors = {(obj["x"], obj["y"]) for obj in self.data.get("object_events", [])}
+        self.signs = {(obj["x"], obj["y"]) for obj in self.data.get("bg_events", []) if obj.get("type") == "sign"}
+        self.obstacles = self.actors | self.signs
+        # Apply the validator's real Map methods to the in-memory snapshot.
+        # Baseline bytes still come solely from Git; no snapshot files are made.
+        self.native = rules.Map.__new__(rules.Map)
+        self.native.data, self.native.layout, self.native.id = self.data, self.layout, self.data["id"]
+        self.native.width, self.native.height = self.width, self.height
+        self.native.cells, self.native.border = self.words, self.border
+        self.native.attributes = [bank["attributes"] for bank in self.banks]
+        self.native.actors, self.native.signs, self.native.obstacles = self.actors, self.signs, self.obstacles
+
+    def inspect(self, x, y):
+        if not (0 <= x < self.width and 0 <= y < self.height):
+            return None
+        word = self.words[y*self.width+x]
+        tile = word & 1023
+        bank, index = (self.banks[0], tile) if tile < 640 else (self.banks[1], tile-640)
+        attribute = bank["attributes"][index] if index < len(bank["attributes"]) else None
+        definition = bank["definitions"][index*8:index*8+8] if attribute is not None else None
+        behavior = attribute & 0x1FF if attribute is not None else None
+        collision = (word >> 10) & 3
+        ground = self.native.ground(x, y)
+        actor, sign = (x, y) in self.actors, (x, y) in self.signs
+        reasons = []
+        if attribute is None:
+            reasons.append("undefined-metatile")
+        if collision:
+            reasons.append("collision")
+        if behavior not in WALK:
+            reasons.append("unsupported-ordinary-walk-behavior")
+        if actor:
+            reasons.append("authored-actor-cell")
+        if sign:
+            reasons.append("authored-sign-cell")
+        return {"word": word, "wordHex": f"0x{word:04X}", "metatile": tile, "metatileHex": f"0x{tile:03X}",
+                "collision": collision, "elevation": word >> 12, "attribute": attribute, "behavior": behavior,
+                "ordinaryWalkingGround": ground, "actor": actor, "sign": sign,
+                "actorSignAwareWalkable": self.native.walkable(x, y),
+                "invalidReasons": reasons, "graphicReferences": definition}
+
+
+def component(city, anchor):
+    start = city.inspect(*anchor)
+    if start is None or not start["actorSignAwareWalkable"]:
+        return {}
+    distances, queue = {anchor: 0}, deque([anchor])
+    while queue:
+        x, y = queue.popleft()
+        current = city.inspect(x, y)
+        for point in ((x-1, y), (x+1, y), (x, y-1), (x, y+1)):
+            target = city.inspect(*point)
+            if point in distances or target is None or not target["actorSignAwareWalkable"]:
+                continue
+            if not city.native.can_step(x, y, city.native, *point):
+                continue
+            distances[point] = distances[(x, y)]+1
+            queue.append(point)
+    return distances
+
+
+def group_numbers(source):
+    groups = source.json("data/maps/map_groups.json")
+    return {name: [group, index] for group, key in enumerate(groups["group_order"])
+            for index, name in enumerate(groups[key])}
+
+
+def taichung_map_files(source, numbers):
+    return {source.json(f"data/maps/{name}/map.json")["id"]: name for name in numbers if name.startswith("Taichung")}
+
+
+def proof_landmarks(old, new, old_contract, new_contract, old_numbers, new_numbers):
+    old_files, new_files = taichung_map_files(old.source, old_numbers), taichung_map_files(new.source, new_numbers)
+    proofs = []
+    for landmark in old_contract["landmarks"]:
+        if landmark["exteriorMap"] != CITY:
+            continue
+        current = next(item for item in new_contract["landmarks"] if item["id"] == landmark["id"])
+        entrance, approach, arrival = landmark["entrance"], landmark["approach"], landmark["arrival"]
+        index = entrance["warpId"]
+        old_room = old.source.json(f"data/maps/{old_files[landmark['gymMap']]}/map.json")
+        new_room = new.source.json(f"data/maps/{new_files[current['gymMap']]}/map.json")
+        returns = []
+        for expected in landmark["interiorReturns"]:
+            warp_index = expected["warpId"]
+            before, after = old_room["warp_events"][warp_index], new_room["warp_events"][warp_index]
+            returns.append({"warpIndex": warp_index, "before": before, "after": after, "unchanged": before == after,
+                            "numericDestinationBefore": old_numbers[old_files[before["dest_map"]]],
+                            "numericDestinationAfter": new_numbers[new_files[after["dest_map"]]]})
+        door_before, door_after = old.inspect(entrance["x"], entrance["y"]), new.inspect(current["entrance"]["x"], current["entrance"]["y"])
+        approach_before, approach_after = old.inspect(approach["x"], approach["y"]), new.inspect(current["approach"]["x"], current["approach"]["y"])
+        arrival_before, arrival_after = old.inspect(arrival["x"], arrival["y"]), new.inspect(current["arrival"]["x"], current["arrival"]["y"])
+        proofs.append({"landmark": landmark["id"], "gymMap": landmark["gymMap"],
+            "numericGymIdBefore": old_numbers[old_files[landmark["gymMap"]]],
+            "numericGymIdAfter": new_numbers[new_files[current["gymMap"]]],
+            "doorCoordinatesUnchanged": entrance == current["entrance"],
+            "doorBefore": door_before, "doorAfter": door_after,
+            "doorWordUnchanged": door_before["word"] == door_after["word"],
+            "exteriorWarpBefore": old.data["warp_events"][index], "exteriorWarpAfter": new.data["warp_events"][index],
+            "exteriorWarpUnchanged": old.data["warp_events"][index] == new.data["warp_events"][index],
+            "approachCoordinatesUnchanged": approach == current["approach"],
+            "approachBefore": approach_before, "approachAfter": approach_after,
+            "approachWordUnchanged": approach_before["word"] == approach_after["word"],
+            "arrivalCoordinatesUnchanged": arrival == current["arrival"],
+            "arrivalBefore": arrival_before, "arrivalAfter": arrival_after,
+            "arrivalWordUnchanged": arrival_before["word"] == arrival_after["word"],
+            "allThreeInteriorReturnsUnchanged": len(returns) == 3 and all(item["unchanged"] for item in returns),
+            "interiorReturns": returns})
+    return proofs
+
+
+def describe(baseline=BASE, output=OUTPUT):
+    head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+    baseline_full = subprocess.check_output(["git", "rev-parse", baseline], cwd=ROOT, text=True).strip()
+    before, current = Source(baseline_full), Source()
+    old, new = CityMap(before), CityMap(current)
+    old_contract, contract = before.json("docs/taichung-city-contract.json"), current.json("docs/taichung-city-contract.json")
+    old_numbers, numbers = group_numbers(before), group_numbers(current)
+    landmark_proofs = proof_landmarks(old, new, old_contract, contract, old_numbers, numbers)
+    station = next(item for item in contract["landmarks"] if item["id"] == "old-taichung-station")
+    anchor = station["arrival"]["x"], station["arrival"]["y"]
+    distances = component(new, anchor)
+    safe = sorted(distances, key=lambda p: (p[1], p[0]))
+    changed, invalidated, newly_walkable, no_relocation = [], [], [], []
+    old_walkable = new_walkable = retained_walkable = 0
+    for y in range(max(old.height, new.height)):
+        for x in range(max(old.width, new.width)):
+            previous, now = old.inspect(x, y), new.inspect(x, y)
+            previous_valid = previous is not None and previous["actorSignAwareWalkable"]
+            now_valid = now is not None and now["actorSignAwareWalkable"]
+            old_walkable += previous_valid
+            new_walkable += now_valid
+            retained_walkable += previous_valid and now_valid
+            reasons = []
+            if previous is None or now is None:
+                reasons.append("map-extent")
+            else:
+                for field, reason in (("word", "map-word"), ("attribute", "resolved-metatile-attribute"),
+                                      ("graphicReferences", "resolved-graphic-references"), ("actor", "actor-blocking"), ("sign", "sign-blocking")):
+                    if previous[field] != now[field]:
+                        reasons.append(reason)
+            if not reasons:
+                continue
+            record = {"x": x, "y": y, "reasons": reasons, "before": previous, "after": now,
+                      "newPositionInSafeConnectedSet": (x, y) in distances,
+                      "relocationNeededByNewTerrainAndActorsOnly": previous_valid and not now_valid}
+            changed.append(record)
+            if previous_valid and not now_valid:
+                fallback = min(safe, key=lambda p: (abs(p[0]-x)+abs(p[1]-y), distances[p], p[1], p[0])) if safe else None
+                invalidated.append({"x": x, "y": y, "newInvalidReasons": now["invalidReasons"] if now else ["out-of-bounds"],
+                                    "nearestSafeConnectedPosition": list(fallback) if fallback else None,
+                                    "fallbackElevation": new.inspect(*fallback)["elevation"] if fallback else None,
+                                    "manhattanDisplacement": abs(fallback[0]-x)+abs(fallback[1]-y) if fallback else None})
+            elif not previous_valid and now_valid:
+                newly_walkable.append([x, y])
+            if previous_valid and now_valid:
+                no_relocation.append([x, y])
+    moved_ids = [{"name": name, "before": numeric, "after": numbers.get(name)} for name, numeric in old_numbers.items() if numbers.get(name) != numeric]
+    dirty = []
+    for path, raw in sorted(current.raw.items()):
+        at_head = git_show(head, path, missing=True)
+        if raw != at_head:
+            dirty.append({"path": path, "currentSha256": digest(raw), "HEADSha256": digest(at_head) if at_head is not None else None})
+    content_hash = digest("".join(path+"\0"+digest(raw)+"\n" for path, raw in sorted(current.raw.items())).encode())
+    dirty_hash = digest(json.dumps(dirty, sort_keys=True, separators=(",", ":")).encode())
+    compiler_manifest = ROOT / "data/taichung/landmarks/old-core-native/manifest.json"
+    compile_info = {"exists": compiler_manifest.exists()}
+    if compiler_manifest.exists():
+        compile_data = json.loads(compiler_manifest.read_text())
+        proposed_map = ROOT / compile_data["mapFile"]
+        compile_info.update({"manifestSha256": digest(compiler_manifest.read_bytes()), "manifestMtimeNs": compiler_manifest.stat().st_mtime_ns,
+            "compiledMapSha256": digest(proposed_map.read_bytes()), "registeredMapMatchesCompiledProposal": current.read(new.layout["blockdata_filepath"]) == proposed_map.read_bytes(),
+            "proposedPrimary": compile_data["primary"], "registeredPrimary": new.layout["primary_tileset"],
+            "proposalUsedAsBaseline": False})
+    rom_path = ROOT / "pokefirered.gba"
+    rom = {"exists": rom_path.exists(), "path": str(rom_path), "builtByThisTool": False, "verifiedAgainstExactSourceFingerprint": False}
+    if rom_path.exists():
+        stat = rom_path.stat()
+        newer = [path for path in current.raw if path.startswith(("data/", "src/", "include/"))
+                 and (ROOT / path).stat().st_mtime_ns > stat.st_mtime_ns]
+        newer_compile = compiler_manifest.exists() and compiler_manifest.stat().st_mtime_ns > stat.st_mtime_ns
+        rom.update({"sha256": digest(rom_path.read_bytes()), "bytes": stat.st_size, "mtimeNs": stat.st_mtime_ns,
+                    "compileManifestNewerThanRom": newer_compile, "consumedSourceFilesNewerThanRom": newer,
+                    "freshness": "stale-relative-to-newer-compile-or-source" if newer or newer_compile else "existing-ROM-not-proven-to-match-dirty-source",
+                    "freshnessBasis": "timestamps identify newer compile/source; no exact dirty-source build fingerprint is available"})
+    drift = [path for path, raw in current.raw.items() if (ROOT / path).read_bytes() != raw]
+    head_after = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+    if drift or head_after != head or WALK_RULE_PATH.read_bytes() != WALK_RULE_BYTES:
+        raise ValueError("Source changed while describing the map; recompute after writes settle: "+str(drift))
+    box = [min(item["x"] for item in changed), min(item["y"] for item in changed), max(item["x"] for item in changed), max(item["y"] for item in changed)] if changed else None
+    report = {
+        "schemaVersion": 1, "purpose": "coordinate/terrain evidence for conditional v2-to-v3 cached-viewport migration; no save mutation",
+        "generatedAtUtc": datetime.now(timezone.utc).isoformat(), "sourceRoot": str(ROOT), "sourceHEAD": head,
+        "baseline": {"commit": baseline_full, "mapSource": "git show only; no worktree or compiler baseline artifact",
+                     "mapSha256": digest(before.read(old.layout["blockdata_filepath"])), "layout": old.layout, "mapData": old.data},
+        "current": {"mapSha256": digest(current.read(new.layout["blockdata_filepath"])), "layout": new.layout, "mapData": new.data,
+                    "consumedSourceContentSha256": content_hash, "dirtyConsumedSourceContentSha256": dirty_hash,
+                    "dirtyHashScope": "only actual registered map/layout/contract/bank dependencies consumed by this utility",
+                    "dirtyConsumedSourceFiles": dirty, "sourceInputsStableDuringRead": True},
+        "walkability": {"source": "tools/taichung/validate_city.py", "sourceSha256": digest(WALK_RULE_BYTES),
+                        "nativeValidatorMapMethodsUsedDirectly": True,
+                        "behaviors": sorted(WALK), "collisionMask": "0x0C00", "behaviorMask": "0x1FF",
+                        "actorSignPolicy": "reserve every authored actor initial cell and sign exactly as the city validator; runtime NPC positions are not modeled",
+                        "elevationRule": "current elevation0 or target elevation0/15/current; identical to validator can_step"},
+        "numericIds": {"baselineMapNamesCompared": len(old_numbers), "allBaselineNumericMapIdsStable": not moved_ids,
+                       "movedOrMissing": moved_ids, "oldCityBefore": old_numbers["TaichungOldCity"], "oldCityAfter": numbers["TaichungOldCity"]},
+        "summary": {"baselineSize": [old.width, old.height], "currentSize": [new.width, new.height], "changedCells": len(changed),
+                    "changedBoundingBoxInclusive": box, "mapWordsChanged": sum("map-word" in item["reasons"] for item in changed),
+                    "baselineActorSignAwareWalkable": old_walkable, "currentActorSignAwareWalkable": new_walkable,
+                    "previouslyOrdinaryWalkableNowInvalid": len(invalidated), "newlyActorSignAwareWalkable": len(newly_walkable),
+                    "previouslyWalkableStillValidKeepSavedPosition": retained_walkable,
+                    "changedButStillValidNoRelocation": len(no_relocation), "safeConnectedPositions": len(safe),
+                    "allOldCityDoorApproachArrivalCoordinatesUnchanged": all(p["doorCoordinatesUnchanged"] and p["approachCoordinatesUnchanged"] and p["arrivalCoordinatesUnchanged"] for p in landmark_proofs),
+                    "allDoorApproachArrivalWordsUnchanged": all(p["doorWordUnchanged"] and p["approachWordUnchanged"] and p["arrivalWordUnchanged"] for p in landmark_proofs),
+                    "interiorReturnWarpsCompared": sum(len(p["interiorReturns"]) for p in landmark_proofs),
+                    "allExteriorWarpsAndNineInteriorReturnsUnchanged": all(p["exteriorWarpUnchanged"] and p["allThreeInteriorReturnsUnchanged"] for p in landmark_proofs)},
+        "changedCells": changed, "previouslyOrdinaryWalkableNowInvalid": invalidated,
+        "newlyActorSignAwareWalkable": newly_walkable, "changedButStillValidNoRelocation": no_relocation,
+        "safeConnectedPositions": {"coordinateSystem": "zero-based local OldCity tiles; no viewport/save offset added",
+            "anchor": list(anchor), "anchorState": new.inspect(*anchor), "anchorValid": bool(distances),
+            "columns": ["x", "y", "elevation", "distanceFromAnchor"],
+            "positions": [[x, y, new.inspect(x, y)["elevation"], distances[(x, y)]] for x, y in safe],
+            "actorCellsExcluded": [list(p) for p in sorted(new.actors)], "signCellsExcluded": [list(p) for p in sorted(new.signs)],
+            "currentWalkableOutsideAnchorComponent": new_walkable-len(safe)},
+        "landmarkCoordinateAndReturnProof": landmark_proofs, "compilerObservation": compile_info, "romObservation": rom,
+        "migrationEvidencePolicy": {"refreshCachedViewportWhenSourceBanksOrMapChanged": True,
+            "preserveSavedPositionIfNewTerrainAndActorSignCheckPasses": True,
+            "doNotRelocateJustBecauseMapWordOrGraphicChanged": True,
+            "fallbacksOnlyForPositionsThatBecameInvalid": True,
+            "fallbackSelection": "nearest Manhattan distance among the connected safe set; then anchor distance,y,x",
+            "disconnectedButStillWalkablePositionsAreReportedNotAutomaticallyRelocated": True,
+            "runtimeSaveMutationOrStartupChangePerformed": False},
+        "provenance": {"baselineFilesSha256": {path: digest(raw) for path, raw in sorted(before.raw.items())},
+                       "currentFilesSha256": {path: digest(raw) for path, raw in sorted(current.raw.items())}},
+    }
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps({"report": str(output), "sourceHEAD": head, "summary": report["summary"], "rom": rom}, indent=2))
+    return report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline", default=BASE)
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    args = parser.parse_args()
+    describe(args.baseline, args.output)
