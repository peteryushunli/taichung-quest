+    for road in data['streets']:
+        color='#e3a84b' if road['role']=='primary-avenue' else '#cfb073'
+        if road['gradeReviewRequired']:color='#9b8ba7'
+        dr.line([pt(p) for p in road['projectedCenterline']],fill=color,width=4 if road['preferredSpine'] else 2)
+    for n in range(5):
+        v=n*64;dr.line((*pt((v,0)),*pt((v,256))),fill='#56615b',width=2)
+        dr.line((*pt((0,v)),*pt((256,v))),fill='#56615b',width=2)
+    for section in data['sections']:
+        x,y=section['worldOrigin'];caption=f"R{section['gridRow']} C{section['gridCol']} · {section['sourceDistrictAtCenter'] or 'urban'}"
+        box=dr.textbbox((0,0),caption,font=small);dr.rectangle((pt((x+1,y+1))[0],pt((x+1,y+1))[1],pt((x+1,y+1))[0]+box[2]+8,pt((x+1,y+1))[1]+24),fill='#faf9f4')
+        dr.text(pt((x+1.5,y+1)),caption,font=small,fill='#3b4a43')
+    conflict_ids={s for c in data['landmarkReserveConflicts'] for s in c['landmarks']}
+    for gym in data['landmarks']:
+        l,t,r,b=gym['reserveEnvelope'];color='#b8443c' if gym['id'] in conflict_ids else '#358273'
+        # Dashed sizing rectangles; deliberately not painted as real buildings.
+        for x in range(math.floor(l),math.ceil(r),2):
+            dr.line((*pt((x,t)),*pt((min(x+1,r),t))),fill=color,width=2);dr.line((*pt((x,b)),*pt((min(x+1,r),b))),fill=color,width=2)
+        for y in range(math.floor(t),math.ceil(b),2):
+            dr.line((*pt((l,y)),*pt((l,min(y+1,b)))),fill=color,width=2);dr.line((*pt((r,y)),*pt((r,min(y+1,b)))),fill=color,width=2)
+        x,y=pt(gym['rawProjectedPoint']);dr.ellipse((x-11,y-11,x+11,y+11),fill=color,outline='#ffffff',width=2)
+        label=str(gym['number']);bb=dr.textbbox((0,0),label,font=small);dr.text((x-(bb[2]-bb[0])/2,y-11),label,font=small,fill='white')
+    lx=margin+side+28;ly=top
+    dr.text((lx,ly),'REAL SOURCE / DRAFT OVERLAY',font=bold,fill='#173d3a');ly+=42
+    lines=[('Roads','Official Taichung 114-year survey'),('Gray lines','Source local road centerlines'),('Gold lines','Selected width/name backbone'),('Purple lines','Grade review; not walking ports'),('Background','Proposed neighborhood fill recipe'),('Faint rectangles','Unpainted candidate lots'),('Dashed boxes','Gym artwork/apron sizing reserves'),('Red reserves','Overlap / elastic spacing needed'),('Rail / water','Missing geometry; no invented traces')]
+    for label,desc in lines:
+        dr.text((lx,ly),label,font=f,fill='#233b34');ly+=25;dr.text((lx,ly),desc,font=small,fill='#626962');ly+=34
+    ly+=12;dr.text((lx,ly),'10 LANDMARKS = 10 GYMS',font=bold,fill='#173d3a');ly+=38
+    for gym in sorted(data['landmarks'],key=lambda g:g['number']):
+        dr.text((lx,ly),f"{gym['number']:>2}  {gym['name']}",font=small,fill='#283d35');ly+=25
+    ly+=22
+    for txt in ['Station/Miyahara and cultural-cluster','reserves conflict under uniform scaling.','Game entrances remain TBD; existing','native door contracts are preserved.','','Bounds: 120.62–120.72°E','24.11–24.20°N · north is up','No final native placements or zoning.']:
+        dr.text((lx,ly),txt,font=small,fill='#8a4238' if 'conflict' in txt else '#55645d');ly+=25
+    output.parent.mkdir(parents=True,exist_ok=True);im.save(output)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--roads',type=Path,required=True,help='R0002 .shp')
+    p.add_argument('--transport',type=Path,help='optional R0004 .shp')
+    p.add_argument('--landmarks',type=Path,required=True,help='Existing official tourism map.json points')
+    p.add_argument('--attractions',type=Path,help='Official dataset7777; supplies later approved Maple Garden point if absent from older map.json')
+    p.add_argument('--townships',type=Path,required=True)
+    p.add_argument('--baseline-contract',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--preview',type=Path)
+    p.add_argument('--source-metadata',type=Path,required=True)
+    args=p.parse_args()
+    metadata=json.loads(args.source_metadata.read_text())
+    points=list(json.loads(args.landmarks.read_text())['points'])
+    if not any(p['n']==14 for p in points):
+        if not args.attractions:p.error('Older landmark map lacks Maple Garden; supply --attractions official dataset7777')
+        attractions=json.loads(args.attractions.read_text())['Attractions']
+        maple=next(a for a in attractions if a['AttractionID']=='Attraction_387000000A_000818')
+        points.append(dict(n=14,name='Maple Garden',zh=maple['AttractionName'],coordinates=[maple['PositionLon'],maple['PositionLat']],sourceId=maple['AttractionID']))
+    towns=[f for f in json.loads(args.townships.read_text())['features'] if f['properties']['county'] in ('臺中市','台中市')]
+    baseline=json.loads(args.baseline_contract.read_text())
+    gyms,conflicts=reserve_landmarks(points,baseline)
+    if len(gyms)!=10:raise ValueError('Exactly ten approved gym points must be present')
+    roads,all_roads,stats,crs=read_roads(args.roads,BBOX)
+    transport=read_transport_polygons(args.transport,BBOX)
