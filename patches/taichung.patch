+// A small driver for the probe's QA page: headless Chrome over the DevTools protocol, no dependencies.
+import { spawn } from 'node:child_process';
+import { mkdtempSync, writeFileSync, mkdirSync } from 'node:fs';
+import { tmpdir, homedir } from 'node:os';
+import { join } from 'node:path';
+
+const CHROME = process.env.QA_CHROME ?? join(homedir(), 'Library/Caches/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-mac-arm64/chrome-headless-shell');
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+
+export async function open({ url, debugPort = 9337, outDir }) {
+  mkdirSync(outDir, { recursive: true });
+  const chrome = spawn(CHROME, [`--remote-debugging-port=${debugPort}`, `--user-data-dir=${mkdtempSync(join(tmpdir(), 'probe-qa-'))}`,
+    '--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist', '--window-size=480,360', 'about:blank'], { stdio: 'ignore' });
+  let version;
+  for (let i = 0; i < 100 && !version; i++) {
+    try { version = await (await fetch(`http://127.0.0.1:${debugPort}/json/version`)).json(); } catch { await sleep(100); }
+  }
+  if (!version) { chrome.kill(); throw new Error('headless Chrome did not start'); }
+  const socket = new WebSocket(version.webSocketDebuggerUrl);
+  await new Promise((resolve, reject) => { socket.onopen = resolve; socket.onerror = reject; });
+  let nextId = 1; const pending = new Map();
+  socket.onmessage = event => {
+    const message = JSON.parse(event.data);
+    if (message.id && pending.has(message.id)) {
+      const { resolve, reject } = pending.get(message.id); pending.delete(message.id);
+      message.error ? reject(new Error(message.error.message)) : resolve(message.result);
+    }
+  };
+  const send = (method, params = {}, sessionId) => new Promise((resolve, reject) => {
+    const id = nextId++; pending.set(id, { resolve, reject }); socket.send(JSON.stringify({ id, method, params, sessionId }));
+  });
+  const { targetId } = await send('Target.createTarget', { url: 'about:blank' });
+  const { sessionId } = await send('Target.attachToTarget', { targetId, flatten: true });
+  await send('Page.enable', {}, sessionId);
+  await send('Emulation.setDeviceMetricsOverride', { width: 480, height: 360, deviceScaleFactor: 1, mobile: false }, sessionId);
+  await send('Page.navigate', { url }, sessionId);
+  const evaluate = async expression => {
+    const result = await send('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true }, sessionId);
+    if (result.exceptionDetails) throw new Error(result.exceptionDetails.exception?.description ?? result.exceptionDetails.text);
+    return result.result.value;
+  };
+  for (let i = 0; i < 200; i++) { if (await evaluate('window.qaReady === true').catch(() => false)) break; await sleep(100); }
+
+  const qa = {
+    sleep, evaluate,
+    close() { socket.close(); chrome.kill(); },
+    load: (symbols, withSave) => evaluate(`qa.load(${JSON.stringify(symbols)}, ${withSave})`),
+    state: () => evaluate('qa.state()'),
+    press: (key, ms = 100, after = 200) => evaluate(`qa.press(${JSON.stringify(key)}, ${ms}, ${after})`),
+    async shot(name) {
+      let data = await evaluate('qa.frame()');
+      let png = Buffer.from(data.split(',')[1], 'base64');
+      if (png.length < 400) {   // an all-black canvas compresses to almost nothing: take the element from the compositor instead
+        png = Buffer.from((await send('Page.captureScreenshot', { format: 'png', clip: { x: 0, y: 0, width: 240, height: 160, scale: 1 } }, sessionId)).data, 'base64');
+      }
+      const path = join(outDir, name + '.png'); writeFileSync(path, png); return path;
+    },
+    // Hold a direction until the player has moved the given number of tiles (a map change counts as a move).
+    async walk(key, tiles, { timeout = 1500 } = {}) {
+      let last = await qa.state(), moved = 0, idle = Date.now();
+      await evaluate(`qa.down(${JSON.stringify(key)})`);
+      try {
+        while (moved < tiles) {
+          await sleep(20);
+          const now = await qa.state();
+          if (now.x !== last.x || now.y !== last.y || now.map !== last.map || now.group !== last.group) { moved++; idle = Date.now(); last = now; }
+          else if (Date.now() - idle > timeout) break;
+        }
+      } finally { await evaluate(`qa.up(${JSON.stringify(key)})`); }
+      await sleep(420);
+      return { moved, state: await qa.state() };
+    },
+    async waitField(ms = 15000) {
+      const until = Date.now() + ms; let s;
+      while (Date.now() < until) { s = await qa.state(); if (s.field) return s; await sleep(100); }
+      return s;
+    },
+  };
+  return qa;
+}
+
+// Frame-by-frame recording (see page.html): pull what the page has captured and write it out.
+import { appendFileSync } from 'node:fs';
+export async function flushRecording(qa, outDir) {
+  mkdirSync(join(outDir, 'frames'), { recursive: true });
+  let total = 0;
+  for (;;) {
+    const frames = await qa.evaluate('qa.recordTake(150)');
+    if (!frames.length) break;
+    for (const f of frames) {
+      const file = `${String(f.v).padStart(7, '0')}.png`;
+      writeFileSync(join(outDir, 'frames', file), Buffer.from(f.png, 'base64'));
+      delete f.png; f.file = file;
+      appendFileSync(join(outDir, 'frames.jsonl'), JSON.stringify(f) + '\n');
+    }
+    total += frames.length;
+  }
+  return total;
+}
