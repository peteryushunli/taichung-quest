+    assert all(actual.render(n) == before.render(n) and actual.attr(n) == before.attr(n) for n in preserved_ids+closure)
+    assert all(actual.entries(n) == before.entries(n) for n in closure)
+    assert all(actual.graphic(n) == before.graphic(n) for n in reserved)
+    assert actual.defs[0] == before.defs[0] and actual.attrs[0] == before.attrs[0]
+    assert actual.palettes[:8] == before.palettes[:8]
