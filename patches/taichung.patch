+
+static bool8 ApplyRelocation(struct WarpData *warp, const struct SavedPositionRelocation *table, u16 count)
+{
+    u16 i;
+    for (i = 0; i < count; i++)
+    {
+        if (warp->x == table[i].x && warp->y == table[i].y)
+        {
+            warp->x = table[i].toX;
+            warp->y = table[i].toY;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void RepairOldCityPosition(struct WarpData *warp, u16 sourceVersion)
+{
+    if (sourceVersion >= 3 || !IsOldCity(warp) || warp->warpId != -1)
+        return;
+    if (ApplyRelocation(warp, sOldCityV3Relocations, sizeof(sOldCityV3Relocations) / sizeof(sOldCityV3Relocations[0])))
+        return;
+    if (sourceVersion < 2)
+        ApplyRelocation(warp, sOldCityV1Relocations, sizeof(sOldCityV1Relocations) / sizeof(sOldCityV1Relocations[0]));
+}
+
+static bool8 IsXitun(const struct WarpData *warp)
+{
+    return warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_XITUN)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_XITUN);
+}
+
+static bool8 IsGreenway(const struct WarpData *warp)
+{
+    return warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_GREENWAY)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_GREENWAY);
+}
+
+static const struct ReworkShift *FindReworkShift(const struct WarpData *warp)
+{
+    u16 i;
+    for (i = 0; i < sizeof(sReworkShifts) / sizeof(sReworkShifts[0]); i++)
+    {
+        if (warp->mapGroup == sReworkShifts[i].mapGroup && warp->mapNum == sReworkShifts[i].mapNum)
+            return &sReworkShifts[i];
+    }
+    return NULL;
+}
+
+// City rework v10: every outdoor district grew outward for the raised freeway, so an explicit
+// position moves by its district's shift, and a cell the rework closed moves to its nearest open
+// cell. It runs after every older repair, whose tables are in released (v9) coordinates.
+static void RepairReworkPosition(struct WarpData *warp)
+{
+    const struct ReworkShift *shift = FindReworkShift(warp);
+
+    if (shift == NULL || warp->warpId != -1)
+        return;
+    if (ApplyRelocation(warp, shift->table, shift->count))
+        return;
+    warp->x += shift->dx;
+    warp->y += shift->dy;
+}
+
+static void RepairChangedCityPosition(struct WarpData *warp, u16 sourceVersion)
+{
+    RepairOldCityPosition(warp, sourceVersion);
+    if (sourceVersion < 4 && IsXitun(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sXitunV4Relocations, sizeof(sXitunV4Relocations) / sizeof(sXitunV4Relocations[0]));
+    if (sourceVersion < 5 && IsGreenway(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sGreenwayV5Relocations, sizeof(sGreenwayV5Relocations) / sizeof(sGreenwayV5Relocations[0]));
+    if (sourceVersion < 6 && IsGreenway(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sGreenwayV6Relocations, sizeof(sGreenwayV6Relocations) / sizeof(sGreenwayV6Relocations[0]));
+    if (sourceVersion < 7 && IsXitun(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sXitunV7Relocations, sizeof(sXitunV7Relocations) / sizeof(sXitunV7Relocations[0]));
+    if (sourceVersion < 8 && IsXitun(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sXitunV8Relocations, sizeof(sXitunV8Relocations) / sizeof(sXitunV8Relocations[0]));
+    if (sourceVersion < 9 && IsXitun(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sXitunV9Relocations, sizeof(sXitunV9Relocations) / sizeof(sXitunV9Relocations[0]));
+    if (sourceVersion < 10)
+        RepairReworkPosition(warp);
+}
+
+// OldCity v8: city-v3 buildings replace generic apartment blocks.
+// OldCity map SHA256 9fcce4bcd0b3c11cd743a01ce382c40c8e792262d0ef5c69750f655414af0ced
+// Every replaced cell keeps its collision and elevation, so a saved OldCity cache is only refreshed.
+// Combined v8 (2026-11-08): the Xitun street layout ships in the same version, and Nantun opens
+// twelve Greenway seam cells from trees to pavers, so every older outdoor save reloads its
+// district once; Xitun positions were repaired by sXitunV8Relocations above.
+// City rework v10: every outdoor district's layout changes, so every older outdoor save reloads once.
+static bool8 UsesChangedCityBanks(const struct WarpData *warp, u16 sourceVersion)
+{
+    if (sourceVersion < 10 && FindReworkShift(warp) != NULL)
+        return TRUE;
+    if (sourceVersion < 8 && (IsOldCity(warp) || IsGreenway(warp) || IsXitun(warp)))
+        return TRUE;
+    // Only Xitun collision words changed at v9. Other v8 districts keep their cache.
+    return sourceVersion < 9 && IsXitun(warp);
+}
+
+static void RememberCacheRefreshFacing(const struct WarpData *warp, u16 sourceVersion)
+{
+    u8 i;
+    const struct ReworkShift *shift = sourceVersion < 10 ? FindReworkShift(warp) : NULL;
+    s16 x = gSaveBlock1Ptr->pos.x, y = gSaveBlock1Ptr->pos.y;
+
+    if (shift != NULL)
+    {
+        // The v10 shift keeps the player on the same world tile, so it is not a repair.
+        x += shift->dx;
+        y += shift->dy;
+    }
+    if (warp->x != x || warp->y != y)
+        return; // A repaired/relocated position uses the normal arrival rules.
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        const struct ObjectEvent *object = &gSaveBlock1Ptr->objectEvents[i];
+        if (!object->active || !object->isPlayer)
+            continue;
+        if (sContinueFacing.direction != DIR_NONE
+            || object->facingDirection < DIR_SOUTH || object->facingDirection > DIR_EAST)
+        {
+            sContinueFacing.direction = DIR_NONE;
+            return; // Ambiguous/invalid saved players keep the engine default.
+        }
+        sContinueFacing.x = warp->x;
+        sContinueFacing.y = warp->y;
+        sContinueFacing.mapGroup = warp->mapGroup;
+        sContinueFacing.mapNum = warp->mapNum;
+        sContinueFacing.direction = object->facingDirection;
+    }
+}
+
+void TaichungSaveRememberObjectCacheRefreshFacing(void)
+{
+    const struct WarpData *warp;
+
+    if (gSaveBlock1Ptr == NULL || UseContinueGameWarp())
+        return; // An existing native return/repair keeps priority.
+    warp = &gSaveBlock1Ptr->continueGameWarp;
+    if (warp->warpId != -1
+        || warp->mapGroup != gSaveBlock1Ptr->location.mapGroup
+        || warp->mapNum != gSaveBlock1Ptr->location.mapNum)
+        return;
+    // The save is already current here (the upgrade ran first), so no v10 shift applies.
+    RememberCacheRefreshFacing(warp, TAICHUNG_SAVE_VERSION);
+}
+
+u8 TaichungSaveConsumeContinueFacing(void)
+{
+    u8 direction = sContinueFacing.direction;
+    sContinueFacing.direction = DIR_NONE;
+    if (gSaveBlock1Ptr->location.warpId != -1
+        || gSaveBlock1Ptr->location.mapGroup != sContinueFacing.mapGroup
+        || gSaveBlock1Ptr->location.mapNum != sContinueFacing.mapNum
+        || gSaveBlock1Ptr->pos.x != sContinueFacing.x
+        || gSaveBlock1Ptr->pos.y != sContinueFacing.y)
+        return DIR_NONE; // A later native warp always wins, even on this load.
+    return direction;
+}
+
+static void ReloadCityBanksOnContinue(u16 sourceVersion)
+{
+    struct WarpData *warp = &gSaveBlock1Ptr->continueGameWarp;
+
+    if (UseContinueGameWarp())
+    {
+        // An existing native return already takes the full map-load path.
+        // Preserve it, except for an explicit target on an exact newly invalid cell for this source version.
+        RepairChangedCityPosition(warp, sourceVersion);
+        return;
+    }
+    if (!UsesChangedCityBanks(&gSaveBlock1Ptr->location, sourceVersion))
+        return;
+
+    *warp = gSaveBlock1Ptr->location;
+    warp->warpId = -1;
+    // location.x/y describe the last warp; pos is the actual saved position.
+    warp->x = gSaveBlock1Ptr->pos.x;
+    warp->y = gSaveBlock1Ptr->pos.y;
+    RepairChangedCityPosition(warp, sourceVersion);
+    RememberCacheRefreshFacing(warp, sourceVersion);
+
+    // Continue first overlays mapView, then this warp reloads the authored map.
+    // Zeroing mapView alone is unsafe: the non-UBFIX emptiness check overreads.
+    SetContinueGameWarpStatus();
+}
+
+void TaichungSaveUpgradeOnContinue(void)
+{
+    bool8 inCity;
+    u16 version = SavedVar(TAICHUNG_SAVE_VERSION_VAR);
+
+    sContinueFacing.direction = DIR_NONE;
+    // Both ordinary and quest-log Continue start a fresh transient session,
+    // even when no save migration is needed. Map/whiteout returns do not.
+    TaichungGymCancelChallenge();
+    if (version >= TAICHUNG_SAVE_VERSION
+        || gSaveBlock1Ptr->playerPartyCount == 0)
+        return;
+
+    if (version == 1 || version == 2 || version == 3 || version == 4 || version == 5 || version == 6 || version == 7 || version == 8 || version == 9)
+    {
+        // Versioned city saves already own their language, team and checkpoint.
+        ReloadCityBanksOnContinue(version);
+        VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+        return;
+    }
+
+    // The earliest prototype had a fixed Bulbasaur and only the tea marker.
+    // Untouched FireRed saves have neither marker and are left alone.
+    if (!HasPrototypeStarter())
+    {
+        if (SavedVar(TAICHUNG_STARTER_VAR) != 0 || SavedVar(TAICHUNG_TEA_VAR) == 0)
+            return;
+        VarSet(TAICHUNG_STARTER_VAR, SPECIES_BULBASAUR);
+    }
+
+    if (SavedVar(TAICHUNG_LANGUAGE_VAR) != TAICHUNG_LANGUAGE_EN
+        && SavedVar(TAICHUNG_LANGUAGE_VAR) != TAICHUNG_LANGUAGE_ZH)
+        VarSet(TAICHUNG_LANGUAGE_VAR, TAICHUNG_LANGUAGE_EN);
+
+    inCity = gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        && gSaveBlock1Ptr->location.mapNum <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM);
+    if (!inCity)
+    {
+        // Use the engine's full map-load path rather than editing a saved
+        // position under an old layout/object-event cache.
+        SetStationWarp(&gSaveBlock1Ptr->continueGameWarp);
+        SetContinueGameWarpStatus();
+    }
+    else
+    {
+        ReloadCityBanksOnContinue(version);
+    }
+    VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+    TaichungSaveSetStationCheckpoint();
+}
