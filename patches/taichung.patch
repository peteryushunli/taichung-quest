+def compile_scene(sc,fixed,code_ids,capacity_only=False):
+ bank=sc['bank'];grid=sc['grid'];w=sc['layout']['width']
+ # Signs are original native metatiles and interactions, placed after the artwork.
+ for pt,word in sc['signs'].items():
+  grid[pt[1]*w+pt[0]]=word
+  overlay=sc['overlays'].pop(pt,None)
+  if pt in sc['signInfo']:sc['signInfo'][pt]['overlay']=overlay
+  sc['allowed'].add(pt)
+ drawn={v&1023 for i,v in enumerate(grid) if (i%w,i//w) not in sc['overlays']}|{v&1023 for v in sc['border']}|fixed
+ used=drawn|code_ids
+ sand_refs={v&1023 for n in drawn for v in bank.entries(n) if 464<=v&1023<482}
+ assert not sand_refs,(sc['name'],'Visible sand animation needs its original slots',sorted(sand_refs))
+ used={n for n in used if len(bank.entries(n))==8}
+ pinned=set(ANIMATED)|{0,20}
+ for n in fixed:
+  pinned|={v&1023 for v in bank.entries(n)}
+ packer=Packer(bank,pinned)
+ defs=[bank.entries(n) if len(bank.entries(n))==8 else [0]*8 for n in range(1024)]
+ attrs=[bank.attr(n) if n<640 or n-640<len(bank.attrs[1]) else 0 for n in range(1024)]
+ palettes=copy.deepcopy(bank.pals)
+ used_palettes=set()
+ for n in sorted(used):
+  entries=bank.entries(n)
+  for k,word in enumerate(entries):
+   if k<4 or any(bank.tile(word&1023)):used_palettes.add(word>>12)
+  if n not in fixed:
+   defs[n]=[v if v&1023 in ANIMATED else (v&0xF000)|(packer.pack(bank.tile(v&1023))^(v&0xC00)) for v in entries]
+ # Flatten floor pixels into the lower layer without fitting/quantizing colors.
+ floors={o['floor'] for o in sc['overlays'].values()}|{s['floor'] for s in sc['signInfo'].values()};floor_entries={}
+ for n in floors:
+  rgb=bank.render(n);entries=[]
+  for y in (0,8):
+   for x in (0,8):
+    colors=list(rgb.crop((x,y,x+8,y+8)).get_flattened_data());setcolors=set(colors)
+    choices=[p for p in range(13) if setcolors<=set(palettes[p])]
+    assert choices,f'Ground tile {n:#x} needs an unavailable exact palette'
+    p=choices[0];used_palettes.add(p)
+    entries.append(packer.pack(bytes(palettes[p].index(c) for c in colors))|(p<<12))
+  floor_entries[n]=entries
+ available=iter(sorted(set(range(13))-used_palettes,reverse=True));art_palettes={}
+ for overlay in sc['overlays'].values():
+  pal=overlay['palette']
+  if pal not in art_palettes:
+   try:p=next(available)
+   except StopIteration:raise ValueError(f"{sc['name']}: no free palette among13, used{sorted(used_palettes)}")
+   art_palettes[pal]=p;palettes[p]=[tuple(pal[i:i+3]) for i in range(0,48,3)]
+ # An opaque8px art tile does not need the ground beneath it. Factor a common
+ # solid fill into the lower BG and use transparent detail above it. This is
+ # pixel-exact and shares far more patterns than storing each baked fill/detail.
+ rawtiles={}
+ candidate_frequency=Counter()
+ for o in sc['overlays'].values():
+  tiles=[o['image'].crop((x,y,x+8,y+8)).tobytes() for y in (0,8) for x in (0,8)]
+  rawtiles[id(o)]=tiles
+  for t in set(tiles):
+   if 0 not in t:
+    for color in set(t):candidate_frequency[canonical(bytes(0 if c==color else c for c in t))[0]]+=1
+ for o in sc['overlays'].values():
+  o['topTiles']=[];o['artBases']=[]
+  for t in rawtiles[id(o)]:
+   top=t;base=None
+   if 0 not in t and canonical(t)[0] not in packer.lookup:
+    choices=[]
+    for color in set(t):
+     detail=bytes(0 if c==color else c for c in t);key=canonical(detail)[0]
+     cost=int(key not in packer.lookup)+int(canonical(bytes([color])*64)[0] not in packer.lookup)
+     choices.append((cost,-candidate_frequency[key],-t.count(color),color,detail))
+    cost,_,_,color,detail=min(choices)
+    if cost<=1:top=detail;base=color
+   o['topTiles'].append(top);o['artBases'].append(base)
+ # Palette indices are arbitrary. Reorder them (and every corresponding pixel)
+ # to share more geometry with existing art while preserving every RGB exactly.
+ art_groups={pal:[o for o in sc['overlays'].values() if o['palette']==pal] for pal in art_palettes}
+ virtual_known=set(packer.lookup);palette_savings=0;permutations={}
+ for pal,group in sorted(art_groups.items(),key=lambda item:-len(item[1])):
+  patterns=set()
+  for o in group:
+   patterns|={canonical(t)[0] for t in o['topTiles']}
+   patterns|={canonical(bytes([c])*64)[0] for c in o['artBases'] if c is not None}
+  permutation,savings=optimize_indices(patterns,virtual_known);palette_savings+=savings
+  permutations[pal]=permutation
+  table=bytes(permutation)+bytes(range(16,256))
+  mapped={canonical(t.translate(table))[0] for t in patterns};virtual_known|=mapped
+  p=art_palettes[pal];original_pal=[tuple(pal[i:i+3]) for i in range(0,48,3)]
+  for old_index,new_index in enumerate(permutation):palettes[p][new_index]=original_pal[old_index]
+  for o in group:
+   o['topTiles']=[t.translate(table) for t in o['topTiles']]
+   o['artBases']=[None if c is None else permutation[c] for c in o['artBases']]
+  assert sorted(permutation)==list(range(16)) and permutation[0]==0
+ free_defs=iter([n for n in list(range(640,1023))+list(range(640)) if n not in used])
+ patterns={canonical(bank.tile(v&1023))[0] for n in used for v in bank.entries(n) if v&1023 not in ANIMATED}
+ for o in sc['overlays'].values():
+  patterns|={canonical(t)[0] for t in o['topTiles']}
+  patterns|={canonical(bytes([c])*64)[0] for c in o['artBases'] if c is not None}
+ pinned_patterns={canonical(bank.tile(n))[0] for n in pinned-ANIMATED}
+ allpatterns=patterns|pinned_patterns
+ capacity=dict(drawnDefinitions=len(drawn),codeDefinitions=len(code_ids),pinnedGraphics=len(pinned),
+   oldPackedBeforeArt=len(packer.allocated),artPalettes=list(art_palettes.values()),uniqueStaticPatternDemand=len(patterns),
+   predictedTotalGraphics=len(allpatterns)+len(pinned)-len(pinned_patterns),losslessPaletteReuseSavings=palette_savings)
+ print(sc['name'],capacity,flush=True)
+ if capacity_only:return capacity
+ known={};count=0
+ for (x,y),overlay in sorted(sc['overlays'].items()):
+  p=art_palettes[overlay['palette']]
+  top=[packer.pack(t)|(p<<12) for t in overlay['topTiles']]
+  lower=[floor_entries[overlay['floor']][k] if c is None else packer.pack(bytes([c])*64)|(p<<12) for k,c in enumerate(overlay['artBases'])]
+  entry=lower+top
+  attr=0 if overlay['solid'] else (1<<29) # walking art stays behind the player
+  key=tuple(entry),attr
+  if key not in known:
+   try:n=next(free_defs)
+   except StopIteration:raise ValueError(sc['name']+': metatile definitions exhausted')
+   defs[n]=entry;attrs[n]=attr;known[key]=n
+  n=known[key];grid[y*w+x]=(grid[y*w+x]&0xFC00)|n;count+=1
+ for (x,y),sign in sc['signInfo'].items():
+  o=sign['overlay']
+  if o and any(o['image'].tobytes()):
+   # Preserve the artist's forecourt tone rather than a grass square or a
+   # building fragment underneath the native wood-post upper layer.
+   color=Counter(c for c in o['image'].tobytes() if c).most_common(1)[0][0]
+   p=art_palettes[o['palette']];color=permutations[o['palette']][color]
+   lower=[packer.pack(bytes([color])*64)|(p<<12)]*4
+  else:lower=floor_entries[sign['floor']]
+  entry=lower+defs[3][4:];attr=bank.attr(3)
+  key=tuple(entry),attr
+  if key not in known:
+   n=next(free_defs);defs[n]=entry;attrs[n]=attr;known[key]=n
+  grid[y*w+x]=0x3400|known[key]
+ # Fill all unallocated raw slots with old pixels; named dynamic/animation slots
+ # and borrowed preview strips were pinned, so late runtime writes remain safe.
+ tiles=[packer.tiles.get(n,bank.tile(n)) for n in range(1024)]
+ sc.update(newdefs=defs,newattrs=attrs,newpals=palettes,newtiles=tiles,fixed=fixed,
+   budget=dict(artCells=count,newDefinitions=len(known),usedPalettes=sorted(used_palettes),
+     artPaletteSlots=list(art_palettes.values()),fixedGraphicSlots=len(pinned),allocatedGraphics=len(packer.allocated),
+     staticGraphicsUsed=len(pinned|set(packer.allocated)),graphicsCapacity=1016))
