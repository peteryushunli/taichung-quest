+      "\t.include \"data/maps/TaichungOldCityNorth/scripts.inc\"\n",
+      "\n@ City rework landmarks and place names (phase 2b).\nTaichungCity_Sign_BotanicalGarden::\n\tmsgbox TaichungCity_Text_BotanicalGarden, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_BotanicalGarden::\n\t.string \"Botanical Garden\\n\"\n\t.string \"A rainforest under glass.$\"\n\nTaichungCity_Sign_ConfuciusTemple::\n\tmsgbox TaichungCity_Text_ConfuciusTemple, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_ConfuciusTemple::\n\t.string \"Taichung Confucius Temple\\n\"\n\t.string \"Through the Lingxing gate.$\"\n\nTaichungCity_Sign_YizhongStreet::\n\tmsgbox TaichungCity_Text_YizhongStreet, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_YizhongStreet::\n\t.string \"Yizhong Street\\n\"\n\t.string \"Students, snacks, late nights.$\"\n\nTaichungCity_Sign_PrefecturalHall::\n\tmsgbox TaichungCity_Text_PrefecturalHall, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_PrefecturalHall::\n\t.string \"Taichung Prefectural Hall\\n\"\n\t.string \"Red brick, begun in 1913.$\"\n\nTaichungCity_Sign_SecondMarket::\n\tmsgbox TaichungCity_Text_SecondMarket, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_SecondMarket::\n\t.string \"Second Market\\n\"\n\t.string \"Six-sided tower, since 1936.$\"\n\nTaichungCity_Sign_Hwy74::\n\tmsgbox TaichungCity_Text_Hwy74, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_Hwy74::\n\t.string \"Hwy 74\\n\"\n\t.string \"Taichung's ring expressway.$\"\n\nTaichungCity_Sign_GreenRiver::\n\tmsgbox TaichungCity_Text_GreenRiver, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_GreenRiver::\n\t.string \"Green River\\n\"\n\t.string \"The old city's own stream.$\"\n\nTaichungCity_Sign_HanCreek::\n\tmsgbox TaichungCity_Text_HanCreek, MSGBOX_SIGN\n\tend\n\nTaichungCity_Text_HanCreek::\n\t.string \"Han Creek\\n\"\n\t.string \"Its old name means dry creek.$\"\n"
