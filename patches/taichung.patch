+
+struct Main gMain;
+struct PaletteFade gPaletteFade;
+struct Sprite gSprites[MAX_SPRITES];
+struct Task gTasks[16];
+const union AnimCmd *const gDummySpriteAnimTable[] = {NULL};
+const union AffineAnimCmd *const gDummySpriteAffineAnimTable[] = {NULL};
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+u16 gSpecialVar_0x8004, gSpecialVar_Result;
+u8 gQuestLogState;
+static u8 sPlayback;
+static MainCallback sMain, sVBlank, sCardReturn;
+static bool8 sChinese, sWindow, sWindowFail, sPaletteFail, sFanfare;
+static u16 sPaletteTags[2];
+static unsigned sWrites, sReturns, sCards, sCleanups, sFanfareCount, sCreates, sFailSpriteAt, sPaletteLoads, sFailPaletteAt;
+static const char *sPrinted[64];
+static unsigned sPrintCount;
+
+u16 VarGet(u16 id) { (void)id; assert(0 && "Read saved progress directly"); return 0; }
+bool8 VarSet(u16 id, u16 value) { assert(id == TAICHUNG_GYM_COMPLETION_VAR); sSave.vars[id - 0x4000] = value; sWrites++; return TRUE; }
+const u8 *TaichungText(const u8 *en, const u8 *zh) { return sChinese ? zh : en; }
+u8 QL_GetPlaybackState(void) { return sPlayback; }
+void SetMainCallback2(MainCallback cb) { sMain = cb; }
+void SetVBlankCallback(MainCallback cb) { sVBlank = cb; }
+void SetHBlankCallback(MainCallback cb) { assert(cb == NULL); }
+void CB2_ReturnToFieldContinueScriptPlayMapMusic(void) { sReturns++; }
+static void CardScene(void) {}
+void ShowPlayerTrainerCard(MainCallback cb) { sCards++; sCardReturn = cb; sMain = CardScene; }
+void CleanupOverworldWindowsAndTilemaps(void) { sCleanups++; }
+void SpriteCallbackDummy(struct Sprite *sprite) { (void)sprite; }
+void ResetSpriteData(void) { memset(gSprites, 0, sizeof(gSprites)); sCreates = 0; }
+u8 CreateSprite(const struct SpriteTemplate *template, s16 x, s16 y, u8 priority)
+{
+    u8 id;
+    (void)priority;
+    assert(x >= 0 && x < 240 && y >= 0 && y < 160);
+    assert(template->tileTag == TAG_NONE && template->images->data != NULL);
+    assert(template->images->size == 128 || template->images->size == 512);
+    assert(template->oam->priority == 0);
+    sCreates++;
+    if (sFailSpriteAt == sCreates)
+        return MAX_SPRITES;
+    for (id = 0; id < MAX_SPRITES; id++)
+        if (!gSprites[id].inUse)
+        {
+            gSprites[id].inUse = TRUE;
+            gSprites[id].template = template;
+            return id;
+        }
+    return MAX_SPRITES;
+}
+void DestroySprite(struct Sprite *sprite) { assert(sprite->inUse); sprite->inUse = FALSE; }
+u8 LoadSpritePalette(const struct SpritePalette *palette)
+{
+    u8 id;
+    sPaletteLoads++;
+    if (sPaletteFail || sPaletteLoads == sFailPaletteAt)
+        return 0xFF;
+    for (id = 0; id < 2; id++)
+        if (!sPaletteTags[id]) { sPaletteTags[id] = palette->tag; return id; }
+    assert(0); return 0xFF;
+}
+void FreeSpritePaletteByTag(u16 tag) { u8 i; for (i = 0; i < 2; i++) if (sPaletteTags[i] == tag) sPaletteTags[i] = 0; }
+void FreeAllSpritePalettes(void) { memset(sPaletteTags, 0, sizeof(sPaletteTags)); sPaletteLoads = 0; }
