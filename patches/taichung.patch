+#!/usr/bin/env python3
+"""Gym interiors and the Wanhe Temple gym (save v12), as one exact layer over BASE.
+
+The user approved (2026-11-11, review board draft 3) a room of its own for every
+gym, shaped like its building, and moved Muqing's gym (save bit 8) from Maple
+Garden to Wanhe Temple. See docs/gym-interiors.md.
+
+- Ten gym layouts LAYOUT_TAICHUNG_GYM_* and six private secondary tilesets,
+  derived by tools/taichung/gym_interiors/install_gyms.py (byte for byte).
+- Each gym map points at its room; its leader and one helper only move; its
+  three exit warps sit on the room's exit (warp 1 = the middle arrow mat).
+- Wanhe Temple hall: Muqing leads the gym there (gym music); Maple Garden keeps
+  only its scientist guide. Badge bit 8 is now the Tide Badge.
+- Save v12: a save inside any of the eleven rooms reloads it on warp 1.
+
+Every edited and added file is pinned in MANIFEST (whose own hash is pinned
+here), and the BASE copy of every edited file ships in BUNDLE, so the check is
+portable (no native git history). Older registered guards read the bytes beneath
+this layer through `underneath` and leave out the files it adds (`added`);
+home_start.py peels it first, so every guard beneath the guest house sees
+beneath this layer too.
+
+  gym_interiors_guard.py                    print the report
+  gym_interiors_guard.py --install          re-pin the manifest's files after an edit or a merge
+                                            (writes the baseline bundle and manifest; needs BASE in git)
+  gym_interiors_guard.py --install --rescan take the file list from git against BASE instead, to add
+                                            or drop files (on a merged tree it also takes the other
+                                            change's files)
+  gym_interiors_guard.py --self-test        also prove each corruption probe is caught
+"""
+from __future__ import annotations
+
+import argparse
+from collections import deque
+import hashlib
+import json
+from pathlib import Path, PurePosixPath
+import re
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+BASE = "9cb6855eb178cffbcae8b533ff90e90e607c29e1"
+LAYER = "data/taichung/gym-interiors"
+BUNDLE = f"{LAYER}/baseline"
+MANIFEST = f"{LAYER}/manifest.json"
+MANIFEST_SHA256 = "8a85eadff344f7c95575417f3e8b8ade0f8184d343814de2a5646b614b103028"
+
+LAYOUTS = "data/layouts/layouts.json"
+SAVE_HEADER = "include/taichung_save.h"
+CONTRACT = "docs/taichung-city-contract.json"
+# map folder -> (its own room layout, its leader's local id)
+ROOMS = {
+    "TaichungOldStation_Gym": ("LAYOUT_TAICHUNG_GYM_OLD_STATION", "LOCALID_TAICHUNG_OLD_STATION_HOST"),
+    "TaichungPark_Gym": ("LAYOUT_TAICHUNG_GYM_PARK", "LOCALID_TAICHUNG_PARK_HOST"),
+    "TaichungMiyahara_Gym": ("LAYOUT_TAICHUNG_GYM_MIYAHARA", "LOCALID_TAICHUNG_MIYAHARA_HOST"),
+    "TaichungScienceMuseum_Gym": ("LAYOUT_TAICHUNG_GYM_SCIENCE_MUSEUM", "LOCALID_TAICHUNG_SCIENCE_MUSEUM_HOST"),
+    "TaichungGreenway_Gym": ("LAYOUT_TAICHUNG_GYM_GREENWAY", "LOCALID_TAICHUNG_GREENWAY_HOST"),
+    "TaichungShenJi_Gym": ("LAYOUT_TAICHUNG_GYM_SHEN_JI", "LOCALID_TAICHUNG_SHEN_JI_HOST"),
+    "TaichungFineArts_Gym": ("LAYOUT_TAICHUNG_GYM_FINE_ARTS", "LOCALID_TAICHUNG_FINE_ARTS_HOST"),
+    "TaichungFengjia_Gym": ("LAYOUT_TAICHUNG_GYM_FENGJIA", "LOCALID_TAICHUNG_FENGJIA_HOST"),
+    "TaichungTheater_Gym": ("LAYOUT_TAICHUNG_GYM_THEATER", "LOCALID_TAICHUNG_THEATER_HOST"),
+    "TaichungWanheTemple_Hall": ("LAYOUT_TAICHUNG_GYM_WANHE_TEMPLE", "LOCALID_TAICHUNG_WANHE_TEMPLE_GYM_HOST"),
+}
+MAPLE = "TaichungMapleGarden_Gym"
+MUQING = "OBJ_EVENT_GFX_TAICHUNG_MUQING"
+PRIVATE_TILESETS = ("old_station", "park", "miyahara", "fine_arts", "fengjia", "theater")
+MB_SOUTH_ARROW_WARP = 0x65
+VOID_BORDER = struct.pack("<4H", *(0x0008,) * 4)
+SECONDARY_START = 0x280
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def words(raw, fmt="H"):
+    size = struct.calcsize(fmt)
+    return list(struct.unpack(f"<{len(raw) // size}{fmt}", raw))
+
+
+def _reader(source, overrides):
+    overrides = overrides or {}
+    return lambda path: overrides[path] if path in overrides else (Path(source) / path).read_bytes()
+
+
+def manifest(read):
+    raw = read(MANIFEST)
+    require(digest(raw) == MANIFEST_SHA256, "The gym interiors manifest differs from the reviewed one")
+    return json.loads(raw)
+
+
+def baseline(read, record):
+    """BASE bytes of every file this layer edits, from the bundle shipped with the
+    patch; raises ValueError if any copy differs."""
+    out = {}
+    for path, expected in record["before"].items():
+        raw = read(f"{BUNDLE}/{path}")
+        require(digest(raw) == expected, f"Baseline copy differs: {path}")
+        out[path] = raw
+    return out
+
+
+def reachable(grid, width, height, start, blocked):
+    open_ = lambda x, y: 0 <= x < width and 0 <= y < height and not grid[y * width + x] & 0xC00 and (x, y) not in blocked
+    seen, queue = {start}, deque([start])
+    while queue:
+        x, y = queue.popleft()
+        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            n = (x + dx, y + dy)
+            if n not in seen and open_(*n):
+                seen.add(n); queue.append(n)
+    return seen, open_
+
+
+def verified(read):
+    """The report when the tree `read` gives is exactly BASE plus this layer;
+    raises ValueError (or OSError) otherwise. Returns (report, BASE bytes)."""
+    record = manifest(read)
+    require(record["base"] == BASE, "Manifest base differs")
+    before = baseline(read, record)
+    for path, expected in {**record["edited"], **record["added"]}.items():
+        require(digest(read(path)) == expected, f"{path} differs from the reviewed gym interiors")
+
+    # Independent semantic closure, re-derived from the tree, for the report.
+    layouts = {l["id"]: l for l in json.loads(read(LAYOUTS))["layouts"] if "id" in l}
+    rooms = {}
+    for name, (layout_id, leader_id) in ROOMS.items():
+        data = json.loads(read(f"data/maps/{name}/map.json"))
+        require(data["layout"] == layout_id and layout_id in layouts, f"{name} does not use its own room")
+        layout = layouts[layout_id]
+        width, height = layout["width"], layout["height"]
+        grid = words(read(layout["blockdata_filepath"]))
+        require(len(grid) == width * height, f"{layout_id} size differs")
+        require(read(layout["border_filepath"]) == VOID_BORDER, f"{layout_id} border is not the black void")
+        warps = data["warp_events"]
+        require(len(warps) == 3 and len({(w["dest_map"], w["dest_warp_id"]) for w in warps}) == 1
+                and all(w["elevation"] == 3 for w in warps), f"{name} exit warps differ")
+        mat = (warps[1]["x"], warps[1]["y"])
+        people = [(o["x"], o["y"]) for o in data["object_events"]]
+        require(len(people) == 2 and data["object_events"][0].get("local_id") == leader_id,
+                f"{name} is not its leader plus one helper")
+        seen, open_ = reachable(grid, width, height, mat, set(people))
+        require(open_(*mat) and all((w["x"], w["y"]) in seen for w in warps), f"{name} exit cells are not open")
+        for x, y in people:
+            require(not grid[y * width + x] & 0xC00, f"{name} has someone standing in a wall at ({x},{y})")
+            require(any((x + dx, y + dy) in seen for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1))),
+                    f"{name}: nobody can reach ({x},{y}) from the exit mat")
+        secondary = layout["secondary_tileset"]
+        if secondary.startswith("gTileset_TaichungGym"):
+            folder = "data/tilesets/secondary/taichung_gym_" + re.sub(r"(?<!^)(?=[A-Z])", "_", secondary[len("gTileset_TaichungGym"):]).lower()
+            attributes = words(read(f"{folder}/metatile_attributes.bin"), "I")
+            metatiles = read(f"{folder}/metatiles.bin")
+            require(len(attributes) <= 384 and len(metatiles) == len(attributes) * 16, f"{folder} exceeds a secondary bank")
+            cell = grid[mat[1] * width + mat[0]] & 0x3FF
+            require(cell >= SECONDARY_START and attributes[cell - SECONDARY_START] & 0x1FF == MB_SOUTH_ARROW_WARP,
+                    f"{name} exit mat is not a south arrow warp")
+        rooms[name] = {"layout": layout_id, "size": [width, height], "exit": list(mat), "people": [list(p) for p in people],
+                       "reachableCells": len(seen), "secondary": secondary}
+
+    wanhe = json.loads(read("data/maps/TaichungWanheTemple_Hall/map.json"))
+    maple = json.loads(read(f"data/maps/{MAPLE}/map.json"))
+    require(wanhe["object_events"][0]["graphics_id"] == MUQING and wanhe["object_events"][0]["script"] == "TaichungCity_Host_MapleGarden"
+            and wanhe["music"] == "MUS_GYM", "Muqing does not lead the Wanhe Temple gym")
+    require(all(o["graphics_id"] != MUQING for o in maple["object_events"]) and len(maple["object_events"]) == 1
+            and maple["music"] == "MUS_FUCHSIA", "Maple Garden is not a visit-only hall")
+    contract = {l["id"]: l for l in json.loads(read(CONTRACT))["landmarks"]}
+    require(contract["wanhe-temple"].get("gym", True) is True and contract["maple-garden"].get("gym") is False,
+            "The city contract does not mark Wanhe as the gym and Maple Garden as a hall")
+    require(re.search(rb"#define TAICHUNG_SAVE_VERSION 12\b", read(SAVE_HEADER)) is not None, "Save version is not 12")
+    report = {"rooms": rooms, "privateTilesets": len(PRIVATE_TILESETS), "wanheGym": True, "mapleGardenHall": True,
+              "saveVersion": 12, "pinnedEdits": len(record["edited"]), "addedFiles": len(record["added"])}
+    return report, before
+
+
+def check(source=ROOT, overrides=None):
+    try:
+        report, before = verified(_reader(Path(source).resolve(), overrides))
+        return {"passed": True, "errors": [], "base": BASE, "checks": report, "underlayPaths": len(before)}
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        return {"passed": False, "errors": [str(error)], "base": BASE}
+
+
+def underneath(files):
+    """{path: BASE bytes} for every file this layer edits, when `files.read` gives
+    exactly BASE plus this layer; otherwise {}, so a guard reads the real bytes.
+    Files the layer adds are listed by added() (and their folders by added_dirs())."""
+    try:
+        return verified(files.read)[1]
+    except (OSError, ValueError, KeyError, TypeError, IndexError):
+        return {}
+
+
+def added(read):
+    """Paths a mirror beneath this layer leaves out: every added file, and every
+    folder that only holds added files (empty when the tree does not hold the
+    reviewed manifest)."""
+    try:
+        record = manifest(read)
+        return set(record["added"]) | set(record["addedDirs"])
+    except (OSError, ValueError, KeyError, TypeError):
+        return set()
+
+
+GUARD = "tools/taichung/gym_interiors_guard.py"
+
+
+def _git(source):
+    return lambda *args: subprocess.run(["git", *args], cwd=source, check=True, capture_output=True).stdout
+
+
+def has_base(source):
+    """True when `source` is a git checkout that holds BASE."""
+    try:
+        _git(source)("cat-file", "-e", f"{BASE}^{{commit}}")
+        return True
+    except (OSError, subprocess.CalledProcessError):
+        return False
+
+
+def scan(source=ROOT):
+    """(edited, added): every file the tree changes against BASE, committed or not,
+    leaving out this layer's own folder, this guard and build output. Files that
+    BASE lacks are added even once committed. Needs BASE in git. On a tree where a
+    later change is merged over this layer, its files are listed too."""
+    git = _git(Path(source).resolve())
+    skip = lambda path: path.startswith(("build/", LAYER + "/")) or path == GUARD
+    edited, new = set(), set()
+    fields = git("diff", "--name-status", "--no-renames", "-z", BASE, "--").decode().split("\0")
+    for status, path in zip(fields[0::2], fields[1::2]):
+        if skip(path):
+            continue
+        require(status in ("M", "T", "A"), f"The gym interiors layer does not delete files: {status} {path}")
+        (new if status == "A" else edited).add(path)
+    new |= {path for path in git("ls-files", "--others", "--exclude-standard", "-z").decode().split("\0")
+            if path and not skip(path)}
+    return sorted(edited), sorted(new)
+
+
+def install(source=ROOT, rescan=False):
+    """Pin the layer: write the BASE copy of every edited file to BUNDLE, the manifest
+    with the current digest of every edited and added file, then this guard's
+    MANIFEST_SHA256. Needs BASE in git.
+
+    By default it re-pins the files the manifest already lists, which is what an
+    edit or a merge of another change over this layer needs. `rescan` takes the
+    file list from git against BASE instead (scan), for adding or dropping files;
+    on a merged tree that also picks up the other change's files."""
+    source = Path(source).resolve()
+    git = _git(source)
+    if rescan or not (source / MANIFEST).exists():
+        edited, new = scan(source)
+    else:
+        pinned = json.loads((source / MANIFEST).read_bytes())
+        edited, new = sorted(pinned["edited"]), sorted(pinned["added"])
+    exists = lambda path: subprocess.run(["git", "cat-file", "-e", f"{BASE}:{path}"], cwd=source,
+                                         capture_output=True).returncode == 0
+    for path in edited:
+        require(exists(path), f"{path} is not in BASE, so it is added, not edited")
+    for path in new:
+        require(not exists(path), f"{path} is in BASE, so it is edited, not added")
+    before = {}
+    for path in edited:
+        raw = git("show", f"{BASE}:{path}")
+        target = source / BUNDLE / path
+        target.parent.mkdir(parents=True, exist_ok=True); target.write_bytes(raw)
+        before[path] = digest(raw)
+    bundle = source / BUNDLE
+    for stale in sorted(bundle.rglob("*"), reverse=True):
+        if stale.is_file() and stale.relative_to(bundle).as_posix() not in before:
+            stale.unlink()
+        elif stale.is_dir() and not any(stale.iterdir()):
+            stale.rmdir()
+    folders = set()
+    for path in new:
+        parts = PurePosixPath(path).parts
+        for depth in range(1, len(parts)):
+            folder = str(PurePosixPath(*parts[:depth]))
+            if not exists(folder):
+                folders.add(folder)
+                break
+    record = {"base": BASE, "before": before,
+              "edited": {p: digest((source / p).read_bytes()) for p in edited},
+              "added": {p: digest((source / p).read_bytes()) for p in new},
+              "addedDirs": sorted(folders)}
+    raw = (json.dumps(record, indent=2) + "\n").encode()
+    (source / MANIFEST).write_bytes(raw)
+    guard = Path(__file__).resolve()
+    text = guard.read_text()
+    guard.write_text(re.sub(r'MANIFEST_SHA256 = "[0-9a-f]{64}"', f'MANIFEST_SHA256 = "{digest(raw)}"', text, count=1))
+    return record
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve()
+    good = check(source)
+    read = _reader(source, None)
+    record = manifest(read)
+    probes = {}
+    for name, path in [("gym-entry", "src/taichung_gym_entry.c"),
+                       ("gym-entry-script", "data/scripts/taichung_gyms.inc"),
+                       ("curated-presets", "src/data/taichung_team_presets.h"),
+                       ("minimap-dialogue", "src/taichung_onboarding_text.c"),
+                       ("glyph-table", "src/data/taichung_glyphs.h"),
+                       ("glyph-mapping", "charmap.txt"),
+                       ("room-map", "data/layouts/TaichungGymTheater/map.bin"),
+                       ("room-tileset", "data/tilesets/secondary/taichung_gym_theater/metatile_attributes.bin"),
+                       ("wanhe-map", "data/maps/TaichungWanheTemple_Hall/map.json"),
+                       ("save-migration", "src/taichung_save.c"),
+                       ("save-test", "tests/taichung_save_v12_test.c"),
+                       ("baseline-copy", f"{BUNDLE}/src/taichung_save.c"),
+                       ("manifest", MANIFEST)]:
+        raw = bytearray(read(path)); raw[len(raw) // 2] ^= 1
+        probes[name] = {path: bytes(raw)}
+    probes["version-11"] = {SAVE_HEADER: read(SAVE_HEADER).replace(b"TAICHUNG_SAVE_VERSION 12", b"TAICHUNG_SAVE_VERSION 11")}
+    probes["base-border"] = {"data/layouts/TaichungGymPark/border.bin": struct.pack("<4H", *(0x0800,) * 4)}
+    caught = {}
+    for name, overrides in probes.items():
+        class View:
+            pass
+        view = View(); view.source = source; view.read = _reader(source, overrides)
+        caught[name] = not check(source, overrides)["passed"] and underneath(view) == {}
+    original_run = subprocess.run
+    def no_subprocess(*args, **kwargs):
+        raise AssertionError("The portable gym interiors check must not invoke git")
+    try:
+        subprocess.run = no_subprocess
+        portable = check(source)["passed"]
+    finally:
+        subprocess.run = original_run
+    class View:
+        pass
+    view = View(); view.source = source; view.read = read
+    under, hidden = underneath(view), added(read)
+    peels = (b"TAICHUNG_SAVE_VERSION 11" in under.get(SAVE_HEADER, b"")
+             and {"data/layouts/TaichungGymTheater", "data/tilesets/secondary/taichung_gym_theater",
+                  "tests/taichung_save_v12_test.c"} <= hidden)
+    # With BASE in git, each pinned path must be what git says it is (edited or added),
+    # committed or not; None in a portable copy without the history.
+    kinds = None
+    if has_base(source):
+        edited, new = scan(source)
+        kinds = set(record["edited"]) <= set(edited) and set(record["added"]) <= set(new)
+    return {"passed": good["passed"] and portable and all(caught.values()) and peels and kinds is not False,
+            "tree": good, "portableWithoutGit": portable, "underneathRestoresV11AndHidesRooms": peels,
+            "pinnedKindsMatchGit": kinds, "rejectedCorruptionProbes": caught}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--install", action="store_true")
+    parser.add_argument("--rescan", action="store_true", help="with --install: take the file list from git, not the manifest")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if args.install:
+        record = install(args.source, rescan=args.rescan)
+        print(f"Pinned {len(record['edited'])} edited and {len(record['added'])} added files; run again without --install to check.")
+        return
+    report = self_test(args.source) if args.self_test else check(args.source)
+    print(json.dumps(report, indent=2, ensure_ascii=False))
+    sys.exit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
