+            allFallbacksVerified=True, coordinateEnumeration='recompute with describe_old_core_delta.component; no duplicate full per-cell safe table'),
+        landmarkCoordinateAndReturnProof=proofs,
+        walkability=dict(helper='tools/taichung/landmarks/describe_old_core_delta.py', helperSha256=helper.digest(HELPER_BYTES),
+            validator='tools/taichung/validate_city.py', validatorSha256=helper.digest(helper.WALK_RULE_BYTES),
+            baselineValidatorSha256=helper.digest(before.read('tools/taichung/validate_city.py')), nativeMapMethodsUsedDirectly=True,
+            collisionMask='0x0C00', attributeBehaviorMask='0x1FF', actorSignPolicy='exclude authored initial actors/signs, as the native geometry validator',
+            elevationRule='current0 or target0/15/current, using actual native can_step'),
+        provenance=dict(baselineFilesSha256={p: helper.digest(raw) for p, raw in sorted(before.raw.items())},
+            currentFilesSha256={p: helper.digest(raw) for p, raw in sorted(current.raw.items())},
+            producerScript=str(PRODUCER_PATH.relative_to(ROOT)), producerScriptSha256=helper.digest(PRODUCER_BYTES),
+            sourceInputsStableDuringRead=True, romBuiltByThisTool=False, saveOrStartupMutationPerformed=False,
+            sourceEvidenceDoesNotClaimLoadedRomCompatibility=True), validation=dict(result='pass'))
+    if current_full is None:
+        drift = [p for p, raw in current.raw.items() if (ROOT / p).read_bytes() != raw]
+        require(not drift, f'Source changed during Greenway delta read; recompute: {drift}')
+        require(subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip() == head, 'HEAD changed during delta read; recompute')
+    require(HELPER_PATH.read_bytes() == HELPER_BYTES and helper.WALK_RULE_PATH.read_bytes() == helper.WALK_RULE_BYTES, 'Shared evidence helpers changed during read')
+    require(PRODUCER_PATH.read_bytes() == PRODUCER_BYTES, 'Greenway delta producer changed during read; recompute')
+    if write:
+        output = Path(output); output.parent.mkdir(parents=True, exist_ok=True); output.write_text(json.dumps(report, indent=2) + '\n')
+    return report
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--baseline', default=BASE)
+    parser.add_argument('--output', type=Path, default=OUTPUT); parser.add_argument('--self-test', action='store_true')
+    parser.add_argument('--current-ref', help='Read current source exclusively from this immutable Git revision')
+    parser.add_argument('--check', action='store_true'); args = parser.parse_args()
+    if args.self_test and args.current_ref: parser.error('--self-test and --current-ref are mutually exclusive')
+    report = describe(args.baseline, args.output, current_ref=args.baseline if args.self_test else args.current_ref, write=not (args.self_test or args.check))
+    if args.self_test:
+        require(report['summary']['changedCells'] == report['summary']['formerlyWalkableNowInvalid'] == 0, 'Identical-Git source test has nonzero delta')
+    if args.check:
+        saved = json.loads(args.output.read_text())
+        for key in ('baseline', 'current', 'numericIds', 'summary', 'changedCells', 'previouslyOrdinaryWalkableNowInvalid',
+                    'savedPositionDisposition', 'safeConnectedSet', 'landmarkCoordinateAndReturnProof', 'walkability'):
+            require(saved[key] == report[key], f'Delta report is stale/edited: {key}')
+    print(json.dumps(dict(result='pass', output=None if args.self_test else str(args.output), selfTest=args.self_test,
+        baseline=report['baseline']['commit'], currentMapSha256=report['current']['mapSha256'], summary=report['summary']), indent=2))
