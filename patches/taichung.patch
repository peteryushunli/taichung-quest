+static void DrawExplorationMenu(void)
+{
+    u8 row, mode;
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 22, sMutedColors, -1, TaichungText(sSubtitleEn, sSubtitleZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 18, sRowY[0], sTextColors, -1, TaichungText(sWildEn, sWildZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 18, sRowY[1], sTextColors, -1, TaichungText(sSightEn, sSightZh));
+    for (row = 0; row < TAICHUNG_EXPLORATION_SETTING_COUNT; row++)
+    {
+        for (mode = TAICHUNG_EXPLORATION_OFF; mode <= TAICHUNG_EXPLORATION_NORMAL; mode++)
+            AddTextPrinterParameterized3(0, FONT_SMALL, 124 + (mode - 1) * 36, sRowY[row], sModes[row] == mode ? sSelectedColors : sMutedColors, -1, TaichungText(sModeNames[mode - 1][0], sModeNames[mode - 1][1]));
+    }
+    AddTextPrinterParameterized3(0, FONT_SMALL, 18, sRowY[2], sTextColors, -1, TaichungText(sContinueEn, sContinueZh));
+    if (!sStartup)
+        AddTextPrinterParameterized3(0, FONT_SMALL, 18, sRowY[3], sTextColors, -1, TaichungText(sOptionsEn, sOptionsZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 6, sRowY[sCursor], sSelectedColors, -1, sCursorText);
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 112, sTextColors, -1, TaichungText(sHelp[sCursor][0], sHelp[sCursor][1]));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 145, sMutedColors, -1, TaichungText(sFooterEn, sFooterZh));
