--- /dev/null
+++ b/tools/taichung/validate_city.py
@@ -0,0 +1,375 @@
+#!/usr/bin/env python3
+"""Validate the authored FireRed city grids, native connections, and door pairs.
+
+Uses source metatile attributes and collision/elevation data, rather than rendered
+pixels. This proves static walking reachability, not the running ROM's scripts,
+door animation, save behavior, or encounter balance. No Pillow dependency.
+
+  python3 tools/taichung/validate_city.py
+  python3 tools/taichung/validate_city.py --baseline ee75ad0 --json
+"""
+
+import argparse
+from collections import deque
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[2]
+DIRECTIONS = {"left": (-1, 0), "right": (1, 0), "up": (0, -1), "down": (0, 1)}
+OPPOSITE = {"left": "right", "right": "left", "up": "down", "down": "up"}
+# These are the walking behaviors used/supported by this geometry validator.
+# Water, ledges, currents, escalators and forced movement are deliberately absent:
+# a static flood-fill must never claim those as ordinary walking paths.
+WALK_BEHAVIORS = {0x00, 0x02, 0x08, 0x0A, 0x0B, 0x0C, 0x16, 0x17,
+                  0x21, 0x22, 0x23, 0x28, 0x2A, 0x62, 0x63, 0x64, 0x65}
+
+
+def binary_values(path, fmt):
+    raw = path.read_bytes()
+    width = struct.calcsize(fmt)
+    if len(raw) % width:
+        raise ValueError(f"{path}: byte length is not divisible by {width}")
+    return struct.unpack(f"<{len(raw) // width}{fmt}", raw)
+
+
+def resolve_tileset(source, label):
+    """Resolve the C labels to native metatile and attribute source files."""
+    headers = (source / "src/data/tilesets/headers.h").read_text()
+    declarations = (source / "src/data/tilesets/metatiles.h").read_text()
+    header = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", headers, re.S)
+    if not header:
+        raise ValueError(f"Unknown tileset {label}")
+    paths = {}
+    for field in ("metatiles", "metatileAttributes"):
+        symbol = re.search(rf"\.{field}\s*=\s*(\w+)", header.group(1))
+        if not symbol:
+            raise ValueError(f"Missing {field} declaration for {label}")
+        declaration = re.search(rf"\b{re.escape(symbol.group(1))}\s*\[.*?=\s*(.*?);",
+                                declarations, re.S)
+        path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1)) if declaration else None
+        if not path:
+            raise ValueError(f"Cannot resolve {symbol.group(1)}")
+        paths[field] = source / path.group(1)
+    count = len(binary_values(paths["metatiles"], "H")) // 8
+    attributes = binary_values(paths["metatileAttributes"], "I")
+    if len(attributes) != count:
+        raise ValueError(f"{label}: {count} metatiles but {len(attributes)} attributes")
+    return attributes
+
+
+class Map:
+    def __init__(self, source, data, layout, tileset_cache):
+        self.data, self.layout, self.id = data, layout, data["id"]
+        self.width, self.height = layout["width"], layout["height"]
+        self.cells = binary_values(source / layout["blockdata_filepath"], "H")
+        self.border = binary_values(source / layout["border_filepath"], "H")
+        self.attributes = []
+        for field in ("primary_tileset", "secondary_tileset"):
+            label = layout[field]
+            if label not in tileset_cache:
+                tileset_cache[label] = resolve_tileset(source, label)
+            self.attributes.append(tileset_cache[label])
+        # Conservatively reserve every authored actor's initial cell. Hidden actors
+        # can later disappear, but should never be required to unblock a route.
+        self.actors = {(o["x"], o["y"]) for o in data.get("object_events", [])}
+        self.signs = {(o["x"], o["y"]) for o in data.get("bg_events", []) if o.get("type") == "sign"}
+        self.obstacles = self.actors | self.signs
+
+    def inside(self, x, y):
+        return 0 <= x < self.width and 0 <= y < self.height
+
+    def cell(self, x, y):
+        return self.cells[y * self.width + x]
+
+    def attribute(self, metatile):
+        which, index = (0, metatile) if metatile < 640 else (1, metatile - 640)
+        return self.attributes[which][index] if index < len(self.attributes[which]) else None
+
+    def behavior(self, x, y):
+        attr = self.attribute(self.cell(x, y) & 0x3FF)
+        return attr & 0x1FF if attr is not None else None
+
+    def elevation(self, x, y):
+        return self.cell(x, y) >> 12
+
+    def ground(self, x, y):
+        return (self.inside(x, y) and not self.cell(x, y) & 0xC00
+                and self.behavior(x, y) in WALK_BEHAVIORS)
+
+    def walkable(self, x, y):
+        return self.ground(x, y) and (x, y) not in self.obstacles
+
+    def can_step(self, x, y, other, nx, ny):
+        if not other.walkable(nx, ny):
+            return False
+        current, target = self.elevation(x, y), other.elevation(nx, ny)
+        # Matches IsElevationMismatchAt: current 0 or target 0/15 are wildcards.
+        return current == 0 or target in (0, 15, current)
+
+
+class Validator:
+    def __init__(self, source, contract):
+        self.source, self.contract, self.errors = source, contract, []
+        self.maps, self.map_numbers, self.tilesets = {}, {}, {}
+        layouts = {x["id"]: x for x in json.loads((source / "data/layouts/layouts.json").read_text())["layouts"] if "id" in x}
+        groups = json.loads((source / "data/maps/map_groups.json").read_text())
+        self.groups = groups
+        self.district_ids = {d["map"] for d in contract["districts"]}
+        wanted = self.district_ids | {l["gymMap"] for l in contract["landmarks"]}
+        for group_num, group in enumerate(groups["group_order"]):
+            for map_num, name in enumerate(groups[group]):
+                data = json.loads((source / f"data/maps/{name}/map.json").read_text())
+                self.check(data["id"] not in self.map_numbers, f"Duplicate map ID {data['id']}")
+                self.map_numbers[data["id"]] = (group_num, map_num)
+                if data["id"] in wanted:
+                    self.maps[data["id"]] = Map(source, data, layouts[data["layout"]], self.tilesets)
+        self.check(wanted == set(self.maps), f"Unregistered maps: {sorted(wanted - set(self.maps))}")
+
+    def check(self, condition, message):
+        if not condition:
+            self.errors.append(message)
+        return condition
+
+    def validate_baseline(self, commit):
+        raw = subprocess.check_output(["git", "show", f"{commit}:data/maps/map_groups.json"], cwd=self.source, text=True)
+        old = json.loads(raw)
+        self.check(self.groups["group_order"][:len(old["group_order"])] == old["group_order"],
+                   f"Existing map-group order changed since {commit}")
+        for group in old["group_order"]:
+            self.check(self.groups.get(group) == old[group], f"Existing map IDs in {group} changed since {commit}")
+
+    def validate_grids(self):
+        header = (self.source / "include/fieldmap.h").read_text()
+        maximum = int(re.search(r"#define MAX_MAP_DATA_SIZE\s+(\w+)", header).group(1), 0)
+        for m in self.maps.values():
+            self.check(len(m.cells) == m.width * m.height,
+                       f"{m.id}: {len(m.cells)} cells, expected {m.width}x{m.height}")
+            self.check((m.width + 15) * (m.height + 14) <= maximum,
+                       f"{m.id}: padded virtual map exceeds MAX_MAP_DATA_SIZE={maximum}")
+            self.check(len(m.border) == m.layout["border_width"] * m.layout["border_height"],
+                       f"{m.id}: border byte size disagrees with layout")
+            for i, cell in enumerate(m.cells):
+                if m.attribute(cell & 0x3FF) is None:
+                    self.check(False, f"{m.id} ({i % m.width},{i // m.width}): undefined metatile {cell & 0x3FF:#x}")
+            for o in m.data.get("object_events", []):
+                x, y = o["x"], o["y"]
+                self.check(m.ground(x, y), f"{m.id} actor {o.get('local_id')} ({x},{y}): not on walking ground")
+                if m.inside(x, y):
+                    self.check(o["elevation"] in (0, m.elevation(x, y)),
+                               f"{m.id} actor ({x},{y}): elevation disagrees with ground")
+            for b in m.border:
+                self.check(m.attribute(b & 0x3FF) is not None, f"{m.id}: undefined border metatile {b & 0x3FF:#x}")
+
+    def crossing(self, m, direction, x, y):
+        candidates = [c for c in m.data.get("connections") or [] if c["direction"] == direction]
+        found = []
+        for c in candidates:
+            target = self.maps.get(c["map"])
+            if not target:
+                continue
+            offset = c["offset"]
+            nx, ny = ((target.width - 1, y - offset) if direction == "left" else
+                      (0, y - offset) if direction == "right" else
+                      (x - offset, target.height - 1) if direction == "up" else (x - offset, 0))
+            if target.inside(nx, ny):
+                found.append((target, nx, ny))
+        return found
+
+    def validate_connections(self):
+        self.open_edges = []
+        for d in self.contract["districts"]:
+            m = self.maps[d["map"]]
+            self.check((m.width, m.height, m.data["layout"]) == (d["width"], d["height"], d["layout"]),
+                       f"{m.id}: dimensions/layout disagree with contract")
+            self.check(m.data["connections"] == d["connections"], f"{m.id}: connections disagree with contract")
+            for c in m.data["connections"]:
+                target = self.maps.get(c["map"])
+                self.check(target is not None, f"{m.id}: unregistered connection to {c['map']}")
+                if target:
+                    self.check(any(r["map"] == m.id and r["direction"] == OPPOSITE[c["direction"]]
+                                   and r["offset"] == -c["offset"] for r in target.data["connections"] or []),
+                               f"{m.id}: no reciprocal connection from {target.id}")
+            counts = {d: 0 for d in DIRECTIONS}
+            for direction in DIRECTIONS:
+                edge = ([(0, y) for y in range(m.height)] if direction == "left" else
+                        [(m.width - 1, y) for y in range(m.height)] if direction == "right" else
+                        [(x, 0) for x in range(m.width)] if direction == "up" else
+                        [(x, m.height - 1) for x in range(m.width)])
+                for x, y in edge:
+                    if m.cell(x, y) & 0xC00:
+                        continue
+                    self.check(m.ground(x, y),
+                               f"{m.id} ({x},{y}): collision-free boundary uses unsupported walking terrain")
+                    targets = self.crossing(m, direction, x, y)
+                    if not self.check(len(targets) == 1, f"{m.id} ({x},{y}): open {direction} boundary has {len(targets)} destinations"):
+                        continue
+                    target, nx, ny = targets[0]
+                    if self.check(m.can_step(x, y, target, nx, ny),
+                                  f"{m.id} ({x},{y}): {direction} seam blocked/mismatched at {target.id} ({nx},{ny})"):
+                        self.open_edges.append(((m.id, x, y), (target.id, nx, ny)))
+                        counts[direction] += 1
+            for c in m.data["connections"]:
+                self.check(counts[c["direction"]] > 0, f"{m.id}: {c['direction']} connection has no walkable crossing")
+
+    def flood(self, start, allowed):
+        distances = {start: 0}
+        pending = deque([start])
+        while pending:
+            mid, x, y = current = pending.popleft()
+            m = self.maps[mid]
+            for direction, (dx, dy) in DIRECTIONS.items():
+                nx, ny = x + dx, y + dy
+                targets = [(m, nx, ny)] if m.inside(nx, ny) else self.crossing(m, direction, x, y)
+                for target, nx, ny in targets:
+                    node = target.id, nx, ny
+                    if target.id in allowed and node not in distances and m.can_step(x, y, target, nx, ny):
+                        distances[node] = distances[current] + 1
+                        pending.append(node)
+        return distances
+
+    def reachable(self, distances, mid, point, label, elevation=None):
+        m, x, y = self.maps[mid], point["x"], point["y"]
+        self.check((mid, x, y) in distances, f"{label}: unreachable {mid} ({x},{y})")
+        if m.inside(x, y) and elevation is not None:
+            self.check(m.elevation(x, y) == elevation, f"{label}: {mid} ({x},{y}) elevation is {m.elevation(x,y)}, expected {elevation}")
+
+    def validate_landmarks(self):
+        spawn = self.contract["spawn"]
+        m = self.maps[spawn["map"]]
+        self.check(m.walkable(spawn["x"], spawn["y"]), "New-game spawn is blocked")
+        self.distances = self.flood((m.id, spawn["x"], spawn["y"]), self.district_ids)
+        self.reachable(self.distances, m.id, spawn, "New-game spawn", spawn["elevation"])
+        self.landmark_results = []
+        for l in self.contract["landmarks"]:
+            ext, room = self.maps[l["exteriorMap"]], self.maps[l["gymMap"]]
+            door, approach = l["entrance"], l["approach"]
+            x, y, wid = door["x"], door["y"], door["warpId"]
+            self.check(ext.inside(x, y), f"{l['id']}: door outside map")
+            if not ext.inside(x, y):
+                continue
+            self.check((ext.cell(x, y) & 0xC00) == 0x400 and ext.elevation(x, y) == 0 and ext.behavior(x, y) == 0x69,
+                       f"{l['id']}: ({x},{y}) must be native collision1/elevation0/MB_WARP_DOOR (word {ext.cell(x,y):#06x})")
+            self.check((approach["x"], approach["y"]) == (x, y + 1), f"{l['id']}: door approach must be immediately south")
+            self.reachable(self.distances, ext.id, approach, f"{l['id']} approach", 3)
+            self.reachable(self.distances, ext.id, l["arrival"], f"{l['id']} arrival", 3)
+            sx, sy = l["sign"]["x"], l["sign"]["y"]
+            self.check((sx, sy) in ext.signs and ext.inside(sx, sy)
+                       and bool(ext.cell(sx, sy) & 0xC00),
+                       f"{l['id']}: sign ({sx},{sy}) missing or lacks collision")
+            warps = ext.data["warp_events"]
+            if not self.check(0 <= wid < len(warps), f"{l['id']}: exterior warp index {wid} missing"):
+                continue
+            w = warps[wid]
+            self.check((w["x"], w["y"], w["elevation"], w["dest_map"], int(w["dest_warp_id"])) ==
+                       (x, y, 0, room.id, l["gymEntryWarpId"]), f"{l['id']}: exterior warp differs from contract")
+            returns = room.data["warp_events"]
+            self.check(len(returns) == len(l["interiorReturns"]) == 3, f"{l['id']}: expected all three room return warps")
+            entry = int(w["dest_warp_id"])
+            if not self.check(0 <= entry < len(returns), f"{l['id']}: room entry warp {entry} missing"):
+                continue
+            p = returns[entry]
+            self.check(room.walkable(p["x"], p["y"]), f"{l['id']}: room landing ({p['x']},{p['y']}) blocked")
+            rd = self.flood((room.id, p["x"], p["y"]), {room.id})
+            active_exits = 0
+            for r in l["interiorReturns"]:
+                i, rx, ry = r["warpId"], r["x"], r["y"]
+                if not self.check(0 <= i < len(returns), f"{l['id']}: return warp {i} missing"):
+                    continue
+                real = returns[i]
+                self.check((real["x"], real["y"], real["elevation"], real["dest_map"], int(real["dest_warp_id"])) ==
+                           (rx, ry, 3, ext.id, wid), f"{l['id']}: room return warp {i} differs from contract")
+                self.reachable(rd, room.id, r, f"{l['id']} return {i}", 3)
+                # The original three-cell Pewter exit has one central south-arrow
+                # trigger; the two side warps are valid landing/return metadata.
+                if room.inside(rx, ry) and room.behavior(rx, ry) == 0x65:
+                    active_exits += 1
+            self.check(active_exits > 0, f"{l['id']}: room has no active south-arrow exit")
+            host = l["host"]
+            actors = [o for o in room.data["object_events"] if o.get("local_id") == host["localId"]]
+            self.check(len(actors) == 1 and (actors[0]["x"], actors[0]["y"], actors[0]["script"]) ==
+                       (host["x"], host["y"], host["script"]), f"{l['id']}: host differs from contract")
+            self.check(any((room.id, host["x"] + dx, host["y"] + dy) in rd for dx, dy in DIRECTIONS.values()),
+                       f"{l['id']}: host ({host['x']},{host['y']}) has no reachable interaction cell")
+            self.landmark_results.append({"id": l["id"], "stepsToApproach": self.distances.get((ext.id, x, y + 1)),
+                                          "interiorReachableCells": len(rd)})
+        for start, target in self.open_edges:
+            self.check(start in self.distances and target in self.distances,
+                       f"Unreachable seam {start} -> {target}")
+        for mid in self.district_ids:
+            m = self.maps[mid]
+            for x, y in m.actors | m.signs:
+                self.check(any((mid, x + dx, y + dy) in self.distances for dx, dy in DIRECTIONS.values()),
+                           f"{mid}: event ({x},{y}) has no reachable interaction cell")
+
+    def validate_habitats(self):
+        for h in self.contract.get("habitatRegions", []):
+            m = self.maps[h["map"]]
+            x0, y0, x1, y1 = h["rect"]
+            reached = 0
+            for y in range(y0, y1 + 1):
+                for x in range(x0, x1 + 1):
+                    self.check(m.inside(x, y), f"{h['id']}: habitat ({x},{y}) outside map")
+                    if m.inside(x, y) and h["terrain"] == "tall-grass":
+                        self.check(m.behavior(x, y) == 2 and not m.cell(x, y) & 0xC00,
+                                   f"{h['id']}: ({x},{y}) is not traversable tall grass")
+                    reached += (m.id, x, y) in self.distances
+            self.check(reached > 0, f"{h['id']}: no habitat cell reachable on foot")
+
+    def run(self):
+        self.validate_grids()
+        # Bad grid sizes/definitions invalidate all downstream coordinate lookups.
+        if self.errors:
+            return
+        self.validate_connections()
+        self.validate_landmarks()
+        self.validate_habitats()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--contract", type=Path, default=Path("docs/taichung-city-contract.json"))
+    parser.add_argument("--baseline", help="Optional git commit whose legacy map IDs must be unchanged")
+    parser.add_argument("--json", action="store_true", help="Print structured QA results")
+    args = parser.parse_args()
+    source = args.source.resolve()
+    contract_path = args.contract if args.contract.is_absolute() else source / args.contract
+    try:
+        validator = Validator(source, json.loads(contract_path.read_text()))
+        if args.baseline:
+            validator.validate_baseline(args.baseline)
+        validator.run()
+        result = {"result": "fail" if validator.errors else "pass", "errors": validator.errors,
+                  "nativeMapIds": {mid: {"group": n[0], "number": n[1]} for mid, n in validator.map_numbers.items() if mid in validator.maps},
+                  "reachableExteriorCells": {mid: sum(n[0] == mid for n in getattr(validator, "distances", {})) for mid in sorted(validator.district_ids)},
+                  "directedSeamCells": len(getattr(validator, "open_edges", [])),
+                  "landmarks": getattr(validator, "landmark_results", []),
+                  "scope": "Static source geometry; runtime scripts, saves and animations require emulator QA."}
+        if args.json:
+            print(json.dumps(result, indent=2))
+        elif validator.errors:
+            print(f"CITY VALIDATION FAILED ({len(validator.errors)} issues)")
+            for error in validator.errors[:40]:
+                print(f"- {error}")
+            if len(validator.errors) > 40:
+                print(f"... and {len(validator.errors) - 40} more (use --json)")
+        else:
+            print("CITY VALIDATION PASSED")
+            for mid, count in result["reachableExteriorCells"].items():
+                group, number = validator.map_numbers[mid]
+                print(f"- {mid}: {count} reachable cells; native ID {group},{number}")
+            print(f"- {len(result['landmarks'])} paired landmark rooms; {result['directedSeamCells']} directed seam cells")
+            print(f"- {result['scope']}")
+        return bool(validator.errors)
+    except (KeyError, ValueError, OSError, struct.error, subprocess.CalledProcessError) as error:
+        print(f"CITY VALIDATION FAILED: {error}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
