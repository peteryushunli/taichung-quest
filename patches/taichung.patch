+"""Cell masks for the city-rework master plan (rect ends exclusive, world tile coordinates)."""
+
+
+def rect_cells(x0, y0, x1, y1):
+    return {(x, y) for y in range(y0, y1) for x in range(x0, x1)}
+
+
+def street_cells(plan, shift=None):
+    """Xitun profile: sidewalk, three asphalt, sidewalk. `shift` moves named streets by whole tiles."""
+    shift = shift or {}
+    cells = {}
+    for s in plan["streetsEastWest"]:
+        r = s["firstAsphaltRow"] + shift.get(s["name"], 0)
+        for c in rect_cells(s["x0"], r - 1, s["x1"], r + 4):
+            cells.setdefault(c, s["name"])
+    for s in plan["streetsNorthSouth"]:
+        c0 = s["firstAsphaltCol"] + shift.get(s["name"], 0)
+        for c in rect_cells(c0 - 1, s["y0"], c0 + 4, s["y1"]):
+            cells.setdefault(c, s["name"])
+    return cells
+
+
+def water_cells(plan, canal_shift=0):
+    cells = set()
+    for r in plan["river"]:
+        cells |= rect_cells(*r)
+    if plan.get("pond"):
+        cells |= rect_cells(*plan["pond"])
+    for name, rects in plan["canals"].items():
+        for x0, y0, x1, y1 in rects:
+            if name == "Wanhe canal":
+                x0, x1 = x0 + canal_shift, x1 + canal_shift
+            cells |= rect_cells(x0, y0, x1, y1)
+    return cells
+
+
+def highway_cells(plan):
+    cells = set()
+    for r in plan["highway"].values():
+        cells |= rect_cells(*r)
+    return cells
