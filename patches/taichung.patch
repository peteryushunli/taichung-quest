+uses=Counter()
+for path in (ROOT/'data/maps').glob('Taichung*/map.json'):
+    data=json.loads(path.read_text())
+    for kind in ('object_events','bg_events'):
+        uses.update(o['script'] for o in data[kind])
+assert all(uses[label]==1 for label in (*SIGN_ROSTER,*LEADERS,*WORKERS,*HOSTS)),uses
+
+
+def run(entry,choices,complete=False,replay=False,locale=1,namespace=(0xEC01,3,2),available=True):
+    expected=LEADERS[entry][1] if entry in LEADERS else (SIGN_ROSTER|WORKERS|HOSTS)[entry]
+    role='leader' if entry in LEADERS else 'worker' if entry in WORKERS else 'site' if (entry in SIGN_ROSTER and expected in SITES and expected!=10 or entry=='TaichungCity_Host_WenchangTemple') else 'visit'
+    label,index,stack=entry,0,[]
+    locked,pending=False,None
+    saved={f'VAR_0x{0x4000+i:04X}':(i*57)&0xFFFF for i in range(256)}
+    saved.update(VAR_0x40F3=namespace[0],VAR_0x40F4=namespace[1],VAR_0x40F5=namespace[2],VAR_0x40FA=0x3FF if complete else 0,VAR_0x40FB=locale)
+    variables={**saved,'VAR_RESULT':0,'VAR_0x8006':0xCAFE}
+    choices=list(choices);events=[];chosen_challenge=False;chosen_encounter=False;selections=0
+    def value(text):
+        return variables.get(text,SYMBOLS.get(text,int(text) if text.isdecimal() else text))
+    def select(history):
+        nonlocal selections
+        assert history==expected,('entry/place binding mismatch',entry,'expected',IDS[expected],'actual',history,events)
+        variables['VAR_0x8006']=history;selections+=1
+    def finish():
+        assert not choices,('unconsumed choices',entry,choices,events)
+        assert all(variables[k]==v for k,v in saved.items()),events
+        assert replay or selections>0,('entry never selected its expected place',entry)
+        if 'battle' in events:assert not complete and chosen_challenge and not replay
+        return events
+    for _ in range(1200):
+        instruction=PROGRAM[label][index];index+=1
+        op,_,args=instruction.partition(' ');parts=[p.strip() for p in args.split(',')]
+        if op in ('setvar','copyvar'):
+            assert parts[0] in ('VAR_RESULT','VAR_0x8004','VAR_0x8005','VAR_0x8006','VAR_0x8007'),instruction
+            variables[parts[0]]=value(parts[1])
+        elif op=='lock':
+            assert not locked;locked=True
+        elif op=='lockall':locked=True
+        elif op in ('release','releaseall'):
+            assert locked;locked=False
+        elif op=='faceplayer':assert locked
+        elif op in ('goto_if_eq','goto_if_ne'):
+            matched=value(parts[0])==value(parts[1])
+            if matched==(op=='goto_if_eq'):label,index=parts[2],0
+        elif op=='goto_if_questlog':
+            if replay:label,index=args,0
+        elif op=='goto':label,index=args,0
+        elif op=='call':stack.append((label,index));label,index=args,0
+        elif op=='return':
+            if not stack:return finish()
+            label,index=stack.pop()
+        elif op=='end':
+            assert not locked;return finish()
+        elif op in ('msgbox','message'):
+            assert locked and parts[0]=='gStringVar4',instruction
+            if pending in ('sign','about','staff','garden','credit','legacy-history'):
+                assert variables['VAR_0x8006']==expected,(entry,'wrong displayed story')
+                events.append(pending);pending=None
+            elif op=='message' and pending=='offer':events.append('offer')
+            if op=='msgbox' and len(parts)>1 and parts[1]=='MSGBOX_SIGN':locked=False
+        elif op in ('waitmessage','waitbuttonpress','closemessage'):pass
+        elif op=='multichoice':
+            assert locked and not replay and parts[3]=='FALSE',instruction
+            menu=parts[2];assert choices,('unexpected menu',entry,menu,events)
+            counts={'MULTICHOICE_TAICHUNG_STORY_CHALLENGE':4,'MULTICHOICE_TAICHUNG_STORY_VISIT':3,'MULTICHOICE_TAICHUNG_STORY_STAFF':2,'MULTICHOICE_TAICHUNG_STORY_SCIENCE':3,'MULTICHOICE_TAICHUNG_STORY_SITE':4}
+            choice=choices.pop(0);assert choice==127 or 0<=choice<counts[menu]
+            if not any(e.startswith('menu:') for e in events):
+                first='CHALLENGE' if role=='leader' and not complete else 'VISIT' if role in ('leader','visit') else 'SITE' if role=='site' else 'SCIENCE' if expected==3 else 'STAFF'
+                assert menu=='MULTICHOICE_TAICHUNG_STORY_'+first,(entry,role,menu)
+            events.append('menu:'+menu)
+            if menu=='MULTICHOICE_TAICHUNG_STORY_CHALLENGE' and choice==0:chosen_challenge=True
+            if menu=='MULTICHOICE_TAICHUNG_STORY_SITE' and choice==0:chosen_encounter=True
+            variables['VAR_RESULT']=choice
+        elif op=='callnative':
+            caller=variables.get('VAR_0x8004')
+            if args=='TaichungStory_ScriptHasPackage':
