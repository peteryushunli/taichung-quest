+#!/usr/bin/env python3
+"""Exercise Story's additive gym scripts using the existing shipped route runner."""
+import contextlib, importlib.util, io, re, subprocess
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[2]
+spec=importlib.util.spec_from_file_location("routes",ROOT/"tools/taichung_gameplay/test-gym-dialogue.py")
+gym=importlib.util.module_from_spec(spec)
+with contextlib.redirect_stdout(io.StringIO()): spec.loader.exec_module(gym)
+text=(ROOT/"data/scripts/taichung_confucius_gym.inc").read_text()
+name,slot,trainer=re.search(r"taichung_landmark_gym (\w+), (\w+), (\w+)",text).groups()
+assert name=="Confucius" and slot=="TAICHUNG_GYM_SHEN_JI" and trainer=="TRAINER_TAICHUNG_CONFUCIUS_WENYI"
+expanded=gym.PROGRAM.copy()
+macro=(ROOT/"data/scripts/taichung_landmark_gym.inc").read_text().replace(r"\name\()",name).replace(r"\name",name).replace(r"\gym",slot).replace(r"\trainer",trainer)
+gym.PROGRAM.update(gym.parse([macro]))
+gym.NAMES=(*gym.NAMES[:5],name,*gym.NAMES[6:])
+for language in (1,2):
+ win=gym.run(name,language)
+ assert win.count("battle")==1 and win.count("award-screen")==1
+ assert win.index("TaichungGym_ScriptGetConfuciusMessage")<win.index("award-screen")
+ for state in ({"outcome":"loss"},{"outcome":"skip"},{"complete":True},{"replay":True},{"available":False},{"fresh":False}):
+  assert "award-screen" not in gym.run(name,language,**state)
+ for entry,adapter in (("TaichungConfucius_Staff","TaichungConfucius_BufferStaffAnecdote"),("TaichungShenJi_LandmarkGuide","TaichungShenJi_BufferLandmarkGuide")):
+  programs=gym.parse([text[text.index(entry+"::"):]])
+  for replay in (False,True):
+   label=entry; index=0; locked=False; pages=0
+   for step in range(20):
+    instruction=programs[label][index];index+=1;op,_,arg=instruction.partition(" ")
+    if op=="lock":locked=True
+    elif op=="faceplayer":assert locked
+    elif op=="goto_if_questlog":
+     if replay:label,index=arg,0
+    elif op=="callnative":assert arg==adapter and locked and not replay
+    elif op=="msgbox":assert arg=="gStringVar4" and locked;pages+=1
+    elif op=="goto":label,index=arg,0
+    elif op=="release":locked=False
+    elif op=="end":assert not locked and pages==(0 if replay else 1);break
+    else:raise AssertionError(instruction)
+   else:raise AssertionError("script loop")
+build=ROOT/"build/taichung-tests";build.mkdir(parents=True,exist_ok=True)
+subprocess.run(["cc","-std=c99","-Wall","-Wextra","-Werror","-Wno-unknown-escape-sequence","-I"+str(ROOT/"tests/gym_host"),"-I"+str(ROOT/"include"),str(ROOT/"src/taichung_confucius_gym.c"),str(ROOT/"src/taichung_landmark_gym.c"),str(ROOT/"tests/taichung_confucius_content_test.c"),"-o",str(build/"confucius-content")],check=True)
+subprocess.run([str(build/"confucius-content")],check=True)
+print("PASS: actual shared Confucius script flow EN/TW; direct battle, guarded win, no award for loss/skip/revisit/replay/unavailable/stale event; staff+ShenJi guide one page/no battle/no saved writes/replay exit")
