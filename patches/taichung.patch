+            require(f'case MAP_NUM(MAP_TAICHUNG_{local}_GYM):' in qualified and f'return localId == LOCALID_TAICHUNG_STAFF_{local} && graphicsId == OBJ_EVENT_GFX_{graphics};' in qualified, 'Vanilla staff identity qualification differs: ' + local)
+            require(re.search(r'#ifndef ' + 'LOCALID_TAICHUNG_STAFF_' + local + r'\s*\n#define LOCALID_TAICHUNG_STAFF_' + local + r'\s+2\s*\n#endif', now.text(IDS)), 'Guarded local-ID definition differs: ' + local)
+        for path in (SAVE, HEADER, 'src/overworld.c', CHARACTERS, IDS):
