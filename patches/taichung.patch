@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Verify Shen Ji indexed/4bpp format and original preservation; no installation."""
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+from PIL import Image
+
+from encode_candidate import HERE, GAME, SOURCE, SIZE, PALETTE_BANK, encode, sha
+
+
+def check(output, cluster):
+    manifest = json.loads((output / "encode-manifest.json").read_text())
+    original = json.loads((HERE / "generation.json").read_text())
+    assert sha(SOURCE) == manifest["originalStudySha256"] == original["artifactSha256"]
+    image = Image.open(output / "candidate-indexed.png")
+    native = Image.open(output / "candidate-native.png")
+    assert image.mode == "P" and image.size == SIZE and image.info.get("transparency") == 0
+    assert image.getextrema()[1] <= 15 and set(native.getchannel("A").get_flattened_data()) == {0, 255}
+    assert all(len(set(image.crop((x, y, x+cluster, y+cluster)).get_flattened_data())) == 1
+               for y in range(0, 96, cluster) for x in range(0, 160, cluster))
+    raw = (output / "tiles.4bpp").read_bytes()
+    graphics = [tuple(value for byte in raw[n:n+32] for value in (byte & 15, byte >> 4)) for n in range(0, len(raw), 32)]
+    tilemap = struct.unpack("<240H", (output / "foreground-tilemap-relative.bin").read_bytes())
+    assert all(word >> 12 == PALETTE_BANK and word & 1023 < len(graphics) for word in tilemap)
+    decoded = []
+    for y in range(96):
+        for x in range(160):
+            word = tilemap[y//8*20+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            decoded.append(graphics[word & 1023][sy*8+sx])
+    assert decoded == list(image.get_flattened_data())
+    pal = (output / "09.pal").read_bytes()
+    assert pal == pal.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+    colors = [tuple(map(int, row.split())) for row in pal.decode().splitlines()[3:] if row]
+    assert len(colors) == 16 and all(0 <= c <= 248 and c%8 == 0 for color in colors for c in color)
+    assert image.getpalette()[:48] == [c for color in colors for c in color]
+    assert list(struct.unpack("<16H", (output / "09.gbapal").read_bytes())) == [r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors]
+    components = manifest["components"]
+    assert sum(item["pixelCount"] for item in components["largestTwoLeftToRight"]+components["otherComponents"]) == components["foregroundPixelCount"]
+    assert manifest["courtyard"]["nativeWalkable"] is False and not manifest["budget"]["combinedAllocationChecked"]
+    if cluster == 2:
+        assert manifest["paintedDoorMeasurement"]["localMetatile"] == [3, 5]
+        assert manifest["paintedDoorMeasurement"]["futureOriginIfFixedGlobalDoor"] == [7, 39]
+    with tempfile.TemporaryDirectory(prefix="shen-ji-format-") as folder:
+        temp = Path(folder)
+        again = encode(temp / "candidate", cluster=cluster)
+        assert again == manifest
+        files = [p.relative_to(temp / "candidate") for p in (temp / "candidate").rglob("*") if p.is_file()]
+        assert all((output / path).read_bytes() == (temp / "candidate" / path).read_bytes() for path in files)
+        converter = GAME / "tools/gbagfx/gbagfx"
+        subprocess.run([str(converter), str(output / "tiles.png"), str(temp / "tiles.4bpp")], check=True, capture_output=True)
+        converted = (temp / "tiles.4bpp").read_bytes()
+        assert converted[:len(raw)] == raw and set(converted[len(raw):]) <= {0}
+        subprocess.run([str(converter), str(output / "09.pal"), str(temp / "09.gbapal")], check=True, capture_output=True)
+        assert (temp / "09.gbapal").read_bytes() == (output / "09.gbapal").read_bytes()
+    report = {"result": "pass", "scope": "unmerged native format only", "originalStudyUnchanged": True,
+              "binaryAlpha": True, "logicalSizePixels": list(SIZE), "nativePixelCluster": cluster,
+              "roundTripPixels": len(decoded), "unmergedUniqueGraphics": len(graphics),
+              "paddedSheetSlots": manifest["native"]["paddedSheetSlots"],
+              "occupiedMetatiles": manifest["native"]["occupiedMetatiles"],
+              "paletteBankCandidate": 9, "opaqueColors": manifest["recipe"]["opaqueColorCount"],
+              "paletteCrlfAndGba555Verified": True, "gbagfxMatches": True, "reproducedFiles": len(files),
+              "sourceComponentBoxesVerifiedByArea": True, "paintedDoorMeasurement": manifest["paintedDoorMeasurement"],
+              "courtyardWalkable": False, "combinedGreenwayBudgetChecked": False,
+              "mapOrBankChanged": False, "nativeReady": False}
+    (output / "validation.json").write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(report, indent=2))
+    return report
+
+
+if __name__ == "__main__":
+    check(HERE / "candidate", 2)
+    if (HERE / "candidate-cluster4/encode-manifest.json").exists():
+        check(HERE / "candidate-cluster4", 4)
diff --git a/data/taichung/landmarks/shen-ji/encode_candidate.py b/data/taichung/landmarks/shen-ji/encode_candidate.py
new file mode 100644
index 0000000..db56ea1
--- /dev/null
+++ b/data/taichung/landmarks/shen-ji/encode_candidate.py
@@ -0,0 +1,216 @@
+#!/usr/bin/env python3
+"""Mechanical Shen Ji format conversion after approval; never installs a map.
+
+The original study is immutable. Outputs are relative foreground references for
+Root's combined Greenway budget, not a separately allocated secondary bank.
+"""
+import argparse
+from collections import deque
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+SOURCE = PROJECT / "artifacts/worktrees/c291d4842985/landmark-art/shen-ji-study-v1.png"
+SIZE, PALETTE_BANK, TARGET = (160, 96), 9, 150
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+def component_boxes(mask):
+    width, height = mask.size
+    data = bytearray(mask.tobytes())
+    found = []
+    for index, value in enumerate(data):
+        if not value:
+            continue
+        data[index] = 0
+        pending = deque([index])
+        area, xmin, ymin, xmax, ymax = 0, width, height, 0, 0
+        while pending:
+            pos = pending.popleft()
+            x, y = pos%width, pos//width
+            area += 1
+            xmin, ymin, xmax, ymax = min(xmin, x), min(ymin, y), max(xmax, x), max(ymax, y)
+            for nx, ny in ((x-1, y), (x+1, y), (x, y-1), (x, y+1)):
+                if 0 <= nx < width and 0 <= ny < height:
+                    other = ny*width+nx
+                    if data[other]:
+                        data[other] = 0
+                        pending.append(other)
+        found.append({"pixelCount": area, "boxExclusive": [xmin, ymin, xmax+1, ymax+1]})
+    found.sort(key=lambda item: -item["pixelCount"])
+    major = sorted(found[:2], key=lambda item: item["boxExclusive"][0])
+    total = sum(item["pixelCount"] for item in found)
+    gap = major[1]["boxExclusive"][0]-major[0]["boxExclusive"][2] if len(major) == 2 else None
+    return {"alphaThreshold": 224, "connectivity": 4, "componentCount": len(found),
+            "foregroundPixelCount": total, "largestTwoLeftToRight": major,
+            "otherComponents": found[2:], "majorForegroundCoverage": sum(item["pixelCount"] for item in major)/total,
+            "minimumFullHeightBoxGapSourcePixels": gap,
+            "separateExtractionSafeByMask": len(major) == 2 and gap > 0 and sum(item["pixelCount"] for item in major) == total,
+            "separateImagesExtracted": False,
+            "futureOption": "Root may place separately extracted mask components with a clear16-pixel native lane; no lane is allocated or claimed here"}
+
+
+def encode(output, cluster=2, source=SOURCE):
+    if cluster not in (2, 4):
+        raise ValueError("Only the bounded2-pixel candidate and optional4-pixel alternative are authorized")
+    generation = json.loads((HERE / "generation.json").read_text())
+    if sha(source) != generation["artifactSha256"]:
+        raise ValueError("Approved original study changed")
+    rgba = Image.open(source).convert("RGBA")
+    mask = rgba.getchannel("A").point(lambda value: 255 if value >= 224 else 0)
+    crop_box = mask.getbbox()
+    footprints = component_boxes(mask)
+    crop = rgba.crop(crop_box)
+    crop.putalpha(mask.crop(crop_box))
+    working = tuple(value//cluster for value in SIZE)
+    scale = min(working[0]/crop.width, working[1]/crop.height)
+    fit = tuple(max(1, round(value*scale)) for value in crop.size)
+    offset = ((working[0]-fit[0])//2, working[1]-fit[1])
+    canvas = Image.new("RGBA", working)
+    canvas.paste(crop.resize(fit, Image.Resampling.NEAREST), offset)
+    raw = list(canvas.get_flattened_data())
+    opaque = [pixel[:3] for pixel in raw if pixel[3]]
+    strip = Image.new("RGB", (len(opaque), 1))
+    strip.putdata(opaque)
+    quantized = strip.quantize(colors=15, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
+    qp = quantized.getpalette()
+    colors = []
+    for index in sorted(set(quantized.get_flattened_data())):
+        color = tuple(min(248, ((qp[index*3+channel]+4)//8)*8) for channel in range(3))
+        if color not in colors:
+            colors.append(color)
+    palette = [(0, 0, 0)] + colors + [(0, 0, 0)]*(15-len(colors))
+    indices = [0 if not a else 1+min(range(len(colors)), key=lambda i:
+               (r-colors[i][0])**2+(g-colors[i][1])**2+(b-colors[i][2])**2) for r, g, b, a in raw]
+    indexed = Image.new("P", working)
+    indexed.putpalette([component for color in palette for component in color]+[0]*720)
+    indexed.putdata(indices)
+    indexed = indexed.resize(SIZE, Image.Resampling.NEAREST)
+    indexed.info["transparency"] = 0
+    indices = list(indexed.get_flattened_data())
+    graphics, lookup, tilemap = [], {}, []
+    for ty in range(12):
+        for tx in range(20):
+            pixels = tuple(indices[(ty*8+y)*160+tx*8+x] for y in range(8) for x in range(8))
+            canonical, flags = min((flip(pixels, flags), flags) for flags in (0, 0x400, 0x800, 0xC00))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tilemap.append(lookup[canonical] | flags | PALETTE_BANK << 12)
+    foreground, occupancy = [], []
+    for my in range(6):
+        row = ""
+        for mx in range(10):
+            foreground.append([tilemap[(my*2+y)*20+mx*2+x] for y in range(2) for x in range(2)])
+            ink = any(indexed.getpixel((mx*16+x, my*16+y)) for y in range(16) for x in range(16))
+            row += "1" if ink else "0"
+        occupancy.append(row)
+    decoded = []
+    for y in range(96):
+        for x in range(160):
+            word = tilemap[y//8*20+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            decoded.append(graphics[word & 1023][sy*8+sx])
+    if decoded != indices:
+        raise ValueError("Flip-aware4bpp references did not round-trip")
+    # Measure the visually identified entry after quantization. Its blue source
+    # glass becomes neutral dark shades, so a blue-only probe would be invalid.
+    # Exclude the two-pixel building baseline from this dark-frame flood.
+    dark = {(x, y) for y in range(80, 94) for x in range(44, 64)
+            if indexed.getpixel((x, y)) and max(palette[indexed.getpixel((x, y))]) <= 112}
+    seed, frame = (52, 90), set()
+    pending = deque([seed]) if seed in dark else deque()
+    while pending:
+        point = pending.popleft()
+        if point in frame or point not in dark:
+            continue
+        frame.add(point)
+        x, y = point
+        pending.extend(((x-1, y), (x+1, y), (x, y-1), (x, y+1)))
+    frame_box = [min(x for x, _ in frame), min(y for _, y in frame), max(x for x, _ in frame), max(y for _, y in frame)] if frame else None
+    # The inspected frame has one pixel-cluster at each side/top. This inset is
+    # measurement only; it does not draw or change any pixel.
+    door_box = [frame_box[0]+cluster, frame_box[1]+cluster, frame_box[2]-cluster, frame_box[3]] if frame_box else None
+    center = [(door_box[0]+door_box[2])/2, (door_box[1]+door_box[3])/2] if door_box else None
+    local = [int(center[0])//16, int(center[1])//16] if center else None
+    output.mkdir(parents=True, exist_ok=True)
+    indexed.save(output / "candidate-indexed.png")
+    native = indexed.convert("RGBA")
+    native.save(output / "candidate-native.png")
+    native.resize((640, 384), Image.Resampling.NEAREST).save(output / "preview-4x.png")
+    physical = ((len(graphics)+15)//16)*16
+    sheet = Image.new("P", (128, physical//16*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info["transparency"] = 0
+    for n, pixels in enumerate(graphics):
+        for y in range(8):
+            for x in range(8):
+                sheet.putpixel((n%16*8+x, n//16*8+y), pixels[y*8+x])
+    sheet.save(output / "tiles.png")
+    (output / "tiles.4bpp").write_bytes(bytes(pixels[i] | pixels[i+1] << 4 for pixels in graphics for i in range(0, 64, 2)))
+    (output / "foreground-tilemap-relative.bin").write_bytes(struct.pack("<240H", *tilemap))
+    (output / "foreground-metatiles-relative.json").write_text(json.dumps(foreground, indent=2)+"\n")
+    (output / "09.pal").write_bytes(("JASC-PAL\r\n0100\r\n16\r\n"+"".join(" ".join(map(str, color))+"\r\n" for color in palette)).encode())
+    (output / "09.gbapal").write_bytes(struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in palette)))
+    (output / "source-component-footprints.json").write_text(json.dumps(footprints, indent=2)+"\n")
+    metadata = {
+        "schemaVersion": 1, "landmarkId": "shen-ji-new-village", "status": "approved direction; unmerged native format candidate",
+        "originalStudySha256": sha(source), "originalStudyUnchanged": True,
+        "recipe": {"sourceCropBoxAlpha224": list(crop_box), "alphaThreshold": 224, "nativeSizePixels": list(SIZE),
+                   "workingSizePixels": list(working), "nativePixelCluster": cluster, "preserveAspectRatio": True,
+                   "fitSizePixels": [v*cluster for v in fit], "offsetPixels": [v*cluster for v in offset],
+                   "resampling": "nearest", "quantization": "MEDIANCUT opaque colors only, then nearest GBA5bit colors; no dithering",
+                   "paletteBankCandidate": PALETTE_BANK, "paletteAvailability": "conditional after all three old Greenway landmark facades retire; Root checks remaining references",
+                   "opaqueColorCount": len(colors), "PillowVersion": PIL.__version__},
+        "native": {"unmergedUniqueGraphicsIncludingBlank": len(graphics), "paddedSheetSlots": physical,
+                   "targetUniqueAtMost": TARGET, "meetsProvisionalTarget": len(graphics) <= TARGET,
+                   "paletteEntries": 16, "binaryAlpha": set(native.getchannel("A").get_flattened_data()) == {0, 255},
+                   "foregroundEnvelopeCells": 60, "occupiedMetatiles": sum(row.count("1") for row in occupancy),
+                   "distinctForegroundDefinitionsIncludingEmpty": len({tuple(group) for group in foreground}),
+                   "occupancyRows": occupancy, "tilemapDimensions8x8": [20, 12], "relativeGraphicIndices": True,
+                   "roundTripPixels": len(decoded), "tilemapRoundTripPass": True},
+        "components": footprints,
+        "courtyard": {"nativeWalkable": False, "nominalGapNativePixelsApprox": footprints["minimumFullHeightBoxGapSourcePixels"]*160/(crop_box[2]-crop_box[0]) if footprints["minimumFullHeightBoxGapSourcePixels"] is not None else None,
+                      "collisionAssigned": False, "RootMaySeparateComponentsWith16PixelLane": True},
+        "paintedDoorMeasurement": {"method": "dark frame component at seed52,90 within inspected left-door ROI x44..63,y80..93; maxRGB112, then one-cluster side/top inset",
+                      "frameBoxInclusiveExcludingBuildingBaseline": frame_box, "panelBoxInclusive": door_box,
+                      "centerPixels": center, "localMetatile": local,
+                      "futureOriginIfFixedGlobalDoor": [10-local[0], 44-local[1]] if local else None,
+                      "originFinal": False, "fixedGlobalDoor": [10, 44], "approach": [10, 45], "arrival": [10, 47],
+                      "paintedPixelsAreNotAnActiveWarp": True},
+        "budget": {"jointGreenwayUsableGraphics": 376, "combinedAllocationChecked": False, "sharedPrimaryReuseNotMeasured": True,
+                   "noSeparateFullBankAssumed": True, "alternativeAutoSelected": False},
+        "files": {"indexed": "candidate-indexed.png", "rgba": "candidate-native.png", "preview": "preview-4x.png", "palette": "09.pal"},
+        "mapOrBankChanged": False, "registeredInRom": False, "nativeReady": False,
+    }
+    (output / "encode-manifest.json").write_text(json.dumps(metadata, indent=2)+"\n")
+    return metadata
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=HERE / "candidate")
+    args = parser.parse_args()
+    result = encode(args.output, cluster=2)
+    variants = {"cluster2": result["native"]}
+    if not result["native"]["meetsProvisionalTarget"]:
