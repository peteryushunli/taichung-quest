+#!/usr/bin/env python3
+"""V3 attached street fronts: fixed approved lots plus explicit authored infill."""
+import argparse
+from collections import Counter, deque
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image, ImageDraw
+
+from color_compile import compile_colorways, color_grid, native_tile_images, save_native
+from library import ROOT, WALK, require
+from neighborhood_density import dilate
+from neighborhood_fill import cells, geometry_helpers
+from neighborhood_pilot import player_reference
+
+
+INFILL = [
+    ('north-roofline', [26, 0, 31, 5], 'residential', 'terracotta'),
+    ('northwest-lane', [14, 8, 19, 13], 'residential', 'terracotta'),
+    ('west-junction', [0, 19, 6, 24], 'shop', 'terracotta'),
+    ('central-junction', [16, 19, 21, 24], 'shop', 'terracotta'),
+    ('central-retail', [38, 36, 43, 40], 'shop', 'teal'),
+    ('station-east', [56, 50, 63, 55], 'shop', 'slate'),
+    ('south-station-row', [34, 58, 46, 63], 'shop', 'terracotta'),
+]
+
+
+def bay_widths(width):
+    """Cover the whole frontage, with attached narrow bays and no gap cells."""
+    if width <= 7: return [width]
+    count = width // 4
+    widths = [width // count] * count
+    for i in range(width % count): widths[-1 - i] += 1
+    return widths
+
+
+def frontage_plan(layout):
+    blocks = []; units = []
+    for lot in layout['candidateLots']:
+        x0, y0, x1, y1 = lot['localRect']; retail = lot['streetBand'] == 'primaryRetailFrontage'
+        family = 'slate' if x0 >= 44 else 'teal' if x0 >= 28 else 'terracotta'
+        if lot['id'] == 'pilot-r2c2-lot-2-12': family = 'source'
+        if lot['id'] == 'pilot-r2c2-lot-18-32': family = 'mustard'
+        blocks.append(dict(id=lot['id'], rect=lot['localRect'], role='shop' if retail else 'residential',
+                           colorway=family, basis='approved-frozen-lot', streetBand=lot['streetBand']))
+    for name, rect, role, family in INFILL:
+        blocks.append(dict(id='authored-infill-' + name, rect=rect, role=role, colorway=family,
+                           basis='authored-game-infill-not-source-parcel',
+                           streetBand='primaryRetailFrontage' if role == 'shop' else 'residentialSideStreet'))
+    for block in blocks:
+        x0, y0, x1, y1 = block['rect']; height = y1 - y0 + 1; x = x0
+        identities = []
+        for n, width in enumerate(bay_widths(x1 - x0 + 1)):
+            bay_height = height
+            # One quieter lower bay within wide residential runs gives a
+            # meaningful skyline rhythm without breaking the attached frontage.
+            if block['role'] == 'residential' and height == 8 and x1 - x0 + 1 >= 8 and n == 1:
+                bay_height = 6
+            identity = f"frontage-{block['role']}-{width}x{bay_height}"
+            unit = dict(id=block['id'] + f'-bay-{n + 1}', prefab=identity, x=x, y=y1 - bay_height + 1,
+                        context='shopping' if block['role'] == 'shop' else 'residential',
+                        colorway=block['colorway'], blockId=block['id'], width=width, height=bay_height, role=block['role'])
+            units.append(unit); identities.append(unit['id']); x += width
+        require(x == x1 + 1, 'Bay decomposition leaves a frontage gap')
+        block['units'] = identities
+    return blocks, units
+
+
+def repeated_window(width, ids):
+    """Repeat complete source metatiles; not RGB resampling or new raster art."""
+    if ids == [0x2c6, 0x2b0, 0x2b1]:
+        # Use complete paired attic-window halves when the interior is even.
+        middle = ([0x2c6] if width % 2 else []) + [0x2b0, 0x2b1] * (width // 2)
+        return middle[:width]
+    return [ids[i % len(ids)] for i in range(width)]
+
+
+def make_frontage(width, height, role, template):
+    """Native source stretch/repetition; roof corners and glazing stay discrete."""
+    require(width >= 4 and height in (5, 6, 8), 'Unsupported frontage dimensions')
+    interior = width - 2; body = height - 1
+    rows = [
+        [0x2a7] + [0x2b6] * interior + [0x287],
+        [0x2af] + [0x2be] * interior + [0x28f],
+        [0x2b7] + repeated_window(interior, [0x2c6, 0x2b0, 0x2b1]) + [0x297],
+    ]
+    if height == 5:
+        rows.append([0x2bf] + [0x2be] * interior + [0x29f])
+    else:
+        for n in range((body - 3) // 2):
+            rows.extend([[0x2a0] + [0x2a1] * interior + [0x2a6],
+                         [0x2a8] + [0x2a9] * interior + [0x2ae]])
+    entrance_x = max(1, min(width - 2, width // 2))
+    dormant = 0x2be
+    if role == 'shop':
+        # Display rows use actual General shop-window metatiles. Concrete
+        # mullions every fourth interior cell make narrow retail bays readable.
+        glass = repeated_window(interior, [0x180, 0x181, 0x182, 0x194])
+        rows[-2][1:-1] = glass
+        rows[-1][1:-1] = [0x194] * interior
+        dormant = 0x194
+    else:
+        rows[-1][entrance_x] = dormant
+    words = [[f'0x{0x400 | tile:04X}' for tile in row] for row in rows]
+    words.append(['0x316E'] * width)
+    p = deepcopy(template)
+    p.update(id=f'frontage-{role}-{width}x{height}', name=f'Attached {role} bay {width}x{height}',
+             width=width, height=height, bodyHeight=body,
+             role='commercial-frontage' if role == 'shop' else 'residential-walkup' if height > 5 else 'residential-lowrise',
+             allowedContext=['shopping', 'mixed-use'] if role == 'shop' else ['residential', 'mixed-use'],
+             material='source roof / masonry / repeated retail glazing' if role == 'shop' else 'source roof / attached masonry homes',
+             words=words,
+             masks=dict(paint=['1' * width] * body + ['0' * width],
+                        solid=['1' * width] * body + ['0' * width],
+                        mandatoryClear=['0' * width] * body + ['1' * width]),
+             entrances=[dict(id='front', position=[entrance_x, body - 1], southApproach=[entrance_x, body],
+                             dormantWord=f'0x{0x400 | dormant:04X}', activeDoorWord='0x043D',
+                             activation='requires-authored-exterior-warp-and-paired-interior-return')],
+             provenance=dict(derivedFromPrefab=['building-rowhouse-compact', 'building-walkup-low', 'building-walkup-tall', 'building-corner-store'],
+                             transforms=['repeat-discrete-source-middle-roof-and-wall-metatiles', 'retain-source-endcaps',
+                                         'attach-bays-with-no-side-setback', 'dormant-entrance', 'clear-unpainted-apron']),
+             notes='Authored continuous-frontage blockout. Reused FireRed geometry/art; no bespoke Taiwan skin or actual parcel/height claim.')
+    return p
+
+
+def compile_frontage(output, layout, variant_metatile_start=None):
+    output = Path(output); output.mkdir(parents=True, exist_ok=True)
+    blocks, units = frontage_plan(layout)
+    catalog = json.loads((ROOT / 'data/taichung/prefabs/catalog.json').read_text())
+    template = next(p for p in catalog['prefabs'] if p['id'] == 'building-rowhouse-compact')
+    definitions = {(u['width'], u['height'], u['role']) for u in units}
+    added = [make_frontage(w, h, role, template) for w, h, role in sorted(definitions)]
+    catalog['prefabs'].extend(added)
+    recipe = json.loads((ROOT / 'data/taichung/prefabs/colorways.json').read_text())
+    recipe['eligiblePrefabs'].extend(p['id'] for p in added)
+    (output / 'frontage-catalog.json').write_text(json.dumps(catalog, indent=2) + '\n')
+    recipe_path = output / 'frontage-colorways.json'; recipe_path.write_text(json.dumps(recipe, indent=2) + '\n')
+    compiled = compile_colorways(catalog=catalog, colorways=recipe_path, variant_metatile_start=variant_metatile_start)
+    return compiled, blocks, units
+
+
+def fill_frontage(compiled, layout, blocks, units):
+    width, height = layout['width'], layout['height']; require((width, height) == (64, 64), 'Expected approved 64x64 pilot')
+    geo = geometry_helpers()
+    roads = set().union(*(geo.line_cells(r['authoredLocalCenterline'], r['widthTiles']) for r in layout['authoredRoads']))
+    approaches = set().union(*(cells(a['rect']) for a in layout['clearApproaches']))
+    gym_reserves = set().union(*(cells(l['proposedAuthoredLocal']['reserveRect']) for l in layout['landmarks']))
+    gym_art = set().union(*(cells(l['proposedAuthoredLocal']['artRect']) for l in layout['landmarks']))
+    approved_cells = set().union(*(cells(l['localRect']) for l in layout['candidateLots']))
+    protected = roads | approaches; base = [0x3001] * (width * height)
+    all_envelopes = set().union(*(cells(b['rect']) for b in blocks))
+    sidewalks = (dilate(roads, 2, width, height) | dilate(all_envelopes, 1, width, height)) - all_envelopes - gym_reserves - protected
+    for x, y in sidewalks: base[y * width + x] = 0x31c1
+    seen_envelopes = set()
+    for block in blocks:
+        patch = cells(block['rect']); require(not patch & (gym_reserves | approaches), 'Frontage enters gym or arrival reserve')
+        require(not patch & seen_envelopes, 'Frontage envelopes overlap'); seen_envelopes |= patch
+        if block['basis'] != 'approved-frozen-lot':
+            require(not patch & approved_cells, 'Authored infill alters an approved lot')
+            require(patch & dilate(roads, 2, width, height), 'Infill strip is not adjacent to an authored road')
+        for x, y in patch:
+            if (x, y) not in roads: base[y * width + x] = 0x316e if block['role'] == 'shop' else 0x31c1
+    # Road and gym surface words remain identical to V1/V2, even where an
+    # unpainted infill apron reserves a clear cell on an existing road edge.
+    for x, y in roads: base[y * width + x] = 0x316e
+    for x, y in approaches: base[y * width + x] = 0x3175
+    for x, y in gym_art: base[y * width + x] = 0x056e
+    lib = compiled['library']; placements = []
+    for unit in units:
+        p = lib.prefabs[unit['prefab']]; block = next(b for b in blocks if b['id'] == unit['blockId'])
+        patch = cells([unit['x'], unit['y'], unit['x'] + p['width'] - 1, unit['y'] + p['height'] - 1])
+        require(patch <= cells(block['rect']), 'Attached bay/apron escapes assigned envelope')
+        placements.append({k: unit[k] for k in ('id', 'prefab', 'x', 'y', 'context', 'colorway', 'blockId')})
+    bare = [{k: v for k, v in p.items() if k not in ('colorway', 'blockId')} for p in placements]
+    composed = lib.compose(width, height, bare, base=base, protected_paths=protected | sidewalks)
+    words = color_grid(compiled, composed, placements)
+    def attr(word):
+        t = word & 1023
+        return lib.attr(t) if t < 640 else compiled['attributes'][t - 640]
+    def walk(point):
+        x, y = point
+        if not (0 <= x < width and 0 <= y < height): return False
+        word = words[y * width + x]
+        return not word & 0xc00 and word >> 12 == 3 and attr(word) & 0x1ff in WALK
+    arrivals = [tuple(l['proposedAuthoredLocal']['arrival']) for l in layout['landmarks']]
+    require(walk(arrivals[0]), 'Spawn blocked'); reached = {arrivals[0]}; queue = deque(reached)
+    while queue:
+        x, y = queue.popleft()
+        for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+            if n not in reached and walk(n): reached.add(n); queue.append(n)
+    require(protected | sidewalks <= reached, 'Disconnected road, arrival path or sidewalk')
+    for p in arrivals: require(p in reached, 'Landmark arrival disconnected')
+    for entrance in composed['entrances']:
+        require(entrance['status'] == 'dormant-reservation' and tuple(entrance['southApproach']) in reached, 'Dormant approach unreachable')
+    for port in layout['independentSeamSuggestions']: require(tuple(port['localPoint']) in reached, 'Road egress disconnected')
+    require(all((a & 0xfc00) == (b & 0xfc00) for a, b in zip(words, composed['words'])), 'Color remap changes collision/elevation')
+    require(not any(attr(w) & 0x1ff in range(0x60, 0x70) for w in words), 'Unregistered warp behavior')
+    # Every frontage spans its whole envelope at street level. This is the
+    # meaningful density contract, rather than merely placing more props.
+    for block in blocks:
+        x0, y0, x1, y1 = block['rect']
+        require(all(words[(y1 - 1) * width + x] & 0xc00 for x in range(x0, x1 + 1)), 'Gap in attached street wall')
+    retail = set().union(*(cells(l['localRect']) for l in layout['candidateLots'] if l['streetBand'] == 'primaryRetailFrontage'))
+    total_front = sum(b['rect'][2] - b['rect'][0] + 1 for b in blocks)
+    report = dict(result='pass', status='V3 source-native continuous frontage study; unregistered',
+        dimensions=[width, height], approvedLotsFilled=len(layout['candidateLots']), authoredInfillStrips=len(INFILL),
+        attachedBuildingBays=len(units), fullWidthStreetwallTiles=total_front, streetwallGapCells=0,
+        approvedLotBuiltCoverage=round(sum(bool(words[y * width + x] & 0xc00) for x, y in approved_cells) / len(approved_cells), 4),
+        approvedCommercialLotBuiltCoverage=round(sum(bool(words[y * width + x] & 0xc00) for x, y in retail) / len(retail), 4),
+        reachableCells=len(reached), protectedRoadAndApproachCells=len(protected), landmarkSouthArrivals=arrivals,
+        ordinaryDormantEntranceApproaches=len(composed['entrances']), roadEgresses=len(layout['independentSeamSuggestions']),
+        footprintOverflows=0, roadOrGymReserveSolidCollisions=0,
+        authoredInfillApronCellsOnExistingRoad=len(set().union(*(cells([b['rect'][0], b['rect'][3], b['rect'][2], b['rect'][3]]) for b in blocks if b['basis'] != 'approved-frozen-lot')) & roads),
+        sourceLayoutCanonicalJsonSha256=hashlib.sha256(json.dumps(layout, sort_keys=True).encode()).hexdigest(),
+        roleCounts=dict(Counter(u['role'] for u in units)), colorCounts=dict(Counter(u['colorway'] for u in units)),
+        nativeBankBudget=compiled['budget'],
+        designAdditionNotice='Seven infill strips are authored gameplay additions, not mapped municipal parcels. Existing lot and road geometry is unchanged.')
+    return dict(words=words, placements=placements, blocks=blocks, report=report,
+                roads=roads, approaches=approaches, gymReserves=gym_reserves, entrances=composed['entrances'])
+
+
+def write_frontage(output):
+    output = Path(output)
+    layout = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json').read_text())
+    compiled, blocks, units = compile_frontage(output, layout)
+    result = fill_frontage(compiled, layout, blocks, units); words = result['words']; report = result['report']
+    tiles = native_tile_images(compiled, {word & 1023 for word in words})
+    image = Image.new('RGB', (1024, 1024))
+    for i, word in enumerate(words): image.paste(tiles[word & 1023], (i % 64 * 16, i // 64 * 16))
+    sprite = player_reference(ROOT)
+    if sprite:
+        x, y = report['landmarkSouthArrivals'][0]; image.paste(sprite, (x * 16, y * 16 - 16), sprite)
+    image.save(output / 'filled-block-native.png')
+    board = Image.new('RGB', (1024, 1120), '#e9efeb'); board.paste(image, (0, 64)); draw = ImageDraw.Draw(board)
+    draw.text((12, 10), 'R2C2 V3 / ATTACHED STREET FRONTS / 24 FIXED LOTS + 7 AUTHORED INFILL STRIPS', fill='#19392f')
+    draw.text((12, 28), 'Full-width adjoining shop bays, homes over retail, deeper building rows, stepped residential rooflines.', fill='#365a4b')
+    draw.text((12, 46), 'Game-design infill, not actual parcels. Recombined native FireRed art; Taiwan-specific skins and gym art remain pending.', fill='#365a4b')
+    for landmark in layout['landmarks']:
+        r = landmark['proposedAuthoredLocal']['artRect']; box = (r[0] * 16, r[1] * 16 + 64, (r[2] + 1) * 16 - 1, (r[3] + 1) * 16 + 63)
+        draw.rectangle(box, outline='#ab642b', width=2)
+        draw.text((box[0] + 4, box[1] + 5), landmark['name'], fill='#6b452b')
+        draw.text((box[0] + 4, box[1] + 20), 'GYM ART RESERVE', fill='#6b452b')
+    draw.text((12, 1090), 'Road/gym/arrival geometry preserved. Every bay has a clear south approach; V1/V2 retained separately.', fill='#365a4b')
+    board.save(output / 'filled-block-overview.png')
+    (output / 'filled-map.bin').write_bytes(struct.pack('<4096H', *words))
+    (output / 'frontage-plan.json').write_text(json.dumps(dict(schemaVersion=1, blocks=blocks, placements=result['placements'],
+        sourceGeometry='data/taichung/neighborhoods/pilot-r2c2-layout.json', sourceGeographyUnchanged=True,
+        notice=report['designAdditionNotice']), indent=2) + '\n')
+    (output / 'validation.json').write_text(json.dumps(report, indent=2) + '\n')
+    save_native(compiled, output / 'native-color-bank')
+    print(json.dumps({k: v for k, v in report.items() if k != 'nativeBankBudget'}, indent=2))
+    print(output / 'filled-block-overview.png')
+    return compiled, result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    write_frontage(parser.parse_args().output)
