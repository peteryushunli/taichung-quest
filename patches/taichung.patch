+	callnative TaichungGym_ScriptGetResult
+	goto_if_ne VAR_RESULT, TAICHUNG_GYM_RESULT_WON, TaichungGym_MiyaharaNotRecorded
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_ne VAR_RESULT, TRUE, TaichungGym_MiyaharaNotRecorded
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_COMPLETE
+	goto TaichungGym_MiyaharaMessage
+
+TaichungGym_MiyaharaAlreadyComplete::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE
+	goto TaichungGym_MiyaharaMessage
+
+TaichungGym_MiyaharaDeclined::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_DECLINED
+	goto TaichungGym_MiyaharaMessage
+
+TaichungGym_MiyaharaUnavailable::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_UNAVAILABLE
+	goto TaichungGym_MiyaharaMessage
+
+TaichungGym_MiyaharaNotRecorded::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_NOT_RECORDED
+
+TaichungGym_MiyaharaMessage::
+	callnative TaichungGym_ScriptGetMiyaharaMessage
+	msgbox gStringVar4
+	release
+	end
