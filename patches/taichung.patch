+          fromStep: index + 1, toStep: index + 2, observedFrames: event.frame - earlier.frame,
+          minFrames: event.possibleEventFrame.min - earlier.possibleEventFrame.max,
+          maxFrames: event.possibleEventFrame.max - earlier.possibleEventFrame.min,
+        };
+      });
+      report.everyEventFrameExact = report.coordinateEvents.every(event => event.possibleEventFrame.min === event.possibleEventFrame.max);
+      report.referenceComparison = !expectedFramesPerTile ? 'not requested'
+        : !report.everyEventFrameExact ? 'inconclusive: polling uncertainty; inspect frame ranges'
+        : report.perTileIntervals.every(interval => interval.observedFrames === expectedFramesPerTile) ? 'matches selected native-frame cadence'
