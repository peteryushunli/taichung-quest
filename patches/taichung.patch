+#!/usr/bin/env python3
+"""Independent read-only checks for the registered Nantun increment.
+
+Nantun appends four map numbers (North, Wanhe and two temple halls), two
+contract districts and two temple landmarks, adds its connections to Greenway
+and Xitun, and opens the neighbour cells its seams cross. The frozen district
+guards (check_cmp, check_xitun_final, and through them check_old_core and
+check_greenway_science) compare whole files against older baselines, so they
+check the state underneath this increment: underneath() removes exactly that
+delta from the shared files, and check() proves the delta and the Nantun maps on
+the actual tree. The plan supplies seam addresses, not proof; no compiler
+module is imported.
+
+City rework (phase 2b): North (43x40) and Wanhe (83x72) follow the master plan
+in data/taichung/nantun/rework. Their sizes, origins and connections come from
+its districts, and every cell a neighbour on another bank will draw is a primary
+(city kit) piece. A neighbour still at its pre-rework size is "pending": seams
+toward it are reported apart from errors, and its own files must stay as the
+Nantun skeleton left them. Once a neighbour lands at its master-plan size, its
+seams with Nantun are enforced in full. The rework's install record
+(rework/report.json) pins its outputs and its entries in the shared files;
+rework_underneath() hands frozen guards the kit commit's Nantun files and
+entries, and only while the tree holds exactly that record. Guards that pass
+the city kit's pre-kit primaries in still see kit pieces as installed here.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+# Canonical integration/taichung the Nantun skeleton was built on. Every shared
+# file this increment touches is byte-identical there and at c8e1495.
+BASE = "a72bd0ea92d3ce41c0b67b1b470066a3b0cfe2d0"
+PLAN = "data/taichung/nantun/skeleton-plan.json"
+GROUPS = "data/maps/map_groups.json"
+CONTRACT = "docs/taichung-city-contract.json"
+LAYOUTS = "data/layouts/layouts.json"
+EXTERIORS = {
+    "MAP_TAICHUNG_NANTUN_NORTH": ("TaichungNantunNorth", "gTileset_TaichungNantunNorth", "data/tilesets/secondary/taichung_nantun_north"),
+    "MAP_TAICHUNG_NANTUN_WANHE": ("TaichungNantunWanhe", "gTileset_TaichungNantun", "data/tilesets/secondary/taichung_nantun"),
+}
+HALLS = {"MAP_TAICHUNG_WANHE_TEMPLE_HALL": "TaichungWanheTemple_Hall",
+         "MAP_TAICHUNG_WENCHANG_TEMPLE_HALL": "TaichungWenchangTemple_Hall"}
+NAMES = ("TaichungNantunNorth", "TaichungNantunWanhe", "TaichungWanheTemple_Hall", "TaichungWenchangTemple_Hall")
+TEMPLES = ("wanhe-temple", "wenchang-temple")
+NEIGHBOURS = ("TaichungGreenway", "TaichungXitun")
+WALKING = 3
+REWORK_PLAN = "data/taichung/nantun/rework/masterplan.json"
+REWORK_PLAN_SHA256 = "c23c806fa95a1a2fd0de198992c9edc00996dd07183362a233348d2bd732af81"
+# The fill pass's cell file: one class per cell in world coordinates (its first line names the origin).
+REWORK_CELLS = "data/taichung/nantun/rework/plan-cells.txt"
+REWORK_CELLS_SHA256 = "735b2b25836e1d1f28ece0126025f4b1ab2252abd2ae78a825cd97048b02b1e3"
+KIT = "data/taichung/city-kit/kit.json"
+ENCOUNTERS = "src/data/wild_encounters.json"
+SCRIPTS = "data/scripts/taichung_city.inc"
+# The rework's install record (build_rework.py) and the kit commit it was built on.
+REWORK_BASE = "63cd81b147f73042560de8d3e5abb861b8230bde"
+REWORK_RECORD = "data/taichung/nantun/rework/report.json"
+SCRIPT_MARK = "@ Nantun rework signs: written by tools/taichung/nantun/build_rework.py"
+NORTH_PALETTES = "data/tilesets/secondary/taichung_nantun_north/palettes"
+# Master-plan districts by map: Nantun's own, then the neighbours they meet.
+OWN = {"north": "MAP_TAICHUNG_NANTUN_NORTH", "wanhe": "MAP_TAICHUNG_NANTUN_WANHE"}
+OTHERS = {"xitun": ("MAP_TAICHUNG_XITUN", "TaichungXitun"), "greenway": ("MAP_TAICHUNG_GREENWAY", "TaichungGreenway"),
+          "oldcity": ("MAP_TAICHUNG_OLD_CITY", "TaichungOldCity")}
+OPPOSITE = {"left": "right", "right": "left", "up": "down", "down": "up"}
+ORDER = ("up", "right", "down", "left")
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def dump(value):
+    return (json.dumps(value, indent=2, ensure_ascii=False)+"\n").encode()
+
+
+def strip_groups(groups):
+    out = copy.deepcopy(groups)
+    out["gMapGroup_Taichung"] = [name for name in out["gMapGroup_Taichung"] if name not in NAMES]
+    return out
+
+
+def strip_map(data):
+    out = copy.deepcopy(data)
+    out["connections"] = [c for c in out["connections"] or [] if c["map"] not in EXTERIORS]
+    return out
+
+
+def strip_contract(contract):
+    out = copy.deepcopy(contract)
+    out["districts"] = [strip_map(d) for d in out["districts"] if d["map"] not in EXTERIORS]
+    out["landmarks"] = [l for l in out["landmarks"] if l["exteriorMap"] not in EXTERIORS]
+    out["habitatRegions"] = [h for h in out.get("habitatRegions", []) if h["map"] not in EXTERIORS]
+    return out
+
+
+def registered(files):
+    return any(name in files.json(GROUPS).get("gMapGroup_Taichung", []) for name in NAMES)
+
+
+def seam_cells(plan, name):
+    return [tuple(cell) for seam in plan["neighborSeams"] if seam["map"] == name for cell in seam["cells"]]
+
+
+def underneath(files):
+    """Overrides that remove exactly the registered Nantun delta from shared files."""
+    if not registered(files):
+        return {}
+    base = type(files)(files.source, BASE)
+    plan = files.json(PLAN)
+    layouts = {l["id"]: l for l in files.json(LAYOUTS)["layouts"] if "id" in l}
+    out = {GROUPS: dump(strip_groups(files.json(GROUPS))), CONTRACT: dump(strip_contract(files.json(CONTRACT)))}
+    for name in NEIGHBOURS:
+        path = f"data/maps/{name}/map.json"
+        data = files.json(path)
+        out[path] = dump(strip_map(data))
+        layout = layouts[data["layout"]]
+        raw, old = bytearray(files.read(layout["blockdata_filepath"])), base.read(layout["blockdata_filepath"])
+        for x, y in seam_cells(plan, name):
+            i = 2*(y*layout["width"]+x)
+            raw[i:i+2] = old[i:i+2]
+        out[layout["blockdata_filepath"]] = bytes(raw)
+    return out
+
+
+def rework_entries(files):
+    """Nantun's entries in the four shared files."""
+    ids, layout_ids = set(OWN.values()), {f"LAYOUT_{mid[4:]}" for mid in OWN.values()}
+    contract, scripts = files.json(CONTRACT), files.text(SCRIPTS)
+    at = scripts.find(SCRIPT_MARK)
+    return {"layouts": [l for l in files.json(LAYOUTS)["layouts"] if l.get("id") in layout_ids],
+            "districts": [d for d in contract["districts"] if d["map"] in ids],
+            "landmarks": [l for l in contract["landmarks"] if l["exteriorMap"] in ids],
+            "encounters": [e for g in files.json(ENCOUNTERS)["wild_encounter_groups"] for e in g["encounters"] if e.get("map") in ids],
+            "scriptsSha256": hashlib.sha256(scripts[at:].encode()).hexdigest() if at >= 0 else None}
+
+
+def rework_registered(files):
+    """The install record, when the tree holds exactly the rework's registered output."""
+    try:
+        record = files.json(REWORK_RECORD)["install"]
+    except (OSError, KeyError, ValueError, subprocess.CalledProcessError):
+        return None
+    if record.get("baseCommit") != REWORK_BASE:
+        return None
+    if any(hashlib.sha256(files.read(path)).hexdigest() != digest for path, digest in record["outputs"].items()):
+        return None
+    return record if rework_entries(files) == record["entries"] else None
+
+
+def rework_underneath(files):
+    """{path: bytes} with exactly the registered rework removed, when the tree
+    holds it; otherwise {}, so a guard reads the real bytes. The rework's own
+    files read as REWORK_BASE's, and its entries in the shared files as that
+    commit's entries; North's palettes (a copy of Wanhe's) read as before."""
+    record = rework_registered(files)
+    if record is None:
+        return {}
+    base = type(files)(files.source, REWORK_BASE)
+    out = {path: base.read(path) for path in record["outputs"]}
+    out.update({f"{NORTH_PALETTES}/{n:02}.pal": base.read(f"{NORTH_PALETTES}/{n:02}.pal") for n in range(16)})
+    ids, layout_ids = set(OWN.values()), {f"LAYOUT_{mid[4:]}" for mid in OWN.values()}
+    old_layouts = {l["id"]: l for l in base.json(LAYOUTS)["layouts"] if "id" in l}
+    layouts = files.json(LAYOUTS)
+    layouts["layouts"] = [old_layouts[l["id"]] if l.get("id") in layout_ids else l for l in layouts["layouts"]]
+    old_contract, contract = base.json(CONTRACT), files.json(CONTRACT)
+    old_districts = {d["map"]: d for d in old_contract["districts"]}
+    old_landmarks = {l["id"]: l for l in old_contract["landmarks"]}
+    contract["districts"] = [old_districts[d["map"]] if d["map"] in ids else d for d in contract["districts"]]
+    contract["landmarks"] = [old_landmarks[l["id"]] if l["exteriorMap"] in ids else l for l in contract["landmarks"]]
+    encounters = files.json(ENCOUNTERS)
+    for group in encounters["wild_encounter_groups"]:
+        group["encounters"] = [e for e in group["encounters"] if e.get("map") not in ids]
+    scripts = files.text(SCRIPTS)
+    out.update({LAYOUTS: dump(layouts), CONTRACT: dump(contract), ENCOUNTERS: dump(encounters),
+                SCRIPTS: (scripts.split("\n" + SCRIPT_MARK)[0].rstrip("\n") + "\n").encode()})
+    return out
+
+
+def plan_connections(plan, key):
+    """Connections of one master-plan district: neighbours sharing an edge, offset along it."""
+    x0, y0, x1, y1 = plan["districts"][key]["plan"]
+    found = []
+    for other, mid in {**OWN, **{k: v[0] for k, v in OTHERS.items()}}.items():
+        if other == key:
+            continue
+        a0, b0, a1, b1 = plan["districts"][other]["plan"]
+        if a0 < x1 and x0 < a1 and b1 == y0:
+            found.append(("up", a0 - x0, mid))
+        if a0 < x1 and x0 < a1 and b0 == y1:
+            found.append(("down", a0 - x0, mid))
+        if b0 < y1 and y0 < b1 and a0 == x1:
+            found.append(("right", b0 - y0, mid))
+        if b0 < y1 and y0 < b1 and a1 == x0:
+            found.append(("left", b0 - y0, mid))
+    found.sort(key=lambda c: (ORDER.index(c[0]), c[1]))
+    return [{"map": mid, "offset": offset, "direction": d} for d, offset, mid in found]
+
+
+def size(plan, key):
+    x0, y0, x1, y1 = plan["districts"][key]["plan"]
+    return x1-x0, y1-y0
+
+
+def pending_error(error, pending, own_ids, facing):
+    """A Validator error on a seam between a Nantun map and a neighbour not yet reworked."""
+    m = re.match(r"(MAP_\w+) \(\d+,\d+\): \w+ seam blocked/mismatched at (MAP_\w+)", error) or \
+        re.match(r"(MAP_\w+): no reciprocal connection from (MAP_\w+)", error)
+    if m:
+        pair = {m.group(1), m.group(2)}
+        # A seam that touches a map not yet reworked lands with that map's increment.
+        return bool(pair & pending)
+    m = re.match(r"(MAP_\w+) \((\d+),(\d+)\): open (\w+) boundary has \d+ destinations", error)
+    if m:
+        return facing(m.group(1), int(m.group(2)), int(m.group(3)), m.group(4))
+    m = re.match(r"(MAP_\w+): (\w+) connection has no walkable crossing", error)
+    if m:
+        return facing(m.group(1), None, None, m.group(2))
+    return False
+
+
+def check(source=ROOT, overrides=None):
+    source = Path(source)
+    support = load("nantun_independent_support", source/"tools/taichung/landmarks/check_old_core.py")
+    strips = load("nantun_independent_strips", source/"tools/taichung/landmarks/analyze_theater_cohort.py")
+    now, base = support.Files(source), support.Files(source, BASE)
+    now.cache.update(overrides or {})
+    # The registered street-sign layer opens three Nantun signposts; its own guard proves it.
+    if hasattr(support, "street_signs_underneath"):
+        now.cache.update(support.street_signs_underneath(now))
+    # The reworked Xitun and Old City stay in view: their seams with Nantun are checked live
+    # once both sides are on the master plan. Only the frozen registry and contract
+    # comparisons read underneath them (the Old City rework, the latest layer, first).
+    tests = support.Checks()
+    plan = now.json(PLAN)
+    raw_plan = now.read(REWORK_PLAN)
+    rework = json.loads(raw_plan)
+    layouts = {l["id"]: l for l in now.json(LAYOUTS)["layouts"] if "id" in l}
+    base_layouts = {l["id"]: l for l in base.json(LAYOUTS)["layouts"] if "id" in l}
+    maps, banks = {}, {}
+    for name in tuple(v[0] for v in EXTERIORS.values())+tuple(v[1] for v in OTHERS.values()):
+        data = now.json(f"data/maps/{name}/map.json")
+        layout = layouts[data["layout"]]
+        maps[data["id"]] = dict(name=name, data=data, layout=layout, grid=now.words(layout["blockdata_filepath"]))
+    key_of = {**{v: k for k, v in OWN.items()}, **{v[0]: k for k, v in OTHERS.items()}}
+    # A neighbour still at its pre-rework size has not landed its side of the seams yet.
+    pending = {mid for key, (mid, _) in OTHERS.items()
+               if (maps[mid]["layout"]["width"], maps[mid]["layout"]["height"]) != size(rework, key)}
+
+    # Guards that check the state under the city kit pass its pre-kit primaries in;
+    # the kit's own guard proves those files, so kit pieces are read as installed.
+    kit_paths = set(support.city_kit_underneath(support.Files(source)))
+    installed = support.Files(source)
+    installed.cache.update({path: data for path, data in (overrides or {}).items() if path not in kit_paths})
+
+    def bank(mid, files=now):
+        if (mid, files is now) not in banks:
+            layout = maps[mid]["layout"]
+            primary, _ = support.resolved_folder(files, layout["primary_tileset"])
+            secondary, _ = support.resolved_folder(files, layout["secondary_tileset"])
+            banks[mid, files is now] = support.Bank(files, primary, secondary)
+        return banks[mid, files is now]
+
+    def registry():
+        # The registered Old City rework appends Old City North; its own guard proves that entry.
+        groups = json.loads(support.oldcity_rework_underneath(now).get(GROUPS) or now.read(GROUPS))
+        order = groups["gMapGroup_Taichung"]
+        tests.require(order[-len(NAMES):] == list(NAMES), "Nantun maps are not the last four Taichung map numbers, in order")
+        tests.require(strip_groups(groups) == base.json(GROUPS), "Map registry changed beyond appending the Nantun maps")
+        ids = {now.json(f"data/maps/{name}/map.json")["id"]: name for name in NAMES}
+        tests.require(ids == {**{mid: v[0] for mid, v in EXTERIORS.items()}, **HALLS}, "Nantun map IDs differ from the registered names")
+        return {"mapNumbers": {mid: order.index(name) for mid, name in ids.items()}}
+
+    def contract_and_connections():
+        tests.require(hashlib.sha256(raw_plan).hexdigest() == REWORK_PLAN_SHA256, "Rework master plan is not c23c806f")
+        tests.require(hashlib.sha256(now.read(REWORK_CELLS)).hexdigest() == REWORK_CELLS_SHA256,
+                      "Rework cell file is not the pinned fill pass")
+        contract = now.json(CONTRACT)
+        # A neighbour's registered rework proves its own contract entries; compare the rest underneath it.
+        others = support.Files(source)
+        others.cache.update(now.cache)
+        others.cache.update(support.oldcity_rework_underneath(others))
+        if hasattr(support, "xitun_rework_underneath"):
+            others.cache.update(support.xitun_rework_underneath(others))
+        tests.require(strip_contract(others.json(CONTRACT)) == base.json(CONTRACT),
+                      "City contract changed beyond the registered Nantun entries")
+        districts = {d["map"]: d for d in contract["districts"]}
+        temples = [l for l in contract["landmarks"] if l["exteriorMap"] in EXTERIORS]
+        tests.require(set(EXTERIORS) <= set(districts), "Nantun exteriors are missing from the contract districts")
+        tests.require(sorted(l["id"] for l in temples) == sorted(TEMPLES), "Nantun landmarks are not exactly the two temples")
+        for l in temples:
+            tests.require(l["gym"] is False and l["gymMap"] in HALLS and l["exteriorMap"] == "MAP_TAICHUNG_NANTUN_WANHE",
+                          f"Temple {l['id']} is not a non-gym hall entered from Wanhe")
+        for key, mid in OWN.items():
+            x0, y0, x1, y1 = rework["districts"][key]["plan"]
+            wanted = plan_connections(rework, key)
+            layout, d = maps[mid]["layout"], districts[mid]
+            tests.require((layout["width"], layout["height"]) == (x1-x0, y1-y0), f"{mid} layout is not its master-plan size")
+            tests.require((d["width"], d["height"], d["worldOrigin"]) == (x1-x0, y1-y0, [x0, y0]),
+                          f"{mid} contract size or origin differs from the master plan")
+            tests.require(maps[mid]["data"]["connections"] == wanted == d["connections"],
+                          f"{mid} connections differ from the master plan")
+        for name in NEIGHBOURS:
+            path = f"data/maps/{name}/map.json"
+            data = now.json(path)
+            if data["id"] not in pending:
+                key = key_of[data["id"]]
+                for c in plan_connections(rework, key):
+                    if c["map"] in OWN.values():
+                        tests.require(c in data["connections"], f"{name} lacks its master-plan connection to {c['map']}")
+                continue
+            tests.require(strip_map(data) == base.json(path), f"{name} map.json changed beyond its Nantun connections")
+            added = sorted((c for c in data["connections"] if c["map"] in EXTERIORS), key=json.dumps)
+            planned = sorted((s["connection"] for s in plan["neighborSeams"] if s["map"] == name), key=json.dumps)
+            tests.require(added == planned, f"{name} Nantun connections differ from the plan's seams")
+        return {"districts": sorted(EXTERIORS), "temples": sorted(l["id"] for l in temples),
+                "pendingNeighbours": sorted(pending)}
+
+    def banks_and_bindings():
+        declarations = "\n".join(now.text(p) for p in ("src/data/tilesets/graphics.h", "src/data/tilesets/metatiles.h", "src/graphics.c"))
+        greenway = maps["MAP_TAICHUNG_GREENWAY"]["layout"]["primary_tileset"]
+        sizes = {}
+        for mid, (name, label, folder) in EXTERIORS.items():
+            layout = maps[mid]["layout"]
+            tests.require(layout["primary_tileset"] == greenway, f"{name} does not share Greenway's primary bank")
+            tests.require(layout["secondary_tileset"] == label, f"{name} does not use its registered secondary bank {label}")
+            actual, header = support.resolved_folder(now, label)
+            tests.require(actual == folder, f"{label} resolves outside {folder}")
+            for field, value in (("isCompressed", "TRUE"), ("isSecondary", "TRUE"), ("callback", "NULL")):
+                tests.require(re.search(rf"\.{field}\s*=\s*{value}\b", header) is not None, f"{label}.{field} is not {value}")
+            for field, suffix in (("tiles", "tiles.4bpp.lz"), ("metatiles", "metatiles.bin"), ("metatileAttributes", "metatile_attributes.bin"), ("palettes", None)):
+                symbol = re.search(rf"\.{field}\s*=\s*(\w+)", header).group(1)
+                declaration = re.search(rf"\b{re.escape(symbol)}\s*\[.*?=\s*(.*?);", declarations, re.S)
+                paths = re.findall(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1)) if declaration else []
+                wanted = [f"{folder}/{suffix}"] if suffix else [f"{folder}/palettes/{n:02}.gbapal" for n in range(16)]
+                tests.require(paths == wanted, f"C loads unvalidated source for {label}.{field}")
+            b = bank(mid)
+            graphics = b.images[1].width*b.images[1].height//64
+            tests.require(len(b.attrs[1]) <= 384 and graphics <= 384, f"{label} exceeds secondary capacity")
+            for n in range(640, 640+len(b.attrs[1])):
+                tests.require((b.attr(n) >> 29) & 3 in (0, 1, 2), f"{label}: unsupported layer at {n:#x}")
+                for entry in b.entries(n):
+                    tests.require((entry & 1023) < 1016 and entry >> 12 < 13, f"{label}: {n:#x} reaches scratch or an unloaded palette")
+                    b.graphic(entry & 1023)
+            for cell in maps[mid]["grid"] + now.words(layout["border_filepath"]):
+                b.attr(cell & 1023)
+            sizes[label] = {"metatiles": len(b.attrs[1]), "graphics": graphics}
+        # North's bank is a byte copy of Wanhe's, so their seam draws the same from either side.
+        north, wanhe = EXTERIORS["MAP_TAICHUNG_NANTUN_NORTH"][2], EXTERIORS["MAP_TAICHUNG_NANTUN_WANHE"][2]
+        for leaf in ("metatiles.bin", "metatile_attributes.bin", "tiles.png")+tuple(f"palettes/{n:02}.pal" for n in range(16)):
+            tests.require(now.read(f"{north}/{leaf}") == now.read(f"{wanhe}/{leaf}"), f"North's bank differs from Wanhe's at {leaf}")
+        return sizes
+
+    def seam_strips():
+        own, landed, pend = 0, 0, 0
+        # Cells of ours a neighbour on another bank will draw, by the master plan's geometry.
+        for key, mid in OWN.items():
+            me = maps[mid]
+            for c in plan_connections(rework, key):
+                other = key_of[c["map"]]
+                if other in OWN:
+                    continue
+                w, h = size(rework, other)
+                for x, y in strips.visible_cells({"width": w, "height": h}, me["layout"], OPPOSITE[c["direction"]], -c["offset"]):
+                    n = me["grid"][y*me["layout"]["width"]+x] & 1023
+                    tests.require(n < 640, f"{me['name']} ({x},{y}) is drawn by {other} but uses secondary metatile {n:#x}")
+                    own += 1
+        # Cells drawn across a seam both sides have landed: the same art from either bank.
+        mismatches = set()
+        for mid, view in maps.items():
+            for c in view["data"]["connections"] or []:
+                pair = {mid, c["map"]}
+                if not pair & set(OWN.values()) or c["map"] not in maps:
+                    continue
+                if pair & pending:
+                    pend += 1
+                    continue
+                target = maps[c["map"]]
+                for x, y in strips.visible_cells(view["layout"], target["layout"], c["direction"], c["offset"]):
+                    n = target["grid"][y*target["layout"]["width"]+x] & 1023
+                    try:
+                        same = bank(mid).render(n) == bank(c["map"]).render(n) and bank(mid).attr(n) == bank(c["map"]).attr(n)
+                    except ValueError:
+                        same = False
+                    if not same and (mid, c["map"], n) not in mismatches:
+                        tests.require(False, f"Connection strip mismatch: {view['name']} draws {target['name']} ({x},{y}) metatile {n:#x} differently")
+                        mismatches.add((mid, c["map"], n))
+                    landed += 1
+        return {"ownCellsNeighboursDraw": own, "landedStripCellsCompared": landed, "pendingConnections": pend,
+                "sourceRule": "fieldmap.c: 7 rows/columns copied per connection, 8 east"}
+
+    def neighbour_cells():
+        opened = landed = 0
+        for seam in plan["neighborSeams"]:
+            name = seam["map"]
+            data = now.json(f"data/maps/{name}/map.json")
+            # The plan's cells address the neighbour as BASE has it, which is where underneath()
+            # restores them; a landed neighbour is rebuilt, so only that addressing is left to
+            # check, and it must stay edge cells the skeleton opened.
+            before = base_layouts[data["layout"]]
+            shape = layouts[data["layout"]] if data["id"] in pending else before
+            width, height = shape["width"], shape["height"]
+            old = base.words(before["blockdata_filepath"])
+            band = {"left": lambda x, y: x <= 1, "right": lambda x, y: x >= width-2,
+                    "up": lambda x, y: y <= 1, "down": lambda x, y: y >= height-2}[seam["connection"]["direction"]]
+            if data["id"] not in pending:
+                for x, y in map(tuple, seam["cells"]):
+                    tests.require(band(x, y), f"{name} ({x},{y}) was not on the edge its seam faces")
+                    tests.require(old[y*width+x] & 0xC00, f"{name} ({x},{y}) was already open; the plan may only list cells it opens")
+                    landed += 1
+                continue
+            tests.require(seam["connection"] in data["connections"], f"{name} lacks the connection its Nantun seam crosses")
+            for x, y in map(tuple, seam["cells"]):
+                word = maps[data["id"]]["grid"][y*width+x]
+                tests.require(band(x, y), f"{name} ({x},{y}) is not on the edge its seam faces")
+                tests.require(not word & 0xC00 and word >> 12 == WALKING, f"{name} ({x},{y}) seam cell is not open walking ground")
+                tests.require(old[y*width+x] & 0xC00, f"{name} ({x},{y}) was already open; the plan may only list cells it opens")
+                opened += 1
+        return {"neighbourCellsOpened": opened, "landedSeamCellsAddressed": landed}
+
+    def kit_and_passability():
+        kit = {name: int(v, 16) for name, v in now.json(KIT)["metatiles"].items()}
+        water_ids = {v for name, v in kit.items() if name.startswith("wa-")}
+        bridge_ids = {v for name, v in kit.items() if name.startswith("pb-")}
+        lines = now.read(REWORK_CELLS).decode().split("\n")
+        cx, cy = (int(re.search(rf"\b{axis} (-?\d+)\.\.", lines[0]).group(1)) for axis in "xy")
+        cells = {(x+cx, y+cy): ch for y, row in enumerate(lines[3:]) for x, ch in enumerate(row)}
+        bridges = {c for c, ch in cells.items() if ch == "b"}
+        highway_ids = {v for name, v in kit.items() if name.startswith("hw-")}
+        street_cells, water_cells, highway_cells = set(), set(), set()
+        for s in rework["streetsEastWest"]:
+            r = s["firstAsphaltRow"]
+            street_cells |= {(x, y) for x in range(s["x0"], s["x1"]) for y in range(r-1, r+4)}
+        for s in rework["streetsNorthSouth"]:
+            c = s["firstAsphaltCol"]
+            street_cells |= {(x, y) for x in range(c-1, c+4) for y in range(s["y0"], s["y1"])}
+        for x0, y0, x1, y1 in rework["river"]+[r for rects in rework["canals"].values() for r in rects]:
+            water_cells |= {(x, y) for x in range(x0, x1) for y in range(y0, y1)}
+        for x0, y0, x1, y1 in rework["highway"].values():
+            highway_cells |= {(x, y) for x in range(x0, x1) for y in range(y0, y1)}
+        counts = {}
+        for key, mid in OWN.items():
+            m, (x0, y0, x1, y1) = maps[mid], rework["districts"][key]["plan"]
+            b, width = bank(mid, installed), x1-x0
+            seen = {"street": 0, "water": 0, "highway": 0, "keptWater": 0, "pathBridge": 0, "wall": 0}
+            for y in range(y0, y1):
+                for x in range(x0, x1):
+                    word = m["grid"][(y-y0)*width+x-x0]
+                    n, c = word & 1023, (x, y)
+                    if c in highway_cells:
+                        tests.require(n in highway_ids and word & 0xC00, f"{m['name']} highway {c} is not a solid kit lane")
+                        seen["highway"] += 1
+                    elif c in street_cells:
+                        tests.require(not word & 0xC00, f"{m['name']} street {c} is not walkable")
+                        seen["street"] += 1
+                    elif cells.get(c) == "W":
+                        # The freeway's retaining wall: nobody climbs it, whatever stands in for it.
+                        tests.require(word & 0xC00, f"{m['name']} wall {c} can be walked onto")
+                        seen["wall"] += 1
+                    elif c in bridges:
+                        # The plan's path bridges cross water on foot; nothing else over water is walkable.
+                        tests.require(c in water_cells and n in bridge_ids and not word & 0xC00,
+                                      f"{m['name']} path bridge {c} is not a walkable kit bridge over water")
+                        seen["pathBridge"] += 1
+                    elif c in water_cells and x == rework["highway"]["west"][2]:
+                        # The freeway's wall carries its top over the river as the bridge's side.
+                        tests.require(n == kit["wall-w-top"] and word & 0xC00, f"{m['name']} {c} is not the wall over the river")
+                        seen["wall"] += 1
+                    elif c in water_cells:
+                        tests.require(n in water_ids, f"{m['name']} water {c} is not a kit water piece")
+                        seen["water"] += 1
+                    if n in water_ids:
+                        # Water never lets anyone in: collision, and no surf or current behaviour.
+                        tests.require(word & 0xC00 and b.attr(n) & 0x1FF == 0, f"{m['name']} water {c} can be entered")
+                        seen["keptWater"] += 1
+            counts[m["name"]] = seen
+        return counts
+
+    def events_and_encounters():
+        labels = set(re.findall(r"^(\w+)::", now.text(SCRIPTS), re.M))
+        encounters = {e["map"]: e for g in now.json(ENCOUNTERS)["wild_encounter_groups"] for e in g["encounters"] if "map" in e}
+        out = {}
+        for mid in OWN.values():
+            m, b = maps[mid], bank(mid)
+            width = m["layout"]["width"]
+            for e in m["data"]["bg_events"]:
+                tests.require(e["script"] in labels, f"{m['name']} sign ({e['x']},{e['y']}) runs undefined {e['script']}")
+                tests.require(m["grid"][e["y"]*width+e["x"]] & 0xC00, f"{m['name']} sign ({e['x']},{e['y']}) can be walked through")
+            tall = sum(1 for w in m["grid"] if b.attr(w & 1023) & 0x1FF == 2 and not w & 0xC00)
+            table = encounters.get(mid, {}).get("land_mons", {})
+            tests.require(tall > 0 and table.get("encounter_rate") == 12 and len(table.get("mons", [])) == 12,
+                          f"{m['name']} lacks tall grass or its 12-slot land table at rate 12")
+            out[m["name"]] = {"signs": len(m["data"]["bg_events"]), "tallGrassCells": tall}
+        return out
+
+    def geometry_and_doors():
+        native = support.load_native(source)
+        geometry = native.Validator(source, now.json(CONTRACT), installed.cache)
+        geometry.run()
+        own_ids = set(OWN.values())
+
+        def facing(mid, x, y, direction):
+            """Whether an open edge (or a whole edge, x is None) of mid looks toward a pending map."""
+            if mid in pending:
+                return any(c["map"] in own_ids for c in maps[mid]["data"]["connections"] if c["direction"] == direction)
+            if mid not in own_ids:
+                return False
+            if x is None:
+                targets = [c["map"] for c in maps[mid]["data"]["connections"] if c["direction"] == direction]
+                return bool(targets) and all(t in pending for t in targets)
+            x0, y0, _, _ = rework["districts"][key_of[mid]]["plan"]
+            dx, dy = {"left": (-1, 0), "right": (1, 0), "up": (0, -1), "down": (0, 1)}[direction]
+            wx, wy = x0+x+dx, y0+y+dy
+            for key, (other, _) in OTHERS.items():
+                a0, b0, a1, b1 = rework["districts"][key]["plan"]
+                if a0 <= wx < a1 and b0 <= wy < b1:
+                    return other in pending
+            return False
+
+        held = [e for e in geometry.errors if pending_error(e, pending, own_ids, facing)]
+        tests.errors.extend("geometry: "+error for error in geometry.errors if error not in held)
+        distances = getattr(geometry, "distances", {})
+        bound = {r["id"] for r in getattr(geometry, "landmark_results", [])}
+        tests.require(set(TEMPLES) <= bound, "Temple landmarks are not bound door-to-hall-and-back")
+        reached = {}
+        for mid, (name, label, folder) in EXTERIORS.items():
+            m = geometry.maps[mid]
+            reached[name] = sum(1 for node in distances if node[0] == mid)
+            tests.require(reached[name] > 0, f"{name} is unreachable on foot from the new-game spawn")
+            painted = {(x, y) for y in range(m.height) for x in range(m.width) if m.behavior(x, y) == 0x69}
+            tests.require(painted == {(w["x"], w["y"]) for w in m.data["warp_events"]}, f"{name} has unpaired door art or warps")
+            tests.require(all(word & 0xC00 for word in m.border), f"{name} border is not blocked")
+        return {"reachableCells": reached, "boundTemples": sorted(bound & set(TEMPLES)), "seamCrossings": len(getattr(geometry, "open_edges", [])),
+                "pendingSeamErrors": len(held), "pendingNeighbours": sorted(pending)}
+
+    for label, function in (("registry", registry), ("contractAndConnections", contract_and_connections),
+                            ("banksAndBindings", banks_and_bindings), ("seamStrips", seam_strips),
+                            ("neighbourCells", neighbour_cells), ("kitAndPassability", kit_and_passability),
+                            ("eventsAndEncounters", events_and_encounters), ("geometryAndDoors", geometry_and_doors)):
+        tests.section(label, function)
+    return {"passed": not tests.errors, "errors": tests.errors, "checks": tests.results, "baselineCommit": BASE,
+            "pendingNeighbours": sorted(pending),
+            "scope": "Read-only source validation of the Nantun increment; geometry reads the working tree; no ROM, runtime or save claim."}
+
+
+def self_test(source=ROOT):
+    support = load("nantun_probe_support", Path(source)/"tools/taichung/landmarks/check_old_core.py")
+    files = support.Files(Path(source))
+    probes = []
+    raw = bytearray(files.read("data/layouts/TaichungGreenway/map.bin"))
+    struct.pack_into("<H", raw, (50*40+0)*2, 0x040E)
+    probes.append(("greenway-seam-cell-closed", {"data/layouts/TaichungGreenway/map.bin": bytes(raw)}))
+    layouts = files.json(LAYOUTS)
+    next(l for l in layouts["layouts"] if l.get("id") == "LAYOUT_TAICHUNG_NANTUN_NORTH")["secondary_tileset"] = "gTileset_TaichungNantun"
+    probes.append(("north-on-shared-bank", {LAYOUTS: dump(layouts)}))
+    folder = EXTERIORS["MAP_TAICHUNG_NANTUN_NORTH"][2]
+    raw = bytearray(files.read(folder+"/metatiles.bin"))
+    struct.pack_into("<H", raw, 16, struct.unpack_from("<H", raw, 16)[0] ^ 1)
+    probes.append(("north-bank-diverges-from-wanhe", {folder+"/metatiles.bin": bytes(raw)}))
+    data = files.json("data/maps/TaichungGreenway/map.json")
+    next(c for c in data["connections"] if c["map"] == "MAP_TAICHUNG_NANTUN_NORTH")["offset"] += 1
+    probes.append(("greenway-connection-offset", {"data/maps/TaichungGreenway/map.json": dump(data)}))
+    data = files.json("data/maps/TaichungNantunNorth/map.json")
+    next(c for c in data["connections"] if c["map"] == "MAP_TAICHUNG_GREENWAY")["offset"] += 1
+    probes.append(("north-connection-offset", {"data/maps/TaichungNantunNorth/map.json": dump(data)}))
+    groups = files.json(GROUPS)
+    order = groups["gMapGroup_Taichung"]
+    order[-4], order[-3] = order[-3], order[-4]
+    probes.append(("nantun-map-numbers-swapped", {GROUPS: dump(groups)}))
+    contract = files.json(CONTRACT)
+    next(l for l in contract["landmarks"] if l["id"] == "wanhe-temple")["gym"] = True
+    probes.append(("temple-made-gym", {CONTRACT: dump(contract)}))
+    plan = files.json(PLAN)
+    plan["neighborSeams"][1]["cells"].append([5, 52])
+    probes.append(("plan-claims-interior-greenway-cell", {PLAN: dump(plan)}))
+    wanhe = "data/layouts/TaichungNantunWanhe/map.bin"
+    raw = bytearray(files.read(wanhe))
+    struct.pack_into("<H", raw, (10*85+84)*2, 0x3000 | 0x2F0)   # Old City draws this cell
+    probes.append(("wanhe-strip-cell-on-secondary-art", {wanhe: bytes(raw)}))
+    raw = bytearray(files.read(wanhe))
+    struct.pack_into("<H", raw, (70*85+42)*2, struct.unpack_from("<H", raw, (70*85+42)*2)[0] & ~0xC00)
+    probes.append(("river-cell-walkable", {wanhe: bytes(raw)}))
+    raw = bytearray(files.read(wanhe))
+    struct.pack_into("<H", raw, (30*85+6)*2, struct.unpack_from("<H", raw, (30*85+6)*2)[0] & ~0xC00)   # world (1,134)
+    probes.append(("wall-cell-walkable", {wanhe: bytes(raw)}))
+    data = files.json("data/maps/TaichungNantunWanhe/map.json")
+    data["bg_events"][-1]["script"] += "_Missing"
+    probes.append(("sign-runs-undefined-script", {"data/maps/TaichungNantunWanhe/map.json": dump(data)}))
+    results = []
+    for name, overrides in probes:
+        result = check(source, overrides)
+        results.append({"probe": name, "rejected": not result["passed"], "errors": result["errors"][:3]})
+    # underneath() may restore only the plan's seam cells; any other neighbour
+    # change must stay visible to the frozen guards.
+    raw = bytearray(files.read("data/layouts/TaichungGreenway/map.bin"))
+    struct.pack_into("<H", raw, (5*40+5)*2, struct.unpack_from("<H", raw, (5*40+5)*2)[0] ^ 0x400)
+    probe = support.Files(Path(source))
+    probe.cache["data/layouts/TaichungGreenway/map.bin"] = bytes(raw)
+    kept = underneath(probe)["data/layouts/TaichungGreenway/map.bin"][(5*40+5)*2:(5*40+5)*2+2] == bytes(raw[(5*40+5)*2:(5*40+5)*2+2])
+    results.append({"probe": "underneath-keeps-unregistered-greenway-word", "rejected": kept, "errors": []})
+    # rework_underneath() hides the rework from frozen guards only while the tree
+    # holds exactly its registered output: an edited cell or entry stays visible.
+    raw = bytearray(files.read(wanhe))
+    struct.pack_into("<H", raw, (40*83+40)*2, struct.unpack_from("<H", raw, (40*83+40)*2)[0] ^ 1)
+    contract = files.json(CONTRACT)
+    next(d for d in contract["districts"] if d["map"] == OWN["wanhe"])["connections"][0]["offset"] += 1
+    for name, path, value in (("rework-underneath-skips-edited-map", wanhe, bytes(raw)),
+                              ("rework-underneath-skips-edited-entry", CONTRACT, dump(contract))):
+        probe = support.Files(Path(source))
+        probe.cache[path] = value
+        results.append({"probe": name, "rejected": rework_underneath(probe) == {}, "errors": []})
+    return results
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    result = check(args.source.resolve())
+    if args.self_test and result["passed"]:
+        result["adversarialProbes"] = self_test(args.source.resolve())
+        result["passed"] &= all(item["rejected"] for item in result["adversarialProbes"])
+        if not result["passed"]:
+            result["errors"].append("A corruption probe escaped independent validation")
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(json.dumps(result, indent=2)+"\n")
+    print(json.dumps({"passed": result["passed"], "errors": result["errors"],
+                      "checks": {k: v["passed"] for k, v in result["checks"].items()},
+                      "adversarialProbes": result.get("adversarialProbes", [])}, indent=2))
+    sys.exit(0 if result["passed"] else 1)
