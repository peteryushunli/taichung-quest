+static const u8 sV1Cases[][2] = {
+    {26,61},
+    {26,62},
+    {26,63},
+    {26,64},
+    {31,57},
+    {32,57},
+};
+
+#define COUNT(a) (sizeof(a) / sizeof((a)[0]))
+static void Versioned(u16 version)
+{
+    Reset(); V(0x40F7) = version; V(0x40FB) = 2; V(0x40FC) = 133;
+    sSave.playerPartyCount = 3; // Established saves need not own an original starter.
+}
+
+static void AssertSamePartyAndVars(const struct SaveBlock1 *before)
+{
+    assert(V(0x40F7) == 3 && sVariableWrites == 1);
+    AssertProtected(before, FALSE); // Includes checkpoint, all nonversion vars and bag/party bytes.
+}
+
+int main(void)
+{
+    static const u16 starters[] = {SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU};
+    static const u8 cohortPositions[][2] = {{30,66},{24,23},{24,15}};
+    struct SaveBlock1 before;
+    unsigned version, i, map;
+
+    Reset(); before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 0);
+
+    for (version = 1; version <= 2; version++)
+    {
+        // Every exact new invalid cell uses its verified nearest connected target.
+        for (i = 0; i < COUNT(sV3Cases); i++)
+        {
+            Versioned(version); InOldCity(sV3Cases[i][0],sV3Cases[i][1]); before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            AssertWarp(sV3Cases[i][2],sV3Cases[i][3]);
+            assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+        }
+        // All 1268 retained walkable positions keep the exact actual saved coordinates.
+        for (i = 0; i < COUNT(sSafeCases); i++)
+        {
+            Versioned(version); InOldCity(sSafeCases[i][0],sSafeCases[i][1]); before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            AssertWarp(sSafeCases[i][0],sSafeCases[i][1]);
+            assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+        }
+        // The old cache is also refreshed after Continue in either connected neighbor.
+        for (map = MAP_NUM(MAP_TAICHUNG_OLD_CITY); map <= MAP_NUM(MAP_TAICHUNG_XITUN); map++)
+        {
+            Versioned(version); InOldCity(cohortPositions[map][0],cohortPositions[map][1]); sSave.location.mapNum = map; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(sWarpRequests == 1 && sHasContinueWarp && sSave.continueGameWarp.mapGroup == 43);
+            assert(sSave.continueGameWarp.mapNum == (s8)map && sSave.continueGameWarp.warpId == -1);
+            assert(sSave.continueGameWarp.x == before.pos.x && sSave.continueGameWarp.y == before.pos.y);
+            AssertSamePartyAndVars(&before);
+            sHasContinueWarp = FALSE; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && !sHasContinueWarp && sWarpRequests == 1);
+        }
+        // Unchanged rooms (including welcome13) and a legacy route retain their location and native returns.
+        for (map = 3; map <= 14; map++)
+        {
+            Versioned(version);
+            if (map < 14) { sSave.location.mapGroup = 43; sSave.location.mapNum = map; }
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(!sHasContinueWarp && sWarpRequests == 0);
+            assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+            AssertSamePartyAndVars(&before);
+        }
+        // Existing native return flags/IDs win. Repair only explicit coordinate targets.
+        for (i = 0; i < COUNT(sV3Cases); i++)
+        {
+            Versioned(version); sHasContinueWarp = TRUE;
+            InOldCity(30,66); sSave.continueGameWarp = sSave.location;
+            sSave.continueGameWarp.warpId = -1;
+            sSave.continueGameWarp.x = sV3Cases[i][0]; sSave.continueGameWarp.y = sV3Cases[i][1]; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(sWarpRequests == 0); AssertWarp(sV3Cases[i][2],sV3Cases[i][3]); AssertSamePartyAndVars(&before);
+        }
+        for (i = 0; i < 3; i++)
+        {
+            Versioned(version); InOldCity(2,2); sHasContinueWarp = TRUE;
+            if (i == 1) { sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = 0; }
+            if (i == 2) { sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1; sSave.continueGameWarp.x = 30; sSave.continueGameWarp.y = 66; }
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(sHasContinueWarp && sWarpRequests == 0);
+            assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+            AssertSamePartyAndVars(&before);
+        }
+    }
+    // v1's six extra cells were already blocked at v2; apply this repair only to v0/v1.
+    for (version = 0; version <= 1; version++)
+        for (i = 0; i < COUNT(sV1Cases); i++)
+        {
+            Versioned(version); V(0x40FC) = SPECIES_PIKACHU; InOldCity(sV1Cases[i][0],sV1Cases[i][1]); before = sSave;
+            TaichungSaveUpgradeOnContinue(); AssertWarp(30,66);
+            if (version == 1) AssertSamePartyAndVars(&before); else AssertProtected(&before,TRUE);
+        }
+    // Earlier unversioned prototype behavior remains: preserve team/progress and establish Station checkpoint.
+    for (i = 0; i < COUNT(starters); i++)
+    {
+        Reset(); V(0x40FC) = starters[i]; V(0x40FD) = 2; V(0x40FB) = i%2 ? 2 : 0; before = sSave;
+        TaichungSaveUpgradeOnContinue(); AssertWarp(30,66);
+        assert(V(0x40F7) == 3 && V(0x40FB) == (i%2 ? 2 : 1) && V(0x40FC) == starters[i]);
+        AssertProtected(&before,TRUE); assert(TaichungSaveUsesStationCheckpoint());
+    }
+    Reset(); V(0x40FD) = 3; before = sSave; TaichungSaveUpgradeOnContinue();
+    assert(V(0x40FC) == SPECIES_BULBASAUR && V(0x40FD) == 3); AssertWarp(30,66); AssertProtected(&before,TRUE);
+    for (map = 0; map < 3; map++)
+    {
+        Reset(); V(0x40FC) = SPECIES_PIKACHU; InOldCity(cohortPositions[map][0],cohortPositions[map][1]); sSave.location.mapNum = map;
+        TaichungSaveUpgradeOnContinue(); assert(sHasContinueWarp && sSave.continueGameWarp.mapNum == (s8)map);
+    }
+    for (version = 0; version <= 4; version++)
+    {
+        Versioned(version); sSave.playerPartyCount = 0; before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 0 && sVariableWrites == 0);
+    }
+    for (version = 3; version <= 4; version++)
+    {
+        Versioned(version); InOldCity(2,2); before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 0 && sVariableWrites == 0);
+    }
+    Reset(); TaichungSaveInitNewGame();
+    assert(V(0x40F7) == 3 && V(0x40FB) == 0 && V(0x40FC) == 0 && sWarpRequests == 0);
+    assert(TaichungSaveUsesStationCheckpoint());
+    puts("PASS: v1/v2 exact 528 relocations and 1268 retained positions, three-bank cohort reload, legacy six blockers, native return preservation, checkpoint/team/bag/preferences/stamps, v0/vanilla/empty/current/future cases.");
+    return 0;
+}
diff --git a/tests/taichung_starter_test.c b/tests/taichung_starter_test.c
new file mode 100644
index 0000000..8eecfaf
--- /dev/null
+++ b/tests/taichung_starter_test.c
@@ -0,0 +1,212 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "pokemon.h"
+#include "taichung_starter.h"
+#include "taichung_team.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+
+static struct SaveBlock1 sSave;
+static struct SaveBlock2 sSave2;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct SaveBlock2 *gSaveBlock2Ptr = &sSave2;
+struct Main gMain;
+struct Pokemon gPlayerParty[6];
+u8 gPlayerPartyCount;
+u16 gSpecialVar_0x8004, gSpecialVar_Result;
+
+static unsigned sCreates, sHistoricalReads;
+static bool8 sFailCreation;
+static u16 sReplaySpecies;
+
+// The party operation has its own production-module tests. This stand-in only
+// exposes whether this helper calls it before/after committing the marker.
+bool8 TaichungTeamSetSlot(u8 slot, u16 species)
+{
+    assert(slot == 0);
+    assert(gPlayerPartyCount == 0);
+    assert(sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] == 0);
+    sCreates++;
+    if (sFailCreation)
+        return FALSE;
+    gPlayerParty[0].species = species;
+    gPlayerPartyCount = 1;
+    return TRUE;
+}
+
+// Mimic the engine's harmful historical read. Every tested path must avoid it.
+u16 VarGet(u16 id)
+{
+    assert(id == TAICHUNG_STARTER_SPECIES_VAR);
+    sHistoricalReads++;
+    sSave.vars[id - VARS_START] = sReplaySpecies;
+    return sReplaySpecies;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    memset(&sSave2, 0xB3, sizeof(sSave2));
+    memset(gPlayerParty, 0, sizeof(gPlayerParty));
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = 0;
+    gSaveBlock1Ptr = &sSave;
+    gSaveBlock2Ptr = &sSave2;
+    gPlayerPartyCount = 0;
+    gMain.inBattle = FALSE;
+    sCreates = sHistoricalReads = 0;
+    sFailCreation = FALSE;
+    sReplaySpecies = 0;
+    gSpecialVar_0x8004 = 0;
+    gSpecialVar_Result = 0xCAFE;
+}
+
+static void AssertOnlyMarkerChanged(const struct SaveBlock1 *before, u16 marker,
+                                  const struct SaveBlock2 *before2)
+{
+    struct SaveBlock1 expected = *before;
+    expected.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = marker;
+    assert(memcmp(&sSave, &expected, sizeof(sSave)) == 0);
+    assert(memcmp(&sSave2, before2, sizeof(sSave2)) == 0);
+    assert(sHistoricalReads == 0);
+}
+
+static void TestAllChoicesAndDuplicate(void)
+{
+    static const u16 choices[] = {SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU};
+    unsigned i;
+    for (i = 0; i < sizeof(choices) / sizeof(choices[0]); i++)
+    {
+        struct SaveBlock1 before;
+        struct SaveBlock2 before2;
+        struct Pokemon granted;
+        Reset();
+        before = sSave;
+        before2 = sSave2;
+        assert(!TaichungStarterHasPartner());
+        assert(TaichungStarterTryGrant(choices[i]) == TAICHUNG_STARTER_RESULT_GRANTED);
+        assert(sCreates == 1 && gPlayerPartyCount == 1);
+        assert(gPlayerParty[0].species == choices[i]);
+        assert(TaichungStarterHasPartner());
+        AssertOnlyMarkerChanged(&before, choices[i], &before2);
+        granted = gPlayerParty[0];
+        assert(TaichungStarterTryGrant(choices[(i + 1) % 4]) == TAICHUNG_STARTER_RESULT_ALREADY);
+        assert(sCreates == 1 && gPlayerPartyCount == 1);
+        assert(memcmp(&granted, &gPlayerParty[0], sizeof(granted)) == 0);
+        AssertOnlyMarkerChanged(&before, choices[i], &before2);
+    }
+}
+
+static void TestInvalidAndFailedCreation(void)
+{
+    static const u16 invalid[] = {0, 2, 3, 5, 6, 8, 26, 150, 151, 0xFFFF};
+    unsigned i;
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    Reset();
+    before = sSave;
+    before2 = sSave2;
+    for (i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++)
+        assert(TaichungStarterTryGrant(invalid[i]) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+
+    sFailCreation = TRUE;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 1 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+    sFailCreation = FALSE;
+    assert(TaichungStarterTryGrant(SPECIES_SQUIRTLE) == TAICHUNG_STARTER_RESULT_GRANTED);
+    assert(sCreates == 2 && gPlayerPartyCount == 1);
+    AssertOnlyMarkerChanged(&before, SPECIES_SQUIRTLE, &before2);
+}
+
+static void TestExistingPartyAndRawMarker(void)
+{
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    struct Pokemon beforeParty[6];
+    Reset();
+    gPlayerParty[0].species = SPECIES_SNORLAX;
+    gPlayerPartyCount = 1;
+    before = sSave;
+    before2 = sSave2;
+    memcpy(beforeParty, gPlayerParty, sizeof(beforeParty));
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_BULBASAUR) == TAICHUNG_STARTER_RESULT_ALREADY);
+    assert(sCreates == 0);
+    assert(memcmp(beforeParty, gPlayerParty, sizeof(beforeParty)) == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2); // Do not infer a legacy marker.
+
+    Reset();
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = SPECIES_PIKACHU;
+    sReplaySpecies = 0;
+    before = sSave;
+    before2 = sSave2;
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_ALREADY);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, SPECIES_PIKACHU, &before2);
+
+    Reset();
+    sReplaySpecies = SPECIES_PIKACHU; // Historical marker must not suppress a new grant.
+    before = sSave;
+    before2 = sSave2;
+    assert(!TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_BULBASAUR) == TAICHUNG_STARTER_RESULT_GRANTED);
+    AssertOnlyMarkerChanged(&before, SPECIES_BULBASAUR, &before2);
+
+    Reset();
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = 0xFFFF;
+    before = sSave;
+    before2 = sSave2;
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_PIKACHU) == TAICHUNG_STARTER_RESULT_ALREADY);
+    AssertOnlyMarkerChanged(&before, 0xFFFF, &before2);
+}
+
+static void TestUnavailableContextAndWrappers(void)
+{
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    Reset();
+    before = sSave;
+    before2 = sSave2;
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    gSaveBlock1Ptr = &sSave;
+    gSaveBlock2Ptr = NULL;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    gSaveBlock2Ptr = &sSave2;
+    gMain.inBattle = TRUE;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+
+    gMain.inBattle = FALSE;
+    TaichungStarter_ScriptHasPartner();
+    assert(gSpecialVar_Result == FALSE);
+    gSpecialVar_0x8004 = SPECIES_PIKACHU;
+    TaichungStarter_ScriptGrant();
+    assert(gSpecialVar_Result == TAICHUNG_STARTER_RESULT_GRANTED);
+    assert(gSpecialVar_0x8004 == SPECIES_PIKACHU);
+    gSpecialVar_0x8004 = SPECIES_SQUIRTLE;
+    TaichungStarter_ScriptGrant();
+    assert(gSpecialVar_Result == TAICHUNG_STARTER_RESULT_ALREADY);
+    TaichungStarter_ScriptHasPartner();
+    assert(gSpecialVar_Result == TRUE);
+    assert(gPlayerPartyCount == 1 && gPlayerParty[0].species == SPECIES_PIKACHU && sCreates == 1);
+    AssertOnlyMarkerChanged(&before, SPECIES_PIKACHU, &before2);
+}
+
+int main(void)
+{
+    TestAllChoicesAndDuplicate();
+    TestInvalidAndFailedCreation();
+    TestExistingPartyAndRawMarker();
+    TestUnavailableContextAndWrappers();
+    puts("PASS: four one-time starter grants; duplicate/existing-party/raw-marker guards; failure/context checks; protected fields retained.");
+    return 0;
+}
