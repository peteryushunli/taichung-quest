+#!/usr/bin/env python3
+"""Export checked baseline native-map -> minimap geometry; no native mutations."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+CONTRACT = 'data/taichung/minimap-contract.json'
+
+
+def require(condition, message):
+    if not condition: raise ValueError(message)
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()
+
+
+def in_bounds(x, y, width, height):
+    return type(x) is int and type(y) is int and 0 <= x < width and 0 <= y < height
+
+
+def project_position(contract, native_key, x, y):
+    """Unknown/invalid inputs return None. Indoor XY never becomes world XY."""
+    entry = contract['mapsByNativeKey'].get(native_key)
+    if entry is None or not in_bounds(x, y, entry['width'], entry['height']): return None
+    indoor = entry['kind'] == 'interior'
+    world = entry['parentEntranceWorld'][:] if indoor else [entry['worldOrigin'][0] + x, entry['worldOrigin'][1] + y]
+    bounds = contract['world']
+    if not in_bounds(world[0], world[1], bounds['width'], bounds['height']): return None
+    return dict(world=world, indoor=indoor, mode='parent-entrance' if indoor else 'live-outdoor',
+                parentMarkerId=entry.get('parentMarkerId'), inBounds=True,
+                normalizedCellCenter=[(world[0] + .5) / bounds['width'], (world[1] + .5) / bounds['height']])
+
+
+def inverse_world(contract, x, y):
+    """Return the one covering exterior and local tile, or None for blank canvas."""
+    if not in_bounds(x, y, contract['world']['width'], contract['world']['height']): return None
+    found = []
+    for key, entry in contract['mapsByNativeKey'].items():
+        if entry['kind'] != 'exterior': continue
+        lx, ly = x - entry['worldOrigin'][0], y - entry['worldOrigin'][1]
+        if in_bounds(lx, ly, entry['width'], entry['height']): found.append(dict(nativeKey=key, local=[lx, ly]))
+    require(len(found) <= 1, 'Exterior world rectangles overlap')
+    return found[0] if found else None
+
+
+def build_contract(source=ROOT):
+    source = Path(source); loaded_hashes = {}
+    def load(path):
+        raw = path.read_bytes(); loaded_hashes[path] = hashlib.sha256(raw).hexdigest()
+        return json.loads(raw)
+    city_path = source / 'docs/taichung-city-contract.json'; city = load(city_path)
+    groups_path = source / 'data/maps/map_groups.json'; groups = load(groups_path)
+    layouts_path = source / 'data/layouts/layouts.json'
+    layouts = {item['id']: item for item in load(layouts_path)['layouts'] if 'id' in item}
+    registered = {}; native_keys = set()
+    for group, name in enumerate(groups['group_order']):
+        for number, folder in enumerate(groups[name]):
+            path = source / 'data/maps' / folder / 'map.json'; data = load(path); key = f'{group}:{number}'
+            require(data['id'] not in registered and key not in native_keys, 'Native map registry is not bijective')
+            registered[data['id']] = dict(key=key, group=group, number=number, data=data, path=path)
+            native_keys.add(key)
+    def native(map_id):
+        require(map_id in registered, f'Map is not registered: {map_id}')
+        r = registered[map_id]; data = r['data']; require(data['layout'] in layouts, f'Layout is not registered: {data["layout"]}')
+        layout = layouts[data['layout']]
+        return dict(mapId=map_id, nativeMapName=data['name'], nativeKey=r['key'], group=r['group'], number=r['number'],
+                    packedMapId=(r['group'] << 8) | r['number'], layoutId=data['layout'],
+                    width=layout['width'], height=layout['height'], registration='registered-source')
+    maps = {}; exterior_by_id = {}; used_paths = [city_path, groups_path, layouts_path]
+    for district in city['districts']:
+        entry = native(district['map']); actual = registered[district['map']]['data']
+        require((entry['width'], entry['height'], entry['layoutId']) == (district['width'], district['height'], district['layout']), 'District contract/layout mismatch')
+        require(actual['connections'] == district['connections'], 'District contract/native connections mismatch')
+        ox, oy = district['worldOrigin']
+        entry.update(kind='exterior', projection='local-plus-world-origin', worldOrigin=[ox, oy],
+                     worldRect=[ox, oy, ox + entry['width'], oy + entry['height']], markerIds=[])
+        maps[entry['nativeKey']] = entry; exterior_by_id[entry['mapId']] = entry
+        used_paths.append(registered[district['map']]['path'])
+    max_x = max(d['worldRect'][2] for d in exterior_by_id.values()); max_y = max(d['worldRect'][3] for d in exterior_by_id.values())
+    require(min(d['worldRect'][0] for d in exterior_by_id.values()) == 0 and min(d['worldRect'][1] for d in exterior_by_id.values()) == 0, 'Baseline world must start at zero')
+    require((max_x, max_y) == (120, 120), 'Current baseline canvas changed; review schema consumers before replacing')
