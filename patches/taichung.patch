index 0000000..aff8b3e
--- /dev/null
+++ b/tools/taichung/gym_interiors/art_theater.py
@@ -0,0 +1,129 @@
+"""National Taichung Theater: the red Grand Theater (stage, curved red walls with acoustic dots,
+red curved-back seats, side aisles, no centre aisle) above the white Sound Cave lobby (curving walls,
+an hourglass passage through the red core, portholes, organic benches). Drawn as one picture with
+curved walls, then cut into tiles; a tile is walkable when its floor is."""
+from PIL import Image, ImageDraw
+import math, random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((48,32,40))
+RW0,RW1,RW2,RF=q((184,52,60)),q((224,104,104)),q((136,32,44)),q((88,16,28))   # red walls, dots, face, deep face
+CP0,CP1=q((112,28,40)),q((100,24,36))                                        # auditorium carpet
+WW0,WW1,WF0,WF1=q((244,240,232)),q((228,224,216)),q((216,212,204)),q((192,188,180))
+LF0,LF1=q((208,204,196)),q((196,192,184))                                     # lobby floor
+SG0,SG1,SG2=q((136,92,60)),q((112,72,48)),q((160,112,76))                     # stage boards
+SEAT0,SEAT1,SEAT2=q((216,64,64)),q((240,112,104)),q((152,32,44))
+TW,TH=23,15
+W,H=TW*16,TH*16
+
+def hall_half(y):
+    """half-width of the auditorium floor at pixel row y (ellipse)."""
+    cy,ry,rx=104,76,172
+    t=1-((y-cy)/ry)**2
+    return rx*math.sqrt(t) if t>0 else -1
+
+def build(lobby=False):
+    H=TH*16 if lobby else 12*16
+    floor_end=160 if lobby else 176
+    region=Image.new('L',(W,H),0)   # 0 wall/void, 1 red floor, 2 stage, 3 white floor
+    px=region.load()
+    for y in range(H):
+        for x in range(W):
+            v=0
+            if 16<=y<48 and 96<=x<272: v=2                       # stage floor (rows 1-2)
+            if y<16 and 96<=x<272: v=5                            # backdrop (drawn later)
+            if 48<=y<64 and 80<=x<288: v=4                        # stage front (drawn later)
+            if 64<=y<floor_end:
+                h=hall_half(y)
+                if h>0 and abs(x+0.5-184)<h: v=1
+            if lobby and 156<=y<196:                                       # hourglass passage, the red core
+                waist=14+abs(y-176)*0.9
+                if abs(x+0.5-184)<waist: v=1
+            if lobby and 160<=y<224:                                       # Sound Cave lobby: a hall with two round alcoves
+                for cx,cy,r in ((84,198,36),(284,198,36)):
+                    if (x-cx)**2+(y-cy)**2<r*r: v=3
+                if 40<=x<328 and 182<=y<224 and v==0: v=3
+            px[x,y]=v
+    im=Image.new('RGB',(W,H),(0,0,0)); d=ImageDraw.Draw(im); p=im.load(); r=random.Random(5)
+    # base textures
+    for y in range(H):
+        for x in range(W):
+            v=px[x,y]
+            if v==0:
+                core=abs(x+0.5-184)<34 and 150<=y<200
+                if not lobby and y>=176: c=(0,0,0)
+                elif y<160 or core or not lobby: c=RW1 if (x%8==2 and y%8==2) or (x%8==6 and y%8==6) else RW0
+                elif y<232: c=WW1 if (x*3+y*5)%11==0 and (x%8,y%8)!=(0,0) and False else (WW1 if (x%8==3 and y%8==5) else WW0)
+                else: c=(0,0,0)
+            elif v==1: c=CP1 if (x//4+y//4)%2==0 and (x%4==0) else CP0
+            elif v in (4,5): c=SG1
+            elif v==2: c=SG1 if y%4==3 else SG2 if (x%8==5 and y%4==1) else SG0
+            else: c=LF1 if (x%16==15 or y%16==15) else LF0
+            p[x,y]=c
+    walk=Image.new('L',(W,H),0); wp=walk.load()
+    for y in range(H):
+        for x in range(W):
+            if px[x,y] in (1,2,3): wp[x,y]=1
+    # vertical wall faces where floor sits below wall (3/4 view), and outlines
+    for x in range(W):
+        for y in range(1,H):
+            if px[x,y]!=0 and px[x,y-1]==0:
+                face=12 if y<176 else 10
+                for k in range(face):
+                    yy=y+k
+                    if yy>=H or px[x,yy]==0: break
+                    wp[x,yy]=0
+                    if y<160 or abs(x+0.5-184)<34: p[x,yy]=RF if k<3 else RW2
+                    else: p[x,yy]=WF1 if k<2 else WF0
+                p[x,y-1]=OUT
+    for y in range(H):
+        for x in range(1,W-1):
+            if px[x,y]!=0 and (px[x-1,y]==0 or px[x+1,y]==0): p[x,y]=OUT
+            if y+1<H and px[x,y]!=0 and px[x,y+1]==0: p[x,y]=OUT
+    # black void below the lobby
+    for y in range(224 if lobby else 176,H):
+        for x in range(W):
+            if px[x,y]==0: p[x,y]=(0,0,0)
+    d=ImageDraw.Draw(im)
+    # stage: backdrop with spot lights, velvet curtains, valance, front face with side steps
+    d.rectangle([96,0,271,15],fill=q((40,32,48)));
+    for x in (120,160,200,240): d.ellipse([x,3,x+5,7],fill=q((248,232,160)))
+    d.rectangle([80,0,287,3],fill=SEAT2)
+    for x0 in (80,256):
+        d.rectangle([x0,0,x0+31,40],fill=SEAT0);
+        for x in range(x0+2,x0+31,5): d.line([x,4,x,40],fill=SEAT2)
+        d.line([x0,0,x0,40],fill=OUT); d.line([x0+31,0,x0+31,40],fill=OUT); d.line([x0,40,x0+31,40],fill=OUT)
