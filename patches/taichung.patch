+static void DecompressGlyph_Taichung(u16 glyphId)
+{
+    u32 x, y;
+    u32 offset;
+    u8 color;
+    u8 bg = GetLastTextColor(2);
+    u8 fg = GetLastTextColor(0);
+    if (glyphId >= ARRAY_COUNT(sTaichungChineseGlyphs))
+        glyphId = 0;
+    memset(gGlyphInfo.pixels, bg | (bg << 4), sizeof(gGlyphInfo.pixels));
+    for (y = 0; y < 14; y++)
+    {
+        for (x = 0; x < 12; x++)
+        {
+            color = (sTaichungChineseGlyphs[glyphId][y] & (1 << x)) ? fg : bg;
+            offset = ((y / 8) * 2 + x / 8) * 32 + (y % 8) * 4 + (x % 8) / 2;
+            if (x & 1)
+                gGlyphInfo.pixels[offset] = (gGlyphInfo.pixels[offset] & 0x0F) | (color << 4);
+            else
+                gGlyphInfo.pixels[offset] = (gGlyphInfo.pixels[offset] & 0xF0) | color;
+        }
+    }
+    gGlyphInfo.width = 12;
+    gGlyphInfo.height = 14;
+}
