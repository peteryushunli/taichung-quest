+#!/usr/bin/env python3
+"""Mechanical, leaf-only city-fit variant; preserve all approved/source V1 files.
+
+Root requested a smaller left dormitory and a full metatile courtyard lane so
+the right edge avoids protected habitat. This utility never reads/writes a map.
+"""
+from collections import deque
+import json
+import struct
+
+from PIL import Image
+
+from encode_candidate import HERE, SOURCE, flip, sha
+from prepare_modules import occupied, patterns
+
+
+def main():
+    directory = HERE / "candidate"
+    preserved = {
+        "candidate-indexed.png": "ba31a65d88b7c4deb18a0bbc47c6ee901cef9ec0d501a2a4327f4607fc8d3ea9",
+        "modules/left.png": "36009f8b4587c55b5b375a2f8c6e56234577ba98830abdacf153fa8b4a1ba7a0",
+        "modules/right.png": "e789aee48cd30ae1e80f48ba3fc218582cdddc641aa634fbb4be38f7c4e167ec",
+        "nativecourtyard-layout-indexed.png": "e24aee233b35b4616ce16f5645050a6b1fee8ac2f5f266bba69f386b0ea4d398",
+    }
+    for name, expected in preserved.items():
+        assert sha(directory / name) == expected, name
+    assert sha(SOURCE) == "9236ecc4f1451b0e4a3da8a1dce8a0b8c994fafa5e9810e92d100888cd196b62"
+    left_source = Image.open(directory / "modules/left.png")
+    right = Image.open(directory / "modules/right.png")
+    palette = left_source.getpalette()
+    assert right.getpalette() == palette
+    assert left_source.convert("RGBA").getchannel("A").getbbox() == (0, 30, 70, 96)
+    left = Image.new("P", (64, 96))
+    left.putpalette(palette)
+    left.info["transparency"] = 0
+    # One bounded size transform: 70x66 -> 30x28 working -> 60x56.
+    # The 2x enlargement preserves the established two-native-pixel clusters.
+    resized = left_source.crop((0, 30, 70, 96)).resize((30, 28), Image.Resampling.NEAREST)
+    left.paste(resized.resize((60, 56), Image.Resampling.NEAREST), (4, 40))
+    layout = Image.new("P", (176, 96))
+    layout.putpalette(palette)
+    layout.info["transparency"] = 0
+    layout.paste(left, (0, 0))
+    layout.paste(right, (80, 0))
+    assert not layout.crop((64, 0, 80, 96)).getbbox()
+    assert layout.crop((80, 0, 176, 96)).tobytes() == right.tobytes()
+    # Tight, visually inspected entry ROI excludes the horizontal storey band
+    # at y80 and the building baseline at y94. This is a measurement only.
+    dark = {(x, y) for y in range(82, 94) for x in range(42, 58)
+            if (index := layout.getpixel((x, y))) and max(palette[index*3:index*3+3]) <= 112}
+    pending, frame = deque([(50, 90)]), set()
+    while pending:
+        point = pending.popleft()
+        if point in frame or point not in dark:
+            continue
+        frame.add(point)
+        x, y = point
+        pending.extend(((x-1, y), (x+1, y), (x, y-1), (x, y+1)))
+    frame_box = [min(x for x, _ in frame), min(y for _, y in frame),
+                 max(x for x, _ in frame), max(y for _, y in frame)]
+    panel = [frame_box[0]+2, frame_box[1]+2, frame_box[2]-2, frame_box[3]]
+    center = [(panel[0]+panel[2])/2, (panel[1]+panel[3])/2]
+    local = [int(value)//16 for value in center]
+    assert frame_box == [44, 82, 55, 93]
+    assert panel == [46, 84, 53, 93] and local == [3, 5]
+    left.save(directory / "modules/left-mapfit-v2.png")
+    layout_path = directory / "nativecourtyard-layout-v2-indexed.png"
+    layout.save(layout_path)
+    layout.convert("RGBA").resize((704, 384), Image.Resampling.NEAREST).save(
+        directory / "nativecourtyard-layout-v2-preview-4x.png")
+    graphics, lookup, tilemap = [], {}, []
+    for ty in range(12):
+        for tx in range(22):
+            pixels = tuple(layout.getpixel((tx*8+x, ty*8+y)) for y in range(8) for x in range(8))
+            canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tilemap.append(lookup[canonical] | flags | 0x9000)
+    raw = bytes(pixels[n] | pixels[n+1] << 4 for pixels in graphics for n in range(0, 64, 2))
+    (directory / "nativecourtyard-layout-v2-tiles.4bpp").write_bytes(raw)
+    (directory / "nativecourtyard-layout-v2-tilemap-relative.bin").write_bytes(struct.pack("<264H", *tilemap))
+    metatiles = [[tilemap[(my*2+y)*22+mx*2+x] for y in range(2) for x in range(2)]
+                 for my in range(6) for mx in range(11)]
+    (directory / "nativecourtyard-layout-v2-metatiles-relative.json").write_text(json.dumps(metatiles, indent=2)+"\n")
+    decoded = [tuple(value for byte in raw[n:n+32] for value in (byte & 15, byte >> 4))
+               for n in range(0, len(raw), 32)]
+    for y in range(96):
+        for x in range(176):
+            word = tilemap[y//8*22+x//8]
+            sx = 7-x%8 if word & 0x400 else x%8
+            sy = 7-y%8 if word & 0x800 else y%8
+            assert decoded[word & 1023][sy*8+sx] == layout.getpixel((x, y))
+            assert layout.getpixel((x, y)) == layout.getpixel((x//2*2, y//2*2))
+    rows = occupied(layout)
+    columns = sorted({7+x for row in rows for x, value in enumerate(row) if value == "1"})
+    assert columns == [7, 8, 9, 10, 12, 13, 14, 15, 16, 17]
+    assert len(graphics) == len(patterns(layout))
+    assert patterns(right) <= patterns(layout)
+    assert layout.getpalette() == palette and set(layout.convert("RGBA").getchannel("A").get_flattened_data()) == {0, 255}
+    for name, expected in preserved.items():
+        assert sha(directory / name) == expected, name
+    result = {
+        "schemaVersion": 1, "landmarkId": "shen-ji-new-village",
+        "status": "Root-requested city-fit V2; format checked; not installed",
+        "userArchitectureDirectionApproved": True,
+        "rootRequestedMechanicalLayout": True, "newArchitectureOrRedraw": False,
+        "files": {"indexed": layout_path.name, "palette": "09.pal", "leftModule": "modules/left-mapfit-v2.png",
+                  "rightModuleUnchanged": "modules/right.png", "preview": "nativecourtyard-layout-v2-preview-4x.png",
+                  "graphics4bpp": "nativecourtyard-layout-v2-tiles.4bpp",
+                  "foregroundTilemapRelative": "nativecourtyard-layout-v2-tilemap-relative.bin",
+                  "foregroundMetatilesRelative": "nativecourtyard-layout-v2-metatiles-relative.json"},
+        "inputSizePixels": [176, 96], "envelopeMetatiles": [11, 6], "paletteBankCandidate": 9,
+        "paletteExactAndTransparencyIndex0": True, "opaqueColorsUsed": len(set(layout.get_flattened_data())-{0}),
+        "leftTransform": {"source": "modules/left.png", "sourceCanvas": [80, 96],
+            "sourceCropExclusive": [0, 30, 70, 96], "workingSize": [30, 28], "fitSize": [60, 56],
+            "destinationCanvas": [64, 96], "destinationPixels": [4, 40], "resampling": "nearest in indexed space, no new colors",
+            "nativePixelCluster": 2, "aspectScaleXY": [60/70, 56/66],
+            "aspectRoundingRelativeDifference": abs((60/70)/(56/66)-1),
+            "opaqueInputPixels": sum(bool(v) for v in left_source.get_flattened_data()),
+            "opaqueOutputPixels": sum(bool(v) for v in left.get_flattened_data()),
+            "pixelCountsConserved": False, "everyOutputIndexNearestSampledFromSource": True,
+            "opaqueBoundingBoxExclusive": list(left.convert("RGBA").getchannel("A").getbbox())},
+        "rightTransform": {"source": "modules/right.png", "destinationPixels": [80, 0],
+            "pixelExact": True, "paletteExact": True, "sourcePixelTranslationFromOriginal160Canvas": [8, 0],
+            "graphicsPhase8Aligned": True},
+        "clearLanePixelsExclusive": [64, 0, 80, 96], "laneCompletelyTransparent": True,
+        "occupancyRows": rows, "solidMapColumnsFromAlphaOnly": columns, "artClearLaneMapColumn": 11,
+        "protectedMapColumn18HasNoInk": True,
+        "mapOriginFromRoot": [7, 39], "doorLocal": local, "doorGlobal": [10, 44],
+        "approach": [10, 45], "arrival": [10, 47],
+        "paintedDoorMeasurement": {"method": "maxRGB112 dark component at50,90 in inspected ROI x42..57,y82..93; excludes storey band/baseline; two-pixel side/top inset",
+            "frameBoxInclusive": frame_box, "panelBoxInclusive": panel, "centerPixels": center,
+            "localMetatile": local, "paintedPixelsAreNotAnActiveWarp": True},
+        "nativeFormat": {"unmergedUniqueGraphicsIncludingBlank": len(graphics),
+            "paddedSheetSlots": (len(graphics)+15)//16*16, "tilemapDimensions8x8": [22, 12],
+            "relativeGraphicIndices": True, "foregroundEnvelopeCells": 66,
+            "occupiedMetatiles": sum(row.count("1") for row in rows),
+            "distinctForegroundDefinitionsIncludingEmpty": len({tuple(group) for group in metatiles}),
+            "roundTripPixels": 176*96, "tilemapRoundTripPass": True, "uniform2PixelClusters": True,
+            "binaryAlpha": True, "allIndicesFit4bpp": max(layout.get_flattened_data()) < 16,
+            "rightGraphicPatternsAllPreserved": True,
+            "newPatternsVersusV1": len(patterns(layout)-patterns(Image.open(directory / "candidate-indexed.png")))},
+        "preservedSourceFilesSha256": preserved, "allPreservedSourceFilesUnchanged": True,
+        "originalStudySha256": sha(SOURCE), "originalStudyUnchanged": True,
+        "jointGreenwayBudgetCheckedByThisUtility": False, "jointGreenwayUsableGraphics": 376,
+        "gameWalkabilityVerified": False, "restoreOldPlaceholderUnderLaneRequired": True,
+        "mapInstalled": False, "nativeReady": False, "sha256": sha(layout_path),
+    }
+    (directory / "nativecourtyard-layout-v2.json").write_text(json.dumps(result, indent=2)+"\n")
+    print(json.dumps({"png": str(layout_path), "door": result["paintedDoorMeasurement"],
+                      "format": result["nativeFormat"], "sha256": result["sha256"]}, indent=2))
+    return result
+
+
+if __name__ == "__main__":
+    main()
