+                    '\t.string "Our city league is preparing\\n"','\t.string "this hall for future challenges.$"','']
+    (ROOT/'data/scripts/taichung_city.inc').write_text('\n'.join(scripts))
+    print(f'Authored {len(DISTRICTS)} native districts and {len(LANDMARKS)} paired landmark rooms.')
+
+
+if __name__=='__main__':
+    build()
