+      'oldMapSha256':digest(packed(sc['old'])),'newMapSha256':digest(packed(sc['grid'])),
+      'allowedChangedCells':[list(p) for p in sorted(sc['allowed'])],
+      'newlyBlockedCells':[[i%w,i//w] for i,(a,b) in enumerate(zip(sc['old'],sc['grid'])) if not(a&0xC00) and b&0xC00]}
