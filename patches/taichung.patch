+
+static EWRAM_DATA struct
+{
+    u32 sequence;
+    u8 site, phase, balls, result;
+    bool8 captureRecorded;
+} sEncounter = {0, TAICHUNG_ENCOUNTER_NONE, TAICHUNG_ENCOUNTER_PHASE_IDLE, 0, 0, FALSE};
+
+static u16 Saved(u16 var)
+{
+    return gSaveBlock1Ptr == NULL ? 0 : gSaveBlock1Ptr->vars[var - VARS_START];
+}
+
+static u16 ExtraBit(u16 low)
+{
+    return low == TAICHUNG_ENCOUNTER_ATTEMPT_VAR
+        ? TAICHUNG_ENCOUNTER_EXTRA_ATTEMPT_BIT : TAICHUNG_ENCOUNTER_EXTRA_UNLOCK_BIT;
+}
+
+static u32 SavedMask(u16 low, u16 upper)
+{
+    return (Saved(low) & TAICHUNG_ENCOUNTER_SAVE_LOW_MASK)
+        | ((u32)Saved(upper) << TAICHUNG_ENCOUNTER_SAVE_LOW_BITS)
+        | ((Saved(TAICHUNG_ENCOUNTER_EXTRA_VAR) & ExtraBit(low)) ? (1u << 26) : 0);
+}
+
+static bool8 SetSiteBit(u16 low, u16 upper, u16 site)
+{
+    if (site < TAICHUNG_ENCOUNTER_SAVE_LOW_BITS)
+        return VarSet(low, Saved(low) | (1u << site));
+    if (site < 26)
+        return VarSet(upper, Saved(upper) | (1u << (site - TAICHUNG_ENCOUNTER_SAVE_LOW_BITS)));
+    if (site == 26)
+        return VarSet(TAICHUNG_ENCOUNTER_EXTRA_VAR, Saved(TAICHUNG_ENCOUNTER_EXTRA_VAR) | ExtraBit(low));
+    return FALSE;
+}
+
+static void NextSequence(void)
+{
+    if (++sEncounter.sequence == 0)
+        sEncounter.sequence = 1;
+}
+
+const struct TaichungEncounterSite *TaichungEncounterGetSite(u16 site)
+{
+    return site < TAICHUNG_ENCOUNTER_COUNT ? &sSites[site] : NULL;
+}
+
+u8 TaichungEncounterSiteForSpecies(u16 species)
+{
+    u8 i;
+    for (i = 0; i < TAICHUNG_ENCOUNTER_COUNT; i++)
+        if (sSites[i].species == species)
+            return i;
+    return TAICHUNG_ENCOUNTER_NONE;
+}
+
+bool8 TaichungEncounterSiteAvailable(u16 site)
+{
+    return site < TAICHUNG_ENCOUNTER_COUNT && !(TAICHUNG_ENCOUNTER_RETIRED_MASK & (1u << site));
+}
+
+bool8 TaichungEncounterStateReady(void)
+{
+    return gSaveBlock1Ptr != NULL && Saved(TAICHUNG_ENCOUNTER_SCHEMA_VAR) == TAICHUNG_ENCOUNTER_SCHEMA
+        && !(Saved(TAICHUNG_ENCOUNTER_EXTRA_VAR) & TAICHUNG_ENCOUNTER_EXTRA_RESERVED_MASK);
+}
+
+bool8 TaichungEncounterInitSaveState(void)
+{
+    u16 schema;
+    u16 upperMask;
+
+    if (TaichungEncounterStateReady())
+        return TRUE;
+    if (gSaveBlock1Ptr == NULL)
+        return FALSE;
+    schema = Saved(TAICHUNG_ENCOUNTER_SCHEMA_VAR);
+    if (schema != TAICHUNG_ENCOUNTER_SCHEMA_V1 && schema != TAICHUNG_ENCOUNTER_SCHEMA_V2
+        && (schema != 0 || Saved(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) || Saved(TAICHUNG_ENCOUNTER_UNLOCK_VAR)
+            || Saved(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) || Saved(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR)))
+        return FALSE;
+    // EC02 supported only IDs0..23: upper bits14/15 must never become
+    // starter history. EC01 keeps its existing original-ten-bit migration.
+    // Preserve raw low-word reserved bits and every historical species bit.
+    upperMask = schema == TAICHUNG_ENCOUNTER_SCHEMA_V2
+        ? (TAICHUNG_ENCOUNTER_V2_MASK >> TAICHUNG_ENCOUNTER_SAVE_LOW_BITS) : 0;
+    return VarSet(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR, Saved(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) & upperMask)
+        && VarSet(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR, Saved(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) & upperMask)
+        && VarSet(TAICHUNG_ENCOUNTER_EXTRA_VAR, 0)
+        && VarSet(TAICHUNG_ENCOUNTER_SCHEMA_VAR, TAICHUNG_ENCOUNTER_SCHEMA)
+        && TaichungEncounterStateReady();
+}
+
+u32 TaichungEncounterGetAttemptMask(void)
+{
+    return TaichungEncounterStateReady()
+        ? SavedMask(TAICHUNG_ENCOUNTER_ATTEMPT_VAR, TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) : 0;
+}
+
+u32 TaichungEncounterGetUnlockMask(void)
+{
+    return TaichungEncounterStateReady()
+        ? SavedMask(TAICHUNG_ENCOUNTER_UNLOCK_VAR, TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) & TaichungEncounterGetAttemptMask() : 0;
+}
+
+bool8 TaichungEncounterWasAttempted(u16 site)
+{
+    return site < TAICHUNG_ENCOUNTER_COUNT && (TaichungEncounterGetAttemptMask() & (1 << site)) != 0;
+}
+
+bool8 TaichungEncounterSpeciesSelectable(u16 species)
+{
+    u8 site;
+    if (species < SPECIES_BULBASAUR || species > SPECIES_MEWTWO)
+        return FALSE;
+    site = TaichungEncounterSiteForSpecies(species);
+    return !TaichungEncounterSiteAvailable(site) || (TaichungEncounterGetUnlockMask() & (1u << site)) != 0;
+}
+
+bool8 TaichungEncounterBegin(u16 site)
+{
+    if (!TaichungEncounterSiteAvailable(site) || !TaichungEncounterStateReady()
+     || (sEncounter.phase != TAICHUNG_ENCOUNTER_PHASE_IDLE && sEncounter.phase != TAICHUNG_ENCOUNTER_PHASE_DONE)
+     || TaichungEncounterWasAttempted(site))
+        return FALSE;
+    if (!SetSiteBit(TAICHUNG_ENCOUNTER_ATTEMPT_VAR, TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR, site)
+     || !TaichungEncounterWasAttempted(site))
+        return FALSE;
+    sEncounter.site = site;
+    sEncounter.balls = TAICHUNG_ENCOUNTER_BALLS;
+    sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_NONE;
+    sEncounter.captureRecorded = FALSE;
+    sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN;
+    NextSequence();
+    return TRUE;
+}
+
+bool8 TaichungEncounterAcknowledge(u32 sequence, u32 attempts, u32 unlocks)
+{
+    if (!sequence || sequence != sEncounter.sequence || !TaichungEncounterWasAttempted(sEncounter.site)
+     || attempts != TaichungEncounterGetAttemptMask() || unlocks != TaichungEncounterGetUnlockMask())
+        return FALSE;
+    if (sEncounter.phase == TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN)
+        sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_ARMED;
+    else if (sEncounter.phase == TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT)
+        sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_DONE;
+    else
+        return FALSE;
+    return TRUE;
+}
+
+bool8 TaichungEncounterOnBattleStart(u16 species, u8 level)
+{
+    const struct TaichungEncounterSite *site = TaichungEncounterGetSite(sEncounter.site);
+    if (site == NULL || sEncounter.phase != TAICHUNG_ENCOUNTER_PHASE_ARMED
+     || species != site->species || level != site->level || !TaichungEncounterWasAttempted(sEncounter.site))
+        return FALSE;
+    sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_BATTLE;
+    return TRUE;
+}
+
+bool8 TaichungEncounterIsActive(void)
+{
+    return sEncounter.phase == TAICHUNG_ENCOUNTER_PHASE_BATTLE;
+}
+
+bool8 TaichungEncounterTakeBall(void)
+{
+    if (!TaichungEncounterIsActive() || sEncounter.balls == 0 || sEncounter.captureRecorded)
+        return FALSE;
+    --sEncounter.balls;
+    return TRUE;
+}
+
+bool8 TaichungEncounterRecordCapture(u16 species)
+{
+    if (!TaichungEncounterIsActive() || sEncounter.captureRecorded
+     || sEncounter.balls == TAICHUNG_ENCOUNTER_BALLS || sSites[sEncounter.site].species != species)
+        return FALSE;
+    sEncounter.captureRecorded = TRUE;
+    return TRUE;
+}
+
+bool8 TaichungEncounterOnBattleEnd(u16 species, u8 outcome)
+{
+    if (!TaichungEncounterIsActive())
+        return FALSE;
+    sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_INTERRUPTED;
+    if (sSites[sEncounter.site].species == species)
+    {
+        switch (outcome)
+        {
+        case B_OUTCOME_CAUGHT:
+            if (sEncounter.captureRecorded
+             && SetSiteBit(TAICHUNG_ENCOUNTER_UNLOCK_VAR, TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR, sEncounter.site)
+             && (TaichungEncounterGetUnlockMask() & (1 << sEncounter.site)))
+                sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_CAUGHT;
+            break;
+        case B_OUTCOME_WON:
+            sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_KO;
+            break;
+        case B_OUTCOME_LOST:
+            sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_LOST;
+            break;
+        case B_OUTCOME_RAN:
+        case B_OUTCOME_PLAYER_TELEPORTED:
+            sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_RAN;
+            break;
+        case B_OUTCOME_NO_SAFARI_BALLS:
+            if (sEncounter.balls == 0)
+                sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_EXHAUSTED;
+            break;
+        }
+    }
+    sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT;
+    NextSequence();
+    return TRUE;
+}
+
+void TaichungEncounterStorageFailed(void)
+{
+    if (sEncounter.phase == TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN || sEncounter.phase == TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT)
+    {
+        sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_ERROR;
+        sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_STORAGE_ERROR;
+    }
+}
+
+void TaichungEncounterResetSession(void)
+{
+    sEncounter.site = TAICHUNG_ENCOUNTER_NONE;
+    sEncounter.phase = TAICHUNG_ENCOUNTER_PHASE_IDLE;
+    sEncounter.balls = 0;
+    sEncounter.result = TAICHUNG_ENCOUNTER_RESULT_NONE;
+    sEncounter.captureRecorded = FALSE;
+    // Keep request sequence monotonic across native Continue/reset callbacks.
+}
+
+u8 TaichungEncounterGetPhase(void) { return sEncounter.phase; }
+u8 TaichungEncounterGetResult(void) { return sEncounter.result; }
+u8 TaichungEncounterGetCurrentSite(void) { return sEncounter.site; }
+u8 TaichungEncounterGetBalls(void) { return sEncounter.balls; }
+u32 TaichungEncounterGetSequence(void) { return sEncounter.sequence; }
