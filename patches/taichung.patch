+#!/usr/bin/env python3
+"""Check the built Greenway, Old City and Old City North against the approved drafts and plan.
+
+Reads the map.bins, tilesets and map.jsons in the working tree (as `build_rework.py` wrote them)
+and compares them with the draft grids, which the builder rebuilds from the same code:
+
+1. the rebuilt draft paints the approved `drafts/greenway.png` and `oldcity.png` pixel for pixel,
+   so the builder starts from what the user approved (`--write-drafts` repaints them);
+2. every built cell holds what its draft class asks for. Where the draft shows real tiles (kept
+   live art, landmarks, kiosks and stalls), the built cell renders the same pixels. Trees the
+   draft marks in a single cell are shrubs, and lot cells a style does not cover are hedges:
+   both count as the same family. Anything else is a difference, explained or not;
+3. every cell a neighbour draws through a connection renders the same with the neighbour's
+   tilesets as with the map's own;
+4. every built cell holds what `plan-cells.txt` draws there, by kind: streets, water, parks
+   and paths, lots. Landmark cells ('L') are the landmarks' own.
+
+Writes 16 px/tile renders of the built maps, a draft diff overlay and a plan diff overlay of
+each to the output folder (red: unexplained, blue: explained), plus `oldcity-greenway-diff.json`.
+
+  python3 tools/taichung/rework/verify_rework.py [--drafts DIR] [--out DIR] [--write-drafts]
+"""
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import build_rework as br  # noqa: E402
+import oldcity_greenway_draft as draft  # noqa: E402
+
+ROOT, native, TILE = br.ROOT, br.native, draft.TILE
+ARTIFACTS = Path("/Users/peter/devday_hackathon/artifacts/city-rework")
+OUT_NAMES = {"TaichungGreenway": "greenway", "TaichungOldCity": "oldcity", "TaichungOldCityNorth": "oldcity-north"}
+NEIGHBOURS = {"MAP_TAICHUNG_XITUN": "xitun", "MAP_TAICHUNG_NANTUN_NORTH": "north", "MAP_TAICHUNG_NANTUN_WANHE": "wanhe",
+              "MAP_TAICHUNG_GREENWAY": "greenway", "MAP_TAICHUNG_OLD_CITY_NORTH": "oldcity_north",
+              "MAP_TAICHUNG_OLD_CITY": "oldcity"}
+MIRROR = {"left": "right", "right": "left", "up": "down", "down": "up"}
+
+
+def layouts():
+    return {l["id"]: l for l in json.loads((ROOT / "data/layouts/layouts.json").read_text())["layouts"] if "id" in l}
+
+
+def map_layout(name):
+    return json.loads((ROOT / f"data/maps/{name}/map.json").read_text())["layout"]
+
+
+class Rendered:
+    """Metatile renders per tileset pair, cached."""
+
+    def __init__(self):
+        self.cache = {}
+
+    def __call__(self, primary, secondary):
+        key = (primary, secondary)
+        if key not in self.cache:
+            self.cache[key] = [np.asarray(t) for t in native.render_metatiles(ROOT, primary, secondary)]
+        return self.cache[key]
+
+
+def wall_pieces(b):
+    """The retaining wall's face and its culvert arch."""
+    return {m for n, m in b.kit.items() if n.startswith(("wall-n-", "wall-culvert-"))}
+
+
+SIDES = {"n": (0, -1), "s": (0, 1), "w": (-1, 0), "e": (1, 0)}
+ROAD = {"asp", "line_h", "line_v", "xwalk_h", "xwalk_v"}
+CORNERS = {"nw": (-1, -1), "ne": (1, -1), "sw": (-1, 1), "se": (1, 1)}
+
+
+def edge_pieces(b, g, x, y):
+    """The kit edges a cell should carry, worked out apart from the builder: bollards toward
+    the street's asphalt on a kerb, a railing toward the water on a walk beside it, and an
+    inner corner toward the one diagonal where a canal ends in open water beside a crossing walk."""
+    out = []
+    if (x, y) in g.kerbs:
+        out += [b.kit[f"st-bollards-{d}"] for d, (dx, dy) in SIDES.items() if g.get(x + dx, y + dy) in ROAD]
+    if (x, y) in g.railings:
+        sides = "".join(d for d, (dx, dy) in SIDES.items() if b.plan["cells"].get((x + g.ox + dx, y + g.oy + dy)) == "~")
+        out.append(b.kit[f"st-rail-{sides}"])
+    if (x, y) in g.rail_corners:
+        corner = "".join(d for d, (dx, dy) in CORNERS.items() if b.plan["cells"].get((x + g.ox + dx, y + g.oy + dy)) == "~")
+        out.append(b.kit[f"st-rail-inner-{corner}"])
+    return out
+
+
+def with_edges(tiles, base, pieces):
+    """The paving's pixels with each kit edge drawn over them (where it differs from the
+    sidewalk the kit draws it on)."""
+    want = tiles[base].copy()
+    for m in pieces:
+        mask = (tiles[m] != tiles[br.SIDEWALK]).any(axis=-1)
+        want[mask] = tiles[m][mask]
+    return want
+
+
+def expected(b, g, kit_names):
+    """Draft class -> metatile IDs that satisfy it, and the family IDs that stand in for it."""
+    k = lambda pred: {v for n, v in b.kit.items() if pred(n)}
+    old_city = g.name == "TaichungOldCity"
+    pavers = br.PAVERS if old_city else br.SIDEWALK
+    tree = {m for row in br.TREE for m in row}
+    styles = {m for s in (br.TOWNHOUSE, br.TEAL_PAIR) for row in s for m in row}
+    firered = {m for s in (br.FIRERED_HOUSE, br.FIRERED_HOUSE_4) for row in s for m in row}
+    still = k(lambda n: n.startswith("wa-still-"))
+    flowing = k(lambda n: n.startswith("wa-") and not n.startswith("wa-still-"))
+    exact = {
+        "hwy": k(lambda n: n.startswith("hw-ew-")),
+        "riv": flowing, "can": flowing, "lake": still,
+        "asp": {b.kit["st-asphalt"]},
+        "line_h": {b.kit["st-ew-centre"]},
+        "line_v": {b.kit["st-ns-centre"]},
+        "xwalk_h": {b.kit["st-ew-crosswalk"]}, "xwalk_v": {b.kit["st-ns-crosswalk"]},
+        "side": {br.SIDEWALK} | k(lambda n: n.startswith("br-")),
+        "wall": {b.kit["wall-n-upper"], b.kit["wall-n-lower"]}, "culvert": k(lambda n: n.startswith("wall-culvert-")),
+        "walk": {br.SIDEWALK}, "pave": {pavers}, "yard": {br.PAVERS if old_city else br.GRASS},
+        "grass": {br.GRASS}, "tall": {br.TALL}, "flower": {br.FLOWER}, "shrub": {br.SHRUB},
+        "tree": tree, "bldg": styles, "bldgc": firered, "pbridge": k(lambda n: n.startswith("pb-ew")),
+    }
+    family = {"tree": {br.SHRUB}, "bldg": {br.SHRUB}, "bldgc": {br.SHRUB}}
+    return exact, family
+
+
+def classify_cells(b, g, name, rows, words, tiles, draft_tiles, reference, seam_hedges):
+    """Per cell of one built map: ('ok' | 'family' | 'explained' | 'diff', note). Secondary
+    metatiles outside the new landmarks must also render as they do in the base tileset
+    (`reference`), so a landmark's tiles cannot have landed on a slot something else draws."""
+    exact, family = expected(b, g, None)
+    signs = {(x, y): label for label, (x, y), _ in br.place_signs(b.oc)} if g is b.oc else {}
+    hedges = seam_hedges.get(g.name, {})
+    r0 = rows[0]
+    out = {}
+    for y in range(rows[0], rows[1]):
+        for x in range(g.w):
+            word = words[(y - r0) * g.w + x]
+            m = word & 0x3FF
+            cls = g.c[y][x]
+            pixels = tiles[m]
+            if (x, y) in hedges and cls in draft.FREE | {"tall"}:
+                out[(x, y - r0)] = ("explained", f"seam hedge on draft {cls}: faces {hedges[(x, y)]}")
+                continue
+            if (x, y) in signs:
+                ok = m == br.SIGNPOST
+                out[(x, y - r0)] = ("explained" if ok else "diff", f"{signs[(x, y)]} signpost on draft {cls}")
+                continue
+            if (x, y) in g.art:
+                ox, oy = g.art[(x, y)]
+                same = word == g.old[oy * g.old_w + ox] and np.array_equal(pixels, reference[m])
+                out[(x, y - r0)] = ("ok" if same else "diff", "live art" if same else f"live art: {word:#06x}")
+                continue
+            if (x, y) in draft_tiles:
+                same = np.array_equal(pixels, np.asarray(draft_tiles[(x, y)].convert("RGB")))
+                out[(x, y - r0)] = ("ok" if same else "diff", "real tiles" if same else f"{cls}: pixels differ from the draft")
+                continue
+            edges = edge_pieces(b, g, x, y)
+            if edges:
+                base = br.PAVERS if cls == "pave" and g is b.oc else br.SIDEWALK
+                ok = not word & 0xC00 and np.array_equal(pixels, with_edges(tiles, base, edges)) and \
+                    (m == edges[0] if base == br.SIDEWALK and len(edges) == 1 else m >= br.NUM_PRIMARY)
+                out[(x, y - r0)] = ("ok" if ok else "diff", f"{cls} with kit edges" if ok else f"{cls}: got {m:#05x} for kit edges")
+            elif m >= br.NUM_PRIMARY and not np.array_equal(pixels, reference[m]):
+                out[(x, y - r0)] = ("diff", f"{cls}: {m:#05x} renders differently from the base tileset")
+            elif m in exact.get(cls, ()):
+                out[(x, y - r0)] = ("ok", cls)
+            elif m in family.get(cls, ()):
+                out[(x, y - r0)] = ("family", f"{cls} -> shrub")
+            else:
+                out[(x, y - r0)] = ("diff", f"{cls}: got {m:#05x}")
+    return out
+
+
+# plan-cells.txt kinds, and the built metatiles each allows. Asphalt ('S') and sidewalk ('s')
+# are told apart, so a kerb is a sidewalk cell where a street stops.
+PLAN_KIND = {"S": "street", "s": "street", "H": "street", "W": "wall", "~": "water", "b": "water", "T": "park",
+             "t": "park", "g": "park", "G": "park", "p": "park", "f": "park", "h": "park", ".": "park", "P": "park",
+             "B": "lot"}
+
+
+def plan_cells(b, g, name, rows, words, tiles, signs, hedges):
+    """Per cell of one built map against plan-cells.txt: ('ok' | 'explained' | 'diff', kind, note).
+    A sidewalk, path or plaza cell with kit edges must draw as its paving under them."""
+    cells, kit = b.plan["cells"], b.kit
+    old_city = g.name == "TaichungOldCity"
+    pave = br.PAVERS if old_city else br.SIDEWALK
+    pieces = lambda pred: {v for n, v in kit.items() if pred(n)}
+    road = {kit[n] for n in ("st-asphalt", "st-ew-centre", "st-ns-centre", "st-ew-crosswalk", "st-ns-crosswalk")}
+    sidewalk = pieces(lambda n: n.startswith("br-")) | {br.SIDEWALK}
+    water = pieces(lambda n: n.startswith("wa-")) | set(range(0x1A0, 0x1B3))
+    allow = {"S": road, "s": sidewalk, "H": pieces(lambda n: n.startswith("hw-ew-")), "W": wall_pieces(b),
+             "~": water, "b": pieces(lambda n: n.startswith("pb-ew")),
+             "g": {br.GRASS}, "G": {br.TALL}, "p": {pave}, ".": {pave}, "P": {pave}, "f": {br.FLOWER}, "h": {br.SHRUB}}
+    r0, out = rows[0], {}
+    for y in range(rows[0], rows[1]):
+        for x in range(g.w):
+            ch = cells.get((x + g.ox, y + g.oy))
+            kind = PLAN_KIND.get(ch)
+            if kind is None:
+                continue
+            word = words[(y - r0) * g.w + x]
+            m, solid = word & 0x3FF, word & 0xC00
+            if (x, y) in g.tree_anchors or ch == "t":
+                ax, ay = next((x - dx, y - dy) for dx in (0, 1) for dy in (0, 1) if (x - dx, y - dy) in g.tree_anchors)
+                ok = m == br.TREE[y - ay][x - ax]
+            elif ch == "B":
+                ok = bool(solid)
+            elif ch in "sp.P" and edge_pieces(b, g, x, y):
+                base = br.SIDEWALK if ch == "s" else pave
+                ok = not solid and np.array_equal(tiles[m], with_edges(tiles, base, edge_pieces(b, g, x, y)))
+            else:
+                ok = m in allow[ch] and (bool(solid) if ch == "W" else ch in "~H" or ch == "h" or not solid or m in water)
+            if ok:
+                out[(x, y - r0)] = ("ok", kind, ch)
+            elif (x, y) in hedges:
+                out[(x, y - r0)] = ("explained", kind, f"'{ch}': seam hedge, faces {hedges[(x, y)]}")
+            elif (x, y) in signs:
+                out[(x, y - r0)] = ("explained", kind, f"'{ch}': {signs[(x, y)]}")
+            else:
+                out[(x, y - r0)] = ("diff", kind, f"'{ch}': got {m:#05x}{' solid' if solid else ''}")
+    return out
+
+
+def strip_cells(conn, me, viewer_size):
+    """Cells of `me` that the viewer draws through its connection back to `me`. `conn` is
+    `me`'s connection to the viewer; the viewer's own one is its mirror."""
+    w, h = me
+    vw, vh = viewer_size
+    vdir, voff = MIRROR[conn["direction"]], -conn["offset"]
+    if vdir in ("left", "right"):
+        cols = range(0, 8) if vdir == "right" else range(w - 7, w)
+        rows = range(max(0, -7 - voff), min(h, vh + 7 - voff))
+        return [(x, y) for y in rows for x in cols]
+    rows = range(0, 7) if vdir == "down" else range(h - 7, h)
+    cols = range(max(0, -7 - voff), min(w, vw + 8 - voff))
+    return [(x, y) for y in rows for x in cols]
+
+
+def verify(b, drafts=None, out=None, write_drafts=False):
+    """The report for builder `b` (grids built) against the working tree. `drafts`: a folder
+    holding the approved PNGs to compare with (`write_drafts`: repaint them first); `out`: a
+    folder for the renders."""
+    report = {"base": b.report["base"], "draftDigests": {}, "draftsMatchApproved": {}, "maps": {}, "strips": [], "plan": {}}
+
+    # 1. The builder's grids are the approved drafts: the same pixels, or the same digest.
+    for g, slug, layout_id in ((b.gw, "greenway", "LAYOUT_TAICHUNG_GREENWAY"), (b.oc, "oldcity", "LAYOUT_TAICHUNG_OLD_CITY")):
+        live = draft.render_layout(b.base, layout_id)
+        image = draft.paint(g, live, strips=False)
+        painted = np.asarray(image)
+        report["draftDigests"][slug] = hashlib.sha256(painted.tobytes()).hexdigest()
+        if drafts and write_drafts:
+            image.save(drafts / f"{slug}.png")
+        if drafts:
+            approved = np.asarray(Image.open(drafts / f"{slug}.png").convert("RGB"))
+            same = painted.shape == approved.shape and np.array_equal(painted, approved)
+            report["draftsMatchApproved"][slug] = same if same else int((painted != approved).any(axis=2).sum())
+
+    # 2. Cell by cell. A draft yard or lawn cell may be a shrub where it faces a solid cell
+    # across a seam between these maps (validate_city: open edges step onto open ground).
+    lay, render = layouts(), Rendered()
+    sizes = {}
+    built = {name: native.words(ROOT / lay[spec[2]]["blockdata_filepath"]) for name, spec in br.MAPS.items()}
+
+    def word(grid, x, y):
+        if grid == "gw":
+            return built["TaichungGreenway"][y * b.gw.w + x]
+        name, y = ("TaichungOldCityNorth", y) if y < b.oc.split else ("TaichungOldCity", y - b.oc.split)
+        return built[name][y * b.oc.w + x]
+
+    seam_hedges = {}
+    for a, c in b.seam_pairs():
+        for (ka, xa, ya), (kc, xc, yc) in ((a, c), (c, a)):
+            if word(ka, xa, ya) & 0x3FF == br.SHRUB and word(kc, xc, yc) & 0xC00:
+                grid = b.gw if ka == "gw" else b.oc
+                seam_hedges.setdefault(grid.name, {})[(xa, ya)] = f"{word(kc, xc, yc) & 0x3FF:#05x} across the seam"
+    for name, (_, _, layout_id, *_rest) in br.MAPS.items():
+        g, rows = b.rows(name)
+        layout = lay[layout_id]
+        assert (layout["width"], layout["height"]) == (g.w, rows[1] - rows[0]), name
+        words = native.words(ROOT / layout["blockdata_filepath"])
+        tiles = render(layout["primary_tileset"], layout["secondary_tileset"])
+        base_secondary = "gTileset_TaichungOldCore" if name == "TaichungOldCityNorth" else layout["secondary_tileset"]
+        reference = [np.asarray(t) for t in native.render_metatiles(b.base, layout["primary_tileset"], base_secondary)]
+        cells = classify_cells(b, g, name, rows, words, tiles, g.tiles, reference, seam_hedges)
+        signs = {(s["at"][0], s["at"][1]): f"{s['name']} sign" for s in g.signs}
+        signs |= {tuple(lm["sign"]["at"]): f"{lm['name']} sign" for lm in g.landmarks}
+        signs |= {(x, y): f"{label} signpost" for label, (x, y), _ in br.place_signs(b.oc)} if g is b.oc else {}
+        planned = plan_cells(b, g, name, rows, words, tiles, signs, seam_hedges.get(g.name, {}))
+        kinds = {}
+        for status, kind, _ in planned.values():
+            kinds.setdefault(kind, {}).setdefault(status, 0)
+            kinds[kind][status] += 1
+        plan_listed = [{"x": x, "y": y, "status": st, "kind": kind, "note": note}
+                       for (x, y), (st, kind, note) in sorted(planned.items(), key=lambda c: (c[0][1], c[0][0])) if st != "ok"]
+        report["plan"][name] = {"kinds": kinds, "differences": plan_listed}
+        sizes[name] = (g.w, rows[1] - rows[0])
+        counts, listed = {}, []
+        for (x, y), (status, note) in sorted(cells.items(), key=lambda c: (c[0][1], c[0][0])):
+            counts[status] = counts.get(status, 0) + 1
+            if status in ("diff", "explained"):
+                listed.append({"x": x, "y": y, "status": status, "note": note})
+        if out:
+            image = draft.render_layout(ROOT, layout_id)
+            image.save(out / f"{OUT_NAMES[name]}.png")
+            over = image.convert("RGBA")
+            d = ImageDraw.Draw(over)
+            for c in listed:
+                colour = "#ff2d2d" if c["status"] == "diff" else "#2d6bff"
+                d.rectangle((c["x"] * TILE, c["y"] * TILE, c["x"] * TILE + 15, c["y"] * TILE + 15), outline=colour, width=3)
+            over.convert("RGB").save(out / f"{OUT_NAMES[name]}-diff.png")
+            over = image.convert("RGBA")
+            d = ImageDraw.Draw(over)
+            for c in plan_listed:
+                colour = "#ff2d2d" if c["status"] == "diff" else "#2d6bff"
+                d.rectangle((c["x"] * TILE, c["y"] * TILE, c["x"] * TILE + 15, c["y"] * TILE + 15), outline=colour, width=3)
+            over.convert("RGB").save(out / f"{OUT_NAMES[name]}-plan-diff.png")
+        report["maps"][name] = {"size": sizes[name], "cells": counts, "differences": listed,
+                                "words": {"words": words, "tiles": tiles}}
+
+    # 3. Strips: every cell a neighbour draws renders the same with its tilesets.
+    plan = b.plan["districts"]
+    for name in br.MAPS:
+        m = json.loads((ROOT / f"data/maps/{name}/map.json").read_text())
+        own = report["maps"][name]["words"]
+        for conn in m["connections"]:
+            other = conn["map"]
+            other_name = "".join(p.capitalize() for p in other[4:].split("_"))
+            r = plan[NEIGHBOURS[other]]["plan"]
+            viewer = lay[map_layout(other_name)]
+            vt = render(viewer["primary_tileset"], viewer["secondary_tileset"])
+            bad = []
+            cells = strip_cells(conn, sizes[name], (r[2] - r[0], r[3] - r[1]))
+            for x, y in cells:
+                mt = own["words"][y * sizes[name][0] + x] & 0x3FF
+                if mt >= len(vt) or not np.array_equal(own["tiles"][mt], vt[mt]):
+                    bad.append([x, y, f"{mt:#05x}"])
+            report["strips"].append({"viewer": other_name, "draws": name, "direction": MIRROR[conn["direction"]],
+                                     "cells": len(cells), "renderDifferently": bad})
+    for v in report["maps"].values():
+        del v["words"]
+    report["allStripsRenderTheSame"] = all(not s["renderDifferently"] for s in report["strips"])
+    report["unexplained"] = {n: v["cells"].get("diff", 0) for n, v in report["maps"].items()}
+    report["planUnexplained"] = {n: sum(k.get("diff", 0) for k in v["kinds"].values()) for n, v in report["plan"].items()}
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--drafts", type=Path, default=ARTIFACTS / "drafts")
+    parser.add_argument("--out", type=Path, default=ARTIFACTS / "built")
+    parser.add_argument("--write-drafts", action="store_true", help="repaint the drafts from the builder's grids first")
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=True)
+    b = br.Builder()
+    b.grids()
+    report = verify(b, args.drafts, args.out, args.write_drafts)
+    (args.out / "oldcity-greenway-diff.json").write_text(json.dumps(report, indent=1) + "\n")
+    print(json.dumps({k: v for k, v in report.items() if k not in ("maps", "plan")} | {
+        "maps": {n: v["cells"] for n, v in report["maps"].items()},
+        "plan": {n: v["kinds"] for n, v in report["plan"].items()}}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
