+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def number(value):
+    return int(value, 0) if isinstance(value, str) and value.lower().startswith("0x") else int(value)
+
+
+def same_json_value(before, after):
+    # Preserve scalar types as well as values: JSON false/0 and 3/3.0 differ.
+    return json.dumps(before, sort_keys=True, separators=(",", ":")) == json.dumps(after, sort_keys=True, separators=(",", ":"))
+
+
+def matches_approved_xiaoyu_graphics(before, after, map_name):
+    """Permit only the independently approved named-guide Woman1 -> Xiaoyu cast.
+
+    Compare the complete map after reverting that one field. Actor identity,
+    index/order/count, coordinates, scripts, warps and every other field stay exact.
+    """
+    if same_json_value(before, after):
+        return True
+    local_id = {
+        "TaichungOldCity": "LOCALID_TAICHUNG_STATION_GUIDE",
+        "TaichungStationWelcome": "LOCALID_TAICHUNG_WELCOME_GUIDE",
+    }.get(map_name)
+    if local_id is None:
+        return False
+    old = before.get("object_events", [])
+    new = after.get("object_events", [])
+    if len(old) != len(new):
+        return False
+    old_indices = [i for i, obj in enumerate(old) if obj.get("local_id") == local_id]
+    new_indices = [i for i, obj in enumerate(new) if obj.get("local_id") == local_id]
+    if len(old_indices) != 1 or old_indices != new_indices:
+        return False
+    index = old_indices[0]
+    if old[index].get("graphics_id") != "OBJ_EVENT_GFX_WOMAN_1" or new[index].get("graphics_id") != "OBJ_EVENT_GFX_TAICHUNG_XIAOYU":
+        return False
+    restored = deepcopy(after)
+    restored["object_events"][index]["graphics_id"] = "OBJ_EVENT_GFX_WOMAN_1"
+    return same_json_value(before, restored)
