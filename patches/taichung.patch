+        f'<p>ROM: {html.escape(config["rom"]["name"])}; SHA-256 <code>{config["rom"]["sha256"]}</code>.</p>'
+    )
+    document = replace_once(document, '<p>Isolated feature ROM and fresh save. Use the in-game Save menu before reading the saved location.</p>', header)
+    document = replace_once(document, '<button id="read-location" disabled>Read saved location</button>',
+                            '<button id="read-location" disabled>Read saved location</button>\n<button id="read-navigation" disabled>Read navigation snapshot</button>')
+    document = replace_once(document, '<pre id="location">No saved location read.</pre>',
+                            '<pre id="location">No saved location read.</pre>\n<pre id="navigation">No navigation snapshot read. This button never writes emulator RAM.</pre>')
+    travel_ui = (
+        '<fieldset><legend>Private native travel timing</legend>'
+        '<label>Direction <select id="travel-direction"><option>Right</option><option>Left</option><option>Up</option><option>Down</option></select></label>'
+        '<label>Metatiles <input id="travel-tiles" type="number" min="2" max="12" value="6"></label>'
+        '<label>Compare <select id="travel-reference"><option value="6">Baseline: 6 frames/tile</option><option value="4">Candidate: 4 frames/tile</option><option value="3">Candidate: 3 frames/tile (5+5+6)</option><option value="0">No reference</option></select></label>'
+        '<button id="measure-travel" disabled>Measure native travel</button><button id="stop-travel" disabled>Stop and release</button>'
+        '<button id="download-travel" disabled>Download travel report</button>'
+        '<p>Choose a clear flat route while stationary. Normal direction input only; no emulator speed change. '
+        'Timing uses destination-coordinate changes across N−1 tile intervals, then verifies the released target stays stable. '
+        'Keep this tab foreground; map/context changes, skipped steps, obstacles and time limits abort.</p>'
+        '<p id="travel-status" role="status">No travel measurement started.</p>'
+        '<pre id="travel-result">No travel measurement recorded.</pre></fieldset>'
+        '<fieldset><legend>Private read-only movement inspection</legend>'
+        '<button id="read-movement" disabled>Inspect native movement</button>'
+        '<p>Requires all three exact-ROM symbol addresses. Reads Sprite stride 0x44 (pos1 +0x20, pos2 +0x24, data[4]/[5] +0x36/+0x38), '
+        'PlayerAvatar 0x20 and ObjectEvent 0x24 from include/sprite.h and include/global.fieldmap.h. '
+        'Travel reports then include at most 64 raw frame observations and start/end pixel displacement. '
+        'Double-copy checks reduce torn reads; navigation does not lock raw engine writes. A completed three-frame cursor of 3 is valid; '
+        'initialization resets to 0 before the first published cursor 1. Missing frames cannot prove 5+5+6.</p>'
+        '<pre id="movement-result">No raw movement read. Supply --sprites-address, --player-avatar-address and --object-events-address from the matching ELF.</pre></fieldset>'
+    )
+    document = replace_once(document, '<pre id="navigation">No navigation snapshot read. This button never writes emulator RAM.</pre>',
+                            '<pre id="navigation">No navigation snapshot read. This button never writes emulator RAM.</pre>\n' + travel_ui)
+    serialized = json.dumps(config, separators=(",", ":")).replace("<", "\\u003c")
+    document = replace_once(document, "  import createMgba from '/mgba.js';", f"  import createMgba from '/mgba.js';\n  const qaConfig = Object.freeze({serialized});")
+    document = replace_once(document, "      emulator.FS.writeFile(romPath, rom);", FIXTURE_JS + "      emulator.FS.writeFile(romPath, rom);")
+    document = replace_once(document, "      byId('read-location').disabled = false;", "      byId('read-location').disabled = false;\n      byId('read-navigation').disabled = false;\n      byId('measure-travel').disabled = false;\n      byId('read-movement').disabled = !qaConfig.movementInspection;")
+    document = replace_once(document, "      emulator.quickReload();", "      resetNavigationCache();\n      emulator.quickReload();")
+    document = replace_once(document, "</script>", NAVIGATION_JS + MOVEMENT_JS + TRAVEL_JS + "\n</script>")
+    return document.encode()
+
+
+def numeric_address(value):
+    address = int(value, 0)
+    if address % 4 or not 0x02000000 <= address <= 0x02040000 - 48:
+        raise argparse.ArgumentTypeError("navigation address must be four-byte aligned and fit 48 bytes in EWRAM")
+    return address
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rom", type=Path, required=True)
+    parser.add_argument("--runtime", type=Path, required=True, help="Pinned directory containing mgba.js and mgba.wasm with getTaichungHeapU8()")
+    parser.add_argument("--port", type=int, default=8790)
+    parser.add_argument("--save", type=Path, help="Explicit native SRAM fixture imported before loadGame; replaces only the selected isolated qaSave file")
+    parser.add_argument("--navigation-address", type=numeric_address)
+    parser.add_argument("--sprites-address", type=numeric_address, help="Exact-ROM gSprites ELF address (64 active entries, stride 0x44)")
+    parser.add_argument("--player-avatar-address", type=numeric_address, help="Exact-ROM gPlayerAvatar ELF address (0x20 bytes)")
+    parser.add_argument("--object-events-address", type=numeric_address, help="Exact-ROM gObjectEvents ELF address (16 entries, stride 0x24)")
+    args = parser.parse_args()
+    if not 0 <= args.port <= 65535:
+        parser.error("port must be 0–65535")
+    movement_addresses = [args.sprites_address, args.player_avatar_address, args.object_events_address]
+    if any(address is not None for address in movement_addresses) and not all(address is not None for address in movement_addresses):
+        parser.error("Raw movement inspection requires all three exact-ROM symbol addresses")
+    for address, length in zip(movement_addresses, (64 * 0x44, 0x20, 16 * 0x24)):
+        if address is not None and address + length > 0x02040000:
+            parser.error("Raw movement symbol range leaves EWRAM")
+    paths = [args.rom, args.runtime / "mgba.js", args.runtime / "mgba.wasm"] + ([args.save] if args.save else [])
+    for path in paths:
+        if not path.is_file():
+            parser.error(f"Missing input: {path}")
+    rom = args.rom.read_bytes()  # Freeze the explicitly selected ROM for this server instance.
+    fixture = args.save.read_bytes() if args.save else None
+    if fixture is not None and len(fixture) not in (0x20000, 0x20010):
+        parser.error("--save must be native 128 KiB SRAM with an optional 16-byte RTC trailer")
+    config = {
+        "rom": {"name": args.rom.name, "bytes": len(rom), "sha256": hashlib.sha256(rom).hexdigest()},
+        "fixture": {"name": args.save.name, "bytes": len(fixture), "sha256": hashlib.sha256(fixture).hexdigest()} if fixture is not None else None,
+        "navigationAddress": args.navigation_address,
+        "movementInspection": {"spritesAddress": args.sprites_address, "playerAvatarAddress": args.player_avatar_address,
+                               "objectEventsAddress": args.object_events_address} if args.sprites_address is not None else None,
+    }
+    try:
+        page = page_bytes(config)
+    except (OSError, ValueError) as error:
+        parser.error(str(error))
+    memory_routes = {"/": (page, "text/html; charset=utf-8"), "/qa.html": (page, "text/html; charset=utf-8"),
+                     "/mapping.gba": (rom, "application/octet-stream")}
+    if fixture is not None:
+        memory_routes["/fixture.sav"] = (fixture, "application/octet-stream")
+    file_routes = {"/mgba.js": (args.runtime / "mgba.js", "text/javascript; charset=utf-8"),
+                   "/mgba.wasm": (args.runtime / "mgba.wasm", "application/wasm")}
+
+    class Handler(BaseHTTPRequestHandler):
+        def end_headers(self):
+            self.send_header("Cross-Origin-Opener-Policy", "same-origin")
+            self.send_header("Cross-Origin-Embedder-Policy", "require-corp")
+            self.send_header("Cross-Origin-Resource-Policy", "same-origin")
+            self.send_header("Cache-Control", "no-store")
+            super().end_headers()
+
+        def do_GET(self):
+            self.serve(head=False)
+
+        def do_HEAD(self):
+            self.serve(head=True)
+
+        def serve(self, head):
+            path = urlsplit(self.path).path
+            if path in memory_routes:
+                data, mime = memory_routes[path]
+                self.send_response(200)
+                self.send_header("Content-Type", mime)
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                if not head:
+                    self.wfile.write(data)
+            elif path in file_routes:
+                source, mime = file_routes[path]
+                self.send_response(200)
+                self.send_header("Content-Type", mime)
+                self.send_header("Content-Length", str(source.stat().st_size))
+                self.end_headers()
+                if not head:
+                    with source.open("rb") as file:
+                        while chunk := file.read(1024 * 1024):
+                            self.wfile.write(chunk)
+            else:
+                self.send_error(404)
+
+    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
+    print(f"Private gameplay QA: http://127.0.0.1:{server.server_address[1]}/?qaSave=distinct-run-name", flush=True)
+    print(f"Frozen ROM SHA-256: {config['rom']['sha256']}; {len(rom)} bytes", flush=True)
+    print(f"Native SRAM fixture: {config['fixture'] or 'none'}; navigation address: {hex(args.navigation_address) if args.navigation_address is not None else 'discover one advancing native header'}", flush=True)
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung_gameplay/refresh-chinese-glyphs.py b/tools/taichung_gameplay/refresh-chinese-glyphs.py
new file mode 100644
index 00000000..227fe1e8
--- /dev/null
+++ b/tools/taichung_gameplay/refresh-chinese-glyphs.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Refresh shapes and append missing glyphs while preserving all FC19 indices.
+
+Never regenerates content, translations, menus, scripts or existing mappings.
+Dry-run by default. Uses the same provider as extend-chinese-glyphs.py.
+"""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+
+SPEC = importlib.util.spec_from_file_location('taichung_extend', Path(__file__).with_name('extend-chinese-glyphs.py'))
+EXTEND = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(EXTEND)
+glyph_records, load_font, sha256 = EXTEND.glyph_records, EXTEND.load_font, EXTEND.sha256
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument('--artifacts', type=Path, required=True)
+    parser.add_argument('--font', type=Path, help='Legacy Noto file only for older checkouts without a bitmap manifest')
+    parser.add_argument('--corpus', type=Path, help='Optional extra UTF8 corpus; only missing glyphs are consumed, never content generation')
+    parser.add_argument('--write', action='store_true')
+    args = parser.parse_args()
+    game = args.game.resolve()
+    cmap_path, header_path = game / 'charmap.txt', game / 'src/data/taichung_glyphs.h'
+    cmap, header = cmap_path.read_bytes(), header_path.read_bytes()
+    existing = EXTEND.parse_existing(cmap, header)
+    sources, characters = EXTEND.native_sources(game)
+    corpus = args.corpus.read_bytes() if args.corpus else None
+    if corpus is not None:
+        characters.update(filter(EXTEND.is_chinese, corpus.decode('utf8')))
+    missing = sorted(characters - set(existing['mappings']))
+    font = load_font(game, args.font)
+    records = glyph_records(font, [row['character'] for row in existing['rows']] + missing, 0)
+    additions = records[len(existing['rows']):]
+    new_cmap, _ = EXTEND.extend(cmap, header, existing, additions)
+    rows = ''.join('    {' + ', '.join(f'0x{x:03x}' for x in row['masks'])
+                   + f"}}, // {row['index']}: {row['character']}\n" for row in records)
+    new_header = ('// Generated by tools/taichung_gameplay/refresh-chinese-glyphs.py.\n'
+                  '// Taichung Native Bitmap12; source/licenses: assets/fonts/taichung-native-font.json\n'
+                  'static const u16 sTaichungChineseGlyphs[][14] = {\n' + rows + '};\n').encode('utf8')
+    candidate = EXTEND.parse_existing(new_cmap, new_header)
+    if not new_cmap.startswith(cmap) or any(candidate['mappings'].get(c) != value for c, value in existing['mappings'].items()):
+        raise ValueError('Refusing to alter any existing character encoding')
+    if [r['character'] for r in candidate['rows'][:len(existing['rows'])]] != [r['character'] for r in existing['rows']]:
+        raise ValueError('Refusing to renumber a released glyph')
+    changed = sum(a['masks'] != b['masks'] for a, b in zip(existing['rows'], candidate['rows']))
+    if args.write:
+        current_sources, _ = EXTEND.native_sources(game)
+        if current_sources != sources or cmap_path.read_bytes() != cmap or header_path.read_bytes() != header:
+            raise ValueError('Font/content inputs changed during preparation; rerun')
+        if args.corpus and args.corpus.read_bytes() != corpus:
+            raise ValueError('Extra corpus changed during preparation; rerun')
+        if new_cmap != cmap:
+            cmap_path.write_bytes(new_cmap)
+        if new_header != header:
+            header_path.write_bytes(new_header)
+    report = {'mode': 'write' if args.write else 'dry-run', 'game': str(game),
+              'existingGlyphCount': len(existing['rows']), 'addedGlyphCount': len(additions),
+              'glyphCount': len(records), 'changedExistingShapes': changed,
+              'allExistingMappingsAndIndicesUnchanged': True,
+              'originalCharmapBytesPreservedAsPrefix': True,
+              'fontSource': font.metadata,
+              'before': {'charmapSha256': sha256(cmap), 'headerSha256': sha256(header)},
+              'candidate': {'charmapSha256': sha256(new_cmap), 'headerSha256': sha256(new_header)},
+              'sourceSha256': {str(path.relative_to(game)): sha256(raw) for path, raw in sources.items()},
+              'additions': [{k: row[k] for k in ('character', 'index', 'encoding')} for row in additions],
+              'scope': 'Glyph shapes and append-only missing glyphs. No translation/menu/script/content writes.'}
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    output = args.artifacts / 'refresh-chinese-glyphs.json'
+    output.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({'mode': report['mode'], 'glyphCount': len(records),
+                      'changedShapes': changed, 'added': len(additions),
+                      'preservedAllIndices': True, 'report': str(output)}))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (OSError, ValueError, KeyError) as error:
+        raise SystemExit(str(error))
diff --git a/tools/taichung_gameplay/render-landmark-history.py b/tools/taichung_gameplay/render-landmark-history.py
new file mode 100644
index 00000000..3ecdbcf4
--- /dev/null
+++ b/tools/taichung_gameplay/render-landmark-history.py
@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+"""Render source-backed bilingual history records; check native page bounds.
+
+Only --write replaces the generated C data module. Source records, the existing
+charmap and font are never edited. Missing glyphs are reported for Main's final
+append-only union, not assigned or reserved by this tool.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+IDS = (
+    'old-taichung-station', 'taichung-park', 'miyahara',
+    'natural-science-museum', 'calligraphy-greenway', 'shen-ji-new-village',
+    'fine-arts-museum', 'fengjia-night-market', 'maple-garden', 'taichung-theater',
+    'wenchang-temple', 'wanhe-temple',
+)
+
+
+def render(game):
+    spec = importlib.util.spec_from_file_location('history_glyphs', game / 'tools/taichung_gameplay/extend-chinese-glyphs.py')
+    glyphs = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(glyphs)
+    before = [(game / path).read_bytes() for path in ('charmap.txt', 'src/data/taichung_glyphs.h')]
+    existing = glyphs.parse_existing(*before)
+    mapping = dict(existing['mappings'])
+    mapping["'"] = mapping['’']
+    font = glyphs.load_font(game)
+    widths = []
+    native_text = (game / 'src/text.c').read_text()
+    for name in ('Normal', 'Male', 'Female'):
+        body = re.search(r'sFont' + name + r'LatinGlyphWidths\[\]\s*=\s*\{(.*?)\};', native_text, re.S)[1]
+        body = re.sub(r'//[^\n]*|/\*.*?\*/', '', body, flags=re.S)
+        widths.append([int(value) for value in re.findall(r'\b\d+\b', body)])
+    output = ['// Generated by tools/taichung_gameplay/render-landmark-history.py.',
+              '// Source facts and citations: data/taichung/landmark-history/*.json.',
+              '#include "global.h"', '#include "taichung_landmark_history.h"', '']
+    snapshot = json.loads((game / 'docs/landmark-history-source-snapshot.json').read_text())
+    approved_hashes = {entry['path']:entry['sha256'] for entry in snapshot['entries']}
+    records, proof, missing, hashes = {}, [], set(), {}
+    displayed_ids = []
+    page_counts = dict(sign=0, tour=0, staff=0)
+    buffer_sizes = []
+    action_records = {}
+
+    def text(pages, record_id, locale):
+        assert isinstance(pages, list) and 1 <= len(pages) <= 3, record_id
+        for page in pages:
+            assert isinstance(page, list) and 1 <= len(page) <= 2, record_id
+            for line in page:
+                assert isinstance(line, str) and line and not any(c in line for c in ('\\', '"', '$', '{', '}', '\n', '\r')), (record_id, line)
+                width = 0
+                for char in line:
+                    if glyphs.is_chinese(char):
+                        width += 13
+                        if char not in mapping:
+                            assert any(font.render(char)), char
+                            missing.add(char)
+                    else:
+                        assert char in mapping and len(mapping[char]) == 1, (record_id, char)
+                        width += max(table[mapping[char][0]] for table in widths) + 1
+                assert width <= 198, (record_id, locale, width, line)
+                proof.append(dict(id=record_id, locale=locale, line=line, pixels=width))
+        return r'\p'.join(r'\n'.join(page) for page in pages)
+
+    for path in sorted((game / 'data/taichung/landmark-history').glob('*.json')):
+        raw = path.read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == approved_hashes[str(path.relative_to(game))], path
+        data = json.loads(raw)
+        landmark = data['landmarkId']
+        assert landmark in IDS and landmark not in records, landmark
+        index = IDS.index(landmark)
+        sources = {item['id']: item for item in data['sources']}
+        assert sources and all(item['url'].startswith('https://') and item['sourceType'].startswith('primary-') for item in sources.values())
+        for entry in [data['sign'], *data['facts'], *data.get('npcFacts', [])]:
+            assert entry['id'] and entry['sources'] and all(item in sources for item in entry['sources'])
+            if entry in data.get('npcFacts', []):
+                assert entry['speakerId'] and entry['factBoundary'], entry['id']
+            else:
+                assert entry['claimId'], entry['id']
+            displayed_ids.append(entry['id'])
+        for action in data['interactionText']:
+            if action['id'] in action_records:
+                assert action == action_records[action['id']], landmark
+            else:
+                action_records[action['id']] = action
+        # sourceFactReference/helperProposal are provenance metadata only.
+        # They are intentionally neither serialized nor counted for glyphs.
+        assert 1 <= len(data['facts']) <= 3
+        sign = data['sign']
+        tours = {locale: [page for fact in data['facts'] for page in fact[locale]] for locale in ('en', 'zh-TW')}
+        staff_facts = data.get('npcFacts', [])
+        assert bool(staff_facts) == (index < 10), landmark
+        if staff_facts:
+            assert len({entry['speakerId'] for entry in staff_facts}) == 1, landmark
+        staff = {locale: [page for fact in staff_facts for page in fact[locale]] for locale in ('en', 'zh-TW')}
+        names = []
+        for kind, entry in [('Sign', sign), ('Tour', tours), ('Staff', staff)]:
+            if kind == 'Staff' and not staff_facts:
+                names.extend(['NULL','NULL'])
+                continue
+            assert len(entry['en']) == len(entry['zh-TW']), (landmark,kind)
+            page_counts[kind.lower()] += len(entry['en'])
+            for locale, suffix in [('en', 'En'), ('zh-TW', 'Zh')]:
+                symbol = 'sHistory' + str(index) + kind + suffix
+                literal = text(entry[locale], landmark + '.' + kind.lower(), locale)
+                encoded_upper_bound = sum(4 if glyphs.is_chinese(char) else 1 for page in entry[locale] for line in page for char in line) + sum(len(page) - 1 for page in entry[locale]) + len(entry[locale])
+                assert encoded_upper_bound <= 1000, (landmark, kind)
+                buffer_sizes.append(dict(landmark=landmark,kind=kind,locale=locale,maxEncodedBytes=encoded_upper_bound))
+                output.append('static const u8 ' + symbol + '[] = _("' + literal + '");')
+                names.append(symbol)
+        records[landmark] = names
+        hashes[str(path.relative_to(game))] = hashlib.sha256(raw).hexdigest()
+    assert set(records) == set(IDS), 'History must cover exactly twelve installed landmarks'
+    # Validate the actual shared action/fallback literals too; these are UI text,
+    # not source-backed historical claims.
+    core = (game / 'src/taichung_landmark_history.c').read_text()
+    assert set(action_records) == {'landmark.action.challenge','landmark.action.about','landmark.action.leave'}
+    # Leaders now tell the history before their challenge question, so the
+    # handoff's About label stays in the frozen records but is never rendered.
+    assert 'gTaichungHistoryAbout' not in core
+    for stem in ('Challenge','Leave'):
+        entry = action_records['landmark.action.'+stem.lower()]
+        for locale, suffix in [('en','En'),('zh-TW','Zh')]:
+            literal = text(entry[locale],entry['id'],locale)
+            assert re.search(r'gTaichungHistory'+stem+suffix+r'\[\] = _\("'+re.escape(literal)+r'"\);',core)
+    for suffix,locale in [('En','en'),('Zh','zh-TW')]:
+        value = re.search(r'sUnavailable'+suffix+r'\[\] = _\("([^"\n]+)"\);',core)[1]
+        text([[value]],'history.unavailable',locale)
+    output.extend(['', 'const struct TaichungLandmarkHistory gTaichungLandmarkHistory[TAICHUNG_LANDMARK_HISTORY_COUNT] = {'])
+    for landmark in IDS:
+        if landmark in records:
+            a, b, c, d, e, f = records[landmark]
+            output.append('    [' + str(IDS.index(landmark)) + '] = {{' + a + ', ' + b + '}, {' + c + ', ' + d + '}, {' + e + ', ' + f + '}},')
+    output.extend(['};', ''])
+    assert before == [(game / path).read_bytes() for path in ('charmap.txt', 'src/data/taichung_glyphs.h')]
+    report = dict(landmarks=list(records), sourceSha256=hashes, existingGlyphCount=len(existing['rows']), missingGlyphs=sorted(missing),
+                  maxLinePixels=max(item['pixels'] for item in proof), safeLinePixels=198, lines=proof,
+                  displayedRecordIds=displayed_ids, pageCountsPerLocale=page_counts,
+                  bilingualMessageLiterals=len(buffer_sizes), buffers=buffer_sizes,
+                  maxEncodedMessageBytes=max(item["maxEncodedBytes"] for item in buffer_sizes),
+                  sourceFactReferenceDisplayed=False, provenanceMetadataRequestedGlyphs=False,
+                  fontAndCharmapUnchanged=True, progressOrSaveWrites=False, runtimeAcceptance=False)
+    return '\n'.join(output).encode(), report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=ROOT)
+    parser.add_argument('--artifacts', type=Path, required=True)
+    parser.add_argument('--write', action='store_true')
+    args = parser.parse_args()
+    game = args.game.resolve()
+    candidate, report = render(game)
+    dest = game / 'src/taichung_landmark_history_data.c'
+    if args.write:
+        dest.write_bytes(candidate)
+    else:
+        assert dest.read_bytes() == candidate, 'Generated history module differs; inspect sources and rerender explicitly'
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    report['mode'] = 'write' if args.write else 'check'
+    report['moduleSha256'] = hashlib.sha256(candidate).hexdigest()
+    (args.artifacts / 'native-history-review.json').write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({key: report[key] for key in ('mode', 'landmarks', 'maxLinePixels', 'missingGlyphs')}, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/taichung_gameplay/render-optional-story.py b/tools/taichung_gameplay/render-optional-story.py
new file mode 100644
index 00000000..5a6ca154
--- /dev/null
+++ b/tools/taichung_gameplay/render-optional-story.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Compile pinned Story packages into an independent optional native text table.
+
+Default: verify installed output. --write changes only the generated C data file.
+Never changes legacy history, scripts, glyph mappings, maps, source locks or saves.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+DATA = Path('data/taichung/optional-story')
+OUTPUT = Path('src/taichung_optional_story_data.c')
+BINDINGS = Path('data/scripts/taichung_optional_story_bindings.inc')
+
+
+def render(game):
+    spec = importlib.util.spec_from_file_location('optional_story_glyphs', game / 'tools/taichung_gameplay/extend-chinese-glyphs.py')
+    glyphs = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(glyphs)
+    existing = glyphs.parse_existing((game / 'charmap.txt').read_bytes(), (game / 'src/data/taichung_glyphs.h').read_bytes())
+    mapping = dict(existing['mappings'])
+    mapping["'"] = mapping['’']
+    font = glyphs.load_font(game)
+    widths = []
+    native_text = (game / 'src/text.c').read_text()
+    for name in ('Normal', 'Male', 'Female'):
+        body = re.search(r'sFont' + name + r'LatinGlyphWidths\[\]\s*=\s*\{(.*?)\};', native_text, re.S)[1]
+        body = re.sub(r'//[^\n]*|/\*.*?\*/', '', body, flags=re.S)
+        widths.append([int(value) for value in re.findall(r'\b\d+\b', body)])
+    manifest = json.loads((game / DATA / 'manifest.json').read_text())
+    assert manifest['schemaVersion'] == 1 and re.fullmatch(r'[0-9a-f]{40}', manifest['frontendSourceCommit'])
+    assert manifest['baselineNative'] == '586b8a84089b338b6c3971cc90604daa57fadb76'
+    output = ['// Generated by tools/taichung_gameplay/render-optional-story.py.',
+              '// Pinned packages/citations: data/taichung/optional-story/manifest.json.',
+              '#include "global.h"', '#include "taichung_optional_story.h"', '']
+    proof, missing, rows, seen_ids = [], set(), [], set()
+    bindings = ['@ Generated by render-optional-story.py from the explicit20-place manifest.',
+                '@ Signs show the full reading, then offer a capture at eligible sites.',
+                '@ They do not implement capture persistence, battles or saved progress.']
+    action_sites, leader_ids = set(), set()
+    pages_per_locale = 0
+
+    def text(pages, identity, locale):
+        assert isinstance(pages, list) and 1 <= len(pages) <= 8, identity
+        size = 1
+        for page in pages:
+            assert isinstance(page, list) and 1 <= len(page) <= 2, identity
+            for line in page:
+                assert isinstance(line, str) and line and not any(c in line for c in ('\\', '"', '$', '{', '}', '\n', '\r')), (identity, line)
+                width = 0
+                for char in line:
+                    if glyphs.is_chinese(char):
+                        width += 13
+                        size += 4
+                        if char not in mapping:
+                            assert any(font.render(char)), char
+                            missing.add(char)
+                    else:
+                        assert char in mapping and len(mapping[char]) == 1, (identity, char)
+                        width += max(table[mapping[char][0]] for table in widths) + 1
+                        size += 1
+                assert width <= 198, (identity, locale, width, line)
+                proof.append(dict(id=identity, locale=locale, line=line, pixels=width))
+            size += len(page) - 1
+        size += len(pages) - 1
+        assert size <= 1000, (identity, size)
+        return r'\p'.join(r'\n'.join(page) for page in pages)
+
+    for entry in sorted(manifest['records'], key=lambda row: row['historyId']):
+        assert re.fullmatch(r'[a-z0-9-]+\.json', entry['file'])
+        raw = (game / DATA / entry['file']).read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == entry['sha256'], entry['file']
+        record = json.loads(raw)
+        identity, history_id = entry['id'], entry['historyId']
+        assert record['schemaVersion'] == 1 and record['landmarkId'] == identity
+        assert type(history_id) is int and 0 <= history_id < 65535 and history_id not in seen_ids
+        assert record['nativeBinding'].get('nativeHistoryId', history_id) == history_id
+        assert record['baselineAudit']['nativeSource'] == manifest['baselineNative']
+        assert record['interaction']['historyAfterVictory'] and not record['interaction']['backStartsBattle']
+        seen_ids.add(history_id)
+        sources = {row['id'] for row in record['sources']}
+        assert sources and all(row['url'].startswith('https://') and row['type'] == 'primary government or venue' for row in record['sources'])
+        facts = {row['id'] for row in record['facts']}
+        assert all(row['sources'] and set(row['sources']) <= sources for row in record['facts'])
+        grouped = {surface: [row for row in record['texts'] if row['surface'] == surface] for surface in ('sign', 'guide', 'staff')}
+        assert len(grouped['sign']) == len(grouped['guide']) == 1 and 1 <= len(grouped['staff']) <= 2
+        assert all(len(grouped['sign'][0]['pages'][locale]) == 1 for locale in ('en', 'zh-TW')), 'Signs must stay short before the reading choice'
+        parts = [grouped['sign'][0], grouped['guide'][0], *grouped['staff']]
+        names = []
+        for kind, part in zip(('Sign', 'About', 'Staff', 'Garden'), parts):
+            assert part['factRefs'] and set(part['factRefs']) <= facts
+            assert len(part['pages']['en']) == len(part['pages']['zh-TW'])
+            pages_per_locale += len(part['pages']['en'])
+            for locale, suffix in (('en', 'En'), ('zh-TW', 'Zh')):
+                symbol = 'sOptionalStory' + str(history_id) + kind + suffix
+                output.append('static const u8 ' + symbol + '[] = _("' + text(part['pages'][locale], part['id'], locale) + '");')
+                names.append(symbol)
+        if len(parts) == 3:
+            names.extend(('NULL', 'NULL'))
+        for locale, suffix in (('en', 'En'), ('zh-TW', 'Zh')):
+            symbol = 'sOptionalStory' + str(history_id) + 'Credit' + suffix
+            output.append('static const u8 ' + symbol + '[] = _("' + text([[entry['staffCredit'][locale]]], identity + '.staff-credit', locale) + '");')
+            names.append(symbol)
+        api = entry.get('leaderQuestionApi')
+        leader_id = entry.get('leaderGymId', 0xFFFF)
+        if api:
+            assert re.fullmatch(r'TaichungGym_ScriptGet[A-Z][A-Za-z]+Message', api)
+            assert type(leader_id) is int and 0 <= leader_id < 10 and leader_id not in leader_ids
+            leader_ids.add(leader_id)
+            output.append('extern void ' + api + '(void);')
+        else:
+            assert leader_id == 0xFFFF
+        site = entry.get('encounterSite', 0xFF)
+        wrapper = entry.get('encounterWrapper')
+        if wrapper:
+            assert type(site) is int and 0 <= site < 10 and site not in action_sites
+            assert re.fullmatch(r'TaichungEncounter_[A-Z][A-Za-z]+', wrapper)
+            action_sites.add(site)
+        else:
+            assert site == 0xFF
+        rows.append('    {%d, %d, %d, {%s, %s}, {%s, %s}, {%s, %s}, {%s, %s}, {%s, %s}, %s},' % (history_id, leader_id, site, *names, api or 'NULL'))
+        sign_label = entry['signLabel']
+        assert re.fullmatch(r'TaichungCity_Sign_[A-Z][A-Za-z]+', sign_label)
+        declared = record['nativeBinding'].get('sign', record['nativeBinding'].get('existingSign', sign_label))
+        assert declared == sign_label
+        bindings += ['', 'TaichungStory_Sign' + str(history_id) + '::', '\tlockall',
+                     '\tgoto_if_questlog TaichungStory_SignDone',
+                     '\tsetvar VAR_0x8004, ' + str(history_id),
+                     '\tcallnative TaichungStory_ScriptHasPackage',
+                     '\tcallnative TaichungStory_ScriptBufferSign',
+                     '\tmsgbox gStringVar4, MSGBOX_SIGN', '\tlockall',
+                     '\tcall TaichungStory_ReadSignDetails']
+        # Wenchang's outside sign is informational; only its existing host may
+        # route to site1. Every other currently bound site uses its outside sign.
+        if wrapper and identity != 'wenchang-temple':
+            bindings += ['\tgoto ' + wrapper]
+        else:
+            bindings += ['\tgoto TaichungStory_SignDone']
+        output.append('')
+    # Audit actual action/fallback literals too. They use the same native fonts
+    # and do not count as additional historical pages.
+    core = (game / 'src/taichung_optional_story.c').read_text()
+    actions = re.findall(r'(\w+)\[\] = _\("([^"\\\n]*)"\);', core)
+    assert len(actions) == 14
+    for name, literal in actions:
+        text([[literal]], name, 'zh-TW' if name.endswith('Zh') else 'en')
+    output += ['const struct TaichungOptionalStory gTaichungOptionalStories[] = {', *rows, '};',
+               'const u16 gTaichungOptionalStoryCount = ARRAY_COUNT(gTaichungOptionalStories);', '']
+    assert seen_ids == set(range(20)) and leader_ids == set(range(10)) and action_sites == set(range(10))
+    bindings += ['', 'TaichungStory_SignDone::', '\tclosemessage', '\treleaseall', '\tend', '']
+    report = dict(packages=len(rows), pagesPerLocale=pages_per_locale,
+                  lines=proof, maxLinePixels=max(row['pixels'] for row in proof),
+                  missingGlyphs=''.join(sorted(missing)), sourceCommit=manifest['frontendSourceCommit'])
+    return {OUTPUT: ('\n'.join(output)).encode(), BINDINGS: ('\n'.join(bindings)).encode()}, report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=ROOT)
+    parser.add_argument('--write', action='store_true')
+    parser.add_argument('--report', type=Path)
+    args = parser.parse_args()
+    outputs, report = render(args.game)
+    for name, raw in outputs.items():
+        path = args.game / name
+        if args.write:
+            path.write_bytes(raw)
+        else:
+            assert path.read_bytes() == raw, ('Generated optional Story output is stale', str(name))
+    if args.report:
+        args.report.parent.mkdir(parents=True, exist_ok=True)
+        args.report.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in report.items() if k != 'lines'}, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
