diff --git a/tools/taichung_gameplay/test-existing-encounter-bindings.py b/tools/taichung_gameplay/test-existing-encounter-bindings.py
new file mode 100755
index 00000000..82edb041
--- /dev/null
+++ b/tools/taichung_gameplay/test-existing-encounter-bindings.py
@@ -0,0 +1,236 @@
+#!/usr/bin/env python3
+"""Validate existing-landmark dispatch and interpret the real shared scripts.
+
+This exercises source control flow, not a cartridge, battle or browser. Native
+calls are recorded at their boundary; no catch, persistent mask or save is faked.
+Only Begin may dispatch the existing save/battle sequence. No private Git needed.
+"""
+from pathlib import Path
+import argparse
+from collections import Counter
+import copy
+import json
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+SUFFIXES = ['MapleGarden', 'WenchangTemple', 'BotanicalGarden', 'ConfuciusTemple',
+            'YizhongStreet', 'PrefecturalHall', 'SecondMarket', 'CulturalHeritagePark',
+            'FengleSculpturePark', 'WenxinForestPark', 'LuceChapel', 'RainbowVillage',
+            'CityHall', 'JingmingStreet']
+SIGN_IDS = [0, 2, 3, 4, 5, 6, 7, 8, 9]
+HEADER = ROOT / 'include/constants/taichung_encounters.h'
+CONSTANTS = dict(re.findall(r'^#define (\w+) (0x[\dA-Fa-f]+|\d+)$', HEADER.read_text(), re.M))
+CONSTANTS.update(TRUE='1', FALSE='0', TAICHUNG_GYM_MAPLE_GARDEN='8')
+
+
+def labels(text):
+    result, current = {}, None
+    for line in text.splitlines():
+        line = line.split('@', 1)[0].strip()
+        match = re.fullmatch(r'(\w+)::?', line)
+        if match:
+            current = match[1]
+            assert current not in result, ('duplicate label', current)
+            result[current] = []
+        elif current and line and not line.startswith(('.', '#')):
+            result[current].append(line)
+    return result
+
+
+def program(city, encounter):
+    definition = re.search(r'\s*\.macro taichung_encounter_entry name, site\n(.*?)\.endm', encounter, re.S)
+    assert definition
+    invocations = re.findall(r'^\s*taichung_encounter_entry (\w+), (TAICHUNG_ENCOUNTER_\w+)$', encounter, re.M)
+    assert [suffix for suffix, _ in invocations] == SUFFIXES
+    assert [int(CONSTANTS[site], 0) for _, site in invocations] == list(range(14))
+    expanded = []
+    for suffix, site in invocations:
+        body = definition[1].replace(r'\name\()', suffix).replace(r'\site', site)
+        expanded.append(body)
+    common = encounter[:definition.start()]
+    parts = [city, common, *expanded, (ROOT / 'data/scripts/std_msgbox.inc').read_text()]
+    parsed = labels('\n'.join(parts))
+    names = list(parsed)
+    for i, name in enumerate(names[:-1]):
+        parsed[name].append('goto ' + names[i + 1])  # Actual native label fallthrough.
+    for instructions in labels(common).values():
+        for instruction in instructions:
+            op, _, args = instruction.partition(' ')
+            assert op not in ('setflag', 'clearflag', 'addvar', 'subvar'), instruction
+            if op in ('setvar', 'copyvar'):
+                assert args.split(',')[0] in ('VAR_0x8004', 'VAR_0x8007', 'VAR_RESULT'), instruction
+    return parsed
+
+
+def validate_bindings(city, encounter, spec, sites):
+    expected = {i: 'TaichungCity_Sign_' + SUFFIXES[i] for i in SIGN_IDS}
+    records = spec['signBindings']
+    assert len(records) == 9 and {r['stableSiteId']: r['signScript'] for r in records} == expected
+    blocks = labels(city)
+    wanted_calls = []
+    for row in records:
+        i = row['stableSiteId']; sign = expected[i]; target = 'TaichungEncounter_' + SUFFIXES[i]
+        assert row['entryScript'] == target
+        preserved = [f'msgbox TaichungCity_Text_{SUFFIXES[i]}, MSGBOX_SIGN']
+        if i == 0:
+            preserved = ['setvar VAR_0x8004, TAICHUNG_GYM_MAPLE_GARDEN',
+                         'callnative TaichungHistory_ScriptBufferSign', 'msgbox gStringVar4, MSGBOX_SIGN']
+        assert row['preservedCommands'] == preserved
+        assert blocks[sign] == preserved + ['goto ' + target], sign
+        wanted_calls.append((sign, target))
+    host = spec['existingHostBinding']
+    assert host == {'stableSiteId': 1, 'script': 'TaichungCity_Host_WenchangTemple',
+                    'entryScript': 'TaichungEncounter_WenchangTemple'}
+    wanted_calls.append(('TaichungCity_Host_WenchangTemple_HistoryDone', host['entryScript']))
+    actual_calls = [(label, command[5:]) for label, body in blocks.items() for command in body
+                    if command.startswith('goto TaichungEncounter_')]
+    assert Counter(actual_calls) == Counter(wanted_calls), actual_calls
+    assert spec['reservedUnboundSites'] == [10, 11, 12, 13]
+    indexed = {r['stableSiteId']: r for r in sites['sites']}
+    assert set(indexed) == set(range(14))
+    current = dict(expected); current[1] = host['script']
+    for i, row in indexed.items():
+        assert row['entryScript'] == 'TaichungEncounter_' + SUFFIXES[i]
+        assert row['currentBinding'] == current.get(i), i
+    return program(city, encounter)
+
+
+def run(parsed, entry, site, choices=(), replay=False, offered=True, begin=True, locale=1):
+    label, index, stack = entry, 0, []
+    saved = {'VAR_0x40F3': 0xEC01, 'VAR_0x40F4': 0x2AA, 'VAR_0x40F5': 2,
+             'VAR_0x40FA': 0x155, 'VAR_0x40FB': locale, 'VAR_0x40F8': 1, 'VAR_0x40F9': 2}
+    values = dict(saved, VAR_RESULT=0); selections = iter(choices)
+    events, messages = [], []
+    locked, pending_wait = False, None
+
+    def value(token):
+        if token in values: return values[token]
+        if token in CONSTANTS: return int(CONSTANTS[token], 0)
+        return int(token, 0) if re.fullmatch(r'0x[\dA-Fa-f]+|\d+', token) else token
+
+    for _ in range(350):
+        assert label in parsed, ('unresolved script', label)
+        instruction = parsed[label][index]; index += 1
+        op, _, args = instruction.partition(' ')
+        parts = [p.strip() for p in args.split(',')]
+        if op in ('setvar', 'copyvar'):
+            assert parts[0] in ('VAR_0x8004', 'VAR_0x8007', 'VAR_RESULT')
+            values[parts[0]] = value(parts[1])
+        elif op == 'lockall': locked = True
+        elif op == 'releaseall': locked = False
+        elif op == 'msgbox':
+            messages.append((parts[0], parts[1] if len(parts) > 1 else 'MSGBOX_DEFAULT'))
+            stack.append((label, index))
+            label = 'Std_MsgboxSign' if len(parts) > 1 and parts[1] == 'MSGBOX_SIGN' else 'Std_MsgboxDefault'
+            index = 0
+        elif op in ('message', 'waitmessage', 'waitbuttonpress', 'closemessage'):
+            assert locked, instruction
+        elif op == 'waitstate':
+            assert pending_wait is not None
+            events.append('wait:' + pending_wait); pending_wait = None
+        elif op == 'goto': label, index = args, 0
+        elif op == 'goto_if_questlog':
+            if replay: label, index = args, 0
+        elif op == 'goto_if_eq':
+            if value(parts[0]) == value(parts[1]): label, index = parts[2], 0
+        elif op == 'return': label, index = stack.pop()
+        elif op == 'multichoice':
+            assert locked and parts == ['0', '0', 'MULTICHOICE_TAICHUNG_ENCOUNTER', 'FALSE']
+            selected = next(selections)
+            assert selected in (0, 1, 2, 127)
+            values['VAR_RESULT'] = selected
+            events.append('choice:' + str(selected))
+        elif op == 'callnative':
+            if args == 'TaichungHistory_ScriptBufferSign':
+                assert site == 0 and value('VAR_0x8004') == 8
+                continue
+            assert value('VAR_0x8007') == site, ('wrong stable site', values)
+            name = args.removeprefix('TaichungEncounter_Script')
+            assert name in ('Offer', 'OpenTeam', 'Begin', 'SaveBegin', 'SaveResult', 'Result'), args
+            events.append(name)
+            if name == 'Offer': values['VAR_RESULT'] = int(not offered)
+            if name == 'OpenTeam': pending_wait = 'team'
+            if name == 'Begin': values['VAR_RESULT'] = int(begin)
+            if name == 'SaveBegin': pending_wait = 'save-begin'
+            if name == 'SaveResult': values['VAR_RESULT'] = 1; pending_wait = 'save-result'
+        elif op == 'end':
+            assert not locked and not stack and pending_wait is None
+            assert all(values[k] == v for k, v in saved.items())
+            return events, messages
+        else: raise AssertionError(('unexpected native script command', instruction))
+    raise AssertionError('Script did not terminate')
+
+
+def exercise(parsed):
+    cases = 0
+    for i in range(14):
+        entries = ['TaichungEncounter_' + SUFFIXES[i]]
+        if i in SIGN_IDS: entries.append('TaichungCity_Sign_' + SUFFIXES[i])
+        for entry in entries:
+            for locale in (1, 2):
+                for choices, expected in [([2], ['Offer', 'choice:2']), ([127], ['Offer', 'choice:127']),
+                    ([0, 2], ['Offer', 'choice:0', 'OpenTeam', 'wait:team', 'Offer', 'choice:2']),
+                    ([1], ['Offer', 'choice:1', 'Begin', 'SaveBegin', 'wait:save-begin', 'SaveResult', 'wait:save-result', 'Result'])]:
+                    events, messages = run(parsed, entry, i, choices, locale=locale)
+                    assert events == expected, (entry, events)
+                    if entry.startswith('TaichungCity_'): assert messages[0][1] == 'MSGBOX_SIGN'
+                    cases += 1
+                assert run(parsed, entry, i, replay=True, locale=locale)[0] == []
+                assert run(parsed, entry, i, offered=False, locale=locale)[0] == ['Offer']
+                assert run(parsed, entry, i, [1], begin=False, locale=locale)[0] == ['Offer', 'choice:1', 'Begin']
+                cases += 3
+    return cases
+
+
+def check_native_references(spec):
+    groups = json.loads((ROOT / 'data/maps/map_groups.json').read_text())
+    names = [name for value in groups.values() if isinstance(value, list) for name in value if isinstance(name, str)]
+    references = Counter()
+    for name in names:
+        path = ROOT / 'data/maps' / name / 'map.json'
+        if path.exists():
+            for event in json.loads(path.read_text()).get('bg_events', []):
+                if event.get('type') == 'sign': references[event['script']] += 1
+    for row in spec['signBindings']: assert references[row['signScript']] == 1, row
+    # Resolve the native renderer, not the gym8 leader alias (now at Wanhe).
+    history = (ROOT / 'src/taichung_landmark_history_data.c').read_text()
+    assert re.search(r'sHistory8SignEn\[\] = _\("Maple Garden\\n', history)
+    assert re.search(r'sHistory8SignZh\[\] = _\("秋紅谷\\n', history)
+    assert re.search(r'\[8\] = \{\{sHistory8SignEn, sHistory8SignZh\}', history)
+    reader = (ROOT / 'src/taichung_landmark_history.c').read_text()
+    assert 'gTaichungLandmarkHistory[gymId].sign[0]' in reader
+    assert 'gTaichungLandmarkHistory[gymId].sign[1]' in reader
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--self-test', action='store_true', help='Also reject targeted in-memory corruptions.')
+    args = parser.parse_args()
+    city = (ROOT / 'data/scripts/taichung_city.inc').read_text()
+    encounter = (ROOT / 'data/scripts/taichung_encounters.inc').read_text()
+    spec = json.loads((ROOT / 'data/taichung/encounters/existing-bindings.json').read_text())
+    sites = json.loads((ROOT / 'data/taichung/encounters/sites.json').read_text())
+    parsed = validate_bindings(city, encounter, spec, sites)
+    cases = exercise(parsed); check_native_references(spec)
+    probes = []
+    if args.self_test:
+        for i in SIGN_IDS:
+            target = 'goto TaichungEncounter_' + SUFFIXES[i]
+            probes.append((city.replace(target, 'end', 1), encounter, spec, sites))
+            probes.append((city.replace(target, 'goto TaichungEncounter_WenchangTemple', 1), encounter, spec, sites))
+        probes.append((city.replace('msgbox TaichungCity_Text_BotanicalGarden, MSGBOX_SIGN', 'delay 1', 1), encounter, spec, sites))
+        probes.append((city.replace('setvar VAR_0x8004, TAICHUNG_GYM_MAPLE_GARDEN', 'setvar VAR_0x8004, TAICHUNG_HISTORY_WANHE_TEMPLE', 1), encounter, spec, sites))
+        probes.append((city + '\nUnexpected_Copy::\n\tgoto TaichungEncounter_MapleGarden\n', encounter, spec, sites))
+        probes.append((city, encounter.replace('\tgoto_if_questlog TaichungEncounter_Leave\n', '', 1), spec, sites))
+        probes.append((city, encounter.replace('\tcopyvar VAR_0x8007, VAR_0x8004', '\tsetvar VAR_0x40F4, 0\n\tcopyvar VAR_0x8007, VAR_0x8004', 1), spec, sites))
+        bad_sites = copy.deepcopy(sites); bad_sites['sites'][0]['currentBinding'] = None
+        probes.append((city, encounter, spec, bad_sites))
+        for index, (bad_city, bad_encounter, bad_spec, bad_meta) in enumerate(probes):
+            try: exercise(validate_bindings(bad_city, bad_encounter, bad_spec, bad_meta))
+            except (AssertionError, KeyError, StopIteration): pass
+            else: raise AssertionError(('corruption accepted', index))
+    print(f'PASS:9 exact existing sign bindings + preserved Wenchang host;14 resolved APIs;{cases} source-flow cases;{len(probes)} rejected corruptions; no native runtime or save/catch simulation.')
+
+
+if __name__ == '__main__':
+    main()
