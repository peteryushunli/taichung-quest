+        "kitTileDiffersInOnePrimary": ("identity", {f"{oldcore}/tiles.png": png_with(oldcore, TILE_SLOTS[5], 3)}),
+        "kitDefinitionDiffersInOnePrimary": ("identity", {f"{greenway}/metatiles.bin": word_with(f"{greenway}/metatiles.bin", FIRST_METATILE * 8 + 1, "H", 0x400)}),
+        "kitArtEditedEverywhere": ("kitContent", {f"{f}/tiles.png": png_with(f, TILE_SLOTS[0], 9) for f in install.PRIMARIES}),
+        "surfableKitWater": ("kitContent", everywhere("metatile_attributes.bin", water, "I", 0x15)),
+        "usedTileOverwritten": ("preserved", {f"{xitun}/tiles.png": png_with(xitun, 0x22F, 7)}),
