+def validate(data,city,evidence):
+    expected={s["id"] for s in city["sections"]}
+    assert {s["id"] for s in data["sections"]} == expected and len(data["sections"])==16
+    sources={s["id"] for s in evidence["sources"]}
+    catalog=json.loads((ROOT/"data/taichung/prefabs/catalog.json").read_text())
+    roles={p["role"] for p in catalog["prefabs"]}
+    city_sections={s["id"]:s for s in city["sections"]}
+    for s in data["sections"]:
+        assert set(s["sourceEvidenceRefs"]) <= sources
+        t=s["authoredVisualTargets"]
+        for key in ("useMix","ageStyleMix","heightMix","roofColorMix","prefabRoleWeights"):
+            assert abs(sum(t[key].values())-1)<1e-8, (s["id"],key)
+            assert all(0<=v<=1 for v in t[key].values())
+        assert set(t["prefabRoleWeights"]) <= roles
+        for band in s["streetBands"].values():
+            assert set(band["prefabRoleWeights"])<=roles
+            assert abs(sum(band["prefabRoleWeights"].values())-1)<1e-8
+            assert all(0<=v<=1 for v in band["prefabRoleWeights"].values())
+            assert set(band["sourceRoadNames"]) <= road_names(city,city_sections[s["id"]])
+            for key in ("frontageContinuity","arcadeFrequency","signageIntensity","builtCoverageTarget"):
+                assert 0<=band[key]<=1
+            assert 0<=band["setbackTiles"][0]<=band["setbackTiles"][1]<=4
+        for key in ("frontageContinuity","arcadeFrequency","signageIntensity","greenSpaceFraction","builtCoverageTarget"):
+            assert 0<=t[key]<=1
+        assert s["streetBands"]["primaryRetailFrontage"]["signageIntensity"] > s["streetBands"]["residentialSideStreet"]["signageIntensity"]
+    current_pilot=json.loads((DATA/"pilot-profile.json").read_text())["section"]
+    expanded_pilot=next(s for s in data["sections"] if s["id"]=="city-v2-r2-c2")
+    assert expanded_pilot["authoredVisualTargets"]==current_pilot["authoredVisualTargets"]
+    assert expanded_pilot["streetBands"]==current_pilot["streetBands"]
+    return {"sections":16,"mixturesNormalized":True,"allRoleNamesInNativePrefabCatalog":True,
+            "allEvidenceRefsResolved":True,"allNamedFrontagesMatchSourceRoadGeometry":True,"retailAndResidentialBandsDiffer":True,
+            "approvedR2C2TargetsUnchanged":True,"nativeMapMutations":False,
+            "sourceRoadSha256":data["sourceStreetDraftSha256"],
+            "broadCharacterConfidenceCounts":{k:sum(s["confidence"]["broadCharacter"]==k for s in data["sections"]) for k in ("high","medium","low")}}
+
