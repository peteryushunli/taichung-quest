+static const u8 sOptionalStory0SignEn[] = _("Old Taichung Station\nStation built in 1917.");
+static const u8 sOptionalStory0SignZh[] = _("舊臺中車站\n站房建於1917年。");
+static const u8 sOptionalStory0AboutEn[] = _("The design draws on\nRenaissance architecture.\pHeritage protection in 1995\nhelped save this station.\pThat protection includes\nthe porch and first platform.\pThe newer station took over\npassenger transport duties.\pRetired train cars now stand\non the old park platforms.");
+static const u8 sOptionalStory0AboutZh[] = _("站房造型，帶有\n文藝復興式建築的特色。\p1995年公告古蹟指定，\n讓這座老站保留下來。\p保存範圍還包括前門廊，\n以及第一月台。\p旅客搭車的運輸功能，\n已由新車站承接。\p舊月台成了鐵道文化空間，\n也展示退役的火車車輛。");
+static const u8 sOptionalStory0StaffEn[] = _("On my postcards, I always\ndraw the central clock tower.\pThose white stone bands\nframe the old red brick.");
+static const u8 sOptionalStory0StaffZh[] = _("畫明信片時，\n我一定先畫中央那座鐘樓。\p你看，白色的洗石子環帶，\n把紅磚襯得更清楚了。");
+static const u8 sOptionalStory0CreditEn[] = _("Aming's postcard notes.");
+static const u8 sOptionalStory0CreditZh[] = _("阿明的明信片筆記。");
+extern void TaichungGym_ScriptGetStationMessage(void);
+
+static const u8 sOptionalStory1SignEn[] = _("Taichung Park\nLake pavilion built in 1908.");
+static const u8 sOptionalStory1SignZh[] = _("臺中公園\n湖心亭建於1908年。");
+static const u8 sOptionalStory1AboutEn[] = _("The park opened in 1903.\nIts lake began as a pond.\pThe pavilion marked the\ntrunk railway opening.\pAfter the war, the park\nwas renamed Zhongshan.\pThe Taichung Park name\nreturned in 2000.\pThe pavilion became\na city heritage site in 1999.");
+static const u8 sOptionalStory1AboutZh[] = _("公園在1903年開園。\n湖泊原本是一處自然水塘。\p湖心亭當年是為了慶祝\n縱貫鐵路通車而建。\p戰後，這座公園\n曾改名為中山公園。\p到了2000年，\n又恢復臺中公園的名稱。\p1999年，湖心亭\n獲指定為市定古蹟。");
+static const u8 sOptionalStory1StaffEn[] = _("Two square pavilions,\njoined by a short corridor.\pI point out the timber posts\nand white concrete braces.");
+static const u8 sOptionalStory1StaffZh[] = _("你看，是兩座方形亭子，\n中間用一段走廊連起來。\p導覽時，我最愛介紹木柱，\n還有白色的斜角扶臂柱。");
+static const u8 sOptionalStory1CreditEn[] = _("Park volunteer's notes.");
+static const u8 sOptionalStory1CreditZh[] = _("公園人員的筆記。");
+extern void TaichungGym_ScriptGetParkMessage(void);
+
+static const u8 sOptionalStory2SignEn[] = _("Miyahara\nEye clinic, built in 1927.");
+static const u8 sOptionalStory2SignZh[] = _("宮原眼科\n1927年建的眼科診所。");
+static const u8 sOptionalStory2AboutEn[] = _("A Japanese eye doctor\nfounded this clinic.\pAfter 1945, it became\nthe city health office.\pDawn Cake brought the\nunused building back to life.\pThe old health-center sign\nwas kept with the facade.\pIt stands beside Luchuan,\nnear the railway station.");
+static const u8 sOptionalStory2AboutZh[] = _("一位日本眼科醫師，\n在這裡開設了診所。\p二戰後，這裡曾作為\n臺中衛生院使用。\p日出接手這棟閒置建築，\n讓老房子重新有了用途。\p從前衛生院的招牌，\n也和外牆一起保留下來。\p這裡就在綠川旁，\n離舊車站也不遠。");
+static const u8 sOptionalStory2StaffEn[] = _("I show visitors the old arch.\nThe red-brick walls stayed.\pMy favorite reuse? The well,\nnow a glass donation box.");
+static const u8 sOptionalStory2StaffZh[] = _("我最愛帶人看那道老牌樓。\n原來的紅磚牆，也保留下來。\p我覺得最巧妙的是那口井。\n後來改成玻璃的募款箱。");
+static const u8 sOptionalStory2CreditEn[] = _("Counter helper's notes.");
+static const u8 sOptionalStory2CreditZh[] = _("店內人員的筆記。");
+extern void TaichungGym_ScriptGetMiyaharaMessage(void);
+
+static const u8 sOptionalStory3SignEn[] = _("Natural Science Museum\nFirst halls opened in 1986.");
+static const u8 sOptionalStory3SignZh[] = _("國立自然科學博物館\n最早展館1986年開放。");
+static const u8 sOptionalStory3AboutEn[] = _("Planning started with an\noffice set up in 1981.\pScience Center and Space\nTheater opened first.\pLife Science Hall followed\nin August 1988.\pHuman Cultures and Global\nEnvironment came in 1993.\pThe Botanical Garden\nopened in July 1999.");
+static const u8 sOptionalStory3AboutZh[] = _("1981年成立籌備處，\n開始規劃這座博物館。\p最早開放的展館包括\n科學中心和太空劇場。\p1988年8月，\n生命科學廳接著開放。\p1993年完成人類文化廳，\n以及地球環境廳。\p植物園則在\n1999年7月開放。");
+static const u8 sOptionalStory3StaffEn[] = _("I help with science notes.\nSpecimens support research.\pHelping schools teach science\nis one of the museum goals.");
+static const u8 sOptionalStory3StaffZh[] = _("我幫忙整理科學筆記時，\n才知道標本也是研究資料。\p協助學校進行科學教育，\n也是這座博物館的目標。");
+static const u8 sOptionalStory3GardenEn[] = _("Native plants grow outside.\nI sketch their leaf shapes.\pThe greenhouse adds plants\nfrom tropical rainforests.");
+static const u8 sOptionalStory3GardenZh[] = _("我會在戶外畫原生植物。\n光是葉形，就畫滿一頁。\p走進溫室，還能認識\n世界各地的雨林植物。");
+static const u8 sOptionalStory3CreditEn[] = _("Qiaoqiao's notebooks.");
+static const u8 sOptionalStory3CreditZh[] = _("巧巧的筆記。");
+extern void TaichungGym_ScriptGetScienceMessage(void);
+
+static const u8 sOptionalStory4SignEn[] = _("Calligraphy Greenway\nName from cursive script.");
+static const u8 sOptionalStory4SignZh[] = _("草悟道／市民廣場\n名字取自草書。");
+static const u8 sOptionalStory4AboutEn[] = _("The real greenway is about\n3.6 kilometers long.\pIt links the science museum\nwith the fine arts museum.\pCivic Square and Park Lane\nby CMP sit along the route.\pGalleries and places to eat\nare part of the corridor.\pCivic Square has hosted\nthe city's jazz festival.");
+static const u8 sOptionalStory4AboutZh[] = _("真實的草悟道，\n長度大約是3.6公里。\p它串起了科博館，\n以及國立臺灣美術館。\p市民廣場、勤美誠品，\n也都在這條廊帶上。\p沿線還聚集了藝廊，\n以及各種餐飲空間。\p市民廣場也曾是\n臺中爵士音樂節的場地。");
+static const u8 sOptionalStory4StaffEn[] = _("Civic Square's broad lawn\nis where I meet my friends.\pI help plan our next stop.\nLots to see along the way.");
+static const u8 sOptionalStory4StaffZh[] = _("市民廣場那片大草坪，\n就是我和朋友碰面的地方。\p我最愛幫朋友安排下一站。\n這條路上，能看的可多了。");
+static const u8 sOptionalStory4CreditEn[] = _("Ayan's route notes.");
+static const u8 sOptionalStory4CreditZh[] = _("阿彥的路線筆記。");
+extern void TaichungGym_ScriptGetGreenwayMessage(void);
+
+static const u8 sOptionalStory5SignEn[] = _("Shen Ji New Village\nAuditing staff homes, 1969.");
+static const u8 sOptionalStory5SignZh[] = _("審計新村\n1969年的審計處宿舍。");
+static const u8 sOptionalStory5AboutEn[] = _("After government changes,\nthe dorms stood unused.\pReuse gave young businesses\na place to get started.\pThis whole compound covers\nabout half a hectare.");
+static const u8 sOptionalStory5AboutZh[] = _("政府組織調整之後，\n這些宿舍曾閒置多年。\p後來重新活化，\n讓青年在這裡展開創業。\p整個聚落的面積，\n大約只有半公頃。");
+static const u8 sOptionalStory5StaffEn[] = _("Reuse kept the old homes\nand the trees beside them.\pNow it's shops and studios.\nI like making things here.");
+static const u8 sOptionalStory5StaffZh[] = _("我喜歡這次再利用的方式。\n老屋、老樹，都留下來了。\p現在有小店，也有工作室。\n能在老屋裡創作，我很開心。");
+static const u8 sOptionalStory5CreditEn[] = _("Workshop helper's notes.");
+static const u8 sOptionalStory5CreditZh[] = _("工作室人員的筆記。");
+extern void TaichungGym_ScriptGetShenJiMessage(void);
+
+static const u8 sOptionalStory6SignEn[] = _("Taiwan Fine Arts Museum\nMuseum opened in 1988.");
+static const u8 sOptionalStory6SignZh[] = _("國立臺灣美術館\n1988年開館。");
+static const u8 sOptionalStory6AboutEn[] = _("The focus is Taiwan's modern\nand contemporary art.\pIt took its National museum\nname in 1999.\pThe sculpture and steles\npark opened in 1995.\pThree floors above ground,\nand two more below.\pIts library specializes\nin books about fine art.");
+static const u8 sOptionalStory6AboutZh[] = _("這裡蒐藏、研究的重點，\n是臺灣近現代藝術。\p到了1999年，\n更名為國立臺灣美術館。\p雕塑與書法碑林園區，\n在1995年啟用。\p主館有地上三層，\n以及地下兩層的空間。\p館內也有一座\n專門蒐集藝術資料的圖書館。");
+static const u8 sOptionalStory6StaffEn[] = _("I like the care art gets:\nchecks, records and framing.\pChildren get art spaces, too.\nI help them look closely.");
+static const u8 sOptionalStory6StaffZh[] = _("我最佩服的是幕後工作。\n作品要檢視、記錄和裝裱。\p也有讓小朋友認識藝術的空間。\n我很喜歡陪他們仔細看作品。");
+static const u8 sOptionalStory6CreditEn[] = _("Gallery volunteer's notes.");
+static const u8 sOptionalStory6CreditZh[] = _("美術館人員的筆記。");
+extern void TaichungGym_ScriptGetFineArtsMessage(void);
+
+static const u8 sOptionalStory7SignEn[] = _("Fengjia Night Market\nMarket roots: 1963.");
+static const u8 sOptionalStory7SignZh[] = _("逢甲夜市\n1963年開始發展。");
+static const u8 sOptionalStory7AboutEn[] = _("It was once Wenhua Market.\nNow named for Feng Chia.\pThe real Wenhua Road core\nlinks campus and Fuxing Road.\pNearby streets include\nFengjia and Xitun roads.\pThis university neighborhood\nis in Xitun District.\pThe market earned five stars\nin a 2022 market assessment.");
+static const u8 sOptionalStory7AboutZh[] = _("原本叫作文華夜市。\n後來因逢甲大學而改名。\p真實的文華路攤販核心，\n從大學側門延伸至福星路。\p周邊的逢甲路、西屯路，\n也屬於廣義的夜市商圈。\p這個大學旁的熱鬧商圈，\n就位在西屯區。\p2022年，這裡獲得\n優良市集五星評等。");
+static const u8 sOptionalStory7StaffEn[] = _("I like swapping snack ideas.\nNew combinations start here.\pClothes, food, accessories.\nI help visitors spot the mix.");
+static const u8 sOptionalStory7StaffZh[] = _("我喜歡和鄰居聊小吃點子。\n新的組合，常常就這樣開始。\p衣服、小吃、配件都有。\n我最愛幫人介紹這裡的熱鬧。");
+static const u8 sOptionalStory7CreditEn[] = _("Auntie Mei's notes.");
+static const u8 sOptionalStory7CreditZh[] = _("美姨的筆記。");
+extern void TaichungGym_ScriptGetFengjiaMessage(void);
+
+static const u8 sOptionalStory8SignEn[] = _("Maple Garden\nPark opened in 2012.");
+static const u8 sOptionalStory8SignZh[] = _("秋紅谷\n2012年啟用。");
+static const u8 sOptionalStory8AboutEn[] = _("A stalled project left a pit.\nIt later became this park.\pLandscape work started\nin December 2010.\pThe sunken grounds cover\nabout three hectares.\pThere's a lake and a bridge,\njust off Taiwan Boulevard.\pThe basin also stores rain\nas part of local drainage.");
+static const u8 sOptionalStory8AboutZh[] = _("原本的開發計畫停了下來，\n留下的坑洞後來變成公園。\p2010年12月起，\n市府開始推動景觀改造。\p低於街道的園區，\n面積大約有三公頃。\p這裡就在臺灣大道旁，\n園內有水池，也有景觀橋。\p下凹空間也能儲存雨水，\n是地方排水系統的一部分。");
+static const u8 sOptionalStory8StaffEn[] = _("Chaoyang and Huilai streams\nfeed the inlet system here.\pI like the park's second job:\ngreen space that stores rain.");
+static const u8 sOptionalStory8StaffZh[] = _("進水系統會收匯\n潮洋溪、惠來溪的水。\p我最喜歡它的另一份工作。\n不只好看，也幫忙滯洪。");
+static const u8 sOptionalStory8CreditEn[] = _("Park volunteer's notes.");
+static const u8 sOptionalStory8CreditZh[] = _("公園人員的筆記。");
+
+static const u8 sOptionalStory9SignEn[] = _("National Taichung Theater\nTheater opened in 2016.");
+static const u8 sOptionalStory9SignZh[] = _("臺中國家歌劇院\n2016年開幕。");
+static const u8 sOptionalStory9AboutEn[] = _("Toyo Ito designed this\ntheater and its curved spaces.\pAn outdoor concert in\nPortugal helped inspire him.\pIts structure uses\n58 curved wall units.\pInside are 29 sound caves,\nseparate but connected.\pSmall openings in the walls\nlet daylight come inside.\pGlass and cement curves\nshape the familiar facade.\pThe curved walls do more\ndecorate: they support it.");
+static const u8 sOptionalStory9AboutZh[] = _("建築師伊東豊雄，\n設計了這些彎曲的空間。\p葡萄牙的一場戶外音樂會，\n曾帶給他設計的靈感。\p建築結構使用了\n58片曲牆單元。\p裡面有29個聲音涵洞，\n各自獨立，又彼此相連。\p牆面的小開孔，\n會把日光帶進建築裡。\p玻璃與水泥曲牆，\n構成這個熟悉的外觀。\p曲牆不只是裝飾，\n也是支撐建築的結構。");
+static const u8 sOptionalStory9StaffEn[] = _("After prop work, I show\nfriends the Sky Garden.\pUnder the ground floor,\npipes help cool the lobby.");
+static const u8 sOptionalStory9StaffZh[] = _("忙完道具的工作，\n我會帶朋友認識空中花園。\p大廳的地板下有管線，\n也在幫這個空間降溫。");
+static const u8 sOptionalStory9CreditEn[] = _("Boxun's backstage notes.");
+static const u8 sOptionalStory9CreditZh[] = _("柏勳的後臺筆記。");
+extern void TaichungGym_ScriptGetTheaterMessage(void);
+
+static const u8 sOptionalStory10SignEn[] = _("Wenchang Temple\nShrine roots: 1797.");
+static const u8 sOptionalStory10SignZh[] = _("南屯文昌公廟\n始於1797年。");
+static const u8 sOptionalStory10AboutEn[] = _("This temple honors the\nFive Wenchang deities.\pLearning groups once taught\nin rooms beside the halls.\pIn 1898, a public school\nused it as temporary rooms.\pThe Changming group formed\nin 1924 to promote learning.\pThe building at this site\nwas built in 1973.");
+static const u8 sOptionalStory10AboutZh[] = _("這座廟主要奉祀的，\n是五文昌。\p文教社團曾在廂房授課，\n為地方培養讀書風氣。\p1898年公學校成立時，\n曾借用這裡作臨時校舍。\p1924年成立的昌明會，\n繼續推動漢學文化。\p現在這個地點的廟宇，\n是在1973年興建的。");
+static const u8 sOptionalStory10StaffEn[] = _("While tidying, I notice\nold plaques and stone pillars.\pListed as a historic building\nin 2010. I tell visitors that.");
+static const u8 sOptionalStory10StaffZh[] = _("幫忙整理廟裡的時候，\n我總會多看清代古匾與石柱。\p2010年登錄為歷史建築。\n我很樂意把這段故事說給人聽。");
+static const u8 sOptionalStory10CreditEn[] = _("Temple helper's notes.");
+static const u8 sOptionalStory10CreditZh[] = _("廟方人員的筆記。");
+
+static const u8 sOptionalStory11SignEn[] = _("Wanhe Temple\nMazu temple built in 1726.");
+static const u8 sOptionalStory11SignZh[] = _("萬和宮\n1726年建的媽祖廟。");
+static const u8 sOptionalStory11AboutEn[] = _("Litoudian was named for\nshops making farm tools.\pLocal surname families\nhelped fund this temple.\pThree halls stand in a row,\none beyond the next.\pThe temple was designated\na heritage site in 1985.\pSurname groups fund operas\nas offerings of thanks.");
+static const u8 sOptionalStory11AboutZh[] = _("犁頭店這個舊地名，\n來自打造犁頭等農具的店舖。\p當年由地方各姓居民，\n一起捐款興建這座廟宇。\p三進廟殿，\n一進接著一進向內排列。\p這座廟在1985年，\n獲指定為古蹟。\p字姓團體輪流出資，\n請戲班演出，向神明致謝。");
+static const u8 sOptionalStory11StaffEn[] = _("I like the six-sided columns.\nLook for carved lotus petals.\pFamilies helped build this.\nI like that shared effort.");
+static const u8 sOptionalStory11StaffZh[] = _("我很喜歡前面的六角石柱。\n仔細看，還刻著蓮瓣細節。\p這座廟是大家一起捐建的。\n幫忙時想到這點，就很踏實。");
+static const u8 sOptionalStory11CreditEn[] = _("Temple helper's notes.");
+static const u8 sOptionalStory11CreditZh[] = _("廟方人員的筆記。");
+extern void TaichungGym_ScriptGetMapleGardenMessage(void);
+
+static const u8 sOptionalStory12SignEn[] = _("Botanical Garden\nA rainforest under glass.");
+static const u8 sOptionalStory12SignZh[] = _("科博館植物園\n玻璃溫室裡的熱帶雨林。");
+static const u8 sOptionalStory12AboutEn[] = _("The garden opened\nin July 1999.\pOutdoor areas introduce\nTaiwan's native plants.\pThe greenhouse uses six\ncolumn groups, seven rings.");
+static const u8 sOptionalStory12AboutZh[] = _("這座植物園，\n在1999年7月開放。\p戶外的展示區，\n介紹臺灣的原生植物。\p溫室由六組立柱，\n和七道環梁構成。");
+static const u8 sOptionalStory12StaffEn[] = _("I help people notice coffee\nand cocoa trees in here.\pI like the work out of sight:\nthe nursery and seed bank.");
+static const u8 sOptionalStory12StaffZh[] = _("介紹植物時，我最愛提醒：\n這裡也有咖啡樹、可可樹！\p園裡不只看得到的植物。\n我也很喜歡苗圃和種子庫。");
+static const u8 sOptionalStory12CreditEn[] = _("Garden helper's notes.");
+static const u8 sOptionalStory12CreditZh[] = _("植物園人員的筆記。");
+
+static const u8 sOptionalStory13SignEn[] = _("Taichung Confucius Temple\nSong-style halls and courts.");
+static const u8 sOptionalStory13SignZh[] = _("臺中孔廟\n宋代宮殿式的廟宇格局。");
+static const u8 sOptionalStory13AboutEn[] = _("The site once held a school\nfor Air Force families.\pThe plan takes cues from\nQufu, on a smaller scale.\pThe next-door Martyrs Shrine\nuses a different Qing style.");
+static const u8 sOptionalStory13AboutZh[] = _("原址曾是空軍子弟學校，\n後來才規劃改建為孔廟。\p平面配置參照曲阜孔廟，\n再依這裡的基地縮小規模。\p相鄰的忠烈祠，\n採用不同的清代宮殿式。");
+static const u8 sOptionalStory13StaffEn[] = _("Double eaves, glazed tiles.\nLook for that yellow roof.\pConfucius is honored here\nwith a tablet, not a statue.");
+static const u8 sOptionalStory13StaffZh[] = _("我帶人看建築，先看屋頂。\n大成殿重檐，覆著黃琉璃瓦。\p殿內以神位奉祀孔子，\n並沒有設置孔子的塑像。");
+static const u8 sOptionalStory13CreditEn[] = _("Heritage volunteer's notes.");
+static const u8 sOptionalStory13CreditZh[] = _("導覽人員的筆記。");
+
+static const u8 sOptionalStory14SignEn[] = _("Yizhong Street\nStudent shops and snacks.");
+static const u8 sOptionalStory14SignZh[] = _("一中街\n學生商圈、小店與小吃。");
+static const u8 sOptionalStory14AboutEn[] = _("Taichung First Senior High\nis one nearby school.\pTaichung University of\nScience and Technology, too.\pTaiwan University of Sport\nis also in this neighborhood.\pYucai Street has food stalls.\nClothes fill the small lanes.\pChungyo and Sanmin shops\nare nearby in the real city.");
+static const u8 sOptionalStory14AboutZh[] = _("臺中一中，\n就是附近的學校之一。\p這裡也鄰近\n臺中科技大學。\p臺灣體育運動大學，\n也是附近的學校之一。\p育才街上有餐飲攤販，\n小巷裡則有許多服飾店。\p真實城市裡，這一帶鄰近\n中友百貨與三民商圈。");
+static const u8 sOptionalStory14StaffEn[] = _("Clothes shops fill the lanes.\nI help visitors spot them.\pI like our student neighbors.\nSchools keep this area lively.");
+static const u8 sOptionalStory14StaffZh[] = _("服飾店常常就在小巷裡。\n我最喜歡幫來逛的人找小店。\p我喜歡這裡的學生鄰居。\n附近有學校，街上就有活力。");
+static const u8 sOptionalStory14CreditEn[] = _("Shop helper's notes.");
+static const u8 sOptionalStory14CreditZh[] = _("店家人員的筆記。");
+
+static const u8 sOptionalStory15SignEn[] = _("Taichung Prefectural Hall\nConstruction began in 1913.");
+static const u8 sOptionalStory15SignZh[] = _("臺中州廳\n1913年開始興建。");
+static const u8 sOptionalStory15AboutEn[] = _("Architect Moriyama\nMatsunosuke designed it.\pAfter later expansions,\nits scale was set by 1934.\pAn L-shaped, two-floor plan\nputs the door at the corner.\pIts roof takes a French\nMansard-style form.");
+static const u8 sOptionalStory15AboutZh[] = _("這座建築的設計者，\n是森山松之助。\p經過多次擴建，\n1934年奠定了現今規模。\p兩層樓的L形配置，\n把主要入口放在街道轉角。\p屋頂採用了\n法式馬薩屋頂的形式。");
+static const u8 sOptionalStory15StaffEn[] = _("Doric below, Ionic above.\nThat's my favorite tour clue.\pInset balconies add shade.\nI point them out on hot days.");
+static const u8 sOptionalStory15StaffZh[] = _("我喜歡請人比比上下柱式。\n一樓多立克，二樓愛奧尼克。\p內凹的陽臺，也能遮蔭。\n天氣熱時，我就會介紹這點。");
+static const u8 sOptionalStory15CreditEn[] = _("Heritage volunteer's notes.");
+static const u8 sOptionalStory15CreditZh[] = _("導覽人員的筆記。");
+
+static const u8 sOptionalStory16SignEn[] = _("Second Market\nMarket founded in 1917.");
+static const u8 sOptionalStory16SignZh[] = _("第二市場\n1917年創建的市場。");
+static const u8 sOptionalStory16AboutEn[] = _("Its original name was\nShintomicho Market.\pThe central hexagonal tower\nwas built later, in 1936.\pSix radial aisles lead\ntoward the hexagonal core.");
+static const u8 sOptionalStory16AboutZh[] = _("這裡最早的名字，\n叫作新富町市場。\p中央的六角樓較晚興建，\n建於1936年。\p六條放射狀的通道，\n都朝中央六角樓匯集。");
+static const u8 sOptionalStory16StaffEn[] = _("I tell visitors this market\nonce had a busy banana trade.\pI'm proud of our food roots:\nbraised pork rice and noodles.");
+static const u8 sOptionalStory16StaffZh[] = _("介紹市場時，我也會說：\n這裡的香蕉交易曾經很熱鬧！\p我最喜歡這裡的飲食傳承。\n魯肉飯、麵食，都有老味道。");
+static const u8 sOptionalStory16CreditEn[] = _("Market helper's notes.");
+static const u8 sOptionalStory16CreditZh[] = _("市場人員的筆記。");
+
+static const u8 sOptionalStory17SignEn[] = _("Cultural Heritage Park\nOld brewery site, since 1916.");
+static const u8 sOptionalStory17SignZh[] = _("文化部文化資產園區\n源於1916年的舊製酒工場。");
+static const u8 sOptionalStory17AboutEn[] = _("The state took over the\nbrewery in 1922.\pIn 1998, production moved\nto the industrial district.\pThe old factory site became\nlisted historic space in 2002.");
+static const u8 sOptionalStory17AboutZh[] = _("1922年酒類納入專賣，\n這座工場也收歸官有。\p1998年，酒廠遷到工業區，\n舊廠房才慢慢有了新用途。\p2002年，這片舊廠區\n登錄為歷史建築。");
+static const u8 sOptionalStory17StaffEn[] = _("I show the old factory rooms.\nI like their industrial story.\pWe use rooms for exhibits\nand creative workshops now.");
+static const u8 sOptionalStory17StaffZh[] = _("帶人看老廠房時，我最喜歡\n留下來的那些工業空間。\p老廠房保留下來，\n現在能辦展覽，也能做文創。");
+static const u8 sOptionalStory17CreditEn[] = _("Venue helper's notes.");
+static const u8 sOptionalStory17CreditZh[] = _("園區人員的筆記。");
+
+static const u8 sOptionalStory18SignEn[] = _("Fengle Sculpture Park\nFirst public sculpture park.");
+static const u8 sOptionalStory18SignZh[] = _("豐樂雕塑公園\n臺灣首座公立露天雕塑公園。");
+static const u8 sOptionalStory18AboutEn[] = _("About six hectares of park,\nwith art among the greenery.\pWorks came from sculpture\nshows and established artists.\pThe artificial lake has\nan arched bridge nearby.");
+static const u8 sOptionalStory18AboutZh[] = _("園區面積約六公頃，\n讓雕塑與綠地放在一起。\p作品來自雕塑大展徵選，\n也有資深藝術家的創作。\p園內有人工湖，\n也能看見拱橋的景觀。");
+static const u8 sOptionalStory18StaffEn[] = _("Bronze and stone need care.\nI like pointing out each type.\pSome use stainless steel,\nothers reinforced plastic.");
+static const u8 sOptionalStory18StaffZh[] = _("青銅、石材，保養方式不同。\n我很喜歡介紹這些材質差異。\p也有不鏽鋼的作品，\n以及強化塑膠的雕塑。");
+static const u8 sOptionalStory18CreditEn[] = _("Art-care helper's notes.");
+static const u8 sOptionalStory18CreditZh[] = _("藝術人員的筆記。");
+
+static const u8 sOptionalStory19SignEn[] = _("Wenxin Forest Park\nFulfillment Amphitheatre.");
+static const u8 sOptionalStory19SignZh[] = _("文心森林公園\n圓滿戶外劇場。");
+static const u8 sOptionalStory19AboutEn[] = _("The park-and-stage project\ntook shape in August 2006.\pRoof construction began\nin 2008.\pThis outdoor venue stands\nin Nantun District.\pSeats rise in tiers,\nwith grass around them.");
+static const u8 sOptionalStory19AboutZh[] = _("公園與戶外劇場的計畫，\n在2006年8月逐步實現。\p劇場的頂棚工程，\n則在2008年開始施作。\p這個戶外表演場地，\n就位在南屯區。\p觀眾區有階梯座席，\n周邊也保留了草地。");
+static const u8 sOptionalStory19StaffEn[] = _("A refit begun in 2023 renewed\nseats, stage and lighting.\pI work with the stage crew.\nPark care is a separate team.");
+static const u8 sOptionalStory19StaffZh[] = _("2023年啟動的整修，\n更新了座席、舞臺和照明。\p我們負責的是劇場這一邊，\n公園綠地則有另一組人照顧。");
+static const u8 sOptionalStory19CreditEn[] = _("Stage crew's notes.");
+static const u8 sOptionalStory19CreditZh[] = _("舞臺人員的筆記。");
+
+const struct TaichungOptionalStory gTaichungOptionalStories[] = {
