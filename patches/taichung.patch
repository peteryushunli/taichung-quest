+def same_json_value(before, after):
+    # Preserve scalar types as well as values: JSON false/0 and 3/3.0 differ.
+    return json.dumps(before, sort_keys=True, separators=(",", ":")) == json.dumps(after, sort_keys=True, separators=(",", ":"))
+
