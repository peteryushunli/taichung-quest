+    Print(x, y, sMutedColors, TaichungText(sMovesEn, sMovesZh));
+    for (move = 0; move < MAX_MON_MOVES; move++)
+        Print(x, y + 16 + move * 16, sTextColors, moves[move] ? gMoveNames[moves[move]] : sLocked);
+}
+
+static bool8 SpeciesInCategory(u16 species, u8 type)
+{
+    if (type == TEAM_CATEGORY_ALL)
+        return TRUE;
+    // Dual-type species belong to both of their types.
+    return gSpeciesInfo[species].types[0] == type || gSpeciesInfo[species].types[1] == type;
+}
+
+static const struct TeamCategory *CurrentCategory(void)
+{
+    return &sCategories[sCategoryIds[sCategory]];
+}
+
+static const u8 *CategoryName(const struct TeamCategory *category)
+{
+    return TaichungText(category->nameEn, category->nameZh);
+}
+
+static void BuildCategories(void)
+{
+    u8 i;
+    u8 size;
+    u16 species;
+
+    sCategoryCount = 0;
+    for (i = 0; i < ARRAY_COUNT(sCategories); i++)
+    {
+        size = 0;
+        for (species = 1; species <= TEAM_ROSTER_COUNT; species++)
+        {
+            if (TaichungTeamSpeciesAllowed(species) && SpeciesInCategory(species, sCategories[i].type))
+                size++;
+        }
+        if (size == 0)
+            continue;
+        sCategoryIds[sCategoryCount] = i;
+        sCategorySizes[sCategoryCount] = size;
+        sCategoryCount++;
+    }
+    if (sCategory >= sCategoryCount)
+        sCategory = 0;
+}
+
+// Lists the current category by dex number and keeps sSpecies selected when it is listed.
+static void BuildRoster(void)
+{
+    u8 type = CurrentCategory()->type;
+    u16 species;
+
+    sRosterCount = 0;
+    sRosterIndex = 0;
+    for (species = 1; species <= TEAM_ROSTER_COUNT; species++)
+    {
+        if (!TaichungTeamSpeciesAllowed(species) || !SpeciesInCategory(species, type))
+            continue;
+        if (species == sSpecies)
+            sRosterIndex = sRosterCount;
+        sRoster[sRosterCount++] = species;
+    }
+    if (sRosterCount == 0)
+        sRoster[sRosterCount++] = SPECIES_BULBASAUR;
+    sSpecies = sRoster[sRosterIndex];
+}
+
+static void DrawCategories(void)
+{
+    u8 i;
+    u8 x;
+    u8 y;
+    u8 text[8];
+
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sCategoryTitleEn, sCategoryTitleZh));
+    Print(8, 22, sMutedColors, TaichungText(sCategoryHintEn, sCategoryHintZh));
+    for (i = 0; i < sCategoryCount; i++)
+    {
+        x = 8 + (i / CATEGORY_ROWS) * CATEGORY_COLUMN_WIDTH;
+        y = 40 + (i % CATEGORY_ROWS) * 16;
+        if (i == sCategory)
+            Print(x, y, sSelectedColors, sCursor);
+        Print(x + 8, y, i == sCategory ? sSelectedColors : sTextColors, CategoryName(&sCategories[sCategoryIds[i]]));
+        ConvertIntToDecimalStringN(text, sCategorySizes[i], STR_CONV_MODE_RIGHT_ALIGN, 3);
+        Print(x + 52, y, sMutedColors, text);
+    }
+    Print(8, 144, sTextColors, TaichungText(sCategoryFooterEn, sCategoryFooterZh));
+}
+
+static void DrawSpecies(void)
+{
+    u8 first = (sRosterIndex / SPECIES_PER_PAGE) * SPECIES_PER_PAGE;
+    u8 i;
+    u8 y;
+    u8 text[12];
+    u8 *end;
+
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, CategoryName(CurrentCategory()));
+    PrintNumber(188, 6, sSpecies, 3);
+    end = ConvertIntToDecimalStringN(text, sRosterIndex + 1, STR_CONV_MODE_LEFT_ALIGN, 3);
+    end = StringCopy(end, sSlash);
+    ConvertIntToDecimalStringN(end, sRosterCount, STR_CONV_MODE_LEFT_ALIGN, 3);
+    Print(8, 22, sMutedColors, text);
+    Print(56, 22, sMutedColors, TaichungText(sSpeciesHintEn, sSpeciesHintZh));
+    for (i = first; i < first + SPECIES_PER_PAGE && i < sRosterCount; i++)
+    {
+        y = 36 + (i - first) * 13;
+        if (i == sRosterIndex)
+            Print(6, y, sSelectedColors, sCursor);
+        ConvertIntToDecimalStringN(text, sRoster[i], STR_CONV_MODE_LEADING_ZEROS, 3);
+        Print(18, y, i == sRosterIndex ? sSelectedColors : sMutedColors, text);
+        Print(40, y, i == sRosterIndex ? sSelectedColors : sTextColors, gSpeciesNames[sRoster[i]]);
+    }
+    Print(148, 30, sSelectedColors, sLevel);
+    DrawMoves(140, 48);
+    Print(8, 144, sMutedColors, TaichungText(sSpeciesFooterEn, sSpeciesFooterZh));
+}
+
+static void DrawConfirmation(void)
+{
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    Print(8, 24, sTextColors, TaichungText(sConfirmEn, sConfirmZh));
+    Print(8, 48, sSelectedColors, gSpeciesNames[sSpecies]);
+    Print(100, 48, sSelectedColors, sLevel);
+    if (sSlot < CalculatePlayerPartyCount())
+    {
+        Print(8, 70, sMutedColors, TaichungText(sReplacingEn, sReplacingZh));
+        Print(8, 86, sTextColors, gSpeciesNames[GetMonData(&gPlayerParty[sSlot], MON_DATA_SPECIES)]);
+    }
+    DrawMoves(140, 48);
+    Print(8, 126, sMutedColors, TaichungText(sFullHpEn, sFullHpZh));
+    Print(8, 144, sTextColors, TaichungText(sConfirmFooterEn, sConfirmFooterZh));
+}
+
+static void DrawTeamMenu(void)
+{
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    if (sScreen == TEAM_SCREEN_SLOTS)
+        DrawSlots();
+    else if (sScreen == TEAM_SCREEN_CATEGORIES)
+        DrawCategories();
+    else if (sScreen == TEAM_SCREEN_SPECIES)
+        DrawSpecies();
+    else
+        DrawConfirmation();
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+}
+
+void ShowTaichungTeamMenu(MainCallback returnCallback)
+{
+    sReturnCallback = returnCallback;
+    sSlot = 0;
+    sCategory = 0;
+    sScreen = TEAM_SCREEN_SLOTS;
+    BuildCategories();
+    SetMainCallback2(CB2_InitTeamMenu);
+}
+
+static void CB2_ReopenTeamMenu(void)
+{
+    sScreen = TEAM_SCREEN_SLOTS;
+    SetMainCallback2(CB2_InitTeamMenu);
+}
+
+static void VBlankCB_TeamMenu(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+static void CB2_InitTeamMenu(void)
+{
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    if (!InitWindows(sWindowTemplates))
+    {
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    DeactivateAllTextPrinters();
+    LoadPalette(sPalette, 0, sizeof(sPalette));
+    DrawTeamMenu();
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_BG0_ON);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    CreateTask(Task_TeamMenuInput, 0);
+    SetVBlankCallback(VBlankCB_TeamMenu);
+    SetMainCallback2(CB2_TeamMenu);
+}
+
+static void CB2_TeamMenu(void)
+{
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void ChangeSpecies(s16 delta)
+{
+    s16 index = sRosterIndex + delta;
+
+    while (index < 0)
+        index += sRosterCount;
+    sRosterIndex = index % sRosterCount;
+    sSpecies = sRoster[sRosterIndex];
+}
+
+static void ChangeCategory(s8 delta)
+{
+    sCategory = (sCategory + sCategoryCount + delta) % sCategoryCount;
+}
+
+// Left/Right move between grid columns, keeping the row where the column has one.
+static void ChangeCategoryColumn(bool8 right)
+{
+    if (right)
+    {
+        if (sCategory + CATEGORY_ROWS < sCategoryCount)
+            sCategory += CATEGORY_ROWS;
+        else
+            sCategory %= CATEGORY_ROWS;
+    }
+    else if (sCategory >= CATEGORY_ROWS)
+        sCategory -= CATEGORY_ROWS;
+    else
+    {
+        while (sCategory + CATEGORY_ROWS < sCategoryCount)
+            sCategory += CATEGORY_ROWS;
+    }
+}
+
+static void Task_TeamMenuInput(u8 taskId)
+{
+    u8 rows;
+    u8 choice;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] != 0)
+    {
+        choice = gTasks[taskId].data[0];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeAllWindowBuffers();
+        if (choice == 2)
+            InitPartyMenu(PARTY_MENU_TYPE_FIELD, PARTY_LAYOUT_SINGLE, PARTY_ACTION_CHOOSE_MON, FALSE, PARTY_MSG_CHOOSE_MON, Task_HandleChooseMonInput, CB2_ReopenTeamMenu);
+        else
+            SetMainCallback2(sReturnCallback);
+        return;
+    }
+    if (sScreen == TEAM_SCREEN_SLOTS)
+    {
+        rows = CalculatePlayerPartyCount();
+        if (rows < PARTY_SIZE)
+            rows++;
+        if (JOY_NEW(B_BUTTON | START_BUTTON))
+            gTasks[taskId].data[0] = 1;
+        else if (JOY_NEW(SELECT_BUTTON) && CalculatePlayerPartyCount() != 0)
+            gTasks[taskId].data[0] = 2;
+        else if (JOY_NEW(DPAD_UP))
+            sSlot = (sSlot + rows - 1) % rows;
+        else if (JOY_NEW(DPAD_DOWN))
+            sSlot = (sSlot + 1) % rows;
+        else if (JOY_NEW(A_BUTTON))
+        {
+            sSpecies = sSlot < CalculatePlayerPartyCount() ? GetMonData(&gPlayerParty[sSlot], MON_DATA_SPECIES) : 1;
+            if (!TaichungTeamSpeciesAllowed(sSpecies))
+                sSpecies = 1;
+            sScreen = TEAM_SCREEN_CATEGORIES;
+        }
+        else
+            return;
+    }
+    else if (sScreen == TEAM_SCREEN_CATEGORIES)
+    {
+        if (JOY_NEW(B_BUTTON))
+            sScreen = TEAM_SCREEN_SLOTS;
+        else if (JOY_NEW(DPAD_UP))
+            ChangeCategory(-1);
+        else if (JOY_NEW(DPAD_DOWN))
+            ChangeCategory(1);
+        else if (JOY_NEW(DPAD_LEFT))
+            ChangeCategoryColumn(FALSE);
+        else if (JOY_NEW(DPAD_RIGHT))
+            ChangeCategoryColumn(TRUE);
+        else if (JOY_NEW(A_BUTTON))
+        {
+            BuildRoster();
+            sScreen = TEAM_SCREEN_SPECIES;
+        }
+        else
+            return;
+    }
+    else if (sScreen == TEAM_SCREEN_SPECIES)
+    {
+        if (JOY_NEW(B_BUTTON))
+            sScreen = TEAM_SCREEN_CATEGORIES;
+        else if (JOY_NEW(DPAD_UP))
+            ChangeSpecies(-1);
+        else if (JOY_NEW(DPAD_DOWN))
+            ChangeSpecies(1);
+        else if (JOY_NEW(DPAD_LEFT))
+            ChangeSpecies(-SPECIES_PER_PAGE);
+        else if (JOY_NEW(DPAD_RIGHT))
+            ChangeSpecies(SPECIES_PER_PAGE);
+        else if (JOY_NEW(A_BUTTON))
+            sScreen = TEAM_SCREEN_CONFIRM;
+        else
+            return;
+    }
+    else
+    {
+        if (JOY_NEW(B_BUTTON))
+            sScreen = TEAM_SCREEN_SPECIES;
+        else if (JOY_NEW(A_BUTTON))
+        {
+            TaichungTeamSetSlot(sSlot, sSpecies);
+            sScreen = TEAM_SCREEN_SLOTS;
+        }
+        else
+            return;
+    }
+    PlaySE(SE_SELECT);
+    if (gTasks[taskId].data[0] != 0)
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+    else
+        DrawTeamMenu();
+}
diff --git a/data/taichung/gym-interiors/baseline/tests/taichung_landmark_history_test.c b/data/taichung/gym-interiors/baseline/tests/taichung_landmark_history_test.c
new file mode 100644
index 0000000..bdca1f1
--- /dev/null
+++ b/data/taichung/gym-interiors/baseline/tests/taichung_landmark_history_test.c
@@ -0,0 +1,108 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_landmark_history.h"
+
+u8 gStringVar4[1024];
+u16 gSpecialVar_0x8004, gSpecialVar_0x8005, gSpecialVar_Result;
+static bool8 sChinese;
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static const u8 *sShown;
+bool8 ShowFieldMessage(const u8 *message) { sShown = message; return TRUE; }
+void TaichungNpc_AmingMessage(void);
+void TaichungNpc_AyanMessage(void);
+void TaichungNpc_QiaoqiaoMessage(void);
+void TaichungNpc_MeiMessage(void);
+void TaichungNpc_BoxunMessage(void);
+
+const u8 *TaichungText(const u8 *en, const u8 *zh)
+{
+    return sChinese ? zh : en;
+}
+
+u8 *StringCopy(u8 *dest, const u8 *src)
+{
+    size_t size = strlen((const char *)src);
+    assert(size < sizeof(gStringVar4));
+    memcpy(dest, src, size + 1);
+    return dest + size;
+}
+
+int main(void)
+{
+    u16 gym;
+    u8 locale;
+    u16 savedVars[256];
+    static const u16 helpers[] = {TAICHUNG_GYM_OLD_STATION,TAICHUNG_GYM_GREENWAY,TAICHUNG_GYM_SCIENCE_MUSEUM,TAICHUNG_GYM_FENGJIA,TAICHUNG_GYM_THEATER};
+    static void (*const handlers[])(void) = {TaichungNpc_AmingMessage,TaichungNpc_AyanMessage,TaichungNpc_QiaoqiaoMessage,TaichungNpc_MeiMessage,TaichungNpc_BoxunMessage};
+    unsigned helper, complete;
+    memset(&sSave,0x5A,sizeof(sSave));
+    assert(gTaichungLandmarkHistory[TAICHUNG_GYM_MIYAHARA].sign[0] != NULL);
+    for (locale = 0; locale < 2; locale++)
+    {
+        sChinese = locale;
+        sSave.vars[0xFB] = locale + 1;
+        memcpy(savedVars,sSave.vars,sizeof(savedVars));
+        for (gym = 0; gym <= TAICHUNG_LANDMARK_HISTORY_COUNT; gym++)
+        {
+            bool8 available = gym < TAICHUNG_LANDMARK_HISTORY_COUNT && gTaichungLandmarkHistory[gym].sign[0] != NULL;
+            gSpecialVar_0x8004 = gym;
+            gSpecialVar_0x8005 = 0xBEEF;
+            gSpecialVar_Result = 0xCAFE;
+            TaichungHistory_ScriptHasFacts();
+            assert(gSpecialVar_Result == available);
+            gSpecialVar_Result = 0xCAFE;
+            TaichungHistory_ScriptBufferSign();
+            if (available)
+                assert(strcmp((const char *)gStringVar4, (const char *)gTaichungLandmarkHistory[gym].sign[locale]) == 0);
+            else
+                assert(gStringVar4[0] != 0);
+            TaichungHistory_ScriptBufferTour();
+            if (available)
+                assert(strcmp((const char *)gStringVar4, (const char *)gTaichungLandmarkHistory[gym].tour[locale]) == 0);
+            TaichungHistory_ScriptBufferStaff();
+            if (gym < 10)
+                assert(strcmp((const char *)gStringVar4,(const char *)gTaichungLandmarkHistory[gym].staff[locale]) == 0);
+            else
+                assert(gStringVar4[0] != 0);
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungHistory_GetStaffText(gym)) == 0);
+            assert(memcmp(savedVars,sSave.vars,sizeof(savedVars)) == 0);
+            assert(gSpecialVar_0x8004 == gym);
+            assert(gSpecialVar_0x8005 == 0xBEEF);
+            assert(gSpecialVar_Result == 0xCAFE);
+        }
+        gSpecialVar_0x8004 = 0xFFFF;
+        TaichungHistory_ScriptHasFacts();
+        assert(gSpecialVar_Result == FALSE);
+        TaichungHistory_ScriptBufferSign();
+        TaichungHistory_ScriptBufferTour();
+        TaichungHistory_ScriptBufferStaff();
+        assert(gStringVar4[0] != 0);
+        assert(gSpecialVar_0x8004 == 0xFFFF);
+        for (complete = 0; complete < 2; complete++)
+        {
+            sSave.vars[0xFA] = complete ? 0x3FF : 0;
+            memcpy(savedVars,sSave.vars,sizeof(savedVars));
+            for (gym = 0; gym < 10; gym++)
+            {
+                gSpecialVar_0x8004 = gym; gSpecialVar_0x8005 = 0xBEEF; gSpecialVar_Result = 0xABCD;
+                TaichungHistory_ScriptBufferStaff();
+                assert(strcmp((const char *)gStringVar4,(const char *)gTaichungLandmarkHistory[gym].staff[locale]) == 0);
+                assert(gSpecialVar_0x8004 == gym && gSpecialVar_0x8005 == 0xBEEF && gSpecialVar_Result == 0xABCD);
+                assert(memcmp(savedVars,sSave.vars,sizeof(savedVars)) == 0);
+            }
+            for (helper = 0; helper < sizeof(helpers)/sizeof(helpers[0]); helper++)
+            {
+                gSpecialVar_0x8004 = 0xCAFE; gSpecialVar_0x8005 = 0xBEEF; gSpecialVar_Result = 0xABCD;
+                sShown = NULL; handlers[helper]();
+                assert(sShown == gTaichungLandmarkHistory[helpers[helper]].staff[locale]);
+                assert(gSpecialVar_0x8004 == 0xCAFE && gSpecialVar_0x8005 == 0xBEEF && gSpecialVar_Result == 0xABCD);
+                assert(memcmp(savedVars,sSave.vars,sizeof(savedVars)) == 0);
+            }
+        }
+    }
+    puts("PASS: actual bilingual sign/tour/staff buffers and five installed NPC C handlers, invalid/temple IDs, pre/post-win access and all256 saved vars unchanged");
+    return 0;
+}
