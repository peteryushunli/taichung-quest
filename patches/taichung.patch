+def prepare_maps(book):
+    maps = []
+    owners = {}
+    by_planned_id = {}
+    for index, source in enumerate(book["maps"]):
+        original, key = MAP_BOOK_BINDINGS.get(source["mapConst"], (
+            source["name"], source["mapConst"].removeprefix("MAP_TAICHUNG_"),
+        ))
+        name = "TaichungBlvd" + original.removeprefix("Taichung")
+        game_map = {
+            **source, "nativeName": name, "nativeId": "MAP_TAICHUNG_BLVD_" + key,
+            "index": index, "warps": [], "signs": [], "people": [],
+        }
+        maps.append(game_map)
+        by_planned_id[source["mapConst"]] = game_map
+        w, h = source["size"]
+        require((w + 15) * (h + 14) <= 0x2800, f"Map too large: {name}")
+        for point in points(source["rect"]):
+            require(point not in owners, f"Map overlap at {point}")
+            owners[point] = index
+
+    for game_map in maps:
+        game_map["nativeConnections"] = []
+        x0, y0, x1, y1 = game_map["rect"]
+        for connection in game_map["connections"]:
+            direction = connection["direction"]
+            neighbor = by_planned_id[connection["map"]]
+            xx0, yy0, xx1, yy1 = neighbor["rect"]
+            sidex, sidey = DIRECTIONS[direction]
+            match = (x1 == xx0 if sidex > 0 else x0 == xx1) if sidex else (
+                y1 == yy0 if sidey > 0 else y0 == yy1)
+            offset = yy0 - y0 if sidex else xx0 - x0
+            shared = [max(y0, yy0), min(y1, yy1)] if sidex else [max(x0, xx0), min(x1, xx1)]
+            require(match and shared[0] < shared[1] and shared == connection["shared"]
+                    and connection["offset"] == offset, f"Incorrect connection at {game_map['nativeName']}")
+            opposite = next(key for key, delta in DIRECTIONS.items() if delta == (-sidex, -sidey))
+            require(any(c["map"] == game_map["mapConst"] and c["direction"] == opposite
+                        for c in neighbor["connections"]), "Map connection is missing its reverse.")
+            game_map["nativeConnections"].append({"map": neighbor["nativeId"], "direction": direction,
+                                                   "offset": offset})
+    return maps, owners
+
