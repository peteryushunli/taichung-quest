+++ b/tools/taichung_gameplay/audit-encounter-slice.py
@@ -0,0 +1,185 @@
+#!/usr/bin/env python3
+"""Check the live landmark roster, saved IDs, dispatch and encounter-only odds."""
+from collections import Counter
+from pathlib import Path
+import json
+import re
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[2]
+core = (root / "src/taichung_encounter.c").read_text()
+rows = re.findall(r'\{"([\w-]+)", SPECIES_(\w+), (\d+), \{([^}]+)\}\}', core)
+manifest = json.loads((root / "data/taichung/encounters/sites.json").read_text())
+assert len(rows) == len(manifest["sites"]) == 27
+retired = {2: "EXEGGUTOR", 8: "ONIX", 9: "JYNX", 13: "NINETALES",
+           15: "PORYGON", 18: "VICTREEBEL", 22: "KABUTOPS"}
+assert {row["stableSiteId"]: row["species"] for row in manifest["sites"] if row.get("retired")} == retired
+assert {(row["siteSlug"], row["species"]) for row in manifest["sites"]} >= {
+    ("city-hall", "MEWTWO"), ("tiger-city", "ZAPDOS"),
+    ("cultural-heritage-park", "MOLTRES"), ("wenxin-forest-park", "ARTICUNO"),
+    ("green-museumbrary", "DRAGONITE"),
+}
+ids = dict((s,int(n)) for s,n in re.findall(r'^#define SPECIES_(\w+) (\d+)$', (root / "include/constants/species.h").read_text(), re.M))
+unsafe = {"MOVE_EXPLOSION","MOVE_SELF_DESTRUCT","MOVE_TELEPORT","MOVE_ROAR","MOVE_WHIRLWIND",
+          "MOVE_MEMENTO","MOVE_PERISH_SONG","MOVE_TAKE_DOWN","MOVE_DOUBLE_EDGE","MOVE_SUBSTITUTE",
+          "MOVE_BELLY_DRUM","MOVE_METRONOME","MOVE_MIMIC","MOVE_MIRROR_MOVE","MOVE_SKILL_SWAP"}
+for index, ((slug, species, level, moves), row) in enumerate(zip(rows, manifest["sites"])):
+    slots = re.findall(r'MOVE_\w+', moves)
+    assert (row["stableSiteId"], row["siteSlug"], row["species"], row["speciesDex"], row["level"], row["moves"]) == (
+        index, slug, species, ids[species], int(level), slots)
+    assert 1 <= ids[species] <= 150 and 50 <= int(level) <= 75
+    assert len(slots) == 4 and not unsafe.intersection(slots)
+assert len({species for _, species, _, _ in rows}) == len(rows)
+assert "GetSetPokedexFlag" not in core and "FLAG_GET_CAUGHT" not in core
+
+baseline = subprocess.check_output(["git", "show", "a701ed51:src/taichung_encounter.c"], cwd=root, text=True)
+old_rows = re.findall(r'\{"([\w-]+)", SPECIES_(\w+), (\d+), \{([^}]+)\}\}', baseline)
+assert len(old_rows) == 21
+for index, row in enumerate(old_rows):
+    expected = ("shen-ji-new-village", *row[1:]) if index == 3 else row
+    if index == 0:
+        # Lapras retains its original history/species/level at Botanical Garden;
+        # only the approved place and water-habitat move profile change.
+        expected = ("botanical-garden", row[1], row[2],
+                    "MOVE_SURF, MOVE_ICE_BEAM, MOVE_BODY_SLAM, MOVE_SING")
+    elif index == 13:
+        expected = ("jingming-street-legacy", *row[1:])
+    elif index == 18:
+        expected = ("botanical-garden-victreebel-legacy", *row[1:])
+    assert rows[index] == expected, (index, "historic encounter reinterpreted")
+assert [(row[0], row[1], row[2]) for row in rows[21:]] == [
+    ("national-trade-center", "MAGNETON", "65"),
+    ("ding-sheng-bhw-legacy", "KABUTOPS", "65"), ("the-lin", "PERSIAN", "65"),
+    ("jingming-street", "CHARIZARD", "65"), ("ding-sheng-bhw", "BLASTOISE", "65"),
+    ("maple-garden", "VENUSAUR", "65")]
+for site, expected_moves in {
+    24: ["MOVE_FLAMETHROWER", "MOVE_WING_ATTACK", "MOVE_DRAGON_CLAW", "MOVE_SMOKESCREEN"],
+    25: ["MOVE_SURF", "MOVE_ICE_BEAM", "MOVE_BITE", "MOVE_SKULL_BASH"],
+    26: ["MOVE_SOLAR_BEAM", "MOVE_SLUDGE_BOMB", "MOVE_SUNNY_DAY", "MOVE_SLEEP_POWDER"],
+}.items():
+    assert manifest["sites"][site]["moves"] == expected_moves
+assert manifest["state"] == {
+    "schemaVar": "0x40F3", "marker": "0xEC03", "attemptVar": "0x40F4", "unlockVar": "0x40F5",
+    "legacyMarker": "0xEC01", "attemptUpperVar": "0x40F0", "unlockUpperVar": "0x40F2",
+    "lowBits": 10, "previousMarker": "0xEC02", "previousSupportedMask": "0x00FFFFFF",
+    "extraVar": "0x40EF", "extraAttemptBit": "0x0001", "extraUnlockBit": "0x0100",
+    "extraReservedMask": "0xFEFE", "supportedMask": "0x07FFFFFF",
+}
+assert manifest["bridge"]["version"] == 2 and manifest["bridge"]["size"] == 72
+assert manifest["supportedSiteCount"] == 27 and manifest["allMask"] == "0x07FFFFFF"
+
+script = (root / "data/scripts/taichung_encounters.inc").read_text()
+wrappers = re.findall(r'^\s*taichung_encounter_entry (\w+), (TAICHUNG_ENCOUNTER_\w+)$', script, re.M)
+header = (root / "include/constants/taichung_encounters.h").read_text()
+definitions = dict(re.findall(r'^#define (TAICHUNG_ENCOUNTER_\w+) (0x[0-9A-Fa-f]+|\d+|TAICHUNG_ENCOUNTER_\w+)$', header, re.M))
+def constant(name):
+    value = definitions[name]
+    return constant(value) if value.startswith('TAICHUNG_ENCOUNTER_') else int(value, 0)
+ids_by_constant = {name: constant(name) for name in definitions}
+assert ids_by_constant['TAICHUNG_ENCOUNTER_COUNT'] == manifest['supportedSiteCount'] == len(rows)
+assert ids_by_constant['TAICHUNG_ENCOUNTER_ALL_MASK'] == int(manifest['allMask'], 16) == (1 << 27) - 1
+for name, value in {
+    'SCHEMA_VAR': 0x40F3, 'SCHEMA_V1': 0xEC01, 'SCHEMA_V2': 0xEC02, 'SCHEMA': 0xEC03,
+    'ATTEMPT_VAR': 0x40F4, 'UNLOCK_VAR': 0x40F5,
+    'ATTEMPT_UPPER_VAR': 0x40F0, 'UNLOCK_UPPER_VAR': 0x40F2,
+    'SAVE_LOW_BITS': 10, 'SAVE_LOW_MASK': 0x03FF, 'V2_MASK': 0x00FFFFFF,
+    'EXTRA_VAR': 0x40EF, 'EXTRA_ATTEMPT_BIT': 0x0001, 'EXTRA_UNLOCK_BIT': 0x0100,
+    'EXTRA_USED_MASK': 0x0101, 'EXTRA_RESERVED_MASK': 0xFEFE,
+}.items():
+    assert ids_by_constant['TAICHUNG_ENCOUNTER_' + name] == value
+assert ids_by_constant['TAICHUNG_ENCOUNTER_EXTRA_USED_MASK'] ^ ids_by_constant['TAICHUNG_ENCOUNTER_EXTRA_RESERVED_MASK'] == 0xFFFF
+assert 0x1000 + (ids_by_constant['TAICHUNG_ENCOUNTER_EXTRA_VAR'] - 0x4000) * 2 == 0x11DE
+entry_ids = {"TaichungEncounter_" + name: ids_by_constant[constant] for name, constant in wrappers}
+assert len(entry_ids) == 20 and set(entry_ids.values()) == set(range(27)) - retired.keys()
+offer = script.split('TaichungEncounter_Offer::',1)[1].split('TaichungEncounter_Begin::',1)[0]
+assert 'ScriptBegin' not in offer and 'ScriptSave' not in offer
+assert script.index('goto_if_questlog') < script.index('TaichungEncounter_Offer::')
+assert 'TaichungEncounter_ScriptSaveBegin\n\twaitstate' in script
+assert 'TaichungEncounter_ScriptSaveResult' not in script
+assert 'multichoicedefault 0, 0, MULTICHOICE_TAICHUNG_ENCOUNTER, 1, FALSE' in offer
+assert '\tclosemessage\n\treleaseall\n\tend' in script
+
+battle = (root / "src/battle_script_commands.c").read_text()
+original = subprocess.check_output(['git','show','6ae533a:src/battle_script_commands.c'], cwd=root, text=True)
+def throw_body(text):
+    return text.split('static void Cmd_handleballthrow(void)\n{',1)[1].split('\nstatic void Cmd_givecaughtmon(void)',1)[0]
+restored = throw_body(battle).replace('TaichungEncounterIsActive() ? BattleScript_TaichungEncounterCaught : BattleScript_SuccessBallThrow', 'BattleScript_SuccessBallThrow')
+restored = restored.replace('TaichungEncounterIsActive() && TaichungEncounterGetBalls() == 0\n                    ? BattleScript_TaichungEncounterLastBallFailed : BattleScript_ShakeBallThrow', 'BattleScript_ShakeBallThrow')
+floor = '        if (TaichungEncounterIsActive() && catchRate < TAICHUNG_ENCOUNTER_MIN_CATCH_RATE)\n            catchRate = TAICHUNG_ENCOUNTER_MIN_CATCH_RATE;\n'
+assert floor in restored and '#define TAICHUNG_ENCOUNTER_BALL_ITEM ITEM_ULTRA_BALL' in header
+restored = restored.replace(floor, '')
+assert restored == throw_body(original), 'Native capture odds/RNG calculation changed'
+assert 'TaichungEncounterRecordCapture(species)' in battle
+field = (root / "src/taichung_encounter_field.c").read_text()
+assert not re.search(r'\b(?:AddBagItem|RemoveBagItem|GiveMonToPlayer|SetMonData|GetSetPokedexFlag)\s*\(', field)
+assert field.index('TaichungEncounterBridgeAcked()') < field.index('CreateMon(&gEnemyParty[0]')
+assert 'StartScriptedWildBattle();' in field and 'TaichungExplorationAllowsAutomaticWild' not in field
+assert 'gFieldCallback = FieldCB_PersistEncounterResult;' in field
+assert 'ScriptContext_SetupScript(TaichungEncounter_Result);' in field
+team = (root / "src/taichung_team.c").read_text()
+assert '|| !TaichungEncounterSpeciesSelectable(species)' in team
+assert 'FALSE_SWIPE' in (root / "data/taichung/team-presets/curated.tsv").read_text().split('SCYTHER\t',1)[1].splitlines()[0]
+
+scripts = "\n".join(path.read_text() for path in sorted((root / "data/scripts").glob("*.inc")))
+blocks = dict(re.findall(r'^(\w+)::\s*\n(.*?)(?=^\w+::|\Z)', scripts, re.M | re.S))
+# Historical Temple text must not remain a second route to bit3 after the move.
+assert re.findall(r'^\s*goto (\w+)\s*$', blocks['TaichungStory_Sign13'], re.M)[-1] == 'TaichungStory_SignDone'
+assert re.findall(r'^\s*goto (\w+)\s*$', blocks['TaichungStory_Sign5'], re.M)[-1] == 'TaichungEncounter_ShenJi'
+retired_entry = [line.split('@',1)[0].strip() for line in blocks['TaichungEncounter_ConfuciusTemple'].splitlines()]
+assert [line for line in retired_entry if line and not line.startswith(('.', '#'))][:2] == ['releaseall','end']
+if 'TaichungLandmark_ShenJi' in blocks:
+    assert re.findall(r'^\s*goto (\w+)\s*$', blocks['TaichungLandmark_ShenJi'], re.M)[-1] == 'TaichungStory_Sign5'
+maps = root / "data/maps"
+groups = json.loads((maps / "map_groups.json").read_text())["gMapGroup_Taichung"]
+events = Counter()
+event_positions = {}
+for map_name in groups:
+    record = json.loads((maps / map_name / "map.json").read_text())
+    if map_name.startswith("TaichungBlvd"):
+        events.update(event["script"] for event in record["bg_events"] if event["type"] == "sign")
+        for event in record['bg_events']:
+            if event['type'] == 'sign':
+                event_positions.setdefault(event['script'], []).append((map_name, 'sign', event['x'], event['y']))
+    events.update(event["script"] for event in record["object_events"])
+    for event in record['object_events']:
+        event_positions.setdefault(event['script'], []).append((map_name, 'object', event['x'], event['y']))
+
+if "--registry-only" not in sys.argv:
+    # The approved visible hotel post supplements its retained guide; both
+    # share the same durable one-attempt ID. No other duplicate is allowed.
+    assert sorted(event_positions['TaichungLandmark_TheLin']) == [
+        ('TaichungBlvdTigerCity', 'object', 18, 13),
+        ('TaichungBlvdTigerCity', 'sign', 14, 13),
+    ]
+    for row in manifest["sites"]:
+        site = row["stableSiteId"]
+        binding = row["currentBinding"]
+        if site in retired:
+            assert row["entryScript"] is None and binding is None
+            continue
+        expected_events = 2 if binding == 'TaichungLandmark_TheLin' else 1
+        assert entry_ids[row["entryScript"]] == site and events[binding] == expected_events, binding
+        # Existing city signs dispatch through a history script. New Boulevard
+        # signs set the stable ID directly after presenting the local history.
+        target = binding
+        for _ in range(2):
+            block = blocks[target]
+            target = re.findall(r'^\s*goto (\w+)\s*$', block, re.M)[-1]
+            if target == "TaichungEncounter_Interact":
+                constant = re.findall(r'^\s*setvar VAR_0x8004, (\w+)\s*$', block, re.M)[-1]
+                assert ids_by_constant.get(constant, int(constant) if constant.isdigit() else None) == site
+                break
+            if target == row["entryScript"]:
+                break
+        else:
+            raise AssertionError(f"{binding} does not start the registered encounter")
+
+wild = json.loads((root / "src/data/wild_encounters.json").read_text())["wild_encounter_groups"]
+rare = {"SPECIES_" + row["species"] for row in manifest["sites"] if row["currentBinding"]}
+for group in wild:
+    for table in group["encounters"]:
+        if table["map"].startswith("MAP_TAICHUNG_"):
+            for habitats in (value for value in table.values() if isinstance(value, dict)):
+                assert not rare.intersection(mon["species"] for mon in habitats["mons"])
+print("PASS: 27 profiles/20 active/seven retired save IDs, historical species IDs retained, EC03 history/extra-word allocation and v2/72/27-bit bounds, first-150 roster, gated Team and unchanged Ultra Ball rules; " + ("map bindings deferred to combined Maps slice" if "--registry-only" in sys.argv else "all20 installed map bindings verified"))
