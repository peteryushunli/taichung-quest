+        raise ValueError('Save-v11 manifest must name each of the five changed-bank maps exactly once')
+    integration=json.loads((root/'data/taichung/approved-landmarks/integration-report.json').read_text())
+    if not integration.get('installed') or integration.get('baseline')!=BASELINE:
+        raise ValueError('Expected the installed approved-art layer over the v10 baseline')
+    rules=module(root/'tools/taichung/validate_city.py')
+    current,current_reached=validator(root,rules)
