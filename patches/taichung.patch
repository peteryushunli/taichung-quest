+
+    def habitat_dropped(value):
+        value["habitatRegions"].remove(next(h for h in value["habitatRegions"] if h["map"] == install.MID))
+
+    words = struct.unpack(f"<{len(read(install.MAP)) // 2}H", read(install.MAP))
+    dx, dy = install.SHIFT
+
+    def world_with(x, y, word):
+        return map_with(x + dx, y + dy, word)
+
+    faults = {
+        "highwayCellOpened": ("geometry", world_with(-3, 25, kit["hw-ns-2"])),
+        "wallOpened": ("geometry", world_with(10, 1, 0x3000 | kit["wall-n-upper"])),
+        "kerbWithoutBollards": ("geometry", world_with(3, 17, 0x3000 | kit["st-asphalt"])),
+        "fengjiaArtEdited": ("geometry", world_with(22, 9, 0x3000 | 0x001)),
+        "newSecondaryArt": ("geometry", world_with(7, 55, 0x1000 | 0x2FF)),
+        "parkGrassMown": ("geometry", world_with(7, 28, 0x3001)),
+        "mapleCollisionOpened": ("geometry", world_with(11, 27, words[(27 + dy) * width + 11 + dx] & ~0x0C00)),
+        "mapleApproachClosed": ("geometry", world_with(12, 33, words[(33 + dy) * width + 12 + dx] | 0x0400)),
+        "treeOnPaving": ("geometry", world_with(4, 46, 0x040E)),
+        # A Shen Ji home piece (secondary art) on a stall lot inside Greenway's strip.
+        "secondaryInEastStrip": ("seams", world_with(36, 25, next(words[(y + dy) * width + x + dx] for y in range(20, 24) for x in range(3, 11)
+                                                                    if words[(y + dy) * width + x + dx] & 0x3FF >= 640))),
+        "southSeamClosed": ("seams", world_with(25, 63, 0x0400 | kit["hw-ns-0"])),
+        "warpNotMoved": ("events", json_with(install.MAP_JSON, lambda v: v["warp_events"][0].update(x=24))),
+        "greenwayOffsetToday": ("events", json_with(install.MAP_JSON, lambda v: v["connections"][0].update(offset=35))),
+        "mapleSignNotMoved": ("events", json_with(install.MAP_JSON, maple_sign_back)),
+        "contractDoorNotMoved": ("contract", json_with(install.CONTRACT, door_not_moved)),
+        "parkHabitatDropped": ("contract", json_with(install.CONTRACT, habitat_dropped)),
+        "encounterLevelSix": ("encounters", json_with(install.ENCOUNTERS, level_six)),
+    }
+    results = {}
+    for name, (section, edits) in faults.items():
+        changed = all(read(path) != raw for path, raw in edits.items())
+        report = check(source, edits)
+        results[name] = changed and not report["passed"] and not report["checks"].get(section, {}).get("passed", True)
+    support = load("xitun_rework_probe_support", source / "tools/taichung/landmarks/check_old_core.py")
+    files = support.Files(source)
+    files.cache.update(faults["fengjiaArtEdited"][1])
+    results["underneathRefusesEditedMap"] = underneath(files) == {}
+    return results
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    report = check(args.source)
+    if args.self_test:
+        report["faultProbes"] = self_test(args.source)
+        if not all(report["faultProbes"].values()):
+            report["passed"] = False
+            report["errors"].append("A corruption probe escaped the Xitun rework check")
+    print(json.dumps(report, indent=2))
+    raise SystemExit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
