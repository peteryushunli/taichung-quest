@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+"""Read-only Xitun private-primary feasibility proof against frozen e9a854b.
+
+Only writes isolated analysis artifacts and an unapplied proposal patch. Native
+maps, banks, C, registries, ROMs and saves are never modified.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import difflib
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
+PRIMARY = "data/tilesets/primary/taichung_old_core"
+SECONDARY = "data/tilesets/secondary/taichung_xitun"
+NAMES = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+XITUN = "MAP_TAICHUNG_XITUN"
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(value)
+    return value
+
+
+def flipped(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 + (7-x if flags & 0x400 else x)] for y in range(8) for x in range(8))
+
+
+def canonical(pixels):
+    return min((flipped(pixels, flags), flags) for flags in (0, 0x400, 0x800, 0xC00))
+
+
+def analyze(source, output):
+    helper = module("xitun_private_primary_bank", ROOT / "tools/taichung/landmarks/check_old_core.py")
+    strips = module("xitun_private_primary_strips", ROOT / "tools/taichung/landmarks/analyze_theater_cohort.py")
+    files = helper.Files(source, BASE)
+    audit = files.json("data/taichung/landmarks/old-core-bank-audit.json")
+    reserved = set(audit["primaryConservativeRawHoleOption"]["requiredRawGraphicIds"]) | set(audit["generalAnimation"]["fixedGraphicIds"])
+    animated = set(audit["generalAnimation"]["fixedGraphicIds"])
+    free = sorted(set(range(640)) - reserved)
+    assert len(reserved) == 228 and len(animated) == 70 and len(free) == 412
+    current = helper.Bank(files, PRIMARY, SECONDARY)
+    simulated = deepcopy(current)
+    simulated.render_cache = {}
+    lookup = {}
+    for n in sorted(reserved - animated):
+        pixels, flags = canonical(current.graphic(n))
+        lookup.setdefault(pixels, (n, flags))
+    allocated, relocation, reused = [], {}, set()
+    all_secondary_refs = {entry & 1023 for n in range(640, 640 + len(current.attrs[1])) for entry in current.entries(n) if entry & 1023 >= 640}
+    for old in sorted(all_secondary_refs):
+        pixels, flags = canonical(current.graphic(old))
+        if pixels not in lookup:
+            n = free[len(allocated)]
+            allocated.append(n)
+            image = simulated.images[0]
+            for y in range(8):
+                for x in range(8):
+                    image.putpixel((n % (image.width // 8)*8+x, n // (image.width // 8)*8+y), pixels[y*8+x])
+            lookup[pixels] = n, 0
+        else:
+            reused.add(old)
+        n, stored_flags = lookup[pixels]
+        relocation[old] = n | (flags ^ stored_flags)
+    for i, entry in enumerate(simulated.defs[1]):
+        old = entry & 1023
+        if old >= 640:
+            packed = relocation[old]
+            simulated.defs[1][i] = (entry & 0xF000) | ((entry & 0xC00) ^ (packed & 0xC00)) | (packed & 1023)
+    preserved = list(audit["primaryConservativeRawHoleOption"]["generalMetatileIdsToKeepCompatible"])
+    ids = preserved + list(range(640, 640 + len(current.attrs[1])))
+    assert all(simulated.render(n) == current.render(n) and simulated.attr(n) == current.attr(n) for n in ids)
+    assert all(simulated.graphic(n) == current.graphic(n) for n in reserved)
+    assert all(entry & 1023 < 640 for entry in simulated.defs[1])
+
+    layouts = {l["id"]: l for l in files.json("data/layouts/layouts.json")["layouts"] if "id" in l}
+    scenes = {}
+    for name in NAMES:
+        data = files.json(f"data/maps/{name}/map.json")
+        layout = layouts[data["layout"]]
+        p, _ = helper.resolved_folder(files, layout["primary_tileset"])
+        s, _ = helper.resolved_folder(files, layout["secondary_tileset"])
+        scenes[data["id"]] = {"data": data, "layout": layout, "words": files.words(layout["blockdata_filepath"]),
+                              "border": files.words(layout["border_filepath"]), "bank": helper.Bank(files, p, s)}
+    xitun = scenes[XITUN]
+    def usage(words):
+        metas = {w & 1023 for w in words}
+        refs = {e & 1023 for n in metas for e in current.entries(n)}
+        return {"metatileIds": sorted(metas), "secondaryMetatileIds": sorted(n for n in metas if n >= 640),
+                "graphicIds": sorted(refs), "secondaryGraphicIds": sorted(n for n in refs if n >= 640),
+                "palettes": sorted({e >> 12 for n in metas for e in current.entries(n)})}
+    records, incoming, donated = [], [], set()
+    for mid, view in scenes.items():
+        for c in view["data"]["connections"]:
+            donor = scenes[c["map"]]
+            points = list(strips.visible_cells(view["layout"], donor["layout"], c["direction"], c["offset"]))
+            words = [donor["words"][y * donor["layout"]["width"] + x] for x, y in points]
+            vb = simulated if mid == XITUN else view["bank"]
+            db = simulated if c["map"] == XITUN else donor["bank"]
+            metas = {w & 1023 for w in words}
+            equal = all(vb.render(n) == db.render(n) and vb.attr(n) == db.attr(n) for n in metas)
+            raw_equal = all(vb.entries(n) == db.entries(n) for n in metas)
+            assert equal
+            records.append({"viewer": mid, "donor": c["map"], "donorBoundsInclusive": strips.bounds(points),
+                            "cells": len(points), "metatileIds": sorted(metas), "renderAndAttributesEqual": equal,
+                            "entryWordsIdenticalAfterSimulatedRepack": raw_equal})
+            if mid == XITUN:
+                incoming.extend(words)
+            if c["map"] == XITUN:
+                donated.update(metas)
+    needed_words = xitun["words"] + xitun["border"] + incoming
+    own = usage(needed_words)
+    contract = files.json("docs/taichung-city-contract.json")
+    future = [l for l in contract["landmarks"] if l["id"] in ("fengjia-night-market", "maple-garden")]
+    cleared = xitun["words"][:]
+    for landmark in future:
+        x0, y0, x1, y1 = landmark["footprint"]
+        for y in range(y0, y1 + 1):
+            for x in range(x0, x1 + 1):
+                cleared[y * 40 + x] = 0x3175
+    post_clear = usage(cleared + xitun["border"] + incoming)
+    active_theater = {n for n in own["metatileIds"] if 719 <= n < 879}
+    primary_conflicts = []
+    groups = files.json("data/maps/map_groups.json")
+    maps = {name: files.json(f"data/maps/{name}/map.json") for group in groups["group_order"] for name in groups[group]}
+    by_id = {data["id"]: data for data in maps.values()}
+    for data in maps.values():
+        for c in data.get("connections") or []:
+            other = by_id[c["map"]]
+            a, b = layouts[data["layout"]]["primary_tileset"], layouts[other["layout"]]["primary_tileset"]
+            if a != b:
+                primary_conflicts.append({"from": data["id"], "to": other["id"], "primary": a, "otherPrimary": b})
+
+    overworld = files.text("src/overworld.c")
+    match = re.search(r"void LoadMapFromCameraTransition\([^)]*\)\s*\{.*?\n\}", overworld, re.S)
+    original = match.group(0)
+    proposal = original.replace("    int paletteIndex;", "    const struct Tileset *oldPrimaryTileset = gMapHeader.mapLayout->primaryTileset;\n    bool8 primaryTilesetChanged;\n    int paletteIndex;", 1)
+    old = """    CopySecondaryTilesetToVramUsingHeap(gMapHeader.mapLayout);
+    LoadSecondaryTilesetPalette(gMapHeader.mapLayout);
+    for (paletteIndex = 7; paletteIndex < 13; paletteIndex++)
+        ApplyWeatherGammaShiftToPal(paletteIndex);
+    InitSecondaryTilesetAnimation();"""
+    new = """    primaryTilesetChanged = oldPrimaryTileset != gMapHeader.mapLayout->primaryTileset;
+    if (primaryTilesetChanged)
+    {
+        CopyMapTilesetsToVram(gMapHeader.mapLayout);
+        LoadMapTilesetPalettes(gMapHeader.mapLayout);
+    }
+    else
+    {
+        CopySecondaryTilesetToVramUsingHeap(gMapHeader.mapLayout);
+        LoadSecondaryTilesetPalette(gMapHeader.mapLayout);
+    }
+    for (paletteIndex = primaryTilesetChanged ? 0 : 7; paletteIndex < 13; paletteIndex++)
+        ApplyWeatherGammaShiftToPal(paletteIndex);
+    if (primaryTilesetChanged)
+        InitTilesetAnimations();
+    else
+        InitSecondaryTilesetAnimation();"""
+    assert old in proposal
+    proposal = proposal.replace(old, new, 1)
+    changed = overworld[:match.start()] + proposal + overworld[match.end():]
+    patch = "".join(difflib.unified_diff(overworld.splitlines(True), changed.splitlines(True), fromfile="a/src/overworld.c", tofile="b/src/overworld.c"))
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "conditional-primary-transition-proposal.patch").write_text(patch)
+    report = {
+        "baselineCommit": BASE, "scope": "Read-only static relocation simulation; no C/source/ROM/save changes or runtime proof.",
+        "graphics": {"protectedPrimarySlots": len(reserved), "protectedAnimationSlots": len(animated),
+                     "availablePrimaryHoles": len(free), "currentSecondaryReferencedRawSlotsAcrossAllDefinitions": len(all_secondary_refs),
+                     "exactReuseOfProtectedStaticPrimary": len(reused), "allocatedPrimaryHoles": len(allocated),
+                     "remainingPrimaryHoles": len(free) - len(allocated), "requiredSecondaryGraphicsAfterRelocation": 0,
+                     "futureStaticSecondaryCapacity": 376, "doorScratchGlobalIdsInclusive": [1016, 1023],
+                     "oldToNewGraphicEntries": {str(k): v for k, v in sorted(relocation.items())}},
+        "metatiles": {"preservedGeneralClosureCount": len(preserved), "preservedCurrentSecondaryDefinitionCount": len(current.attrs[1]),
+                      "allPreservedMetatileRgbAndAttributesEqual": True, "mapWordsOrIdsChangedBySimulation": False,
+                      "sourcePewterReservationInclusive": [640, 718], "theaterReservationInclusive": [719, 878],
+                      "unusedSecondaryDefinitionSlotsAfter878": 1024 - 879,
+                      "privatePrimaryDefinitionIdsOutsideProtectedGeneralClosure": len(set(range(640)) - set(preserved)),
+                      "primaryDefinitionAllocationNeedsSeparateIdContract": True,
+                      "actualTheaterIdsInScene": sorted(active_theater),
+                      "currentlyUnreferencedTheaterDefinitionCount": 160 - len(active_theater),
+                      "reuseUnreferencedDefinitionsRequiresExplicitContract": True},
+        "sceneUsageCurrent": own, "sceneUsageAfterAnalyticalFuturePlaceholderClearance": post_clear,
+        "palettes": {"theaterPalette7MustRemainExact": True, "primary0to6MustRemainExact": True,
+                     "currentScenePalettes": own["palettes"], "remainingScenePalettesAfterBothClearances": post_clear["palettes"],
+                     "freeSecondaryPalettesNow": [p for p in range(7, 13) if p not in own["palettes"]],
+                     "freeSecondaryPalettesAfterBothClearances": [p for p in range(7, 13) if p not in post_clear["palettes"]],
+                     "noSharedPaletteWithGreenwayRequiredForPrivateArtOutsideStrips": True,
+                     "newArtworkColorNeedsNotMeasured": True},
+        "connectionProof": records, "preexistingDifferentPrimaryDirectedConnections": primary_conflicts,
+        "engine": {"existingSecondaryUploadMaximumBytes": 384*32, "fullPrimaryUploadBytes": 640*32,
+                   "combinedUploadMaximumBytes": 1024*32, "dmaManagerPerVblankByteLimit": 40*1024,
+                   "additionalTransientHeapBytesForFullPrimary": 640*32,
+                   "minimumAdditionalFreeTaskSlots": 1,
+                   "atomicSameVblankCompletionProven": False,
+                   "latchedTilemapRawReferenceCompatibilityRequired": True,
+                   "objectPalettes16to31MustNotBeReloadedByBackgroundBranch": True},
+        "save": {"frozenVersion": int(re.search(r"#define TAICHUNG_SAVE_VERSION\s+(\d+)", files.text("include/taichung_save.h")).group(1)),
+                 "graphicsOnlyRelocationPreservesEveryExistingMapWordAndMetatileMeaning": True,
+                 "graphicsOnlyRelocationRequiresNoSaveStructFormatChange": True,
+                 "newFengjiaMapleGeometryOrReusedMetatileIdsRequireMainVersionedCacheAndPositionMigration": True,
+                 "versionVarOwnedByMain": "0x40F7", "noMigrationImplemented": True},
+        "proposal": {"file": "conditional-primary-transition-proposal.patch", "applied": False,
+                     "newPublicApiRequired": False, "runtimeAcceptanceRequired": True},
+    }
+    # Record engine bodies as exact frozen inputs even where the prose analysis
+    # discusses them rather than making a machine-executable runtime assertion.
+    for path in ("src/fieldmap.c", "src/field_camera.c", "src/new_menu_helpers.c", "src/dma3_manager.c", "src/main.c", "src/tileset_anims.c", "src/field_weather.c", "src/event_object_movement.c", "src/taichung_save.c", "include/fieldmap.h"):
+        files.read(path)
+    report["frozenInputSha256"] = {path: hashlib.sha256(raw).hexdigest() for path, raw in sorted(files.cache.items())}
+    (output / "analysis.json").write_text(json.dumps(report, indent=2) + "\n")
+    return report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--output", type=Path, default=ROOT.parents[1] / "artifacts/worktrees/c291d4842985/xitun-primary-plan")
+    args = parser.parse_args()
+    result = analyze(args.source.resolve(), args.output)
+    print(json.dumps({"graphics": {k: v for k, v in result["graphics"].items() if k != "oldToNewGraphicEntries"},
+                      "metatiles": {k: v for k, v in result["metatiles"].items() if k != "actualTheaterIdsInScene"},
+                      "palettes": result["palettes"], "preexistingDifferentPrimaryDirectedConnections": result["preexistingDifferentPrimaryDirectedConnections"],
+                      "output": str(args.output)}, indent=2))
diff --git a/tools/taichung/landmarks/audit_old_core_primary.py b/tools/taichung/landmarks/audit_old_core_primary.py
