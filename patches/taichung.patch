+            for target in mapping.values():
+                checks.require(all((entry&1023) not in animated for entry in bank.entries(number(target))), f"Static {family} color artwork reuses a General animation destination")
+        return {"primaryGraphics": 640, "secondaryGraphicsLoaded": loaded, "secondaryDefinitions": len(bank.attrs[1]), "checkedReferences": counts["checkedGraphicReferences"], "staticReferencesBelow1016": True, "sharedPalette7Matches": True}
