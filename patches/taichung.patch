diff --git a/src/tile_stream.c b/src/tile_stream.c
new file mode 100644
index 00000000..d6e60448
--- /dev/null
+++ b/src/tile_stream.c
@@ -0,0 +1,866 @@
+#include "global.h"
+#include "gflib.h"
+#include "blend_palette.h"
+#include "field_weather.h"
+#include "fieldmap.h"
+#include "main.h"
+#include "overworld.h"
+#include "tile_stream.h"
+
+// See include/tile_stream.h for what this is for.
+//
+// Tile slots are the 1,024 tiles the three map layers can address from
+// character base 0. A few are pinned: tile 0 (the transparent tile every
+// empty layer points at), the primary tileset's animated tiles (their frames
+// are copied to fixed places), and the last eight (door animation frames).
+// The rest are handed out on demand.
+//
+// A slot whose last reference goes away keeps its tile and joins the tail of
+// a free list; a new tile takes the slot at the head. So a tile that scrolls
+// off and back within a few steps is not copied again, and a slot released
+// this frame is the last one to be overwritten. That matters because tiles
+// are written to VRAM at once while the tilemap in VRAM is one frame behind.
+//
+// Palettes work the same way over the 13 map palette slots.
+
+#define NUM_TILE_SLOTS   NUM_TILES_TOTAL
+#define NUM_PAL_SLOTS    NUM_PALS_TOTAL
+#define DOOR_TILE_SLOTS  8
+#define SLOT_NONE        0xFFFF
+#define REFS_PINNED      0xFFFF
+#define HASH_BUCKETS     1024
+#define TILE_BANK_MASK   0x3F  // low six bits of a bank byte: tile number bits 10-15
+#define PAL_BANK_SHIFT   6     // high two bits: palette number bits 4-5
+#define MAX_PALETTES     64
+#define PAL_NONE         0xFF
+
+// What the drawing loop reads for every tile, kept together and eight bytes
+// long so one shift finds a slot.
+struct TileSlot
+{
+    u16 tile;      // tile number held, SLOT_NONE if never loaded
+    u16 refs;      // tilemap cells using the slot, or REFS_PINNED
+    u16 hashNext;  // next slot whose tile falls in the same hash bucket
+    u16 freePrev;  // free list link, meaningful while refs is 0
+};
+
+// The 32x32 tilemap holds 16x16 metatiles.
+#define NUM_SHOWN_CELLS 256
+#define SHOWN_CELL(offset) ((((offset) >> 6) << 4) | (((offset) & 0x1F) >> 1))
+
+// A map cell whose drawing was put off to a later frame.
+#define MAX_DEFERRED 32
+
+struct DeferredCell
+{
+    u16 offset; // into the 32x32 tilemap buffers
+    s16 x;      // map position, as MapGridGetMetatileIdAt takes it
+    s16 y;
+};
+
+struct TileStreamState
+{
+    const struct Tileset *primary;
+    const struct Tileset *secondary;
+    u16 palRefs[NUM_PAL_SLOTS];
+    u8 palSlotOf[MAX_PALETTES];    // palette number -> slot, PAL_NONE if not loaded
+    u16 palVirt[NUM_PAL_SLOTS];
+    u16 freeHead;
+    u16 freeTail;
+    u32 palFreedAt[NUM_PAL_SLOTS];
+    u32 clock;
+    u16 shown[NUM_SHOWN_CELLS];    // metatile each 2x2 block of the tilemap shows, SLOT_NONE if something else
+    u16 deferredHead;              // cells waiting to be drawn, oldest first
+    u16 deferredCount;
+    struct DeferredCell deferred[MAX_DEFERRED];
+    u16 hashHead[HASH_BUCKETS];    // tile number -> slot, chained through hashNext
+    struct TileSlot slots[NUM_TILE_SLOTS];
+    u16 freeNext[NUM_TILE_SLOTS];
+};
+
+static EWRAM_DATA struct TileStreamState *sState = NULL;
+static EWRAM_DATA bool8 sActive = FALSE;
+static EWRAM_DATA bool8 sRedrawRequested = FALSE;
+EWRAM_DATA struct TileStreamStats gTileStreamStats = {0};
+
+// ------------------------------------------------- probe instrumentation
+// Timer 2 is not used by anything else in the game. It runs at one tick per
+// 64 cycles, so a 16-bit difference covers about fifteen frames.
+void TileStream_ClockStart(void)
+{
+    REG_TM2CNT_H = 0;
+    REG_TM2CNT_L = 0;
+    REG_TM2CNT_H = TIMER_ENABLE | TIMER_64CLK;
+}
+
+u32 TileStream_Clock(void)
+{
+    return REG_TM2CNT_L;
+}
+
+static EWRAM_DATA u32 sFrameStart = 0;
+static EWRAM_DATA u32 sFrameVblank = 0;
+static EWRAM_DATA u32 sFrameDraw = 0;
+static EWRAM_DATA u32 sFrameCells = 0;
+
+void TileStream_FrameBegin(void)
+{
+    if (!(REG_TM2CNT_H & TIMER_ENABLE))
+        TileStream_ClockStart();
+    gTileStreamStats.frameFlags = 0;
+    sFrameDraw = gTileStreamStats.metatileSum;
+    sFrameCells = gTileStreamStats.metatilesDrawn;
+    gTileStreamStats.frameLoads = gTileStreamStats.tileLoads + gTileStreamStats.palLoads;
+    sFrameVblank = gMain.vblankCounter2;
+    sFrameStart = TileStream_Clock();
+}
+
+void TileStream_FrameEnd(void)
+{
+    struct TileStreamStats *st = &gTileStreamStats;
+    u32 cycles = TILE_STREAM_ELAPSED(sFrameStart);
+    u32 flags = st->frameFlags;
+
+    st->mainLoops++;
+    st->vblanks = gMain.vblankCounter2;
+    if ((flags & TILE_STREAM_FRAME_FIELD) && !(flags & (TILE_STREAM_FRAME_WHOLE | TILE_STREAM_FRAME_SEAM)))
+    {
+        st->fieldFrames++;
+        st->fieldFrameSum += cycles;
+        if (flags & TILE_STREAM_FRAME_SLICE)
+        {
+            if (cycles > st->maxSliceFrame)
+                st->maxSliceFrame = cycles;
+        }
+        else if (cycles > st->maxPlainFrame)
+        {
+            st->maxPlainFrame = cycles;
+        }
+    }
+    if (gMain.vblankCounter2 != sFrameVblank)
+    {
+        struct TileStreamLateFrame *late = &st->late[st->lateIndex++ % ARRAY_COUNT(st->late)];
+
+        st->lateFrames++;
+        late->frameCycles = cycles;
+        late->drawCycles = st->metatileSum - sFrameDraw;
+        late->flags = flags;
+        late->cells = (st->metatilesDrawn - sFrameCells) | ((st->tileLoads + st->palLoads - st->frameLoads) << 8);
+    }
+}
+
+bool32 TileStream_IsLayoutStreamed(const struct MapLayout *layout)
+{
+    return layout != NULL
+        && layout->secondaryTileset != NULL
+        && layout->secondaryTileset->streamBanks != NULL
+        && layout->primaryTileset != NULL
+        && !layout->primaryTileset->isCompressed
+        && !layout->secondaryTileset->isCompressed;
+}
+
+bool32 TileStream_IsActive(void)
+{
+    return sActive;
+}
+
+bool32 TileStream_TakeRedrawRequest(void)
+{
+    bool32 requested = sRedrawRequested;
+
+    sRedrawRequested = FALSE;
+    return requested;
+}
+
+// ---------------------------------------------------------------- tiles
+
+static void FreeListAppend(u32 slot)
+{
+    struct TileStreamState *s = sState;
+
+    s->freeNext[slot] = SLOT_NONE;
+    s->slots[slot].freePrev = s->freeTail;
+    if (s->freeTail != SLOT_NONE)
+        s->freeNext[s->freeTail] = slot;
+    else
+        s->freeHead = slot;
+    s->freeTail = slot;
+}
+
+static void FreeListRemove(u32 slot)
+{
+    struct TileStreamState *s = sState;
+    u32 prev = s->slots[slot].freePrev;
+    u32 next = s->freeNext[slot];
+
+    if (prev != SLOT_NONE)
+        s->freeNext[prev] = next;
+    else
+        s->freeHead = next;
+    if (next != SLOT_NONE)
+        s->slots[next].freePrev = prev;
+    else
+        s->freeTail = prev;
+}
+
+static void HashInsert(u32 slot)
+{
+    struct TileStreamState *s = sState;
+    u32 bucket = s->slots[slot].tile % HASH_BUCKETS;
+
+    s->slots[slot].hashNext = s->hashHead[bucket];
+    s->hashHead[bucket] = slot;
+}
+
+static void HashRemove(u32 slot)
+{
+    struct TileStreamState *s = sState;
+    u32 bucket = s->slots[slot].tile % HASH_BUCKETS;
+    u32 cur = s->hashHead[bucket];
+
+    if (cur == slot)
+    {
+        s->hashHead[bucket] = s->slots[slot].hashNext;
+        return;
+    }
+    while (cur != SLOT_NONE)
+    {
+        if (s->slots[cur].hashNext == slot)
+        {
+            s->slots[cur].hashNext = s->slots[slot].hashNext;
+            return;
+        }
+        cur = s->slots[cur].hashNext;
+    }
+}
+
+static const u32 *TileSource(u32 tile)
+{
+    struct TileStreamState *s = sState;
+
+    if (tile < NUM_TILES_IN_PRIMARY)
+        return &s->primary->tiles[tile * (TILE_SIZE_4BPP / 4)];
+    tile -= NUM_TILES_IN_PRIMARY;
+    if (tile >= s->secondary->streamNumTiles)
+        return NULL;
+    return &s->secondary->tiles[tile * (TILE_SIZE_4BPP / 4)];
+}
+
+static void CopyTileToSlot(const u32 *src, u32 slot)
+{
+    u32 *dst = (u32 *)(BG_VRAM + TILE_OFFSET_4BPP(slot));
+
+    // Eight words written out: cheaper than a BIOS call for one tile.
+    dst[0] = src[0];
+    dst[1] = src[1];
+    dst[2] = src[2];
+    dst[3] = src[3];
+    dst[4] = src[4];
+    dst[5] = src[5];
+    dst[6] = src[6];
+    dst[7] = src[7];
+    gTileStreamStats.tileLoads++;
+}
+
+static void PinSlot(u32 slot, bool32 loadTile)
+{
+    struct TileStreamState *s = sState;
+
+    if (s->slots[slot].refs == REFS_PINNED)
+        return;
+    s->slots[slot].refs = REFS_PINNED;
+    if (loadTile)
+    {
+        s->slots[slot].tile = slot;
+        HashInsert(slot);
+        CopyTileToSlot(TileSource(slot), slot);
+    }
+}
+
+// The two functions below are the uncommon half of acquiring a tile or a
+// palette. The common half, a tile or palette the draw window already uses,
+// is written out in TileStream_DrawMetatile.
+
+// slot is where the hash table has the tile, if it has it (then nothing uses
+// it at the moment). Returns the slot now holding the tile, 0 (transparent)
+// for a tile number the tileset does not have, or SLOT_NONE if every slot is
+// in use by the draw window.
+static u32 AcquireIdleOrNewTile(u32 tile, u32 slot)
+{
+    struct TileStreamState *s = sState;
+    const u32 *src;
+
+    if (slot != SLOT_NONE)
+    {
+        FreeListRemove(slot);
+    }
+    else
+    {
+        src = TileSource(tile);
+        slot = s->freeHead;
+        if (src == NULL)
+            return 0;
+        if (slot == SLOT_NONE)
+            return SLOT_NONE;
+        FreeListRemove(slot);
+        if (s->slots[slot].tile != SLOT_NONE)
+            HashRemove(slot);
+        s->slots[slot].tile = tile;
+        HashInsert(slot);
+        CopyTileToSlot(src, slot);
+    }
+    s->slots[slot].refs = 1;
+    if (++gTileStreamStats.residentTiles > gTileStreamStats.peakTiles)
+        gTileStreamStats.peakTiles = gTileStreamStats.residentTiles;
+    return slot;
+}
+
+// ------------------------------------------------------------- palettes
+
+static void LoadPaletteIntoSlot(u32 slot, u32 pal)
+{
+    struct TileStreamState *s = sState;
+    const u16 *src;
+
+    if (pal < NUM_PALS_IN_PRIMARY)
+        src = s->primary->palettes[pal];
+    else if (pal < s->secondary->streamNumPalettes)
+        src = s->secondary->palettes[pal];
+    else
+        src = s->primary->palettes[0];
+    LoadPalette(src, BG_PLTT_ID(slot), PLTT_SIZE_4BPP);
+    if (slot == 0)
+    {
+        // Colour 0 of palette 0 is the backdrop; the map loader keeps it black.
+        gPlttBufferUnfaded[0] = RGB_BLACK;
+        gPlttBufferFaded[0] = RGB_BLACK;
+    }
+    ApplyGlobalTintToPaletteSlot(slot, 1);
+    ApplyWeatherGammaShiftToPal(slot);
+    // A palette that arrives in the middle of a screen fade joins it part-way.
+    if (gPaletteFade.active && gPaletteFade.mode == 0 && (gPaletteFade.multipurpose1 & (1 << slot)))
+        BlendPalette(BG_PLTT_ID(slot), 16, gPaletteFade.y, gPaletteFade.blendColor);
+    gTileStreamStats.palLoads++;
+}
+
+// Returns the slot now holding the palette, or PAL_NONE if all thirteen are
+// in use by the draw window.
+static u32 AcquireIdleOrNewPalette(u32 pal)
+{
+    struct TileStreamState *s = sState;
+    u32 slot = s->palSlotOf[pal];
+    u32 i;
+
+    if (slot == PAL_NONE)
+    {
+        slot = SLOT_NONE;
+        for (i = 0; i < NUM_PAL_SLOTS; i++)
+        {
+            if (s->palRefs[i] == 0 && (slot == SLOT_NONE || s->palFreedAt[i] < s->palFreedAt[slot]))
+                slot = i;
+        }
+        if (slot == SLOT_NONE)
+            return PAL_NONE;
+        if (s->palVirt[slot] != SLOT_NONE)
+            s->palSlotOf[s->palVirt[slot]] = PAL_NONE;
+        s->palVirt[slot] = pal;
+        s->palSlotOf[pal] = slot;
+        LoadPaletteIntoSlot(slot, pal);
+    }
+    s->palRefs[slot] = 1;
+    if (++gTileStreamStats.residentPals > gTileStreamStats.peakPals)
+        gTileStreamStats.peakPals = gTileStreamStats.residentPals;
+    return slot;
+}
+
+// Something reloaded the map palettes wholesale (returning from a tint, say).
+void TileStream_ReloadPalettes(void)
+{
+    u32 slot;
+
+    if (!sActive)
+        return;
+    for (slot = 0; slot < NUM_PAL_SLOTS; slot++)
+    {
+        if (sState->palVirt[slot] != SLOT_NONE)
+            LoadPaletteIntoSlot(slot, sState->palVirt[slot]);
+    }
+}
+
+// ------------------------------------------------------------ metatiles
+
+static const u8 sCellOffsets[] = {0, 1, 0x20, 0x21};
+
+// Writes four tilemap entries (or four empty ones) over a 2x2 block of one
+// layer and gives back what those cells held. A cell that is not tile 0
+// holds one reference to its tile slot and one to its palette slot.
+static void WriteLayer(u16 *cells, const u16 *entries, u32 empty)
+{
+    struct TileStreamState *s = sState;
+    u32 i, old, slot, refs;
+
+    for (i = 0; i < ARRAY_COUNT(sCellOffsets); i++)
+    {
+        u16 *cell = &cells[sCellOffsets[i]];
+
+        old = *cell;
+        *cell = entries != NULL ? entries[i] : empty;
+        slot = old & 0x3FF;
+        if (slot == 0)
+            continue;
+        refs = s->slots[slot].refs;
+        if (refs != REFS_PINNED && refs != 0)
+        {
+            s->slots[slot].refs = --refs;
+            if (refs == 0)
+            {
+                FreeListAppend(slot);
+                gTileStreamStats.residentTiles--;
+            }
+        }
+        slot = old >> 12;
+        if (slot < NUM_PAL_SLOTS && (refs = s->palRefs[slot]) != 0)
+        {
+            s->palRefs[slot] = --refs;
+            if (refs == 0)
+            {
+                s->palFreedAt[slot] = ++s->clock;
+                gTileStreamStats.residentPals--;
+            }
+        }
+    }
+}
+
+// Empties a 2x2 block on all three layers, giving back what it held.
+static void ClearLayers(u32 offset)
+{
+    WriteLayer(&gBGTilemapBuffers3[offset], NULL, 0);
+    WriteLayer(&gBGTilemapBuffers1[offset], NULL, 0);
+    WriteLayer(&gBGTilemapBuffers2[offset], NULL, 0);
+}
+
+// Under the middle layer of a normal metatile the game draws tile 0x14 of
+// palette 3, which nothing sees. A streamed map has no fixed tile or palette
+// there, so it draws the transparent tile instead.
+static void WriteLayers(u32 layerType, const u16 *entries, u32 offset)
+{
+    u16 *bottom = &gBGTilemapBuffers3[offset];
+    u16 *middle = &gBGTilemapBuffers1[offset];
+    u16 *top = &gBGTilemapBuffers2[offset];
+
+    switch (layerType)
+    {
+    case METATILE_LAYER_TYPE_SPLIT:
+        WriteLayer(bottom, entries, 0);
+        WriteLayer(middle, NULL, 0);
+        WriteLayer(top, entries + 4, 0);
+        break;
+    case METATILE_LAYER_TYPE_COVERED:
+        WriteLayer(bottom, entries, 0);
+        WriteLayer(middle, entries + 4, 0);
+        WriteLayer(top, NULL, 0);
+        break;
+    default:
+        WriteLayer(bottom, NULL, 0);
+        WriteLayer(middle, entries, 0);
+        WriteLayer(top, entries + 4, 0);
+        break;
+    }
+}
+
+// Draws one metatile at a tilemap offset on all three map layers, loading
+// whatever tiles and palettes are not in VRAM yet. The new entries are taken
+// before the old cells are given back, so a tile in both never drops out.
+void TileStream_DrawMetatile(const struct MapLayout *layout, u32 metatileId, u32 offset)
+{
+    struct TileStreamState *s = sState;
+    const struct Tileset *tileset;
+    const u16 *src;
+    const u8 *banks;
+    u16 entries[NUM_TILES_PER_METATILE];
+    u32 i, raw, bank, tile, slot, refs, pal, palSlot;
+    bool32 released = FALSE;
+#if TILE_STREAM_PROBE
+    u32 start = TileStream_Clock();
+    u32 loads = gTileStreamStats.tileLoads + gTileStreamStats.palLoads;
+#endif
+
+    // Roads, paving and grass repeat: a cell that already shows this metatile
+    // holds the same tilemap entries it would be given again.
+    if (s->shown[SHOWN_CELL(offset)] == metatileId)
+    {
+#if TILE_STREAM_PROBE
+        gTileStreamStats.cellsUnchanged++;
+#endif
+        return;
+    }
+    s->shown[SHOWN_CELL(offset)] = metatileId;
+
+    if (metatileId < NUM_METATILES_IN_PRIMARY)
+    {
+        tileset = layout->primaryTileset;
+    }
+    else
+    {
+        tileset = layout->secondaryTileset;
+        metatileId -= NUM_METATILES_IN_PRIMARY;
+        if (tileset->streamBanks != NULL && metatileId >= tileset->streamNumMetatiles)
+            metatileId = 0;
+    }
+    src = &tileset->metatiles[metatileId * NUM_TILES_PER_METATILE];
+    banks = tileset->streamBanks;
+    if (banks != NULL)
+        banks += metatileId * NUM_TILES_PER_METATILE;
+
+    for (i = 0; i < NUM_TILES_PER_METATILE; i++)
+    {
+        raw = src[i];
+        bank = banks != NULL ? banks[i] : 0;
+        tile = ((bank & TILE_BANK_MASK) << 10) | (raw & 0x3FF);
+        if (tile == 0)
+        {
+            entries[i] = 0;
+            continue;
+        }
+        slot = s->hashHead[tile % HASH_BUCKETS];
+        while (slot != SLOT_NONE && s->slots[slot].tile != tile)
+            slot = s->slots[slot].hashNext;
+        if (slot != SLOT_NONE && (refs = s->slots[slot].refs) != 0)
+        {
+            if (refs != REFS_PINNED)
+                s->slots[slot].refs = refs + 1;
+        }
+        else
+        {
+            refs = slot;
+            slot = AcquireIdleOrNewTile(tile, refs);
+            if (slot == SLOT_NONE)
+            {
+                // Nothing free. What this cell holds now is about to go
+                // anyway: give it back first and try once more.
+                if (!released)
+                {
+                    ClearLayers(offset);
+                    released = TRUE;
+                    slot = AcquireIdleOrNewTile(tile, refs);
+                }
+                if (slot == SLOT_NONE)
+                {
+                    gTileStreamStats.overflowTiles++;
+                    s->shown[SHOWN_CELL(offset)] = SLOT_NONE; // drawn short: draw again when asked
+                    slot = 0;
+                }
+            }
+            if (slot == 0)
+            {
+                entries[i] = 0;
+                continue;
+            }
+        }
+        pal = (raw >> 12) | ((bank >> PAL_BANK_SHIFT) << 4);
+        palSlot = s->palSlotOf[pal];
+        if (palSlot != PAL_NONE && (refs = s->palRefs[palSlot]) != 0)
+        {
+            s->palRefs[palSlot] = refs + 1;
+        }
+        else
+        {
+            palSlot = AcquireIdleOrNewPalette(pal);
+            if (palSlot == PAL_NONE && !released)
+            {
+                ClearLayers(offset);
+                released = TRUE;
+                palSlot = AcquireIdleOrNewPalette(pal);
+            }
+            if (palSlot == PAL_NONE)
+            {
+                // More palettes on screen than the hardware has. The cell
+                // gets slot 0 and the wrong colours, and holds no reference.
+                gTileStreamStats.overflowPals++;
+                s->shown[SHOWN_CELL(offset)] = SLOT_NONE;
+                palSlot = NUM_PAL_SLOTS;
+            }
+        }
+        entries[i] = slot | (raw & 0x0C00) | (palSlot << 12);
+    }
+    // The layer type is bits 29-30 of the metatile's attributes.
+    WriteLayers((tileset->metatileAttributes[metatileId] >> 29) & 3, entries, offset);
+#if TILE_STREAM_PROBE
+    start = TILE_STREAM_ELAPSED(start);
+    gTileStreamStats.metatileSum += start;
+    gTileStreamStats.metatilesDrawn++;
+    if (start > gTileStreamStats.maxCell)
+        gTileStreamStats.maxCell = start;
+    if (gTileStreamStats.tileLoads + gTileStreamStats.palLoads != loads)
+    {
+        gTileStreamStats.loadCells++;
+        gTileStreamStats.loadCellSum += start;
+    }
+#endif
+}
+
+// ------------------------------------------------------- cells that wait
+
+void TileStream_DeferCell(u32 offset, s32 x, s32 y)
+{
+    struct TileStreamState *s = sState;
+    struct DeferredCell *cell;
+
+    if (s->deferredCount == MAX_DEFERRED)
+    {
+        TileStream_DrawMetatile(gMapHeader.mapLayout, MapGridGetMetatileIdAt(x, y), offset);
+        return;
+    }
+    cell = &s->deferred[(s->deferredHead + s->deferredCount++) % MAX_DEFERRED];
+    cell->offset = offset;
+    cell->x = x;
+    cell->y = y;
+#if TILE_STREAM_PROBE
+    if (s->deferredCount > gTileStreamStats.pendingMax)
+        gTileStreamStats.pendingMax = s->deferredCount;
+#endif
+}
+
+// Draws up to max waiting cells from the map as it is now. Returns TRUE if it drew any.
+bool32 TileStream_DrawDeferred(u32 max)
+{
+    struct TileStreamState *s = sState;
+    const struct DeferredCell *cell;
+    bool32 drew = FALSE;
+
+    if (!sActive)
+        return FALSE;
+    while (s->deferredCount != 0 && max-- != 0)
+    {
+        cell = &s->deferred[s->deferredHead];
+        s->deferredHead = (s->deferredHead + 1) % MAX_DEFERRED;
+        s->deferredCount--;
+        TileStream_DrawMetatile(gMapHeader.mapLayout, MapGridGetMetatileIdAt(cell->x, cell->y), cell->offset);
+        drew = TRUE;
+    }
+#if TILE_STREAM_PROBE
+    if (drew)
+        TileStream_Mark(TILE_STREAM_FRAME_WAITED);
+#endif
+    return drew;
+}
+
+// The whole view is about to be drawn: nothing needs to wait any more.
+void TileStream_DropDeferred(void)
+{
+    if (sActive)
+    {
+        sState->deferredHead = 0;
+        sState->deferredCount = 0;
+    }
+}
+
+// Draws ready-made tilemap entries (a door animation frame). Their tiles sit
+// in pinned slots; their palette numbers still have to be given slots.
+void TileStream_DrawEntries(u32 layerType, const u16 *raw, u32 offset)
+{
+    struct TileStreamState *s = sState;
+    u16 entries[NUM_TILES_PER_METATILE];
+    u32 i, pal, palSlot, refs;
+
+    s->shown[SHOWN_CELL(offset)] = SLOT_NONE;
+    for (i = 0; i < NUM_TILES_PER_METATILE; i++)
+    {
+        if ((raw[i] & 0x3FF) == 0)
+        {
+            entries[i] = 0;
+            continue;
+        }
+        pal = raw[i] >> 12;
+        palSlot = s->palSlotOf[pal];
+        if (palSlot != PAL_NONE && (refs = s->palRefs[palSlot]) != 0)
+        {
+            s->palRefs[palSlot] = refs + 1;
+        }
+        else
+        {
+            palSlot = AcquireIdleOrNewPalette(pal);
+            if (palSlot == PAL_NONE)
+            {
+                gTileStreamStats.overflowPals++;
+                palSlot = NUM_PAL_SLOTS;
+            }
+        }
+        entries[i] = (raw[i] & 0x0FFF) | (palSlot << 12);
+    }
+    WriteLayers(layerType, entries, offset);
+}
+
+// ------------------------------------------------------------- lifetime
+
+static void Reset(const struct MapLayout *layout)
+{
+    struct TileStreamState *s = sState;
+    const struct Tileset *primary = layout->primaryTileset;
+    u32 i, dynamic;
+
+    s->primary = primary;
+    s->secondary = layout->secondaryTileset;
+    for (i = 0; i < NUM_TILE_SLOTS; i++)
+    {
+        s->slots[i].tile = SLOT_NONE;
+        s->slots[i].refs = 0;
+        s->slots[i].hashNext = SLOT_NONE;
+    }
+    for (i = 0; i < HASH_BUCKETS; i++)
+        s->hashHead[i] = SLOT_NONE;
+    s->freeHead = SLOT_NONE;
+    s->freeTail = SLOT_NONE;
+    s->clock = 0;
+    s->deferredHead = 0;
+    s->deferredCount = 0;
+    for (i = 0; i < NUM_SHOWN_CELLS; i++)
+        s->shown[i] = SLOT_NONE;
+    for (i = 0; i < NUM_PAL_SLOTS; i++)
+    {
+        s->palVirt[i] = SLOT_NONE;
+        s->palRefs[i] = 0;
+        s->palFreedAt[i] = 0;
+    }
+    for (i = 0; i < MAX_PALETTES; i++)
+        s->palSlotOf[i] = PAL_NONE;
+
+    gTileStreamStats.magic = 0x52545354; // 'TSTR'
+    gTileStreamStats.residentTiles = 0;
+    gTileStreamStats.peakTiles = 0;
+    gTileStreamStats.overflowTiles = 0;
+    gTileStreamStats.residentPals = 0;
+    gTileStreamStats.peakPals = 0;
+    gTileStreamStats.overflowPals = 0;
+    gTileStreamStats.resets++;
+
+    PinSlot(0, TRUE);
+    for (i = 0; i < primary->streamPinCount; i++)
+        PinSlot(primary->streamPinFirst + i, TRUE);
+    for (i = NUM_TILE_SLOTS - DOOR_TILE_SLOTS; i < NUM_TILE_SLOTS; i++)
+        PinSlot(i, FALSE);
+    dynamic = 0;
+    for (i = 0; i < NUM_TILE_SLOTS; i++)
+    {
+        if (s->slots[i].refs != REFS_PINNED)
+        {
+            FreeListAppend(i);
+            dynamic++;
+        }
+    }
+    gTileStreamStats.dynamicSlots = dynamic;
+
+    // Every tilemap cell must start out as tile 0: a cell left over from
+    // another tileset would be counted as a reference when it is redrawn.
+    if (gBGTilemapBuffers1 != NULL && gBGTilemapBuffers2 != NULL && gBGTilemapBuffers3 != NULL)
+    {
+        CpuFastFill16(0, gBGTilemapBuffers1, BG_SCREEN_SIZE);
+        CpuFastFill16(0, gBGTilemapBuffers2, BG_SCREEN_SIZE);
+        CpuFastFill16(0, gBGTilemapBuffers3, BG_SCREEN_SIZE);
+    }
+    gPlttBufferUnfaded[0] = RGB_BLACK;
+    gPlttBufferFaded[0] = RGB_BLACK;
+}
+
+bool32 TileStream_Begin(const struct MapLayout *layout)
+{
+    if (!TileStream_IsLayoutStreamed(layout))
+    {
+        TileStream_End();
+        return FALSE;
+    }
+    if (sState == NULL)
+        sState = Alloc(sizeof(*sState));
+    if (sState == NULL)
+    {
+        sActive = FALSE;
+        return FALSE;
+    }
+    Reset(layout);
+    sActive = TRUE;
+    sRedrawRequested = FALSE;
+    return TRUE;
+}
+
+void TileStream_End(void)
+{
+    sActive = FALSE;
+    sRedrawRequested = FALSE;
+    gTileStreamStats.magic = 0;
+    TileStream_Free();
+}
+
+void TileStream_Free(void)
+{
+    if (sState != NULL)
+    {
+        Free(sState);
+        sState = NULL;
+    }
+    sActive = FALSE;
+    gTileStreamStats.magic = 0;
+}
+
+void TileStream_ForgetAllocation(void)
+{
+    sState = NULL;
+    sActive = FALSE;
+    sRedrawRequested = FALSE;
+    gTileStreamStats.magic = 0;
+}
+
+static bool32 SamePool(const struct MapLayout *layout)
+{
+    struct TileStreamState *s = sState;
+
+    return s->primary->tiles == layout->primaryTileset->tiles
+        && s->primary->palettes == layout->primaryTileset->palettes
+        && s->primary->streamPinFirst == layout->primaryTileset->streamPinFirst
+        && s->primary->streamPinCount == layout->primaryTileset->streamPinCount
+        && s->secondary->tiles == layout->secondaryTileset->tiles
+        && s->secondary->palettes == layout->secondaryTileset->palettes
+        && s->secondary->streamNumTiles == layout->secondaryTileset->streamNumTiles
+        && s->secondary->streamNumPalettes == layout->secondaryTileset->streamNumPalettes;
+}
+
+bool32 TileStream_OnCameraTransition(const struct MapLayout *oldLayout, const struct MapLayout *newLayout)
+{
+    bool32 wasActive = sActive;
+
+    if (TileStream_IsLayoutStreamed(newLayout))
+    {
+        if (wasActive && SamePool(newLayout))
+        {
+            // Same tiles and palettes, a different metatile table at most:
+            // everything on screen stays valid, but a metatile number may
+            // now mean something else.
+            u32 i;
+
+            sState->primary = newLayout->primaryTileset;
+            sState->secondary = newLayout->secondaryTileset;
+            for (i = 0; i < NUM_SHOWN_CELLS; i++)
+                sState->shown[i] = SLOT_NONE;
+            return TRUE;
+        }
+        if (TileStream_Begin(newLayout))
+        {
+            sRedrawRequested = TRUE;
+            return TRUE;
+        }
+        return FALSE;
+    }
+    if (wasActive)
+    {
+        // Leaving for an ordinary map: its tilesets are about to be copied
+        // over the cache, so the whole view has to be drawn again.
+        TileStream_End();
+        if (gBGTilemapBuffers1 != NULL && gBGTilemapBuffers2 != NULL && gBGTilemapBuffers3 != NULL)
+        {
+            CpuFastFill16(0, gBGTilemapBuffers1, BG_SCREEN_SIZE);
+            CpuFastFill16(0, gBGTilemapBuffers2, BG_SCREEN_SIZE);
+            CpuFastFill16(0, gBGTilemapBuffers3, BG_SCREEN_SIZE);
+        }
+        sRedrawRequested = TRUE;
+    }
+    return FALSE;
+}
