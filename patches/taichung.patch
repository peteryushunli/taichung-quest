+          b'= TAICHUNG_ENCOUNTER_SCHEMA;', b'= 0;')
+    probes['missing-registration'] = {MANIFEST: None}
+    probes['tampered-registration'] = {MANIFEST: read(MANIFEST) + b'\n'}
+    baseline = peel(read)[SOURCE]
+    probes['unregistered-source-revert'] = {SOURCE: baseline}
+    caught = {}
