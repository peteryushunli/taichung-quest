+        assert(gTaichungNavigationBridge.localX == 31 + (s16)state);
+        assert(gTaichungNavigationBridge.localY == 66);
+        assert(!!(gTaichungNavigationBridge.flags & TAICHUNG_NAVIGATION_CYCLING) == (state == 1 || state == 2));
+        frame = gTaichungNavigationBridge.frameCounter;
+        gPlayerAvatar.runningState = NOT_MOVING;
+        TaichungNavigationBridge_Tick(TRUE);
+        assert(gTaichungNavigationBridge.frameCounter == frame + 1);
+        assert(gTaichungNavigationBridge.contextFlags == 0);
+        assert(gTaichungNavigationBridge.flags & TAICHUNG_NAVIGATION_POSITION_VALID);
+        assert(gTaichungNavigationBridge.localX == 31 + (s16)state);
+        assert(gTaichungNavigationBridge.localY == 66);
+    }
+    ResetField(); gMapHeader.mapType = MAP_TYPE_INDOOR; TaichungNavigationBridge_Tick(TRUE);
+    assert((gTaichungNavigationBridge.flags & (TAICHUNG_NAVIGATION_INDOOR | TAICHUNG_NAVIGATION_OUTDOOR)) == TAICHUNG_NAVIGATION_INDOOR);
+    ResetField(); sField = FALSE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_NOT_FIELD, TRUE);
+    ResetField(); Hidden(TAICHUNG_NAVIGATION_CONTEXT_CALLBACKS_SKIPPED, FALSE);
+    ResetField(); gMain.inBattle = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_BATTLE, TRUE);
+    ResetField(); gPaletteFade.active = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_TRANSITION, TRUE);
