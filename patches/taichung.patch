+        # A neighbour is done once it has the plan's size and the reciprocal offset.
+        layouts = {l["id"]: l for l in now.json(install.LAYOUTS)["layouts"] if l.get("id")}
+        pending = []
+        for mid, (direction, value) in wanted.items():
