+        for path in ((() if self.city else (old_core,)) + ('tools/taichung/landmarks/check_greenway_science.py',)
+                     + (() if self.city else ('tools/taichung/landmarks/check_xitun_final.py',))):
+            self.assertEqual((ROOT / path).read_bytes(), historical(path, reference))
+        for path, marker in [('tools/taichung/landmarks/check_cmp.py', '        probes={}'),
+                             ('tools/taichung/streetscape/check_xitun_streets.py', 'def self_test(source):')]:
+            old, current = historical(path, reference).decode(), (ROOT / path).read_text()
+            self.assertEqual(old[old.index(marker):], current[current.index(marker):], path)
+        path = 'tools/taichung/landmarks/check_cmp.py'
+        old, current = historical(path, reference).decode(), (ROOT / path).read_text()
+        for name in ('REVIEWED_MAIN_SAVE', 'REVIEWED_FINAL_XITUN_SAVE', 'REVIEWED_RELEASE_CITY_BATCH_V8_SAVE', 'REVIEWED_LANDMARK_COLLISION_V9_SAVE'):
+            def assignment(text):
