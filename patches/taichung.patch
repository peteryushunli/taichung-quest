index 0000000..42f140c
--- /dev/null
+++ b/tools/taichung_gameplay/test-save-facing.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Compile real migration/warp/avatar functions; stub only map/GBA services.
+
+Function bodies are copied verbatim from current native sources into a host
+translation unit. Assertions execute them, including native direction selection,
+object reset, InitPlayerAvatar, ObjectEventTurn and the real facing getter.
+No source-pattern assertions or substitute facing implementation are used.
+"""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+def definition(source, name):
+    match = re.search(r"^[\w *]+\b" + re.escape(name) + r"\([^;{}]*\)\s*\n\{", source, re.M)
+    if not match:
+        raise ValueError(f"Missing native definition: {name}")
+    start = source.index('{', match.start())
+    depth, mode, index = 1, 'code', start + 1
+    while depth:
+        char, pair = source[index], source[index:index + 2]
+        if mode == 'line':
+            if char == '\n':
+                mode = 'code'
+        elif mode == 'block':
+            if pair == '*/':
+                mode = 'code'
+                index += 1
+        elif mode in ('"', "'"):
+            if char == '\\':
+                index += 1
+            elif char == mode:
+                mode = 'code'
+        elif pair == '//':
+            mode = 'line'
+            index += 1
+        elif pair == '/*':
+            mode = 'block'
+            index += 1
+        elif char in ('"', "'"):
+            mode = char
+        elif char == '{':
+            depth += 1
+        elif char == '}':
+            depth -= 1
+        index += 1
+    return source[match.start():index], source[match.start():start].strip() + ';'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--prove-regression', action='store_true', help='Also verify the same native engine tests fail without only the new avatar hook')
+    args = parser.parse_args()
+    game = Path(__file__).resolve().parents[2]
+    out = game / 'build/taichung-tests/facing'
+    out.mkdir(parents=True, exist_ok=True)
+    subprocess.run(['python3', '-B', str(game / 'tools/taichung_gameplay/generate-approved-art-save.py'),
+                    '--host-truth', str(out / 'save-v11-expect.inc')], check=True, capture_output=True)
+    functions = {
+        'src/overworld.c': [
+            'ApplyCurrentWarp', 'LoadCurrentMapData', 'SetPlayerCoordsFromWarp', 'WarpIntoMap',
+            'GetMapLayout', 'SetWarpDestinationToContinueGameWarp', 'ResetInitialPlayerAvatarState',
+            'GetInitialPlayerAvatarState', 'GetAdjustedInitialTransitionFlags',
+            'MetatileBehavior_IsSurfableInSeafoamIslands', 'GetAdjustedInitialDirection',
+            'GetCenterScreenMetatileBehavior', 'GetMapTypeByGroupAndId', 'GetMapTypeByWarpData',
+            'GetCurrentMapType', 'InitObjectEventsLocal',
+        ],
+        'src/fieldmap.c': ['GetCameraFocusCoords'],
+        'src/event_object_movement.c': ['ClearObjectEvent', 'ClearAllObjectEvents', 'ResetObjectEvents',
+                                         'SetObjectEventDirection', 'ObjectEventTurn'],
+        'src/field_player_avatar.c': ['ClearPlayerAvatarInfo', 'SetPlayerAvatarStateMask',
+                                      'InitPlayerAvatar', 'GetPlayerFacingDirection'],
+    }
+    bodies, prototypes = [], []
+    for path, names in functions.items():
+        text = (game / path).read_text()
+        for name in names:
+            body, prototype = definition(text, name)
+            prototypes.append(prototype)
+            bodies.append(f'#line 1 "{path}:{name}"\n{body}\n')
+    # Pull only this native constant; the unrelated event-ID table is generated
+    # by ROM builds and is not a prerequisite for these host avatar tests.
+    player_id = next(line for line in (game / 'include/constants/event_objects.h').read_text().splitlines()
+                     if re.match(r'^#define LOCALID_PLAYER\s', line))
+    prefix = player_id + '\n' + '''struct InitialPlayerAvatarState { u8 transitionFlags, direction; bool8 hasDirectionSet; };
+static struct InitialPlayerAvatarState sInitialPlayerAvatarState;
+static struct WarpData sWarpDestination, sFixedDiveWarp, sFixedHoleWarp;
+static const struct WarpData sDummyWarpData = {-1, -1, -1, -1, -1};
+'''
+    generated = prefix + '\n'.join(prototypes) + '\n' + '\n'.join(bodies)
+    include = out / 'native-engine.inc'
+    include.write_text(generated)
+    collision = json.loads((game / 'data/taichung/landmark-collision/delta.json').read_text())
+    origins = collision['newlySolidPositions']
+    if len(origins) != 44 or any(item['nativeMap'] != [43, 2] for item in origins):
+        raise ValueError('Expected the reviewed44 Xitun-only collision origins')
+    # Independent runtime test inputs come from Maps' committed collision
+    # manifest, not from the C migration table being tested.
+    (out / 'collision-v9-origins.inc').write_text('static const u8 sCollisionV9Origins[][2] = {\n' +
+        ''.join(f"    {{{item['x']}, {item['y']}}},\n" for item in origins) + '};\n')
+    # The v10 shifts and repairs come from the committed rework record, never the C tables.
+    rework = json.loads((game / 'data/taichung/city-rework/save-v10.json').read_text())['maps']
+    if sorted(m['constant'] for m in rework) != sorted(['MAP_TAICHUNG_XITUN', 'MAP_TAICHUNG_GREENWAY', 'MAP_TAICHUNG_OLD_CITY',
+                                                        'MAP_TAICHUNG_NANTUN_NORTH', 'MAP_TAICHUNG_NANTUN_WANHE']):
+        raise ValueError('Expected the five reworked outdoor districts')
+    tables, rows = [], []
+    for m in rework:
+        name = f"sV10{m['map']}Repairs"
+        cells = ''.join(f"    {{{sx}, {sy}, {tx}, {ty}}},\n" for sx, sy, tx, ty in m['repairs']) or '    {0xFF, 0xFF, 0xFF, 0xFF},\n'
+        tables.append(f'static const u8 {name}[][4] = {{\n{cells}}};\n')
+        rows.append(f"    {{\"{m['map'][len('Taichung'):]}\", MAP_NUM({m['constant']}), {m['shift'][0]}, {m['shift'][1]}, "
+                    f"{m['releasedSize'][0]}, {m['releasedSize'][1]}, {name}, {len(m['repairs'])}}},\n")
+    (out / 'save-v10.inc').write_text(''.join(tables) +
+        'static const struct V10District { const char *name; u8 mapNum; s8 dx, dy; u8 width, height; const u8 (*repairs)[4]; u16 count; }'
+        ' sV10Districts[] = {\n' + ''.join(rows) + '};\n')
+    # FRLG retains unused-parameter false-return compatibility functions from
+    # RSE in this unchanged native file; keep that exception scoped to it.
+    behaviors = out / 'metatile-behavior.o'
+    subprocess.run(['cc', '-std=c99', '-Wall', '-Wextra', '-Werror', '-Wno-unused-parameter',
+                    '-I' + str(game / 'tests/save_host'), '-I' + str(game / 'include'),
+                    '-c', str(game / 'src/metatile_behavior.c'), '-o', str(behaviors)], check=True)
+    command = ['cc', '-std=c99', '-Wall', '-Wextra', '-Werror', '-Wno-pointer-sign',
+               '-I' + str(game / 'tests/save_host'), '-I' + str(game / 'include'), '-I' + str(out),
+               str(game / 'src/taichung_save.c'), str(behaviors),
+               str(game / 'tests/taichung_save_facing_test.c')]
+    binary = out / 'save-facing'
+    subprocess.run(command + ['-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
+    if args.prove_regression:
+        # Remove the sole runtime integration hook, not the expected answers or
+        # migration. The real engine must reproduce South instead of saved Up.
+        hook = '''    continueFacing = TaichungSaveConsumeContinueFacing();
+    if (continueFacing != DIR_NONE)
+        player->direction = continueFacing;'''
+        if generated.count(hook) != 1:
+            raise ValueError('Expected one exact avatar hook for the regression control')
+        include.write_text(generated.replace(hook, '    (void)continueFacing;', 1))
+        broken = out / 'save-facing-without-hook'
+        try:
+            subprocess.run(command + ['-o', str(broken)], check=True)
+            result = subprocess.run([str(broken)], capture_output=True)
+            if result.returncode == 0 or b'cache-only native facing: expected 2, got 1' not in result.stderr:
+                raise ValueError('Regression control did not reproduce the specific saved North to South failure')
+            (out / 'without-hook.stderr.txt').write_bytes(result.stderr)
+            print('PASS: removing only the runtime hook reproduces the native saved-facing assertion failure')
+        finally:
+            include.write_text(generated)
+
+
+if __name__ == '__main__':
+    main()
