+#include "global.h"
+#include "taichung_city_names.h"
+#include "taichung_language.h"
+#include "constants/region_map_sections.h"
+
+// Region-map callers include a 19-byte buffer. Four FC19 glyphs plus EOS
+// occupy 17 bytes, so these names fit without changing any native buffers.
+static const u8 sText_OldCity[] = _("臺中舊城");
+static const u8 sText_Greenway[] = _("草悟道");
+static const u8 sText_Xitun[] = _("臺中西屯");
+
+typedef char OldCityNameFits[sizeof(sText_OldCity) <= 19 ? 1 : -1];
+typedef char GreenwayNameFits[sizeof(sText_Greenway) <= 19 ? 1 : -1];
+typedef char XitunNameFits[sizeof(sText_Xitun) <= 19 ? 1 : -1];
+
+const u8 *TaichungGetLocalizedMapSectionName(u16 mapsec)
+{
+    if (!TaichungIsChinese())
+        return NULL;
+
+    switch (mapsec)
+    {
+    case MAPSEC_TAICHUNG_OLD_CITY:
+        return sText_OldCity;
+    case MAPSEC_TAICHUNG_GREENWAY:
+        return sText_Greenway;
+    case MAPSEC_TAICHUNG_XITUN:
+        return sText_Xitun;
+    default:
+        return NULL;
+    }
+}
