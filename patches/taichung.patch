+"""Six solid terrain tiles across the east-side railway viaduct."""
+
+from PIL import Image, ImageDraw
+
+
+def viaduct_tiles():
+    wall = Image.new("RGBA", (16, 16), "#585870")
+    draw = ImageDraw.Draw(wall)
+    draw.rectangle((1, 0, 10, 15), fill="#a8b8c8")
+    draw.rectangle((3, 0, 8, 15), fill="#c8d8e8")
+    draw.line((2, 0, 2, 15), fill="#e0e8f8")
+    draw.line((11, 0, 11, 15), fill="#404868", width=2)
+    for y in (0, 8):
+        draw.line((3, y, 10, y), fill="#90a0b0")
+
+    ballast = Image.new("RGBA", (16, 16), "#787880")
+    draw = ImageDraw.Draw(ballast)
+    for x, y in ((3, 1), (11, 3), (6, 6), (14, 8), (2, 10), (9, 13)):
+        draw.line((x, y, x + 1, y), fill="#90a0b0")
+    for x, y in ((1, 4), (8, 2), (4, 8), (10, 9), (14, 13), (5, 15)):
+        draw.point((x, y), fill="#585870")
+
+    track = ballast.copy()
+    draw = ImageDraw.Draw(track)
+    for y in (1, 5, 9, 13):
+        draw.rectangle((1, y, 14, y + 1), fill="#404868")
+    for x in (4, 11):
+        draw.line((x + 1, 0, x + 1, 15), fill="#203038")
+        draw.line((x, 0, x, 15), fill="#c8d8e8")
+
+    return (wall, ballast, track, ballast, track, wall.transpose(Image.Transpose.FLIP_LEFT_RIGHT))
