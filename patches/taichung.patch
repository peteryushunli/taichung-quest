+#!/usr/bin/env python3
+"""Describe Greenway save-coordinate geometry versus exact Git 16625bd; no mutation."""
+import argparse
+from datetime import datetime, timezone
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = '16625bddb212c4bedea3189346a3a03c914001e6'
+OUTPUT = ROOT / 'data/taichung/landmarks/greenway-native/delta.json'
+MAP_NAME = 'TaichungGreenway'
+MAP_ID = 'MAP_TAICHUNG_GREENWAY'
+ANCHOR = (24, 23)
+PRODUCER_PATH = Path(__file__).resolve()
+PRODUCER_BYTES = PRODUCER_PATH.read_bytes()
+HELPER_PATH = ROOT / 'tools/taichung/landmarks/describe_old_core_delta.py'
+HELPER_BYTES = HELPER_PATH.read_bytes()
+spec = importlib.util.spec_from_file_location('greenway_delta_source_helpers', HELPER_PATH)
+helper = importlib.util.module_from_spec(spec); spec.loader.exec_module(helper)
+Source, CityMap, component, group_numbers = helper.Source, helper.CityMap, helper.component, helper.group_numbers
+
+
+def require(condition, message):
+    if not condition: raise ValueError(message)
+
+
+def content_hash(source):
+    return helper.digest(''.join(path + '\0' + helper.digest(raw) + '\n' for path, raw in sorted(source.raw.items())).encode())
+
+
+def coordinate_runs(points, city):
+    """Lossless compact [y,xFirst,xLast,elevation] rows for every given tile."""
+    result = []
+    for x, y in sorted(points, key=lambda p: (p[1], p[0])):
+        elevation = city.inspect(x, y)['elevation']
+        if result and result[-1][0] == y and result[-1][2] + 1 == x and result[-1][3] == elevation:
+            result[-1][2] = x
+        else: result.append([y, x, x, elevation])
+    return result
+
+
+def compact_state(state):
+    if state is None: return None
+    return [state['wordHex'], f"0x{state['attribute']:08X}" if state['attribute'] is not None else None,
+            state['collision'], state['elevation'], state['behavior'], state['actorSignAwareWalkable']]
+
+
+def bank_summary(source, bank):
+    paths = bank['paths']; palette_folder = Path(paths['palettes']).parent
+    palettes = b''.join(source.read(palette_folder / f'{n:02}.pal') for n in range(16))
+    return dict(label=bank['label'], metatilesSha256=helper.digest(source.read(paths['metatiles'])),
+        attributesSha256=helper.digest(source.read(paths['metatileAttributes'])),
+        graphicsSourceSha256=helper.digest(source.read(Path(paths['tiles']).parent / 'tiles.png')),
+        sixteenPaletteSourcesSha256=helper.digest(palettes))
+
+
+def landmark_proofs(before, current, old, new, old_numbers, numbers):
+    old_contract = before.json('docs/taichung-city-contract.json'); contract = current.json('docs/taichung-city-contract.json')
+    old_files = helper.taichung_map_files(before, old_numbers); files = helper.taichung_map_files(current, numbers)
+    proofs = []
+    for landmark in old_contract['landmarks']:
+        if landmark['exteriorMap'] != MAP_ID: continue
+        now = next(l for l in contract['landmarks'] if l['id'] == landmark['id'])
+        require(now['exteriorMap'] == MAP_ID and landmark['gymMap'] == now['gymMap'], 'Greenway landmark parent/gym changed')
+        gym = landmark['gymMap']; old_room = before.json(f'data/maps/{old_files[gym]}/map.json'); room = current.json(f'data/maps/{files[gym]}/map.json')
+        anchors = {}
+        for role in ('entrance', 'approach', 'arrival'):
+            a, b = landmark[role], now[role]
+            require(a == b, f'{landmark["id"]} {role} coordinate/warp anchor changed')
+            old_state, state = old.inspect(a['x'], a['y']), new.inspect(b['x'], b['y'])
+            anchors[role] = dict(coordinatesBefore=a, coordinatesAfter=b, coordinatesUnchanged=True,
+                wordBefore=old_state['wordHex'], wordAfter=state['wordHex'], wordUnchanged=old_state['word'] == state['word'],
+                behaviorBefore=old_state['behavior'], behaviorAfter=state['behavior'],
+                currentActorSignAwareWalkable=state['actorSignAwareWalkable'])
+            require(old_state['word'] == state['word'], f'{landmark["id"]} {role} native word changed')
+            if role == 'entrance':
+                require(state['behavior'] == 0x69 and state['collision'] == 1 and state['elevation'] == 0, 'Entrance no longer a native warp door')
+            else: require(state['actorSignAwareWalkable'], 'Landmark approach/arrival is blocked')
+        index = landmark['entrance']['warpId']; old_warp, warp = old.data['warp_events'][index], new.data['warp_events'][index]
+        require(old_warp == warp, 'Exterior Greenway warp changed')
+        require(warp['dest_map'] == gym and int(warp['dest_warp_id']) == now['gymEntryWarpId'], 'Exterior warp no longer enters the correct gym')
+        returns = []
+        for expected in landmark['interiorReturns']:
+            i = expected['warpId']; a, b = old_room['warp_events'][i], room['warp_events'][i]
+            require(a == b and b['dest_map'] == MAP_ID and int(b['dest_warp_id']) == index, 'Interior return changed or lost its exterior pair')
+            returns.append(dict(warpIndex=i, coordinates=[b['x'], b['y']], destinationMapId=b['dest_map'],
+                destinationWarpId=int(b['dest_warp_id']), unchanged=True,
+                numericDestinationBefore=old_numbers[old_files[b['dest_map']]], numericDestinationAfter=numbers[files[b['dest_map']]]))
+        require(len(returns) == 3, 'Expected three return warps per Greenway gym')
+        require(old_numbers[old_files[gym]] == numbers[files[gym]], 'Greenway numeric gym ID changed')
+        proofs.append(dict(landmarkId=landmark['id'], gymMapId=gym, numericGymIdBefore=old_numbers[old_files[gym]],
+            numericGymIdAfter=numbers[files[gym]], anchors=anchors, exteriorWarpIndex=index,
+            exteriorWarpBefore=old_warp, exteriorWarpAfter=warp, exteriorWarpUnchanged=True, interiorReturns=returns))
+    require({p['landmarkId'] for p in proofs} == {'natural-science-museum', 'calligraphy-greenway', 'shen-ji-new-village', 'fine-arts-museum'}, 'Greenway landmark set changed')
+    return proofs
+
+
+def describe(baseline=BASE, output=OUTPUT, current_ref=None, write=True):
+    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
+    baseline_full = subprocess.check_output(['git', 'rev-parse', baseline], cwd=ROOT, text=True).strip()
+    current_full = subprocess.check_output(['git', 'rev-parse', current_ref], cwd=ROOT, text=True).strip() if current_ref else None
+    before, current = Source(baseline_full), Source(current_full)
+    old, new = CityMap(before, MAP_NAME), CityMap(current, MAP_NAME)
+    require(old.data['id'] == new.data['id'] == MAP_ID, 'Registered exterior map ID changed')
+    old_numbers, numbers = group_numbers(before), group_numbers(current)
+    moved = [dict(name=name, before=value, after=numbers.get(name)) for name, value in old_numbers.items() if numbers.get(name) != value]
+    require(not moved, f'Baseline native numeric map IDs moved: {moved}')
+    proofs = landmark_proofs(before, current, old, new, old_numbers, numbers)
+    science = next(p for p in proofs if p['landmarkId'] == 'natural-science-museum')
+    arrival = science['anchors']['arrival']['coordinatesAfter']; require((arrival['x'], arrival['y']) == ANCHOR, 'Science arrival must remain24,23')
+    distances = component(new, ANCHOR); require(distances, 'Science safe arrival is not walkable')
+    for proof in proofs:
+        for role in ('approach', 'arrival'):
+            p = proof['anchors'][role]['coordinatesAfter']; require((p['x'], p['y']) in distances, 'Greenway gym anchor disconnected from Science arrival')
+    old_valid, current_valid, retained, changed_retained, newly_valid = set(), set(), set(), set(), set()
+    changed, invalidated = [], []
+    fields = (('word', 'map-word'), ('attribute', 'resolved-attribute'), ('collision', 'collision'),
+              ('elevation', 'elevation'), ('behavior', 'resolved-behavior'), ('graphicReferences', 'graphic-references'),
+              ('actor', 'actor-blocking'), ('sign', 'sign-blocking'))
+    for y in range(max(old.height, new.height)):
+        for x in range(max(old.width, new.width)):
+            a, b = old.inspect(x, y), new.inspect(x, y)
+            was_valid = a is not None and a['actorSignAwareWalkable']; is_valid = b is not None and b['actorSignAwareWalkable']
+            if was_valid: old_valid.add((x, y))
+            if is_valid: current_valid.add((x, y))
+            if was_valid and is_valid: retained.add((x, y))
+            if is_valid and not was_valid: newly_valid.add((x, y))
+            reasons = ['map-extent'] if a is None or b is None else [reason for field, reason in fields if a[field] != b[field]]
+            if reasons:
+                changed.append(dict(x=x, y=y, changes=reasons, before=compact_state(a), after=compact_state(b)))
+                if was_valid and is_valid: changed_retained.add((x, y))
+            if was_valid and not is_valid:
+                nearest = min(distances, key=lambda p: (abs(p[0] - x) + abs(p[1] - y), distances[p], p[1], p[0]))
+                fallback = new.inspect(*nearest)
+                require(fallback['actorSignAwareWalkable'] and nearest in distances, 'Fallback is not connected and valid')
+                invalidated.append(dict(x=x, y=y, newInvalidReasons=b['invalidReasons'] if b else ['out-of-bounds'],
+                    nearestSafeConnectedPosition=list(nearest), fallbackElevation=fallback['elevation'],
+                    manhattanDisplacement=abs(nearest[0] - x) + abs(nearest[1] - y),
+                    fallbackDistanceFromScienceArrival=distances[nearest], fallbackVerified=True))
+    require({(p['x'], p['y']) for p in invalidated} == old_valid - current_valid, 'Invalidated-coordinate list is incomplete')
+    keep_runs = coordinate_runs(current_valid, new)
+    decoded_keep = {(x, y) for y, x0, x1, elevation in keep_runs for x in range(x0, x1 + 1)}
+    require(decoded_keep == current_valid, 'Keep-saved-position ranges omit or add coordinates')
+    old_banks, new_banks = [bank_summary(before, b) for b in old.banks], [bank_summary(current, b) for b in new.banks]
+    before.read('tools/taichung/validate_city.py')
+    box = [min(p['x'] for p in changed), min(p['y'] for p in changed), max(p['x'] for p in changed), max(p['y'] for p in changed)] if changed else None
+    report = dict(schemaVersion=1, purpose='Greenway geometry evidence for Main save-v5 integration; no runtime/save mutation',
+        generatedAtUtc=datetime.now(timezone.utc).isoformat(), sourceRoot=str(ROOT), sourceHEAD=head,
+        coordinateSystem='zero-based unbuffered local Greenway metatiles; no save/viewport offset added',
+        baseline=dict(commit=baseline_full, source='exact Git blobs only; no worktree/compiler baseline artifact',
+            mapSha256=helper.digest(before.read(old.layout['blockdata_filepath'])), dimensions=[old.width, old.height],
+            layoutId=old.layout['id'], banks=old_banks),
+        current=dict(source='exact Git registered native source' if current_full else 'current registered native source', revision=current_full,
+            mapSha256=helper.digest(current.read(new.layout['blockdata_filepath'])), dimensions=[new.width, new.height],
+            layoutId=new.layout['id'], banks=new_banks, consumedSourceContentSha256=content_hash(current)),
+        numericIds=dict(baselineMapNamesCompared=len(old_numbers), allBaselineNumericMapIdsStable=True, movedOrMissing=[],
+            greenwayBefore=old_numbers[MAP_NAME], greenwayAfter=numbers[MAP_NAME]),
+        summary=dict(changedCells=len(changed), changedBoundingBoxInclusive=box,
+            mapWordsChanged=sum('map-word' in p['changes'] for p in changed),
+            resolvedAttributesChanged=sum('resolved-attribute' in p['changes'] for p in changed),
+            collisionCellsChanged=sum('collision' in p['changes'] for p in changed),
+            elevationCellsChanged=sum('elevation' in p['changes'] for p in changed),
+            graphicReferenceCellsChanged=sum('graphic-references' in p['changes'] for p in changed),
+            baselineActorSignAwareWalkable=len(old_valid), currentActorSignAwareWalkable=len(current_valid),
+            formerlyWalkableNowInvalid=len(invalidated), formerlyWalkableStillValidKeepSavedPosition=len(retained),
+            changedButStillValidKeepSavedPosition=len(changed_retained), newlyWalkable=len(newly_valid),
+            safeConnectedPositions=len(distances), currentWalkableOutsideArrivalComponent=len(current_valid - distances.keys()),
+            registeredBanksOrSourceArtChanged=old_banks != new_banks,
+            exteriorWarpAnchorsCompared=len(proofs), interiorReturnWarpsCompared=sum(len(p['interiorReturns']) for p in proofs),
+            allFourGymAnchorsExteriorWarpsAndTwelveReturnsUnchanged=True),
+        changedCellColumns=['wordHex', 'resolvedAttributeHex', 'collision', 'elevation', 'behavior', 'actorSignAwareWalkable'],
+        changedCells=changed, previouslyOrdinaryWalkableNowInvalid=invalidated,
+        savedPositionDisposition=dict(keepSavedPositionForEveryCurrentlyValidCoordinate=True,
+            keepSavedPositionCount=len(current_valid), runColumns=['y', 'xFirstInclusive', 'xLastInclusive', 'elevation'], keepSavedPositionRuns=keep_runs,
+            stillWalkableOutsideArrivalComponentKeepSavedPositionRuns=coordinate_runs(current_valid - distances.keys(), new),
+            refreshCachedViewportIfMapOrResolvedBankChanged=True, relocateOnlyIfCurrentTerrainOrActorSignCheckFails=True,
+            neverRelocateForWordGraphicOrBankChangeAlone=True, runtimeSaveCodeOwner='Main'),
+        safeConnectedSet=dict(anchor=list(ANCHOR), size=len(distances),
+            fallbackSelection='minimum Manhattan displacement among current arrival-connected valid tiles; tie: distance from arrival,y,x',
+            allFallbacksVerified=True, coordinateEnumeration='recompute with describe_old_core_delta.component; no duplicate full per-cell safe table'),
+        landmarkCoordinateAndReturnProof=proofs,
+        walkability=dict(helper='tools/taichung/landmarks/describe_old_core_delta.py', helperSha256=helper.digest(HELPER_BYTES),
+            validator='tools/taichung/validate_city.py', validatorSha256=helper.digest(helper.WALK_RULE_BYTES),
+            baselineValidatorSha256=helper.digest(before.read('tools/taichung/validate_city.py')), nativeMapMethodsUsedDirectly=True,
+            collisionMask='0x0C00', attributeBehaviorMask='0x1FF', actorSignPolicy='exclude authored initial actors/signs, as the native geometry validator',
+            elevationRule='current0 or target0/15/current, using actual native can_step'),
+        provenance=dict(baselineFilesSha256={p: helper.digest(raw) for p, raw in sorted(before.raw.items())},
+            currentFilesSha256={p: helper.digest(raw) for p, raw in sorted(current.raw.items())},
+            producerScript=str(PRODUCER_PATH.relative_to(ROOT)), producerScriptSha256=helper.digest(PRODUCER_BYTES),
+            sourceInputsStableDuringRead=True, romBuiltByThisTool=False, saveOrStartupMutationPerformed=False,
+            sourceEvidenceDoesNotClaimLoadedRomCompatibility=True), validation=dict(result='pass'))
+    if current_full is None:
+        drift = [p for p, raw in current.raw.items() if (ROOT / p).read_bytes() != raw]
+        require(not drift, f'Source changed during Greenway delta read; recompute: {drift}')
+        require(subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip() == head, 'HEAD changed during delta read; recompute')
+    require(HELPER_PATH.read_bytes() == HELPER_BYTES and helper.WALK_RULE_PATH.read_bytes() == helper.WALK_RULE_BYTES, 'Shared evidence helpers changed during read')
+    require(PRODUCER_PATH.read_bytes() == PRODUCER_BYTES, 'Greenway delta producer changed during read; recompute')
+    if write:
+        output = Path(output); output.parent.mkdir(parents=True, exist_ok=True); output.write_text(json.dumps(report, indent=2) + '\n')
+    return report
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--baseline', default=BASE)
+    parser.add_argument('--output', type=Path, default=OUTPUT); parser.add_argument('--self-test', action='store_true')
+    parser.add_argument('--current-ref', help='Read current source exclusively from this immutable Git revision')
+    parser.add_argument('--check', action='store_true'); args = parser.parse_args()
+    if args.self_test and args.current_ref: parser.error('--self-test and --current-ref are mutually exclusive')
+    report = describe(args.baseline, args.output, current_ref=args.baseline if args.self_test else args.current_ref, write=not (args.self_test or args.check))
+    if args.self_test:
+        require(report['summary']['changedCells'] == report['summary']['formerlyWalkableNowInvalid'] == 0, 'Identical-Git source test has nonzero delta')
+    if args.check:
+        saved = json.loads(args.output.read_text())
+        for key in ('baseline', 'current', 'numericIds', 'summary', 'changedCells', 'previouslyOrdinaryWalkableNowInvalid',
+                    'savedPositionDisposition', 'safeConnectedSet', 'landmarkCoordinateAndReturnProof', 'walkability'):
+            require(saved[key] == report[key], f'Delta report is stale/edited: {key}')
+    print(json.dumps(dict(result='pass', output=None if args.self_test else str(args.output), selfTest=args.self_test,
+        baseline=report['baseline']['commit'], currentMapSha256=report['current']['mapSha256'], summary=report['summary']), indent=2))
