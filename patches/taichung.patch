+def reviewed_onboarding_profile(current):
+    """Only the exact reviewed opt-in flow may replace four legacy blocks."""
+    result = {"active":False,"passed":False,"errors":[],"allowedBlocks":{}}
+    try:
+        scripts = current.text("data/maps/PalletTown/scripts.inc")
+        hooks = "\n".join(current.text(path) for path in ("src/main.c","src/new_game.c","src/field_control_avatar.c"))
+        result["active"] = bool(re.search(r"callnative\s+TaichungOnboarding_",scripts)
+                                or re.search(r"\bTaichungOnboarding_\w+\s*\(",hooks))
+        if not result["active"]:
+            return result
+        profile = REVIEWED_ONBOARDING
+        approved = Files(current.source,profile["sourceCommit"])
+        for path, expected in profile["sourceSha256"].items():
+            if digest(approved.read(path)) != expected or digest(current.read(path)) != expected:
+                result["errors"].append("Reviewed onboarding source changed: "+path)
+        for path, labels in profile["scriptBlocks"].items():
+            if digest(approved.read(path)) != profile["frozenScriptFilesSha256"][path]:
+                result["errors"].append("Immutable onboarding script attestation changed: "+path)
+            for label in labels:
+                if path.endswith("/text.inc"):
+                    pattern = rf"^{re.escape(label)}::\s*\n(.*?)(?=^\w+::|\Z)"
+                    actual = re.search(pattern,current.text(path),re.S|re.M)
+                    frozen = re.search(pattern,approved.text(path),re.S|re.M)
+                    same = actual is not None and frozen is not None and actual[1] == frozen[1]
+                else:
+                    actual = script_block(current.text(path),label)
+                    frozen = script_block(approved.text(path),label)
+                    if label == "EventScript_ResetAllMapFlags":
+                        # The include list after this script's terminal end is
+                        # outside onboarding. Keep the executable reset exact.
+                        actual = actual[:actual.index("end")+1]
+                        frozen = frozen[:frozen.index("end")+1]
+                    same = actual == frozen
+                if not same:
+                    result["errors"].append("Reviewed onboarding block changed: "+path+":"+label)
+        if not result["errors"]:
+            # Parser and shared bitmap provider are pinned above. Validation
+            # only compares in-memory masks; no source writes, network or CLI.
+            path = current.source/"tools/taichung_gameplay/extend-chinese-glyphs.py"
+            spec = importlib.util.spec_from_file_location("old_core_reviewed_onboarding_glyphs",path)
+            parser = importlib.util.module_from_spec(spec);spec.loader.exec_module(parser)
+            # Source/helper/license pins above are checked before dynamic import.
+            codebook = Files(current.source,profile["codebookBaseCommit"])
+            if (digest(codebook.read("charmap.txt")) != profile["charmapPrefixSha256"]
+                    or approved.read("charmap.txt") != codebook.read("charmap.txt")
+                    or digest(approved.read("src/data/taichung_glyphs.h")) != profile["glyphHeaderSha256"]):
+                raise ValueError("Immutable reviewed font/codebook attestation changed")
+            frozen = parser.parse_existing(approved.read("charmap.txt"),approved.read("src/data/taichung_glyphs.h"))
+            actual = parser.parse_existing(current.read("charmap.txt"),current.read("src/data/taichung_glyphs.h"))
+            count = profile["glyphPrefixRows"]
+            same = (len(frozen["rows"]) == count and actual["rows"][:count] == frozen["rows"]
+                    and current.read("charmap.txt").startswith(approved.read("charmap.txt"))
+                    and actual["header"].startswith(frozen["header"][:frozen["closeAt"]])
+                    and actual["header"][actual["closeAt"]:] == frozen["header"][frozen["closeAt"]:]
+                    and all(actual["mappings"].get(char) == code for char,code in frozen["mappings"].items()))
+            suffix = current.read("charmap.txt")[len(approved.read("charmap.txt")):].decode().splitlines()
+            suffix = [line for line in suffix if line.strip()]
+            extras = actual["rows"][count:]
+            if len(suffix) != len(extras):
+                same = False
+            for line,row in zip(suffix,extras):
+                expected = [0xFC,0x19,row["index"]%240+1,row["index"]//240+1]
+                match = re.fullmatch(r"'(.)'[ \t]*=[ \t]*([0-9A-Fa-f]{2}(?:[ \t]+[0-9A-Fa-f]{2}){3})[ \t]*",line)
+                if match is None or match[1] != row["character"] or [int(token,16) for token in match[2].split()] != expected:
+                    same = False
+            # Approved476prefix stays exact; any later appended rows must use
+            # the same pinned bitmap source rather than silently mix fonts.
+            font = parser.load_font(current.source)
+            if any(font.render(row["character"]) != row["masks"] for row in actual["rows"]):
+                same = False
+            if not same:
+                result["errors"].append("Reviewed 476-row font/codebook prefix or same-source glyph tail changed")
+        if not result["errors"]:
+            result["allowedBlocks"] = {label:script_block(approved.text("data/maps/PalletTown/scripts.inc"),label)
+                                       for label in profile["allowedLegacyBlockAlternatives"]}
+            result["passed"] = True
+    except (ValueError,KeyError,IndexError,FileNotFoundError,AssertionError,subprocess.CalledProcessError) as error:
+        result["errors"].append(str(error))
+    return result
