+static const u8 sDeclinedZh[] = _("不急，等你和夥伴\n準備好再回來吧。");
+static const u8 sNotRecordedEn[] = _("No new stamp was recorded.\nYou're welcome to try again.");
+static const u8 sNotRecordedZh[] = _("這次沒有新增印記。\n歡迎再次挑戰。");
+static const u8 sUnavailableEn[] = _("Bring a POKéMON partner\nwhen you're ready to battle.");
+static const u8 sUnavailableZh[] = _("準備對戰時，\n請帶著你的寶可夢夥伴。");
