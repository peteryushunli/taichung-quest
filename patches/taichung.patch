+        tests.require(approach in steps, "The park path from X26 does not reach the Maple Garden's door")
+        changed = sum(cell(x, y) != today[(y - dy) * today_w + x - dx] for y in range(dy, height) for x in range(dx, width))
+        limit = int(re.search(r"#define MAX_MAP_DATA_SIZE\s+(\w+)", now.text("include/fieldmap.h")).group(1), 0)
