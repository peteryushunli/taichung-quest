@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Prepare an unregistered CMP palette using seven proven-unused scene indices.
+
+Existing palette8 indices0..7 and13 remain exact. This is conditional on retiring
+the Calligraphy placeholder and is NOT applied to the released Greenway bank.
+"""
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+from PIL import Image
+
+HERE=Path(__file__).resolve().parent
+GAME=HERE.parents[3]
+PROJECT=GAME.parents[1]
+SOURCE=PROJECT/'artifacts/worktrees/c291d4842985/landmark-art/calligraphy-greenway-study-v1.png'
+BASE='e9a854b969ae3c3bd72a437bd405b4bcdd8c9496'
+PATH='data/tilesets/secondary/taichung_greenway/palettes/08.pal'
+SPARE=[8,9,10,11,12,14,15]
+
+
+def distance(a,b):return sum((x-y)**2 for x,y in zip(a,b))
+
+
+def main():
+    raw=subprocess.check_output(['git','show',f'{BASE}:{PATH}'],cwd=GAME)
+    palette=[tuple(map(int,line.split())) for line in raw.decode().splitlines()[3:] if line.strip()]
+    assert len(palette)==16
+    rgba=Image.open(SOURCE).convert('RGBA');mask=rgba.getchannel('A').point(lambda a:255 if a>=224 else 0)
+    crop=rgba.crop(mask.getbbox());crop.putalpha(mask.crop(mask.getbbox()))
+    scale=min(72/crop.width,80/crop.height);resized=crop.resize((round(crop.width*scale),round(crop.height*scale)),Image.Resampling.NEAREST)
+    samples=[p[:3] for p in resized.get_flattened_data() if p[3]]
+    strip=Image.new('RGB',(len(samples),1));strip.putdata(samples)
+    q=strip.quantize(colors=64,method=Image.Quantize.MEDIANCUT,dither=Image.Dither.NONE);qp=q.getpalette()
+    prototypes=Counter(tuple(min(248,((qp[i*3+c]+4)//8)*8) for c in range(3)) for i in q.get_flattened_data())
+    fixed=[palette[i] for i in range(1,16) if i not in SPARE]
+    added=[]
+    for slot in SPARE:
+        best=min(prototypes,key=lambda color:sum(n*min(distance(p,c) for c in fixed+added+[color]) for p,n in prototypes.items()))
+        added.append(best);palette[slot]=best
+    output=HERE/'palette-candidate';output.mkdir(exist_ok=True)
+    (output/'08.pal').write_bytes(('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,c)) for c in palette)+'\r\n').encode())
+    report=dict(baselineCommit=BASE,sourcePalette=PATH,sourcePaletteGitSha256=hashlib.sha256(raw).hexdigest(),
+                preservedIndices=[0,1,2,3,4,5,6,7,13],newColorsOnlyInSpareIndices=dict(zip(map(str,SPARE),map(list,added))),
+                method='greedy minimum weighted nearest-RGB error over64 opaque GBA-rounded prototypes, keeping all existing used colors fixed',
+                sourceStudyUnchanged=True,registeredInSource=False,
+                condition='Requires last Calligraphy placeholder retirement and repeated prior-render/strip-index guard; never overwrite current e9 palette8 in place')
+    (output/'manifest.json').write_text(json.dumps(report,indent=2)+'\n')
+    print(json.dumps(report,indent=2))
+
+
+if __name__=='__main__':main()
