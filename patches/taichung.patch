+
+const u8 TaichungGym_Text_StationIntroEn[] = _("Welcome to Old Station!\nI'm Jun. I build model trains.\pMy team works just as well.\nThink you can stop us?");
+const u8 TaichungGym_Text_StationIntroZh[] = _("歡迎來到舊臺中車站！\n我是俊，最愛組火車模型。\p我的隊伍也一樣有默契！\n來吧，看你能不能跟上！");
+const u8 TaichungGym_Text_StationDefeatEn[] = _("You found a route I missed!");
+const u8 TaichungGym_Text_StationDefeatZh[] = _("你找到新路線了！");
+static const u8 sOfferEn[] = _("JUN: My model train is ready.\nCare for a Station challenge?\pA win earns your Departure Badge.\nReady when you are!");
+static const u8 sOfferZh[] = _("俊：火車模型準備好了。\n想來場車站挑戰嗎？\p獲勝可得啟程徽章。\n準備好就出發吧！");
+static const u8 sCompleteEn[] = _("A fine journey! Take this\nDeparture Badge!");
+static const u8 sCompleteZh[] = _("你找到新路線了！\n啟程徽章交給你！");
+static const u8 sAlreadyEn[] = _("Your Departure Badge is already\nin your City Pass. Keep exploring!");
+static const u8 sAlreadyZh[] = _("城市護照已有啟程徽章。\n繼續探索吧！");
+static const u8 sDeclinedEn[] = _("No rush. Come back when\nyou and your partner are ready.");
+static const u8 sDeclinedZh[] = _("不急，你和夥伴\n準備好再來吧。");
+static const u8 sNotRecordedEn[] = _("No new badge was recorded.\nYou're welcome to try again.");
+static const u8 sNotRecordedZh[] = _("沒有新增徽章。\n歡迎再挑戰！");
+static const u8 sUnavailableEn[] = _("Bring a POKéMON partner\nwhen you're ready to battle.");
+static const u8 sUnavailableZh[] = _("帶寶可夢夥伴\n來對戰吧！");
+static const u8 *const sStationMessages[][2] = {
+    {sOfferEn, sOfferZh}, {sCompleteEn, sCompleteZh}, {sAlreadyEn, sAlreadyZh},
+    {sDeclinedEn, sDeclinedZh}, {sNotRecordedEn, sNotRecordedZh}, {sUnavailableEn, sUnavailableZh}
+};
+
+// Reusable script API: VAR_0x8004 = permanent gym ID, VAR_0x8005 = trainer ID.
+void TaichungGym_ScriptIsComplete(void)
+{
+    gSpecialVar_Result = TaichungGymIsComplete(gSpecialVar_0x8004);
+}
+
+void TaichungGym_ScriptPrepareChallenge(void)
+{
+    u8 slot;
+    u8 count = CalculatePlayerPartyCount();
+    gSpecialVar_Result = FALSE;
+    for (slot = 0; slot < count; slot++)
+        if (!GetMonData(&gPlayerParty[slot], MON_DATA_IS_EGG) && GetMonData(&gPlayerParty[slot], MON_DATA_HP))
+            break;
+    if (slot == count)
+    {
+        TaichungGymCancelChallenge();
+        return;
+    }
+    gSpecialVar_Result = TaichungGymPrepareChallenge(gSpecialVar_0x8004, gSpecialVar_0x8005);
+    if (gSpecialVar_Result == TRUE)
+        TaichungTeamEnsurePartyLevel();
+}
+
+void TaichungGym_ScriptGetCompletedCount(void)
+{
+    gSpecialVar_Result = TaichungGymGetCompletedCount();
+}
+
+void TaichungGym_ScriptGetResult(void)
+{
+    gSpecialVar_Result = TaichungGymGetLastResult();
+}
+
+void TaichungGym_ScriptCancelChallenge(void)
+{
+    TaichungGymCancelChallenge();
+}
+
+void TaichungGym_ScriptGetStationMessage(void)
+{
+    u16 message = gSpecialVar_0x8005;
+    if (message >= ARRAY_COUNT(sStationMessages))
+        message = TAICHUNG_GYM_MESSAGE_UNAVAILABLE;
+    StringCopy(gStringVar4, TaichungText(sStationMessages[message][0], sStationMessages[message][1]));
+}
diff --git a/src/taichung_gym_entry.c b/src/taichung_gym_entry.c
new file mode 100644
index 00000000..e7446187
--- /dev/null
+++ b/src/taichung_gym_entry.c
@@ -0,0 +1,71 @@
+#include "global.h"
+#include "event_data.h"
+#include "field_message_box.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "script_pokemon_util.h"
+#include "string_util.h"
+#include "strings.h"
+#include "taichung_gym_entry.h"
+#include "taichung_gym_progress.h"
+#include "taichung_language.h"
+#include "taichung_team.h"
+#include "constants/maps.h"
+
+static const u8 sReminderEn[] = _("Prepare a team for this gym?");
+static const u8 sReminderZh[] = _("要先準備挑戰隊伍嗎？");
+static const u8 sTeamReadyEn[] = _("Your random team is ready!");
+static const u8 sTeamReadyZh[] = _("隨機隊伍準備好了！");
+static const u8 sTeamUnavailableEn[] = _("Couldn't fill your team.\nChoose partners from Team.");
+static const u8 sTeamUnavailableZh[] = _("無法組成隨機隊伍。\n可從隊伍選單加入夥伴。");
+const u8 gTaichungTeamReminderChooseEn[] = _("Prepare & begin");
+const u8 gTaichungTeamReminderChooseZh[] = _("準備後開始");
+const u8 gTaichungTeamReminderLaterEn[] = _("Not now");
+const u8 gTaichungTeamReminderLaterZh[] = _("稍後再說");
+
+u8 TaichungGymEntryCurrentGym(void)
+{
+    if (!TaichungTeamNoGrindActive())
+        return TAICHUNG_GYM_NONE;
+    switch (gSaveBlock1Ptr->location.mapNum)
+    {
+    case MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM): return TAICHUNG_GYM_OLD_STATION;
+    case MAP_NUM(MAP_TAICHUNG_PARK_GYM): return TAICHUNG_GYM_PARK;
+    case MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM): return TAICHUNG_GYM_MIYAHARA;
+    case MAP_NUM(MAP_TAICHUNG_SCIENCE_MUSEUM_GYM): return TAICHUNG_GYM_SCIENCE_MUSEUM;
+    case MAP_NUM(MAP_TAICHUNG_GREENWAY_GYM): return TAICHUNG_GYM_GREENWAY;
+    case MAP_NUM(MAP_TAICHUNG_CONFUCIUS_GYM): return TAICHUNG_GYM_CONFUCIUS_TEMPLE;
+    case MAP_NUM(MAP_TAICHUNG_FINE_ARTS_GYM): return TAICHUNG_GYM_FINE_ARTS;
+    case MAP_NUM(MAP_TAICHUNG_FENGJIA_GYM): return TAICHUNG_GYM_FENGJIA;
+    // The saved bit name predates Muqing's move to Wanhe Temple.
+    case MAP_NUM(MAP_TAICHUNG_WANHE_TEMPLE_HALL): return TAICHUNG_GYM_MAPLE_GARDEN;
+    case MAP_NUM(MAP_TAICHUNG_THEATER_GYM): return TAICHUNG_GYM_THEATER;
+    }
+    return TAICHUNG_GYM_NONE;
+}
+
+bool8 TaichungGymEntryShouldRemind(void)
+{
+    u8 gym = TaichungGymEntryCurrentGym();
+    return gym != TAICHUNG_GYM_NONE
+        && !TaichungGymIsComplete(gym);
+}
+
+void TaichungGymEntry_ScriptCheck(void)
+{
+    TaichungTeamSyncPresetMoves();
+    gSpecialVar_Result = TaichungGymEntryShouldRemind();
+    if (gSpecialVar_Result)
+        StringCopy(gStringVar4, TaichungText(sReminderEn, sReminderZh));
+}
+
+
+void TaichungGymEntry_ScriptFillRandom(void)
+{
+    u16 choice = gSpecialVar_Result;
+    bool8 filled = choice >= 1 && choice <= 3
+        && TaichungGymEntryShouldRemind() && TaichungTeamFillRandom(choice + 2);
+    gSpecialVar_Result = filled;
+    StringCopy(gStringVar4, filled ? TaichungText(sTeamReadyEn, sTeamReadyZh)
+                                  : TaichungText(sTeamUnavailableEn, sTeamUnavailableZh));
+}
