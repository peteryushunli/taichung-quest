+const u8 gText_PlayerScurriedBackHome[] = "field-9";
+const u8 gText_PlayerSavedTheGame[] = "{PLAYER} saved the game.";
+
+int main(void)
+{
+    static const u8 *const targets[] = {
+        gText_QuestLog_SwitchMon1WithMon2,
+        gText_QuestLog_UsedTheItem,
+        gText_QuestLog_WithdrewItemFromPC,
+        gText_QuestLog_GaveMonHeldItemFromPC,
