+                TaichungSaveUpgradeOnContinue(); AssertAfterCmp(x,sGreenwayV5SafeRuns[i][0]);
+                assert(sWarpRequests == 1); AssertSamePartyAndVars(&before); count++;
+                if (IsNewGreenwayFloor(x,sGreenwayV5SafeRuns[i][0])) newly++;
+            }
+        assert(count == 1995 && newly == 97 && count-newly == 1898);
+        // Pending explicit Greenway coordinates are repaired even from an unrelated source map.
+        for (i = 0; i < COUNT(sGreenwayV5Cases); i++)
+        {
+            Versioned(version); sHasContinueWarp = TRUE;
