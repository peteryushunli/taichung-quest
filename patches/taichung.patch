diff --git a/include/taichung_language_bridge.h b/include/taichung_language_bridge.h
new file mode 100644
index 0000000..8124fe6
--- /dev/null
+++ b/include/taichung_language_bridge.h
@@ -0,0 +1,52 @@
+#ifndef GUARD_TAICHUNG_LANGUAGE_BRIDGE_H
+#define GUARD_TAICHUNG_LANGUAGE_BRIDGE_H
+
+#include "gba/types.h"
+
+// Little-endian bytes "TCLANG01". This packet is volatile EWRAM, never SRAM.
+#define TAICHUNG_LANGUAGE_BRIDGE_MAGIC_A 0x414C4354
+#define TAICHUNG_LANGUAGE_BRIDGE_MAGIC_B 0x3130474E
+#define TAICHUNG_LANGUAGE_BRIDGE_VERSION 1
+#define TAICHUNG_LANGUAGE_BRIDGE_SIZE 32
+
+#define TAICHUNG_LANGUAGE_BRIDGE_READY 1
+#define TAICHUNG_LANGUAGE_BRIDGE_SAFE_FIELD 2
+
+#define TAICHUNG_LANGUAGE_BRIDGE_NONE 0
+#define TAICHUNG_LANGUAGE_BRIDGE_APPLIED 1
+#define TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON 2
+#define TAICHUNG_LANGUAGE_BRIDGE_UNSET 3
+#define TAICHUNG_LANGUAGE_BRIDGE_INVALID 4
+
+struct TaichungLanguageBridge
+{
+    /* 0x00 */ u32 magicA;
+    /* 0x04 */ u32 magicB;
+    /* 0x08 */ u16 version;
+    /* 0x0A */ u16 size;
+    /* 0x0C */ u32 selfGbaAddress;
+    /* 0x10 */ u32 frameCounter;
+    /* 0x14 */ u8 activeLanguage; // 0 unset, 1 English, 2 Traditional Chinese
+    /* 0x15 */ u8 requestedLanguage; // Browser owns this byte and requestSequence only.
+    /* 0x16 */ u8 flags;
+    /* 0x17 */ u8 result;
+    /* 0x18 */ u32 requestSequence;
+    /* 0x1C */ u32 ackSequence;
+};
+
+extern volatile struct TaichungLanguageBridge gTaichungLanguageBridge;
+
+void TaichungLanguageBridge_Tick(bool8 gameCallbacksRan);
+void TaichungLanguageBridge_OnNativeChoice(u16 language);
+
+// Shared by the native adapter and host protocol checks. The writer must return
+// success only after committing the language variable. An acknowledgement is
+// published last, so it never promises a change that has not happened yet.
+typedef bool8 (*TaichungLanguageBridgeWriter)(u8 language);
+void TaichungLanguageBridge_UpdatePacket(volatile struct TaichungLanguageBridge *packet,
+                                       u32 selfGbaAddress, u8 nativeLanguage,
+                                       bool8 variablesReady, bool8 safeField,
+                                       TaichungLanguageBridgeWriter writer);
+void TaichungLanguageBridge_PublishNativeChoice(volatile struct TaichungLanguageBridge *packet, u16 language);
+
+#endif
