+    TaichungSaveUpgradeOnContinue(); AssertGreenwayWarp(8,40);
+    assert(V(0x40F7) == 6 && TaichungSaveUsesStationCheckpoint() && sChallengeCancels == 1); AssertProtected(&before,TRUE);
+    for (version = 6; version <= 7; version++)
+    {
+        Versioned(version); InGreenway(8,41); before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 0 && sVariableWrites == 0 && sChallengeCancels == 1);
+    }
+    Versioned(4); InGreenway(8,41); TaichungSaveUpgradeOnContinue(); assert(sWarpRequests == 1 && sChallengeCancels == 1);
+    sHasContinueWarp = FALSE; before = sSave; TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 1 && sVariableWrites == 1 && sChallengeCancels == 2);
+}
