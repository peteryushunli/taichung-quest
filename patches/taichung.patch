index 0000000..a6ee075
--- /dev/null
+++ b/tools/taichung/landmarks/audit_old_core_primary.py
@@ -0,0 +1,339 @@
+#!/usr/bin/env python3
+"""Read-only capacity audit for a possible scene-specialized OldCity primary.
+
+Writes only the audit JSON. It does not create a tileset, alter General, remap a
+metatile, assign a bank, or assert that arbitrary runtime mutations are safe.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+PROJECT = ROOT.parents[1]
+ARTIFACT = PROJECT / "artifacts/worktrees/c291d4842985"
+OUTPUT = ROOT / "data/taichung/landmarks/old-core-bank-audit.json"
+V4 = ARTIFACT / "neighborhoods/r2c2-filled-v4"
+PRIMARY = ROOT / "data/tilesets/primary/general"
+PEWTER = ROOT / "data/tilesets/secondary/pewter_city"
+MAPS = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+
+
+class Inputs:
+    def __init__(self):
+        self.raw = {}
+
+    def read(self, path):
+        path = Path(path)
+        if path not in self.raw:
+            self.raw[path] = path.read_bytes()
+        return self.raw[path]
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        return list(struct.unpack(f"<{len(raw)//struct.calcsize(kind)}{kind}", raw))
+
+    def image(self, path):
+        self.read(path)
+        image = Image.open(path)
+        if image.mode != "P" or image.getextrema()[1] > 15:
+            raise ValueError(f"Expected indexed 4bpp source: {path}")
+        return image
+
+    def provenance(self):
+        return {str(path.relative_to(PROJECT)): hashlib.sha256(raw).hexdigest()
+                for path, raw in sorted(self.raw.items())}
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+def canonical(pixels):
+    return min(flip(pixels, flags) for flags in (0, 0x400, 0x800, 0xC00))
+
+
+def pattern(image, graphic):
+    x, y = graphic % (image.width//8)*8, graphic // (image.width//8)*8
+    return canonical(tuple(image.getpixel((x+dx, y+dy)) for dy in range(8) for dx in range(8)))
+
+
+def ranges(values):
+    result = []
+    for number in sorted(values):
+        if result and number == result[-1][1]+1:
+            result[-1][1] = number
+        else:
+            result.append([number, number])
+    return result
+
+
+def audit(output=OUTPUT):
+    inputs = Inputs()
+    spec = importlib.util.spec_from_file_location("audit_native_renderer", ROOT / "tools/taichung/render_maps.py")
+    renderer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(renderer)
+    inputs.read(ROOT / "tools/taichung/render_maps.py")
+    for file in ("headers.h", "graphics.h", "metatiles.h"):
+        inputs.read(ROOT / "src/data/tilesets" / file)
+    inputs.read(ROOT / "src/graphics.c")
+    general = inputs.words(PRIMARY / "metatiles.bin")
+    general_attrs = inputs.words(PRIMARY / "metatile_attributes.bin", "I")
+    image = inputs.image(PRIMARY / "tiles.png")
+    assert image.width*image.height//64 == 640
+    source_patterns = {n: pattern(image, n) for n in range(640)}
+    animations = inputs.text(ROOT / "src/tileset_anims.c")
+    animation_writes = sorted((int(start), int(count)) for start, count in re.findall(
+        r"AppendTilesetAnimToBuffer\(sTilesetAnims_General_[^;]*?TILE_OFFSET_4BPP\((\d+)\)\),\s*(\d+)\s*\*\s*TILE_SIZE_4BPP\);", animations))
+    assert animation_writes == [(416, 48), (464, 18), (508, 4)], animation_writes
+    animated = {tile for start, count in animation_writes for tile in range(start, start+count)}
+    door_source = inputs.text(ROOT / "src/field_door.c")
+    assert "#define DOOR_TILE_START (NUM_TILES_TOTAL - 8)" in door_source
+    scratch = set(range(1016, 1024))
+    records, required_graphics, primary_metatiles, behavior_ids = [], set(), set(), set()
+
+    def collect(label, words, secondary):
+        secondary_defs = inputs.words(secondary / "metatiles.bin")
+        secondary_attrs = inputs.words(secondary / "metatile_attributes.bin", "I")
+        metatiles = {word & 1023 for word in words}
+        graphics, primary_metas = set(), set()
+        for tile in metatiles:
+            if tile < 640:
+                definitions, attributes, index = general, general_attrs, tile
+                primary_metas.add(tile)
+            else:
+                definitions, attributes, index = secondary_defs, secondary_attrs, tile-640
+            assert index < len(attributes), (label, tile)
+            behavior_ids.add(attributes[index] & 0x1FF)
+            for entry in definitions[index*8:index*8+8]:
+                graphic = entry & 1023
+                if graphic < 640:
+                    graphics.add(graphic)
+        required_graphics.update(graphics)
+        primary_metatiles.update(primary_metas)
+        records.append({"input": label, "secondaryDefinitions": str(secondary.relative_to(PROJECT)),
+                        "usedMetatileCount": len(metatiles), "generalMetatileIds": sorted(primary_metas),
+                        "generalGraphicIdsIncludingSecondaryCrossReferences": sorted(graphics)})
+
+    layouts = inputs.json(ROOT / "data/layouts/layouts.json")["layouts"]
+    map_records = []
+    for name in MAPS:
