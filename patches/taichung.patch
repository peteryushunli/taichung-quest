+        Versioned(version); InGreenway(8,41); sHasContinueWarp = TRUE;
+        sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1;
+        sSave.continueGameWarp.x = 24; sSave.continueGameWarp.y = 23; before = sSave;
+        TaichungSaveUpgradeOnContinue(); AssertGreenwayWarp(24,23); assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+        // Version matrix:1/2 all3,3 Xitun+Greenway,4 Greenway only.
+        for (map = 0; map < 3; map++)
+        {
+            bool8 expected = version < 3 || map == MAP_NUM(MAP_TAICHUNG_XITUN)
+                || (version < 6 && map == MAP_NUM(MAP_TAICHUNG_GREENWAY));
+            Versioned(version); InOldCity(positions[map][0],positions[map][1]); sSave.location.mapNum = map; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(sHasContinueWarp == expected && sWarpRequests == (unsigned)expected);
