diff --git a/src/taichung_ambient.c b/src/taichung_ambient.c
new file mode 100644
index 00000000..6690e000
--- /dev/null
+++ b/src/taichung_ambient.c
@@ -0,0 +1,173 @@
+#include "global.h"
+#include "event_object_movement.h"
+#include "fieldmap.h"
+#include "load_save.h"
+#include "overworld.h"
+#include "taichung_ambient.h"
+#include "taichung_save.h"
+#include "constants/event_object_movement.h"
+#include "constants/event_objects.h"
+#include "constants/maps.h"
+#include "constants/trainer_types.h"
+
+// Exact reviewed actors only. This is ROM data, not a saved schema or a new
+// runtime object pool. Old actors retain their existing map-local identities.
+struct AmbientActor
+{
+    u8 mapNum, localId, graphicsId, movementType;
+    s16 x, y;
+    u8 rangeX, rangeY;
+    u16 overlapStart;
+    u8 overlapCount;
+};
+
+static const struct AmbientActor sAmbientActors[] = {
+#include "../data/taichung/ambient-npcs/native-registry.inc"
+};
+
+static const struct Coords16 sAmbientOverlapOffsets[] = {
+#include "../data/taichung/ambient-npcs/native-overlap-offsets.inc"
+};
+
+static bool8 MatchesActor(const struct ObjectEventTemplate *object, const struct AmbientActor *actor)
+{
+    return object->localId == actor->localId
+        && object->graphicsId == actor->graphicsId
+        && object->kind == OBJ_KIND_NORMAL
+        && object->x == actor->x && object->y == actor->y
+        && object->flagId == 0
+        && object->objUnion.normal.trainerType == TRAINER_TYPE_NONE
+        && object->objUnion.normal.movementType == actor->movementType
+        && object->objUnion.normal.movementRangeX == actor->rangeX
+        && object->objUnion.normal.movementRangeY == actor->rangeY;
+}
+
+static const struct ObjectEventTemplate *RegisteredTemplate(const struct MapHeader *header,
+                                                           const struct AmbientActor *actor)
+{
+    const struct ObjectEventTemplate *object;
+    u8 index = actor->localId - 1;
+
+    if (actor->localId == 0 || header->events == NULL
+        || header->events->objectEventCount > OBJECT_EVENT_TEMPLATES_COUNT
+        || index >= header->events->objectEventCount)
+        return NULL;
+    object = &header->events->objectEvents[index];
+    if (!MatchesActor(object, actor))
+        return NULL;
+    return object;
+}
+
+void TaichungAmbientRefreshOnContinue(void)
+{
+    const struct MapHeader *header;
+    const struct AmbientActor *actor;
+    const struct ObjectEventTemplate *current, *saved;
+    struct WarpData *warp;
+    u16 i;
+
+    if (gSaveBlock1Ptr == NULL || UseContinueGameWarp()
+        || gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_TAICHUNG_OLD_CITY))
+        return;
+    for (i = 0; i < NELEMS(sAmbientActors); i++)
+    {
+        actor = &sAmbientActors[i];
+        if (gSaveBlock1Ptr->location.mapNum != actor->mapNum)
+            continue;
+        header = Overworld_GetMapHeaderByGroupAndId(MAP_GROUP(MAP_TAICHUNG_OLD_CITY), actor->mapNum);
+        if (header == NULL || header->mapLayout == NULL
+            || gSaveBlock1Ptr->pos.x < 0 || gSaveBlock1Ptr->pos.y < 0
+            || gSaveBlock1Ptr->pos.x >= header->mapLayout->width
+            || gSaveBlock1Ptr->pos.y >= header->mapLayout->height)
+            return;
+        current = RegisteredTemplate(header, actor);
+        if (current == NULL)
+            continue;
+        saved = &gSaveBlock1Ptr->objectEventTemplates[actor->localId - 1];
+        // Native roaming saves currentCoords in objectEvents, while templates
+        // retain their authored anchors. Refresh a changed authored anchor
+        // (including the old Greenway Walker start), not live patrol motion.
+        if (saved->localId == current->localId && saved->graphicsId == current->graphicsId
+            && saved->kind == current->kind && saved->flagId == current->flagId
+            && saved->x == current->x && saved->y == current->y
+            && saved->script == current->script
+            && saved->objUnion.normal.trainerType == current->objUnion.normal.trainerType
+            && saved->objUnion.normal.movementType == current->objUnion.normal.movementType
+            && saved->objUnion.normal.movementRangeX == current->objUnion.normal.movementRangeX
+            && saved->objUnion.normal.movementRangeY == current->objUnion.normal.movementRangeY)
+            continue;
+
+        // Reuse the full native map-load path, exact saved position and facing.
+        // Pending returns/migrations have priority; no player or progress edit.
+        warp = &gSaveBlock1Ptr->continueGameWarp;
+        *warp = gSaveBlock1Ptr->location;
+        warp->warpId = -1;
+        warp->x = gSaveBlock1Ptr->pos.x;
+        warp->y = gSaveBlock1Ptr->pos.y;
+        TaichungSaveRememberObjectCacheRefreshFacing();
+        SetContinueGameWarpStatus();
+        return;
+    }
+}
+
+void TaichungAmbientAvoidPlayerOverlap(s16 playerX, s16 playerY)
+{
+    const struct AmbientActor *actor;
+    const struct ObjectEventTemplate *current;
+    const struct MapHeader *header;
+    struct ObjectEvent *object;
+    s16 x, y;
+    const struct Coords16 *offset;
+    u16 i;
+    u8 objectId, direction, candidate;
+    bool8 moved;
+
+    if (gSaveBlock1Ptr == NULL
+        || gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_TAICHUNG_OLD_CITY))
+        return;
+    for (i = 0; i < NELEMS(sAmbientActors); i++)
+    {
+        actor = &sAmbientActors[i];
+        if (gSaveBlock1Ptr->location.mapNum != actor->mapNum
+            || playerX != actor->x || playerY != actor->y)
+            continue;
+        header = Overworld_GetMapHeaderByGroupAndId(MAP_GROUP(MAP_TAICHUNG_OLD_CITY), actor->mapNum);
+        if (header == NULL || (current = RegisteredTemplate(header, actor)) == NULL
+            || TryGetObjectEventIdByLocalIdAndMap(actor->localId, actor->mapNum,
+                                               MAP_GROUP(MAP_TAICHUNG_OLD_CITY), &objectId))
+            continue;
+        object = &gObjectEvents[objectId];
+        if (object->isPlayer || object->graphicsId != actor->graphicsId
+            || object->currentCoords.x != playerX + MAP_OFFSET
+            || object->currentCoords.y != playerY + MAP_OFFSET)
+            continue;
+        // Follow Maps' exact reviewed order. Reposition only the newly
+        // spawned NPC; retain the authored template/initialCoords and bounds.
+        // Native collision rejects terrain, elevations and occupied cells.
+        moved = FALSE;
+        for (candidate = 0; candidate < actor->overlapCount; candidate++)
+        {
+            if (actor->overlapStart + candidate >= NELEMS(sAmbientOverlapOffsets))
+                break;
+            offset = &sAmbientOverlapOffsets[actor->overlapStart + candidate];
+            if ((offset->x == 0 && offset->y == 0)
+             || offset->x < -actor->rangeX || offset->x > actor->rangeX
+             || offset->y < -actor->rangeY || offset->y > actor->rangeY)
+                continue;
+            x = actor->x + MAP_OFFSET + offset->x;
+            y = actor->y + MAP_OFFSET + offset->y;
+            direction = offset->x ? (offset->x > 0 ? DIR_EAST : DIR_WEST)
+                                  : (offset->y > 0 ? DIR_SOUTH : DIR_NORTH);
+            if (GetCollisionAtCoords(object, x, y, direction) != COLLISION_NONE)
+                continue;
+            MoveObjectEventToMapCoords(object, x, y);
+            moved = TRUE;
+            break;
+        }
+        if (!moved)
+            // Exact registered actors have flagId0. Native FlagSet(0) returns
+            // without any saved write; removal is only for this loaded view.
+            RemoveObjectEventByLocalIdAndMap(current->localId, actor->mapNum,
+                                            MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    }
+}
