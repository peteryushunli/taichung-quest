+        report["passed"] = report["passed"] and nantun["passed"]
+        report["nantunIncrement"] = {"guard": NANTUN_GUARD, "baselineCommit": nantun["baselineCommit"], "passed": nantun["passed"],
+                                     "checks": {k: v["passed"] for k, v in nantun["checks"].items()}}
+    return report
