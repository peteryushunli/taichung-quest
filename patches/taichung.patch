+#!/usr/bin/env python3
+"""Prepare the approved Theater bank and map proposal; never register or install.
+
+The source scene, rather than the full unused prefab catalog, determines which
+Pewter metatiles must survive. Original IDs remain stable. The reviewed raster
+is only mechanically encoded; no pixels are redrawn by this tool.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+OUTPUT = ROOT / "data/tilesets/secondary/taichung_xitun"
+INPUT = ROOT / "data/taichung/landmarks/theater/candidate/candidate-indexed.png"
+PRIMARY = ROOT / "data/tilesets/primary/general"
+SECONDARY = ROOT / "data/tilesets/secondary/pewter_city"
+MAP = ROOT / "data/layouts/TaichungXitun/map.bin"
+BORDER = MAP.with_name("border.bin")
+ARTIFACTS = ROOT.parents[1] / "artifacts/worktrees/c291d4842985/landmark-art"
+ORIGIN, SIZE, DOOR, APPROACH, ARRIVAL = (4, 35), (16, 10), (12, 44), (12, 45), (12, 47)
+OLD_FOOTPRINT = (7, 38, 17, 44)
+WIDTH, HEIGHT, PAVING, DOOR_WORD = 40, 64, 0x3175, 0x043D
+
+
+def values(path, kind="H"):
+    data = path.read_bytes()
+    return list(struct.unpack(f"<{len(data) // struct.calcsize(kind)}{kind}", data))
+
+
+def save_values(path, items, kind="H"):
+    path.write_bytes(struct.pack(f"<{len(items)}{kind}", *items))
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+class Bank:
+    def __init__(self):
+        self.graphics, self.lookup = [], {}
+
+    def pack(self, pixels):
+        canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+        if canonical not in self.lookup:
+            self.lookup[canonical] = len(self.graphics)
+            self.graphics.append(canonical)
+        return 640 + self.lookup[canonical] | flags
+
+
+def pixels(image, tile):
+    x, y = tile % (image.width // 8) * 8, tile // (image.width // 8) * 8
+    return tuple(image.getpixel((x+dx, y+dy)) for dy in range(8) for dx in range(8))
+
+
+def inside(x, y, rectangle):
+    return rectangle[0] <= x <= rectangle[2] and rectangle[1] <= y <= rectangle[3]
+
+
+def baseline_bytes():
+    """Permit a repeat build after registration, using the frozen source map."""
+    budget = json.loads((INPUT.parent / "integration-budget.json").read_text())
+    expected = budget["sourceSha256"][str(MAP.relative_to(ROOT))]
+    for path in (MAP, OUTPUT / "proposal/baseline-map.bin"):
+        if path.exists() and sha(path.read_bytes()) == expected:
+            return path.read_bytes()
+    raise ValueError("Xitun source changed; review a new baseline instead of silently replacing it")
+
+
+def colors(path):
+    result = [tuple(map(int, line.split())) for line in path.read_text().splitlines()[3:] if line.strip()]
+    if len(result) != 16:
+        raise ValueError(f"Expected 16 colors: {path}")
+    return result
+
+
+def render_metatiles(secondary):
+    """Source renderer with explicit directories, so no C registration is needed.
+
+    As with render_maps.py, this shows initial animation frames, omits objects,
+    and uses JASC RGB colors. It is source QA, not an emulator screenshot.
+    """
+    folders = (PRIMARY, secondary)
+    sheets = [Image.open(folder / "tiles.png") for folder in folders]
+    definitions = [values(folder / "metatiles.bin") for folder in folders]
+    palettes = [colors(folders[0 if n < 7 else 1] / f"palettes/{n:02}.pal") for n in range(16)]
+    rendered = []
+    for tile in range(640 + len(definitions[1]) // 8):
+        set_n, pos = (0, tile) if tile < 640 else (1, tile-640)
+        image = Image.new("RGB", (16, 16))
+        for layer in range(2):
+            for q, word in enumerate(definitions[set_n][pos*8+layer*4:pos*8+layer*4+4]):
+                graphic, palette = word & 1023, palettes[word >> 12]
+                source = sheets[0 if graphic < 640 else 1]
+                n = graphic if graphic < 640 else graphic-640
+                for y in range(8):
+                    for x in range(8):
+                        sx, sy = 7-x if word & 0x400 else x, 7-y if word & 0x800 else y
+                        index = source.getpixel((n%16*8+sx, n//16*8+sy))
+                        if index or layer == 0:
+                            image.putpixel((q%2*8+x, q//2*8+y), palette[index])
+        rendered.append(image)
+    return rendered
+
+
+def render_scene(secondary, map_words):
+    tiles = render_metatiles(secondary)
+    image = Image.new("RGB", (WIDTH*16, HEIGHT*16))
+    for n, word in enumerate(map_words):
+        image.paste(tiles[word & 1023], (n%WIDTH*16, n//WIDTH*16))
+    return image
+
+
+def compile_bank(output=OUTPUT, artifacts=ARTIFACTS):
+    art = Image.open(INPUT)
+    if art.mode != "P" or art.size != (256, 160) or art.getextrema()[1] > 15 or art.info.get("transparency") != 0:
+        raise ValueError("Theater input must be 256x160 indexed 4bpp with transparent index0")
+    baseline_raw = baseline_bytes()
+    original = list(struct.unpack(f"<{len(baseline_raw)//2}H", baseline_raw))
+    if len(original) != WIDTH*HEIGHT or original[DOOR[1]*WIDTH+DOOR[0]] != DOOR_WORD:
+        raise ValueError("Baseline dimensions or fixed General door changed")
+    # Only the obsolete facade is erased. The surrounding city and road retain
+    # their exact original map words, including collision/elevation bits.
+    ground = original.copy()
+    for y in range(OLD_FOOTPRINT[1], OLD_FOOTPRINT[3]+1):
+        for x in range(OLD_FOOTPRINT[0], OLD_FOOTPRINT[2]+1):
+            ground[y*WIDTH+x] = PAVING
+    needed = {word & 1023 for word in ground + values(BORDER)}
+    source_metatiles = values(SECONDARY / "metatiles.bin")
+    source_attrs = values(SECONDARY / "metatile_attributes.bin", "I")
+    source_sheet = Image.open(SECONDARY / "tiles.png")
+    source_count = len(source_attrs)
+    if len(source_metatiles) != source_count*8 or any(t >= 640+source_count for t in needed):
+        raise ValueError("Unexpected source metatile definitions")
+    bank = Bank()
+    entries, attrs = [0]*len(source_metatiles), [0]*source_count
+    source_graphics, source_palettes = set(), set()
+    for tile in sorted(t for t in needed if t >= 640):
+        offset = (tile-640)*8
+        for q, word in enumerate(source_metatiles[offset:offset+8]):
+            source_palettes.add(word >> 12)
+            graphic = word & 1023
+            if graphic >= 640:
+                source_graphics.add(graphic)
+                packed = bank.pack(pixels(source_sheet, graphic-640))
+                word = (word & 0xF000) | ((word & 0xC00) ^ (packed & 0xC00)) | (packed & 1023)
+            entries[offset+q] = word
+        attrs[tile-640] = source_attrs[tile-640]
+    if 7 in source_palettes:
+        raise ValueError("The remaining source scene already uses Theater palette7")
+    source_used = len(bank.graphics)
+    primary = values(PRIMARY / "metatiles.bin")
+    paving = primary[(PAVING & 1023)*8:(PAVING & 1023)*8+8]
+    if paving[4:] != [0]*4:
+        raise ValueError("Paving uses a foreground layer; explicit compositing is required")
+    proposal, blocked = ground.copy(), []
+    first = 640+len(attrs)
+    for y in range(SIZE[1]):
+        row = ""
+        for x in range(SIZE[0]):
+            gx, gy = ORIGIN[0]+x, ORIGIN[1]+y
+            occupied = any(art.getpixel((x*16+dx, y*16+dy)) for dy in range(16) for dx in range(16))
+            top = [bank.pack(pixels(art, (y*2+dy)*32+x*2+dx)) | 0x7000
+                   for dy in range(2) for dx in range(2)]
+            # All painted baseline cells stand over the same plaza paving.
+            # Empty cells retain the original scene instead of stamping paving.
+            if occupied and (ground[gy*WIDTH+gx] & 1023) != (PAVING & 1023):
+                raise ValueError(f"Painted cell overlaps non-plaza source at {gx},{gy}")
+            tile = 640+len(attrs)
+            entries.extend(paving[:4]+top)
+            attrs.append(0x20000000 if y == SIZE[1]-1 else 0)
+            if occupied:
+                proposal[gy*WIDTH+gx] = tile | 0x400
+            row += "1" if occupied else "0"
+        blocked.append(row)
+    # General's existing animated door and warp remain the first integration
+    # contract. Its 16x16 art replaces this one raster cell intentionally.
+    proposal[DOOR[1]*WIDTH+DOOR[0]] = DOOR_WORD
+    physical = ((len(bank.graphics)+15)//16)*16
+    if physical > 384 or len(bank.graphics) > 376 or len(attrs) > 384:
+        raise ValueError("Native secondary bank capacity exceeded")
+    output.mkdir(parents=True, exist_ok=True)
+    image = Image.new("P", (128, physical//16*8))
+    image.putpalette(art.getpalette())
+    for n, data in enumerate(bank.graphics):
+        for y in range(8):
+            for x in range(8):
+                image.putpixel((n%16*8+x, n//16*8+y), data[y*8+x])
+    image.save(output / "tiles.png")
+    # Include padded graphics in 4bpp exactly as Make/gbagfx will encode them.
+    flat = [image.getpixel((n%16*8+x, n//16*8+y)) for n in range(physical) for y in range(8) for x in range(8)]
+    (output / "tiles.4bpp").write_bytes(bytes(flat[i] | flat[i+1] << 4 for i in range(0, len(flat), 2)))
+    save_values(output / "metatiles.bin", entries)
+    save_values(output / "metatile_attributes.bin", attrs, "I")
+    (output / "palettes").mkdir(exist_ok=True)
+    for n in range(16):
+        source = INPUT.parent / "07.pal" if n == 7 else SECONDARY / f"palettes/{n:02}.pal"
+        destination = output / f"palettes/{n:02}.pal"
+        destination.write_bytes(source.read_bytes())
+        save_values(destination.with_suffix(".gbapal"), [r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors(source)])
+    proposal_folder = output / "proposal"
+    proposal_folder.mkdir(exist_ok=True)
+    (proposal_folder / "baseline-map.bin").write_bytes(baseline_raw)
+    (proposal_folder / "border.bin").write_bytes(BORDER.read_bytes())
+    save_values(proposal_folder / "map.bin", proposal)
+    source_files = [INPUT, BORDER, PRIMARY / "tiles.png", PRIMARY / "metatiles.bin", PRIMARY / "metatile_attributes.bin",
+                    SECONDARY / "tiles.png", SECONDARY / "metatiles.bin", SECONDARY / "metatile_attributes.bin",
+                    ROOT / "data/maps/TaichungXitun/map.json", ROOT / "data/maps/TaichungTheater_Gym/map.json"]
+    source_files += [PRIMARY / f"palettes/{n:02}.pal" for n in range(7)]
+    source_files += [SECONDARY / f"palettes/{n:02}.pal" for n in range(16)] + [INPUT.parent / "07.pal"]
+    source_hashes = {str(p.relative_to(ROOT)): sha(p.read_bytes()) for p in source_files}
+    source_hashes[str(MAP.relative_to(ROOT))] = sha(baseline_raw)
+    manifest = {
+        "schemaVersion": 1, "assetId": "landmark-national-taichung-theater-v1",
+        "status": "prepared native bank and map proposal; not registered; runtime validation pending",
+        "registeredInRom": False, "nativeReady": False,
+        "input": str(INPUT.relative_to(ROOT)), "inputSha256": sha(INPUT.read_bytes()),
+        "sourceSha256": source_hashes,
+        "graphics": {"sourceGraphicsBeforeDedup": len(source_graphics), "sourceGraphicsAfterDedup": source_used,
+                     "theaterGraphicsAdded": len(bank.graphics)-source_used, "uniqueSecondaryTotal": len(bank.graphics),
+                     "loadedIncludingSheetPadding": physical, "secondaryCapacity": 384,
+                     "sceneGraphicsCapacity": 376, "doorAnimationScratchSlots": 8,
+                     "spareBeforePadding": 376-len(bank.graphics),
+                     "immediatelyAvailablePaddedSlots": max(0, 376-physical)},
+        "futureColorFamilies": {"notIncluded": True, "unusedPrefabCatalogPacked": False,
+                                "requiresSceneUsageAndPaletteRecount": True,
+                                "budgetNote": "24 immediately unallocated scene slots; 15 padded blanks can be reclaimed by recompiling. Eight door-animation scratch slots remain reserved. No promise that a whole future neighborhood kit fits."},
+        "metatiles": {"sourceIdRangePreserved": [640, 640+source_count-1], "sourceDefinitionSlots": source_count,
+                      "unneededSourceDefinitionsZeroed": True, "firstTheaterId": first, "theaterCount": SIZE[0]*SIZE[1],
+                      "secondaryTotal": len(attrs), "secondaryCapacity": 384},
+        "preservedSourceMetatiles": sorted(t for t in needed if t >= 640),
+        "sourceGraphicIds": sorted(source_graphics),
+        "palettes": {"theater": 7, "sourceUsedAndPreserved": sorted(source_palettes),
+                     "sourceFilesPreservedExcept": [7], "loadedBackgroundPaletteRange": [0, 12],
+                     "primaryPalettesUnchanged": True},
+        "placement": {"mapId": "MAP_TAICHUNG_XITUN", "mapSize": [WIDTH, HEIGHT],
+                      "origin": list(ORIGIN), "size": list(SIZE), "oldFacadeRemovedInclusive": list(OLD_FOOTPRINT),
+                      "oldFacadeRestorationWord": "0x3175", "occupiedRows": blocked,
+                      "door": list(DOOR), "doorWord": "0x043D", "doorBehavior": "MB_WARP_DOOR",
+                      "doorRasterCellIntentionallyReplacedByGeneralDoor": True,
+                      "approach": list(APPROACH), "arrival": list(ARRIVAL),
+                      "transparentMetatilePolicy": "retain underlying source word after restoring only obsolete facade",
+                      "frontFacadeLayerType": "COVERED; player renders in front", "roofLayerType": "NORMAL",
+                      "mapleStreetRowsPreserved": [35, 36, 37]},
+        "proposal": {"map": str((proposal_folder / "map.bin").relative_to(ROOT)) if output.is_relative_to(ROOT) else "proposal/map.bin",
+                     "baselineSha256": sha(baseline_raw), "mapSha256": sha((proposal_folder / "map.bin").read_bytes()),
+                     "changedCellCount": sum(a != b for a, b in zip(original, proposal)),
+                     "requiresRootRegistration": ["secondary bank C declarations", "LAYOUT_TAICHUNG_XITUN secondary label", "reviewed proposal/map.bin copy"],
+                     "registeredSourceMapWasNotWritten": True},
+        "qa": {"renderKind": "source raster, initial animation frame, no object events or player; not runtime",
+               "cropSizePixels": [240, 160], "runtimeChecksRemaining": ["walk and bicycle approach", "animated entry and three interior returns", "front wall/roof layering"]},
+    }
+    # Output-relative paths keep temporary reproducibility runs byte-identical.
+    manifest["proposal"]["map"] = "proposal/map.bin"
+    (output / "compile-manifest.json").write_text(json.dumps(manifest, indent=2)+"\n")
+    if artifacts is not None:
+        artifacts.mkdir(parents=True, exist_ok=True)
+        scene = render_scene(output, proposal)
+        scene.save(artifacts / "theater-proposed-map-source.png")
+        for label, center in (("door", DOOR), ("arrival", ARRIVAL), ("roof", (12, 40))):
+            x, y = center[0]*16+8-120, center[1]*16+8-80
+            scene.crop((x, y, x+240, y+160)).save(artifacts / f"theater-proposed-{label}-source.png")
+    return manifest, proposal
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    parser.add_argument("--artifacts", type=Path, default=ARTIFACTS)
+    parser.add_argument("--no-render", action="store_true")
+    args = parser.parse_args()
+    result, _ = compile_bank(args.output, None if args.no_render else args.artifacts)
+    print(json.dumps({"graphics": result["graphics"], "proposal": result["proposal"]}, indent=2))
