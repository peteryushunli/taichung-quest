+static void AssertGreenwayWarp(s16 x, s16 y)
+{
+    assert(sHasContinueWarp && sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.mapGroup == MAP_GROUP(MAP_TAICHUNG_GREENWAY));
+    assert(sSave.continueGameWarp.mapNum == MAP_NUM(MAP_TAICHUNG_GREENWAY));
+    assert(sSave.continueGameWarp.x == x && sSave.continueGameWarp.y == y);
+}
+
+static void InGreenway(s16 x, s16 y)
+{
+    InOldCity(x,y);
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_GREENWAY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_GREENWAY);
+}
+
+
+static void AssertAfterCmp(s16 x, s16 y)
+{
+    unsigned i;
+    for (i = 0; i < COUNT(sGreenwayV6Cases); i++)
+        if (x == sGreenwayV6Cases[i][0] && y == sGreenwayV6Cases[i][1])
+        {
+            AssertGreenwayWarp(sGreenwayV6Cases[i][2],sGreenwayV6Cases[i][3]);
+            return;
+        }
+    AssertGreenwayWarp(x,y);
+}
+
+static bool8 IsNewGreenwayFloor(u8 x, u8 y)
+{
+    unsigned i;
+    for (i = 0; i < COUNT(sGreenwayNewWalkable); i++)
+        if (sGreenwayNewWalkable[i][0] == x && sGreenwayNewWalkable[i][1] == y)
+            return TRUE;
+    return FALSE;
+}
+
+static void AssertXitunWarp(s16 x, s16 y)
+{
+    assert(sHasContinueWarp && sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.mapGroup == MAP_GROUP(MAP_TAICHUNG_XITUN));
+    assert(sSave.continueGameWarp.mapNum == MAP_NUM(MAP_TAICHUNG_XITUN));
+    assert(sSave.continueGameWarp.x == x && sSave.continueGameWarp.y == y);
+}
+
+static void InXitun(s16 x, s16 y)
+{
+    InOldCity(x,y);
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_XITUN);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_XITUN);
+}
+
+static void TestXitunV4Migration(void)
+{
+    struct SaveBlock1 before;
+    unsigned version, i, x, count;
+    for (version = 1; version <= 3; version++)
+    {
+        for (i = 0; i < COUNT(sXitunV4Cases); i++)
+        {
+            Versioned(version); InXitun(sXitunV4Cases[i][0],sXitunV4Cases[i][1]); before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            AssertXitunWarp(sXitunV4Cases[i][2],sXitunV4Cases[i][3]);
+            assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+        }
+        count = 0;
+        for (i = 0; i < COUNT(sXitunSafeRuns); i++)
+            for (x = sXitunSafeRuns[i][1]; x <= sXitunSafeRuns[i][2]; x++)
+            {
+                Versioned(version); InXitun(x,sXitunSafeRuns[i][0]); before = sSave;
+                TaichungSaveUpgradeOnContinue();
+                AssertXitunWarp(x,sXitunSafeRuns[i][0]);
+                assert(sWarpRequests == 1); AssertSamePartyAndVars(&before); count++;
+            }
+        assert(count == 1516);
+        // An already scheduled native return is authoritative regardless of the source map.
+        for (i = 0; i < COUNT(sXitunV4Cases); i++)
+        {
+            Versioned(version); sHasContinueWarp = TRUE;
+            sSave.continueGameWarp.mapGroup = MAP_GROUP(MAP_TAICHUNG_XITUN);
+            sSave.continueGameWarp.mapNum = MAP_NUM(MAP_TAICHUNG_XITUN);
+            sSave.continueGameWarp.warpId = -1;
+            sSave.continueGameWarp.x = sXitunV4Cases[i][0]; sSave.continueGameWarp.y = sXitunV4Cases[i][1];
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            AssertXitunWarp(sXitunV4Cases[i][2],sXitunV4Cases[i][3]);
+            assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+        }
+        // Real native warp IDs resolve via authored doors, even if ignored x/y look blocked.
+        for (i = 0; i < 3; i++)
+        {
+            Versioned(version); InXitun(12,47); sHasContinueWarp = TRUE;
+            sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = i;
+            sSave.continueGameWarp.x = 5; sSave.continueGameWarp.y = 38;
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(sHasContinueWarp && sWarpRequests == 0);
+            assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+            AssertSamePartyAndVars(&before);
+        }
+        Versioned(version); InXitun(12,47); sHasContinueWarp = TRUE;
+        sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1;
+        sSave.continueGameWarp.x = 12; sSave.continueGameWarp.y = 47; before = sSave;
+        TaichungSaveUpgradeOnContinue(); AssertXitunWarp(12,47); assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+
+        Versioned(version); InXitun(12,47); sHasContinueWarp = TRUE; before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(sHasContinueWarp && sWarpRequests == 0 && memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        AssertSamePartyAndVars(&before);
+    }
+    // V3 already owns OldCity's authored map; do not replay the older 528-cell migration there.
+    for (i = 0; i < 5; i++)
+    {
+        static const u8 maps[] = {0,1,3,13};
+        Versioned(3);
+        if (i < COUNT(maps)) { InOldCity(30,66); sSave.location.mapNum = maps[i]; }
+        before = sSave; TaichungSaveUpgradeOnContinue();
+        if (before.location.mapGroup == MAP_GROUP(MAP_TAICHUNG_GREENWAY)
+            && before.location.mapNum == MAP_NUM(MAP_TAICHUNG_GREENWAY))
+        {
+            AssertGreenwayWarp(before.pos.x,before.pos.y);
+            assert(sWarpRequests == 1);
+        }
+        else
+        {
+            assert(!sHasContinueWarp && sWarpRequests == 0);
+            assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        }
+        AssertSamePartyAndVars(&before);
+    }
+    Versioned(3); InOldCity(2,2); sHasContinueWarp = TRUE;
+    sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1;
+    sSave.continueGameWarp.x = 2; sSave.continueGameWarp.y = 2; before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(sWarpRequests == 0 && memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+    AssertSamePartyAndVars(&before);
+    // Legacy prototype recognition/checkpoint behavior survives the added Xitun repair.
+    Reset(); V(0x40FC) = SPECIES_PIKACHU; InXitun(sXitunV4Cases[0][0],sXitunV4Cases[0][1]); before = sSave;
+    TaichungSaveUpgradeOnContinue(); AssertXitunWarp(sXitunV4Cases[0][2],sXitunV4Cases[0][3]);
+    assert(V(0x40F7) == 6 && TaichungSaveUsesStationCheckpoint()); AssertProtected(&before,TRUE);
+    // Current/future save versions do not schedule or repair a return.
+    for (version = 6; version <= 7; version++)
+    {
+        Versioned(version); InXitun(5,38); before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 0 && sVariableWrites == 0);
+    }
+    Versioned(3); InXitun(12,47); TaichungSaveUpgradeOnContinue(); assert(sWarpRequests == 1);
+    sHasContinueWarp = FALSE; before = sSave; TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 1 && !sHasContinueWarp);
+}
