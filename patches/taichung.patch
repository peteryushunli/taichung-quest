+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(pixels):
+    return min((tuple(pixels[(7-y if flags & 0x800 else y)*8 + (7-x if flags & 0x400 else x)]
+                      for y in range(8) for x in range(8)), flags) for flags in (0, 0x400, 0x800, 0xC00))
+
+
+def save_words(path, values, kind="H"):
+    path.write_bytes(struct.pack(f"<{len(values)}{kind}", *values))
+
+
+def crlf(raw):
+    return raw.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+
+
+def save_palette(path, colors):
+    raw = ("JASC-PAL\r\n0100\r\n16\r\n" + "\r\n".join(" ".join(map(str, color)) for color in colors) + "\r\n").encode()
+    path.write_bytes(raw)
+
+
+def same_source_bytes(a, b, path):
+    return a.splitlines() == b.splitlines() if path.endswith(".pal") else a == b
+
+
+class Packer:
+    def __init__(self, bank, protected, animated):
+        self.primary = bank.images[0].copy()
+        self.free = sorted(set(range(640)) - protected)
+        self.lookup, self.allocated, self.secondary = {}, [], []
+        for n in sorted(protected - animated):
+            pixels, flags = canonical(bank.graphic(n))
+            self.lookup.setdefault(pixels, (n, flags))
+
+    def pack(self, pixels):
+        pixels, flags = canonical(pixels)
+        if pixels not in self.lookup:
+            if len(self.allocated) < len(self.free):
+                n = self.free[len(self.allocated)]
+                self.allocated.append(n)
+                for y in range(8):
+                    for x in range(8):
+                        self.primary.putpixel((n % 16*8+x, n // 16*8+y), pixels[y*8+x])
+            else:
+                if len(self.secondary) >= 376:
+                    raise ValueError("CMP secondary graphics exceed the 376 static slots")
+                n = 640 + len(self.secondary)
+                self.secondary.append(pixels)
+            self.lookup[pixels] = n, 0
+        n, stored = self.lookup[pixels]
+        return n | (flags ^ stored)
