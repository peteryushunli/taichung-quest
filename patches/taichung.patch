@@ -0,0 +1,125 @@
+// The probe's test route. Usage: node run.mjs <out dir> <nav address> <stats address> [--plain]
+//   --plain  only boot and capture Old City (for the same frame from the unmodified ROM)
+import { writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { open } from './cdp.mjs';
+
+const [outDir, nav, stats, mode] = process.argv.slice(2);
+const qa = await open({ url: `http://127.0.0.1:${process.env.QA_PORT ?? 8831}/`, outDir, debugPort: Number(process.env.QA_DEBUG_PORT ?? 9337) });
+const log = []; let lastField = null;
+async function mark(name, extra = {}) {
+  const state = await qa.state();
+  if (state.field) lastField = state;
+  await qa.shot(name);
+  log.push({ name, state, at: state.field ? undefined : lastField, ...extra });
+  const s = state.stream;
+  console.log(name.padEnd(30), `${state.group}.${state.map}`.padEnd(7), String(state.x).padStart(3), String(state.y).padStart(3),
+    (s.active ? `tiles ${s.residentTiles} (peak ${s.peakTiles}) pals ${s.residentPals} (peak ${s.peakPals}) overflow ${s.overflowTiles}/${s.overflowPals} resets ${s.resets} loads ${s.tileLoads}` : 'not streamed')
+    + ` | step ${state.timing.lastSlice} whole ${state.timing.lastWhole} late ${state.timing.vblanks - state.timing.mainLoops}`);
+  writeFileSync(join(outDir, 'run.json'), JSON.stringify(log, null, 1));
+  return state;
+}
+async function boot() {
+  for (let i = 0; i < 60; i++) { await qa.sleep(700); if ((await qa.state()).field) break; await qa.press(i % 5 === 4 ? 'Start' : 'A', 80, 100); }
+  await qa.sleep(1500);
+}
+const walk = async (...args) => { const r = await qa.walk(...args); if (r.state.field) lastField = r.state; return r; };
+async function go(key, tiles, name, every = 0) {
+  let done = 0;
+  while (done < tiles) {
+    const step = every ? Math.min(every, tiles - done) : tiles - done;
+    const r = await walk(key, step);
+    done += step;
+    if (r.moved < step) { console.log(`  blocked going ${key}: ${r.moved} of ${step}`); await mark(`${name}-blocked`); return false; }
+    if (every || done === tiles) await mark(every ? `${name}-${String(done).padStart(2, '0')}` : name);
+  }
+  return true;
+}
+const MENU = [150, 0, 240, 152], TEXT = [0, 108, 240, 160], POPUP = [0, 0, 240, 40];
+
+await qa.load({ nav: Number(nav), stats: Number(stats) }, true);
+await boot();
+await mark('01-old-city');
+if (mode === '--plain') { qa.close(); process.exit(0); }
+
+// Old City -> probe map A (a warp from an ordinary map into a streamed one)
+await qa.walk('Down', 2); await qa.walk('Left', 4);
+await mark('01b-old-city-walked');
+await qa.walk('Left', 1);
+await qa.waitField(); await qa.sleep(700);
+await mark('02-arrive-name-popup', { window: POPUP });
+await qa.sleep(3500);
+await mark('03-arrived', { exact: true });
+
+// start menu over the streamed map, then a full-screen menu and back (the map is rebuilt from nothing)
+await qa.press('Start', 100, 700);
+await mark('04-start-menu', { window: MENU });
+await qa.press('Down', 80, 250); await qa.press('Down', 80, 250); await qa.press('A', 100, 2500);
+await mark('05-bag-open', { skip: true });
+await qa.press('B', 100, 2500); await qa.waitField(); await qa.sleep(600);
+await qa.press('B', 100, 600);
+await mark('06-back-from-bag', { exact: true });
+
+// a text box
+await walk('Right', 1);
+await qa.press('Up', 60, 300); await qa.press('A', 100, 1000);
+await mark('07-text-box', { window: TEXT });
+await qa.press('A', 100, 1000);
+await mark('08-text-box-next', { window: TEXT });
+await qa.press('A', 100, 800); await qa.press('B', 100, 500);
+
+// the door: animation frames are copied into fixed tile slots; then indoors and back out to Old City
+await walk('Right', 2); await walk('Up', 1);
+await mark('09-at-door');
+await qa.evaluate(`qa.down('Up')`);
+for (let i = 0; i < 22; i++) { await qa.sleep(30); await mark(`10-door-${String(i).padStart(2, '0')}`, { door: true }); }
+await qa.evaluate(`qa.up('Up')`);
+await qa.sleep(2500); await qa.waitField(); await qa.sleep(800);
+await mark('11-indoors');
+await qa.walk('Down', 1, { timeout: 3000 }); await qa.sleep(2500); await qa.waitField(); await qa.sleep(1200);
+await mark('12-old-city-from-indoors');
+// make for the trigger again from wherever the exit put us (the guest house door is at 20,67)
+let s = await qa.state();
+if (s.map === 0) { await qa.walk('Down', 70 - s.y); await qa.walk('Left', s.x - 15); }
+await qa.waitField(); await qa.sleep(3500);
+await mark('13-arrive-again', { exact: true });
+
+// on foot: north up the avenue beside City Hall, east along the boulevard into map B, south, then west through the plaza
+await go('Left', 2, '14-avenue');
+await go('Up', 22, '15-north', 6);
+await go('Right', 52, '16-boulevard', 6);
+await go('Down', 21, '17-south', 6);
+await go('Left', 18, '18-plaza', 6);
+await go('Down', 4, '19-plaza-centre');
+
+// save here, reset the cartridge and continue: the saved map view is restored on a streamed map
+await qa.press('Start', 100, 700);
+for (let i = 0; i < 3; i++) await qa.press('Down', 80, 250);
+await mark('20-menu-on-save', { window: MENU });
+await qa.press('A', 100, 1500);
+await mark('21-save-prompt', { window: [0, 0, 240, 160] });
+for (let i = 0; i < 8 && !(await qa.state()).field; i++) { await qa.press('A', 100, 1500); }
+await qa.sleep(1500);
+await mark('22-saved');
+const save = await qa.evaluate('qa.saveBase64()');
+if (save) writeFileSync(join(outDir, 'saved-on-probe-map-b.sav'), Buffer.from(save, 'base64'));
+await qa.evaluate('qa.reset()');
+await boot(); await qa.sleep(2500);
+await mark('23-continued', { exact: true });
+
+// by bike: back west along the plaza, across the seam, then the long southern street out and back
+await qa.press('Start', 100, 700); for (let i = 0; i < 3; i++) await qa.press('Down', 80, 250);   // the cursor starts at the top after a reset
+await mark('24-menu-on-bike', { window: MENU });
+await qa.press('A', 100, 1200);
+console.log('  cycling:', Boolean((await qa.state()).flags & 32));
+await go('Up', 4, '25-bike-up');
+await go('Left', 22, '26-bike-west', 8);
+await go('Down', 1, '27-bike-down');
+await go('Left', 12, '28-bike-west', 6);
+await go('Down', 18, '29-bike-south', 6);
+await go('Right', 46, '30-bike-east', 8);
+await go('Left', 46, '31-bike-back', 8);
+await go('Down', 14, '32-bike-south', 7);
+await qa.walk('Down', 1); await qa.sleep(2500); await qa.waitField(); await qa.sleep(1500);
+await mark('33-old-city-return');
+qa.close();
diff --git a/tools/taichung/tile_limit_probe/qa/serve.py b/tools/taichung/tile_limit_probe/qa/serve.py
