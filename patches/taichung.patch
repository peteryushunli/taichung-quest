diff --git a/data/taichung/landmarks/theater/encode_candidate.py b/data/taichung/landmarks/theater/encode_candidate.py
new file mode 100644
index 0000000..c291b75
--- /dev/null
+++ b/data/taichung/landmarks/theater/encode_candidate.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Deterministically encode the approved Theater study as an independent candidate.
+
+This performs asset-format conversion only: hard alpha, aspect-preserving nearest
+reduction, 15 opaque GBA colors, and flip-aware 4bpp packing. It does not register
+tiles, alter any native map or activate the painted entrance as a game warp.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ARTIFACT = PROJECT / 'artifacts/worktrees' / hashlib.sha256(str(GAME).encode()).hexdigest()[:12]
+
+
+def flip(pixels, horizontal=False, vertical=False):
+    return tuple(pixels[(7-y if vertical else y)*8+(7-x if horizontal else x)]
+                 for y in range(8) for x in range(8))
+
+
+def encode(source, output, review, threshold=224, pixel_step=2):
+    rgba = Image.open(source).convert('RGBA')
+    mask = rgba.getchannel('A').point(lambda value: 255 if value >= threshold else 0)
+    bbox = mask.getbbox()
+    if not bbox:
+        raise ValueError('The source has no foreground at this alpha threshold.')
+    # Preserve the approved architecture's aspect ratio, centered and aligned to
+    # the native envelope's south edge. Transparent north space remains walkable
+    # until the integrator assigns source layers and actual collision geometry.
+    crop = rgba.crop(bbox)
+    crop.putalpha(mask.crop(bbox))
+    if pixel_step not in (1,2,4):
+        raise ValueError('Pixel step must be1,2 or4 and divide the native envelope.')
+    working_size = (256//pixel_step,160//pixel_step)
+    scale = min(working_size[0]/crop.width, working_size[1]/crop.height)
+    size = (max(1, round(crop.width*scale)), max(1, round(crop.height*scale)))
+    resized = crop.resize(size, Image.Resampling.NEAREST)
+    offset = ((working_size[0]-size[0])//2, working_size[1]-size[1])
+    canvas = Image.new('RGBA', working_size)
+    canvas.paste(resized, offset)
+
+    raw_pixels = list(canvas.getdata())
+    opaque = [pixel[:3] for pixel in raw_pixels if pixel[3]]
+    strip = Image.new('RGB', (len(opaque),1))
+    strip.putdata(opaque)
+    quantized = strip.quantize(colors=15, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
+    source_palette = quantized.getpalette()
+    palette = []
+    for index in sorted(set(quantized.getdata())):
+        color = tuple(min(248, ((source_palette[index*3+c]+4)//8)*8) for c in range(3))
+        if color not in palette:
+            palette.append(color)
+    if len(palette)>15:
+        raise ValueError('Opaque palette exceeds 4bpp capacity.')
+    # Index zero is transparency. Opaque black, if chosen, receives its own index.
+    full_palette = [(0,0,0)] + palette + [(0,0,0)]*(15-len(palette))
+    indices = []
+    for r,g,b,a in raw_pixels:
+        if not a:
+            indices.append(0)
+        else:
+            indices.append(1+min(range(len(palette)), key=lambda i:
+                (r-palette[i][0])**2+(g-palette[i][1])**2+(b-palette[i][2])**2))
+    indexed = Image.new('P', working_size)
+    indexed.putpalette([v for color in full_palette for v in color] + [0]*(768-48))
+    indexed.putdata(indices)
+    indexed.info['transparency'] = 0
+    if pixel_step != 1:
+        # A deliberately coarser, uniform native-pixel cluster size reduces tile
+        # cost while retaining the approved silhouette and full map footprint.
+        indexed = indexed.resize((256,160),Image.Resampling.NEAREST)
+        indexed.info['transparency'] = 0
+        indices = list(indexed.getdata())
+
+    graphics = []
+    lookup = {}
+    tile_entries = []
+    for ty in range(20):
+        for tx in range(32):
+            pixels = tuple(indices[(ty*8+y)*256+tx*8+x] for y in range(8) for x in range(8))
+            options = [(pixels,0),(flip(pixels,True),0x400),(flip(pixels,False,True),0x800),(flip(pixels,True,True),0xc00)]
+            canonical, flags = min(options, key=lambda item:(item[0],item[1]))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tile_entries.append(lookup[canonical] | flags | (7<<12))
+    # Explicit relative entries: integrator chooses final secondary graphic base.
+    relative_metatiles = []
+    for my in range(10):
+        for mx in range(16):
+            relative_metatiles.append([tile_entries[(my*2+y)*32+mx*2+x]
+                                       for y in range(2) for x in range(2)])
+
+    # Meaningful format round-trip against the indexed target, including flips.
+    decoded = []
+    for y in range(160):
+        for x in range(256):
+            entry = tile_entries[(y//8)*32+x//8]
+            local_x, local_y = x%8, y%8
+            if entry&0x400: local_x=7-local_x
+            if entry&0x800: local_y=7-local_y
+            decoded.append(graphics[entry&0x3ff][local_y*8+local_x])
+    if decoded != indices:
+        raise ValueError('Flip-aware native tilemap did not round-trip.')
+    if len(graphics)>384:
+        raise ValueError(f'Candidate alone exceeds secondary capacity: {len(graphics)}.')
+
+    output.mkdir(parents=True, exist_ok=True)
+    indexed.save(output/'candidate-indexed.png')
+    native = indexed.convert('RGBA')
+    native.save(output/'candidate-native.png')
+    review.parent.mkdir(parents=True, exist_ok=True)
+    native.resize((1024,640), Image.Resampling.NEAREST).save(review)
+    sheet = Image.new('P', (128, ((len(graphics)+15)//16)*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info['transparency'] = 0
+    for n,pixels in enumerate(graphics):
+        for y in range(8):
+            for x in range(8): sheet.putpixel((n%16*8+x,n//16*8+y),pixels[y*8+x])
+    sheet.save(output/'tiles.png')
+    (output/'tiles.4bpp').write_bytes(bytes(pixels[i]|pixels[i+1]<<4
+                                           for pixels in graphics for i in range(0,64,2)))
+    (output/'foreground-tilemap-relative.bin').write_bytes(struct.pack('<640H',*tile_entries))
+    (output/'foreground-metatiles-relative.json').write_text(json.dumps(relative_metatiles,indent=2)+'\n')
+    palette_text = 'JASC-PAL\n0100\n16\n'+'\n'.join(' '.join(map(str,color)) for color in full_palette)+'\n'
+    (output/'07.pal').write_bytes(palette_text.replace('\n','\r\n').encode())
+    (output/'07.gbapal').write_bytes(struct.pack('<16H',*(r//8|(g//8)<<5|(b//8)<<10 for r,g,b in full_palette)))
+    metadata = {
+        'schemaVersion':1,'landmarkId':'taichung-theater','status':'independent native-encoded candidate; not registered in ROM',
+        'sourceArtifact':str(source),'sourceSha256':hashlib.sha256(source.read_bytes()).hexdigest(),
+        'recipe':{'alphaThreshold':threshold,'sourceCropBox':list(bbox),'preserveAspectRatio':True,'resampling':'nearest',
+                  'quantization':'MEDIANCUT over opaque pixels only; no dithering','gbaColorRounding':'nearest multiple of8 clamped248',
+                  'logicalSize':[256,160],'workingResolution':list(working_size),'nativePixelClusterSize':pixel_step,
+                  'fittedSubjectSize':[v*pixel_step for v in size],'subjectOffset':[v*pixel_step for v in offset],'paletteBankCandidate':7,
+                  'opaqueColors':len(palette),'PillowVersion':PIL.__version__},
+        'native':{'unique8x8GraphicsFlipDeduplicated':len(graphics),'secondaryCapacity':384,'slotsRemainingBeforeOtherAssets':384-len(graphics),
+                  'foregroundMetatileCells':160,'paletteEntries':16,'binaryAlpha':True,'tilemapRoundTripPass':True,
+                  'tilemapGraphicIndices':'relative to this candidate bank, not global640-based registration IDs',
+                  'tilemapDimensions8x8':[32,20],'paintedDoorLocalMetatile':[8,9],'paintedDoorRequiresNativeBinding':True},
+        'integration':{'registeredInRom':False,'sharedPaletteAssigned':False,'geometryReviewed':False,'nativeReady':False,
+                       'rootMustAssignGraphicOffsetAndMergeSharedKit':True,'baselineDoor':[12,44],'baselineArrival':[12,47]},
+        'reviewArtifact':str(review),'nativePngSha256':hashlib.sha256((output/'candidate-native.png').read_bytes()).hexdigest()
+    }
+    (output/'encode-manifest.json').write_text(json.dumps(metadata,indent=2)+'\n')
+    return metadata
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ARTIFACT/'landmark-art/theater-study-v1.png')
+    parser.add_argument('--output', type=Path, default=HERE/'candidate')
+    parser.add_argument('--review', type=Path, default=ARTIFACT/'landmark-art/theater-native-candidate-v1.png')
+    parser.add_argument('--alpha-threshold', type=int, default=224)
+    parser.add_argument('--pixel-step', type=int, default=2)
+    args=parser.parse_args()
+    result=encode(args.source,args.output,args.review,args.alpha_threshold,args.pixel_step)
+    print(json.dumps({'native':result['native'],'recipe':result['recipe'],'reviewArtifact':result['reviewArtifact']},indent=2))
