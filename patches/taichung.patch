+#!/usr/bin/env python3
+"""Validate the ten installed leader parties against native Gen III learn data."""
+from pathlib import Path
+import re,json,subprocess
+ROOT=Path(__file__).resolve().parents[2]
+def read(p):return (ROOT/p).read_text()
+def entries(text):
+ m=list(re.finditer(r'\[(SPECIES_\w+)\]\s*=',text));return {x[1]:text[x.end():m[i+1].start() if i+1<len(m)else len(text)]for i,x in enumerate(m)}
+expected={'StationJun':['RATICATE','PIDGEOT','PERSIAN'],'ParkLian':['SEAKING','GOLDUCK','PIDGEOT'],'MiyaharaPeiqi':['DEWGONG','CLOYSTER','LAPRAS'],'ScienceYicheng':['MAGNETON','AERODACTYL','OMASTAR'],'GreenwayXingan':['VICTREEBEL','VILEPLUME','TANGELA'],'ConfuciusWenyi':['SLOWBRO','EXEGGUTOR','ALAKAZAM'],'FineArtsCaining':['BUTTERFREE','MUK','CLEFABLE'],'FengjiaJiahe':['FARFETCHD','MAGMAR','SNORLAX'],'MapleGardenMuqing':['POLIWRATH','BUTTERFREE','VAPOREON'],'TheaterLing':['WIGGLYTUFF','JYNX','MR_MIME']}
+ids={n:int(v)for n,v in re.findall(r'^#define (SPECIES_\w+) (\d+)$',read('include/constants/species.h'),re.M)}
+pointers=dict(re.findall(r'\[(SPECIES_\w+)\] = (s\w+LevelUpLearnset)',read('src/data/pokemon/level_up_learnset_pointers.h')))
+levels={n:{move for lvl,move in re.findall(r'LEVEL_UP_MOVE\((\d+), (MOVE_\w+)\)',body)if int(lvl)<=50}for n,body in re.findall(r'static const u16 (s\w+LevelUpLearnset)\[\] = \{(.*?)\};',read('src/data/pokemon/level_up_learnsets.h'),re.S)}
+parents={}
+for parent,body in entries(read('src/data/pokemon/evolution.h')).items():
+ for child in re.findall(r'\{EVO_\w+,\s*\w+,\s*(SPECIES_\w+)\}',body):parents.setdefault(child,set()).add(parent)
+def inherited(n,seen=None):
+ seen=set()if seen is None else seen
+ if n in seen:return set()
+ seen.add(n);return levels[pointers[n]]|set().union(*(inherited(p,seen)for p in parents.get(n,[])))
+tm={n:{'MOVE_'+v for v in re.findall(r'TMHM\((?:TM|HM)\d+_(\w+)\)',body)}for n,body in entries(read('src/data/pokemon/tmhm_learnsets.h')).items()}
+tutor={n:set(re.findall(r'TUTOR\((MOVE_\w+)\)',body))for n,body in entries(read('src/data/pokemon/tutor_learnsets.h')).items()}
+source=read('src/data/trainer_parties.h');trainers=read('src/data/trainers.h');proof={}
+pattern=r'static const struct (TrainerMon\w+) sParty_Taichung(\w+)\[\] = \{(.*?)\n\};'
+parties={name:(typ,body)for typ,name,body in re.findall(pattern,source,re.S)}
+for name,roster in expected.items():
+ typ,body=parties[name];assert typ=='TrainerMonNoItemCustomMoves';mons=re.findall(r'\.lvl = (\w+), \.species = (SPECIES_\w+),\s*\.moves = \{([^}]+)\}',body)
+ assert len(mons)==3 and [s[8:]for _,s,_ in mons]==roster,(name,mons)
+ proof[name]=[]
+ for lvl,species,slots in mons:
+  assert lvl=='TAICHUNG_TEAM_LEVEL'and 1<=ids[species]<=150;assert '#define TAICHUNG_TEAM_LEVEL 50' in read('include/taichung_team_presets.h')
+  moves=re.findall(r'MOVE_\w+',slots);assert len(moves)==len(set(moves))==4
+  legal=inherited(species)|tm.get(species,set())|tutor.get(species,set());assert set(moves)<=legal,(name,species,set(moves)-legal)
+  proof[name].append({'species':species[8:],'level':50,'moves':moves,'legalSources':{move:'level or ancestor <=50'if move in inherited(species)else'TM/HM'if move in tm[species]else'native tutor'for move in moves}})
+ assert 'NO_ITEM_CUSTOM_MOVES(sParty_Taichung'+name+')'in trainers
+old=subprocess.check_output(['git','show','f7e7d04d03f22872dad17fbd6bff88d5e1dd4897:src/data/trainer_parties.h'],cwd=ROOT,text=True)
+oldpart={name:(typ,body)for typ,name,body in re.findall(pattern,old,re.S)}
+for name,value in oldpart.items():
+ if name not in expected:assert parties[name]==value,name
+out=ROOT/'build/taichung-tests/gym-rosters.json';out.parent.mkdir(parents=True,exist_ok=True);out.write_text(json.dumps(proof,indent=2)+'\n')
+print('PASS: ten original-150 parties, each3Lv50/no items/four legal moves (native inherited level<=50, TM/HM or tutor); retired ShenJi and every generic trainer unchanged.');print(out)
