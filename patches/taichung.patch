@@ -0,0 +1,1076 @@
+#!/usr/bin/env python3
+"""Build Greenway, Old City and Old City North natively from the approved phase-2a drafts.
+
+Phase 2b of the city rework. The drafts (`oldcity_greenway_draft.py`) give every cell of the
+cell-exact master plan a class; this resolves each class to a real map word and installs the
+new landmarks' tiles, starting from the city kit (`--base`):
+
+- streets, the highway, bridges and water are kit pieces (`data/taichung/city-kit/kit.json`).
+  Water banks follow from the water's shape, and each body takes its own flow;
+- lots are packed by the draft (plan_lots): the city-v3 townhouse and teal duplex, their rows cut
+  or stretched to the block's depth; the FireRed house, bay by bay, where Greenway draws the lots
+  (it carries it, and Old City North now does too); kiosks and stalls where Wanhe draws them;
+- kept landmarks, park content, signs and doors keep their live words;
+- landmark 13 goes into GreenwayCmp, 16 into OldCore, and 14, 15 and 17 into Old City North's
+  new secondary, which also carries OldCore's city-v3 styles and FireRed house at the same IDs.
+
+Old City keeps today's rows (shift 0,0) and grows east and south for the river; Greenway's
+live content moves down 37 rows; Old City North is new. The highway's retaining wall, its
+culvert over Green River, kerb bollards and waterside railings (with an inner corner where a
+canal ends in open water at a crossing walk) are the kit's own pieces; paving with an edge the
+kit has no single piece for (pavers with a railing, a kerb by the river) is a definition at the
+same ID in OldCore and Old City North, so it draws the same in either's strip.
+
+Base files come from git, so every run writes the same bytes. `--check` builds in memory and
+compares with the working tree.
+
+  python3 tools/taichung/rework/build_rework.py [--check] [--base REF]
+
+Requires Pillow, NumPy and git.
+"""
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import io
+import json
+import random
+import struct
+import subprocess
+import sys
+import tarfile
+import tempfile
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "tools/taichung"))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import render_maps as native  # noqa: E402
+import landmark_redraw as lr  # noqa: E402
+import landmark_tiles  # noqa: E402
+import oldcity_greenway_draft as draft  # noqa: E402
+
+BASE = "b00a9651c77f7f381c789012e78f07a920ba0686"
+PLAN = "data/taichung/city-rework/masterplan.json"
+KIT = "data/taichung/city-kit/kit.json"
+BASE_PATHS = ["src/data/tilesets", "src/graphics.c",
+              "data/tilesets/primary/taichung_old_core", "data/tilesets/primary/taichung_greenway_private",
+              "data/tilesets/secondary/taichung_old_core", "data/tilesets/secondary/taichung_greenway_cmp",
+              "data/layouts/TaichungGreenway", "data/layouts/TaichungOldCity", "data/layouts/layouts.json"]
+
+WALK, SOLID, WET = 0x3000, 0x0400, 0x1400
+COVERED = 1 << 29
+NUM_PRIMARY = 640
+SLOTS = 376          # secondary tile slots below field_door.c's door scratch (0x3F8-0x3FF)
+DEFS = 384           # secondary metatile definitions
+CITY_V3 = range(939, 1011)
+
+# Building styles, as placed in today's Old City (data/taichung/oldcity-buildings/placements.json),
+# and checked against the base map. The FireRed house is the one Greenway carries at Old City's
+# IDs today, cut to 5x5: roof, eaves, sign band, one storey, the door storey.
+TOWNHOUSE = ((0x3B0, 0x3B1, 0x3B2, 0x3B3), (0x3BA, 0x3BB, 0x3BC, 0x3BD), (0x3C4, 0x3C5, 0x3C6, 0x3C7),
+             (0x3CE, 0x3CF, 0x3D0, 0x3D1), (0x3D8, 0x3D9, 0x3DA, 0x3DB))
+TEAL_PAIR = ((0x3AB, 0x3AC, 0x3AD, 0x3AE, 0x3AC, 0x3AF), (0x3B4, 0x3B5, 0x3B6, 0x3B7, 0x3B8, 0x3B9),
+             (0x3BE, 0x3BF, 0x3C0, 0x3C1, 0x3C2, 0x3C3), (0x3C8, 0x3C9, 0x3CA, 0x3CB, 0x3CC, 0x3CD),
+             (0x3D2, 0x3D3, 0x3D4, 0x3D5, 0x3D6, 0x3D7))
