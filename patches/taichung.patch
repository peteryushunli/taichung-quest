@@ -0,0 +1,319 @@
+// Browser-side controller and position reader for the pinned cartridge.
+export async function installTravelEmulator({ metadata, fixture, speed, start, mode, graph, actions }) {
+  const { default: createEmulator } = await import('/emulator/mgba.js');
+  const canvas = document.createElement('canvas');
+  canvas.width = 240;
+  canvas.height = 160;
+  canvas.style.cssText = 'width:240px;height:160px;display:block;image-rendering:pixelated';
+  document.body.replaceChildren(canvas);
+  document.documentElement.style.cssText = 'margin:0;background:#171819';
+  document.body.style.margin = '0';
+  const createContext = canvas.getContext.bind(canvas);
+  canvas.getContext = (type, attributes) => createContext(type, /webgl/.test(type)
+    ? { ...attributes, preserveDrawingBuffer: true } : attributes);
+  const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));
+  const emulator = await createEmulator({ canvas });
+  await emulator.FSInit();
+  emulator.setCoreSettings({
+    autoSaveStateEnable: false, restoreAutoSaveStateOnLoad: false,
+    rewindEnable: false, allowOpposingDirections: false,
+  });
+
+  const response = await fetch('/roms/taichung-firered.gba', { cache: 'no-store' });
+  if (!response.ok) throw new Error('The local ROM failed to load');
+  const rom = new Uint8Array(await response.arrayBuffer());
+  const digest = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', rom)),
+    byte => byte.toString(16).padStart(2, '0')).join('');
+  if (digest !== metadata.sha256) throw new Error('The loaded cartridge differs from the tested build');
+  const files = emulator.filePaths();
+  const name = '/travel-' + crypto.randomUUID();
+  const romPath = files.gamePath + name + '.gba';
+  const savPath = files.savePath + name + '.sav';
+  emulator.FS.writeFile(romPath, rom);
+  emulator.FS.writeFile(savPath, Uint8Array.from(atob(fixture), ch => ch.charCodeAt(0)));
+
+  const { address, magicA, magicB } = metadata.navigationBridge;
+  let memory;
+  let words;
+  let base;
+  function position() {
+    const heap = emulator.getTaichungHeapU8();
+    if (!memory || heap.buffer !== memory.buffer) {
+      memory = new DataView(heap.buffer);
+      words = new Uint32Array(heap.buffer);
+      base = undefined;
+    }
+    if (base === undefined) {
+      for (let i = 0; i + 13 <= words.length; i++) {
+        if (words[i] === magicA && words[i + 1] === magicB && words[i + 3] === address) {
+          base = i * 4;
+          break;
+        }
+      }
+      if (base === undefined) return;
+    }
+    const sequence = Atomics.load(words, (base + 16) / 4);
+    if (!sequence || sequence & 1) return;
+    const flags = memory.getUint32(base + 24, true);
+    const context = memory.getUint16(base + 40, true);
+    const result = {
+      frame: memory.getUint32(base + 20, true),
+      flags, context, field: (flags & 7) === 7 && context === 0,
+      x: memory.getInt16(base + 28, true), y: memory.getInt16(base + 30, true),
+      group: memory.getUint8(base + 32), map: memory.getUint8(base + 33), facing: memory.getUint8(base + 34),
+    };
+    if (Atomics.load(words, (base + 16) / 4) === sequence) return result;
+  }
+
+  let held;
+  let releaseAt = Infinity;
+  let ticks = 0;
+  function hold(key) {
+    if (held === key) return;
+    if (held) emulator.buttonUnpress(held);
+    if (key) emulator.buttonPress(key);
+    held = key;
+  }
+  function pace(multiplier) {
+    emulator.setFastForwardMultiplier(multiplier);
+    emulator.setMainLoopTiming(0, multiplier === 1 ? 16 : 1);
+  }
+  async function frames(duration) {
+    const end = ticks + duration;
+    const deadline = performance.now() + 20000;
+    while (ticks < end) {
+      if (performance.now() > deadline) throw new Error('The emulator stopped delivering frames');
+      await wait(8);
+    }
+  }
+  async function press(key, duration, rest) {
+    hold(key);
+    releaseAt = ticks + duration;
+    await frames(duration + rest);
+  }
+
+  const keys = ['Right', 'Down', 'Left', 'Up'];
+  const points = graph.points;
+  const neighbors = graph.neighbors;
+  const signWalls = new Set(graph.signWalls);
+  const wallBase = points.length * 4;
+  const pointIndex = new Map(points.map((point, i) => [point.join(','), i]));
+  const visited = new Set();
+  const passed = [];
+  const fails = [];
+  const shots = [];
+  const stalled = new Set();
+  const closedSigns = [];
+  const seen = new Uint32Array(points.length);
+  const parents = new Int32Array(points.length);
+  const queue = new Int32Array(points.length);
+  let generation = 0;
+  let current = -1;
+  let cursor = 0;
+  let route = [];
+  let pending;
+  let hiddenSince;
+  let latest;
+  let measuredFrames = 0;
+  let recovered = 0;
+  let turns = 0;
+  let previousKey;
+  let done = 'booting';
+
+  function finish(status) {
+    hold(undefined);
+    done = status;
+  }
+  function issue(name, state) {
+    const src = pending ? pending.edge >> 2 : current;
+    const to = pending && !pending.wall ? neighbors[src][pending.edge & 3] : -1;
+    fails.push({
+      name, action: pending?.action ?? actions[cursor], cursor,
+      blockedProbe: !!pending?.wall, required: !!pending?.required,
+      from: points[src], to: points[to], direction: pending ? keys[pending.edge & 3] : undefined, state,
+      heldFrames: pending ? ticks - pending.started : undefined,
+    });
+    if (shots.length < 9) shots.push({ cursor, png: canvas.toDataURL('image/png').split(',')[1] });
+  }
+  function routeTo(target) {
+    generation++;
+    queue[0] = current;
+    seen[current] = generation;
+    let end = 1;
+    for (let i = 0; i < end; i++) {
+      const from = queue[i];
+      if (from === target) {
+        const path = [];
+        for (let at = target; at !== current;) {
+          const edge = parents[at];
+          path.push(edge);
+          at = edge >> 2;
+        }
+        return path.reverse();
+      }
+      for (let d = 0; d < 4; d++) {
+        const to = neighbors[from][d];
+        const edge = from * 4 + d;
+        if (to < 0 || seen[to] === generation || stalled.has(edge)) continue;
+        parents[to] = edge;
+        seen[to] = generation;
+        queue[end++] = to;
+      }
+    }
+    return [];
+  }
+
+  function nextAction() {
+    if (cursor === actions.length) {
+      finish('complete');
+      return;
+    }
+    const action = actions[cursor];
+    const wall = action >= wallBase;
+    const wanted = wall ? action - wallBase : action;
+    const required = current === (wanted >> 2);
+    if (!required && !route.length) route = routeTo(wanted >> 2);
+    if (!required && !route.length) {
+      issue('no-recovery-route', latest);
+      finish('interrupted');
+      return;
+    }
+    const edge = required ? wanted : route.shift();
+    if (required) route = [];
+    pending = { action: required ? action : edge, edge, wall: required && wall, required, started: ticks };
+    const key = keys[edge & 3];
+    if (previousKey && previousKey !== key) turns++;
+    previousKey = key;
+    hold(key);
+  }
+
+  function track() {
+    const state = position();
+    if (!state) return;
+    latest = state;
+    if (!state.field) {
+      hiddenSince ??= ticks;
+      const sign = pending?.wall && signWalls.has(pending.edge) && !!(state.context & (16 | 32));
+      if (sign) {
+        if (!pending.sign) {
+          hold(undefined);
+          pending.sign = true;
+          pending.dismissAt = ticks + 45;
+        } else if (ticks >= pending.dismissAt) {
+          hold('B');
+          releaseAt = ticks + 5;
+          pending.dismissAt = ticks + 55;
+        }
+      } else {
+        hold(undefined);
+      }
+      if (ticks - hiddenSince > (sign ? 1800 : 160)) {
+        issue('field-interrupted', state);
+        finish('interrupted');
+      }
+      return;
+    }
+    const wasHidden = hiddenSince !== undefined;
+    hiddenSince = undefined;
+    if (wasHidden && pending?.sign) {
+      hold(undefined);
+      releaseAt = Infinity;
+    }
+    if (!!(state.flags & 32) !== (mode === 'bike')) {
+      issue('travel-mode-changed', state);
+      finish('interrupted');
+      return;
+    }
+    const cell = state.group === 43 ? pointIndex.get([state.map, state.x, state.y].join(',')) : undefined;
+    if (cell === undefined) {
+      issue('left-travel-grid', state);
+      finish('interrupted');
+      return;
+    }
+    if (current < 0) {
+      current = cell;
+      visited.add(cell);
+    }
+    if (pending && current !== cell) {
+      const expected = !pending.wall && neighbors[current][pending.edge & 3] === cell;
+      if (expected && pending.required) {
+        passed.push(pending.action);
+      } else if (expected) {
+        recovered++;
+      } else {
+        issue(pending.wall ? 'crossed-expected-solid-side' : 'unexpected-arrival', state);
+        route = [];
+      }
+      if (pending.required) cursor++;
+      pending = undefined;
+      current = cell;
+      visited.add(cell);
+    } else if (pending) {
+      if (wasHidden && !pending.sign) hold(keys[pending.edge & 3]);
+      const time = ticks - pending.started;
+      if (pending.wall && time >= (mode === 'bike' ? 22 : 40)) {
+        if (pending.sign) closedSigns.push(pending.action);
+        passed.push(pending.action);
+        cursor++;
+        pending = undefined;
+      } else if (!pending.wall && time >= 84) {
+        issue('held-direction-without-moving', state);
+        stalled.add(pending.edge);
+        if (pending.required) cursor++;
+        route = [];
+        pending = undefined;
+        hold(undefined);
+        return;
+      }
+    }
+    if (!pending) nextAction();
+  }
+
+  if (!emulator.loadGame(romPath, savPath)) throw new Error('The emulator could not open the cartridge');
+  emulator.toggleInput(false);
+  emulator.setVolume(0);
+  emulator.addCoreCallbacks({ videoFrameEndedCallback: () => {
+    ticks++;
+    if (ticks >= releaseAt) {
+      hold(undefined);
+      releaseAt = Infinity;
+    }
+    if (done !== 'running') return;
+    measuredFrames++;
+    try {
+      track();
+    } catch (error) {
+      fails.push({ name: 'controller-driver-error', message: String(error), cursor, state: latest });
+      finish('interrupted');
+    }
+  } });
+  pace(Math.min(speed, 8));
+
+  window.qa = {
+    frame: () => canvas.toDataURL('image/png'),
+    state: position,
+    press,
+    pace,
+    async boot() {
+      await frames(60);
+      for (let i = 0; i < 50 && !position()?.field; i++) {
+        await press(i % 6 === 5 ? 'Start' : 'A', 7, 27);
+      }
+      const loaded = position();
+      if (!loaded?.field || [loaded.map, loaded.x, loaded.y].join(',') !== start.join(',')) {
+        throw new Error('Preview save did not reach expected location ' + start + '; got ' + JSON.stringify(loaded));
+      }
+      if (!!(loaded.flags & 32) !== (mode === 'bike')) await press('B', 8, 85);
+      const ready = position();
+      if (!!(ready?.flags & 32) !== (mode === 'bike')) throw new Error('Could not select travel mode ' + mode);
+      return ready;
+    },
+    start() { pace(speed); done = 'running'; },
+    stop() { finish('interrupted'); },
+    progress() { return { done, cursor, measuredFrames, visited: visited.size, failures: fails.length, latest }; },
+    result() {
+      return { done, cursor, measuredFrames, turns, recovered, visited: [...visited], passed, closedSigns, fails, latest, shots };
+    },
+  };
+  window.qaReady = true;
+}
