+#!/usr/bin/env python3
+"""Measure frozen Greenway graphics/IDs and exact connected-border requirements.
+
+Read-only source analysis. The optional output file is the only write. No art-fit,
+runtime, save-compatibility, or installation claim follows from these counts.
+"""
+from __future__ import annotations
+
+import argparse
+from itertools import combinations
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "76832f0"
+PRIMARY = "data/tilesets/primary/taichung_old_core"
+CORE = "data/tilesets/secondary/taichung_old_core"
+THEATER = "data/tilesets/secondary/taichung_xitun"
+GREENWAY = "MAP_TAICHUNG_GREENWAY"
+NAMES = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+FUTURE = ("natural-science-museum", "shen-ji-new-village", "fine-arts-museum")
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def ranges(values):
+    result = []
+    for n in sorted(values):
+        if result and result[-1][1] == n - 1:
+            result[-1][1] = n
+        else:
+            result.append([n, n])
+    return result
+
+
+def analyze(source, revision):
+    support = load("greenway_readonly_bank", ROOT / "tools/taichung/landmarks/check_old_core.py")
+    strips = load("greenway_readonly_strips", ROOT / "tools/taichung/landmarks/analyze_theater_cohort.py")
+    commit = subprocess.check_output(["git", "rev-parse", f"{revision}^{{commit}}"], cwd=source, text=True).strip()
+    files = support.Files(source, commit)
+    bank = support.Bank(files, PRIMARY, CORE)
+    theater = support.Bank(files, PRIMARY, THEATER)
+    animation = set(files.json("data/taichung/landmarks/old-core-bank-audit.json")["generalAnimation"]["fixedGraphicIds"])
+    assert len(animation) == 70
+
+    def usage(words):
+        ids = {word & 1023 for word in words}
+        graphics = {entry & 1023 for n in ids for entry in bank.entries(n)}
+        palettes = {entry >> 12 for n in ids for entry in bank.entries(n)}
+        primary = {n for n in graphics if n < 640}
+        secondary = graphics - primary
+        return {
+            "metatileCount": len(ids), "metatileIds": sorted(ids),
+            "primaryMetatileCount": sum(n < 640 for n in ids),
+            "secondaryMetatileIds": sorted(n for n in ids if n >= 640),
+            "rawPrimaryGraphicCount": len(primary), "rawPrimaryGraphicIds": sorted(primary),
+            "rawSecondaryGraphicCount": len(secondary), "rawSecondaryGraphicIds": sorted(secondary),
+            "referencedAnimatedPrimaryGraphicIds": sorted(primary & animation),
+            "flipCanonicalInitialFramePatternCount": len({strips.canonical(bank.graphic(n)) for n in graphics}),
+            "paletteBanks": sorted(palettes),
+        }
+
+    layouts = {item["id"]: item for item in files.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    scenes = {}
+    for name in NAMES:
+        data = files.json(f"data/maps/{name}/map.json")
+        layout = layouts[data["layout"]]
+        assert layout["primary_tileset"] == "gTileset_TaichungOldCorePrimary"
+        scenes[data["id"]] = {"name": name, "map": data, "layout": layout,
+                               "words": files.words(layout["blockdata_filepath"]),
+                               "border": files.words(layout["border_filepath"])}
+    greenway = scenes[GREENWAY]
+    own = greenway["words"] + greenway["border"]
+    incoming, outgoing, all_required = [], [], list(own)
+    all_strip_cells = 0
+    for mid, view in scenes.items():
+        for connection in view["map"]["connections"]:
+            donor_id = connection["map"]
+            donor = scenes[donor_id]
+            points = list(strips.visible_cells(view["layout"], donor["layout"], connection["direction"], connection["offset"]))
+            words = [donor["words"][y * donor["layout"]["width"] + x] for x, y in points]
+            viewer_bank = theater if mid == "MAP_TAICHUNG_XITUN" else bank
+            donor_bank = theater if donor_id == "MAP_TAICHUNG_XITUN" else bank
+            ids = {word & 1023 for word in words}
+            equal = all(viewer_bank.render(n) == donor_bank.render(n) and viewer_bank.attr(n) == donor_bank.attr(n) for n in ids)
+            assert equal, f"Released seam mismatch: {mid} <- {donor_id}"
+            record = {"viewer": mid, "donor": donor_id, "direction": connection["direction"],
+                      "offset": connection["offset"], "donorBoundsInclusive": strips.bounds(points),
+                      "copiedCells": len(points), "releasedRenderAndAttributesEqual": equal, "usage": usage(words)}
+            all_strip_cells += len(points)
+            if mid == GREENWAY:
+                incoming.append(record)
+                all_required.extend(words)
+            if donor_id == GREENWAY:
+                outgoing.append(record)
+
+    contract = files.json("docs/taichung-city-contract.json")
+    landmarks = {item["id"]: item for item in contract["landmarks"] if item["id"] in FUTURE}
+    assert set(landmarks) == set(FUTURE)
+    stages = []
+    for count in range(4):
+        for cleared in combinations(FUTURE, count):
+            words = greenway["words"][:]
+            for name in cleared:
+                x1, y1, x2, y2 = landmarks[name]["footprint"]
+                for y in range(y1, y2 + 1):
+                    for x in range(x1, x2 + 1):
+                        words[y * greenway["layout"]["width"] + x] = 0x3175
+            required = words + greenway["border"]
+            for record in incoming:
+                donor = scenes[record["donor"]]
+                x1, y1, x2, y2 = record["donorBoundsInclusive"]
+                required.extend(donor["words"][y * donor["layout"]["width"] + x]
+                                for y in range(y1, y2 + 1) for x in range(x1, x2 + 1))
+            stage = usage(required)
+            stages.append({"analyticallyClearedPlaceholderIds": list(cleared),
+                           "pavingWord": "0x3175", "remainingPalette7Free": 7 not in stage["paletteBanks"],
+                           "remainingPalette9Free": 9 not in stage["paletteBanks"], "usage": stage})
+
+    total = usage(all_required)
+    essential = set(total["rawSecondaryGraphicIds"])
+    reserved_source = set(range(640, 719))
+    reserved_colors = set(range(815, 847))
+    private = set(range(640, 1024)) - reserved_source - reserved_colors
+    static_primary = set(range(640)) - animation
+    primary_patterns = {strips.canonical(bank.graphic(n)) for n in static_primary}
+    original_general = "data/tilesets/primary/general"
+    original = support.Bank(files, original_general, "data/tilesets/secondary/pewter_city")
+    core_manifest = files.json("data/taichung/landmarks/old-core-native/manifest.json")
+    transition = re.search(r"void LoadMapFromCameraTransition\([^)]*\)\s*\{(.*?)\n\}", files.text("src/overworld.c"), re.S).group(1)
+    primary_unchanged_required = all(bank.graphic(n) == original.graphic(n) for n in animation)
+    assert primary_unchanged_required
+    assert essential == set(), "Unexpected required secondary graphics: update plan"
+    assert len(private) == 273
+    assert all(7 not in row["usage"]["paletteBanks"] for row in incoming)
+    report = {
+        "schemaVersion": 1, "baselineCommit": commit,
+        "scope": "Read-only frozen source counts; no source installation, runtime, save, or future-art fit claim.",
+        "recommendation": "Keep released OldCore primary byte-identical across all districts. Give Greenway a private secondary preserving required source/color metatile IDs, with new art packed into its currently unreferenced secondary graphic pool.",
+        "engine": {"samePrimaryRequired": True,
+                   "cameraTransitionCopiesSecondary": "CopySecondaryTilesetToVramUsingHeap" in transition,
+                   "cameraTransitionCopiesPrimary": "CopyPrimaryTilesetToVram" in transition or "CopyMapTilesetsToVram" in transition,
+                   "staticSecondaryGraphicSlots": 376, "doorAnimationScratchGlobalGraphics": [1016, 1023],
+                   "staticGraphicReferencesMustBeBelow": 1016},
+        "releasedGreenwayOwnSceneAndBorder": usage(own), "incomingStrips": incoming, "outgoingStrips": outgoing,
+        "allDistrictBidirectionalBorrowedCells": all_strip_cells,
+        "requiredGreenwayOwnAndIncoming": total,
+        "secondaryGraphicCapacity": {"existingOldCoreUsedStaticGraphics": core_manifest["secondaryGraphics"],
+                                     "essentialExistingSecondaryGraphicIds": sorted(essential),
+                                     "availableStaticSecondarySlotsForCombinedNewArt": 376 - len(essential),
+                                     "notPerLandmark": True, "newCandidateUnionMeasured": False},
+        "primaryReuse": {"mustNotChangePrimaryPixelsOrDefinitions": True,
+                         "excludedAnimatedGraphicRangesInclusive": ranges(animation),
+                         "eligibleNonanimatedPrimaryRawSlots": len(static_primary),
+                         "eligibleFlipCanonicalIndexedPatterns": len(primary_patterns),
+                         "allAnimationDestinationPixelsMatchOriginalGeneral": primary_unchanged_required,
+                         "reuseRequiresExactIndexed8x8MatchAllowingFlips": True,
+                         "initialFramePatternCountIsNotAnAnimationSafetyProof": True},
+        "metatileIdPlan": {"requiredSecondaryIdsNow": total["secondaryMetatileIds"],
+                           "requiredSourcePewterIdsNow": [n for n in total["secondaryMetatileIds"] if n < 719],
+                           "requiredBorrowedColorIdsNow": [n for n in total["secondaryMetatileIds"] if 815 <= n < 847],
+                           "reserveAllSourcePewterIdsInclusive": [640, 718],
+                           "reserveAllSharedColorAliasIdsInclusive": [815, 846],
+                           "availablePrivateDefinitionRangesInclusive": ranges(private),
+                           "availablePrivateDefinitionCount": len(private),
+                           "appendOnlyAfter846DefinitionCount": 177,
+                           "note": "719..814 are Station-specific in OldCity but not visible from Greenway; their meaning may be private in a separate Greenway bank when required borrowed IDs stay identical."},
+        "palettePlan": {"palette7FreeInCurrentOwnAndIncoming": 7 not in total["paletteBanks"],
+                        "palette9FreeNow": 9 not in total["paletteBanks"],
+                        "preserveCurrentPrimaryAndSceneBanks": [0, 1, 2, 3, 5, 8, 10, 11, 12],
+                        "grayBlueScienceFineArtsCandidateBank": 7,
+                        "warmShenJiCandidateBankAfterPlaceholderClearance": 9,
+                        "authoredSuggestionOnly": True,
+                        "futureWholePrefabCatalogPalette9CompatibilityNotPromised": True},
+        "analyticalPlaceholderClearanceStages": stages,
+        "futureGeometryConstraints": {
+            "greenwayDonatedBandsToKeepCompatible": [r["donorBoundsInclusive"] for r in outgoing],
+            "currentLandmarkAnchors": {name: {key: landmarks[name][key] for key in ("footprint", "entrance", "approach", "arrival")} for name in FUTURE},
+            "science": "A 12x8 envelope at origin18,13 endsx29 and is clear of east donationx33..39; future wider opaque ink reachingx33 needs cross-bank compatibility.",
+            "shenJi": "Door10,44 with a hypothetical12x8 envelope and localdoor6,7 givesorigin4,37: opaque ink atglobalx4..7,y37..38 leaks into Xitun's view. Test actual alpha/placement; keep this donated strip unchanged or obtain a cross-bank contract.",
+            "fineArts": "The current door10,62 and footprinty56..62 are well below the Xitun donationmaxy38; keep eastdonationx33..39 compatible.",
+            "artFitOrDoorPlacementChanged": False,
+        },
+        "requiredIndependentValidation": [
+            "Frozen shared primary bytes, primary pointer and General animation callback/destinations unchanged.",
+            "Exact donor-strip RGB, attributes/layers and collision/elevation words remain compatible in both banks.",
+            "All unchanged own-map cells retain words, RGB and attributes; all new entries targetgfx<1016.",
+            "Actual approved candidates jointly pack within376staticsecondaryslots after exact nonanimatedprimary reuse.",
+            "Door/approach/arrival warps, actors, routeBFS and existing otherlandmarks stay valid.",
+            "Main separately owns new-blocked-cell save migration and runtimewalks; staticcapacity alone proves neither.",
+        ],
+    }
+    report["frozenInputSha256"] = {path: hashlib.sha256(raw).hexdigest() for path, raw in sorted(files.cache.items())}
+    return report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--baseline", default=BASE)
+    parser.add_argument("--output", type=Path, default=ROOT.parents[1] / "artifacts/worktrees/c291d4842985/greenway-analysis/capacity.json")
+    args = parser.parse_args()
+    report = analyze(args.source.resolve(), args.baseline)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps({"baselineCommit": report["baselineCommit"],
+                      "requiredSecondaryGraphics": report["secondaryGraphicCapacity"]["essentialExistingSecondaryGraphicIds"],
+                      "availableCombinedStaticGraphics": report["secondaryGraphicCapacity"]["availableStaticSecondarySlotsForCombinedNewArt"],
+                      "availablePrivateDefinitions": report["metatileIdPlan"]["availablePrivateDefinitionCount"],
+                      "paletteStages": [{"cleared": row["analyticallyClearedPlaceholderIds"], "palettes": row["usage"]["paletteBanks"], "palette9Free": row["remainingPalette9Free"]} for row in report["analyticalPlaceholderClearanceStages"]],
+                      "output": str(args.output)}, indent=2))
