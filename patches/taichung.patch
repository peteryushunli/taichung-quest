+def registered_cmp_guard(source, overrides=None):
+    support = load('greenway_dispatch_bank', ROOT/'tools/taichung/landmarks/check_old_core.py')
+    files = support.Files(source)
+    files.cache.update(overrides or {})
+    data = files.json('data/maps/TaichungGreenway/map.json')
+    layout = next(item for item in files.json('data/layouts/layouts.json')['layouts'] if item.get('id') == data['layout'])
+    if (layout['primary_tileset'],layout['secondary_tileset']) != ('gTileset_TaichungGreenwayPrivate','gTileset_TaichungGreenwayCmp'):
+        return None
+    return load('greenway_registered_cmp_guard', source/'tools/taichung/landmarks/check_cmp.py')
+
+
+def check(source, manifest_path=MANIFEST, baseline_ref=BASE, overrides=None):
+    cmp = registered_cmp_guard(source, overrides)
+    if cmp is not None:
+        result = cmp.check(source, overrides=overrides)
+        return {"schemaVersion":1,"passed":result["passed"],"scope":"Independent registered CMP source proof; no runtime/save claim.",
+                "baselineCommit":result["baselineCommit"],"manifest":cmp.MANIFEST,"registeredCmpIncrement":True,
+                "results":result["checks"],"errors":result["errors"],"warnings":result["warnings"]}
+    support = load("greenway_independent_bank", ROOT / "tools/taichung/landmarks/check_old_core.py")
+    strips = load("greenway_independent_strip", ROOT / "tools/taichung/landmarks/analyze_theater_cohort.py")
+    now, before = support.Files(source), support.Files(source, baseline_ref)
+    now.cache.update(overrides or {})
+    tests = support.Checks()
+    manifest = now.json(manifest_path)
+    baseline_full = subprocess.check_output(["git", "rev-parse", f"{baseline_ref}^{{commit}}"], cwd=source, text=True).strip()
+    old_layouts = {item["id"]: item for item in before.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    layouts = {item["id"]: item for item in now.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    core_before = support.Bank(before, PRIMARY_FOLDER, "data/tilesets/secondary/taichung_old_core")
+    bank = support.Bank(now, PRIMARY_FOLDER, SECONDARY_FOLDER)
+    animation = set(before.json("data/taichung/landmarks/old-core-bank-audit.json")["generalAnimation"]["fixedGraphicIds"])
+    old_contract, contract = before.json("docs/taichung-city-contract.json"), now.json("docs/taichung-city-contract.json")
+    old_landmarks = {item["id"]: item for item in old_contract["landmarks"]}
+    selected = [dict(item, id=ALIASES.get(item["id"], item["id"])) for item in manifest["landmarks"]]
+    selected_ids = {item["id"] for item in selected}
+    selected_building_ids = {item["id"] for item in selected if item.get("role") != "prop"}
+    maps, old_maps, grids, old_grids, banks, old_banks = {}, {}, {}, {}, {}, {}
+
+    def identity():
+        tests.require(manifest["baselineCommit"] == baseline_full == BASE, "Manifest must freeze the agreed 16625bd baseline")
+        tests.require((manifest["primary"], manifest["secondary"]) == (PRIMARY_LABEL, SECONDARY_LABEL), "Unexpected Greenway bank labels")
+        tests.require((manifest["primaryFolder"], manifest["secondaryFolder"]) == (PRIMARY_FOLDER, SECONDARY_FOLDER), "Unexpected Greenway folders")
+        tests.require(bool(selected) and len(selected_ids) == len(selected) and selected_ids <= set(APPROVALS), "Unapproved or duplicate landmark ID in increment")
+        for item in selected:
