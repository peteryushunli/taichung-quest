+#!/usr/bin/env python3
+"""Independent Xitun final-bank and semantic-map checks; no source writes.
+
+Expected pixels come from Git-pinned approved PNGs; geometry comes from fixed
+reviewed masks and the original map. No compiler module or CMP guard is imported.
+Use --proposal before Root registers the assembled landmarks secondary bank.
+"""
+from __future__ import annotations
+
+import argparse
+from io import BytesIO
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "c1bc28900f0ae46f9a15d74d4089317c66a28b00"
+ORIGINAL = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
