--- /dev/null
+++ b/tools/taichung/boulevard_city/verify_north_xitun.py
@@ -0,0 +1,149 @@
+"""Compare resolved native pixels, metatile attributes, and collision across the city."""
+from functools import lru_cache
+import json
+from pathlib import Path
+import struct
+import sys
+from PIL import Image
+
+game, qa, old_overview = map(Path, sys.argv[1:])
+sys.path.insert(0, str(game / 'tools/taichung'))
+from render_maps import words
+sys.path.insert(0, str(game / 'tools/taichung/tile_limit_probe'))
+from packing import c15, c24
+
+def read(path):
+    return json.loads(path.read_text())
+
+def unpack(path, width, code):
+    data = path.read_bytes()
+    return struct.unpack(f'<{len(data) // width}{code}', data)
+
+primary = game / 'data/tilesets/primary/taichung_approved_old_city_north'
+primary_tiles = (primary / 'tiles.4bpp').read_bytes()
+primary_meta = words(primary / 'metatiles.bin')
+primary_attrs = unpack(primary / 'metatile_attributes.bin', 4, 'I')
+primary_colors = tuple(
+    c15(tuple(map(int, line.split())))
+    for i in range(7)
+    for line in (primary / 'palettes' / f'{i:02}.pal').read_text().splitlines()[3:] if line.strip()
+)
+
+class CityTiles:
+    def __init__(self, sources):
+        self.data = sources / 'data/tilesets/secondary/taichung_boulevard'
+        self.tiles = primary_tiles + (self.data / 'tiles.bin').read_bytes()
+        colors = words(self.data / 'palettes.bin')
+        self.colors = primary_colors + colors[len(primary_colors):]
+
+    @lru_cache(maxsize=None)
+    def map_tables(self, n):
+        prefix = self.data / f'map_{n:02}'
+        return (
+            words(prefix.with_name(prefix.name + '_metatiles.bin')),
+            prefix.with_name(prefix.name + '_banks.bin').read_bytes(),
+            unpack(prefix.with_name(prefix.name + '_attributes.bin'), 4, 'I'),
+        )
+
+    @lru_cache(maxsize=None)
+    def pixels(self, word, bank, opaque=False):
+        tile = (word & 0x3ff) | ((bank & 0x3f) << 10)
+        orientation = (word >> 10) & 3
+        palette = ((bank >> 6) << 4) | (word >> 12)
+        block = self.tiles[tile*32:tile*32+32]
+        assert len(block) == 32 and palette*16 + 15 < len(self.colors)
+        rows = [list(it for b in block[i:i+4] for it in (b & 15, b >> 4)) for i in range(0,32,4)]
+        if orientation & 1:
+            rows = [row[::-1] for row in rows]
+        if orientation & 2:
+            rows.reverse()
+        return tuple(self.colors[palette*16 + n] if n or opaque else -1 for row in rows for n in row)
+
+    @lru_cache(maxsize=None)
+    def metatile(self, number, key):
+        if key < 640:
+            table, banks, attrs, offset = primary_meta, bytes(5120), primary_attrs, key
+        else:
+            table, banks, attrs = self.map_tables(number)
+            offset = key - 640
+        parts = []
+        for idx in range(offset*8, offset*8+8):
+            parts.append(self.pixels(table[idx], banks[idx], opaque=idx%8<4))
+        return attrs[offset], tuple(parts)
+
+    def cell(self, number, word):
+        return word & 0xf400, self.metatile(number, (word & 0x3ff) | ((word & 0x800) >> 1))
+
+    def cell_image(self, number, word):
+        _, (_, parts) = self.cell(number, word)
+        image = Image.new('RGB',(16,16))
+        for i in range(4):
+            values = [a if b == -1 else b for a,b in zip(parts[i],parts[i+4])]
+            quadrant = Image.new('RGB',(8,8))
+            quadrant.putdata([c24(n) for n in values])
+            image.paste(quadrant,((i%2)*8,(i//2)*8))
+        return image
+
+
+base, candidate = qa / 'production-baseline', qa / 'candidate'
+before, after = CityTiles(base), CityTiles(candidate)
+baseline = read(base / 'build-report.json')
+report = read(candidate / 'build-report.json')
+sites = report['northXitun']['sites']
+rects = [s['block'] for s in sites]
+contains = lambda r, x, y: r[0] <= x < r[2] and r[1] <= y < r[3]
+allowed = lambda x, y: any(contains(r, x, y) for r in rects)
+assert report['reachable']['seams'] == baseline['reachable']['seams']
+assert report['xitunTowerBlock'] == baseline['xitunTowerBlock']
+assert report['installedLandmarks'] == baseline['installedLandmarks']
+assert report['captureSigns'] == baseline['captureSigns']
+assert report['streetPeople'] == baseline['streetPeople']
+checked = 0
+changed, walked = set(), set()
+crop = (44, 60, 145, 127)
+scene = Image.new('RGB', ((crop[2]-crop[0])*16, (crop[3]-crop[1])*16))
+for old, new in zip(baseline['maps'], report['maps'], strict=True):
+    assert {k:v for k,v in old.items() if k!='localWalkable'} == {k:v for k,v in new.items() if k!='localWalkable'}
+    name, number = new['name'], new['number']
+    x0,y0,x1,y1 = new['worldRect']
+    for kind, margin in (('map',0),('border',9)):
+        prefix = Path('data/layouts') / name / (kind+'.bin')
+        w,h = x1-x0,y1-y0
+        bw,bh = w+margin*2,h+margin*2
+        for index,(a,b) in enumerate(zip(words(base/prefix),words(candidate/prefix),strict=True)):
+            rx,ry = index % bw,index // bw
+            x=x0+(rx if rx<w+margin else rx-bw)
+            y=y0+(ry if ry<h+margin else ry-bh)
+            if before.cell(number,a) != after.cell(number,b):
+                assert allowed(x,y), (name,kind,x,y,'changed outside approved infill')
+                changed.add((x,y))
+            if kind=='map':
+                if not b & 0x400:
+                    walked.add((x,y))
+                if contains(crop,x,y):
+                    scene.paste(after.cell_image(number,b),((x-crop[0])*16,(y-crop[1])*16))
+            checked+=1
+
+for site in sites:
+    assert all(tuple(p) in walked for p in site['approaches']), site['id']
+    if site['id']=='huimin-park':
+        for g in site['groundRects']:
+            a,b,c,d=g['rect']
+            assert all((x,y) in walked for y in range(b,d) for x in range(a,c)), ('blocked park loop',g)
+    a,b,c,d=site['block']
+    focus=scene.crop(((a-crop[0])*16,(b-crop[1])*16,(c-crop[0])*16,(d-crop[1])*16))
+    focus.resize((focus.width*2,focus.height*2),Image.Resampling.NEAREST).save(qa/(site['id']+'-block.png'))
+scene.save(qa/'north-xitun-native.png')
+scene.resize((808,536),Image.Resampling.NEAREST).save(qa/'north-xitun-review.png')
+overview=Image.open(old_overview).convert('RGB')
+assert overview.size==(353*6,256*6)
+for a,b,c,d in rects:
+    focus=scene.crop(((a-crop[0])*16,(b-crop[1])*16,(c-crop[0])*16,(d-crop[1])*16))
+    overview.paste(focus.resize(((c-a)*6,(d-b)*6),Image.Resampling.NEAREST),((a-31)*6,b*6))
+overview.save(candidate/'city-overview.png')
+result=dict(checkedResolvedMapAndBorderCells=checked,changedWorldCells=len(changed),
+            allChangesWithinApprovedBlocks=True,streetsTowersLandmarksEventsAndConnectionsUnchanged=True,
+            walkableCells=len(walked),directedConnections=len(report['reachable']['seams']),
+            parkLoopAndFourEntrancesWalkable=True,budget=report['budget'])
+(qa/'source-validation.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps(result,indent=2))
