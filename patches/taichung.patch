new file mode 100644
index 0000000..b3a9a3c
--- /dev/null
+++ b/include/taichung_navigation_bridge.h
@@ -0,0 +1,61 @@
+#ifndef GUARD_TAICHUNG_NAVIGATION_BRIDGE_H
+#define GUARD_TAICHUNG_NAVIGATION_BRIDGE_H
+
+#include "gba/types.h"
+
+// Little-endian bytes "TCNAV001". Native publishes; the browser only reads.
+#define TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A 0x414E4354
+#define TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B 0x31303056
+#define TAICHUNG_NAVIGATION_BRIDGE_VERSION 1
+#define TAICHUNG_NAVIGATION_BRIDGE_SIZE 48
+
+#define TAICHUNG_NAVIGATION_READY          (1 << 0)
+#define TAICHUNG_NAVIGATION_FIELD          (1 << 1)
+#define TAICHUNG_NAVIGATION_POSITION_VALID (1 << 2)
+#define TAICHUNG_NAVIGATION_OUTDOOR        (1 << 3)
+#define TAICHUNG_NAVIGATION_INDOOR         (1 << 4)
+#define TAICHUNG_NAVIGATION_CYCLING         (1 << 5)
+#define TAICHUNG_NAVIGATION_CAN_TOGGLE_BIKE (1 << 6)
+
+#define TAICHUNG_NAVIGATION_CONTEXT_CALLBACKS_SKIPPED (1 << 0)
+#define TAICHUNG_NAVIGATION_CONTEXT_NOT_FIELD         (1 << 1)
+#define TAICHUNG_NAVIGATION_CONTEXT_BATTLE            (1 << 2)
+#define TAICHUNG_NAVIGATION_CONTEXT_TRANSITION        (1 << 3)
+#define TAICHUNG_NAVIGATION_CONTEXT_SCRIPT            (1 << 4)
+#define TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE          (1 << 5)
+#define TAICHUNG_NAVIGATION_CONTEXT_LINK              (1 << 6)
+#define TAICHUNG_NAVIGATION_CONTEXT_REPLAY            (1 << 7)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE      (1 << 8)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR    (1 << 9)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION  (1 << 10)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP       (1 << 11)
+
+struct TaichungNavigationBridge
+{
+    /* 0x00 */ u32 magicA;
+    /* 0x04 */ u32 magicB;
+    /* 0x08 */ u16 version;
+    /* 0x0A */ u16 size;
+    /* 0x0C */ u32 selfGbaAddress;
+    /* 0x10 */ u32 sequence;     // Odd during publication; stable, nonzero even afterward.
+    /* 0x14 */ u32 frameCounter; // Advances every Tick, including hidden contexts.
+    /* 0x18 */ u32 flags;
+    /* 0x1C */ s16 localX;       // Zero-based destination metatile; -1 when invalid.
+    /* 0x1E */ s16 localY;
+    /* 0x20 */ u8 mapGroup;      // Native saved map IDs; 0xFF when invalid.
+    /* 0x21 */ u8 mapNum;
+    /* 0x22 */ u8 facing;        // 0 unknown; 1 south, 2 north, 3 west, 4 east.
+    /* 0x23 */ u8 mapType;       // Native MAP_TYPE_*; 0 when invalid.
+    /* 0x24 */ u16 mapWidth;     // Local layout dimensions in 16-pixel metatiles.
+    /* 0x26 */ u16 mapHeight;
+    /* 0x28 */ u16 contextFlags; // Nonzero: hide/suspend the live minimap.
+    /* 0x2A */ u16 reserved16;
+    /* 0x2C */ u32 reserved32;
+};
+
+extern volatile struct TaichungNavigationBridge gTaichungNavigationBridge;
+
+// Call once per main loop after game callbacks, next to the language Tick.
+void TaichungNavigationBridge_Tick(bool8 gameCallbacksRan);
+
+#endif
