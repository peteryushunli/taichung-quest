+def shape(t):
+ """Color-independent shape, retaining transparent zero as a special role."""
+ seen={0:0};out=[]
+ for c in t:
+  if c not in seen:seen[c]=len(seen)
+  out.append(seen[c])
+ return bytes(out)
+
