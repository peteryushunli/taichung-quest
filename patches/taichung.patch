+#!/usr/bin/env python3
+"""Fill the approved64x64 old-core lots; preserve all authored reservations."""
+import argparse
+from collections import Counter,deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image,ImageDraw
+
+from color_compile import compile_colorways,color_grid,native_tile_images,save_native
+from library import ROOT,WALK,require
+from neighborhood_pilot import player_reference
+
+
+def geometry_helpers():
+    spec=importlib.util.spec_from_file_location('taichung_geography_pilot',ROOT/'tools/taichung/geography/profile_pilot.py')
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    return module
+
+
+def cells(rect):
+    return {(x,y) for y in range(rect[1],rect[3]+1) for x in range(rect[0],rect[2]+1)}
+
+
+def context_for(prefab,band):
+    preferences=['shopping','market','mixed-use','neighborhood-centre','transport-plaza'] if band=='primaryRetailFrontage' else ['residential','mixed-use','residential-corner','neighborhood-centre','shopping','park-edge']
+    return next((c for c in preferences if c in prefab['allowedContext']),prefab['allowedContext'][0])
+
+
+def fill_layout(compiled,layout,profile):
+    width,height=layout['width'],layout['height'];require((width,height)==(64,64),'Only approved64x64 pilot supported by this helper')
+    geo=geometry_helpers();roads=set().union(*(geo.line_cells(r['authoredLocalCenterline'],r['widthTiles']) for r in layout['authoredRoads']))
+    approaches=set().union(*(cells(a['rect']) for a in layout['clearApproaches']))
+    gym_reserves=set().union(*(cells(l['proposedAuthoredLocal']['reserveRect']) for l in layout['landmarks']))
+    gym_art=set().union(*(cells(l['proposedAuthoredLocal']['artRect']) for l in layout['landmarks']))
+    require(not roads&gym_art,'Authored road crosses gym art envelope')
+    protected=roads|approaches;base=[0x3001]*(width*height)
+    for x,y in roads:base[y*width+x]=0x316e
+    for x,y in approaches:base[y*width+x]=0x3175
+    # Gym art stays explicitly reserved. Solid normal tiles prevent a fake shortcut
+    # through a future façade; no decorative door or active warp is invented.
+    for x,y in gym_art:base[y*width+x]=0x056e
+    lib=compiled['library'];placements=[];lot_records=[];role_counts={};variant_counts=Counter()
+    for lot in layout['candidateLots']:
+        band=lot['streetBand'];targets=profile['streetBands'][band];weights=targets['prefabRoleWeights'];counts=role_counts.setdefault(band,Counter())
+        compatible=[lib.prefabs[i] for i in lot['compatibleSizeOnlyPrefabIds'] if lib.prefabs[i]['role'] in weights]
+        require(bool(compatible),f'No role-compatible module for{lot["id"]}')
+        n=sum(counts.values())+1;roles=sorted({p['role'] for p in compatible})
+        role=max(roles,key=lambda r:(weights.get(r,0)*n-counts[r],r))
+        options=[p for p in compatible if p['role']==role]
+        if role=='residential-walkup':
+            # Taller bays form a rhythm when envelopes allow, not random heights.
+            choice='building-walkup-tall' if lot['height']>=8 and counts[role]%2==0 else 'building-walkup-low'
+            options.sort(key=lambda p:(p['id']==choice,p['width']*p['bodyHeight']),reverse=True)
+        else:options.sort(key=lambda p:(p['width']*p['bodyHeight'],p['width']),reverse=True)
