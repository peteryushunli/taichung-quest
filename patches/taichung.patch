+                   "foregroundEnvelopeCells": len(metatiles), "occupiedMetatiles": sum(row.count("1") for row in rows),
+                   "distinctForegroundDefinitionsIncludingEmpty": len({tuple(group) for group in metatiles}),
+                   "occupancyRows": rows, "roundTripPixels": width*height, "tilemapRoundTripPass": True},
+        "entryAnalysis": {"regions": entry_regions, "regionsAreMeasurementsOnly": True,
