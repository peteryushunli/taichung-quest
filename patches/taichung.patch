+static void AssertXitunWarp(s16 x, s16 y)
+{
+    AssertDistrictWarp(MAP_NUM(MAP_TAICHUNG_XITUN), x, y);
+}
+
+static void InXitun(s16 x, s16 y)
+{
+    InOldCity(x,y);
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_XITUN);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_XITUN);
+}
+
+
+static void XitunRelocate(const u8 (*table)[4], unsigned count, u8 *x, u8 *y)
+{
+    unsigned i;
+    for (i = 0; i < count; i++)
+        if (*x == table[i][0] && *y == table[i][1])
+        {
+            *x = table[i][2]; *y = table[i][3];
+            return;
+        }
+}
+
+// Continue chains historical repairs before the final collision-only v9 repair.
+static void AssertXitunAfter(unsigned version, u8 x, u8 y)
+{
+    if (version < 4) XitunRelocate(sXitunV4Cases, COUNT(sXitunV4Cases), &x, &y);
+    if (version < 7) XitunRelocate(sXitunV7Cases, COUNT(sXitunV7Cases), &x, &y);
+    if (version < 8) XitunRelocate(sXitunV8Cases, COUNT(sXitunV8Cases), &x, &y);
+    if (version < 9 && sV9Solid[y][x]) { x = 12; y = 35; }
+    AssertXitunWarp(x,y);
+}
+
