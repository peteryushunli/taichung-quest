+    [TAICHUNG_GYM_MESSAGE_NOT_RECORDED] = {TaichungGym_Text_ShenJiNotRecordedEn, TaichungGym_Text_ShenJiNotRecordedZh},
+    [TAICHUNG_GYM_MESSAGE_UNAVAILABLE] = {TaichungGym_Text_ShenJiUnavailableEn, TaichungGym_Text_ShenJiUnavailableZh},
