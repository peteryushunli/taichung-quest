+#!/usr/bin/env python3
+"""V4 block-density proof: fixed geography, old fixtures, native pack and access."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+from tempfile import TemporaryDirectory
+
+from color_check import check as check_native_colors
+from color_compile import compile_colorways, native_tile_images
+from library import ROOT, parse_words, render_tools, require
+from neighborhood_blocks import compile_blocks, compose_blocks
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(output, previous):
+    output = Path(output); previous = [Path(p) for p in previous]
+    require(len(previous) == 3, 'Pass preserved V1, V2 and V3 directories')
+    hashes = {str(folder): {str(p.relative_to(folder)): sha(p) for p in folder.rglob('*') if p.is_file()} for folder in previous}
+    require(all(hashes.values()), 'Previous fixture directories must contain files')
+    layout = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json').read_text())
+    compiled, plan = compile_blocks(output, layout); result = compose_blocks(compiled, layout, plan)
+    repeated_compiled, repeated_plan = compile_blocks(output, layout)
+    repeated = compose_blocks(repeated_compiled, layout, repeated_plan)
+    require(result['words'] == repeated['words'] and plan['units'] == repeated_plan['units'], 'Nondeterministic composition')
+    raw = (output / 'filled-map.bin').read_bytes()
+    require(list(struct.unpack('<4096H', raw)) == result['words'], 'Saved words differ from validated composition')
+    for folder in previous:
+        old = struct.unpack('<4096H', (folder / 'filled-map.bin').read_bytes())
+        for x, y in plan['invariant']:
+            require(result['words'][y * 64 + x] == old[y * 64 + x], f'Fixed road/gym/arrival cell differs from {folder.name}: {x},{y}')
+        old_report = json.loads((folder / 'validation.json').read_text())
+        old_hash = old_report.get('sourceLayoutSha256', old_report.get('sourceLayoutCanonicalJsonSha256'))
+        require(old_hash == result['report']['sourceLayoutCanonicalJsonSha256'], 'Source geometry changed')
+    saved_plan = json.loads((output / 'block-plan.json').read_text())
+    require(saved_plan['originalLotRecords'] == layout['candidateLots'], 'Original lot provenance records changed')
+    require(len(plan['eligible']) == 4096 - 1311 and len(plan['invariant']) == 1311, 'Buildable denominator altered')
+    actual_solids = {(x, y) for x, y in plan['eligible'] if result['words'][y * 64 + x] & 0xc00}
+    require(actual_solids == plan['solid'], 'Actual roofs disagree with authored blocked footprint')
+    require(result['report']['solidShareOfAllUnreservedLand'] >= .60, 'Unreserved building coverage below requested floor')
+    require(.60 <= result['report']['solidShareAfterExplicitAprons'] <= .75, 'Density outside requested 60–75% after explicit aprons')
+    require(not plan['solid'] & plan['invariant'], 'Building roof enters protected geometry')
+    lib = compiled['library']
+    for word in result['words']:
+        t = word & 1023; attr = lib.attr(t) if t < 640 else compiled['attributes'][t - 640]
+        require(attr & 0x1ff not in range(0x60, 0x70), 'Unregistered warp-door behavior')
+    baseline = compile_colorways()
+    for field in ('graphics', 'metatiles', 'attributes', 'palettes', 'remaps'):
+        require(compiled[field] == baseline[field], f'Block modules unexpectedly alter native {field}')
+    source_ids = lambda c: {w & 1023 for p in c['library'].prefabs.values() for row in parse_words(p) for w in row}
+    extra = (source_ids(compiled) | {w & 1023 for w in result['words'] if w & 1023 < 640}) - (source_ids(baseline) | {1})
+    require(all(t < 640 for t in extra), 'New secondary source metatiles introduced')
+    original = render_tools().render_metatiles(ROOT, 'General', 'PewterCity')
+    for tile, image in native_tile_images(compiled, extra).items():
+        require(image.tobytes() == original[tile].tobytes(), 'Additional primary ground render differs')
+    proof = check_native_colors()
+    with TemporaryDirectory(prefix='taichung-block-offset-') as temp:
+        moved, moved_plan = compile_blocks(temp, layout, variant_metatile_start=900)
+        shifted = compose_blocks(moved, layout, moved_plan)
+        original_images = native_tile_images(compiled); moved_images = native_tile_images(moved)
+        require(min(v for m in moved['remaps'].values() for v in m.values()) == 900, 'Variant offset ignored')
+        for family, mapping in compiled['remaps'].items():
+            for source, tile in mapping.items():
+                require(original_images[tile].tobytes() == moved_images[moved['remaps'][family][source]].tobytes(), 'Relocation changes roof rendering')
+        require(all(a & 0xfc00 == b & 0xfc00 for a, b in zip(result['words'], shifted['words'])), 'Relocation changes collision/elevation')
+    bank = output / 'native-color-bank'; gfx = (bank / 'tiles.4bpp').read_bytes()
+    decoded = [tuple(v for byte in gfx[i:i + 32] for v in (byte & 15, byte >> 4)) for i in range(0, len(gfx), 32)]
+    require(decoded == compiled['graphics'], 'Saved 4bpp roundtrip differs')
+    meta = (bank / 'metatiles.bin').read_bytes(); entries = struct.unpack(f'<{len(meta) // 2}H', meta)
+    require(list(entries) == [v for row in compiled['metatiles'] for v in row], 'Saved metatile roundtrip differs')
+    attr = (bank / 'metatile_attributes.bin').read_bytes()
+    require(list(struct.unpack(f'<{len(attr) // 4}I', attr)) == compiled['attributes'], 'Saved attributes roundtrip differs')
+    palette = struct.unpack('<16H', (bank / '12.gbapal').read_bytes())
+    require([((v & 31) * 8, ((v >> 5) & 31) * 8, ((v >> 10) & 31) * 8) for v in palette] == compiled['palettes'][12], 'Saved BGR555 colors differ')
+    for folder in previous:
+        require({str(p.relative_to(folder)): sha(p) for p in folder.rglob('*') if p.is_file()} == hashes[str(folder)], 'Previous artifacts changed')
+    report = dict(result='pass', previousFixtureHashesPreserved=hashes, invariantCellsComparedPerVersion=1311,
+        previousVersionsCompared=3, deterministicMapSha256=sha(output / 'filled-map.bin'),
+        unchangedBaseNativeBank=True, addedGraphicsOrMetatiles=0,
+        sourceRenderComparisons=proof['baseMetatileRendersCompared'] + len(extra), roofShaderComparisons=32,
+        native4bppGraphicsRoundtripped=len(decoded), nativeMetatileU16ReferencesRoundtripped=len(entries),
+        nativeAttributesU32Roundtripped=len(compiled['attributes']), bgr555ColorsRoundtripped=16,
+        relocatedRoofRendersCompared=32, densityAndAccess=result['report'])
+    (output / 'block-checks.json').write_text(json.dumps(report, indent=2) + '\n')
+    sources = [
+        'tools/taichung/streetscape/neighborhood_blocks.py', 'tools/taichung/streetscape/neighborhood_blocks_check.py',
+        'tools/taichung/streetscape/neighborhood_frontage.py', 'tools/taichung/streetscape/neighborhood_density.py',
+        'tools/taichung/streetscape/neighborhood_fill.py',
+        'tools/taichung/streetscape/neighborhood_pilot.py', 'tools/taichung/streetscape/color_compile.py',
+        'tools/taichung/streetscape/color_check.py', 'tools/taichung/streetscape/library.py',
+        'tools/taichung/geography/profile_pilot.py', 'tools/taichung/render_maps.py',
+        'data/taichung/prefabs/catalog.json', 'data/taichung/prefabs/colorways.json',
+        'data/taichung/neighborhoods/pilot-r2c2-layout.json',
+        'graphics/object_events/pics/people/red_normal.png', 'graphics/object_events/palettes/player.pal',
+    ]
+    for folder in ('primary/general', 'secondary/pewter_city'):
+        path = ROOT / 'data/tilesets' / folder
+        sources.extend(str((path / name).relative_to(ROOT)) for name in ('tiles.png', 'metatiles.bin', 'metatile_attributes.bin'))
+        sources.extend(str(p.relative_to(ROOT)) for p in sorted((path / 'palettes').glob('*.pal')))
+    provenance = dict(schemaVersion=1, nativeRegistration=False,
+        geometry='Fixed roads/gyms/arrival paths retained exactly. New rectangular building runs over blank land are authored game geometry, not surveyed parcels.',
+        oldLots='All24 records preserved; their boundaries do not limit V4 block footprints.',
+        art='Recombined General/Pewter native metatiles with palette12 roof-index remaps. Native geometry/art is provisional, not bespoke Taiwan architecture.',
+        sourceSha256={name: sha(ROOT / name) for name in sources},
+        emittedFileSha256={str(p.relative_to(output)): sha(p) for p in sorted(output.rglob('*')) if p.is_file() and p.name != 'provenance.json'})
+    (output / 'provenance.json').write_text(json.dumps(provenance, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in report.items() if k not in ('previousFixtureHashesPreserved', 'densityAndAccess')}, indent=2))
+    return report
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--previous', type=Path, action='append', required=True)
+    args = parser.parse_args(); check(args.output, args.previous)
