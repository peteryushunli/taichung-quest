+        tests.require(kit_ids <= free_defs, f"Kit IDs in used or reserved definitions: {sorted(kit_ids - free_defs)}")
+        tests.require(not set(TILE_SLOTS) & ANIMATED, "Kit tiles in General's animation slots")
+        return {"commonFreeTiles": report["commonFreeTileCount"], "kitFreeTiles": report["kitFreeTileCount"]}
+
+    def exteriors():
+        layouts = {l["id"]: l for l in now.json("data/layouts/layouts.json")["layouts"] if l}
