@@ -0,0 +1,29 @@
+TaichungOldCity_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, Taichung_OnFrame
+	.byte 0
+
+@ The new-game-only C field gate starts this before ordinary input handling.
+@ It does not run for existing saves or while quest-log recap is playing.
+TaichungOldCity_OnboardingStart::
+	lockall
+	turnobject LOCALID_TAICHUNG_STATION_GUIDE, DIR_EAST
+	turnobject LOCALID_PLAYER, DIR_WEST
+	callnative TaichungOnboarding_ScriptIsRelease
+	goto_if_eq VAR_RESULT, TRUE, TaichungOldCity_OnboardingRelease
+TaichungOldCity_OnboardingTopic::
+	callnative TaichungOnboarding_ScriptBufferTopic
+	message gStringVar4
+	waitmessage
+	callnative TaichungOnboarding_ScriptWaitCard
+	waitstate
+	closemessage
+	callnative TaichungOnboarding_ScriptAdvance
+	goto_if_eq VAR_RESULT, FALSE, TaichungOldCity_OnboardingTopic
