+bool8 TaichungBadgeLoadPalettes(void)
+{
+    if (LoadSpritePalette(&sPalettes[0]) == 0xFF)
+        return FALSE;
+    if (LoadSpritePalette(&sPalettes[1]) == 0xFF)
+    {
+        FreeSpritePaletteByTag(BADGE_PALETTE_EARNED);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+void TaichungBadgeFreePalettes(void)
+{
+    FreeSpritePaletteByTag(BADGE_PALETTE_EARNED);
+    FreeSpritePaletteByTag(BADGE_PALETTE_LOCKED);
+}
+
+u8 TaichungBadgeCreateSprite(u16 gymId, bool8 award, bool8 earned, s16 x, s16 y)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT)
+        return MAX_SPRITES;
+    return CreateSprite(award ? &sAwardSprites[gymId] : &sCollectionSprites[gymId][earned != FALSE], x, y, 0);
+}
+
+// Only the shared after-win script calls these adapters. Collection/history reads
+// never consume or create an award, and no new progress field is stored.
+void TaichungBadge_ScriptPrepareAward(void)
+{
+    sPreparedAward = TAICHUNG_GYM_NONE;
+    gSpecialVar_Result = FALSE;
+    if (QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+    {
+        TaichungGymCancelChallenge();
+        return;
+    }
+    if (TaichungGymConsumeNewBadge(gSpecialVar_0x8004))
+    {
+        sPreparedAward = gSpecialVar_0x8004;
+        gSpecialVar_Result = TRUE;
+    }
+}
+
+void TaichungBadge_ScriptOpenAward(void)
+{
+    u16 gym = sPreparedAward;
+    sPreparedAward = TAICHUNG_GYM_NONE;
+    CleanupOverworldWindowsAndTilemaps();
+    if (gym < TAICHUNG_GYM_COUNT && TaichungGymIsComplete(gym))
+        ShowTaichungBadgeAward(gym, CB2_ReturnToFieldContinueScriptPlayMapMusic);
+    else
+        SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+}
diff --git a/src/taichung_battle_ai.c b/src/taichung_battle_ai.c
new file mode 100644
index 00000000..f6ecf256
--- /dev/null
+++ b/src/taichung_battle_ai.c
@@ -0,0 +1,48 @@
+#include "global.h"
+#include "battle.h"
+#include "pokemon.h"
+#include "taichung_battle_ai.h"
+#include "taichung_encounter.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle_move_effects.h"
+
+void TaichungBattleAI_AdjustScores(s8 scores[4], u8 battler)
+{
+    u8 slot;
+    if (battler >= MAX_BATTLERS_COUNT)
+        return;
+    if (gBattleTypeFlags & BATTLE_TYPE_TRAINER)
+    {
+        if (!TaichungGymIsBadgeChallenge(gTrainerBattleOpponent_A))
+            return;
+    }
+    else if (!TaichungEncounterIsActive())
+        return;
+
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+    {
+        u8 stat;
+        if (scores[slot] <= 0 || !gBattleMons[battler].pp[slot])
+            continue;
+        switch (gBattleMoves[gBattleMons[battler].moves[slot]].effect)
+        {
+        case EFFECT_DEFENSE_UP:
+        case EFFECT_DEFENSE_UP_2:
+        case EFFECT_DEFENSE_CURL:
+            stat = STAT_DEF;
+            break;
+        case EFFECT_SPECIAL_DEFENSE_UP:
+        case EFFECT_SPECIAL_DEFENSE_UP_2:
+            stat = STAT_SPDEF;
+            break;
+        default:
+            continue;
+        }
+        // +2 already doubles this defense. Leave initial useful setup alone,
+        // then prefer an equally scored attack over more pure defense. Keep
+        // normal AI scoring and ties, including when attacks are unsuitable.
+        // Mixed offensive setup (Calm Mind/Bulk Up) is deliberately untouched.
+        if (gBattleMons[battler].statStages[stat] >= DEFAULT_STAT_STAGE + 2)
+            scores[slot] = scores[slot] > 8 ? scores[slot] - 8 : 0;
+    }
+}
