+
+struct Expected { u8 map, x, y, toX, toY; };
+#include "north-xitun-expect.inc"
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool8 sPending;
+static unsigned sRequests, sCases;
+bool32 UseContinueGameWarp(void) { return sPending; }
+void SetContinueGameWarpStatus(void) { sPending = TRUE; sRequests++; }
+
+static void Reset(u8 map, s16 x, s16 y)
+{
