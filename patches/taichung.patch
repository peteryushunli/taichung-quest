+    for x, y in protected: require(words[y * WIDTH + x] == native.cell(x, y), f'Protected source cell changed at {x},{y}')
+    require(all(words[y * WIDTH + x] & 0xc00 and words[y * WIDTH + x] >> 12 == 0 for x, y in painted), 'Roof footprint not fully blocked independently of story flags')
+    for u in units:
+        p = compiled['library'].prefabs[u['prefab']]
