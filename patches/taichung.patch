+         dict(id='shen-ji', input='shen-ji/candidate/nativecourtyard-layout-v2-indexed.png',
+              origin=[7,39], door=[10,44], palette=9, retired=[8,41,13,44]),
+         dict(id='fine-arts', input='fine-arts/candidate/facade/candidate-indexed.png',
+              origin=[5,57], door=[10,62], palette=7, retired=[5,56,15,62]),
+         dict(id='fine-arts-sculpture', input='fine-arts/candidate/sculpture-shared/candidate-indexed.png',
+              origin=[14,64], door=None, palette=9, role='prop', parent='fine-arts')]
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(pixels):
+    return min((tuple(pixels[(7-y if f&0x800 else y)*8+(7-x if f&0x400 else x)] for y in range(8) for x in range(8)),f)
+               for f in (0,0x400,0x800,0xc00))
+
+
+def words(path, values=None, kind='H'):
+    import struct
+    if values is None:
+        raw=path.read_bytes();return list(struct.unpack(f'<{len(raw)//struct.calcsize(kind)}{kind}',raw))
+    path.write_bytes(struct.pack(f'<{len(values)}{kind}',*values))
+
+
