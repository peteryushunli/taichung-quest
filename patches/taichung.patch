diff --git a/src/taichung_save.c b/src/taichung_save.c
new file mode 100644
index 0000000..c9d01f6
--- /dev/null
+++ b/src/taichung_save.c
@@ -0,0 +1,141 @@
+#include "global.h"
+#include "event_data.h"
+#include "load_save.h"
+#include "taichung_language.h"
+#include "taichung_save.h"
+#include "constants/maps.h"
+#include "constants/species.h"
+
+#define TAICHUNG_STARTER_VAR 0x40FC
+#define TAICHUNG_TEA_VAR 0x40FD
+
+static u16 SavedVar(u16 id)
+{
+    // Continue and map callbacks can overlap quest-log playback. Preferences
+    // and migration must inspect the current save, not a replayed variable.
+    return gSaveBlock1Ptr->vars[id - VARS_START];
+}
+
+static void SetStationWarp(struct WarpData *warp)
+{
+    warp->mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    warp->mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    warp->warpId = -1;
+    warp->x = 30;
+    warp->y = 66;
+}
+
+void TaichungSaveSetStationCheckpoint(void)
+{
+    SetStationWarp(&gSaveBlock1Ptr->lastHealLocation);
+}
+
+void TaichungSaveInitNewGame(void)
+{
+    VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+    TaichungSaveSetStationCheckpoint();
+}
+
+bool8 TaichungSaveUsesStationCheckpoint(void)
+{
+    const struct WarpData *warp = &gSaveBlock1Ptr->lastHealLocation;
+    return SavedVar(TAICHUNG_SAVE_VERSION_VAR) == TAICHUNG_SAVE_VERSION
+        && warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+}
+
+static bool8 HasPrototypeStarter(void)
+{
+    u16 species = SavedVar(TAICHUNG_STARTER_VAR);
+    return species == SPECIES_BULBASAUR || species == SPECIES_CHARMANDER
+        || species == SPECIES_SQUIRTLE || species == SPECIES_PIKACHU;
+}
+
+static bool8 IsOldCity(const struct WarpData *warp)
+{
+    return warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+}
+
+static bool8 StationArtBlocksOldPosition(s16 x, s16 y)
+{
+    // Version 2 expands only these formerly passable Station cells.
+    return (y == 57 && (x == 31 || x == 32))
+        || (x == 26 && y >= 61 && y <= 64);
+}
+
+static void ReloadStationArtOnContinue(void)
+{
+    struct WarpData *warp = &gSaveBlock1Ptr->continueGameWarp;
+
+    if (UseContinueGameWarp())
+    {
+        // An existing native return already takes the full map-load path.
+        // Preserve it, except for an explicit target inside the new facade.
+        if (IsOldCity(warp) && warp->warpId == -1
+            && StationArtBlocksOldPosition(warp->x, warp->y))
+            SetStationWarp(warp);
+        return;
+    }
+    if (!IsOldCity(&gSaveBlock1Ptr->location))
+        return;
+
+    *warp = gSaveBlock1Ptr->location;
+    warp->warpId = -1;
+    // location.x/y describe the last warp; pos is the actual saved position.
+    warp->x = gSaveBlock1Ptr->pos.x;
+    warp->y = gSaveBlock1Ptr->pos.y;
+    if (StationArtBlocksOldPosition(warp->x, warp->y))
+        SetStationWarp(warp);
+
+    // Continue first overlays mapView, then this warp reloads the authored map.
+    // Zeroing mapView alone is unsafe: the non-UBFIX emptiness check overreads.
+    SetContinueGameWarpStatus();
+}
+
+void TaichungSaveUpgradeOnContinue(void)
+{
+    bool8 inCity;
+    u16 version = SavedVar(TAICHUNG_SAVE_VERSION_VAR);
+
+    if (version >= TAICHUNG_SAVE_VERSION
+        || gSaveBlock1Ptr->playerPartyCount == 0)
+        return;
+
+    if (version == 1)
+    {
+        // Versioned city saves already own their language, team and checkpoint.
+        ReloadStationArtOnContinue();
+        VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+        return;
+    }
+
+    // The earliest prototype had a fixed Bulbasaur and only the tea marker.
+    // Untouched FireRed saves have neither marker and are left alone.
+    if (!HasPrototypeStarter())
+    {
+        if (SavedVar(TAICHUNG_STARTER_VAR) != 0 || SavedVar(TAICHUNG_TEA_VAR) == 0)
+            return;
+        VarSet(TAICHUNG_STARTER_VAR, SPECIES_BULBASAUR);
+    }
+
+    if (SavedVar(TAICHUNG_LANGUAGE_VAR) != TAICHUNG_LANGUAGE_EN
+        && SavedVar(TAICHUNG_LANGUAGE_VAR) != TAICHUNG_LANGUAGE_ZH)
+        VarSet(TAICHUNG_LANGUAGE_VAR, TAICHUNG_LANGUAGE_EN);
+
+    inCity = gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        && gSaveBlock1Ptr->location.mapNum <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM);
+    if (!inCity)
+    {
+        // Use the engine's full map-load path rather than editing a saved
+        // position under an old layout/object-event cache.
+        SetStationWarp(&gSaveBlock1Ptr->continueGameWarp);
+        SetContinueGameWarpStatus();
+    }
+    else
+    {
+        ReloadStationArtOnContinue();
+    }
+    VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+    TaichungSaveSetStationCheckpoint();
+}
diff --git a/src/taichung_starter.c b/src/taichung_starter.c
new file mode 100644
index 0000000..778fa38
--- /dev/null
+++ b/src/taichung_starter.c
@@ -0,0 +1,49 @@
+#include "global.h"
+#include "main.h"
+#include "pokemon.h"
+#include "event_data.h"
+#include "taichung_starter.h"
+#include "taichung_team.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+
+static bool8 IsStarterSpecies(u16 species)
+{
+    return species == SPECIES_CHARMANDER || species == SPECIES_BULBASAUR
+        || species == SPECIES_SQUIRTLE || species == SPECIES_PIKACHU;
+}
+
+bool8 TaichungStarterHasPartner(void)
+{
+    // A quest-log variable read can replace the current saved marker with a
+    // historical value. Inspect the current save and native party directly.
+    return (gSaveBlock1Ptr != NULL
+        && gSaveBlock1Ptr->vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] != 0)
+        || gPlayerPartyCount != 0;
+}
+
+u8 TaichungStarterTryGrant(u16 species)
+{
+    if (!IsStarterSpecies(species) || gMain.inBattle
+        || gSaveBlock1Ptr == NULL || gSaveBlock2Ptr == NULL)
+        return TAICHUNG_STARTER_RESULT_INVALID;
+    if (TaichungStarterHasPartner())
+        return TAICHUNG_STARTER_RESULT_ALREADY;
+    if (!TaichungTeamSetSlot(0, species))
+        return TAICHUNG_STARTER_RESULT_INVALID;
+
+    // Commit the existing marker only after the real native party write.
+    // Supplies, story flags, migration and the plaza transition are caller-owned.
+    gSaveBlock1Ptr->vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = species;
+    return TAICHUNG_STARTER_RESULT_GRANTED;
+}
+
+void TaichungStarter_ScriptHasPartner(void)
+{
+    gSpecialVar_Result = TaichungStarterHasPartner();
+}
+
+void TaichungStarter_ScriptGrant(void)
+{
+    gSpecialVar_Result = TaichungStarterTryGrant(gSpecialVar_0x8004);
+}
diff --git a/src/taichung_starter_menu.c b/src/taichung_starter_menu.c
new file mode 100644
index 0000000..1728a06
--- /dev/null
+++ b/src/taichung_starter_menu.c
@@ -0,0 +1,291 @@
+#include "global.h"
+#include "gflib.h"
+#include "main.h"
+#include "menu.h"
+#include "task.h"
+#include "scanline_effect.h"
+#include "new_menu_helpers.h"
+#include "overworld.h"
+#include "event_data.h"
+#include "data.h"
+#include "pokemon_icon.h"
+#include "trainer_pokemon_sprites.h"
+#include "taichung_language.h"
+#include "taichung_starter_menu.h"
+#include "taichung_team_presets.h"
+#include "constants/species.h"
+#include "constants/songs.h"
+
+#define STARTER_COUNT 4
+#define PORTRAIT_NONE 0xFFFF
+#define PORTRAIT_PALETTE 8
+
+static EWRAM_DATA MainCallback sReturnCallback = NULL;
+static EWRAM_DATA u16 sPortrait = PORTRAIT_NONE;
+static EWRAM_DATA u8 sIcons[STARTER_COUNT] = {};
+static EWRAM_DATA u8 sSelected = 0;
+static EWRAM_DATA bool8 sConfirm = FALSE;
+
+static void CB2_InitStarterMenu(void);
+static void CB2_StarterMenu(void);
+static void Task_StarterMenuInput(u8 taskId);
+
+static const u16 sSpecies[STARTER_COUNT] = {
+    SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU
+};
+static const u8 sCharmanderZh[] = _("小火龍");
+static const u8 sBulbasaurZh[] = _("妙蛙種子");
+static const u8 sSquirtleZh[] = _("傑尼龜");
+static const u8 sPikachuZh[] = _("皮卡丘");
+static const u8 *const sNamesZh[STARTER_COUNT] = {
+    sCharmanderZh, sBulbasaurZh, sSquirtleZh, sPikachuZh
+};
+
+static const u8 sTitleEn[] = _("CHOOSE YOUR PARTNER");
+static const u8 sTitleZh[] = _("選擇你的夥伴");
+static const u8 sConfirmTitleEn[] = _("TAKE THIS PARTNER?");
+static const u8 sConfirmTitleZh[] = _("就選這位夥伴嗎？");
+static const u8 sBrowseHelpEn[] = _("Choose your first city companion.");
+static const u8 sBrowseHelpZh[] = _("選一位夥伴，一起探索臺中。");
+static const u8 sBrowseControlsEn[] = _("D-pad: switch     A: choose");
+static const u8 sBrowseControlsZh[] = _("方向鍵選擇    A確認");
+static const u8 sConfirmHelpEn[] = _("Your adventure starts together!");
+static const u8 sConfirmHelpZh[] = _("和這位夥伴一起出發吧！");
+static const u8 sConfirmControlsEn[] = _("A: confirm     B: keep choosing");
+static const u8 sConfirmControlsZh[] = _("A確認    B繼續選擇");
+static const u8 sCursor[] = _(">");
+static const u8 sLv[] = _("Lv");
+static const u8 sFireEn[] = _("FIRE");
+static const u8 sFireZh[] = _("火");
+static const u8 sGrassEn[] = _("GRASS/POISON");
+static const u8 sGrassZh[] = _("草/毒");
+static const u8 sWaterEn[] = _("WATER");
+static const u8 sWaterZh[] = _("水");
+static const u8 sElectricEn[] = _("ELECTRIC");
+static const u8 sElectricZh[] = _("電");
+static const u8 *const sTypes[STARTER_COUNT][2] = {
+    {sFireEn, sFireZh}, {sGrassEn, sGrassZh},
+    {sWaterEn, sWaterZh}, {sElectricEn, sElectricZh}
+};
+
+static const u16 sPalette[] = {
+    RGB(0, 0, 0), RGB(31, 31, 30), RGB(4, 8, 13), RGB(15, 19, 22),
+    RGB(6, 14, 24), RGB(26, 29, 31), RGB(12, 21, 28), RGB(16, 23, 29),
+    RGB(28, 8, 7), RGB(29, 30, 31), RGB(31, 31, 31), RGB(31, 31, 31),
+    RGB(31, 31, 31), RGB(31, 31, 31), RGB(31, 31, 31), RGB(31, 31, 31)
+};
+static const u8 sHeaderColors[] = {4, 1, 4};
+static const u8 sTextColors[] = {1, 2, 1};
+static const u8 sSelectedColors[] = {5, 4, 5};
+static const u8 sPanelColors[] = {5, 2, 5};
+static const u8 sMutedColors[] = {5, 3, 5};
+static const struct BgTemplate sBgTemplates[] = {
+    {.bg = 0, .charBaseIndex = 0, .mapBaseIndex = 31, .screenSize = 0, .paletteMode = 0, .priority = 1, .baseTile = 0}
+};
+static const struct WindowTemplate sWindowTemplates[] = {
+    {.bg = 0, .tilemapLeft = 0, .tilemapTop = 0, .width = 30, .height = 20, .paletteNum = 0, .baseBlock = 0},
+    DUMMY_WIN_TEMPLATE
+};
+
+static void Print(u8 x, u8 y, const u8 *colors, const u8 *text)
+{
+    AddTextPrinterParameterized3(0, FONT_SMALL, x, y, colors, -1, text);
+}
+
+static void DrawPanel(u16 x, u16 y, u16 width, u16 height)
+{
+    FillWindowPixelRect(0, 7, x, y, width, height);
+    FillWindowPixelRect(0, 5, x + 1, y + 1, width - 2, height - 2);
+}
+
+static void DrawStarterMenu(void)
+{
+    u8 option;
+    u8 y;
+    u8 level[8];
+    const u8 *name;
+
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    FillWindowPixelRect(0, 4, 0, 0, 240, 26);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 10, 5, sHeaderColors, -1,
+        sConfirm ? TaichungText(sConfirmTitleEn, sConfirmTitleZh) : TaichungText(sTitleEn, sTitleZh));
+
+    DrawPanel(8, 33, 88, 89);
+    StringCopy(level, sLv);
+    ConvertIntToDecimalStringN(level + 2, TAICHUNG_TEAM_LEVEL, STR_CONV_MODE_LEFT_ALIGN, 2);
+    Print(14, 35, sMutedColors, level);
+    name = TaichungText(gSpeciesNames[sSpecies[sSelected]], sNamesZh[sSelected]);
+    if (sPortrait == PORTRAIT_NONE)
+        Print(14, 68, sPanelColors, name);
+    Print(14, 107, sPanelColors, TaichungText(sTypes[sSelected][0], sTypes[sSelected][1]));
+
+    for (option = 0; option < STARTER_COUNT; option++)
+    {
+        y = 34 + option * 22;
+        if (option == sSelected)
+        {
+            DrawPanel(101, y, 131, 22);
+            Print(105, y + 4, sSelectedColors, sCursor);
+        }
+        name = TaichungText(gSpeciesNames[sSpecies[option]], sNamesZh[option]);
+        Print(145, y + 4, option == sSelected ? sSelectedColors : sTextColors, name);
+    }
+
+    DrawPanel(8, 127, 224, 29);
+    Print(14, 128, sPanelColors,
+        sConfirm ? TaichungText(sConfirmHelpEn, sConfirmHelpZh) : TaichungText(sBrowseHelpEn, sBrowseHelpZh));
+    Print(14, 142, sMutedColors,
+        sConfirm ? TaichungText(sConfirmControlsEn, sConfirmControlsZh) : TaichungText(sBrowseControlsEn, sBrowseControlsZh));
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+}
+
+static void LoadSelectedPortrait(void)
+{
+    if (sPortrait != PORTRAIT_NONE)
+        FreeAndDestroyMonPicSprite(sPortrait);
+    sPortrait = CreateMonPicSprite_HandleDeoxys(sSpecies[sSelected], 0, 0, TRUE, 52, 74, PORTRAIT_PALETTE, TAG_NONE);
+    if (sPortrait != PORTRAIT_NONE)
+        gSprites[sPortrait].oam.priority = 0;
+}
+
+static void FreeStarterSprites(void)
+{
+    u8 option;
+    if (sPortrait != PORTRAIT_NONE)
+    {
+        FreeAndDestroyMonPicSprite(sPortrait);
+        sPortrait = PORTRAIT_NONE;
+    }
+    for (option = 0; option < STARTER_COUNT; option++)
+    {
+        if (sIcons[option] < MAX_SPRITES)
+            DestroyMonIcon(&gSprites[sIcons[option]]);
+        sIcons[option] = SPRITE_NONE;
+    }
+    FreeMonIconPalettes();
+}
+
+void ShowTaichungStarterMenu(MainCallback returnCallback)
+{
+    u8 option;
+    sReturnCallback = returnCallback;
+    sPortrait = PORTRAIT_NONE;
+    for (option = 0; option < STARTER_COUNT; option++)
+        sIcons[option] = SPRITE_NONE;
+    sSelected = 0;
+    sConfirm = FALSE;
+    gSpecialVar_Result = SPECIES_NONE;
+    SetMainCallback2(CB2_InitStarterMenu);
+}
+
+void TaichungStarter_ScriptOpenMenu(void)
+{
+    CleanupOverworldWindowsAndTilemaps();
+    ShowTaichungStarterMenu(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+}
+
+static void VBlankCB_StarterMenu(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+static void CB2_InitStarterMenu(void)
+{
+    u8 option;
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    if (!InitWindows(sWindowTemplates))
+    {
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    DeactivateAllTextPrinters();
+    LoadPalette(sPalette, 0, sizeof(sPalette));
+    LoadMonIconPalettes();
+    for (option = 0; option < STARTER_COUNT; option++)
+    {
+        sIcons[option] = CreateMonIcon(sSpecies[option], SpriteCB_MonIcon, 125, 45 + option * 22, 0, 0, FALSE);
+        if (sIcons[option] < MAX_SPRITES)
+            gSprites[sIcons[option]].oam.priority = 0;
+    }
+    LoadSelectedPortrait();
+    DrawStarterMenu();
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_BG0_ON | DISPCNT_OBJ_ON | DISPCNT_OBJ_1D_MAP);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    CreateTask(Task_StarterMenuInput, 0);
+    SetVBlankCallback(VBlankCB_StarterMenu);
+    SetMainCallback2(CB2_StarterMenu);
+}
+
+static void CB2_StarterMenu(void)
+{
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void Task_StarterMenuInput(u8 taskId)
+{
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0])
+    {
+        gSpecialVar_Result = sSpecies[sSelected];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeStarterSprites();
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    if (sConfirm)
+    {
+        if (JOY_NEW(B_BUTTON))
+            sConfirm = FALSE;
+        else if (JOY_NEW(A_BUTTON))
+        {
+            PlaySE(SE_SELECT);
+            gTasks[taskId].data[0] = 1;
+            BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+            return;
+        }
+        else
+            return;
+    }
+    else if (JOY_NEW(DPAD_LEFT | DPAD_UP))
+    {
+        sSelected = (sSelected + STARTER_COUNT - 1) % STARTER_COUNT;
+        LoadSelectedPortrait();
+    }
+    else if (JOY_NEW(DPAD_RIGHT | DPAD_DOWN))
+    {
+        sSelected = (sSelected + 1) % STARTER_COUNT;
+        LoadSelectedPortrait();
+    }
+    else if (JOY_NEW(A_BUTTON))
+        sConfirm = TRUE;
+    else
+        return; // The first partner remains mandatory; B never exits empty.
+    PlaySE(SE_SELECT);
+    DrawStarterMenu();
+}
diff --git a/src/taichung_team.c b/src/taichung_team.c
new file mode 100644
index 0000000..b19520c
--- /dev/null
+++ b/src/taichung_team.c
@@ -0,0 +1,90 @@
+#include "global.h"
+#include "pokemon.h"
+#include "pokedex.h"
+#include "taichung_team.h"
+#include "taichung_team_presets.h"
+#include "script_pokemon_util.h"
+#include "constants/items.h"
+#include "constants/maps.h"
+
+bool8 TaichungTeamNoGrindActive(void)
+{
+    // All three city districts and their ten halls use this dedicated group.
+    // Kanto, link play and the original tutorials retain their own rules.
+    return gSaveBlock1Ptr != NULL
+        && gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+}
+
+void TaichungTeamPrepareMon(struct Pokemon *mon)
+{
+    u16 species;
+    u32 status = 0;
+    u16 hp;
+
+    if (mon == NULL)
+        return;
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    if (!TaichungTeamSpeciesAllowed(species) || GetMonData(mon, MON_DATA_IS_EGG))
+        return;
+    // Level is derived from experience. Preserve identity, IVs/EVs, nickname,
+    // ownership and held items when updating an existing saved partner.
+    SetMonData(mon, MON_DATA_EXP, &gExperienceTables[gSpeciesInfo[species].growthRate][TAICHUNG_TEAM_LEVEL]);
+    CalculateMonStats(mon);
+    TaichungTeamApplyPreset(mon);
+    hp = GetMonData(mon, MON_DATA_MAX_HP);
+    // Explicitly set HP after calculation, including downward normalization:
+    // the original engine's max-HP delta can underflow on older high-level saves.
+    SetMonData(mon, MON_DATA_HP, &hp);
+    SetMonData(mon, MON_DATA_STATUS, &status);
+}
+
+void TaichungTeamPrepareParty(void)
+{
+    u8 slot;
+    CalculatePlayerPartyCount();
+    for (slot = 0; slot < gPlayerPartyCount; slot++)
+        TaichungTeamPrepareMon(&gPlayerParty[slot]);
+    HealPlayerParty();
+}
+
+void TaichungTeamEnsurePartyLevel(void)
+{
+    u8 slot;
+    if (!TaichungTeamNoGrindActive())
+        return;
+    CalculatePlayerPartyCount();
+    for (slot = 0; slot < gPlayerPartyCount; slot++)
+    {
+        // Upgrade an older party once. Ordinary exploration battles do not
+        // refill an already-normalized partner's HP, status or PP.
+        if (GetMonData(&gPlayerParty[slot], MON_DATA_LEVEL) != TAICHUNG_TEAM_LEVEL)
+            TaichungTeamPrepareMon(&gPlayerParty[slot]);
+    }
+}
+
+bool8 TaichungTeamSetSlot(u8 slot, u16 species)
+{
+    struct Pokemon replacement;
+    u16 heldItem = 0;
+    u8 mail = MAIL_NONE;
+    u8 count = CalculatePlayerPartyCount();
+
+    // Append at the first empty slot, or replace an existing one. Never make
+    // gaps, send a choice to the PC, or remove the player's last partner.
+    if (gMain.inBattle || slot >= PARTY_SIZE || slot > count || !TaichungTeamSpeciesAllowed(species))
+        return FALSE;
+    if (slot < count)
+    {
+        heldItem = GetMonData(&gPlayerParty[slot], MON_DATA_HELD_ITEM);
+        mail = GetMonData(&gPlayerParty[slot], MON_DATA_MAIL);
+    }
+    CreateMon(&replacement, species, TAICHUNG_TEAM_LEVEL, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+    TaichungTeamApplyPreset(&replacement);
+    SetMonData(&replacement, MON_DATA_HELD_ITEM, &heldItem);
+    SetMonData(&replacement, MON_DATA_MAIL, &mail);
+    gPlayerParty[slot] = replacement;
+    CalculatePlayerPartyCount();
+    GetSetPokedexFlag(species, FLAG_SET_SEEN);
+    GetSetPokedexFlag(species, FLAG_SET_CAUGHT);
+    return TRUE;
+}
