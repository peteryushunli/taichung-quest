+    Print(8, 22, sMutedColors, TaichungText(sSlotHelpEn, sSlotHelpZh));
+    for (slot = 0; slot < PARTY_SIZE; slot++)
+    {
+        u8 y = 40 + slot * 16;
+        if (slot == sSlot)
+            Print(6, y, sSelectedColors, sCursor);
+        PrintNumber(18, y, slot + 1, 1);
+        if (slot < count)
+        {
+            species = GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES);
+            Print(34, y, sTextColors, gSpeciesNames[species]);
+            StringCopy(text, sLv);
+            ConvertIntToDecimalStringN(text + 2, GetMonData(&gPlayerParty[slot], MON_DATA_LEVEL), STR_CONV_MODE_LEFT_ALIGN, 3);
+            Print(166, y, sMutedColors, text);
+        }
+        else
+            Print(34, y, sMutedColors, slot == count ? TaichungText(sEmptyEn, sEmptyZh) : sLocked);
+    }
