diff --git a/Makefile b/Makefile
index 8b454db..c2cf470 100644
--- a/Makefile
+++ b/Makefile
@@ -192,6 +192,9 @@ MID_OBJS := $(patsubst $(MID_SUBDIR)/%.mid,$(MID_BUILDDIR)/%.o,$(MID_SRCS))
 OBJS     := $(C_OBJS) $(C_ASM_OBJS) $(ASM_OBJS) $(DATA_ASM_OBJS) $(SONG_OBJS) $(MID_OBJS)
 OBJS_REL := $(patsubst $(OBJ_DIR)/%,%,$(OBJS))
 
+# Encoded Chinese glyph IDs depend on the generated character map.
+$(C_OBJS) $(C_ASM_OBJS) $(DATA_ASM_OBJS): charmap.txt
+
 SUBDIRS  := $(sort $(dir $(OBJS)))
 $(shell mkdir -p $(SUBDIRS))
 
