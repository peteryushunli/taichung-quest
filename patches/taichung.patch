diff --git a/data/taichung/landmarks/calligraphy-greenway/check_candidate.py b/data/taichung/landmarks/calligraphy-greenway/check_candidate.py
new file mode 100644
index 0000000..e7a4472
--- /dev/null
+++ b/data/taichung/landmarks/calligraphy-greenway/check_candidate.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Independent saved-format checks for the frozen CMP candidate; no install.
+
+All reconstruction outputs go to a temporary directory. This checker writes
+only format-validation.json; the Root-owned encoder/candidate stay unchanged.
+"""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def read_palette(raw):
+    lines = raw.decode().splitlines()
+    assert lines[:3] == ["JASC-PAL", "0100", "16"]
+    result = [tuple(map(int, row.split())) for row in lines[3:] if row.strip()]
+    assert len(result) == 16
+    return result
+
+
+def bgr555(colors):
+    return struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors))
+
+
+def check():
+    directory = HERE / "candidate"
+    manifest = json.loads((directory / "encode-manifest.json").read_text())
+    recipe, native_meta = manifest["recipe"], manifest["native"]
+    source = Path(manifest["sourceArtifact"])
+    palette_source = Path(recipe["sharedPaletteSource"])
+    review = Path(manifest["reviewArtifact"])
+    palette_meta = json.loads((HERE / "palette-candidate/manifest.json").read_text())
+    watched = [path for path in directory.iterdir() if path.is_file()] + [source, palette_source, review, HERE / "encode_candidate.py"]
+    before = {str(path): digest(path) for path in watched}
+    assert digest(source) == manifest["sourceSha256"]
+    width, height = recipe["logicalSize"]
+    assert (width, height) == (144, 160)
+    indexed = Image.open(directory / "candidate-indexed.png")
+    native = Image.open(directory / "candidate-native.png")
+    assert indexed.mode == "P" and indexed.size == (width, height) and indexed.info["transparency"] == 0
+    assert indexed.getextrema()[1] < 16
+    assert indexed.convert("RGBA").tobytes() == native.convert("RGBA").tobytes()
+    assert set(native.getchannel("A").get_flattened_data()) == {0, 255}
+    assert digest(directory / "candidate-native.png") == manifest["nativePngSha256"]
+    step = recipe["nativePixelClusterSize"]
+    assert step == 2 and all(indexed.getpixel((x, y)) == indexed.getpixel((x//step*step, y//step*step))
+                             for y in range(height) for x in range(width))
+    palette_raw = (directory / "08.pal").read_bytes()
+    assert palette_raw == palette_raw.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+    colors = read_palette(palette_raw)
+    assert colors == read_palette(palette_source.read_bytes())
+    assert indexed.getpalette()[:48] == [v for color in colors for v in color]
+    assert (directory / "08.gbapal").read_bytes() == bgr555(colors)
+    released_raw = subprocess.check_output(["git", "show", palette_meta["baselineCommit"]+":"+palette_meta["sourcePalette"]], cwd=GAME)
+    assert hashlib.sha256(released_raw).hexdigest() == palette_meta["sourcePaletteGitSha256"]
+    released = read_palette(released_raw)
+    fixed, spare = [0, 1, 2, 3, 4, 5, 6, 7, 13], [8, 9, 10, 11, 12, 14, 15]
+    changed = [index for index in range(16) if colors[index] != released[index]]
+    assert changed == spare and all(colors[index] == released[index] for index in fixed)
+    assert all(all(0 <= v <= 248 and v%8 == 0 for v in colors[index]) for index in spare)
+    # Released RGB8 values such as index0=(24,41,82) deliberately remain exact;
+    # BGR555 encoding truncates these to the same loaded native words.
+    release_words, candidate_words = struct.unpack("<16H", bgr555(released)), struct.unpack("<16H", bgr555(colors))
+    assert all(release_words[index] == candidate_words[index] for index in fixed)
+    raw = (directory / "tiles.4bpp").read_bytes()
+    graphics = [tuple(value for byte in raw[n:n+32] for value in (byte & 15, byte >> 4)) for n in range(0, len(raw), 32)]
+    assert len(graphics) == native_meta["unique8x8GraphicsFlipDeduplicated"] == 262
+    assert len(set(graphics)) == len(graphics)
+    words = struct.unpack("<360H", (directory / "foreground-tilemap-relative.bin").read_bytes())
+    assert all(word >> 12 == 8 and word & 1023 < len(graphics) for word in words)
+    for y in range(height):
+        for x in range(width):
+            word = words[y//8*18+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            assert graphics[word & 1023][sy*8+sx] == indexed.getpixel((x, y))
+    groups = [[words[(my*2+y)*18+mx*2+x] for y in range(2) for x in range(2)]
+              for my in range(10) for mx in range(9)]
+    assert groups == json.loads((directory / "foreground-metatiles-relative.json").read_text())
+    canonical_from_png = set()
+    for ty in range(20):
+        for tx in range(18):
+            variants = [tuple(indexed.getpixel((tx*8+(7-x if horizontal else x), ty*8+(7-y if vertical else y)))
+                              for y in range(8) for x in range(8)) for horizontal, vertical in ((False, False), (True, False), (False, True), (True, True))]
+            canonical_from_png.add(min(variants))
+    assert canonical_from_png == set(graphics)
+    assert Image.open(review).convert("RGBA").tobytes() == native.resize((576, 640), Image.Resampling.NEAREST).tobytes()
+    with tempfile.TemporaryDirectory(prefix="cmp-format-") as folder:
+        temp = Path(folder)
+        spec = importlib.util.spec_from_file_location("cmp_frozen_encoder", HERE / "encode_candidate.py")
+        encoder = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(encoder)
+        rebuilt = encoder.encode(source, temp / "candidate", temp / "review.png", recipe["alphaThreshold"], step,
+                                 (width, height), palette_source)
+        # reviewArtifact is the only location-dependent manifest field. Never
+        # point the rebuild at Root's actual saved review file merely to match it.
+        rebuilt["reviewArtifact"] = manifest["reviewArtifact"]
+        assert rebuilt == manifest
