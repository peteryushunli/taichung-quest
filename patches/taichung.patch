+void TaichungGymFormatCount(u8 *dest)
+{
+    ConvertIntToDecimalStringN(dest, TaichungGymGetCompletedCount(), STR_CONV_MODE_LEFT_ALIGN, 2);
+    StringAppend(dest, sTotal);
+}
+
+static void Print(u8 x, u8 y, const u8 *colors, const u8 *text)
+{
+    AddTextPrinterParameterized3(0, FONT_SMALL, x, y, colors, -1, text);
+}
+
+static void PrintCentered(u8 y, const u8 *colors, const u8 *text)
+{
+    u16 width = GetStringWidth(FONT_SMALL, text, 0);
+    Print(width < 224 ? (240 - width) / 2 : 8, y, colors, text);
+}
+
+static void DrawFrame(u8 x, u8 y, u8 width, u8 height, u8 border, u8 fill)
+{
+    FillWindowPixelRect(0, border, x, y, width, height);
+    FillWindowPixelRect(0, fill, x + 2, y + 2, width - 4, height - 4);
+}
+
+static void DrawCityPass(void)
+{
+    u8 gym, x, y;
+    u8 countText[12];
+    u8 number[4];
+    bool8 complete = TaichungGymIsComplete(sSelected);
+
+    FillWindowPixelBuffer(0, PIXEL_FILL(8));
+    FillWindowPixelRect(0, 4, 0, 0, 240, 24);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 3, sHeaderColors, -1, TaichungText(sTitleEn, sTitleZh));
+    TaichungGymFormatCount(countText);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 196, 3, sHeaderColors, -1, countText);
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        x = 8 + (gym % 5) * 46;
+        y = 27 + (gym / 5) * 43;
+        DrawFrame(x, y, 40, 37, gym == sSelected ? 6 : 7, 1);
+        ConvertIntToDecimalStringN(number, gym + 1, STR_CONV_MODE_LEFT_ALIGN, 2);
+        Print(x + 17, y + 22, sTextColors, number);
+        if (gym == sSelected)
+            Print(x + 4, y + 22, sTextColors, sCursor);
+        if (sBadgeSprites[gym] == MAX_SPRITES)
+            Print(x + 18, y + 4, sMutedColors, sMissingIcon);
+    }
+    // Each small-font line paints a 13px (Latin) or 14px (Chinese) cell, so the
+    // three 14px rows need 42px inside the 2px border: rows 113-154 of 112-155.
+    DrawFrame(5, 110, 230, 48, 7, 1);
+    Print(12, 113, sTextColors, TaichungBadgeGetName(sSelected));
+    Print(176, 113, sMutedColors, complete ? TaichungText(sEarnedEn, sEarnedZh) : TaichungText(sLockedEn, sLockedZh));
+    Print(12, 127, sMutedColors, TaichungBadgeGetLandmark(sSelected));
+    Print(12, 141, sTextColors, TaichungText(sFooterEn, sFooterZh));
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+}
+
+static void DrawBadgeAward(void)
+{
+    FillWindowPixelBuffer(0, PIXEL_FILL(8));
+    FillWindowPixelRect(0, 4, 0, 0, 240, 24);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 3, sHeaderColors, -1, TaichungText(sAwardTitleEn, sAwardTitleZh));
+    DrawFrame(8, 28, 224, 82, 6, 4);
+    if (sBadgeSprites[0] == MAX_SPRITES)
+        PrintCentered(55, sStageColors, TaichungText(sEarnedEn, sEarnedZh));
+    PrintCentered(86, sStageColors, TaichungBadgeGetName(sSelected));
+    DrawFrame(5, 116, 230, 41, 7, 1);
+    Print(13, 118, sTextColors, TaichungText(sAwardTextEn, sAwardTextZh));
+    Print(13, 133, sTextColors, TaichungBadgeGetName(sSelected));
+    Print(218, 139, sTextColors, sAdvance);
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+}
+
+void ShowTaichungCityPass(MainCallback returnCallback)
+{
+    sReturnCallback = returnCallback;
+    sSelected = 0;
+    sAward = FALSE;
+    SetMainCallback2(CB2_InitCityPass);
+}
+
+void ShowTaichungBadgeAward(u16 gymId, MainCallback returnCallback)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT)
+    {
+        SetMainCallback2(returnCallback);
+        return;
+    }
+    sReturnCallback = returnCallback;
+    sSelected = gymId;
+    sAward = TRUE;
+    SetMainCallback2(CB2_InitCityPass);
+}
+
+static void FreeBadgeSprites(void)
+{
+    u8 gym;
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        if (sBadgeSprites[gym] != MAX_SPRITES)
+            DestroySprite(&gSprites[sBadgeSprites[gym]]);
+        sBadgeSprites[gym] = MAX_SPRITES;
+    }
+    TaichungBadgeFreePalettes();
+}
+
+static void CB2_InitCityPass(void)
+{
+    u8 gym;
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+        sBadgeSprites[gym] = MAX_SPRITES;
+    if (!InitWindows(sWindowTemplates))
+    {
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    DeactivateAllTextPrinters();
+    LoadPalette(sPalette, 0, sizeof(sPalette));
+    if (TaichungBadgeLoadPalettes())
+    {
+        if (sAward)
+            sBadgeSprites[0] = TaichungBadgeCreateSprite(sSelected, TRUE, TRUE, 120, 60);
+        else
+            for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+                sBadgeSprites[gym] = TaichungBadgeCreateSprite(gym, FALSE, TaichungGymIsComplete(gym), 28 + (gym % 5) * 46, 40 + (gym / 5) * 43);
+    }
+    if (sAward)
+        DrawBadgeAward();
+    else
+        DrawCityPass();
+    // Stage the immutable sprite frames and OAM before exposing the scene.
+    AnimateSprites();
+    BuildOamBuffer();
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_BG0_ON | DISPCNT_OBJ_ON | DISPCNT_OBJ_1D_MAP);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    CreateTask(Task_CityPassInput, 0);
+    if (sAward)
+        PlayFanfare(MUS_OBTAIN_BADGE);
+    SetVBlankCallback(VBlankCB_CityPass);
+    SetMainCallback2(CB2_CityPass);
+}
+
+static void CB2_CityPass(void)
+{
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void CB2_ReopenCityPass(void)
+{
+    sAward = FALSE;
+    SetMainCallback2(CB2_InitCityPass);
+}
+
+static bool8 MoveSelection(void)
+{
+    u8 old = sSelected;
+    if (JOY_NEW(DPAD_LEFT))
+        sSelected = (sSelected / 5) * 5 + (sSelected + 4) % 5;
+    else if (JOY_NEW(DPAD_RIGHT))
+        sSelected = (sSelected / 5) * 5 + (sSelected + 1) % 5;
+    else if (JOY_NEW(DPAD_UP | DPAD_DOWN))
+        sSelected = (sSelected + 5) % TAICHUNG_GYM_COUNT;
+    return old != sSelected;
+}
+
+static void Task_CityPassInput(u8 taskId)
+{
+    u8 choice;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] == 0)
+    {
+        if (sAward)
+        {
+            // A held battle-advance button cannot dismiss a newly earned badge.
+            if (!(gMain.heldKeys & (A_BUTTON | B_BUTTON | START_BUTTON)))
+                gTasks[taskId].data[1] = TRUE;
+            if (!gTasks[taskId].data[1] || !IsFanfareTaskInactive())
+                return;
+            if (!JOY_NEW(A_BUTTON | B_BUTTON | START_BUTTON))
+                return;
+            gTasks[taskId].data[0] = 2;
+        }
+        else if (JOY_NEW(A_BUTTON))
+            gTasks[taskId].data[0] = 1;
+        else if (JOY_NEW(B_BUTTON | START_BUTTON))
+            gTasks[taskId].data[0] = 2;
+        else
+        {
+            if (MoveSelection())
+            {
+                PlaySE(SE_SELECT);
+                DrawCityPass();
+            }
+            return;
+        }
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+    }
+    else
+    {
+        choice = gTasks[taskId].data[0];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeBadgeSprites();
+        FreeAllWindowBuffers();
+        if (choice == 1)
+            ShowPlayerTrainerCard(CB2_ReopenCityPass);
+        else
+            SetMainCallback2(sReturnCallback);
+    }
+}
diff --git a/src/taichung_exploration.c b/src/taichung_exploration.c
new file mode 100644
index 0000000..e396c0f
--- /dev/null
+++ b/src/taichung_exploration.c
@@ -0,0 +1,66 @@
+#include "global.h"
+#include "event_data.h"
+#include "taichung_exploration.h"
+#include "constants/vars.h"
+
+static u16 GetPreferenceVar(u16 setting)
+{
+    if (setting == TAICHUNG_EXPLORATION_WILD)
+        return TAICHUNG_EXPLORATION_WILD_VAR;
+    if (setting == TAICHUNG_EXPLORATION_SIGHT)
+        return TAICHUNG_EXPLORATION_SIGHT_VAR;
+    return 0;
+}
+
+u8 TaichungExplorationGetMode(u16 setting)
+{
+    u16 variable = GetPreferenceVar(setting);
+    // VarGet replays quest-log values into the save during recap playback.
+    // Preferences describe the current player, rather than a recorded scene.
+    u16 mode = variable && gSaveBlock1Ptr ? gSaveBlock1Ptr->vars[variable - VARS_START] : TAICHUNG_EXPLORATION_UNSET;
+    if (mode < TAICHUNG_EXPLORATION_OFF || mode > TAICHUNG_EXPLORATION_NORMAL)
+        return TAICHUNG_EXPLORATION_NORMAL;
+    return mode;
+}
+
+bool8 TaichungExplorationSetMode(u16 setting, u16 mode)
+{
+    u16 variable = GetPreferenceVar(setting);
+    if (!variable || mode < TAICHUNG_EXPLORATION_OFF || mode > TAICHUNG_EXPLORATION_NORMAL)
+        return FALSE;
+    return VarSet(variable, mode);
+}
+
+bool8 TaichungExplorationAllowsAutomaticWild(bool8 temporarilyDisabled)
+{
+    return !temporarilyDisabled && TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD) != TAICHUNG_EXPLORATION_OFF;
+}
+
+u32 TaichungExplorationAdjustAutomaticWildRate(u32 rate)
+{
+    u8 mode = TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD);
+    if (mode == TAICHUNG_EXPLORATION_OFF)
+        return 0;
+    if (mode == TAICHUNG_EXPLORATION_LOW && rate > 0)
+    {
+        rate /= 4;
+        if (rate == 0)
+            rate = 1;
+    }
+    return rate;
+}
+
+bool8 TaichungExplorationAllowsTrainerSight(void)
+{
+    return TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT) != TAICHUNG_EXPLORATION_OFF;
+}
+
+u8 TaichungExplorationGetTrainerSightRange(u8 configuredRange)
+{
+    u8 mode = TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT);
+    if (mode == TAICHUNG_EXPLORATION_OFF)
+        return 0;
+    if (mode == TAICHUNG_EXPLORATION_LOW && configuredRange > 1)
+        return 1;
+    return configuredRange;
+}
diff --git a/src/taichung_exploration_menu.c b/src/taichung_exploration_menu.c
new file mode 100644
index 0000000..eb6392b
--- /dev/null
+++ b/src/taichung_exploration_menu.c
@@ -0,0 +1,271 @@
+#include "global.h"
+#include "gflib.h"
+#include "main.h"
+#include "menu.h"
+#include "task.h"
+#include "scanline_effect.h"
+#include "new_menu_helpers.h"
+#include "overworld.h"
+#include "option_menu.h"
+#include "taichung_exploration.h"
+#include "taichung_exploration_menu.h"
+#include "taichung_language.h"
+#include "event_data.h"
+#include "constants/songs.h"
+
+static EWRAM_DATA MainCallback sReturnCallback = NULL;
+static EWRAM_DATA u8 sModes[TAICHUNG_EXPLORATION_SETTING_COUNT] = {};
+static EWRAM_DATA u8 sCursor = 0;
+static EWRAM_DATA bool8 sStartup = FALSE;
+
+static void CB2_InitExplorationMenu(void);
+static void CB2_ExplorationMenu(void);
+static void CB2_ReopenExplorationMenu(void);
+static void Task_ExplorationMenuInput(u8 taskId);
+
+// Rows, top to bottom: the game's language first, then the two encounter
+// settings, then CONTINUE and (outside the opening) the native options.
+enum
+{
+    ROW_LANGUAGE,
+    ROW_WILD,
+    ROW_SIGHT,
+    ROW_CONTINUE,
+    ROW_OPTIONS,
+};
+#define ROW_FIRST_SETTING ROW_WILD
+
+static const u8 sTitleEn[] = _("SETTINGS");
+static const u8 sTitleZh[] = _("設定");
+static const u8 sSubtitleEn[] = _("LANGUAGE AND ENCOUNTERS");
+static const u8 sSubtitleZh[] = _("語言與遭遇");
+static const u8 sLanguageEn[] = _("LANGUAGE");
+static const u8 sLanguageZh[] = _("語言");
+static const u8 sEnglish[] = _("English");
+static const u8 sChinese[] = _("繁體中文");
+static const u8 sWildEn[] = _("WILD POKéMON ENCOUNTERS");
+static const u8 sWildZh[] = _("野生寶可夢遭遇");
+static const u8 sSightEn[] = _("TRAINER ENCOUNTERS");
+static const u8 sSightZh[] = _("訓練家遭遇");
+static const u8 sOffEn[] = _("Off");
+static const u8 sOffZh[] = _("關閉");
+static const u8 sLowEn[] = _("Low");
+static const u8 sLowZh[] = _("減少");
+static const u8 sNormalEn[] = _("Normal");
+static const u8 sNormalZh[] = _("正常");
+static const u8 sContinueEn[] = _("CONTINUE (A)");
+static const u8 sContinueZh[] = _("繼續 (A)");
+static const u8 sOptionsEn[] = _("GAME OPTIONS");
+static const u8 sOptionsZh[] = _("遊戲設定");
+static const u8 sCursorText[] = _(">");
+static const u8 sFooterEn[] = _("Up/Down: row   Left/Right: change   B: back");
+static const u8 sFooterZh[] = _("上下選列 左右調整 B返回");
+static const u8 sLanguageHelpEn[] = _("The language for all game text.\nChange it any time in OPTION.");
+static const u8 sLanguageHelpZh[] = _("遊戲文字的語言，\n隨時可在設定更改。");
+static const u8 sWildHelpEn[] = _("Wild POKéMON that jump out of grass\nand water. Low: rarer. Off: never.");
+static const u8 sWildHelpZh[] = _("草叢與水面的野生寶可夢。\n減少：少見。關閉：不出現。");
+static const u8 sSightHelpEn[] = _("Trainers who battle you on sight.\nLow: only up close. Off: never.");
+static const u8 sSightHelpZh[] = _("看到你就挑戰的訓練家。\n減少：要靠近。關閉：不挑戰。");
+static const u8 sContinueHelpEn[] = _("Preferences are saved with your game.\nYou can change them again in OPTION.");
+static const u8 sContinueHelpZh[] = _("偏好隨存檔保存，\n可在設定選單再改。");
+static const u8 sOptionsHelpEn[] = _("Text speed, battle style, sound,\nand other native game options.");
+static const u8 sOptionsHelpZh[] = _("文字速度、對戰方式、\n音效等設定。");
+
+static const u8 *const sModeNames[][2] = {
+    {sOffEn, sOffZh}, {sLowEn, sLowZh}, {sNormalEn, sNormalZh}
+};
+static const u8 *const sSettingNames[][2] = {
+    {sWildEn, sWildZh}, {sSightEn, sSightZh}
+};
+static const u8 *const sHelp[][2] = {
+    {sLanguageHelpEn, sLanguageHelpZh},
+    {sWildHelpEn, sWildHelpZh}, {sSightHelpEn, sSightHelpZh},
+    {sContinueHelpEn, sContinueHelpZh}, {sOptionsHelpEn, sOptionsHelpZh}
+};
+static const u8 sRowY[] = {38, 54, 70, 88, 102};
+// Choice columns: Off/Low/Normal, and English/Chinese on the language row.
+static const u8 sModeX[] = {130, 162, 196};
+static const u8 sLanguageX[] = {130, 176};
+static const u16 sPalette[] = {
+    RGB(31, 30, 27), RGB(31, 30, 27), RGB(3, 10, 8), RGB(19, 22, 18),
+    RGB(5, 19, 10), RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27),
+    RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27),
+    RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27)
+};
+static const u8 sTextColors[] = {1, 2, 1};
+static const u8 sSelectedColors[] = {1, 4, 1};
+static const u8 sMutedColors[] = {1, 3, 1};
+static const struct BgTemplate sBgTemplates[] = {
+    {.bg = 0, .charBaseIndex = 0, .mapBaseIndex = 31, .screenSize = 0, .paletteMode = 0, .priority = 0, .baseTile = 0}
+};
+static const struct WindowTemplate sWindowTemplates[] = {
+    {.bg = 0, .tilemapLeft = 0, .tilemapTop = 0, .width = 30, .height = 20, .paletteNum = 0, .baseBlock = 0},
+    DUMMY_WIN_TEMPLATE
+};
+
+static u8 CurrentLanguage(void)
+{
+    return TaichungIsChinese() ? TAICHUNG_LANGUAGE_ZH : TAICHUNG_LANGUAGE_EN;
+}
+
+static void DrawExplorationMenu(void)
+{
+    u8 row, mode;
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 22, sMutedColors, -1, TaichungText(sSubtitleEn, sSubtitleZh));
+    // Each language is named in its own script, whichever one is active.
+    AddTextPrinterParameterized3(0, FONT_SMALL, 12, sRowY[ROW_LANGUAGE], sTextColors, -1, TaichungText(sLanguageEn, sLanguageZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, sLanguageX[0], sRowY[ROW_LANGUAGE], CurrentLanguage() == TAICHUNG_LANGUAGE_EN ? sSelectedColors : sMutedColors, -1, sEnglish);
+    AddTextPrinterParameterized3(0, FONT_SMALL, sLanguageX[1], sRowY[ROW_LANGUAGE], CurrentLanguage() == TAICHUNG_LANGUAGE_ZH ? sSelectedColors : sMutedColors, -1, sChinese);
+    for (row = 0; row < TAICHUNG_EXPLORATION_SETTING_COUNT; row++)
+    {
+        AddTextPrinterParameterized3(0, FONT_SMALL, 12, sRowY[ROW_FIRST_SETTING + row], sTextColors, -1, TaichungText(sSettingNames[row][0], sSettingNames[row][1]));
+        for (mode = TAICHUNG_EXPLORATION_OFF; mode <= TAICHUNG_EXPLORATION_NORMAL; mode++)
+            AddTextPrinterParameterized3(0, FONT_SMALL, sModeX[mode - 1], sRowY[ROW_FIRST_SETTING + row], sModes[row] == mode ? sSelectedColors : sMutedColors, -1, TaichungText(sModeNames[mode - 1][0], sModeNames[mode - 1][1]));
+    }
+    AddTextPrinterParameterized3(0, FONT_SMALL, 12, sRowY[ROW_CONTINUE], sTextColors, -1, TaichungText(sContinueEn, sContinueZh));
+    if (!sStartup)
+        AddTextPrinterParameterized3(0, FONT_SMALL, 12, sRowY[ROW_OPTIONS], sTextColors, -1, TaichungText(sOptionsEn, sOptionsZh));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 4, sRowY[sCursor], sSelectedColors, -1, sCursorText);
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 116, sTextColors, -1, TaichungText(sHelp[sCursor][0], sHelp[sCursor][1]));
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 145, sMutedColors, -1, TaichungText(sFooterEn, sFooterZh));
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+}
+
+void ShowTaichungExplorationMenu(MainCallback returnCallback, bool8 startup)
+{
+    u8 setting;
+    u16 language;
+    sReturnCallback = returnCallback;
+    sStartup = startup;
+    sCursor = ROW_CONTINUE; // A single A accepts the shown language and pair.
+    // A new game reaches this screen before any language is stored: start
+    // from English so the opening never waits on a separate language prompt.
+    language = gSaveBlock1Ptr->vars[TAICHUNG_LANGUAGE_VAR - VARS_START];
+    if (language != TAICHUNG_LANGUAGE_EN && language != TAICHUNG_LANGUAGE_ZH)
+        VarSet(TAICHUNG_LANGUAGE_VAR, TAICHUNG_LANGUAGE_EN);
+    for (setting = 0; setting < TAICHUNG_EXPLORATION_SETTING_COUNT; setting++)
+        sModes[setting] = TaichungExplorationGetMode(setting);
+    SetMainCallback2(CB2_InitExplorationMenu);
+}
+
+void TaichungExploration_ScriptOpenStartup(void)
+{
+    CleanupOverworldWindowsAndTilemaps();
+    ShowTaichungExplorationMenu(CB2_ReturnToFieldContinueScriptPlayMapMusic, TRUE);
+}
+
+static void VBlankCB_ExplorationMenu(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+static void CB2_InitExplorationMenu(void)
+{
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    if (!InitWindows(sWindowTemplates))
+    {
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    DeactivateAllTextPrinters();
+    LoadPalette(sPalette, 0, sizeof(sPalette));
+    DrawExplorationMenu();
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_BG0_ON);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    CreateTask(Task_ExplorationMenuInput, 0);
+    SetVBlankCallback(VBlankCB_ExplorationMenu);
+    SetMainCallback2(CB2_ExplorationMenu);
+}
+
+static void CB2_ExplorationMenu(void)
+{
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void CB2_ReopenExplorationMenu(void)
+{
+    ShowTaichungExplorationMenu(sReturnCallback, FALSE);
+}
+
+static void Task_ExplorationMenuInput(u8 taskId)
+{
+    u8 rows = sStartup ? ROW_OPTIONS : ROW_OPTIONS + 1;
+    u8 setting;
+    u8 choice;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] != 0)
+    {
+        choice = gTasks[taskId].data[0];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeAllWindowBuffers();
+        if (choice == 2)
+        {
+            gMain.savedCallback = CB2_ReopenExplorationMenu;
+            SetMainCallback2(CB2_OptionsMenuFromStartMenu);
+        }
+        else
+            SetMainCallback2(sReturnCallback);
+        return;
+    }
+    if (JOY_NEW(B_BUTTON) || (JOY_NEW(A_BUTTON) && sCursor >= ROW_CONTINUE))
+    {
+        for (setting = 0; setting < TAICHUNG_EXPLORATION_SETTING_COUNT; setting++)
+            TaichungExplorationSetMode(setting, sModes[setting]);
+        gTasks[taskId].data[0] = JOY_NEW(A_BUTTON) && sCursor == ROW_OPTIONS ? 2 : 1;
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+    }
+    else if (JOY_NEW(DPAD_UP))
+        sCursor = (sCursor + rows - 1) % rows;
+    else if (JOY_NEW(DPAD_DOWN))
+        sCursor = (sCursor + 1) % rows;
+    else if (sCursor == ROW_LANGUAGE)
+    {
+        // Two choices, so any change flips it. The screen redraws in the new
+        // language at once, and the web player follows the saved value.
+        if (!JOY_NEW(DPAD_LEFT | DPAD_RIGHT | A_BUTTON))
+            return;
+        VarSet(TAICHUNG_LANGUAGE_VAR, CurrentLanguage() == TAICHUNG_LANGUAGE_ZH ? TAICHUNG_LANGUAGE_EN : TAICHUNG_LANGUAGE_ZH);
+    }
+    else if (sCursor < ROW_CONTINUE)
+    {
+        setting = sCursor - ROW_FIRST_SETTING;
+        if (JOY_NEW(DPAD_LEFT))
+            sModes[setting] = sModes[setting] == TAICHUNG_EXPLORATION_OFF ? TAICHUNG_EXPLORATION_NORMAL : sModes[setting] - 1;
+        else if (JOY_NEW(DPAD_RIGHT | A_BUTTON))
+            sModes[setting] = sModes[setting] == TAICHUNG_EXPLORATION_NORMAL ? TAICHUNG_EXPLORATION_OFF : sModes[setting] + 1;
+        else
+            return;
+    }
+    else
+        return;
+    PlaySE(SE_SELECT);
+    if (gTasks[taskId].data[0] == 0)
+        DrawExplorationMenu();
+}
diff --git a/src/taichung_fengjia_gym.c b/src/taichung_fengjia_gym.c
