+static void Reset(u16 mask)
+{
+    unsigned i;
+    for (i = 0; i < 256; i++) sSave.vars[i] = (u16)(0xA500 + i);
+    sSave.vars[0xF7] = 7; sSave.vars[0xF8] = 1; sSave.vars[0xF9] = 1;
+    sSave.vars[0xFA] = mask; sSave.vars[0xFB] = 2;
+    sSave.vars[0xFC] = 150; sSave.vars[0xFD] = 1;
+    sWrites = 0;
+    TaichungGymCancelChallenge();
+}
+
+static void Message(const struct Gym *gym, u16 requested, u16 expected)
+{
+    unsigned lang;
+    struct SaveBlock1 before = sSave;
+    unsigned writes = sWrites;
+    for (lang = 0; lang < 2; lang++)
+    {
+        sChinese = lang;
+        gSpecialVar_0x8005 = requested;
+        gym->message();
+        assert(strcmp((char *)gStringVar4, (const char *)gym->text[expected][lang]) == 0);
+        assert(memcmp(&before, &sSave, sizeof(before)) == 0 && writes == sWrites);
+    }
+}
+
+static void Start(const struct Gym *gym)
+{
+    assert(TaichungGymPrepareChallenge(gym->gym, gym->trainer));
+    TaichungGymOnTrainerBattleStart(gym->trainer);
+}
+
+static void TestGym(const struct Gym *gym)
+{
+    u16 mask, other;
+    u8 outcome;
+    unsigned slot;
+    struct SaveBlock1 before;
+    assert(gym->gym >= 3 && gym->gym <= 9);
+    assert(gym->trainer == 743 + gym->gym && gym->trainer < NUM_TRAINERS);
+    Reset(7); before = sSave;
+    Message(gym, TAICHUNG_GYM_MESSAGE_COMPLETE, TAICHUNG_GYM_MESSAGE_NOT_RECORDED);
+    Message(gym, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE, TAICHUNG_GYM_MESSAGE_NOT_RECORDED);
+    Message(gym, 8, TAICHUNG_GYM_MESSAGE_UNAVAILABLE);
+    Message(gym, 65535, TAICHUNG_GYM_MESSAGE_UNAVAILABLE);
+    for (slot = 0; slot < 8; slot++)
+        if (slot != TAICHUNG_GYM_MESSAGE_COMPLETE && slot != TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE)
+            Message(gym, slot, slot);
+
+    // Decline/greeting/offer are read-only. No preparation or award happens.
+    assert(memcmp(&before, &sSave, sizeof(before)) == 0 && sWrites == 0);
+    TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_WON); // No prep/start.
+    assert(TaichungGymPrepareChallenge(gym->gym, gym->trainer));
+    TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_WON); // No start.
+    assert(TaichungGymPrepareChallenge(gym->gym, gym->trainer));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_WON); // Wrong start.
+    Start(gym);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, B_OUTCOME_WON); // Wrong end.
+    Start(gym); TaichungGymCancelChallenge();
+    TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_WON); // Cancelled.
+    assert(memcmp(&before, &sSave, sizeof(before)) == 0 && sWrites == 0);
+
+    // Every native non-win code preserves all prior badges and all variables.
+    for (outcome = 0; outcome < 16; outcome++)
+    {
+        if (outcome == B_OUTCOME_WON) continue;
+        Start(gym);
+        TaichungGymOnTrainerBattleEnd(gym->trainer, outcome);
+        Message(gym, TAICHUNG_GYM_MESSAGE_COMPLETE, TAICHUNG_GYM_MESSAGE_NOT_RECORDED);
+        for (other = 0; other < TAICHUNG_GYM_COUNT; other++)
+            if (other != gym->gym) assert(!TaichungGymConsumeLossNotice(other));
+        assert(!TaichungGymConsumeLossNotice(65535));
+        gSpecialVar_0x8004 = gym->gym;
+        TaichungGym_ScriptConsumeLandmarkLossNotice();
+        assert(gSpecialVar_Result == (outcome == B_OUTCOME_LOST));
+        TaichungGym_ScriptConsumeLandmarkLossNotice();
+        assert(gSpecialVar_Result == FALSE);
+        TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_LOST);
+        assert(!TaichungGymConsumeLossNotice(gym->gym));
+        assert(memcmp(&before, &sSave, sizeof(before)) == 0 && sWrites == 0);
+    }
+
+    // Every possible existing badge combination retains its bits and writes
+    // exactly this gym's bit once. Duplicate outcomes and rematches add nothing.
+    for (mask = 0; mask <= TAICHUNG_GYM_ALL_MASK; mask++)
+    {
+        if (mask & (1 << gym->gym)) continue;
+        Reset(mask); before = sSave;
+        Start(gym);
+        TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_WON);
+        before.vars[0xFA] |= 1 << gym->gym;
+        assert(sWrites == 1 && memcmp(&before, &sSave, sizeof(before)) == 0);
+        Message(gym, TAICHUNG_GYM_MESSAGE_COMPLETE, TAICHUNG_GYM_MESSAGE_COMPLETE);
+        Message(gym, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE);
+        assert(!TaichungGymPrepareChallenge(gym->gym, gym->trainer));
+        TaichungGymOnTrainerBattleStart(gym->trainer);
+        TaichungGymOnTrainerBattleEnd(gym->trainer, B_OUTCOME_WON);
+        assert(sWrites == 1 && memcmp(&before, &sSave, sizeof(before)) == 0);
+        // Continue clears volatile result/notice, preserving the loaded mask.
+        TaichungGymCancelChallenge();
+        Message(gym, TAICHUNG_GYM_MESSAGE_COMPLETE, TAICHUNG_GYM_MESSAGE_NOT_RECORDED);
+        Message(gym, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE);
+        assert(!TaichungGymConsumeLossNotice(gym->gym));
+    }
+}
+
+int main(void)
+{
+    unsigned i;
+    assert(NUM_TRAINERS <= MAX_TRAINERS_COUNT);
+    for (i = 0; i < sizeof(sGyms)/sizeof(sGyms[0]); i++) TestGym(&sGyms[i]);
+    printf("PASS: %u installed landmark gyms, exact trainer/bit IDs, all 512 prior-badge combinations each, real-start/matching/win guards, non-win/loss/retry/duplicate/Continue reset, bilingual guarded messages; only own bit writes.\n", i);
+    return 0;
+}
diff --git a/tests/taichung_landmark_history_test.c b/tests/taichung_landmark_history_test.c
new file mode 100644
index 0000000..acfd644
--- /dev/null
+++ b/tests/taichung_landmark_history_test.c
@@ -0,0 +1,109 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_landmark_history.h"
+
+u8 gStringVar4[1024];
+u16 gSpecialVar_0x8004, gSpecialVar_0x8005, gSpecialVar_Result;
+static bool8 sChinese;
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static const u8 *sShown;
+bool8 ShowFieldMessage(const u8 *message) { sShown = message; return TRUE; }
+void TaichungNpc_AmingMessage(void);
+void TaichungNpc_AyanMessage(void);
+void TaichungNpc_QiaoqiaoMessage(void);
+void TaichungNpc_MeiMessage(void);
+void TaichungNpc_BoxunMessage(void);
+
+const u8 *TaichungText(const u8 *en, const u8 *zh)
+{
+    return sChinese ? zh : en;
+}
+
+u8 *StringCopy(u8 *dest, const u8 *src)
+{
+    size_t size = strlen((const char *)src);
+    assert(size < sizeof(gStringVar4));
+    memcpy(dest, src, size + 1);
+    return dest + size;
+}
+
+int main(void)
+{
+    u16 gym;
+    u8 locale;
+    u16 savedVars[256];
+    static const u16 helpers[] = {TAICHUNG_GYM_OLD_STATION,TAICHUNG_GYM_GREENWAY,TAICHUNG_GYM_SCIENCE_MUSEUM,TAICHUNG_GYM_FENGJIA,TAICHUNG_GYM_THEATER};
+    static void (*const handlers[])(void) = {TaichungNpc_AmingMessage,TaichungNpc_AyanMessage,TaichungNpc_QiaoqiaoMessage,TaichungNpc_MeiMessage,TaichungNpc_BoxunMessage};
+    unsigned helper, complete;
+    memset(&sSave,0x5A,sizeof(sSave));
+    assert(gTaichungLandmarkHistory[TAICHUNG_GYM_MIYAHARA].sign[0] != NULL);
+    for (locale = 0; locale < 2; locale++)
+    {
+        sChinese = locale;
+        sSave.vars[0xFB] = locale + 1;
+        memcpy(savedVars,sSave.vars,sizeof(savedVars));
+        for (gym = 0; gym <= TAICHUNG_LANDMARK_HISTORY_COUNT; gym++)
+        {
+            bool8 available = gym < TAICHUNG_LANDMARK_HISTORY_COUNT && gTaichungLandmarkHistory[gym].sign[0] != NULL;
+            gSpecialVar_0x8004 = gym;
+            gSpecialVar_0x8005 = 0xBEEF;
+            gSpecialVar_Result = 0xCAFE;
+            TaichungHistory_ScriptHasFacts();
+            // Gym 8's leader moved to Wanhe Temple, whose host tells its story.
+            assert(gSpecialVar_Result == (available && gym != TAICHUNG_GYM_MAPLE_GARDEN));
+            gSpecialVar_Result = 0xCAFE;
+            TaichungHistory_ScriptBufferSign();
+            if (available)
+                assert(strcmp((const char *)gStringVar4, (const char *)gTaichungLandmarkHistory[gym].sign[locale]) == 0);
+            else
+                assert(gStringVar4[0] != 0);
+            TaichungHistory_ScriptBufferTour();
+            if (available)
+                assert(strcmp((const char *)gStringVar4, (const char *)gTaichungLandmarkHistory[gym].tour[locale]) == 0);
+            TaichungHistory_ScriptBufferStaff();
+            if (gym < 10)
+                assert(strcmp((const char *)gStringVar4,(const char *)gTaichungLandmarkHistory[gym].staff[locale]) == 0);
+            else
+                assert(gStringVar4[0] != 0);
+            assert(strcmp((const char *)gStringVar4,(const char *)TaichungHistory_GetStaffText(gym)) == 0);
+            assert(memcmp(savedVars,sSave.vars,sizeof(savedVars)) == 0);
+            assert(gSpecialVar_0x8004 == gym);
+            assert(gSpecialVar_0x8005 == 0xBEEF);
+            assert(gSpecialVar_Result == 0xCAFE);
+        }
+        gSpecialVar_0x8004 = 0xFFFF;
+        TaichungHistory_ScriptHasFacts();
+        assert(gSpecialVar_Result == FALSE);
+        TaichungHistory_ScriptBufferSign();
+        TaichungHistory_ScriptBufferTour();
+        TaichungHistory_ScriptBufferStaff();
+        assert(gStringVar4[0] != 0);
+        assert(gSpecialVar_0x8004 == 0xFFFF);
+        for (complete = 0; complete < 2; complete++)
+        {
+            sSave.vars[0xFA] = complete ? 0x3FF : 0;
+            memcpy(savedVars,sSave.vars,sizeof(savedVars));
+            for (gym = 0; gym < 10; gym++)
+            {
+                gSpecialVar_0x8004 = gym; gSpecialVar_0x8005 = 0xBEEF; gSpecialVar_Result = 0xABCD;
+                TaichungHistory_ScriptBufferStaff();
+                assert(strcmp((const char *)gStringVar4,(const char *)gTaichungLandmarkHistory[gym].staff[locale]) == 0);
+                assert(gSpecialVar_0x8004 == gym && gSpecialVar_0x8005 == 0xBEEF && gSpecialVar_Result == 0xABCD);
+                assert(memcmp(savedVars,sSave.vars,sizeof(savedVars)) == 0);
+            }
+            for (helper = 0; helper < sizeof(helpers)/sizeof(helpers[0]); helper++)
+            {
+                gSpecialVar_0x8004 = 0xCAFE; gSpecialVar_0x8005 = 0xBEEF; gSpecialVar_Result = 0xABCD;
+                sShown = NULL; handlers[helper]();
+                assert(sShown == gTaichungLandmarkHistory[helpers[helper]].staff[locale]);
+                assert(gSpecialVar_0x8004 == 0xCAFE && gSpecialVar_0x8005 == 0xBEEF && gSpecialVar_Result == 0xABCD);
+                assert(memcmp(savedVars,sSave.vars,sizeof(savedVars)) == 0);
+            }
+        }
+    }
+    puts("PASS: actual bilingual sign/tour/staff buffers and five installed NPC C handlers, invalid/temple IDs, pre/post-win access and all256 saved vars unchanged");
+    return 0;
+}
diff --git a/tests/taichung_lian_test.c b/tests/taichung_lian_test.c
new file mode 100644
index 0000000..68435e5
--- /dev/null
+++ b/tests/taichung_lian_test.c
@@ -0,0 +1,93 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_lian.h"
+#include "constants/maps.h"
+#include "constants/event_objects.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool32 sPendingWarp;
+static unsigned sHeaderReads;
+static const struct MapLayout sLayout = {13, 15};
+static const struct ObjectEventTemplate sObjects[] = {
+    {1, OBJ_EVENT_GFX_TAICHUNG_LIAN}
+};
+static const struct MapEvents sEvents = {1, sObjects};
+static const struct MapHeader sHeader = {&sLayout, &sEvents};
+
+bool32 UseContinueGameWarp(void) { return sPendingWarp; }
+void SetContinueGameWarpStatus(void) { sPendingWarp = TRUE; }
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group, u16 number)
+{
+    assert(group == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(number == MAP_NUM(MAP_TAICHUNG_PARK_GYM));
+    sHeaderReads++;
+    return &sHeader;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.partyBadgesAndOtherSavedData, 0xA5, sizeof(sSave.partyBadgesAndOtherSavedData));
+    sSave.pos.x = 3; sSave.pos.y = 10;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_PARK_GYM);
+    sSave.location.warpId = 1;
+    sSave.location.x = 6; sSave.location.y = 13;
+    sSave.objectEventTemplates[0].localId = 1;
+    sSave.objectEventTemplates[0].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+    gSaveBlock1Ptr = &sSave;
+    sPendingWarp = FALSE;
+    sHeaderReads = 0;
+}
+
+static void ExpectUnchanged(void)
+{
+    struct SaveBlock1 before = sSave;
+    TaichungLianRefreshOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+}
+
+int main(void)
+{
+    struct SaveBlock1 before;
+    Reset();
+    before = sSave;
+    TaichungLianRefreshOnContinue();
+    assert(sPendingWarp && sHeaderReads == 1);
+    assert(sSave.continueGameWarp.mapGroup == sSave.location.mapGroup);
+    assert(sSave.continueGameWarp.mapNum == sSave.location.mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == 3 && sSave.continueGameWarp.y == 10);
+    before.continueGameWarp = sSave.continueGameWarp;
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+
+    Reset();
+    sSave.objectEventTemplates[0].localId = 0;
+    TaichungLianRefreshOnContinue();
+    assert(sPendingWarp); // Missing Station host cache also reloads safely.
+
+    Reset();
+    sSave.objectEventTemplates[0] = sObjects[0];
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); sPendingWarp = TRUE;
+    sSave.continueGameWarp.mapGroup = 1;
+    ExpectUnchanged(); assert(sHeaderReads == 0);
+
+    Reset(); sSave.location.mapGroup = 1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.location.mapNum = -1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.pos.x = 13;
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); gSaveBlock1Ptr = NULL;
+    TaichungLianRefreshOnContinue(); assert(sHeaderReads == 0);
+    puts("PASS: stale Lian cache refresh at saved position; party/badges preserved; current caches, pending warps, unrelated maps and invalid inputs untouched");
+    return 0;
+}
diff --git a/tests/taichung_native_badge_sprites_test.c b/tests/taichung_native_badge_sprites_test.c
new file mode 100644
index 0000000..5e77189
--- /dev/null
+++ b/tests/taichung_native_badge_sprites_test.c
@@ -0,0 +1,197 @@
+// Native bodies and layouts are extracted by test-native-badge-sprites.py.
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef int8_t s8;
+typedef uint16_t u16;
+typedef int16_t s16;
+typedef uint32_t u32;
+typedef int32_t s32;
+typedef uint8_t bool8;
+#define TRUE 1
+#define FALSE 0
+#define DISPLAY_WIDTH 240
+#define DISPLAY_HEIGHT 160
+#define TILE_SIZE_4BPP 32
+#define TOTAL_OBJ_TILE_COUNT 1024
+#define MAX_SPRITE_COPY_REQUESTS 64
+#define OAM_MATRIX_COUNT 32
+#define TAICHUNG_GYM_COUNT 10
+#define RGB(r, g, b) ((r) | ((g) << 5) | ((b) << 10))
+struct Sprite;
+typedef void (*AnimFunc)(struct Sprite *);
+typedef void (*AnimCmdFunc)(struct Sprite *);
+void SpriteCallbackDummy(struct Sprite *sprite);
+#include "native-badge-types.inc"
+
+static u8 sObjVram[TOTAL_OBJ_TILE_COUNT * TILE_SIZE_4BPP];
+static struct OamData sHardwareOam[128];
+#define OBJ_VRAM0 sObjVram
+#define OAM sHardwareOam
+struct { bool8 oamLoadDisabled; struct OamData oamBuffer[128]; } gMain;
+struct Sprite gSprites[MAX_SPRITES];
+struct OamMatrix gOamMatrices[OAM_MATRIX_COUNT];
+u8 gSpriteOrder[MAX_SPRITES], gSpriteTileAllocBitmap[TOTAL_OBJ_TILE_COUNT / 8];
+u16 gSpritePriorities[MAX_SPRITES], gReservedSpriteTileCount;
+s16 gSpriteCoordOffsetX, gSpriteCoordOffsetY;
+u8 gOamLimit = MAX_SPRITES, gSpriteCopyRequestCount;
+bool8 gAffineAnimsDisabled, gShouldProcessSpriteCopyRequests;
+struct SpriteCopyRequest gSpriteCopyRequests[MAX_SPRITE_COPY_REQUESTS];
+static u16 sPaletteTags[2], sObjPalette[32];
+static unsigned sCopies, sPaletteTransfers;
+
+static void CpuCopy16(const void *src, void *dest, u32 size)
+{
+    assert((u8 *)dest >= sObjVram && (u8 *)dest + size <= sObjVram + sizeof(sObjVram));
+    memcpy(dest, src, size);
+    sCopies++;
+}
+static void CpuCopy32(const void *src, void *dest, u32 size) { memcpy(dest, src, size); }
+static void TransferPlttBuffer(void) { sPaletteTransfers++; }
+// The real OAM builder runs with stable slot order; sorting is irrelevant to
+// transparency and contains the upstream -1 read documented in sprite.c.
+static void SortSprites(void) {}
+static void BeginAffineAnim(struct Sprite *sprite) { assert(sprite->oam.affineMode == ST_OAM_AFFINE_OFF); }
+static void ContinueAffineAnim(struct Sprite *sprite) { assert(sprite->oam.affineMode == ST_OAM_AFFINE_OFF); }
+static void InitSpriteAffineAnim(struct Sprite *sprite) { (void)sprite; assert(0); }
+static void AnimCmd_jump(struct Sprite *sprite) { (void)sprite; assert(0); }
+static void AnimCmd_loop(struct Sprite *sprite) { (void)sprite; assert(0); }
+static bool8 AddSubspritesToOamBuffer(struct Sprite *sprite, struct OamData *dest, u8 *index)
+{ (void)sprite; (void)dest; (void)index; assert(0); return FALSE; }
+static u16 GetSpriteTileStartByTag(u16 tag) { (void)tag; assert(0); return 0; }
+static void SetSpriteSheetFrameTileNum(struct Sprite *sprite) { (void)sprite; assert(0); }
+static u8 IndexOfSpritePaletteTag(u16 tag)
+{
+    u8 i;
+    for (i = 0; i < 2; i++) if (sPaletteTags[i] == tag) return i;
+    assert(0); return 0xFF;
+}
+static u8 LoadSpritePalette(const struct SpritePalette *palette)
+{
+    u8 i;
+    for (i = 0; i < 2; i++) if (!sPaletteTags[i])
+    {
+        sPaletteTags[i] = palette->tag;
+        memcpy(sObjPalette + i * 16, palette->data, 32);
+        return i;
+    }
+    return 0xFF;
+}
+static void FreeSpritePaletteByTag(u16 tag) { sPaletteTags[IndexOfSpritePaletteTag(tag)] = 0; }
+#include "native-badge-engine.inc"
+#include "native-badge-data.inc"
+
+static void Reset(void)
+{
+    u8 i;
+    memset(&gMain, 0, sizeof(gMain));
+    memset(sObjVram, 0, sizeof(sObjVram));
+    memset(sHardwareOam, 0, sizeof(sHardwareOam));
+    memset(gSpriteTileAllocBitmap, 0, sizeof(gSpriteTileAllocBitmap));
+    memset(sPaletteTags, 0, sizeof(sPaletteTags));
+    memset(gSpriteCopyRequests, 0, sizeof(gSpriteCopyRequests));
+    gSpriteCopyRequestCount = 0;
+    gShouldProcessSpriteCopyRequests = FALSE;
+    sCopies = sPaletteTransfers = 0;
+    for (i = 0; i < MAX_SPRITES; i++) { ResetSprite(&gSprites[i]); gSpriteOrder[i] = i; }
+    assert(TaichungBadgeLoadPalettes());
+    assert(!memcmp(sObjPalette, sEarnedPalette, sizeof(sEarnedPalette)));
+    assert(!memcmp(sObjPalette + 16, sLockedPalette, sizeof(sLockedPalette)));
+}
+
+static void CheckPixels(u8 id, bool8 award)
+{
+    struct Sprite *sprite = &gSprites[id];
+    unsigned size = award ? AWARD_BYTES : COLLECTION_BYTES;
+    const u8 *expected = (award ? sAwardTiles : sCollectionTiles) + id * size;
+    const u8 *actual = sObjVram + sprite->oam.tileNum * TILE_SIZE_4BPP;
+    assert(!memcmp(actual, expected, size));
+    // The immutable payload includes opaque pixels, not just an empty frame.
+    assert(memcmp(actual, (u8[AWARD_BYTES]){0}, size));
+}
+
+static void TestBatch(bool8 award, bool8 earned, bool8 dummy)
+{
+    u8 id, tick;
+    unsigned copyCount;
+    struct SpriteTemplate dummyTemplates[TAICHUNG_GYM_COUNT];
+    Reset();
+    for (id = 0; id < TAICHUNG_GYM_COUNT; id++)
+    {
+        u8 created;
+        if (dummy)
+        {
+            dummyTemplates[id] = award ? sAwardSprites[id] : sCollectionSprites[id][earned];
+            dummyTemplates[id].anims = gDummySpriteAnimTable;
+            created = CreateSprite(&dummyTemplates[id], 28 + id * 16, 60, 0);
+        }
+        else
+            created = TaichungBadgeCreateSprite(id, award, earned, 28 + id * 16, 60);
+        assert(created == id && !gSprites[id].usingSheet && !gSprites[id].invisible);
+        assert(gSprites[id].oam.tileNum == id * (award ? 16 : 4));
+    }
+    assert(gSpriteCopyRequestCount == 0 && sCopies == 0);
+    AnimateSprites();
+    if (dummy)
+        assert(gSpriteCopyRequestCount == 0);
+    else
+    {
+        assert(gSpriteCopyRequestCount == TAICHUNG_GYM_COUNT);
+        for (id = 0; id < TAICHUNG_GYM_COUNT; id++)
+        {
+            struct SpriteCopyRequest *request = &gSpriteCopyRequests[id];
+            assert(request->src == gSprites[id].images[0].data);
+            assert(request->dest == sObjVram + gSprites[id].oam.tileNum * TILE_SIZE_4BPP);
+            assert(request->size == (award ? AWARD_BYTES : COLLECTION_BYTES));
+        }
+    }
+    // Requests are deferred until BuildOamBuffer and the real scene VBlank.
+    ProcessSpriteCopyRequests();
+    assert(sCopies == 0);
+    BuildOamBuffer();
+    assert(!gMain.oamLoadDisabled && gShouldProcessSpriteCopyRequests);
+    VBlankCB_CityPass();
+    assert(gSpriteCopyRequestCount == 0 && sPaletteTransfers == 1);
+    assert(sCopies == (dummy ? 0 : TAICHUNG_GYM_COUNT));
+    for (id = 0; id < TAICHUNG_GYM_COUNT; id++)
+    {
+        struct OamData *oam = &sHardwareOam[id];
+        assert(oam->tileNum == gSprites[id].oam.tileNum && oam->priority == 0);
+        assert(oam->objMode == ST_OAM_OBJ_NORMAL && oam->affineMode == ST_OAM_AFFINE_OFF);
+        assert(oam->shape == ST_OAM_SQUARE && oam->size == (award ? 2 : 1));
+        assert(oam->paletteNum == (award || earned ? 0 : 1));
+        assert(oam->x == 28 + id * 16 - (award ? 16 : 8));
+        assert(oam->y == 60 - (award ? 16 : 8));
+        if (!dummy) CheckPixels(id, award);
+    }
+    if (dummy) assert(!memcmp(sObjVram, (u8[sizeof(sObjVram)]){0}, sizeof(sObjVram)));
+    // No follow-on frame may read the next icon, advance art or recopy pixels.
+    copyCount = sCopies;
+    for (tick = 0; tick < 120; tick++)
+    {
+        AnimateSprites();
+        assert(gSpriteCopyRequestCount == 0);
+        BuildOamBuffer();
+        VBlankCB_CityPass();
+        assert(sCopies == copyCount);
+        for (id = 0; id < TAICHUNG_GYM_COUNT; id++)
+        {
+            if (!dummy) { assert(gSprites[id].animEnded && gSprites[id].animCmdIndex == 0); CheckPixels(id, award); }
+        }
+    }
+}
+
+int main(void)
+{
+    u8 award, earned;
+    assert(sizeof(struct OamData) == 8 && sizeof(union AnimCmd) == 4);
+    for (award = 0; award < 2; award++) for (earned = 0; earned < 2; earned++)
+    {
+        TestBatch(award, earned, TRUE);
+        TestBatch(award, earned, FALSE);
+    }
+    puts("PASS: native dummy anim queues zero images; all10 fixed collection/award frames copy exact128/512 payloads, earned/locked palettes and OAM, static120frames");
+    return 0;
+}
diff --git a/tests/taichung_peiqi_test.c b/tests/taichung_peiqi_test.c
