+static void TestTransientEntryClears(void)
+{
+    struct SaveBlock1 before;
+
+    // New Game calls the transient reset once, without resetting an existing
+    // party, preferences or mask in this helper. New-game setup owns those.
+    Reset(); before = sSave;
+    TaichungSaveInitNewGame();
+    assert(sChallengeCancels == 1);
+    AssertProtected(&before, TRUE);
+    assert(V(0x40FB) == before.vars[0xFB] && V(0x40FC) == before.vars[0xFC]);
+    assert(V(0x40F7) == TAICHUNG_SAVE_VERSION && sVariableWrites == 1);
+
+    // Ordinary and quest-log Continue both reuse this helper. A current save
+    // takes the early return but must cancel once on each separate entry.
+    Versioned(TAICHUNG_SAVE_VERSION); before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(sChallengeCancels == 1);
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+    TaichungSaveUpgradeOnContinue();
+    assert(sChallengeCancels == 2);
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+    assert(sVariableWrites == 0 && sWarpRequests == 0);
+
+    // The empty-party and future-version exits also clear only transient state.
+    Versioned(1); sSave.playerPartyCount = 0; before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(sChallengeCancels == 1 && sVariableWrites == 0 && sWarpRequests == 0);
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+    Versioned(TAICHUNG_SAVE_VERSION + 1); before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(sChallengeCancels == 1 && sVariableWrites == 0 && sWarpRequests == 0);
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+
+    // Ordinary city transitions refresh this checkpoint. Neither that hook nor
+    // the whiteout checkpoint query may consume the player's pending notice.
+    Versioned(TAICHUNG_SAVE_VERSION);
+    TaichungSaveSetStationCheckpoint();
+    assert(TaichungSaveUsesStationCheckpoint() && sChallengeCancels == 0);
+    before = sSave;
+    TaichungSaveSetStationCheckpoint();
+    assert(TaichungSaveUsesStationCheckpoint() && sChallengeCancels == 0);
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+}
