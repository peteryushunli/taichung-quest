diff --git a/src/taichung_characters.c b/src/taichung_characters.c
new file mode 100644
index 0000000..044d345
--- /dev/null
+++ b/src/taichung_characters.c
@@ -0,0 +1,126 @@
+#include "global.h"
+#include "load_save.h"
+#include "overworld.h"
+#include "taichung_characters.h"
+#include "taichung_save.h"
+#include "constants/event_objects.h"
+#include "constants/maps.h"
+
+// Vanilla sprites are shared elsewhere, so only these exact room/local-ID/
+// graphics triples participate in the optional staff cache and overlap repair.
+static bool8 IsNewGymStaff(u8 mapNum, u8 localId, u8 graphicsId)
+{
+    switch (mapNum)
+    {
+    case MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM):
+        return localId == LOCALID_TAICHUNG_STAFF_MIYAHARA && graphicsId == OBJ_EVENT_GFX_WOMAN_2;
+    case MAP_NUM(MAP_TAICHUNG_PARK_GYM):
+        return localId == LOCALID_TAICHUNG_STAFF_PARK && graphicsId == OBJ_EVENT_GFX_MAN;
+    case MAP_NUM(MAP_TAICHUNG_SHEN_JI_GYM):
+        return localId == LOCALID_TAICHUNG_STAFF_SHEN_JI && graphicsId == OBJ_EVENT_GFX_LASS;
+    case MAP_NUM(MAP_TAICHUNG_FINE_ARTS_GYM):
+        return localId == LOCALID_TAICHUNG_STAFF_FINE_ARTS && graphicsId == OBJ_EVENT_GFX_WOMAN_1;
+    case MAP_NUM(MAP_TAICHUNG_MAPLE_GARDEN_GYM):
+        return localId == LOCALID_TAICHUNG_STAFF_MAPLE_GARDEN && graphicsId == OBJ_EVENT_GFX_SCIENTIST;
+    default: return FALSE;
+    }
+}
+
+void TaichungCharactersRefreshOnContinue(void)
+{
+    const struct MapHeader *header;
+    const struct ObjectEventTemplate *current;
+    const struct ObjectEventTemplate *saved;
+    struct WarpData *warp;
+    u8 i, j;
+    bool8 refresh = FALSE;
+    bool8 staff;
+
+    // Respect an existing migration/return warp, including the interrupted
+    // opening handoff. Unrelated FireRed maps and saves are not affected.
+    if (gSaveBlock1Ptr == NULL || UseContinueGameWarp()
+        || gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        || gSaveBlock1Ptr->location.mapNum < 0
+        || gSaveBlock1Ptr->location.mapNum > MAP_NUM(MAP_TAICHUNG_STATION_WELCOME))
+        return;
+
+    header = Overworld_GetMapHeaderByGroupAndId(gSaveBlock1Ptr->location.mapGroup,
+                                             gSaveBlock1Ptr->location.mapNum);
+    if (header->events == NULL || header->mapLayout == NULL
+        || gSaveBlock1Ptr->pos.x < 0 || gSaveBlock1Ptr->pos.y < 0
+        || gSaveBlock1Ptr->pos.x >= header->mapLayout->width
+        || gSaveBlock1Ptr->pos.y >= header->mapLayout->height)
+        return;
+
+    for (i = 0; i < header->events->objectEventCount; i++)
+    {
+        current = &header->events->objectEvents[i];
+        staff = IsNewGymStaff(gSaveBlock1Ptr->location.mapNum, current->localId, current->graphicsId);
+        if (!staff && (current->graphicsId < OBJ_EVENT_GFX_TAICHUNG_YICHENG
+            || current->graphicsId > OBJ_EVENT_GFX_TAICHUNG_BOXUN))
+            continue;
+        for (j = 0; j < OBJECT_EVENT_TEMPLATES_COUNT; j++)
+        {
+            saved = &gSaveBlock1Ptr->objectEventTemplates[j];
+            if (saved->localId == current->localId)
+                break;
+        }
+        if (j == OBJECT_EVENT_TEMPLATES_COUNT || saved->graphicsId != current->graphicsId
+            || (staff && (saved->y != 9 || (saved->x != 3 && saved->x != 4))))
+        {
+            refresh = TRUE;
+            break;
+        }
+    }
+    if (!refresh)
+        return;
+
+    // Use the engine's full map-load path to rebuild object templates and
+    // spawn the added NPC. Keep this exact saved position, never a door warp.
+    // No persistent variable, badge, party or mapView bytes are rewritten.
+    warp = &gSaveBlock1Ptr->continueGameWarp;
+    *warp = gSaveBlock1Ptr->location;
+    warp->warpId = -1;
+    warp->x = gSaveBlock1Ptr->pos.x;
+    warp->y = gSaveBlock1Ptr->pos.y;
+    TaichungSaveRememberObjectCacheRefreshFacing();
+    SetContinueGameWarpStatus();
+}
+
+// A legacy save may occupy a newly added optional NPC's authored square.
+// During the native full map load, move that NPC one reviewed floor tile right.
+// The player, party, progress, pending warp and every unrelated object stay put.
+void TaichungCharactersAvoidNpcSpawnOverlap(s16 playerX, s16 playerY)
+{
+    struct ObjectEventTemplate *object;
+    u8 graphicsId = 0;
+    bool8 customRoom = TRUE;
+    u8 i;
+
+    if (gSaveBlock1Ptr == NULL
+        || gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        || playerX != 3 || playerY != 9)
+        return;
+
+    switch (gSaveBlock1Ptr->location.mapNum)
+    {
+    case MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM): graphicsId = OBJ_EVENT_GFX_TAICHUNG_AMING; break;
+    case MAP_NUM(MAP_TAICHUNG_GREENWAY_GYM): graphicsId = OBJ_EVENT_GFX_TAICHUNG_AYAN; break;
+    case MAP_NUM(MAP_TAICHUNG_SCIENCE_MUSEUM_GYM): graphicsId = OBJ_EVENT_GFX_TAICHUNG_QIAOQIAO; break;
+    case MAP_NUM(MAP_TAICHUNG_FENGJIA_GYM): graphicsId = OBJ_EVENT_GFX_TAICHUNG_MEI; break;
+    case MAP_NUM(MAP_TAICHUNG_THEATER_GYM): graphicsId = OBJ_EVENT_GFX_TAICHUNG_BOXUN; break;
+    default: customRoom = FALSE; break;
+    }
+
+    for (i = 0; i < OBJECT_EVENT_TEMPLATES_COUNT; i++)
+    {
+        object = &gSaveBlock1Ptr->objectEventTemplates[i];
+        if (((customRoom && object->localId != 0 && object->graphicsId == graphicsId)
+             || IsNewGymStaff(gSaveBlock1Ptr->location.mapNum, object->localId, object->graphicsId))
+            && object->x == 3 && object->y == 9)
+        {
+            object->x = 4;
+            return;
+        }
+    }
+}
