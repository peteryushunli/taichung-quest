+def build(city):
+    sections=[]
+    for c, s in zip(CONFIGS,city["sections"]):
+        assert s["id"] == f"city-v2-r{c['rc'][0]}-c{c['rc'][1]}"
+        sections.append(make_section(c,s,road_names(city,s)))
+    return {
+        "schemaVersion":1, "status":"background authoring input; one-section reviews continue independently",
+        "coordinateContractRef":"docs/city-v2-streets.json#/coordinateContract",
+        "evidenceRef":"data/taichung/neighborhoods/evidence.json",
+        "sourceStreetDraftSha256":hashlib.sha256((ROOT/"docs/city-v2-streets.json").read_bytes()).hexdigest(),
+        "scope":"16 existing draft sections; no new gyms, source footprints or native map registration",
+        "numericalValueProvenance":"All mixtures and targets are authored game design, never surveyed percentages or inferred zoning.",
+        "definitions":{
+            "useMix":"Intended visual role shares among ordinary infill; not legal use or a percentage of real parcels.",
+            "ageStyleMix":"Apparent facade styles: older brick/weathered masonry, mature tiled/concrete mixed use, contemporary pale concrete/glass. No construction-year claim.",
+            "heightMix":"Conceptual low/mid/high-rise visual variety; current kit only partly expresses it. No actual floor count or native art guarantee.",
+            "roofColorMix":"Coherent roof-family authoring targets, not sampled facade colors or exact native RGB/palette banks.",
+            "frontageContinuity":"0..1 tendency to place adjacent facades into continuous runs.",
+            "setbackTiles":"Inclusive intended ground setback range in game tiles, after mandatory-clear masks; not surveyed meters.",
+            "arcadeFrequency":"0..1 intended share of frontage runs with an arcade/awning treatment; current art/collision support is partial.",
+            "signageIntensity":"0..1 visual emphasis; no actual count of signs per street.",
+            "greenSpaceFraction":"Target green share of land available for ordinary infill, excluding roads and landmark/park gym reserves.",
+            "builtCoverageTarget":"Target facade/body/lot share of available ordinary infill, excluding roads, arrivals and gym reserves; a game-density knob, not people per square kilometer.",
+            "prefabRoleWeights":"Relative selection priorities among compatible normal kit roles, after dimensions/context/mask checks; not shares of all metatiles.",
+            "streetBands":"Context overrides inside a section. Named roads are real; choosing particular retail frontages remains authored.",
+            "confidence":"Confidence in qualitative source-to-section character transfer, not statistical accuracy of authored weights."
+        },
+        "compositionPolicy":{
+            "assignmentUnit":"contiguous frontage run or small block, not independent random lots",
+            "runLengthBuildings":[4,8],"oneDominantRoofFamilyPerRun":True,
+            "secondaryAccentFraction":[.1,.2],"consistentHeightBandAndSetbackWithinRun":True,
+            "retailPlacement":"Prioritize selected main-road fronts and corners; reduce signage and stalls in residential interiors.",
+            "greenPlacement":"Cluster planting at coherent courts, park edges and transitions rather than random single-tile dots.",
+            "densityPlacement":"Apply targets only after protected roads, arrivals, gym footprints and actual prefab clear masks.",
+            "randomPerLotPaletteAssignment":False,
+            "avoidUniformSectionTreatment":True,
+            "styleAgeDoesNotDetermineEveryRoofColor":True
+        },
+        "unsupportedOrPartialVisualTargets":["Exact Taichung arcade/facade detailing","True high-rise silhouettes","Workshop-specific Taiwanese art","Current building-age and population-density statistics","Source building footprints and parcel zoning"],
+        "nativeMapChanges":False,"sections":sections}
+
