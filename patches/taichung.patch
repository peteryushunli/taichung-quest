+        'TaichungShenJi_Gym','TaichungFineArts_Gym','TaichungFengjia_Gym','TaichungTheater_Gym','TaichungWanheTemple_Hall','TaichungMapleGarden_Gym')
+lay = {l['id']: l for l in json.load(open(ROOT/'data/layouts/layouts.json'))['layouts'] if 'id' in l}
+bad = 0
+for m in MAPS:
+    d = json.load(open(ROOT/f'data/maps/{m}/map.json')); L = lay[d['layout']]; W, H = L['width'], L['height']
+    raw = open(ROOT/L['blockdata_filepath'], 'rb').read(); w = struct.unpack('<%dH' % (len(raw)//2), raw)
+    walk = lambda x, y: 0 <= x < W and 0 <= y < H and not (w[y*W+x] >> 10) & 3
+    objs = [(o['x'], o['y']) for o in d['object_events']]
+    ex = d['warp_events'][1]; start = (ex['x'], ex['y']); seen = {start}; st = [start]
+    while st:
+        x, y = st.pop()
+        for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):
+            n = (x+dx, y+dy)
+            if n not in seen and walk(*n) and n not in objs: seen.add(n); st.append(n)
+    on = [walk(*o) for o in objs]
+    ok = [any((ox+dx, oy+dy) in seen for dx, dy in ((1,0),(-1,0),(0,1),(0,-1))) for ox, oy in objs]
+    good = all(on) and all(ok) and walk(*start)
+    bad += not good
+    print(f"{'ok ' if good else 'BAD'} {m:26s} {d['layout']:34s} {W}x{H} people {objs} exit {start} music {d['music']}")
+sys.exit(1 if bad else 0)
