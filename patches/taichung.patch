+        raise ValueError('Cannot substitute staff maps before the complete current proof')
+    baseline = Files(source, BASE)
+    edits.update({path: baseline.read(path) for path in MAP_PATHS})
+    return StaffProjection(edits, source, overrides)
+
+
+def current_overrides(source, overrides):
+    """Re-prove, then unwrap a legacy projection at a current-guard boundary.
+
+    FinalXitun delegates back to the current streets guard. That guard must see
+    the original actual inputs, not mistake its caller's verified historical
+    map view for a current staff deletion. Ordinary mutation dicts have no view
+    metadata and are never normalized or excused here.
+    """
+    if not hasattr(overrides, '_staff_actual_overrides'):
+        return overrides
+    if overrides._staff_projection_source != str(Path(source).resolve()):
+        raise ValueError('Staff projection belongs to a different source')
