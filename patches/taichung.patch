+def beneath_street_signs(files, peel):
+    """peel(files) on a view with the street-sign layer removed, plus that layer's bytes;
+    exactly peel(files) when the tree does not hold the layer (or it is already peeled)."""
+    signs = street_signs_underneath(files)
+    if not signs:
+        return peel(files)
+    view = object.__new__(type(files))
+    view.__dict__.update(files.__dict__)
+    view.cache = {**files.cache, **signs}
+    out = peel(view)
+    return {**signs, **out} if out else {}
