+        return {"warps": len(data["warp_events"]), "signs": len(data["bg_events"]), "objects": len(data["object_events"]),
+                "shift": list(install.SHIFT), "offsets": {k: v[1] for k, v in wanted.items()}, "neighboursPending": pending}
+
+    def contract():
+        district, landmarks, habitats = install.contract_entries(base.json(install.CONTRACT))
+        mine = now.json(install.CONTRACT)
+        tests.require(next(d for d in mine["districts"] if d["map"] == install.MID) == district,
+                      "Contract district is not Xitun's plan size, origin and connections")
+        tests.require({l["id"]: l for l in mine["landmarks"] if l["exteriorMap"] == install.MID} == landmarks,
