+        gPlayerParty[i].hp = i ? 0 : 17;
+        gPlayerParty[i].status = 8;
+        gPlayerParty[i].pp[0] = 1; gPlayerParty[i].pp[1] = 0;
+        gPlayerParty[i].pp[2] = 2; gPlayerParty[i].pp[3] = 0;
+        gPlayerParty[i].ppBonuses = 0xE4;
+    }
+    CalculatePlayerPartyCount(); sCallback = NULL; sTrainerBattleMode = 0; sRivalBattleFlags = 0;
+    sRespawns = 0; TaichungGymCancelChallenge();
+}
+
+int main(void)
+{
+    static const u16 values[] = {0,1,2,65535};
+    struct Pokemon before[PARTY_SIZE], afterBattle[PARTY_SIZE];
+    unsigned mode, gym, i, j, cases = 0;
+    for (mode = 0; mode < ARRAY_COUNT(values); mode++) for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        bool8 enabled = values[mode] != TAICHUNG_GYM_HEAL_OFF;
+        InjuredParty(values[mode]); memcpy(before, gPlayerParty, sizeof(before));
+        assert(TaichungExplorationGymHealingEnabled() == enabled);
+        gSpecialVar_0x8004 = gym; gSpecialVar_0x8005 = sExpectedTrainers[gym];
+        TaichungGym_ScriptPrepareChallenge(); assert(gSpecialVar_Result);
+        assert(memcmp(before, gPlayerParty, sizeof(before)) == 0 && !sHeals);
+        TaichungGymOnTrainerBattleStart(sExpectedTrainers[gym]);
+        gPlayerParty[0].hp = 6; gPlayerParty[0].pp[0] = 0;
+        memcpy(afterBattle, gPlayerParty, sizeof(afterBattle));
+        gTrainerBattleOpponent_A = sExpectedTrainers[gym]; gBattleOutcome = B_OUTCOME_WON;
+        CB2_EndTrainerBattle();
+        assert(TaichungGymIsComplete(gym) && sHeals == enabled);
+        if (enabled)
+            for (i = 0; i < 2; i++)
+            {
+                assert(gPlayerParty[i].hp == gPlayerParty[i].maxHp && !gPlayerParty[i].status);
+                for (j = 0; j < 4; j++)
+                    assert(gPlayerParty[i].pp[j] == CalculatePPWithBonus(gPlayerParty[i].moves[j], gPlayerParty[i].ppBonuses, j));
+                assert(memcmp(&gPlayerParty[i].identity, &before[i].identity, sizeof(before[i].identity)) == 0);
+            }
+        else assert(memcmp(afterBattle, gPlayerParty, sizeof(afterBattle)) == 0);
+        CB2_EndTrainerBattle(); assert(sHeals == enabled); // Duplicate completion never heals twice.
+        cases++;
+    }
+    for (mode = 0; mode < 2; mode++)
+    {
+        InjuredParty(mode ? 2 : 1);
+        assert(TaichungGymPrepareChallenge(0, sExpectedTrainers[0]));
+        TaichungGymOnTrainerBattleStart(sExpectedTrainers[0]);
+        gTrainerBattleOpponent_A = sExpectedTrainers[0]; gBattleOutcome = B_OUTCOME_LOST;
+        CB2_EndTrainerBattle(); assert(!sHeals && sCallback == CB2_WhiteOut);
+        DoWhiteOut(); assert(sHeals == 1 && sRespawns == 1 && gPlayerParty[0].hp == gPlayerParty[0].maxHp);
+    }
+    InjuredParty(1); gTrainerBattleOpponent_A = sExpectedTrainers[0]; gBattleOutcome = B_OUTCOME_WON;
+    CB2_EndTrainerBattle(); assert(!sHeals); // No prepared/started challenge.
+    InjuredParty(1); assert(!TaichungGymPrepareChallenge(0, TRAINER_YOUNGSTER_BEN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    gTrainerBattleOpponent_A = TRAINER_YOUNGSTER_BEN; CB2_EndTrainerBattle(); assert(!sHeals);
+    for (mode = 0; mode < 2; mode++)
+    {
+        InjuredParty(mode ? 2 : 1); gPlayerParty[0].hp = 0;
+        gSpecialVar_0x8004 = 0; gSpecialVar_0x8005 = sExpectedTrainers[0];
+        memcpy(before, gPlayerParty, sizeof(before));
+        TaichungGym_ScriptPrepareChallenge(); assert(!gSpecialVar_Result && !sHeals);
+        assert(!memcmp(before, gPlayerParty, sizeof(before)));
+        gPlayerParty[0].hp = 17; gPlayerParty[0].isEgg = TRUE;
+        TaichungGym_ScriptPrepareChallenge(); assert(!gSpecialVar_Result && !sHeals);
+    }
+    // Necessary legacy normalization must neither revive nor make a living mon unusable.
+    InjuredParty(2); gPlayerParty[0].level = 5; gPlayerParty[0].hp = 1;
+    gPlayerParty[1].level = 80; gPlayerParty[1].hp = 0;
+    memcpy(before, gPlayerParty, sizeof(before)); TaichungTeamEnsurePartyLevel();
+    assert(gPlayerParty[0].level == 50 && gPlayerParty[0].hp == 1 && gPlayerParty[1].hp == 0);
+    for (i = 0; i < 2; i++)
+    {
+        assert(gPlayerParty[i].status == before[i].status && !memcmp(gPlayerParty[i].pp, before[i].pp, 4));
+        assert(!memcmp(&gPlayerParty[i].identity, &before[i].identity, sizeof(before[i].identity)));
+    }
+    printf("PASS: %u real gym entry/victory cases; native HP/PP/PP-Up/status full heal On, damage preserved Off, no preheal/faint revive, legacy normalization and ordinary blackout both modes\n", cases);
+    return 0;
+}
