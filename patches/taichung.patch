@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Check source/draft separation and reciprocal section-port sizing contracts."""
+import argparse
+import json
+from pathlib import Path
+
+
+def require(ok,message):
+    if not ok:raise SystemExit('GEOGRAPHY DRAFT FAILED: '+message)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--draft',type=Path,default=Path('docs/city-v2-streets.json'))
+    p.add_argument('--baseline-contract',type=Path,default=Path('docs/taichung-city-contract.json'))
+    args=p.parse_args();d=json.loads(args.draft.read_text());base=json.loads(args.baseline_contract.read_text())
+    require(len(d['sections'])==16,'Expected provisional4×4 sections')
+    require({g['id'] for g in d['landmarks']}=={g['id'] for g in base['landmarks']},'Approved10-gym IDs differ from native baseline')
+    baseline={g['id']:g for g in base['landmarks']}
+    for gym in d['landmarks']:
+        require(gym['authoredGameEntrance'] is None,'GPS point promoted prematurely to game entrance')
+        native=gym['baselineNative'];actual=baseline[gym['id']]
+        require(native['exteriorMap']==actual['exteriorMap'] and native['entrance']==actual['entrance'] and native['arrival']==actual['arrival'],'Existing native entrance/arrival altered')
+    sections={s['id']:s for s in d['sections']}
+    for s in sections.values():
+        require(s['nativeMapId'] is None and not s['nativeMapRegistration'],'Draft registered a native map')
+        require((s['width']+15)*(s['height']+14)<=0x2800,'Section exceeds current native virtual-map buffer')
+    south,west,north,east=d['coordinateContract']['wgs84BoundsSWNE']
+    for street in d['streets']:
+        require(street['sourceLayer']=='R0002','Unexpected unsourced street layer')
+        require(street['authoredGameCenterline'] is None,'Raw source trace is mislabeled final game route')
+        for lon,lat in street['sourceGeometryWgs84']:
+            require(west-1e-6<=lon<=east+1e-6 and south-1e-6<=lat<=north+1e-6,'Source trace escaped clipping bounds')
+        require(all(0<=x<=256 and 0<=y<=256 for x,y in street['projectedCenterline']),'Projected trace outside world')
+    for port in d['seamCandidates']:
+        require(port['fromSection'] in sections and port['toSection'] in sections,'Port links nonexistent section')
+        a,b=sections[port['fromSection']],sections[port['toSection']]
+        x,y=port['fromLocalCenter'];u,v=port['toLocalCenter']
+        if port['direction']=='right':
+            require(a['gridRow']==b['gridRow'] and a['gridCol']+1==b['gridCol'] and x==63 and u==0 and y==v,'Horizontal seam mismatch')
+        else:
+            require(a['gridCol']==b['gridCol'] and a['gridRow']+1==b['gridRow'] and y==63 and v==0 and x==u,'Vertical seam mismatch')
+        require(port['nativeConnectionOffset']==0,'Aligned64×64 draft should use zero connection offset')
+    for lot in d['unpaintedLotCandidates']:
+        s=sections[lot['section']];x,y=lot['localOrigin']
+        require(0<=x and 0<=y and x+lot['width']<=64 and y+lot['height']<=64,'Lot outside section')
+        require(lot['sourceBuildingId'] is None and lot['selectedPrefabId'] is None,'Candidate lot presented as real/final building')
+    require(len(d['landmarkReserveConflicts'])>=1,'Uniform projection unexpectedly concealed landmark footprint pressure')
+    require(any(m['layer']=='waterway geometry' for m in d['missingLayers']),'Missing water geometry not disclosed')
+    require(any(m['layer']=='rail centerlines' for m in d['missingLayers']),'Missing rail geometry not disclosed')
+    print(f"GEOGRAPHY DRAFT PASSED: {len(sections)} sections, {len(d['streets'])} sourced road parts, {len(d['seamCandidates'])} reciprocal port candidates,10 preserved gym IDs.")
+
+
+if __name__=='__main__':main()
diff --git a/tools/taichung/landmarks/audit_old_core_primary.py b/tools/taichung/landmarks/audit_old_core_primary.py
new file mode 100644
index 0000000..a6ee075
--- /dev/null
+++ b/tools/taichung/landmarks/audit_old_core_primary.py
@@ -0,0 +1,339 @@
+#!/usr/bin/env python3
+"""Read-only capacity audit for a possible scene-specialized OldCity primary.
+
+Writes only the audit JSON. It does not create a tileset, alter General, remap a
+metatile, assign a bank, or assert that arbitrary runtime mutations are safe.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+PROJECT = ROOT.parents[1]
+ARTIFACT = PROJECT / "artifacts/worktrees/c291d4842985"
+OUTPUT = ROOT / "data/taichung/landmarks/old-core-bank-audit.json"
+V4 = ARTIFACT / "neighborhoods/r2c2-filled-v4"
+PRIMARY = ROOT / "data/tilesets/primary/general"
+PEWTER = ROOT / "data/tilesets/secondary/pewter_city"
+MAPS = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+
+
+class Inputs:
+    def __init__(self):
+        self.raw = {}
+
+    def read(self, path):
+        path = Path(path)
+        if path not in self.raw:
+            self.raw[path] = path.read_bytes()
+        return self.raw[path]
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        return list(struct.unpack(f"<{len(raw)//struct.calcsize(kind)}{kind}", raw))
+
+    def image(self, path):
+        self.read(path)
+        image = Image.open(path)
+        if image.mode != "P" or image.getextrema()[1] > 15:
+            raise ValueError(f"Expected indexed 4bpp source: {path}")
+        return image
+
+    def provenance(self):
+        return {str(path.relative_to(PROJECT)): hashlib.sha256(raw).hexdigest()
+                for path, raw in sorted(self.raw.items())}
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+def canonical(pixels):
+    return min(flip(pixels, flags) for flags in (0, 0x400, 0x800, 0xC00))
+
+
+def pattern(image, graphic):
+    x, y = graphic % (image.width//8)*8, graphic // (image.width//8)*8
+    return canonical(tuple(image.getpixel((x+dx, y+dy)) for dy in range(8) for dx in range(8)))
+
+
+def ranges(values):
+    result = []
+    for number in sorted(values):
+        if result and number == result[-1][1]+1:
+            result[-1][1] = number
+        else:
+            result.append([number, number])
+    return result
+
+
+def audit(output=OUTPUT):
+    inputs = Inputs()
+    spec = importlib.util.spec_from_file_location("audit_native_renderer", ROOT / "tools/taichung/render_maps.py")
+    renderer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(renderer)
+    inputs.read(ROOT / "tools/taichung/render_maps.py")
+    for file in ("headers.h", "graphics.h", "metatiles.h"):
+        inputs.read(ROOT / "src/data/tilesets" / file)
+    inputs.read(ROOT / "src/graphics.c")
+    general = inputs.words(PRIMARY / "metatiles.bin")
+    general_attrs = inputs.words(PRIMARY / "metatile_attributes.bin", "I")
+    image = inputs.image(PRIMARY / "tiles.png")
+    assert image.width*image.height//64 == 640
+    source_patterns = {n: pattern(image, n) for n in range(640)}
+    animations = inputs.text(ROOT / "src/tileset_anims.c")
+    animation_writes = sorted((int(start), int(count)) for start, count in re.findall(
+        r"AppendTilesetAnimToBuffer\(sTilesetAnims_General_[^;]*?TILE_OFFSET_4BPP\((\d+)\)\),\s*(\d+)\s*\*\s*TILE_SIZE_4BPP\);", animations))
+    assert animation_writes == [(416, 48), (464, 18), (508, 4)], animation_writes
+    animated = {tile for start, count in animation_writes for tile in range(start, start+count)}
+    door_source = inputs.text(ROOT / "src/field_door.c")
+    assert "#define DOOR_TILE_START (NUM_TILES_TOTAL - 8)" in door_source
+    scratch = set(range(1016, 1024))
+    records, required_graphics, primary_metatiles, behavior_ids = [], set(), set(), set()
+
+    def collect(label, words, secondary):
+        secondary_defs = inputs.words(secondary / "metatiles.bin")
+        secondary_attrs = inputs.words(secondary / "metatile_attributes.bin", "I")
+        metatiles = {word & 1023 for word in words}
+        graphics, primary_metas = set(), set()
+        for tile in metatiles:
+            if tile < 640:
+                definitions, attributes, index = general, general_attrs, tile
+                primary_metas.add(tile)
+            else:
+                definitions, attributes, index = secondary_defs, secondary_attrs, tile-640
+            assert index < len(attributes), (label, tile)
+            behavior_ids.add(attributes[index] & 0x1FF)
+            for entry in definitions[index*8:index*8+8]:
+                graphic = entry & 1023
+                if graphic < 640:
+                    graphics.add(graphic)
+        required_graphics.update(graphics)
+        primary_metatiles.update(primary_metas)
+        records.append({"input": label, "secondaryDefinitions": str(secondary.relative_to(PROJECT)),
+                        "usedMetatileCount": len(metatiles), "generalMetatileIds": sorted(primary_metas),
+                        "generalGraphicIdsIncludingSecondaryCrossReferences": sorted(graphics)})
+
+    layouts = inputs.json(ROOT / "data/layouts/layouts.json")["layouts"]
+    map_records = []
+    for name in MAPS:
+        layout = next(item for item in layouts if item.get("name") == name+"_Layout")
+        assert layout["primary_tileset"] == "gTileset_General", "Re-audit a changed primary before reuse"
+        secondary = renderer.tileset_paths(ROOT, layout["secondary_tileset"])["metatiles"].parent
+        for kind in ("blockdata_filepath", "border_filepath"):
+            collect(name+":"+kind, inputs.words(ROOT / layout[kind]), secondary)
+        map_records.append({"mapId": "MAP_"+re.sub(r"(?<!^)(?=[A-Z])", "_", name).upper(),
+                            "layout": layout["id"], "secondary": layout["secondary_tileset"],
+                            "size": [layout["width"], layout["height"]]})
+    catalog_path = ROOT / "data/taichung/prefabs/catalog.json"
+    catalog = inputs.json(catalog_path)
+    catalog_words = [int(word, 0) for prefab in catalog["prefabs"] for row in prefab["words"] for word in row]
+    collect("complete-original-prefab-catalog", catalog_words, PEWTER)
+    v4_bank = V4 / "native-color-bank"
+    v4_map = inputs.words(V4 / "filled-map.bin")
+    collect("V4-filled-64x64-fixture", v4_map, v4_bank)
+    v4_catalog = inputs.json(V4 / "block-catalog.json")
+    collect("complete-V4-block-catalog", [int(word, 0) for prefab in v4_catalog["prefabs"] for row in prefab["words"] for word in row], PEWTER)
+    labels_source = inputs.text(ROOT / "include/constants/metatile_labels.h")
+    named_general = {name: int(number, 0) for name, number in re.findall(
+        r"^#define\s+(METATILE_General_\w+)\s+(0x[0-9A-Fa-f]+|\d+)", labels_source, re.M)}
+    before_dynamic = required_graphics.copy()
+    collect("conservative-dynamic-closure-all-named-General-labels", list(named_general.values()), PEWTER)
+    dynamic_graphics_added = required_graphics-before_dynamic
+    for path in ("src/fldeff_cut.c", "src/scrcmd.c", "src/field_effect_helpers.c", "src/field_specials.c", "src/fieldmap.c", "src/special_field_anim.c", "src/field_tasks.c"):
+        inputs.read(ROOT / path)
+    script_paths = [ROOT / "data/scripts/taichung_city.inc"] + sorted((ROOT / "data/maps").glob("Taichung*/scripts.inc"))
+    script_replacements = []
+    for path in script_paths:
+        for number, line in enumerate(inputs.text(path).splitlines(), 1):
+            if re.search(r"^\s*(?:setmetatile|setmetatileattribute)\b", line):
+                script_replacements.append({"file": str(path.relative_to(ROOT)), "line": number, "text": line.strip()})
+    reserved = required_graphics | animated
+    free = set(range(640))-reserved
+    assert not free & animated and not free & required_graphics
+    static_available_patterns = {source_patterns[tile] for tile in required_graphics-animated}
+    # Static patterns must never reuse an animation destination merely because
+    # its initial frame happens to match: the next callback overwrites it.
+    all_static = {source_patterns[tile] for tile in set(range(640))-animated}
+    full_preserve_count = len(animated)+len(all_static)
+    pools = {}
+
+    def pool(label, path, count=None, palette_banks=None):
+        sheet = inputs.image(path)
+        count = count if count is not None else sheet.width*sheet.height//64
+        result = {pattern(sheet, tile) for tile in range(count)}
+        pools[label] = {"path": str(path.relative_to(PROJECT)), "rawGraphicsExamined": count,
+                        "flipCanonicalPatterns": len(result), "paletteBanks": palette_banks,
+                        "patternSha256": hashlib.sha256(bytes(value for pixels in sorted(result) for value in pixels)).hexdigest()}
+        return result
+
+    station_path = ROOT / "data/taichung/landmarks/old-station/native.png"
+    station = pool("Station-art-palette7", station_path, palette_banks=[7])
+    miyahara_path = ROOT / "data/taichung/landmarks/miyahara/candidate-v2/candidate-indexed.png"
+    miyahara = pool("Miyahara-V2-art-palette7", miyahara_path, palette_banks=[7])
+    shared_palette = inputs.image(station_path).getpalette()[:48]
+    assert inputs.image(miyahara_path).getpalette()[:48] == shared_palette
+    original_color_bank = ARTIFACT / "neighborhoods/native-color-bank"
+    original_color_manifest = inputs.json(original_color_bank / "compile-manifest.json")
+    fixture_color = pool("existing-generic-color-fixture-snapshot", original_color_bank / "tiles.png",
+                         original_color_manifest["secondaryGraphicsTotal"], [8, 9, 10, 11, 12])
+    # The generic fixture directory can be regenerated by a later streetscape
+    # pass. Compile the original full catalog in memory to measure its entire
+    # color recipe instead of assuming that fixture still contains all of it.
+    sys.path.insert(0, str(ROOT / "tools/taichung/streetscape"))
+    import color_compile
+    full_compiled = color_compile.compile_colorways(
+        ROOT, catalog_path, ROOT / "data/taichung/prefabs/colorways.json")
+    full_color = {canonical(tuple(pixels)) for pixels in full_compiled["graphics"]}
+    pools["complete-original-catalog-and-color-recipe"] = {
+        "compiledInMemoryOnly": True, "sourceCatalog": str(catalog_path.relative_to(ROOT)),
+        "sourceRecipe": "data/taichung/prefabs/colorways.json", "flipCanonicalPatterns": len(full_color),
+        "sourceKitPatterns": full_compiled["budget"]["sourceKitGraphicsAfterFlipDedup"],
+        "coloredPatternsAdded": full_compiled["budget"]["coloredRoofGraphicsAdded"],
+        "paletteBanks": [8, 9, 10, 11, 12],
+        "patternSha256": hashlib.sha256(bytes(value for pixels in sorted(full_color) for value in pixels)).hexdigest(),
+    }
+    for path in (ROOT / "tools/taichung/streetscape/color_compile.py", ROOT / "tools/taichung/streetscape/library.py",
+                 ROOT / "data/taichung/prefabs/colorways.json", PEWTER / "tiles.png"):
+        inputs.read(path)
+    for bank in range(13):
+        inputs.read((PRIMARY if bank < 7 else PEWTER) / f"palettes/{bank:02}.pal")
+    v4_manifest = inputs.json(v4_bank / "compile-manifest.json")
+    v4_color = pool("V4-source-and-color-kit", v4_bank / "tiles.png", v4_manifest["secondaryGraphicsTotal"], [8, 9, 10, 11, 12])
+    # Include any actually referenced OldCity secondary pixels that are not
+    # already represented by the source/color kit and standalone Station art.
+    old_layout = next(item for item in layouts if item.get("id") == "LAYOUT_TAICHUNG_OLD_CITY")
+    old_secondary = renderer.tileset_paths(ROOT, old_layout["secondary_tileset"])["metatiles"].parent
+    old_defs = inputs.words(old_secondary / "metatiles.bin")
+    old_words = inputs.words(ROOT / old_layout["blockdata_filepath"]) + inputs.words(ROOT / old_layout["border_filepath"])
+    old_graphics = set()
+    for tile in {word & 1023 for word in old_words if word & 1023 >= 640}:
+        old_graphics.update((word & 1023)-640 for word in old_defs[(tile-640)*8:(tile-640)*8+8] if word & 1023 >= 640)
+    old_sheet = inputs.image(old_secondary / "tiles.png")
+    old_scene = {pattern(old_sheet, n) for n in old_graphics}
+    pools["current-OldCity-secondary-scene"] = {"path": str((old_secondary / "tiles.png").relative_to(PROJECT)),
+                                                "rawGraphicsExamined": len(old_graphics), "flipCanonicalPatterns": len(old_scene),
+                                                "graphicIndicesRelative": sorted(old_graphics)}
+    known = station | miyahara | full_color | fixture_color | v4_color | old_scene
+    park_path = ROOT / "data/taichung/landmarks/taichung-park/candidate/candidate-indexed.png"
+    if park_path.exists():
+        park = pool("Park-candidate", park_path, palette_banks=[7])
+        park_palette_matches = inputs.image(park_path).getpalette()[:48] == shared_palette
+        park_status = "candidate included; exact palette match measured"
+    else:
+        park, park_palette_matches, park_status = set(), None, "not encoded at audit time; no cost invented"
+    combined = known | park
+    matched_primary = combined & static_available_patterns
+    new_patterns = combined-static_available_patterns
