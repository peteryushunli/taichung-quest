@@ -0,0 +1,77 @@
+#include <stdint.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;typedef uint16_t u16;typedef uint32_t u32;typedef uint8_t bool8;typedef void(*MainCallback)(void);
+#define TRUE 1
+#define FALSE 0
+#define PARTY_SIZE 6
+#define SPECIES_NONE 0
+#define MON_DATA_SPECIES 0
+#define A_BUTTON 1
+#define B_BUTTON 2
+#define SELECT_BUTTON 4
+#define START_BUTTON 8
+#define DPAD_UP 16
+#define DPAD_DOWN 32
+#define DPAD_LEFT 64
+#define DPAD_RIGHT 128
+#define JOY_NEW(b) (gMain.newKeys&(b))
+#define PARTY_MENU_TYPE_FIELD 0
+#define PARTY_LAYOUT_SINGLE 0
