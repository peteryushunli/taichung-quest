+                       "retirementRestorations": restores, "placementSource": MAPLE, "placementSha256": MAPLE_SHA,
+                       "layers": "passable art and unused raster-door template COVERED1; B/T/water NORMAL0; actual door uses exact General03D",
+                       "doorIsExplicitOneCellPavilionAdaptation": True, "rasterUnchanged": True}],
+        "delta": {"changedCells": len(delta), "cells": delta, "newlyBlockedCount": len(blocked), "newlyBlocked": blocked,
+                  "newlyWalkableCount": len(opened), "newlyWalkable": opened,
+                  "changedBoundsInclusive": [min(c["x"] for c in delta), min(c["y"] for c in delta), max(c["x"] for c in delta), max(c["y"] for c in delta)],
