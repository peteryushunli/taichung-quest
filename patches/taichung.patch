+import sys
+from lib import *
+ROOMS={}
+def room(fn): ROOMS[fn.__name__]=fn; return fn
+def exit_mat(g, cx, primary=True):
+    H=len(g)
+    g[H-2][cx-1:cx+2]=[0x012,0x013,0x014]
+    g[H-1][cx-1:cx+2]=[0x01a|0xC00,0x01b|0xC00,0x01c|0xC00]
+BLACK=0x008|0xC00
+
+@room
+def science():
+    """Science Museum: 15x9 room, fossils left, shuttle right, leader under the central pillar."""
+    m1=grid('PEWTER_CITY_MUSEUM_1F'); m2=grid('PEWTER_CITY_MUSEUM_2F')
+    W,H=15,10
+    g=new(W,H,0x281)
+    # walls: 2F cols 2..16 give windows at 1,5,9,13 and pillars at 3,7,11
+    paste(g,crop(m2,2,0,15,2),0,0)
+    for x in range(W): g[2][x]=0x282
+    g[H-1]=[BLACK]*W
+    # left wall: shadow column like the museum's west edge
+    for y in range(3,H-1): g[y][0]=0x282
+    # fossil cases (1F, two 4x3 cases)
+    paste(g,crop(m1,3,3,4,6),1,3)
+    # shuttle on its plinth (2F 14..17 x 4..6)
+    paste(g,crop(m2,14,4,4,3),10,3)
+    # bookshelves on the north wall replace a window pair (1F 17..20 x 0..2)
+    paste(g,crop(m1,17,0,2,3),0,0) if False else None
+    # round stools facing the shuttle (1F 16,3)
+    g[7][10]=m1[3][16]; g[7][13]=m1[3][16]
+    # potted plants at the entrance (2F 0,8..9 / 1,8..9)
+    paste(g,crop(m2,0,8,1,2),0,H-3); paste(g,crop(m2,18,8,1,2),W-1,H-3)
+    # info desk (1F 27, 3..4 PC desk)
+    paste(g,crop(m1,27,3,1,2),W-1,3)
+    g[H-2][6:9]=[m1[9][13],m1[9][14],m1[9][15]]; g[H-1][6:9]=[m1[10][13],m1[10][14],m1[10][15]]
+    return g,'gTileset_Museum'
+
+@room
+def park():
+    """Taichung Park: the lake pavilion. Cerulean pool; one pier from the door to the leader's deck."""
+    c=grid('CERULEAN_CITY_GYM')
+    top=[row[:] for row in c[0:10]]
+    # pier joins the deck's south edge at x=9
+    top[9][9]=0x29c; top[9][10]=0x293
+    # drop the deck's east branch so the pier is the only way up
+    for y in (8,9): top[y][12]=0x291; top[y][13]=0x291
+    link=[row[:] for row in c[15:16]]
+    g=top+link+[row[:] for row in c[16:20]]
+    return g,'gTileset_CeruleanGym'
+
+@room
+def station():
+    """Old Station: waiting hall, ticket gates, leader at the platform passage under the clock."""
+    r2=grid('ROUTE2_ENTRANCE'); r16=grid('ROUTE16_NORTH_ENTRANCE_1F')
+    W,H=19,14; V=0x008|0xC00; S_=0xC00
+    g=new(W,H,0x281)
+    for y in range(H): g[y][0]=V; g[y][W-1]=V
+    g[H-1]=[V]*W
+    top=[0x287]*W; low=[0x28f|S_]*W
+    for x in (2,5,12,15): top[x:x+2]=[0x298|S_,0x299|S_]; low[x:x+2]=[0x2a0|S_,0x2a1|S_]
+    top[8:11]=[0x288|S_,0x289|S_,0x28a|S_]; low[8:11]=[0x290|S_,0x291,0x292|S_]
+    top=[v|S_ for v in top]
+    g[0][1:W-1]=top[1:W-1]; g[1][1:W-1]=low[1:W-1]
+    g[2][1:W-1]=[0x282]*(W-2)
+    for x in (1,7,11,17):
+        g[1][x]=r2[1][1]; g[2][x]=r2[2][1]
+    for y in range(3,H-1): g[y][1]=0x282
+    # ticket gates: Route 16 partition, open in the middle
+    part=crop(r16,1,5,11,4)
+    for y in range(4):
+        L=part[y][0]; M=part[y][1]; R=part[y][10]
+        g[5+y][1:8]=[L]+[M]*5+[R]
+        g[5+y][11:18]=[L]+[M]*5+[R]
+    # red carpet from the gates to the door
+    paste(g,[[0x29a,0x2c2,0x29b]]+[[0x2c3,0x2cb,0x2c4]]*3+[[0x2a2,0x2ca,0x2a3]],8,8)
+    # waiting tables either side
+    tbl=crop(r2,10,4,4,2)
+    paste(g,tbl,3,10); paste(g,tbl,13,10)
+    # potted plants by the door
+    paste(g,crop(r2,1,4,2,2),1,10) if False else None
+    # red benches against both side walls
+    for j in range(3):
+        g[9+j][0]=r16[11+j][0]; g[9+j][1]=r16[11+j][1]
+        g[9+j][W-2]=r16[11+j][11]; g[9+j][W-1]=r16[11+j][12]
+    g[H-2][8:11]=[0x2c5,0x2c6,0x2c7]; g[H-1][8:11]=[0x2cd|S_,0x2ce|S_,0x2cf|S_]
+    return g,'gTileset_GenericBuilding2'
+
+@room
+def miyahara():
+    """Miyahara: sweet-shop hall. Dais between twin stairs, glass sweet cases, towering shelves, ice-cream counter."""
+    d3=grid('CELADON_CITY_DEPARTMENT_STORE_3F'); d4=grid('CELADON_CITY_DEPARTMENT_STORE_4F'); d1=grid('CELADON_CITY_DEPARTMENT_STORE_1F')
+    g=[row[:] for row in d3[0:6]]
+    for x in range(5,8): g[0][x]=d3[0][3]; g[1][x]=d3[1][3]; g[2][x]=d3[2][4]
+    g+= [row[:] for row in d4[6:10]]
+    g+= [row[:] for row in d4[11:13]]
+    g+= [[0x2c1]+[0x2c0]*11+[0x2c0]]
+    g+= [row[:] for row in d1[13:16]]
+    g=g[:-3]+[d1[14][:],d1[15][:]]
+    # one centred exit
+    g[-2]=[0x2c1]+[0x2c0]*12; g[-2][5:8]=d1[14][1:4]
+    g[-1]=[0x008|0xC00]*13; g[-1][5:8]=d1[15][1:4]
+    for y in (10,11): g[y][12]=0x2c0
+    return g,'gTileset_DepartmentStore'
+
+@room
+def greenway():
+    """Calligraphy Greenway: the green tower's indoor garden; a single path up to the leader's lawn."""
+    c=grid('CELADON_CITY_GYM')
+    g=[row[:] for row in c[0:10]]+[row[:] for row in c[14:20]]
+    return g,'gTileset_CeladonGym'
+
+@room
+def shenji():
+    """Shen Ji New Village: the two old houses side by side, joined by an inner doorway."""
+    p1=grid('PALLET_TOWN_PLAYERS_HOUSE_1F'); cc=grid('SAFFRON_CITY_COPYCATS_HOUSE_1F')
+    V=0x008|0xC00; W,H=16,10
+    g=new(W,H,0x001)
+    for y in range(H): g[y][0]=V; g[y][8]=V
+    g[H-1]=[V]*W
+    # house A: the start-home look
+    paste(g,crop(p1,1,0,7,3),1,0)
+    for y in range(3,H-1):
+        for x in range(1,8): g[y][x]=0x001
+        g[y][1]=0x009
+    paste(g,crop(p1,4,3,6,4),2,3)
+    paste(g,crop(p1,11,6,1,2),7,7) if False else None
+    g[6][1]=p1[6][1]; g[7][1]=p1[7][1]
+    g[H-2][3:6]=[0x012,0x013,0x014]; g[H-1][3:6]=[0x01a|0xC00,0x01b|0xC00,0x01c|0xC00]
+    # house B: the copycat house look
+    paste(g,crop(grid('SAFFRON_CITY_COPYCATS_HOUSE_2F'),1,0,7,3),9,0)
+    for y in range(3): g[y][7]=p1[y][9]
+    for y in range(3,H-1):
+        for x in range(9,16): g[y][x]=0x0a9
+    paste(g,crop(cc,4,3,6,4),9,3)
+    g[4][15]=cc[4][12]; g[5][15]=cc[5][12]; g[6][15]=cc[6][12]; g[7][15]=cc[7][12]
+    # inner doorway
+    for y in (6,7): g[y][8]=0x001
+    return g,'gTileset_GenericBuilding1'
+
+@room
+def finearts():
+    """Fine Arts Museum: a white gallery. Paintings along the wall, glass sculpture cases, viewing sofas."""
+    c1=grid('CELADON_CITY_CONDOMINIUMS_1F'); c2=grid('CELADON_CITY_CONDOMINIUMS_2F')
+    W,H=15,10; X=0xC00
+    g=new(W,H,0x281)
+    g[0]=[0x289|X]*W; g[1]=[0x291|X]*W; g[2]=[0x282]*W
+    for y in range(3,H-1): g[y][0]=0x282
+    for x in (2,6,10):
+        g[0][x:x+2]=[0x2b8|X,0x2b9|X]; g[1][x:x+2]=[0x2c0|X,0x2c1|X]
+    g[0][12]=0x2ed|X; g[0][13]=0x2ee|X; g[1][12]=0x2f5|X; g[1][13]=0x2f6|X; g[2][12]=0x2ef; g[2][13]=0x2f7
+    for x in (0,14): g[1][x]=0x2ca|X; g[2][x]=0x2d1|X
+    g[1][5]=0x2ca|X; g[2][5]=0x2d1|X; g[1][9]=0x2ca|X; g[2][9]=0x2d1|X
+    case=crop(c1,2,15,2,3)
+    paste(g,case,1,4); paste(g,case,12,4)
+    sofa=[[0x2e5|X,0x2e6|X,0x2e7|X],[0x2e0,0x2e1,0x2e2]]
+    paste(g,sofa,3,6); paste(g,sofa,9,6)
+    g[H-1]=[0x008|X]*W
+    g[H-2][6:9]=[0x2e8,0x2e9,0x2ea]; g[H-1][6:9]=[0x01a|X,0x01b|X,0x01c|X]
+    return g,'gTileset_Condominiums'
+
+@room
+def fengjia():
+    """Fengjia Night Market: stall counters along the north, two rows of arcade game stalls, leader at the main stall."""
+    c=grid('CELADON_CITY_GAME_CORNER')
+    rows=[0,1,2,3,4,5,6,7,10,11,12,13,14]
+    g=[c[y][:] for y in rows]
+    for x in (15,16,17): g[2][x]=0x292
+    return g,'gTileset_GameCorner'
+
+@room
+def theater():
+    """Taichung Theater: the octagonal auditorium. Tiered seating either side, stage stairs to the leader."""
+    c=grid('POKEMON_LEAGUE_CHAMPIONS_ROOM')
+    k=5
+    g=[]
+    for row in c[0:15]:
+        r=row[:5]+[row[4]]*k+row[5:9]+[row[8]]*k+row[9:]
+        g.append(r)
+    W=len(g[0]); cx=W//2
+    g.append([0x008|0xC00]*W)
+    g[14]=[0x008|0xC00]*W; g[14][cx-1:cx+2]=c[14][5:8]
+    g[15][cx-1:cx+2]=[0x174|0xC00,0x175|0xC00,0x176|0xC00]
+    return g,'gTileset_PokemonLeague'
+
+@room
+def wanhe():
+    """Wanhe Temple: worship hall. Red lacquered pillars, wall scrolls, prayer mats, guardian statues at the door."""
+    d=grid('SAFFRON_CITY_DOJO')
+    g=[d[y][:] for y in (0,1,2,3,5,6,7,8,11,12,13,14,15)]
+    return g,'gTileset_PewterGym'
+
+if __name__=='__main__':
+    names=sys.argv[1:] or list(ROOMS)
+    for n in names:
+        g,s=ROOMS[n]()
+        render(g,s,2,coords=True,solid=True).save(S/f'room-{n}.png')
+        print(n,len(g[0]),'x',len(g))
