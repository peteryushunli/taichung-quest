+import ast
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+BASE = '532fdf5f'
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, ROOT / path)
+    result = importlib.util.module_from_spec(spec); spec.loader.exec_module(result)
+    return result
+
+
+guard = load('text_fix_test', 'tools/taichung/encounter_field_fix_guard.py')
+capture = load('text_fix_capture_test', 'tools/taichung/capture_gameplay_guard.py')
+gym = load('text_fix_gym_test', 'tools/taichung/gym_interiors_guard.py')
+
+
+def frozen(revision, path):
+    return subprocess.check_output(['git', 'show', revision + ':' + path], cwd=ROOT)
+
+
+class FieldFixGuardTests(unittest.TestCase):
+    def test_bound_two_inputs_and_exact_underlay(self):
+        r = json.loads((ROOT / guard.MANIFEST).read_text())
+        under = guard.peel(guard.reader(ROOT))
+        self.assertEqual(tuple(under), guard.PATHS)
+        for path in guard.PATHS:
+            self.assertEqual((ROOT / path).read_bytes(), frozen(r['featureCommit'], path))
+            self.assertEqual(under[path], frozen(r['baselineCommit'], path))
+
+    def test_raw_old_guard_stays_strict_and_composed_gym_passes(self):
+        self.assertFalse(capture.check(ROOT)['passed'])
+        self.assertTrue(capture.check(ROOT, guard.peel(guard.reader(ROOT)))['passed'])
+        self.assertTrue(gym.check(ROOT)['passed'])
+
+    def test_old_registration_and_probes_unchanged(self):
+        for path in ('data/taichung/capture-gameplay-guard/registration.json', 'tools/taichung/capture_gameplay_guard.py',
+                     'data/taichung/encounter-save-init/registration.json', 'data/taichung/gym-interiors/manifest.json'):
+            self.assertEqual((ROOT / path).read_bytes(), frozen(BASE, path))
+        path = 'tools/taichung/gym_interiors_guard.py'
+        def probe(text):
+            node = next(n for n in ast.parse(text).body if isinstance(n, ast.FunctionDef) and n.name == 'self_test')
+            return ast.get_source_segment(text, node)
+        self.assertEqual(probe((ROOT / path).read_text()), probe(frozen(BASE, path).decode()))
+
+    def test_corruptions_and_foreign_mutation_are_not_excused(self):
+        self.assertTrue(guard.self_test(ROOT)['passed'])
+        path = 'src/taichung_team.c'
+        raw = (ROOT / path).read_bytes() + b'\n/* foreign edit */\n'
+        self.assertNotIn(path, guard.peel(guard.reader(ROOT, {path: raw})))
+        self.assertFalse(gym.check(ROOT, {path: raw})['passed'])
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
