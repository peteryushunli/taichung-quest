+#!/usr/bin/env python3
+"""One denser revision of the approved old-core pilot; V1 remains untouched."""
+import argparse
+from collections import Counter, deque
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image, ImageDraw
+
+from color_compile import compile_colorways, color_grid, native_tile_images, save_native
+from library import ROOT, WALK, parse_words, require
+from neighborhood_fill import cells, context_for, geometry_helpers
+from neighborhood_pilot import player_reference
+
+
+def density_catalog():
+    """Derive three modular source variants, without changing the 17-item kit."""
+    catalog = json.loads((ROOT / 'data/taichung/prefabs/catalog.json').read_text())
+    source = {p['id']: p for p in catalog['prefabs']}
+    added = []
+    for height, suffix in ((6, 'mid'), (8, 'tall')):
+        p = deepcopy(source['building-walkup-low' if height == 6 else 'building-walkup-tall'])
+        p.update(id=f'building-mixed-use-{suffix}', name=f'{suffix.title()} mixed-use shop house',
+                 role='commercial-frontage', allowedContext=['shopping', 'mixed-use'],
+                 material='source pale masonry / upper homes / broad retail glazing')
+        # Keep the complete roof and paired upper-window bands. Change only
+        # the inner three cells of the last two facade rows to retail glass.
+        for row, ids in ((height - 3, (0x180, 0x181, 0x182)),
+                         (height - 2, (0x194, 0x194, 0x194))):
+            for x, tile in enumerate(ids, 1):
+                p['words'][row][x] = f'0x{0x400 | tile:04X}'
+        p['entrances'][0]['dormantWord'] = '0x0594'
+        p['provenance']['frontagePatch'] = ['General180', 'General181', 'General182', 'General194']
+        p['provenance']['derivedFromPrefab'] = 'building-walkup-low' if height == 6 else 'building-walkup-tall'
+        p['notes'] = 'Source-recombined density blockout, not bespoke Taiwan architecture. Dormant retail entrance below homes.'
+        added.append(p)
+    p = deepcopy(source['building-corner-store'])
+    p.update(id='building-shop-row-pair', name='Paired shop frontage', width=10,
+             material='contiguous source corner-shop bays')
+    p['words'] = [row + row for row in p['words']]
+    p['masks'] = {name: [row + row for row in rows] for name, rows in p['masks'].items()}
+    west, east = deepcopy(p['entrances'][0]), deepcopy(p['entrances'][0])
+    west['id'] = 'west-front'; east['id'] = 'east-front'
+    east['position'][0] += 5; east['southApproach'][0] += 5
+    p['entrances'] = [west, east]
+    p['provenance']['derivedFromPrefab'] = 'building-corner-store'
+    p['provenance']['repeatHorizontal'] = 2
+    p['notes'] = 'Two contiguous source shop bays. Native footprint includes both dormant entrance reservations and one clear apron.'
+    added.append(p)
+    catalog['prefabs'].extend(added)
+    return catalog, [p['id'] for p in added]
+
+
+def compile_density(output, variant_metatile_start=None):
+    output = Path(output); output.mkdir(parents=True, exist_ok=True)
+    catalog, added = density_catalog()
+    recipe = json.loads((ROOT / 'data/taichung/prefabs/colorways.json').read_text())
+    recipe['eligiblePrefabs'].extend(added)
+    recipe_path = output / 'density-colorways.json'
+    recipe_path.write_text(json.dumps(recipe, indent=2) + '\n')
+    (output / 'density-catalog.json').write_text(json.dumps(catalog, indent=2) + '\n')
+    return compile_colorways(catalog=catalog, colorways=recipe_path,
+                             variant_metatile_start=variant_metatile_start)
+
+
+def dilate(points, radius, width, height):
+    return {(x + dx, y + dy) for x, y in points
+            for dx in range(-radius, radius + 1) for dy in range(-radius, radius + 1)
+            if abs(dx) + abs(dy) <= radius and 0 <= x + dx < width and 0 <= y + dy < height}
+
+
+def fill_density(compiled, layout, profile):
+    width, height = layout['width'], layout['height']
+    require((width, height) == (64, 64), 'Only approved 64x64 pilot supported')
+    geo = geometry_helpers()
+    roads = set().union(*(geo.line_cells(r['authoredLocalCenterline'], r['widthTiles']) for r in layout['authoredRoads']))
+    approaches = set().union(*(cells(a['rect']) for a in layout['clearApproaches']))
+    gym_reserves = set().union(*(cells(l['proposedAuthoredLocal']['reserveRect']) for l in layout['landmarks']))
+    gym_art = set().union(*(cells(l['proposedAuthoredLocal']['artRect']) for l in layout['landmarks']))
+    lot_union = set().union(*(cells(l['localRect']) for l in layout['candidateLots']))
+    require(not lot_union & (roads | gym_reserves | approaches), 'Approved lots overlap protected geometry')
+    protected = roads | approaches
+    base = [0x3001] * (width * height)
+    # Authored streetscape only: paving links street-facing lots to the road.
+    # The actual Park envelope and all future gym ground remain byte-identical
+    # to V1; this is not a factual land-cover or municipal parcel claim.
+    sidewalks = (dilate(roads, 2, width, height) | dilate(lot_union, 1, width, height)) - roads - lot_union - gym_reserves - approaches
+    for x, y in sidewalks: base[y * width + x] = 0x31c1
+    for x, y in roads: base[y * width + x] = 0x316e
+    for x, y in approaches: base[y * width + x] = 0x3175
+    for x, y in gym_art: base[y * width + x] = 0x056e
+    lib = compiled['library']; placements = []; lot_records = []; families = Counter(); roles = Counter()
+
+    def add(lot, identity, x, y, family='source', unit='building'):
+        p = lib.prefabs[identity]
+        footprint = cells([x, y, x + p['width'] - 1, y + p['height'] - 1])
+        require(footprint <= cells(lot['localRect']), 'Module including apron exceeds approved lot')
+        placements.append(dict(id=f"{lot['id']}-{unit}", prefab=identity, x=x, y=y,
+                               context=context_for(p, lot['streetBand']), colorway=family,
+                               lotId=lot['id']))
+        return placements[-1]
+
+    for lot in layout['candidateLots']:
+        x0, y0, x1, y1 = lot['localRect']; band = lot['streetBand']; retail = band == 'primaryRetailFrontage'
+        family = 'slate' if x0 >= 44 else 'teal' if x0 >= 28 else 'terracotta'
+        # Coherent runs have controlled exceptions; source blue and cream remain.
+        if lot['id'] == 'pilot-r2c2-lot-2-12': family = 'source'
+        if lot['id'] == 'pilot-r2c2-lot-18-32': family = 'mustard'
+        for x, y in cells(lot['localRect']): base[y * width + x] = 0x316e if retail else 0x31c1
+        start = len(placements)
+        if retail:
+            if lot['width'] >= 10: identity = 'building-shop-row-pair'
+            elif lot['height'] >= 8: identity = 'building-mixed-use-tall'
+            elif lot['height'] >= 6: identity = 'building-mixed-use-mid'
+            else: identity = 'building-corner-store'
+            if lot['id'] == 'pilot-r2c2-lot-8-52':
+                # Deliberate market lane: 2 source stalls, a continuous side
+                # aisle and their own clear service/apron rows inside one lot.
+                for n in range(2): add(lot, 'stall-market-red', x0, y0 + n * 4, unit=f'market-{n + 1}')
+            else:
+                p = lib.prefabs[identity]
+                add(lot, identity, x0, y1 - p['height'] + 1, family)
+        else:
+            if lot['width'] >= 10: identity = 'building-rowhouse-pair'
+            elif lot['height'] >= 8 and (x0 >= 44 or x0 in (30, 28)): identity = 'building-walkup-tall'
+            elif lot['height'] >= 6 and x0 in (22, 36): identity = 'building-walkup-low'
+            else: identity = 'building-rowhouse-compact'
+            p = lib.prefabs[identity]
+            add(lot, identity, x0, y1 - p['height'] + 1, family)
+        units = placements[start:]
+        for p in units: families[p['colorway']] += 1; roles[lib.prefabs[p['prefab']]['role']] += 1
+        lot_records.append(dict(lotId=lot['id'], localRect=lot['localRect'], streetBand=band,
+            units=[p['id'] for p in units], selectedPrefabIds=[p['prefab'] for p in units],
+            colorway=family if units[0]['colorway'] != 'source' else 'source',
+            ground='smooth-paved retail apron' if retail else 'quiet stone courtyard',
+            ageStyle='contemporary/mid-era upper-floor homes' if identity.endswith('tall') and family in ('teal', 'slate') else 'older low-rise or mid-era mixed use',
+            status='authored game character, not surveyed building age/use', decorations=[]))
+
+    def compose(items):
+        bare = [{k: v for k, v in p.items() if k not in ('colorway', 'lotId')} for p in items]
+        return lib.compose(width, height, bare, base=base, protected_paths=protected | sidewalks)
+    composed = compose(placements)
+    # Rear boundaries only where a real court remains. No blanket shrub/sign
+    # scatter, and no strip may cross an apron, adjacent lot or public path.
+    for lot, record in zip(layout['candidateLots'], lot_records):
+        if lot['streetBand'] != 'residentialSideStreet': continue
+        x0, y0, x1, y1 = lot['localRect']
+        building_y = min(p['y'] for p in placements if p['lotId'] == lot['id'])
+        if building_y - y0 < 3: continue
+        p = lib.prefabs['prop-low-brick-edge']
+        candidate = dict(id=lot['id'] + '-rear-boundary', prefab=p['id'], x=x0, y=y0,
+                         context='street-edge', colorway='source', lotId=lot['id'])
+        require(cells([x0, y0, x0 + p['width'] - 1, y0 + p['height'] - 1]) <= cells(lot['localRect']), 'Boundary overflows lot')
+        composed = compose(placements + [candidate]); placements.append(candidate)
+        record['decorations'].append(dict(prefab=p['id'], placement=[x0, y0], purpose='rear court boundary'))
+    words = color_grid(compiled, composed, placements)
+    def attr(word):
+        tile = word & 1023
+        return lib.attr(tile) if tile < 640 else compiled['attributes'][tile - 640]
+    def walk(point):
+        x, y = point
+        if not (0 <= x < width and 0 <= y < height): return False
+        word = words[y * width + x]
+        return not word & 0xc00 and word >> 12 == 3 and attr(word) & 0x1ff in WALK
+    arrivals = [tuple(l['proposedAuthoredLocal']['arrival']) for l in layout['landmarks']]
+    require(walk(arrivals[0]), 'Spawn is blocked')
+    seen = {arrivals[0]}; queue = deque(seen)
+    while queue:
+        x, y = queue.popleft()
+        for point in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+            if point not in seen and walk(point): seen.add(point); queue.append(point)
+    require(protected | sidewalks <= seen, 'Disconnected road, arrival path or new sidewalk')
+    for point in arrivals: require(point in seen, 'Disconnected gym south arrival')
+    for entrance in composed['entrances']:
+        require(entrance['status'] == 'dormant-reservation' and tuple(entrance['southApproach']) in seen, 'Entrance is active or its approach disconnected')
+    for port in layout['independentSeamSuggestions']: require(tuple(port['localPoint']) in seen, 'Disconnected road egress')
+    for placement in placements:
+        p = lib.prefabs[placement['prefab']]; lot = next(l for l in layout['candidateLots'] if l['id'] == placement['lotId'])
+        patch = cells([placement['x'], placement['y'], placement['x'] + p['width'] - 1, placement['y'] + p['height'] - 1])
+        require(patch <= cells(lot['localRect']) and not patch & (protected | gym_reserves), 'Decorative overflow or reservation collision')
+    require(all((a & 0xfc00) == (b & 0xfc00) for a, b in zip(words, composed['words'])), 'Color remap changed collision/elevation')
+    require(not any(attr(w) & 0x1ff in range(0x60, 0x70) for w in words), 'Unregistered active warp behavior')
+    building_cells = {(p['x'] + x, p['y'] + y) for p in placements if lib.prefabs[p['prefab']]['role'] != 'park-edge'
+                      for y, row in enumerate(lib.prefabs[p['prefab']]['masks']['solid']) for x, bit in enumerate(row) if bit == '1'}
+    commercial_lots = set().union(*(cells(l['localRect']) for l in layout['candidateLots'] if l['streetBand'] == 'primaryRetailFrontage'))
+    report = dict(result='pass', status='V2 source-composed density fixture; not registered in ROM',
+        sectionId=layout['sectionId'], dimensions=[width, height], filledLots=len(lot_records),
+        buildingOrStallModules=len(placements) - sum(len(r['decorations']) for r in lot_records),
+        rearCourtBoundaries=sum(len(r['decorations']) for r in lot_records), reachableCells=len(seen),
+        protectedRoadAndApproachCells=len(protected), newSidewalkCells=len(sidewalks),
+        landmarkSouthArrivals=arrivals, ordinaryDormantEntranceApproaches=len(composed['entrances']),
+        roadEgresses=len(layout['independentSeamSuggestions']), decorativeOverflows=0, roadOrGymReserveCollisions=0,
+        lotSolidCoverage=round(len(building_cells) / len(lot_union), 4),
+        commercialLotSolidCoverage=round(len(building_cells & commercial_lots) / len(commercial_lots), 4),
+        sourceLayoutSha256=hashlib.sha256(json.dumps(layout, sort_keys=True).encode()).hexdigest(),
+        profileId=profile['id'], authoredRoleCounts=dict(roles), roofColorCounts=dict(families),
+        nativeBankBudget=compiled['budget'])
+    # V1's output is evidence, never an input mutated by this revision.
+    return dict(words=words, placements=placements, lots=lot_records, report=report,
+                roads=roads, approaches=approaches, gymReserves=gym_reserves, sidewalks=sidewalks)
+
+
+def write_density(output):
+    output = Path(output); compiled = compile_density(output)
+    layout = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json').read_text())
+    profile = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-profile.json').read_text())['section']
+    result = fill_density(compiled, layout, profile); words = result['words']; report = result['report']
+    width, height = report['dimensions']; tiles = native_tile_images(compiled, {w & 1023 for w in words})
+    image = Image.new('RGB', (width * 16, height * 16))
+    for i, word in enumerate(words): image.paste(tiles[word & 1023], (i % width * 16, i // width * 16))
+    sprite = player_reference(ROOT)
+    if sprite:
+        x, y = report['landmarkSouthArrivals'][0]; image.paste(sprite, (x * 16, y * 16 - 16), sprite)
+    image.save(output / 'filled-block-native.png')
+    image.crop((0, 26 * 16, 32 * 16, 50 * 16)).save(output / 'density-detail-32x24.png')
+    board = Image.new('RGB', (1024, 1120), '#e9efeb'); board.paste(image, (0, 64)); draw = ImageDraw.Draw(board)
+    draw.text((12, 10), 'R2C2 OLD CORE / V2 DENSER STREETSCAPE / SAME 24 APPROVED LOTS', fill='#19392f')
+    draw.text((12, 28), 'Continuous retail bays + homes above; paved commercial aprons; quieter residential stone courts and rear walls.', fill='#365a4b')
+    draw.text((12, 46), 'Source-native art blockout. Authored building use/age/materials; not surveyed parcels or finished Taiwan architecture.', fill='#365a4b')
+    for landmark in layout['landmarks']:
+        r = landmark['proposedAuthoredLocal']['artRect']; box = (r[0] * 16, r[1] * 16 + 64, (r[2] + 1) * 16 - 1, (r[3] + 1) * 16 + 63)
+        draw.rectangle(box, outline='#ab642b', width=2)
+        draw.text((box[0] + 4, box[1] + 5), landmark['name'], fill='#6b452b')
+        draw.text((box[0] + 4, box[1] + 20), 'GYM ART RESERVE', fill='#6b452b')
+    draw.text((12, 1090), 'Roads, gym reserves and all 3 south arrivals preserved. Source palette12 color encoding; V1 preview retained separately.', fill='#365a4b')
+    board.save(output / 'filled-block-overview.png')
+    (output / 'filled-map.bin').write_bytes(struct.pack(f'<{len(words)}H', *words))
+    (output / 'placements.json').write_text(json.dumps(dict(schemaVersion=1, sectionId=layout['sectionId'], placements=result['placements'], lots=result['lots']), indent=2) + '\n')
+    (output / 'validation.json').write_text(json.dumps(report, indent=2) + '\n')
+    save_native(compiled, output / 'native-color-bank')
+    print(json.dumps({k: v for k, v in report.items() if k != 'nativeBankBudget'}, indent=2))
+    print(output / 'filled-block-overview.png')
+    return compiled, result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    write_density(parser.parse_args().output)
