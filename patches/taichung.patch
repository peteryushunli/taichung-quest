+++ b/data/scripts/taichung_encounters.inc
@@ -0,0 +1,104 @@
+@ Stable interaction API: VAR_0x8004 = site ID. Maps can bind the wrappers below
+@ at new positions without changing state IDs, species, persistence or battles.
+TaichungEncounter_Interact::
+	lockall
+	goto_if_questlog TaichungEncounter_Leave
+	copyvar VAR_0x8007, VAR_0x8004
+TaichungEncounter_Offer::
+	callnative TaichungEncounter_ScriptOffer
+	goto_if_eq VAR_RESULT, TRUE, TaichungEncounter_MessageAndLeave
+	message gStringVar4
+	waitmessage
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_ENCOUNTER, FALSE
+TaichungEncounter_HandleChoice::
+	goto_if_eq VAR_RESULT, 0, TaichungEncounter_Prepare
+	goto_if_eq VAR_RESULT, 1, TaichungEncounter_Begin
+	goto TaichungEncounter_Leave
+
+@ Native menu return restores the site before entering this script. Keep Begin
+@ selected after preparation, including when the player used its party screen.
+TaichungEncounter_OfferPrepared::
+	lockall
+	callnative TaichungEncounter_ScriptOffer
+	goto_if_eq VAR_RESULT, TRUE, TaichungEncounter_MessageAndLeave
+	message gStringVar4
+	waitmessage
+	multichoicedefault 0, 0, MULTICHOICE_TAICHUNG_ENCOUNTER, 1, FALSE
+	goto TaichungEncounter_HandleChoice
+
+TaichungEncounter_Prepare::
+	closemessage
+	callnative TaichungEncounter_ScriptOpenTeam
+	waitstate
+	goto TaichungEncounter_Offer
+
+TaichungEncounter_Begin::
+	callnative TaichungEncounter_ScriptBegin
+	goto_if_eq VAR_RESULT, FALSE, TaichungEncounter_MessageAndLeave
+	closemessage
+	callnative TaichungEncounter_ScriptSaveBegin
+	waitstate
+@ The native battle return saves the outcome during field fade, then enters
+@ Result explicitly after the matching durable ACK. It never needs reinteraction.
+TaichungEncounter_Result::
+	lockall
+	callnative TaichungEncounter_ScriptResult
+	goto_if_eq VAR_RESULT, TRUE, TaichungEncounter_OfferCaught
+	goto TaichungEncounter_MessageAndLeave
+TaichungEncounter_OfferCaught::
+	msgbox gStringVar4, MSGBOX_YESNO
+	goto_if_ne VAR_RESULT, YES, TaichungEncounter_Leave
+	closemessage
+	callnative TaichungEncounter_ScriptAddCaught
+	goto_if_ne VAR_RESULT, TRUE, TaichungEncounter_MessageAndLeave
+	msgbox gStringVar4
+	closemessage
+	callnative TaichungEncounter_ScriptChooseReplacement
+	waitstate
+TaichungEncounter_ConfirmReplacement::
+	lockall
+	callnative TaichungEncounter_ScriptConfirmReplacement
+	goto_if_ne VAR_RESULT, TRUE, TaichungEncounter_Leave
+	msgbox gStringVar4, MSGBOX_YESNO
+	goto_if_ne VAR_RESULT, YES, TaichungEncounter_Leave
+	closemessage
+	callnative TaichungEncounter_ScriptReplaceWithCaught
+TaichungEncounter_MessageAndLeave::
+	msgbox gStringVar4
+TaichungEncounter_Leave::
+	closemessage
+	releaseall
+	end
+
+	.macro taichung_encounter_entry name, site
+	.global TaichungEncounter_\name\()
+TaichungEncounter_\name\():
+	setvar VAR_0x8004, \site
+	goto TaichungEncounter_Interact
+	.endm
+	taichung_encounter_entry MapleGarden, TAICHUNG_ENCOUNTER_VENUSAUR
+	taichung_encounter_entry WenchangTemple, TAICHUNG_ENCOUNTER_WENCHANG_TEMPLE
+	taichung_encounter_entry BotanicalGarden, TAICHUNG_ENCOUNTER_LAPRAS
+	taichung_encounter_entry ShenJi, TAICHUNG_ENCOUNTER_SHEN_JI
+	taichung_encounter_entry YizhongStreet, TAICHUNG_ENCOUNTER_YIZHONG_STREET
+	taichung_encounter_entry PrefecturalHall, TAICHUNG_ENCOUNTER_PREFECTURAL_HALL
+	taichung_encounter_entry SecondMarket, TAICHUNG_ENCOUNTER_SECOND_MARKET
+	taichung_encounter_entry CulturalHeritagePark, TAICHUNG_ENCOUNTER_CULTURAL_HERITAGE_PARK
+	taichung_encounter_entry FengleSculpturePark, TAICHUNG_ENCOUNTER_FENGLE_SCULPTURE_PARK
+	taichung_encounter_entry WenxinForestPark, TAICHUNG_ENCOUNTER_WENXIN_FOREST_PARK
+	taichung_encounter_entry GreenMuseumbrary, TAICHUNG_ENCOUNTER_GREEN_MUSEUMBRARY
+	taichung_encounter_entry RainbowVillage, TAICHUNG_ENCOUNTER_RAINBOW_VILLAGE
+	taichung_encounter_entry CityHall, TAICHUNG_ENCOUNTER_CITY_HALL
+	taichung_encounter_entry JingmingStreet, TAICHUNG_ENCOUNTER_CHARIZARD
+	taichung_encounter_entry TigerCity, TAICHUNG_ENCOUNTER_TIGER_CITY
+	taichung_encounter_entry Ballpark, TAICHUNG_ENCOUNTER_BALLPARK
+	taichung_encounter_entry FolklorePark, TAICHUNG_ENCOUNTER_FOLKLORE_PARK
+
+	taichung_encounter_entry NationalTradeCenter, TAICHUNG_ENCOUNTER_NATIONAL_TRADE_CENTER
+	taichung_encounter_entry DingShengBHW, TAICHUNG_ENCOUNTER_BLASTOISE
+	taichung_encounter_entry TheLin, TAICHUNG_ENCOUNTER_THE_LIN
+
+@ Retired Temple symbol stays link-compatible without a second capture route.
+TaichungEncounter_ConfuciusTemple::
