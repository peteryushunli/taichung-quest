+@ Ten incidental outdoor voices; Maps owns anchors, movement and sprites.
+@ Include from the global Taichung scripts. No persistent variables are touched.
+	.macro taichung_ambient_npc name
+	.global TaichungBoulevard_Ambient_\name\()
+TaichungBoulevard_Ambient_\name\():
+	lock
+	faceplayer
+	goto_if_questlog TaichungBoulevard_Ambient_\name\()Done
+	callnative TaichungAmbient_Buffer\name
+	msgbox gStringVar4
+TaichungBoulevard_Ambient_\name\()Done:
+	release
+	end
+	.endm
