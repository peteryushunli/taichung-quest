index 00000000..cdedca1d
--- /dev/null
+++ b/tools/taichung_gameplay/test-battle-ai.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Real scoring policy, move data, RNG and native tie selector at scored-turn boundary."""
+import importlib.util
+from pathlib import Path
+import re
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/ai"
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("extract", ROOT / "tools/taichung_gameplay/test-save-facing.py")
+extract = importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+source = (ROOT / "src/battle_ai_script_commands.c").read_text()
+selector = extract.definition(source, "BattleAI_ChooseMoveOrAction")[0]
+hook = "    TaichungBattleAI_AdjustScores(AI_THINKING_STRUCT->score, gBattlerAttacker);\n"
+assert selector.count(hook) == 1
+baseline = selector.replace(hook, "").replace("BattleAI_ChooseMoveOrAction", "BaselineChoose", 1)
+rng = extract.definition((ROOT / "src/random.c").read_text(), "Random")[0]
+(OUT / "native-selector.inc").write_text(rng + "\n" + baseline + "\n" + selector)
+subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-unknown-attributes", "-Wno-pointer-to-int-cast", "-Wno-int-to-pointer-cast",
+    "-I"+str(ROOT/"include"), "-I"+str(ROOT/"src"), "-I"+str(OUT), str(ROOT/"src/taichung_battle_ai.c"),
+    str(ROOT/"tests/taichung_ai_test.c"), "-o", str(OUT/"battle-ai")], check=True)
+result = subprocess.run([str(OUT/"battle-ai")], capture_output=True, text=True)
+(OUT/"battle-ai.log").write_text(result.stdout+result.stderr)
+assert result.returncode == 0, result.stdout+result.stderr
+print(result.stdout.strip())
+trainers = (ROOT/"src/data/trainers.h").read_text()
+entries = dict(re.findall(r"\[(TRAINER_TAICHUNG_\w+)\] = \{(.*?)\n    \},", trainers, re.S))
+registered = set(re.findall(r"TRAINER_TAICHUNG_\w+", (ROOT/"src/taichung_gym_progress.c").read_text().split("sLandmarkTrainers",1)[1].split("};",1)[0]))
+leaders = [entries[key] for key in registered]
+assert len(leaders) == 10
+for body in leaders:
+    flags = re.search(r"\.aiFlags = (.*?),", body)[1]
+    assert set(re.findall(r"AI_SCRIPT_\w+", flags)) == {"AI_SCRIPT_CHECK_BAD_MOVE", "AI_SCRIPT_CHECK_VIABILITY", "AI_SCRIPT_TRY_TO_FAINT"}
+for body in entries.values():
+    if ".trainerClass = TRAINER_CLASS_LEADER," not in body:
+        assert re.search(r"\.aiFlags = (.*?),", body)[1] == "AI_SCRIPT_CHECK_BAD_MOVE"
+scripts = (ROOT/"data/battle_ai_scripts.s").read_text()
+cbm = scripts.split("AI_CBM_DefenseUp::",1)[1].split("\n\n",1)[0]
+assert "STAT_DEF, 12" in cbm and "STAT_DEF, 8" not in cbm
+cv = scripts.split("AI_CheckViability::",1)[1].split("\n\tend",1)[0]
+assert "EFFECT_DEFENSE_CURL" not in cv # Standard viability cannot fix this gap alone.
+assert "\tscore +4" in scripts.split("AI_TryToFaint_ScoreUp4::",1)[1].split("\n\n",1)[0]
+wild = extract.definition(source,"BattleAI_SetupAIData")[0].split("if (gBattleTypeFlags & BATTLE_TYPE_WILD_SCRIPTED)",1)[1].split("else if",1)[0]
+assert "aiFlags = AI_SCRIPT_CHECK_BAD_MOVE;" in wild
+print("PASS:ten leader flag profiles, unchanged street/scripted-wild flags, actual CBM cap/DefenseCurl viability gap and native finishing+4 contract")
