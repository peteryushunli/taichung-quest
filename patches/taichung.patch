index 0000000..12b3e22
--- /dev/null
+++ b/tools/taichung_gameplay/extend-chinese-glyphs.py
@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+"""Append missing native Chinese glyphs without renumbering released mappings.
+
+Dry-run by default: writes only an explicit artifact report. --write additionally
+appends charmap entries and inserts new header rows before the existing closing
+brace. Existing charmap bytes and every existing header row remain unchanged.
+No parent generator, translation source, menu table, download or build is run.
+
+Uses the configured pinned bitmap source without Pillow or network access.
+Older copied fixtures without a manifest can explicitly pass their pinned
+NotoSansTC.ttf via --font, with Pillow installed.
+"""
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+
+_FONT_SPEC = importlib.util.spec_from_file_location('taichung_chinese_glyph_font', Path(__file__).with_name('chinese_glyph_font.py'))
+_FONT_MODULE = importlib.util.module_from_spec(_FONT_SPEC)
+_FONT_SPEC.loader.exec_module(_FONT_MODULE)
+glyph_records, load_font = _FONT_MODULE.glyph_records, _FONT_MODULE.load_font
+
+
+FONT_SHA256 = "864727d210d54f2537bbe23b3a839436c3992af72de9322af5270897246bd44f"
+LITERAL = re.compile(r"^'(.)'[ \t]*=[ \t]*([^\r\n]+)", re.M)
+ROW = re.compile(r"^[ \t]*\{([^}\r\n]+)\},[ \t]*//[ \t]*(\d+): (.)[ \t]*\r?$", re.M)
+C_STRING = re.compile(r'_\([ \t]*("(?:\\[^\r\n]|[^"\\\r\n])*")[ \t]*\)')
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def is_chinese(character):
+    code = ord(character)
+    return 0x3400 <= code <= 0x9FFF or 0x3000 <= code <= 0x303F or code == 0x30FB or 0xFF00 <= code <= 0xFFEF
+
+
+def parse_existing(charmap_bytes, header_bytes):
+    charmap, header = charmap_bytes.decode("utf-8"), header_bytes.decode("utf-8")
+    mappings, by_index = {}, {}
+    for match in LITERAL.finditer(charmap):
+        character, encoded = match.groups()
+        if character in mappings:
+            raise ValueError(f"Duplicate charmap character: {character}")
+        tokens = encoded.split("@", 1)[0].split()
+        if not tokens or any(not re.fullmatch(r"[0-9a-fA-F]{2}", token) for token in tokens):
+            raise ValueError(f"Unrecognized literal charmap encoding: {match[0]}")
+        code = tuple(int(token, 16) for token in tokens)
+        mappings[character] = code
+        if code[:2] == (0xFC, 0x19):
+            if len(code) != 4 or not all(1 <= digit <= 240 for digit in code[2:]):
+                raise ValueError(f"Invalid FC19 base240 digits: {character}")
+            index = code[2] - 1 + (code[3] - 1) * 240
+            if index in by_index:
+                raise ValueError(f"Duplicate Chinese glyph index: {index}")
+            by_index[index] = character
+    table = re.search(r"^static const u16 sTaichungChineseGlyphs\[\]\[14\] = \{\r?\n", header, re.M)
+    if not table:
+        raise ValueError("Unrecognized Chinese glyph table declaration")
+    closing = re.search(r"^\};[ \t]*(?:\r?\n)?", header[table.end():], re.M)
+    if not closing:
+        raise ValueError("Missing Chinese glyph table closing brace")
+    close_at = table.end() + closing.start()
+    body = header[table.end():close_at]
+    rows = []
+    for match in ROW.finditer(body):
+        values, number, character = match.groups()
+        tokens = [token.strip() for token in values.split(",")]
+        if len(tokens) != 14 or any(not re.fullmatch(r"0x[0-9a-fA-F]{1,3}", token) for token in tokens):
+            raise ValueError(f"Glyph {number} must contain fourteen 12-bit row masks")
+        masks = [int(token, 16) for token in tokens]
+        if any(mask > 0xFFF for mask in masks) or not any(masks):
+            raise ValueError(f"Glyph {number} has invalid or blank row masks")
+        index = len(rows)
+        if int(number) != index or by_index.get(index) != character:
+            raise ValueError(f"Header/charmap mismatch at index {index}: comment {number}, character {character}")
+        rows.append({"character": character, "index": index, "line": match[0], "masks": masks})
+    if ROW.sub("", body).strip() or set(by_index) != set(range(len(rows))):
+        raise ValueError("Chinese table has unrecognized rows, holes or unmatched FC19 indices")
+    if len({row["character"] for row in rows}) != len(rows):
+        raise ValueError("Duplicate Chinese header character")
+    return {"mappings": mappings, "rows": rows, "header": header, "closeAt": close_at}
+
+
+def native_sources(game):
+    sources = [game / "src/start_menu.c", *sorted((game / "src").glob("taichung*.c"))]
+    snapshots, characters = {}, set()
+    for path in sources:
+        raw = path.read_bytes()
+        snapshots[path] = raw
+        for match in C_STRING.finditer(raw.decode("utf-8")):
+            characters.update(filter(is_chinese, match[1]))
+    return snapshots, characters
+
+
+def render_glyphs(font_path, characters, first_index):
+    """Retain the existing helper signature with this checkout's pinned source."""
+    return glyph_records(load_font(Path(__file__).resolve().parents[2], font_path), characters, first_index)
+
+
+def extend(charmap_bytes, header_bytes, existing, additions):
+    if not additions:
+        return charmap_bytes, header_bytes
+    charmap = charmap_bytes.decode("utf-8")
+    newline = "\r\n" if "\r\n" in charmap else "\n"
+    suffix = "" if charmap.endswith("\n") else newline
+    for row in additions:
+        suffix += f"'{row['character']}' = " + " ".join(f"{value:02X}" for value in row["encoding"]) + newline
+    header = existing["header"]
+    header_newline = "\r\n" if "\r\n" in header else "\n"
+    rows = "".join("    {" + ", ".join(f"0x{value:03x}" for value in row["masks"])
+                   + f"}}, // {row['index']}: {row['character']}" + header_newline for row in additions)
+    return (charmap + suffix).encode("utf-8"), (header[:existing["closeAt"]] + rows + header[existing["closeAt"]:]).encode("utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--game", type=Path, default=Path(__file__).resolve().parents[2], help="Native checkout, or a copied fixture for testing")
+    parser.add_argument("--font", type=Path, help="Legacy pinned Noto file only when the checkout has no bitmap manifest")
+    parser.add_argument("--artifacts", type=Path, required=True, help="Explicit output directory for the append-only review report")
+    parser.add_argument("--write", action="store_true", help="Write validated append-only candidates; default is report-only dry-run")
+    args = parser.parse_args()
+    game = args.game.resolve()
+    charmap_path, header_path = game / "charmap.txt", game / "src/data/taichung_glyphs.h"
+    charmap_bytes, header_bytes = charmap_path.read_bytes(), header_path.read_bytes()
+    existing = parse_existing(charmap_bytes, header_bytes)
+    font = load_font(game, args.font)
+    if font.metadata['provider'] == 'bdf-gzip':
+        for row in existing['rows']:
+            if font.render(row['character']) != row['masks']:
+                raise ValueError('Existing glyphs disagree with the configured bitmap font; run refresh-chinese-glyphs.py first')
+    sources, corpus = native_sources(game)
+    missing = sorted(corpus - set(existing["mappings"]))
+    additions = glyph_records(font, missing, len(existing["rows"]))
+    new_charmap, new_header = extend(charmap_bytes, header_bytes, existing, additions)
+    candidate = parse_existing(new_charmap, new_header)
+    preserved_indices = all(candidate["mappings"].get(char) == code for char, code in existing["mappings"].items())
+    preserved_rows = candidate["rows"][:len(existing["rows"])] == existing["rows"]
+    if not new_charmap.startswith(charmap_bytes) or not preserved_indices or not preserved_rows:
+        raise ValueError("Append-only validation failed; refusing to write")
+    if args.write:
+        current_sources, _ = native_sources(game)
+        if current_sources != sources or charmap_path.read_bytes() != charmap_bytes or header_path.read_bytes() != header_bytes:
+            raise ValueError("Inputs changed during preparation; rerun on the current source")
+        if additions:
+            charmap_path.write_bytes(new_charmap)
+            header_path.write_bytes(new_header)
+    report = {
+        "mode": "write" if args.write else "dry-run", "game": str(game),
+        "fontSha256": font.metadata['fontSha256'], "rendering": font.metadata['rendering'],
+        "fontSource": font.metadata,
+        "encoding": "FC 19 (index%240+1) (index//240+1)",
+        "existingGlyphCount": len(existing["rows"]), "addedGlyphCount": len(additions), "glyphCount": len(candidate["rows"]),
+        "allOldMappingsUnchanged": preserved_indices, "allOldHeaderRowsByteIdentical": preserved_rows,
+        "originalCharmapBytesPreservedAsPrefix": new_charmap.startswith(charmap_bytes),
+        "sourceSha256": {str(path.relative_to(game)): sha256(raw) for path, raw in sources.items()},
+        "before": {"charmapSha256": sha256(charmap_bytes), "headerSha256": sha256(header_bytes)},
+        "candidate": {"charmapSha256": sha256(new_charmap), "headerSha256": sha256(new_header)},
+        "additions": [{**row, "masks": [f"0x{value:03x}" for value in row["masks"]]} for row in additions],
+        "scope": "Only physical single-line _(\"...\") literals in start_menu.c and src/taichung*.c; existing native punctuation mappings retained. No parent generator, menu/translation regeneration, download or build.",
+    }
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    report_path = args.artifacts / "extend-chinese-glyphs.json"
+    report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
+    print(json.dumps({"mode": report["mode"], "existing": report["existingGlyphCount"], "added": len(additions),
+                      "characters": "".join(missing), "preservedOldMappingsAndRows": True, "report": str(report_path)}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, UnicodeError) as error:
+        raise SystemExit(str(error))
diff --git a/tools/taichung_gameplay/generate-approved-art-save.py b/tools/taichung_gameplay/generate-approved-art-save.py
