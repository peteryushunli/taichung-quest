+#!/usr/bin/env python3
+"""Tile-efficient redraws of new landmarks, counted against the tiles their map really has.
+
+`landmark_tiles.py` fits the board's free-drawn set pieces and so gives an upper bound. These
+redraws are built for the tile budget instead:
+
+- whole cells reuse existing metatiles (Miyahara's brick and arcade for the Prefectural Hall,
+  Greenway's grass and flowers for the Botanical Garden);
+- a reused metatile's top layer can sit on a different ground, which costs a definition but no tile;
+- new art is drawn on the 8x8 grid in one palette per tile, with colour 0 transparent over the
+  ground metatile's bottom layer, and repeats and mirrors so that equal tiles are stored once.
+
+Each landmark is counted as new 8x8 tiles (distinct under flips, not already in either tileset)
+and new metatile definitions. The renders go into the draft PNGs through `render()`.
+
+Old City North is a new map with a new secondary. Its landmarks are drawn on the Old City
+primary with the city kit installed (read from `--kit-ref`, so the kit's pond and bridge pieces
+count as free), and its secondary is assumed to start with Old City's palettes 7-12. Every
+tile its landmarks use that is not in that primary takes a slot in the new secondary, whether
+it is new art or copied from Old City.
+
+  python3 tools/taichung/rework/landmark_redraw.py --output-dir DIR [--sheet PNG] [--kit-ref REF]
+
+Requires Pillow, NumPy and git. It writes no game data.
+"""
+
+import argparse
+import json
+import subprocess
+import sys
+import tarfile
+import tempfile
+from io import BytesIO
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageOps
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import render_maps as native  # noqa: E402
+import landmark_tiles  # noqa: E402
+
+TILE = 16
+KIT_REF = "claude/city-kit"
+KIT_PATHS = ["src/data/tilesets", "src/graphics.c", "data/tilesets/primary/taichung_old_core",
+             "data/tilesets/secondary/taichung_old_core"]
+_KIT = {}
+
+
+def kit_source(source, ref=KIT_REF):
+    """A scratch source tree with the city kit's Old City primary, from git."""
+    if ref not in _KIT:
+        sha = subprocess.run(["git", "-C", str(source), "rev-parse", "--short", ref], check=True, capture_output=True, text=True).stdout.strip()
+        raw = subprocess.run(["git", "-C", str(source), "archive", ref, *KIT_PATHS], check=True, capture_output=True).stdout
+        folder = tempfile.TemporaryDirectory(prefix="kit-")
+        tarfile.open(fileobj=BytesIO(raw)).extractall(folder.name)
+        _KIT[ref] = (folder, Path(folder.name), sha)
+    return _KIT[ref][1], _KIT[ref][2]
+
+
+class Tiles:
+    """Indexed tile graphics, palettes and metatile layers of one primary + secondary pair."""
+
+    def __init__(self, source, primary, secondary, fresh=False):
+        """`fresh`: the map gets a new secondary, so only primary tiles are free."""
+        self.fresh = fresh
+        sets = [native.tileset_paths(source, name) for name in (primary, secondary)]
+        self.pixels = [np.array(Image.open(s["tiles"]), dtype=np.uint8) for s in sets]
+        self.palettes = []
+        for p in range(16):
+            lines = (sets[0 if p < 7 else 1]["palettes"] / f"{p:02}.pal").read_text().splitlines()[3:]
+            self.palettes.append(np.array([list(map(int, l.split())) for l in lines if l.strip()][:16], dtype=np.uint8))
+        self.defs = [native.words(s["metatiles"]) for s in sets]
+        self.primary_known, self.secondary_known = set(), set()
+        for px, known in zip(self.pixels, (self.primary_known, self.secondary_known)):
+            for ty in range(px.shape[0] // 8):
+                for tx in range(px.shape[1] // 8):
+                    known.add(landmark_tiles.canonical(px[ty * 8:ty * 8 + 8, tx * 8:tx * 8 + 8]))
+        self.known = self.primary_known | self.secondary_known
+        self.metatiles = {self.render_layers(self.layers(m)).tobytes() for m in range(640 + len(self.defs[1]) // 8)}
+
+    def layers(self, metatile):
+        d = self.defs[0][metatile * 8:metatile * 8 + 8] if metatile < 640 else self.defs[1][(metatile - 640) * 8:(metatile - 640) * 8 + 8]
+        return [list(d[:4]), list(d[4:])]
+
+    def tile(self, word):
+        """(indices, palette) of a metatile word, flips applied."""
+        n = word & 0x3FF
+        px = self.pixels[0 if n < 640 else 1]
+        n = n if n < 640 else n - 640
+        cols = px.shape[1] // 8
+        a = px[n // cols * 8:n // cols * 8 + 8, n % cols * 8:n % cols * 8 + 8]
+        if word & 0x400:
+            a = a[:, ::-1]
+        if word & 0x800:
+            a = a[::-1, :]
+        return a, word >> 12
+
+    def render_layers(self, layers):
+        """16x16 RGB of a bottom layer (words) and a top layer (words or (indices, palette) pairs)."""
+        out = np.zeros((16, 16, 3), dtype=np.uint8)
+        for li, layer in enumerate(layers):
+            for q, item in enumerate(layer):
+                if item is None:
+                    continue
+                a, p = self.tile(item) if isinstance(item, int) else item
+                block = out[q // 2 * 8:q // 2 * 8 + 8, q % 2 * 8:q % 2 * 8 + 8]
+                mask = (a != 0) | (li == 0)
+                block[mask] = self.palettes[p][a][mask]
+        return Image.fromarray(out, "RGB")
+
+
+class Piece:
+    """A landmark on a grid of 16 px cells. `art` is RGBA at full size, drawn in palette colours."""
+
+    def __init__(self, bank, w, h, ground):
+        self.bank, self.w, self.h = bank, w, h
+        self.cells = [[("meta", ground)] * w for _ in range(h)]
+        self.art = Image.new("RGBA", (w * TILE, h * TILE), (0, 0, 0, 0))
+        self.ground = ground
+
+    def meta(self, x, y, metatile):
+        self.cells[y][x] = ("meta", metatile)
+
+    def relayer(self, x, y, metatile, ground=None, mirror=False):
+        """An existing metatile's top layer on another ground, mirrored if asked: a new
+        definition, no new tile."""
+        self.cells[y][x] = ("relayer", metatile, mirror, ground if ground is not None else self.ground)
+
+    def new(self, x, y, ground=None):
+        self.cells[y][x] = ("new", ground if ground is not None else self.ground)
+
+    def build(self, prefer=()):
+        """Render, and count new tiles and metatile definitions."""
+        bank = self.bank
+        self.prefer = prefer
+        art = np.array(self.art)
+        out = Image.new("RGB", (self.w * TILE, self.h * TILE))
+        used, new_meta, problems = {}, set(), []
+
+        def use(items):
+            for item in items:
+                if item is not None:
+                    a, p = bank.tile(item) if isinstance(item, int) else item
+                    used.setdefault(landmark_tiles.canonical(a), (a, p))
+
+        for y in range(self.h):
+            for x in range(self.w):
+                cell = self.cells[y][x]
+                if cell[0] == "meta":
+                    layers = bank.layers(cell[1])
+                    out.paste(bank.render_layers(layers), (x * TILE, y * TILE))
+                    use(layers[0] + layers[1])
+                    continue
+                bottom = bank.layers(cell[-1])[0]
+                if cell[0] == "relayer":
+                    top = bank.layers(cell[1])[1]
+                    if cell[2]:
+                        top = [top[i] ^ 0x400 for i in (1, 0, 3, 2)]
+                else:
+                    top = []
+                    for q in range(4):
+                        block = art[y * TILE + q // 2 * 8:y * TILE + q // 2 * 8 + 8, x * TILE + q % 2 * 8:x * TILE + q % 2 * 8 + 8]
+                        tile = self.quantise(block, prefer)
+                        if tile is None:
+                            problems.append([x, y, q])
+                            top.append(None)
+                            continue
+                        top.append(tile if tile[0].any() else None)
+                image = bank.render_layers([bottom, top])
+                use(bottom + top)
+                out.paste(image, (x * TILE, y * TILE))
+                if image.tobytes() not in bank.metatiles:
+                    new_meta.add(image.tobytes())
+        self.render = out
+        new = {k: v for k, v in used.items() if k not in bank.known}
+        copied = {k: v for k, v in used.items() if k in bank.secondary_known and k not in bank.primary_known}
+        self.stats = {"sizeCells": [self.w, self.h], "newTiles": len(new), "newMetatiles": len(new_meta),
+                      "palettes": sorted({p for _, p in new.values()}), "unfittedTiles": problems}
+        if bank.fresh:
+            self.stats.update({"copiedFromOldCore": len(copied), "newSecondaryTiles": len(new) + len(copied)})
+        self.new_tiles = new
+        self.secondary_tiles = set(new) | set(copied) if bank.fresh else set(new)
+        return self
+
+    def quantise(self, block, prefer):
+        """Indices for an 8x8 RGBA block: alpha 0 is colour 0; colours must all sit in one palette."""
+        opaque = block[..., 3] > 0
+        if not opaque.any():
+            return np.zeros((8, 8), dtype=np.uint8), prefer[0] if prefer else 0
+        colours = {tuple(c) for c in block[opaque][:, :3]}
+        for p in list(prefer) + list(range(13)):
+            pal = [tuple(c) for c in self.bank.palettes[p]]
+            if all(c in pal[1:] for c in colours):
+                idx = np.zeros((8, 8), dtype=np.uint8)
+                for yy in range(8):
+                    for xx in range(8):
+                        if opaque[yy, xx]:
+                            idx[yy, xx] = pal.index(tuple(block[yy, xx, :3]), 1)
+                return idx, p
+        return None
+
+
+def colours(bank, p):
+    return {i: tuple(int(v) for v in bank.palettes[p][i]) + (255,) for i in range(16)}
+
+
+def mirror_left(img, axis):
+    """Copy the left half (x < axis) mirrored onto the right of `axis`, in place."""
+    left = img.crop((0, 0, axis, img.height))
+    img.alpha_composite(ImageOps.mirror(left), (axis, 0))
+
+
+# --- 16 Taichung Prefectural Hall (Old City, 10x10) -------------------------------------------
+
+def prefectural_hall(bank):
+    """Red-brick wings with grey-white bands under a dark grey mansard with dormers; a white
+    corner entrance block with a carriage porch and a low dome; a central lawn.
+    Brick storeys and the porch reuse Miyahara's tiles (0x367-0x376)."""
+    P = colours(bank, 7)
+    pave, grass = 0x175, 0x001
+    piece = Piece(bank, 10, 10, pave)
+    d = ImageDraw.Draw(piece.art)
+    # Wing, x 48-159: mansard rows 1-2 (new), brick storeys rows 3-4 (Miyahara), shadow row 5.
+    wing = range(3, 10)
+    for x in wing:
+        piece.new(x, 1)
+        piece.new(x, 2)
+    upper = [0x368, 0x369, 0x36A, 0x368, 0x369, 0x36A]
+    lower = [0x370, 0x371, 0x372, 0x370, 0x371, 0x372]
+    for x, a, b in zip(wing, upper, lower):
+        piece.relayer(x, 3, a)
+        piece.relayer(x, 4, b)
+    piece.relayer(9, 3, 0x367, mirror=True)  # Miyahara's west end, mirrored, closes the wing
+    piece.relayer(9, 4, 0x36F, mirror=True)
+    roof = Image.new("RGBA", (16, 32), (0, 0, 0, 0))  # one 16 px bay of mansard, rows 1-2
+    r = ImageDraw.Draw(roof)
+    r.line((0, 1, 15, 1), fill=P[1])
+    r.line((0, 2, 15, 2), fill=P[4])
+    r.rectangle((0, 3, 15, 23), fill=P[3])
+    for yy in range(6, 23, 4):  # slate courses
+        r.line((0, yy, 15, yy), fill=P[2])
+    # Dormer centred in the bay's first tile: white frame, round-headed window.
+    r.rectangle((1, 7, 6, 19), fill=P[15])
+    r.line((2, 6, 5, 6), fill=P[15])
+    r.rectangle((2, 9, 5, 17), fill=P[11])
+    r.line((3, 8, 4, 8), fill=P[11])
+    r.line((1, 20, 6, 20), fill=P[1])
+    # Eaves and the grey-white cornice band.
+    r.line((0, 24, 15, 24), fill=P[1])
+    r.rectangle((0, 25, 15, 28), fill=P[15])
+    r.line((0, 28, 15, 28), fill=P[4])
+    r.rectangle((0, 29, 15, 31), fill=P[6])
+    r.line((0, 31, 15, 31), fill=P[5])
+    for x in wing:
+        piece.art.alpha_composite(roof, (x * TILE, 16))
+    # Right end of the wing roof.
+    d.rectangle((158, 17, 159, 47), fill=(0, 0, 0, 0))
+    d.line((157, 18, 157, 40), fill=P[1])
+    d.line((156, 19, 156, 40), fill=P[4])
+    # Corner block, x 0-47, mirrored about x 24.
+    for y in range(0, 4):
+        for x in range(0, 3):
+            piece.new(x, y)
+    block = Image.new("RGBA", (48, 64), (0, 0, 0, 0))
+    b = ImageDraw.Draw(block)
+    # Low dome and finial (rows 0), drum (row 1 top).
+    b.line((23, 1, 23, 4), fill=P[1])
+    b.ellipse((14, 5, 33, 22), fill=P[3], outline=P[1])
+    b.line((18, 8, 21, 7), fill=P[4])
+    b.rectangle((12, 13, 35, 15), fill=P[15])
+    b.line((12, 16, 35, 16), fill=P[1])
+    # Hip roof (row 1).
+    for yy in range(17, 32):
+        inset = (31 - yy) // 3
+        b.line((1 + inset, yy, 46 - inset, yy), fill=P[3])
+    for yy in range(19, 31, 4):
+        b.line((2, yy, 45, yy), fill=P[2])
+    b.line((6, 17, 41, 17), fill=P[1])
+    b.line((1, 31, 46, 31), fill=P[1])
+    # White stucco wall (rows 2-3): cornice, band between storeys, round-headed windows.
+    b.rectangle((0, 32, 47, 63), fill=P[15])
+    b.line((0, 32, 0, 63), fill=P[1])
+    b.rectangle((0, 32, 47, 35), fill=P[10])
+    b.line((0, 35, 47, 35), fill=P[9])
+    b.line((0, 48, 47, 48), fill=P[9])
+    b.line((0, 49, 47, 49), fill=P[10])
+    for top in (37, 51):
+        b.rectangle((10, top + 1, 13, top + 9), fill=P[11])
+        b.line((11, top, 12, top), fill=P[11])
+        b.line((9, top + 10, 14, top + 10), fill=P[9])
+    b.line((1, 36, 1, 63), fill=P[9])
+    mirror_left(block, 24)
+    piece.art.alpha_composite(block, (0, 0))
+    # Carriage porch: Miyahara's portico.
+    for x, m in zip(range(3), (0x373, 0x374, 0x375)):
+        piece.relayer(x, 4, m)
+    # Central lawn.
+    for y in range(6, 9):
+        for x in range(3, 10):
+            piece.meta(x, y, grass)
+    return piece.build(prefer=(7,))
+
+
+# --- 13 Botanical Garden (Greenway, 13x7) ---------------------------------------------------
+
+def botanical_garden(bank):
+    """A round, tapering glass tower in an exposed steel frame with four masts, on the garden
+    lawn with flower beds at the corners. Mirrored about the centre; mullions are vertical so the
+    glass repeats, and only the sloping edges and the ring beams differ row by row."""
+    P = colours(bank, 3)
+    grass, flower = 0x001, 0x004
