+def put_layouts(layouts, entries):
+    """layouts.json with these layouts set (appended if new, dropped when None)."""
+    out = copy.deepcopy(layouts)
+    out["layouts"] = [entries.get(l.get("id"), l) if l.get("id") in entries else l for l in out["layouts"]]
+    out["layouts"] = [l for l in out["layouts"] if l is not None]
+    have = {l.get("id") for l in out["layouts"]}
+    out["layouts"] += [e for i, e in entries.items() if e and i not in have]
+    return out
