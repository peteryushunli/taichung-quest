+        for connection in scene["data"]["connections"]:
+            donor = scenes[connection["map"]]
+            cells = list(visible_cells(scene["layout"], donor["layout"], connection["direction"], connection["offset"]))
+            viewer_bank = actual if mid == XITUN else scene["bank"]
+            donor_bank = actual if connection["map"] == XITUN else donor["bank"]
+            strip_words = [donor["grid"][y*donor["layout"]["width"]+x] for x, y in cells]
+            for word in strip_words:
+                n = word & 1023
+                assert viewer_bank.entries(n) == donor_bank.entries(n)
+                assert viewer_bank.attr(n) == donor_bank.attr(n) and viewer_bank.render(n) == donor_bank.render(n)
+            strip_total += len(cells)
+            connection_proof.append({"viewer": mid, "donor": connection["map"], "cells": len(cells),
+                                     "donorBoundsInclusive": bounds(cells), "wordSha256": digest(packed_words(strip_words)),
+                                     "entryWordsIdentical": True, "renderAndAttributesEqual": True})
+    assert strip_total == 1530
+    assert all(digest((ROOT / path).read_bytes()) == expected for path, expected in art_hashes.items())
