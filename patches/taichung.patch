@@ -0,0 +1,248 @@
+#!/usr/bin/env python3
+"""Install the converted city-v3 buildings into the OldCity banks and map.
+
+Deterministic packer: it reads the base OldCity/Greenway source from BASE_COMMIT, the
+indexed art in data/taichung/oldcity-buildings/art and placements.json, then writes the
+OldCore secondary graphics and metatiles and the OldCity map. The art already uses the bank's Taichung kit palette, so no palette changes. `--check` rebuilds everything in memory and requires the working
+tree to match.
+
+Safety rules it enforces:
+- Only generic-apartment cells listed as blocks change, and each keeps its collision and
+  elevation bits, so no saved position can become invalid.
+- Nothing in either connection strip changes. Strips follow fieldmap.c (7 columns, or 8
+  for an east neighbour, plus 7 rows of padding), so Greenway's view of OldCity is
+  byte-identical and every Greenway cell OldCity draws keeps its definition.
+- The install is additive. Every existing graphic, palette and metatile definition stays
+  identical: new graphics use only appended secondary slots
+  below the door scratch area and secondary slots no definition references, and new
+  metatiles are only appended to the secondary bank. Exterior maps may use only the
+  protected General IDs below 640, so the primary bank is not touched at all.
+"""
+import argparse
+import hashlib
+import io
+import json
+import struct
+import subprocess
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+BASE_COMMIT = 'a72bd0ea92d3ce41c0b67b1b470066a3b0cfe2d0'
+DATA = Path('data/taichung/oldcity-buildings')
+MAP = Path('data/layouts/TaichungOldCity/map.bin')
+GREENWAY = Path('data/layouts/TaichungGreenway/map.bin')
+PRIMARY = Path('data/tilesets/primary/taichung_old_core')
+SECONDARY = Path('data/tilesets/secondary/taichung_old_core')
+WIDTH, HEIGHT, GREENWAY_WIDTH, GREENWAY_HEIGHT = 40, 72, 40, 72
+GREENWAY_OFFSET = 16             # Greenway's east connection: OldCity y + 16 is Greenway y
+NUM_PRIMARY = 640
+SECONDARY_GRAPHIC_LIMIT = 376    # static slots below the door-animation scratch at 0x3F8
+SECONDARY_SHEET = 384            # loaded sheet, padded to whole 16-tile PNG rows
+SECONDARY_METATILE_LIMIT = 384
+PALETTE = 12                     # existing Taichung kit palette, shared with OldCity infill
+LAYER_COVERED = 1 << 29
+GENERIC = set(range(0x280, 0x2D4)) | set(range(0x32F, 0x34F)) | {0x180, 0x181, 0x182, 0x194}
+FILLERS = {'tree': [[0x00E, 0x00F], [0x016, 0x017]], 'shrub': [[0x005]]}
+
+
+def require(condition, message):
+    if not condition:
+        raise SystemExit(message)
+
+
+def base_bytes(path):
+    return subprocess.run(['git', '-C', str(ROOT), 'show', f'{BASE_COMMIT}:{path}'], check=True, capture_output=True).stdout
+
+
+def words(raw):
+    return list(struct.unpack(f'<{len(raw) // 2}H', raw))
+
+
+def metatiles(raw):
+    return [list(struct.unpack('<8H', raw[i:i + 16])) for i in range(0, len(raw), 16)]
+
+
+def attributes(raw):
+    return list(struct.unpack(f'<{len(raw) // 4}I', raw))
+
+
+def canonical(q):
+    variants = [(q, 0), (q[:, ::-1], 0x400), (q[::-1], 0x800), (q[::-1, ::-1], 0xC00)]
+    return min((v.tobytes(), f) for v, f in variants)
+
+
+def oldcity_strip():
+    """OldCity cells Greenway draws with its own banks (Greenway's east neighbour: 8 columns)."""
+    return {(x, y) for x in range(8) for y in range(HEIGHT) if -7 <= y + GREENWAY_OFFSET < GREENWAY_HEIGHT + 7}
+
+
+def greenway_strip():
+    """Greenway cells OldCity draws with the OldCore banks (OldCity's west neighbour: 7 columns)."""
+    return {(x, y) for x in range(GREENWAY_WIDTH - 7, GREENWAY_WIDTH) for y in range(GREENWAY_HEIGHT)
+            if -7 <= y - GREENWAY_OFFSET < HEIGHT + 7}
+
+
+def build():
+    plan = json.loads((ROOT / DATA / 'placements.json').read_text())
+    art = json.loads((ROOT / DATA / 'art.json').read_text())
+    base_map = words(base_bytes(MAP))
+    greenway = words(base_bytes(GREENWAY))
+    pmeta = metatiles(base_bytes(PRIMARY / 'metatiles.bin'))
+    smeta = metatiles(base_bytes(SECONDARY / 'metatiles.bin'))
+    sattr = attributes(base_bytes(SECONDARY / 'metatile_attributes.bin'))
+    simage = Image.open(io.BytesIO(base_bytes(SECONDARY / 'tiles.png')))
+    stiles = np.array(simage)
+    require(len(pmeta) == NUM_PRIMARY, 'Unexpected primary bank size')
+
+    # Cells to replace: exactly the listed blocks, all generic, solid and outside the strip.
+    blocks = set()
+    for x0, y0, x1, y1 in plan['blocks']:
+        blocks |= {(x, y) for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)}
+    for x, y in blocks:
+        word = base_map[y * WIDTH + x]
+        require((word & 0x3FF) in GENERIC, f'Block cell {x},{y} is not a generic apartment cell')
+        require((word >> 10) & 3 == 1, f'Block cell {x},{y} is not solid')
+    require(not blocks & oldcity_strip(), f'A block reaches into the Greenway strip: {sorted(blocks & oldcity_strip())[:8]}')
+
+    styles = {s['id']: s for s in art['styles']}
+    art_index = {}
+    for name in {b['style'] for b in plan['buildings']}:
+        require(styles[name]['mergedForOldCity'], f'{name} was not merged into the OldCity budget')
+        art_index[name] = np.array(Image.open(ROOT / styles[name]['png']))
+
+    # Cell assignment: building cells and filler metatiles must tile the blocks exactly.
+    cells = {}
+    for b in plan['buildings']:
+        index = art_index[b['style']]
+        if b.get('mirror'):
+            index = index[:, ::-1]
+        w, h = index.shape[1] // 16, index.shape[0] // 16
+        for cy in range(h):
+            for cx in range(w):
+                pos = (b['x'] + cx, b['y'] + cy)
+                require(pos not in cells, f'Overlapping placement at {pos}')
+                cells[pos] = ('art', index[cy * 16:cy * 16 + 16, cx * 16:cx * 16 + 16])
+    for f in plan['fillers']:
+        for dy, row in enumerate(FILLERS[f['kind']]):
+            for dx, metatile in enumerate(row):
+                pos = (f['x'] + dx, f['y'] + dy)
+                require(pos not in cells, f'Overlapping filler at {pos}')
+                cells[pos] = ('metatile', metatile)
+    require(set(cells) == blocks, f'Placements do not cover the blocks exactly: {sorted(set(cells) ^ blocks)[:8]}')
+
+    # Every existing definition stays; these IDs must also stay drawn exactly as they are.
+    ground = int(plan['ground'], 16)
+    strip_ids = {greenway[y * GREENWAY_WIDTH + x] & 0x3FF for x, y in greenway_strip()}
+    kit = base_bytes(SECONDARY / f'palettes/{PALETTE:02}.pal').split()[6:]
+    require([[int(v) for v in kit[i:i + 3]] for i in range(0, 45, 3)] == art['palette']['colours'],
+            f'Art is not indexed to the bank palette {PALETTE}')
+    referenced = {e & 0x3FF for entries in pmeta + smeta for e in entries}
+    loaded = stiles.shape[0] // 8 * 16
+    slots = list(range(NUM_PRIMARY + loaded, NUM_PRIMARY + SECONDARY_GRAPHIC_LIMIT))
+    slots += [NUM_PRIMARY + n for n in range(loaded) if NUM_PRIMARY + n not in referenced]
+
+    # Allocate graphics for every distinct 8x8 pattern (flip-aware).
+    lookup, order = {}, []
+    for kind, data in cells.values():
+        if kind != 'art':
+            continue
+        for sy in (0, 8):
+            for sx in (0, 8):
+                q = data[sy:sy + 8, sx:sx + 8]
+                if q.any():
+                    key, _ = canonical(q)
+                    if key not in lookup:
+                        require(len(order) < len(slots), f'Graphics budget exceeded: {len(slots)} free slots')
+                        lookup[key] = slots[len(order)]
+                        order.append(key)
+    sgrid = np.zeros((SECONDARY_SHEET // 16 * 8, 128), np.uint8)
+    sgrid[:stiles.shape[0]] = stiles
+    for key in order:
+        n = lookup[key] - NUM_PRIMARY
+        sgrid[n // 16 * 8:n // 16 * 8 + 8, n % 16 * 8:n % 16 * 8 + 8] = np.frombuffer(key, np.uint8).reshape(8, 8)
+
+    # Metatiles: ground below, building art above, both under sprites (covered layer).
+    floor = pmeta[ground][:4]
+    free_ids = list(range(NUM_PRIMARY + len(smeta), NUM_PRIMARY + SECONDARY_METATILE_LIMIT))
+    new_smeta, new_sattr = [m[:] for m in smeta], sattr[:]
+    definitions, new_map = {}, base_map[:]
+    for (x, y), (kind, data) in sorted(cells.items(), key=lambda c: (c[0][1], c[0][0])):
+        if kind == 'metatile':
+            metatile = data
+        else:
+            top = []
+            for sy in (0, 8):
+                for sx in (0, 8):
+                    q = data[sy:sy + 8, sx:sx + 8]
+                    if not q.any():
+                        top.append(0)
+                        continue
+                    key, flip = canonical(q)
+                    top.append(lookup[key] | flip | PALETTE << 12)
+            entry = tuple(floor + top)
+            if entry not in definitions:
+                require(len(definitions) < len(free_ids), f'Metatile budget exceeded: {len(free_ids)} free ids')
+                metatile = free_ids[len(definitions)]
+                definitions[entry] = metatile
+                new_smeta.append(list(entry))
+                new_sattr.append(LAYER_COVERED)
+            metatile = definitions[entry]
+        new_map[y * WIDTH + x] = (base_map[y * WIDTH + x] & 0xFC00) | metatile
+
+    # Additive: every existing definition and every graphic one references is unchanged.
+    require(new_smeta[:len(smeta)] == smeta and new_sattr[:len(sattr)] == sattr, 'An existing definition changed')
+    for n in referenced:
+        if n >= NUM_PRIMARY and n - NUM_PRIMARY < loaded:
+            k = n - NUM_PRIMARY
+            require((sgrid[k // 16 * 8:k // 16 * 8 + 8, k % 16 * 8:k % 16 * 8 + 8]
+                     == stiles[k // 16 * 8:k // 16 * 8 + 8, k % 16 * 8:k % 16 * 8 + 8]).all(), f'Referenced graphic {n} changed')
+    image = Image.fromarray(sgrid, 'P')
+    image.putpalette(simage.getpalette())
+    sheet = io.BytesIO()
+    image.save(sheet, format='PNG', optimize=False)
+
+    outputs = {
+        MAP: struct.pack(f'<{len(new_map)}H', *new_map),
+        SECONDARY / 'tiles.png': sheet.getvalue(),
+        SECONDARY / 'metatiles.bin': b''.join(struct.pack('<8H', *m) for m in new_smeta),
+        SECONDARY / 'metatile_attributes.bin': struct.pack(f'<{len(new_sattr)}I', *new_sattr),
+    }
+    used_slots = [lookup[k] for k in order]
+    report = dict(
+        schemaVersion=1, id='oldcity-buildings-install', baseCommit=BASE_COMMIT,
+        changedCells=len(blocks), collisionAndElevationPreserved=True, connectionStripsTouched=False,
+        existingDefinitionsChanged=0, buildings=len(plan['buildings']), fillers=len(plan['fillers']),
+        graphics=dict(used=len(order), available=len(slots),
+                      secondaryAppended=sum(1 for s in used_slots if s >= NUM_PRIMARY + loaded),
+                      secondaryUnreferenced=sum(1 for s in used_slots if s < NUM_PRIMARY + loaded),
+                      loadedSheet=SECONDARY_SHEET),
+        metatiles=dict(used=len(definitions), available=len(free_ids),
+                       appended=[min(definitions.values()), max(definitions.values())]),
+        paletteSlot=PALETTE,
+        greenwayStripIds=sorted(strip_ids),
+        outputs={str(p): hashlib.sha256(b).hexdigest() for p, b in outputs.items()})
+    outputs[DATA / 'install.json'] = (json.dumps(report, indent=2) + '\n').encode()
+    return outputs, report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('--check', action='store_true', help='require the working tree to match a fresh install')
+    args = parser.parse_args()
+    outputs, report = build()
+    if args.check:
+        stale = [str(p) for p, b in outputs.items() if (ROOT / p).read_bytes() != b]
+        require(not stale, f'OldCity buildings are not installed as planned: {stale}')
+        print(f'PASS oldcity buildings: {report["changedCells"]} cells, {report["graphics"]["used"]} graphics, '
+              f'{report["metatiles"]["used"]} metatiles')
+        return
+    for path, data in outputs.items():
+        (ROOT / path).write_bytes(data)
+    print(json.dumps({k: report[k] for k in ('changedCells', 'graphics', 'metatiles')}, indent=1))
+
+
+if __name__ == '__main__':
+    main()
