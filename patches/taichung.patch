+++ b/data/taichung/landmarks/shen-ji/prepare_modules.py
@@ -0,0 +1,182 @@
+#!/usr/bin/env python3
+"""Extract the approved native Shen Ji buildings exactly; no redraw or map write."""
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image
+
+from encode_candidate import HERE, SOURCE, sha, flip
+
+
+def patterns(image):
+    result = set()
+    for ty in range(image.height//8):
+        for tx in range(image.width//8):
+            pixels = tuple(image.getpixel((tx*8+x, ty*8+y)) for y in range(8) for x in range(8))
+            result.add(min(flip(pixels, flags) for flags in (0, 0x400, 0x800, 0xC00)))
+    return result
+
+
+def occupied(image):
+    return ["".join("1" if any(image.getpixel((x*16+dx, y*16+dy)) for dy in range(16) for dx in range(16)) else "0"
+                    for x in range(image.width//16)) for y in range(image.height//16)]
+
+
+def main():
+    candidate = HERE / "candidate"
+    path = candidate / "candidate-indexed.png"
+    before = sha(path)
+    manifest = json.loads((candidate / "encode-manifest.json").read_text())
+    assert sha(SOURCE) == manifest["originalStudySha256"]
+    image = Image.open(path)
+    assert image.mode == "P" and image.size == (160, 96) and image.info.get("transparency") == 0
+    assert manifest["components"]["separateExtractionSafeByMask"]
+    boxes = manifest["components"]["largestTwoLeftToRight"]
+    source_mask = Image.open(SOURCE).getchannel("A").point(lambda value: 255 if value >= 224 else 0)
+    labels = Image.new("L", source_mask.size)
+    for label, component in enumerate(boxes, 1):
+        box = component["boxExclusive"]
+        part = source_mask.crop(box).point(lambda value, n=label: n if value else 0)
+        labels.paste(part, box[:2])
+    recipe = manifest["recipe"]
+    cluster = recipe["nativePixelCluster"]
+    working = tuple(recipe["workingSizePixels"])
+    fit = tuple(n//cluster for n in recipe["fitSizePixels"])
+    offset = tuple(n//cluster for n in recipe["offsetPixels"])
+    projected = Image.new("L", working)
+    projected.paste(labels.crop(recipe["sourceCropBoxAlpha224"]).resize(fit, Image.Resampling.NEAREST), offset)
+    projected = projected.resize((160, 96), Image.Resampling.NEAREST)
+    membership = {1: [], 2: []}
+    for y in range(96):
+        for x in range(160):
+            index, label = image.getpixel((x, y)), projected.getpixel((x, y))
+            assert bool(index) == bool(label), f"Source projection mismatch at{x},{y}"
+            if index:
+                assert (label == 1 and x < 72) or (label == 2 and x >= 72), f"Cut crosses component ink at{x},{y}"
+                membership[label].append((x, y))
+    left, right = Image.new("P", (80, 96)), Image.new("P", (96, 96))
+    for module in (left, right):
+        module.putpalette(image.getpalette())
+        module.info["transparency"] = 0
+    left.paste(image.crop((0, 0, 72, 96)), (0, 0))
+    right.paste(image.crop((72, 0, 160, 96)), (0, 0))
+    assert not left.crop((72, 0, 80, 96)).getbbox()
+    assert not right.crop((88, 0, 96, 96)).getbbox()
+    for y in range(96):
+        for x in range(160):
+            assert image.getpixel((x, y)) == (left.getpixel((x, y)) if x < 72 else right.getpixel((x-72, y)))
+    source_counts = Counter(index for index in image.get_flattened_data() if index)
+    module_counts = Counter(index for index in left.get_flattened_data() if index)+Counter(index for index in right.get_flattened_data() if index)
+    assert source_counts == module_counts
+    source_patterns, left_patterns, right_patterns = patterns(image), patterns(left), patterns(right)
+    assert source_patterns == left_patterns | right_patterns
+    destination = candidate / "modules"
+    destination.mkdir(exist_ok=True)
+    left.save(destination / "left.png")
+    right.save(destination / "right.png")
+    # Root-approved game-map module layout: exact indexed copies only. The
+    # source right building moves24 pixels, preserving its8-pixel graphic phase.
+    layout = Image.new("P", (192, 96))
+    layout.putpalette(image.getpalette())
+    layout.info["transparency"] = 0
+    layout.paste(left, (0, 0))
+    layout.paste(right, (96, 0))
+    assert not layout.crop((80, 0, 96, 96)).getbbox()
+    assert Counter(index for index in layout.get_flattened_data() if index) == source_counts
+    for y in range(96):
+        for x in range(160):
+            translated = x if x < 72 else x+24
+            assert layout.getpixel((translated, y)) == image.getpixel((x, y))
+    assert patterns(layout) == source_patterns
+    layout_path = candidate / "nativecourtyard-layout-indexed.png"
+    layout.save(layout_path)
+    raw_graphics = (candidate / "tiles.4bpp").read_bytes()
+    source_graphics = [tuple(value for byte in raw_graphics[n:n+32] for value in (byte & 15, byte >> 4))
+                       for n in range(0, len(raw_graphics), 32)]
+    lookup = {pixels: index for index, pixels in enumerate(source_graphics)}
+    tilemap = []
+    for ty in range(12):
+        for tx in range(24):
+            pixels = tuple(layout.getpixel((tx*8+x, ty*8+y)) for y in range(8) for x in range(8))
+            canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+            assert canonical in lookup
+            tilemap.append(lookup[canonical] | flags | 0x9000)
+    for y in range(96):
+        for x in range(192):
+            word = tilemap[y//8*24+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            assert source_graphics[word & 1023][sy*8+sx] == layout.getpixel((x, y))
+    metatiles = [[tilemap[(my*2+y)*24+mx*2+x] for y in range(2) for x in range(2)]
+                 for my in range(6) for mx in range(12)]
+    (candidate / "nativecourtyard-tilemap-relative.bin").write_bytes(struct.pack("<288H", *tilemap))
+    (candidate / "nativecourtyard-metatiles-relative.json").write_text(json.dumps(metatiles, indent=2)+"\n")
+    layout_info = {
+        "schemaVersion": 1, "landmarkId": "shen-ji-new-village",
+        "status": "Root-approved exact game-map module layout; not installed",
+        "files": {"indexed": "nativecourtyard-layout-indexed.png", "palette": "09.pal", "graphics4bpp": "tiles.4bpp",
+                  "foregroundTilemapRelative": "nativecourtyard-tilemap-relative.bin",
+                  "foregroundMetatilesRelative": "nativecourtyard-metatiles-relative.json"},
+        "inputSizePixels": [192, 96], "envelopeMetatiles": [12, 6], "paletteBankCandidate": 9,
+        "sourceIndexed": "candidate-indexed.png", "sourceIndexedSha256": before,
+        "sourceIndexedUnchanged": True, "sourceOriginalStudyUnchanged": True,
+        "moduleCopiesOnly": [{"file": "modules/left.png", "destinationPixels": [0, 0]},
+                             {"file": "modules/right.png", "destinationPixels": [96, 0]}],
+        "rightSourcePixelTranslation": [24, 0], "graphicsPhase8Aligned": True,
+        "clearLanePixelsExclusive": [80, 0, 96, 96], "laneCompletelyTransparent": True,
+        "allOpaqueIndexCountsConserved": True, "allSourcePixelsAtTheirSpecifiedTranslationUnchanged": True,
+        "paletteExactAndTransparencyIndex0": True, "flipCanonicalGraphics": len(patterns(layout)),
+        "newGraphicPatterns": 0, "occupancyRows": occupied(layout),
+        "nativeFormat": {"relativeGraphicIndices": True, "tilemapDimensions8x8": [24, 12],
+                         "foregroundEnvelopeCells": 72, "occupiedMetatiles": sum(row.count("1") for row in occupied(layout)),
+                         "distinctForegroundDefinitionsIncludingEmpty": len({tuple(group) for group in metatiles}),
+                         "roundTripPixels": 192*96, "tilemapRoundTripPass": True},
+        "mapOriginFromRoot": [7, 39], "doorLocal": [3, 5], "doorGlobal": [10, 44],
+        "approach": [10, 45], "arrival": [10, 47], "artClearLaneMapColumn": 12,
+        "minimumInkMapRow": 39+layout.convert("RGBA").getchannel("A").getbbox()[1]//16,
+        "rootApprovedMapModuleLayoutChoice": True, "newArchitectureOrPropCreated": False,
+        "restoreOldPlaceholderUnderLaneRequired": True, "gameWalkabilityVerified": False,
+        "jointGreenwayBudgetCheckedByThisUtility": False, "mapInstalled": False, "nativeReady": False,
+        "sha256": sha(layout_path),
+    }
+    assert layout_info["minimumInkMapRow"] > 38
+    (candidate / "nativecourtyard-layout.json").write_text(json.dumps(layout_info, indent=2)+"\n")
+    assert sha(path) == before
+    info = []
+    for label, name, module, origin in ((1, "left", left, [7, 39]), (2, "right", right, [13, 39])):
+        bbox = module.convert("RGBA").getchannel("A").getbbox()
+        rows = occupied(module)
+        info.append({"id": name, "file": name+".png", "sizePixels": list(module.size), "paletteBank": 9,
+                     "sourceXRangeExclusive": [0, 72] if label == 1 else [72, 160],
+                     "sourceComponentLabel": label, "opaquePixels": len(membership[label]),
+                     "opaqueBoundingBoxExclusive": list(bbox), "occupancyRows": rows,
+                     "proposedMapOriginFromRoot": origin, "placementInstalled": False,
+                     "solidMapColumnsFromAlphaOnly": sorted({origin[0]+x for row in rows for x, value in enumerate(row) if value == "1"}),
+                     "sha256": sha(destination / (name+".png"))})
+    assert max(info[0]["solidMapColumnsFromAlphaOnly"]) == 11
+    assert min(info[1]["solidMapColumnsFromAlphaOnly"]) == 13
+    result = {"schemaVersion": 1, "landmarkId": "shen-ji-new-village", "status": "exact native module extraction for Root placement",
+              "sourceIndexedSha256": before, "sourceIndexedUnchanged": True, "originalStudyUnchanged": True,
+              "cutNativeX": 72, "cutAlignsTo8PixelGraphics": True, "componentMembershipProjectedFromSourceAlpha224": True,
+              "leftComponentPixelsAtOrBeyondCut": 0, "rightComponentPixelsBeforeCut": 0,
+              "allOpaqueIndexCountsConserved": True, "opaqueIndexCounts": dict(sorted(source_counts.items())),
+              "allSourcePixelsRecoverExactlyFromModules": True, "paletteExactAndTransparencyIndex0": True,
+              "modules": info, "flipCanonicalGraphics": {"source": len(source_patterns), "left": len(left_patterns),
+                  "right": len(right_patterns), "union": len(left_patterns | right_patterns),
+                  "newPatternsAdded": len((left_patterns | right_patterns)-source_patterns)},
+              "proposedPlacement": {"providedByRoot": True, "leftOrigin": [7, 39], "rightOrigin": [13, 39],
+                  "leftDoorLocal": [3, 5], "fixedLeftDoorGlobal": [10, 44], "approach": [10, 45], "arrival": [10, 47],
+                  "artClearLaneMapColumn": 12, "artClearLaneWidthPixels": 16,
+                  "noModuleInkAtMapY38OrAbove": True, "restoreOldPlaceholderUnderLaneRequired": True,
+                  "gameWalkabilityVerified": False, "mapInstalled": False},
+              "jointGreenwayBudgetChecked": False, "noCreativeRedrawOrImageGeneration": True, "nativeReady": False}
+    result["canonicalGameMapLayout"] = layout_info
+    (destination / "manifest.json").write_text(json.dumps(result, indent=2)+"\n")
+    print(json.dumps(result, indent=2))
+    return result
+
+
+if __name__ == "__main__":
+    main()
