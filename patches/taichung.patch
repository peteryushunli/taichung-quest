+        tests.require(all(n < 640 + manifest["secondaryGraphics"] for n in refs if n >= 640), "Static entry references sheet padding beyond declared graphics")
+        declarations = "\n".join(now.text(path) for path in ("src/data/tilesets/graphics.h", "src/data/tilesets/metatiles.h", "src/graphics.c"))
+        folder, header = support.resolved_folder(now, SECONDARY_LABEL)
