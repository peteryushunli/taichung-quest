+        title=en.upper()
+        scripts += [f'TaichungCity_Sign_{suffix}::',f'\tmsgbox TaichungCity_Text_{suffix}, MSGBOX_SIGN','\tend','',
+                    f'TaichungCity_Host_{suffix}::',f'\tmsgbox TaichungCity_Text_Host_{suffix}, MSGBOX_NPC','\tend','',
+                    f'TaichungCity_Text_{suffix}::',f'\t.string "{title}\\p"',
+                    '\t.string "Landmark hall: enter to explore.$"','',
+                    f'TaichungCity_Text_Host_{suffix}::',f'\t.string "Welcome to {title}!\\p"' if len(title)<18 else '\t.string "Welcome to this landmark hall!\\p"',
+                    '\t.string "Our city league is preparing\\n"','\t.string "this hall for future challenges.$"','']
+    (ROOT/'data/scripts/taichung_city.inc').write_text('\n'.join(scripts))
+    print(f'Authored {len(DISTRICTS)} native districts and {len(LANDMARKS)} paired landmark rooms.')
+
+
+if __name__=='__main__':
+    build()
diff --git a/tools/taichung/capture_gameplay_guard.py b/tools/taichung/capture_gameplay_guard.py
new file mode 100644
index 00000000..40cb3fa0
--- /dev/null
+++ b/tools/taichung/capture_gameplay_guard.py
@@ -0,0 +1,189 @@
+#!/usr/bin/env python3
+"""Exact capture-only Gameplay and known glyph append above the v12 guards.
+
+The approved source is immutable Main81259 (ae3 plus its C89-only run-hook
+fix). Only registered, fully verified edited files yield historical bytes.
+Added modules are hash-checked live inputs, never synthetic source stubs.
+No map, save, font or runtime file is written. No native runtime claim is made.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = 'data/taichung/capture-gameplay-guard/registration.json'
+MANIFEST_SHA256 = '15ade2549685d48aa1136fd8d0ae3f30530babbeef366f534abda57dd40510b5'
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def reader(source, overrides=None):
+    def read(path):
+        if path in (overrides or {}):
+            raw = overrides[path]
+            if raw is None:
+                raise FileNotFoundError(path)
+            return raw
+        return (Path(source) / path).read_bytes()
+    return read
+
+
+def active(read):
+    try:
+        read(MANIFEST)
+        return True
+    except FileNotFoundError:
+        return b'TaichungEncounterBridge_Tick(' in read('src/main.c')
+
+
+def reverse(raw, item, path):
+    require(digest(raw) == item['installedSha256'], 'Unreviewed capture input: ' + path)
+    text = raw.decode()
+    require(item['edits'], 'Missing registered capture edits: ' + path)
+    for edit in reversed(item['edits']):
+        require(text.count(edit['after']) == 1, 'Capture edit missing/ambiguous: ' + path)
+        text = text.replace(edit['after'], edit['before'], 1)
+    baseline = text.encode()
+    require(digest(baseline) == item['baselineSha256'], 'Capture delta does not restore exact baseline: ' + path)
+    return baseline
+
+
+def glyph_append(before_map, after_map, before_header, after_header):
+    require(after_map.startswith(before_map), 'Capture glyph append changed old charmap bytes')
+    pattern = re.compile(r"^'(.)' = FC 19 ([0-9A-F]{2}) ([0-9A-F]{2})$", re.M)
+    old_mapping = pattern.findall(before_map.decode())
+    mapping = pattern.findall(after_map.decode())
+    require(len(old_mapping) == 786 and len(mapping) == 808 and mapping[:786] == old_mapping,
+            'Capture glyph count/order/old mapping differs')
+    suffix = after_map[len(before_map):].decode().splitlines()
+    require(len(suffix) == 22 and all(pattern.fullmatch(line) for line in suffix), 'Capture charmap suffix is not exactly22 entries')
+    rows = re.compile(r'^([ \t]*\{([^{}\n]+)\}, // (\d+): (.)\n)', re.M)
+    old_rows, new_rows = rows.findall(before_header.decode()), rows.findall(after_header.decode())
+    require(len(old_rows) == 786 and len(new_rows) == 808 and new_rows[:786] == old_rows,
+            'Capture glyph append changed old raster rows')
+    restored = after_header.decode()
+    chars = set()
+    for index, ((line, masks, number, char), (mapped, low, high)) in enumerate(zip(new_rows, mapping)):
+        require(int(number) == index and char == mapped and char not in chars, 'Capture glyph raster/index/character differs')
+        require((int(low, 16), int(high, 16)) == (index % 240 + 1, index // 240 + 1), 'Capture glyph encoding differs')
+        values = [int(value.strip(), 16) for value in masks.split(',')]
+        require(len(values) == 14 and all(0 <= value <= 0xFFF for value in values), 'Capture glyph cell exceeds12x14')
+        chars.add(char)
+        if index >= 786:
+            require(restored.count(line) == 1, 'Capture appended glyph row is ambiguous')
+            restored = restored.replace(line, '', 1)
+    require(restored.encode() == before_header, 'Capture font changed outside its22 appended rows')
+    return {'oldRows': 786, 'newRows': 808, 'appended': 22, 'allOldMappingAndRasterBytesKept': True, 'cell': [12, 14]}
+
+
+def verified(read):
+    require(active(read), 'Capture Gameplay layer is absent')
+    raw = read(MANIFEST)
+    require(digest(raw) == MANIFEST_SHA256, 'Capture Gameplay registration differs')
+    registration = json.loads(raw)
+    require(registration['schemaVersion'] == 1 and len(registration['inputs']) == 32, 'Capture Gameplay scope differs')
+    under = {}
+    edited = added = 0
+    for path, item in registration['inputs'].items():
+        data = read(path)
+        require(digest(data) == item['installedSha256'], 'Unreviewed capture input: ' + path)
+        if item['kind'] == 'added':
+            added += 1
+        else:
+            require(item['kind'] == 'edited', 'Unknown capture input kind')
+            under[path] = reverse(data, item, path)
+            edited += 1
+    require((edited, added) == (18, 14), 'Capture edited/added inventory differs')
+    for path, expected in registration['sourceDependencies'].items():
+        require(digest(read(path)) == expected, 'Capture dependency differs: ' + path)
+    glyph = registration['glyphAppend']
+    require((glyph['beforeCount'], glyph['afterCount'], glyph['addedCount']) == (786, 808, 22), 'Capture glyph registration differs')
+    for path, item in glyph['files'].items():
+        under[path] = reverse(read(path), item, path)
+    font = glyph_append(under['charmap.txt'], read('charmap.txt'), under['src/data/taichung_glyphs.h'], read('src/data/taichung_glyphs.h'))
+    require(not any(path.startswith(('data/maps/', 'data/layouts/', 'data/tilesets/')) for path in under), 'Capture layer may not substitute geometry')
+    require('src/taichung_save.c' not in under and 'include/taichung_save.h' not in under, 'Capture layer may not substitute SaveC/H')
+    return {'active': True, 'passed': True, 'acceptedSourceCommit': registration['acceptedSourceCommit'],
+            'baselineCommit': registration['baselineCommit'], 'checkedGameplayInputs': 32,
+            'edited': edited, 'added': added, 'historicalInputs': len(under), 'glyphAppend': font,
+            'binding': 'Wenchang only;13 other wrappers are APIs', 'checksGeometry': False,
+            'nativeRuntimeTested': False}, under
+
+
+def peel(read):
+    return verified(read)[1] if active(read) else {}
+
+
+def check(source=ROOT, overrides=None):
+    read = reader(source, overrides)
+    try:
+        return verified(read)[0] if active(read) else {'active': False, 'passed': True}
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        return {'active': True, 'passed': False, 'errors': [str(error)]}
+
+
+def self_test(source=ROOT):
+    read = reader(source)
+    positive = check(source)
+    if not positive['passed']:
+        return {'passed': False, 'current': positive}
+    registration = json.loads(read(MANIFEST))
+    probes = {MANIFEST: read(MANIFEST) + b'\n'}
+    for path in [*registration['inputs'], *registration['sourceDependencies'], *registration['glyphAppend']['files']]:
+        raw = bytearray(read(path)); require(raw, 'Empty registered input: ' + path)
+        raw[len(raw) // 2] ^= 1
+        probes[path] = bytes(raw)
+    caught = {}
+    for path, raw in probes.items():
+        edits = {path: raw}
+        rejected = not check(source, edits)['passed']
+        try:
+            peel(reader(source, edits)); no_underlay = False
+        except (OSError, ValueError, KeyError, TypeError):
+            no_underlay = True
+        caught[path] = rejected and no_underlay
+    # Removing the registration is not an absent-layer success over active code.
+    missing = not check(source, {MANIFEST: None})['passed']
+    under = peel(read)
+    # Unrelated overrides are never replaced or authorized by this registration.
+    foreign = 'src/new_game.c'
+    altered = read(foreign) + b'\n/* unrelated change */\n'
+    forwarded = peel(reader(source, {foreign: altered}))
+    strict_scope = foreign not in forwarded and 'src/taichung_save.c' not in forwarded
+    old_map, new_map = under['charmap.txt'], read('charmap.txt')
+    old_header, new_header = under['src/data/taichung_glyphs.h'], read('src/data/taichung_glyphs.h')
+    font_probes = {}
+    for name, args in {
+        'old-charmap-byte': (old_map, b'!' + new_map[1:], old_header, new_header),
+        'old-raster-byte': (old_map, new_map, old_header, new_header.replace(b'0x010', b'0x011', 1)),
+        'removed-new-raster': (old_map, new_map, old_header, new_header.replace(new_header.splitlines(keepends=True)[-2], b'', 1)),
+        'new-encoding-reindexed': (old_map, new_map.replace("'三' = FC 19 43 04".encode(), "'三' = FC 19 44 04".encode()), old_header, new_header),
+    }.items():
+        try:
+            glyph_append(*args); font_probes[name] = False
+        except ValueError:
+            font_probes[name] = True
+    return {'passed': all(caught.values()) and missing and strict_scope and all(font_probes.values()),
+            'current': positive, 'rejectedInputChanges': caught, 'missingRegistrationRejected': missing,
+            'unrelatedOverridesRemainLive': strict_scope, 'independentGlyphCorruptionsRejected': font_probes}
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ROOT)
+    parser.add_argument('--self-test', action='store_true')
+    args = parser.parse_args()
+    report = self_test(args.source) if args.self_test else check(args.source)
+    print(json.dumps(report, indent=2))
+    raise SystemExit(0 if report['passed'] else 1)
diff --git a/tools/taichung/capture_release_guard.py b/tools/taichung/capture_release_guard.py
