+def optimize_indices(patterns,known):
+ """Lossless palette permutation to reuse existing8px shapes; no RGB fitting."""
+ groups=defaultdict(list)
+ for t in known:groups[shape(t)].append(t)
+ requirements=[];seeds={tuple(range(16))}
+ for t in patterns:
+  options=set()
+  for f in (0,0x400,0x800,0xC00):
+   transformed=flip(t,f)
+   for other in groups.get(shape(transformed),[]):
+    pairs=tuple(sorted(set(zip(transformed,other))))
+    if any((a==0)!=(b==0) for a,b in pairs):continue
+    options.add(pairs)
+  if not options:continue
+  requirements.append(tuple(options))
+  for pairs in options:
+   perm=[-1]*16;perm[0]=0;occupied={0}
+   for a,b in pairs:perm[a]=b;occupied.add(b)
+   for a in range(1,16):
+    if perm[a]<0 and a not in occupied:perm[a]=a;occupied.add(a)
+   free=iter(sorted(set(range(16))-occupied))
+   for a in range(1,16):
+    if perm[a]<0:perm[a]=next(free)
+   seeds.add(tuple(perm))
+ scores={}
+ def score(perm):
+  if perm not in scores:scores[perm]=sum(any(all(perm[a]==b for a,b in pairs) for pairs in options) for options in requirements)
+  return scores[perm]
+ identity=tuple(range(16));best=identity
+ for seed in sorted(seeds,key=lambda p:(-score(p),p))[:4]:
+  current=seed
+  for _ in range(6):
+   candidate=current
+   for a in range(1,16):
+    for b in range(a+1,16):
+     p=list(current);p[a],p[b]=p[b],p[a];p=tuple(p)
+     if score(p)>score(candidate):candidate=p
+   if candidate==current:break
+   current=candidate
+  if score(current)>score(best):best=current
+ return best,score(best)-score(identity)
+
