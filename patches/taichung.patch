+++ b/tools/taichung_gameplay/generate-cjk-punctuation.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Generate the full-width ！？。 rows drawn after a Chinese glyph.
+
+The character map keeps ！？。 on FireRed's Latin bytes (!?.), which original
+English text also uses. The renderer instead draws these full-width rows when
+one of those bytes directly follows a Chinese glyph, so Chinese lines get
+Chinese punctuation and English text is unchanged.
+
+Rows come from the pinned bitmap font through the shared glyph loader, in the
+same 12x14 mask format as src/data/taichung_glyphs.h. The header is
+generated. Check mode is the default; --write replaces the header.
+"""
+import argparse
+import importlib.util
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+HEADER = 'src/data/taichung_cjk_punctuation.h'
+# Order matches CHAR_EXCL_MARK (0xAB), CHAR_QUESTION_MARK (0xAC), CHAR_PERIOD (0xAD).
+CHARACTERS = '！？。'
+
+
+def render(game):
+    spec = importlib.util.spec_from_file_location('taichung_chinese_glyph_font', game / 'tools/taichung_gameplay/chinese_glyph_font.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    font = module.load_font(game)
+    lines = [
+        '// Generated by tools/taichung_gameplay/generate-cjk-punctuation.py. Do not edit.',
+        '// Full-width ！？。 drawn after a Chinese glyph; index = Latin byte - CHAR_EXCL_MARK.',
+        '// Taichung Native Bitmap12; source/licenses: assets/fonts/taichung-native-font.json',
+        'static const u16 sTaichungCjkPunctuation[3][14] = {',
+    ]
+    for character in CHARACTERS:
+        masks = font.render(character)
+        if len(masks) != 14 or not any(masks):
+            raise ValueError('Unexpected punctuation glyph: ' + character)
+        lines.append('    {' + ', '.join(f'0x{mask:03x}' for mask in masks) + '}, // ' + character)
+    lines.append('};')
+    return ('\n'.join(lines) + '\n').encode()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=ROOT)
+    parser.add_argument('--write', action='store_true')
+    args = parser.parse_args()
+    game = args.game.resolve()
+    candidate = render(game)
+    dest = game / HEADER
+    if args.write:
+        dest.write_bytes(candidate)
+        print('Wrote ' + HEADER)
+    else:
+        assert dest.read_bytes() == candidate, HEADER + ' differs from the pinned font; rerun with --write'
+        print('OK ' + HEADER)
+
+
+if __name__ == '__main__':
+    main()
