+        'static bool8 ExpectApprovedArtV11(u8 group, u8 num, s16 *x, s16 *y)\n'
+        '{\n    unsigned i;\n'
+        '    for (i = 0; i < sizeof(sApprovedArtV11Expected) / sizeof(sApprovedArtV11Expected[0]); i++)\n'
