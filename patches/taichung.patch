+@ Native city geometry and shared Station checkpoint.
+TaichungCity_OnTransition::
+	callnative TaichungSaveSetStationCheckpoint
+	call_if_eq TAICHUNG_STARTER_SPECIES, 0, Taichung_MigrateLegacyStarter
