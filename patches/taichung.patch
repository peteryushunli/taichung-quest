+    cols=4; cw,ch=400,360; rows=(len(library.prefabs)+cols-1)//cols
+    image=Image.new('RGB',(cols*cw,rows*ch+96),'#e9efeb');draw=ImageDraw.Draw(image)
+    draw.text((16,12),'TAICHUNG NATIVE PREFAB CATALOG / SOURCE BLOCKOUT v1',fill='#172b25')
+    draw.text((16,32),'Reused FireRed art. Taiwan-specific skins are pending. Door squares mark dormant reservations.',fill='#31473d')
+    draw.text((16,50),'Final apron row is clear and unpainted on placement. All native doors remain closed until paired warps are verified.',fill='#31473d')
+    for i,p in enumerate(library.prefabs.values()):
+        ox,oy=(i%cols)*cw,(i//cols)*ch+80;grid=parse_words(p)
+        draw.rounded_rectangle((ox+6,oy+4,ox+cw-6,oy+ch-4),8,fill='#f9faf5',outline='#c3d0c5')
+        draw.text((ox+14,oy+12),p['name'],fill='#152b23');draw.text((ox+14,oy+30),f"{p['width']}x{p['height']} / {p['role']}",fill='#496253')
+        scale=min(2,max(1,370//(p['width']*16)),max(1,270//(p['height']*16))); step=16*scale
+        patch=Image.new('RGB',(p['width']*16,p['height']*16))
+        for y,row in enumerate(grid):
+            for x,word in enumerate(row):patch.paste(tiles[word&0x3ff],(x*16,y*16))
+        patch=patch.resize((patch.width*scale,patch.height*scale),Image.Resampling.NEAREST)
+        px,py=ox+(cw-patch.width)//2,oy+52;image.paste(patch,(px,py))
+        draw.line((px,py+(p['height']-1)*step,px+patch.width,py+(p['height']-1)*step),fill='#3c9b83',width=2)
+        for entry in p['entrances']:
+            x,y=entry['position'];draw.rectangle((px+x*step,py+y*step,px+(x+1)*step-1,py+(y+1)*step-1),outline='#dc6f28',width=2)
+        draw.text((ox+14,oy+ch-24),p['id'],fill='#526c5a')
+    output.parent.mkdir(parents=True,exist_ok=True);image.save(output)
+
+
+def render_composition(library,composition,output):
+    from PIL import Image
+    tiles=render_tools().render_metatiles(library.source,'General','PewterCity')
+    image=Image.new('RGB',(composition['width']*16,composition['height']*16))
+    for i,word in enumerate(composition['words']):image.paste(tiles[word&0x3ff],(i%composition['width']*16,i//composition['width']*16))
+    output.parent.mkdir(parents=True,exist_ok=True);image.resize((image.width*2,image.height*2),Image.Resampling.NEAREST).save(output)
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action',choices=['validate','catalog','compose'])
+    parser.add_argument('--catalog',type=Path,default=DEFAULT_CATALOG)
