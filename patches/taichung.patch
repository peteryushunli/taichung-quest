+    # Every directed borrowed-strip cell keeps both its map word and the eight
+    # exact native entries, including when one of its banks becomes private.
+    layouts = {item["id"]: item for item in frozen.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    scenes = {}
+    for name in NAMES:
+        data = frozen.json(f"data/maps/{name}/map.json")
+        layout = layouts[data["layout"]]
+        p, _ = resolved_folder(frozen, layout["primary_tileset"])
