+++ b/tools/taichung/render_overview.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Render native source QA previews from the Taichung city mapping contract.
+
+Requires Pillow. Writes three maps (plain and collision grid), a stitched overview,
+and a station close-up. These previews use actual ROM source tiles, omit sprites,
+and are not a playable substitute or final landmark artwork.
+
+  python3 tools/taichung/render_overview.py --output-dir /tmp/taichung-map-qa
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+import render_maps as native
+
+
+def font(size):
+    for name in ("/System/Library/Fonts/Supplemental/Arial.ttf", "DejaVuSans.ttf"):
+        try:
+            return ImageFont.truetype(name, size)
+        except OSError:
+            pass
+    return ImageFont.load_default()
+
+
+def render_layout(source, layout, tiles):
+    width, height = layout["width"], layout["height"]
+    data = native.words(source / layout["blockdata_filepath"])
+    if len(data) != width * height:
+        raise ValueError(f"Wrong cell count for {layout['id']}")
+    image = Image.new("RGB", (width * 16, height * 16))
+    for n, value in enumerate(data):
+        image.paste(tiles[value & 0x3FF], (n % width * 16, n // width * 16))
+    return image, data
+
+
+def collision_grid(image, data, width, scale=2):
+    image = image.resize((image.width * scale, image.height * scale), Image.Resampling.NEAREST)
+    draw = ImageDraw.Draw(image)
+    step = 16 * scale
+    for n, value in enumerate(data):
+        x, y = n % width * step, n // width * step
+        draw.rectangle((x, y, x + step - 1, y + step - 1), outline="#ee6666" if value & 0xC00 else "#444444")
+        draw.text((x + 1, y + 1), f"{n % width},{n // width}", fill="white", stroke_width=1, stroke_fill="black")
+    return image
+
+
+def slug(map_id):
+    return map_id.removeprefix("MAP_TAICHUNG_").lower().replace("_", "-")
+
+
+def overview(contract, images):
+    margin, top, legend_width = 28, 100, 460
+    world_w = max(d["worldOrigin"][0] + d["width"] for d in contract["districts"]) * 16
+    world_h = max(d["worldOrigin"][1] + d["height"] for d in contract["districts"]) * 16
+    image = Image.new("RGB", (world_w + legend_width + margin * 2, max(world_h, 1600) + top + margin), "#edf3ef")
+    draw = ImageDraw.Draw(image)
+    title, normal, small = font(34), font(22), font(18)
+    draw.text((margin, 24), "TAICHUNG / Native FireRed city blockout", font=title, fill="#1b3429")
+    draw.text((margin, 67), "Actual ROM source tiles / connected districts / provisional landmark art / no gym battles yet", font=small, fill="#355c48")
+    labels = {"MAP_TAICHUNG_OLD_CITY": "OLD CITY / Arrival", "MAP_TAICHUNG_GREENWAY": "GREENWAY / Culture", "MAP_TAICHUNG_XITUN": "XITUN / West"}
+    origins = {}
+    for district in contract["districts"]:
+        map_id = district["map"]
+        ox = margin + district["worldOrigin"][0] * 16
+        oy = top + district["worldOrigin"][1] * 16
+        source_map = images[map_id]
+        image.paste(source_map, (ox, oy))
+        origins[map_id] = (ox, oy)
+        draw.rectangle((ox, oy, ox + source_map.width - 1, oy + source_map.height - 1), outline="#356653", width=2)
+        label = labels.get(map_id, district["name"])
+        box = draw.textbbox((ox + 10, oy + 9), label, font=normal)
+        draw.rectangle((box[0] - 5, box[1] - 4, box[2] + 5, box[3] + 4), fill="#f4f5df")
+        draw.text((ox + 10, oy + 9), label, font=normal, fill="#244f3c")
+    lx = margin + world_w + 30
+    for i, landmark in enumerate(contract["landmarks"], 1):
+        ox, oy = origins[landmark["exteriorMap"]]
+        x = ox + (landmark["arrival"]["x"] + 0.5) * 16
+        y = oy + (landmark["arrival"]["y"] + 0.5) * 16
+        draw.ellipse((x - 13, y - 13, x + 13, y + 13), fill="#fff0a8", outline="#82511b", width=2)
+        text = str(i)
+        box = draw.textbbox((0, 0), text, font=small)
+        draw.text((x - (box[2] - box[0]) / 2, y - 11), text, font=small, fill="#352b13")
+        ly = top + 20 + (i - 1) * 104
+        draw.ellipse((lx, ly, lx + 30, ly + 30), fill="#fff0a8", outline="#82511b", width=2)
+        draw.text((lx + (8 if i < 10 else 4), ly + 3), text, font=small, fill="#352b13")
+        draw.text((lx + 44, ly + 3), landmark["name"]["en"], font=normal, fill="#1b3429")
+        door = landmark["entrance"]
+        draw.text((lx + 44, ly + 34), f"{slug(landmark['exteriorMap'])} / door ({door['x']},{door['y']})", font=small, fill="#355c48")
+    ly = top + 1090
+    notes = ["Starting point: Station plaza", "Maps: 40x72, 40x72, 40x64", "Each square: 16x16 native pixels", "Markers: reserved arrival locations", "Water / grass: habitat blockouts", "Source QA: object sprites omitted.", "Buildings use temporary FireRed art."]
+    for i, line in enumerate(notes):
+        draw.text((lx, ly + i * 36), line, font=normal if i == 0 else small, fill="#1b3429" if i == 0 else "#355c48")
+    return image
+
+
+def station_closeup(contract, images):
+    spawn = contract["spawn"]
+    source_map = images[spawn["map"]]
+    rect = (max(0, spawn["x"] - 6), max(0, spawn["y"] - 11), min(source_map.width // 16, spawn["x"] + 10), min(source_map.height // 16, spawn["y"] + 5))
+    crop = source_map.crop(tuple(n * 16 for n in rect))
+    crop = crop.resize((crop.width * 2, crop.height * 2), Image.Resampling.NEAREST)
+    image = Image.new("RGB", (crop.width, crop.height + 100), "#edf3ef")
+    image.paste(crop, (0, 52))
+    draw = ImageDraw.Draw(image)
+    draw.text((12, 12), "Old Station / arrival plaza", font=font(24), fill="#1b3429")
+    x, y = (spawn["x"] - rect[0] + 0.5) * 32, 52 + (spawn["y"] - rect[1] + 0.5) * 32
+    draw.ellipse((x - 11, y - 11, x + 11, y + 11), outline="#e84935", width=3)
+    draw.text((12, crop.height + 62), f"Source QA / spawn ({spawn['x']},{spawn['y']}) / temporary art", font=font(16), fill="#355c48")
+    return image
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--contract", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    contract = json.loads((args.contract or args.source / "docs/taichung-city-contract.json").read_text())
+    layouts = {l.get("id"): l for l in json.loads((args.source / "data/layouts/layouts.json").read_text())["layouts"]}
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    tilesets, images, paths = {}, {}, []
+    for district in contract["districts"]:
+        layout = layouts[district["layout"]]
+        pair = (layout["primary_tileset"], layout["secondary_tileset"])
+        if pair not in tilesets:
+            tilesets[pair] = native.render_metatiles(args.source, *pair)
+        source_map, data = render_layout(args.source, layout, tilesets[pair])
+        images[district["map"]] = source_map
+        prefix = "taichung-" + slug(district["map"]) + "-blockout"
+        for suffix, rendered in (("", source_map.resize((source_map.width * 2, source_map.height * 2), Image.Resampling.NEAREST)), ("-grid", collision_grid(source_map, data, layout["width"]))):
+            path = args.output_dir / f"{prefix}{suffix}.png"
+            rendered.save(path)
+            paths.append(path)
+    for name, image in (("taichung-city-stitched-blockout.png", overview(contract, images)), ("taichung-station-closeup.png", station_closeup(contract, images))):
+        path = args.output_dir / name
+        image.save(path)
+        paths.append(path)
+    print("\n".join(map(str, paths)))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung/rooms/build_welcome.py b/tools/taichung/rooms/build_welcome.py
new file mode 100644
index 0000000..9d50894
--- /dev/null
+++ b/tools/taichung/rooms/build_welcome.py
@@ -0,0 +1,285 @@
+#!/usr/bin/env python3
+"""Build an isolated welcome room and source-only geometry proof; no registration."""
+from __future__ import annotations
+
+import argparse
+from collections import deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[3]
+NAME = "TaichungStationWelcome"
+WIDTH, HEIGHT = 13, 10
+PRIMARY, SECONDARY = "gTileset_Building", "gTileset_GenericBuilding1"
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    loaded = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(loaded)
+    return loaded
+
+
+def values(path, fmt):
+    raw = path.read_bytes()
+    assert len(raw) % struct.calcsize(fmt) == 0
+    return list(struct.unpack(f"<{len(raw)//struct.calcsize(fmt)}{fmt}", raw))
+
+
+class SourceTiles:
+    def __init__(self):
+        from PIL import Image
+        resolver = module("welcome_source_renderer", ROOT/"tools/taichung/render_maps.py")
+        validator = module("welcome_source_attributes", ROOT/"tools/taichung/validate_city.py")
+        self.validator = validator
+        self.paths = [resolver.tileset_paths(ROOT, label) for label in (PRIMARY, SECONDARY)]
+        self.images = [Image.open(p["tiles"]) for p in self.paths]
+        assert all(i.mode == "P" for i in self.images)
+        self.defs = [values(p["metatiles"], "H") for p in self.paths]
+        self.attrs = [validator.resolve_tileset(ROOT, label) for label in (PRIMARY, SECONDARY)]
+        self.palettes = []
+        for n in range(16):
+            folder = self.paths[0 if n < 7 else 1]["palettes"]
+            self.palettes.append([tuple(map(int,line.split())) for line in (folder/f"{n:02}.pal").read_text().splitlines()[3:] if line.strip()])
+        self.cache = {}
+
+    def attribute(self, n):
+        which, local = (0,n) if n < 640 else (1,n-640)
+        assert 0 <= local < len(self.attrs[which]), f"missing attribute {n:#x}"
+        return self.attrs[which][local]
+
+    def render(self, n):
+        from PIL import Image
+        if n in self.cache:
+            return self.cache[n]
+        which, local = (0,n) if n < 640 else (1,n-640)
+        entries = self.defs[which][local*8:(local+1)*8]
+        assert len(entries) == 8, f"missing metatile {n:#x}"
+        image = Image.new("RGB", (16,16))
+        for layer in range(2):
+            for q in range(4):
+                entry = entries[layer*4+q]
+                graphic = entry & 0x3ff
+                graphic_set = 0 if graphic < 640 else 1
+                graphic = graphic if graphic_set == 0 else graphic-640
+                source = self.images[graphic_set]
+                sx, sy = graphic%16*8, graphic//16*8
+                assert sx+8 <= source.width and sy+8 <= source.height, f"missing graphic in used metatile {n:#x}"
+                for y in range(8):
+                    for x in range(8):
+                        color = source.getpixel((sx+(7-x if entry&0x400 else x),sy+(7-y if entry&0x800 else y)))
+                        if color or layer == 0:
+                            image.putpixel((q%2*8+x,q//2*8+y),self.palettes[entry>>12][color])
+        self.cache[n] = image
+        return image
+
+
+def atlas(tiles, output):
+    from PIL import Image,ImageDraw
+    image=Image.new("RGB",(16*64,6*76),"#e7e5da")
+    draw=ImageDraw.Draw(image)
+    for n in range(96):
+        x,y=n%16*64,n//16*76
+        image.paste(tiles.render(n).resize((48,48),Image.Resampling.NEAREST),(x,y))
+        draw.text((x,y+51),f"{n:03X} b{tiles.attribute(n)&0x1ff:02X}",fill="#222222")
+    output.parent.mkdir(parents=True,exist_ok=True)
+    image.save(output)
+
+
+def build_room():
+    """Pure authored data: no source mutation, scripts, state or registration."""
+    solid = lambda tile: 0x0400 | tile
+    floor = lambda tile: 0x3000 | tile
+    grid = [solid(0x008)] * (WIDTH*HEIGHT)
+    def put(x,y,word):
+        assert 0<=x<WIDTH and 0<=y<HEIGHT
+        grid[y*WIDTH+x]=word
+    for y in range(2,9):
+        for x in range(1,12):
+            put(x,y,floor(0x079))
+    for x in range(1,12):
+        put(x,0,solid(0x020))
+        put(x,1,solid(0x028))
+    # Existing native wall windows and one non-interactive information display.
+    for x in (2,9):
+        for dy,row in enumerate(((0x021,0x022),(0x029,0x02A))):
+            for dx,tile in enumerate(row): put(x+dx,dy,solid(tile))
+    put(6,1,solid(0x0A6))
+    # A tiny reception counter. The optional guide cell (6,3) stays clear behind it.
+    for dx,tile in enumerate((0x070,0x071,0x072)):put(5+dx,4,solid(tile))
+    # Two ordinary source-native potted plants on the side, outside the welcome lane.
+    for x in (1,10):
+        for dy,row in enumerate(((0x08B,0x08C),(0x093,0x094))):
+            for dx,tile in enumerate(row):put(x+dx,5+dy,solid(tile))
+    layout={"id":"LAYOUT_TAICHUNG_STATION_WELCOME","name":NAME+"_Layout",
+            "width":WIDTH,"height":HEIGHT,"border_width":2,"border_height":2,
+            "primary_tileset":PRIMARY,"secondary_tileset":SECONDARY,
+            "border_filepath":f"data/layouts/{NAME}/border.bin",
+            "blockdata_filepath":f"data/layouts/{NAME}/map.bin"}
+    map_data={"id":"MAP_TAICHUNG_STATION_WELCOME","name":NAME,"layout":layout["id"],
+              "music":"MUS_PALLET","region_map_section":"MAPSEC_TAICHUNG_OLD_CITY",
+              "requires_flash":False,"weather":"WEATHER_NONE","map_type":"MAP_TYPE_INDOOR",
+              "allow_cycling":False,"allow_escaping":False,"allow_running":False,
+              "show_map_name":False,"floor_number":0,"battle_scene":"MAP_BATTLE_SCENE_NORMAL",
+              "connections":None,"object_events":[],"warp_events":[],"coord_events":[],"bg_events":[]}
+    return grid,[solid(0x008)]*4,layout,map_data
+
+
+def source_checks(grid,border,layout,map_data,tiles):
+    assert len(grid)==WIDTH*HEIGHT and len(border)==4
+    assert layout["width"]==WIDTH and layout["height"]==HEIGHT
+    def inside(x,y):return 0<=x<WIDTH and 0<=y<HEIGHT
+    def walkable(x,y):
+        if not inside(x,y): return False
+        word=grid[y*WIDTH+x]
+        return not word&0x0c00 and word>>12==3 and tiles.attribute(word&0x3ff)&0x1ff==0
+    for word in grid+border:
+        tiles.attribute(word&0x3ff)
+        tiles.render(word&0x3ff)  # Strictly resolves only actually used native art.
+    for i,word in enumerate(grid):
+        if not word&0x0c00:
+            assert word>>12==3, f"wrong walkable elevation at{i%WIDTH},{i//WIDTH}"
+            assert tiles.attribute(word&0x3ff)&0x1ff==0, f"nonstandard walk behavior at{i%WIDTH},{i//WIDTH}"
+    for x,y in [(6,6),(6,5),(6,3)]:assert walkable(x,y),f"anchor blocked at{x},{y}"
+    assert all(walkable(x,y) for y in range(5,9) for x in range(4,9)),"welcome lane blocked"
+    reached={(6,6)};todo=deque(reached)
+    while todo:
+        x,y=todo.popleft()
+        for n in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
+            if n not in reached and walkable(*n):reached.add(n);todo.append(n)
+    floor_cells={(x,y) for y in range(HEIGHT) for x in range(WIDTH) if walkable(x,y)}
+    assert reached==floor_cells,"disconnected ordinary walkable cell"
+    boundary={(x,y) for y in range(HEIGHT) for x in range(WIDTH) if x in(0,WIDTH-1) or y in(0,HEIGHT-1)}
+    assert not floor_cells&boundary,"unsealed boundary without paired physical exit"
+    assert not map_data["warp_events"], "Physical exits need a separate paired-warp geometry review"
+    actors={(o["x"],o["y"]) for o in map_data["object_events"]}
+    assert len(actors)==len(map_data["object_events"]), "Existing actors share a cell"
+    assert all(walkable(*p) for p in actors), "Existing actor is blocked by regenerated geometry"
+    assert not actors & {(6,6),(6,5)}, "Existing actor blocks the opening anchors"
+    actor_reached={(6,6)};todo=deque(actor_reached)
+    while todo:
+        x,y=todo.popleft()
+        for n in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
+            if n not in actor_reached and n not in actors and walkable(*n):
+                actor_reached.add(n);todo.append(n)
+    assert actor_reached==floor_cells-actors, "Existing actors disconnect the welcome hall"
+    groups=json.loads((ROOT/"data/maps/map_groups.json").read_text())
+    assert groups["group_order"][43]=="gMapGroup_Taichung"
+    assert groups["gMapGroup_Taichung"][:13]==["TaichungOldCity","TaichungGreenway","TaichungXitun","TaichungOldStation_Gym","TaichungPark_Gym","TaichungMiyahara_Gym","TaichungScienceMuseum_Gym","TaichungGreenway_Gym","TaichungShenJi_Gym","TaichungFineArts_Gym","TaichungFengjia_Gym","TaichungMapleGarden_Gym","TaichungTheater_Gym"]
+    current_slot=groups["gMapGroup_Taichung"][13:14]
+    assert not current_slot or current_slot==[NAME],"proposed append slot occupied by another map"
+    outdoor_data=json.loads((ROOT/"data/maps/TaichungOldCity/map.json").read_text())
+    layouts=json.loads((ROOT/"data/layouts/layouts.json").read_text())["layouts"]
+    outdoor_layout=next(l for l in layouts if l.get("id")==outdoor_data["layout"])
+    outdoor=tiles.validator.Map(ROOT,outdoor_data,outdoor_layout,{})
+    assert outdoor.walkable(30,66) and outdoor.elevation(30,66)==3 and outdoor.behavior(30,66)==0
+    station_warp=outdoor_data["warp_events"][0]
+    assert (station_warp["x"],station_warp["y"],station_warp["dest_map"])==(32,64,"MAP_TAICHUNG_OLD_STATION_GYM")
+    return {"width":WIDTH,"height":HEIGHT,"blockdataBytes":len(grid)*2,"borderBytes":len(border)*2,
+            "allUsedMetatilesAndGraphicsResolved":True,"ordinaryWalkableCells":len(floor_cells),
+            "reachableOrdinaryWalkableCells":len(reached),"allWalkableCellsElevation3":True,
+            "existingObjectCount":len(actors),"reachableCellsWithExistingActors":len(actor_reached),
+            "walkableSourceBehaviors":[0],"spawnAndFrontClear":True,"optionalAttendantCellClear":True,
+            "welcomeLaneClear":[4,5,8,8],"boundarySealed":True,"activePhysicalWarps":0,
+            "outdoorHandoffStaticClear":True,"outdoorHandoffElevation":3,"outdoorHandoffSourceBehavior":0,
+            "existingStationGymExteriorWarp0Unchanged":[32,64],
+            "objectOrScriptBindingsAdded":False,"mapDataBufferEstimate":(WIDTH+15)*(HEIGHT+14),
+            "mapDataBufferLimit":10240,"proposedMapGroup":43,"proposedMapNumber":13,
+            "globalRegistryModifiedByBuilder":False,"nativeRuntimeTested":False}
+
+
+def render_room(grid,tiles,artifact_dir):
+    from PIL import Image,ImageDraw,ImageFont
+    image=Image.new("RGB",(WIDTH*16,HEIGHT*16))
+    for i,word in enumerate(grid):image.paste(tiles.render(word&0x3ff),(i%WIDTH*16,i//WIDTH*16))
+    image.save(artifact_dir/"station-welcome-source.png")
+    # A source overview at integer scale, explicitly without a rendered player/NPC.
+    scale=3;top=42
+    preview=Image.new("RGB",(WIDTH*16*scale,HEIGHT*16*scale+92),"#eeeadd")
+    preview.paste(image.resize((WIDTH*16*scale,HEIGHT*16*scale),Image.Resampling.NEAREST),(0,top))
+    d=ImageDraw.Draw(preview)
+    for font_name in ("/System/Library/Fonts/STHeiti Light.ttc", "DejaVuSans.ttf"):
+        try:
+            font=ImageFont.truetype(font_name,17)
+            break
+        except OSError:
+            continue
+    else:
+        font=ImageFont.load_default()
+    d.text((12,10),"Station welcome hall · SOURCE PREVIEW, no runtime claim",font=font,fill="#24323b")
+    for x,y,color in ((6,6,"#a7f484"),(6,5,"#79c9ef"),(6,3,"#e9cf77")):
+        d.rectangle((x*48,top+y*48,x*48+47,top+y*48+47),outline=color,width=3)
+    d.text((12,top+HEIGHT*48+10),"Green: spawn (6,6) · Blue: front (6,5) · Gold: optional guide (6,3)",font=font,fill="#24323b")
+    d.text((12,top+HEIGHT*48+33),"Geometry preview omits NPCs; existing map/script bindings stay intact.",font=font,fill="#465661")
+    preview.save(artifact_dir/"station-welcome-source-annotated.png")
+
+
+def existing_map_definition(map_dir, proposed):
+    path=map_dir/"map.json"
+    if not path.exists():
+        return proposed
+    current=json.loads(path.read_text())
+    for key in ("id","name","layout"):
+        assert current[key]==proposed[key], f"Existing room identity changed: {key}"
+    return current
+
+
+def write_map_scaffold(map_dir, map_data):
+    """Create missing scaffolding only; Main owns installed event/script bindings."""
+    map_dir.mkdir(parents=True,exist_ok=True)
+    path=map_dir/"map.json"
+    if not path.exists():
+        path.write_text(json.dumps(map_data,indent=2)+"\n")
+    path=map_dir/"scripts.inc"
+    if not path.exists():
+        path.write_text(f"{NAME}_MapScripts::\n\t.byte 0\n")
+
+
+def build(artifact_dir, map_dir=None, layout_dir=None):
+    artifact_dir.mkdir(parents=True,exist_ok=True)
+    tiles=SourceTiles()
+    grid,border,layout,map_data=build_room()
+    map_dir=Path(map_dir) if map_dir is not None else ROOT/f"data/maps/{NAME}"
+    layout_dir=Path(layout_dir) if layout_dir is not None else ROOT/f"data/layouts/{NAME}"
+    map_data=existing_map_definition(map_dir,map_data)
+    report=source_checks(grid,border,layout,map_data,tiles)
+    preserved={p.name:hashlib.sha256(p.read_bytes()).hexdigest()
+               for p in (map_dir/"map.json",map_dir/"scripts.inc") if p.exists()}
+    map_dir.mkdir(parents=True,exist_ok=True);layout_dir.mkdir(parents=True,exist_ok=True)
+    (layout_dir/"map.bin").write_bytes(struct.pack(f"<{len(grid)}H",*grid))
+    (layout_dir/"border.bin").write_bytes(struct.pack(f"<{len(border)}H",*border))
+    (layout_dir/"layout.json").write_text(json.dumps(layout,indent=2)+"\n")
+    write_map_scaffold(map_dir,map_data)
+    assert all(hashlib.sha256((map_dir/name).read_bytes()).hexdigest()==digest
+               for name,digest in preserved.items()), "Existing map/script bindings were modified"
+    report["existingMapAndScriptFilesPreservedByteForByte"]=sorted(preserved)
+    inputs=[ROOT/"tools/taichung/rooms/build_welcome.py",ROOT/"docs/station-welcome-map-contract.json",
+            ROOT/"src/data/tilesets/headers.h",ROOT/"src/data/tilesets/metatiles.h",ROOT/"src/data/tilesets/graphics.h"]
+    for paths in tiles.paths:
+        inputs.extend((paths["tiles"],paths["metatiles"],paths["metatiles"].parent/"metatile_attributes.bin"))
+    for n in range(16):inputs.append(tiles.paths[0 if n<7 else 1]["palettes"]/f"{n:02}.pal")
+    report["sourceSha256"]={str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest() for p in inputs}
+    (map_dir/"source-validation.json").write_text(json.dumps(report,indent=2)+"\n")
+    (artifact_dir/"station-welcome-source-validation.json").write_text(json.dumps(report,indent=2)+"\n")
+    render_room(grid,tiles,artifact_dir)
+    print(json.dumps({k:v for k,v in report.items() if k!="sourceSha256"}))
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--artifact-dir",type=Path,required=True)
+    parser.add_argument("--atlas",action="store_true")
+    args=parser.parse_args()
+    if args.atlas:
+        tiles=SourceTiles()
+        atlas(tiles,args.artifact_dir/"welcome-interior-primary-atlas.png")
+        print("Source interior atlas ready; no map or registry modified.")
+        return
+    build(args.artifact_dir)
+
+
+if __name__ == "__main__":
+    main()
