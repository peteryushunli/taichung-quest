+
+static bool8 SpeciesInCategory(u16 species, u8 type)
+{
+    if (type == TEAM_CATEGORY_ALL)
+        return TRUE;
+    // Dual-type species belong to both of their types.
+    return gSpeciesInfo[species].types[0] == type || gSpeciesInfo[species].types[1] == type;
+}
+
+static const struct TeamCategory *CurrentCategory(void)
+{
+    return &sCategories[sCategoryIds[sCategory]];
+}
+
+static const u8 *CategoryName(const struct TeamCategory *category)
+{
+    return TaichungText(category->nameEn, category->nameZh);
+}
+
+static void BuildCategories(void)
+{
+    u8 i;
+    u8 size;
+    u16 species;
+
+    sCategoryCount = 0;
+    for (i = 0; i < ARRAY_COUNT(sCategories); i++)
+    {
+        size = 0;
+        for (species = 1; species <= TEAM_ROSTER_COUNT; species++)
+        {
+            if (TaichungTeamSpeciesAllowed(species) && SpeciesInCategory(species, sCategories[i].type))
+                size++;
+        }
+        if (size == 0)
+            continue;
+        sCategoryIds[sCategoryCount] = i;
+        sCategorySizes[sCategoryCount] = size;
+        sCategoryCount++;
+    }
+    if (sCategory >= sCategoryCount)
+        sCategory = 0;
+}
+
+// Lists the current category by dex number and keeps sSpecies selected when it is listed.
+static void BuildRoster(void)
+{
+    u8 type = CurrentCategory()->type;
+    u16 species;
+
+    sRosterCount = 0;
+    sRosterIndex = 0;
+    for (species = 1; species <= TEAM_ROSTER_COUNT; species++)
+    {
+        if (!TaichungTeamSpeciesAllowed(species) || !SpeciesInCategory(species, type))
+            continue;
+        if (species == sSpecies)
+            sRosterIndex = sRosterCount;
+        sRoster[sRosterCount++] = species;
+    }
+    if (sRosterCount == 0)
+        sRoster[sRosterCount++] = SPECIES_BULBASAUR;
+    sSpecies = sRoster[sRosterIndex];
+}
+
+static void DrawCategories(void)
+{
+    u8 i;
+    u8 x;
+    u8 y;
+    u8 text[8];
+
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sCategoryTitleEn, sCategoryTitleZh));
+    Print(8, 22, sMutedColors, TaichungText(sCategoryHintEn, sCategoryHintZh));
+    for (i = 0; i < sCategoryCount; i++)
+    {
+        x = 8 + (i / CATEGORY_ROWS) * CATEGORY_COLUMN_WIDTH;
+        y = 40 + (i % CATEGORY_ROWS) * 16;
+        if (i == sCategory)
+            Print(x, y, sSelectedColors, sCursor);
+        Print(x + 8, y, i == sCategory ? sSelectedColors : sTextColors, CategoryName(&sCategories[sCategoryIds[i]]));
+        ConvertIntToDecimalStringN(text, sCategorySizes[i], STR_CONV_MODE_RIGHT_ALIGN, 3);
+        Print(x + 52, y, sMutedColors, text);
+    }
+    Print(8, 144, sTextColors, TaichungText(sCategoryFooterEn, sCategoryFooterZh));
+}
+
+static void DrawSpecies(void)
+{
+    u8 first = (sRosterIndex / SPECIES_PER_PAGE) * SPECIES_PER_PAGE;
+    u8 i;
+    u8 y;
+    u8 text[12];
+    u8 *end;
+
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, CategoryName(CurrentCategory()));
+    PrintNumber(188, 6, sSpecies, 3);
+    end = ConvertIntToDecimalStringN(text, sRosterIndex + 1, STR_CONV_MODE_LEFT_ALIGN, 3);
+    end = StringCopy(end, sSlash);
+    ConvertIntToDecimalStringN(end, sRosterCount, STR_CONV_MODE_LEFT_ALIGN, 3);
+    Print(8, 22, sMutedColors, text);
+    Print(56, 22, sMutedColors, TaichungText(sSpeciesHintEn, sSpeciesHintZh));
+    for (i = first; i < first + SPECIES_PER_PAGE && i < sRosterCount; i++)
+    {
+        y = 36 + (i - first) * 13;
+        if (i == sRosterIndex)
+            Print(6, y, sSelectedColors, sCursor);
+        ConvertIntToDecimalStringN(text, sRoster[i], STR_CONV_MODE_LEADING_ZEROS, 3);
+        Print(18, y, i == sRosterIndex ? sSelectedColors : sMutedColors, text);
+        Print(40, y, i == sRosterIndex ? sSelectedColors : sTextColors, gSpeciesNames[sRoster[i]]);
+    }
+    Print(148, 30, sSelectedColors, sLevel);
+    DrawMoves(140, 48);
+    Print(8, 144, sMutedColors, TaichungText(sSpeciesFooterEn, sSpeciesFooterZh));
+}
+
+static void DrawConfirmation(void)
+{
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    Print(8, 24, sTextColors, TaichungText(sConfirmEn, sConfirmZh));
+    Print(8, 48, sSelectedColors, gSpeciesNames[sSpecies]);
+    Print(100, 48, sSelectedColors, sLevel);
+    if (sSlot < CalculatePlayerPartyCount())
+    {
+        Print(8, 70, sMutedColors, TaichungText(sReplacingEn, sReplacingZh));
+        Print(8, 86, sTextColors, gSpeciesNames[GetMonData(&gPlayerParty[sSlot], MON_DATA_SPECIES)]);
+    }
+    DrawMoves(140, 48);
+    Print(8, 126, sMutedColors, TaichungText(sFullHpEn, sFullHpZh));
+    Print(8, 144, sTextColors, TaichungText(sConfirmFooterEn, sConfirmFooterZh));
+}
+
+static void DrawTeamMenu(void)
+{
+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    if (sScreen == TEAM_SCREEN_SLOTS)
+        DrawSlots();
+    else if (sScreen == TEAM_SCREEN_CATEGORIES)
+        DrawCategories();
+    else if (sScreen == TEAM_SCREEN_SPECIES)
+        DrawSpecies();
+    else
+        DrawConfirmation();
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+}
+
+void ShowTaichungTeamMenu(MainCallback returnCallback)
