+    changes = [dict(x=i % width, y=i // width, before=f"0x{a:04X}", after=f"0x{b:04X}") for i, (a, b) in enumerate(zip(own["grid"], grid)) if a != b]
+    blocked = [[i % width, i // width] for i, (a, b) in enumerate(zip(own["grid"], grid)) if not a & 0xC00 and b & 0xC00]
+    opened = [[i % width, i // width] for i, (a, b) in enumerate(zip(own["grid"], grid)) if a & 0xC00 and not b & 0xC00]
+    old_manifest = frozen.json("data/taichung/landmarks/greenway-native/manifest.json")
+    art_patterns = {canonical(tuple(art.getpixel((x*8+dx, y*8+dy)) for dy in range(8) for dx in range(8)))[0] for y in range(art.height//8) for x in range(art.width//8)}
+    outputs = [path for folder in (PRIMARY, SECONDARY, DATA) for path in (root/folder).rglob("*") if path.is_file() and path.suffix in (".png", ".bin", ".pal")]
+    result = dict(schemaVersion=1, baselineCommit=BASE, geometryBaselineCommit=GEOMETRY_BASE,
+        primary=PRIMARY_LABEL, secondary=SECONDARY_LABEL, primaryFolder=PRIMARY, secondaryFolder=SECONDARY,
+        mapFile=DATA+"/map.bin", baselineMapFile=DATA+"/baseline-map.bin", width=width, height=height,
+        mapSha256=digest((root/DATA/"map.bin").read_bytes()), sourceMapSha256=digest(frozen.read(own["layout"]["blockdata_filepath"])),
+        landmarks=[dict(id="calligraphy-greenway", input=INPUT, inputSha256=digest(frozen.read(INPUT)), origin=list(ORIGIN), size=list(SIZE),
+            door=list(DOOR), palette=PALETTE, role="landmark", occupiedCells=occupied, localMetatileIds=local_ids,
+            provisionalRasterPortalLocal=[4, 9], approach=[22, 37], arrival=[22, 39], nativeDoorWord="0x043D")],
+        retainedLandmarks=old_manifest["landmarks"], retiredFootprints=[list(RETIRED)],
+        secondaryGraphics=len(packer.secondary), loadedSecondaryGraphics=loaded, secondaryMetatiles=len(attributes),
+        protectedRawGraphicIds=sorted(protected), preservedGeneralRawGraphicIds=sorted(general),
+        allocatedPrimaryRawGraphicIds=packer.allocated, generalAnimationDestinations=sorted(animated),
+        protectedGeneralMetatileIds=sorted(allowed_general), protectedBorrowedMetatileIds=sorted(borrowed_ids),
+        primaryAnimationCallback="InitTilesetAnim_General", doorScratch=[1016, 1024],
+        graphicsBudget=dict(primaryTotal=640, protectedPrimary=278, oldArtMovedToPrimary=350, cmpNewPrimary=12,
+            cmpPatterns=len(art_patterns), cmpResidentPatternReuses=len(art_patterns & before_cmp_patterns),
+            staticSecondaryCapacity=376, secondaryStaticSpare=376-len(packer.secondary), remainingPrimaryHoles=0),
+        oldRawGraphicRemaps={str(n): value for n, value in sorted(relocation.items())},
+        paletteChanges={"8":dict(changedIndices=sorted(palette_changes), preservedIndices=sorted(set(range(16))-palette_changes),
+            allowedSpareIndices=sorted(SPARE_PALETTE_INDICES), existingDefinitionColorsPreserved=True)},
+        approval=dict(source=APPROVAL, sourceSha256=digest(frozen.read(APPROVAL)), artworkApproved=True,
+            anchorChoiceApproved=True, text=approval["approval"], originalStudySha256=approval["originalSha256"]),
+        encodingManifest=dict(path=ENCODING, sha256=digest(frozen.read(ENCODING))),
+        changedMapWords=len(changes), changedCells=changes, newlyBlockedCells=blocked, newlyBlockedCellCount=len(blocked),
+        becameWalkableCells=opened, becameWalkableCellCount=len(opened),
+        sourceProof=dict(passed=True, actualWrittenBankRendersChecked=True, protectedRawSlotsCompared=278,
+            priorMetatileRgbAttributeComparisons=len(allowed_general)+207, priorSecondaryNumericIdsPreserved=207,
+            exactBorrowedEntryWordsPreserved=True, borrowedStripCellsCompared=sum(r["cells"] for r in strip_records),
+            connectionStrips=strip_records, cmpForegroundCellsCompared=len(local_ids),
+            allTenGymBindingsAndSourceBfsPassed=True, reachableExteriorNodes=len(geometry.distances),
+            walkableSeamCrossings=len(geometry.open_edges), originalRegisteredMapUnwritten=True),
+        sourceInputSha256={path:digest(raw) for path, raw in sorted(frozen.cache.items())},
+        sourceHashRepresentation="frozen Git blob bytes; new .pal output hashes use their written CRLF bytes",
