+++ b/tools/taichung/render_maps.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Render actual FireRed source metatiles for map/tileset QA (not a game engine).
+
+Examples:
+  python3 tools/taichung/render_maps.py --layout LAYOUT_CELADON_CITY --output /tmp/celadon.png
+  python3 tools/taichung/render_maps.py --primary General --secondary SaffronCity --atlas --start 640 --output /tmp/saffron-atlas.png
+
+Requires Pillow. Outputs are deliberately explicit so they cannot replace release art.
+Animated tiles show their source image's initial frame; object events are not drawn.
+"""
+
+import argparse
+import json
+import re
+import struct
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+
+def words(path):
+    data = path.read_bytes()
+    if len(data) % 2:
+        raise ValueError(f"Odd-size word data: {path}")
+    return struct.unpack(f"<{len(data) // 2}H", data)
+
+
+def tileset_paths(source, label):
+    """Resolve C tileset labels through their source declarations, not name casing."""
+    label = label if label.startswith("gTileset_") else f"gTileset_{label}"
+    declarations = (source / "src/data/tilesets/headers.h").read_text()
+    header = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", declarations, re.S)
+    if not header:
+        raise ValueError(f"Unknown tileset {label}")
+
+    files = "\n".join((source / name).read_text() for name in (
+        "src/data/tilesets/metatiles.h", "src/data/tilesets/graphics.h", "src/graphics.c"
+    ))
+    result = {}
+    for field in ("tiles", "metatiles", "palettes"):
+        match = re.search(rf"\.{field}\s*=\s*(\w+)", header.group(1))
+        if not match:
+            raise ValueError(f"Missing {field} in {label}")
+        symbol = re.escape(match.group(1))
+        declaration = re.search(rf"\b{symbol}\s*\[.*?=\s*(.*?);", files, re.S)
+        if not declaration:
+            raise ValueError(f"Could not resolve {match.group(1)}")
+        path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1))
+        if not path:
+            raise ValueError(f"No source path for {match.group(1)}")
+        result[field] = source / path.group(1)
+    result["tiles"] = result["tiles"].parent / "tiles.png"
+    result["palettes"] = result["palettes"].parent
+    return result
+
+
+def render_metatiles(source, primary, secondary):
+    sets = [tileset_paths(source, name) for name in (primary, secondary)]
+    sources = [Image.open(s["tiles"]) for s in sets]
+    for path, image in zip(sets, sources):
+        if image.mode != "P":
+            raise ValueError(f"Expected indexed source PNG: {path['tiles']}")
+    palettes = []
+    for p in range(16):
+        folder = sets[0 if p < 7 else 1]["palettes"]
+        lines = (folder / f"{p:02}.pal").read_text().splitlines()[3:]
+        palettes.append([tuple(map(int, line.split())) for line in lines if line.strip()])
+    data = [words(s["metatiles"]) for s in sets]
+    count = 640 + len(data[1]) // 8
+    images = []
+    for n in range(count):
+        set_index, pos = (0, n) if n < 640 else (1, n - 640)
+        image = Image.new("RGB", (16, 16))
+        if (pos + 1) * 8 > len(data[set_index]):
+            images.append(image)
+            continue
+        for layer in range(2):
+            for quadrant in range(4):
+                value = data[set_index][pos * 8 + layer * 4 + quadrant]
+                tile_n = value & 0x3FF
+                tile_source = sources[0 if tile_n < 640 else 1]
+                tile_n = tile_n if tile_n < 640 else tile_n - 640
+                sx, sy = (tile_n % 16) * 8, (tile_n // 16) * 8
+                if sx + 8 > tile_source.width or sy + 8 > tile_source.height:
+                    raise ValueError(f"Metatile {n:#x} references missing graphic {tile_n:#x}")
+                palette = palettes[value >> 12]
+                for y in range(8):
+                    for x in range(8):
+                        tx = 7 - x if value & 0x400 else x
+                        ty = 7 - y if value & 0x800 else y
+                        index = tile_source.getpixel((sx + tx, sy + ty))
+                        if index or layer == 0:
+                            image.putpixel((quadrant % 2 * 8 + x, quadrant // 2 * 8 + y), palette[index])
+        images.append(image)
+    return images
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--layout", help="Native layout ID, e.g. LAYOUT_TAICHUNG_OLD_CITY")
+    parser.add_argument("--primary", help="Override primary tileset, e.g. General or gTileset_General")
+    parser.add_argument("--secondary", help="Override secondary tileset, e.g. SaffronCity")
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--atlas", action="store_true", help="Render the tileset instead of a map")
+    parser.add_argument("--start", type=lambda x: int(x, 0), default=0, help="First atlas index (decimal or 0x...)")
+    parser.add_argument("--count", type=int, help="Maximum number of atlas metatiles")
+    parser.add_argument("--scale", type=int, default=2)
+    parser.add_argument("--grid", action="store_true", help="Show source coordinates and collision mask")
+    args = parser.parse_args()
+    if args.scale < 1:
+        parser.error("--scale must be positive")
+
+    layout = None
+    if args.layout:
+        layouts = json.loads((args.source / "data/layouts/layouts.json").read_text())["layouts"]
+        layout = next((x for x in layouts if x.get("id") == args.layout), None)
+        if layout is None:
+            parser.error(f"Unknown layout: {args.layout}")
+    elif not args.atlas:
+        parser.error("--layout is required unless --atlas is used")
+    primary = args.primary or (layout or {}).get("primary_tileset")
+    secondary = args.secondary or (layout or {}).get("secondary_tileset")
+    if not primary or not secondary:
+        parser.error("Provide --layout or both --primary and --secondary")
+    tiles = render_metatiles(args.source, primary, secondary)
+
+    if args.atlas:
+        end = min(len(tiles), args.start + args.count) if args.count else len(tiles)
+        if not 0 <= args.start < end:
+            parser.error("Atlas range contains no tiles")
+        cell = 16 * args.scale
+        image = Image.new("RGB", (16 * (cell + 8), ((end - args.start + 15) // 16) * (cell + 16)), "#f0f0dd")
+        draw = ImageDraw.Draw(image)
+        for i, n in enumerate(range(args.start, end)):
+            x, y = i % 16 * (cell + 8), i // 16 * (cell + 16)
+            image.paste(tiles[n].resize((cell, cell), Image.Resampling.NEAREST), (x, y))
+            draw.text((x, y + cell), f"{n:03x}", fill="#222222")
+    else:
+        width, height = layout["width"], layout["height"]
+        data = words(args.source / layout["blockdata_filepath"])
+        if len(data) != width * height:
+            raise ValueError(f"Layout contains {len(data)} cells, expected {width * height}")
+        image = Image.new("RGB", (width * 16, height * 16))
+        for n, value in enumerate(data):
+            metatile = value & 0x3FF
+            if metatile >= len(tiles):
+                raise ValueError(f"Missing metatile {metatile:#x} at {n % width},{n // width}")
+            image.paste(tiles[metatile], (n % width * 16, n // width * 16))
+        image = image.resize((image.width * args.scale, image.height * args.scale), Image.Resampling.NEAREST)
+        if args.grid:
+            draw = ImageDraw.Draw(image)
+            step = 16 * args.scale
+            for n, value in enumerate(data):
+                x, y = n % width * step, n // width * step
+                draw.rectangle((x, y, x + step - 1, y + step - 1), outline="#ee6666" if value & 0xC00 else "#444444")
+                draw.text((x + 1, y + 1), f"{n % width},{n // width}", fill="white", stroke_width=1, stroke_fill="black")
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    image.save(args.output)
+    print(f"{args.output} ({image.width}x{image.height})")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung/render_overview.py b/tools/taichung/render_overview.py
new file mode 100644
index 0000000..4c199be
--- /dev/null
+++ b/tools/taichung/render_overview.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Render native source QA previews from the Taichung city mapping contract.
+
+Requires Pillow. Writes three maps (plain and collision grid), a stitched overview,
+and a station close-up. These previews use actual ROM source tiles, omit sprites,
+and are not a playable substitute or final landmark artwork.
+
+  python3 tools/taichung/render_overview.py --output-dir /tmp/taichung-map-qa
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+import render_maps as native
+
+
+def font(size):
+    for name in ("/System/Library/Fonts/Supplemental/Arial.ttf", "DejaVuSans.ttf"):
+        try:
+            return ImageFont.truetype(name, size)
+        except OSError:
+            pass
+    return ImageFont.load_default()
+
+
+def render_layout(source, layout, tiles):
+    width, height = layout["width"], layout["height"]
+    data = native.words(source / layout["blockdata_filepath"])
+    if len(data) != width * height:
+        raise ValueError(f"Wrong cell count for {layout['id']}")
+    image = Image.new("RGB", (width * 16, height * 16))
+    for n, value in enumerate(data):
+        image.paste(tiles[value & 0x3FF], (n % width * 16, n // width * 16))
+    return image, data
+
+
+def collision_grid(image, data, width, scale=2):
+    image = image.resize((image.width * scale, image.height * scale), Image.Resampling.NEAREST)
+    draw = ImageDraw.Draw(image)
+    step = 16 * scale
+    for n, value in enumerate(data):
+        x, y = n % width * step, n // width * step
+        draw.rectangle((x, y, x + step - 1, y + step - 1), outline="#ee6666" if value & 0xC00 else "#444444")
+        draw.text((x + 1, y + 1), f"{n % width},{n // width}", fill="white", stroke_width=1, stroke_fill="black")
+    return image
+
+
+def slug(map_id):
+    return map_id.removeprefix("MAP_TAICHUNG_").lower().replace("_", "-")
+
+
+def overview(contract, images):
+    margin, top, legend_width = 28, 100, 460
+    world_w = max(d["worldOrigin"][0] + d["width"] for d in contract["districts"]) * 16
+    world_h = max(d["worldOrigin"][1] + d["height"] for d in contract["districts"]) * 16
+    image = Image.new("RGB", (world_w + legend_width + margin * 2, max(world_h, 1600) + top + margin), "#edf3ef")
+    draw = ImageDraw.Draw(image)
+    title, normal, small = font(34), font(22), font(18)
+    draw.text((margin, 24), "TAICHUNG / Native FireRed city blockout", font=title, fill="#1b3429")
+    draw.text((margin, 67), "Actual ROM source tiles / connected districts / provisional landmark art / no gym battles yet", font=small, fill="#355c48")
+    labels = {"MAP_TAICHUNG_OLD_CITY": "OLD CITY / Arrival", "MAP_TAICHUNG_GREENWAY": "GREENWAY / Culture", "MAP_TAICHUNG_XITUN": "XITUN / West"}
+    origins = {}
+    for district in contract["districts"]:
+        map_id = district["map"]
+        ox = margin + district["worldOrigin"][0] * 16
+        oy = top + district["worldOrigin"][1] * 16
+        source_map = images[map_id]
+        image.paste(source_map, (ox, oy))
+        origins[map_id] = (ox, oy)
+        draw.rectangle((ox, oy, ox + source_map.width - 1, oy + source_map.height - 1), outline="#356653", width=2)
+        label = labels.get(map_id, district["name"])
+        box = draw.textbbox((ox + 10, oy + 9), label, font=normal)
+        draw.rectangle((box[0] - 5, box[1] - 4, box[2] + 5, box[3] + 4), fill="#f4f5df")
+        draw.text((ox + 10, oy + 9), label, font=normal, fill="#244f3c")
+    lx = margin + world_w + 30
+    for i, landmark in enumerate(contract["landmarks"], 1):
+        ox, oy = origins[landmark["exteriorMap"]]
+        x = ox + (landmark["arrival"]["x"] + 0.5) * 16
+        y = oy + (landmark["arrival"]["y"] + 0.5) * 16
+        draw.ellipse((x - 13, y - 13, x + 13, y + 13), fill="#fff0a8", outline="#82511b", width=2)
+        text = str(i)
+        box = draw.textbbox((0, 0), text, font=small)
+        draw.text((x - (box[2] - box[0]) / 2, y - 11), text, font=small, fill="#352b13")
+        ly = top + 20 + (i - 1) * 104
+        draw.ellipse((lx, ly, lx + 30, ly + 30), fill="#fff0a8", outline="#82511b", width=2)
+        draw.text((lx + (8 if i < 10 else 4), ly + 3), text, font=small, fill="#352b13")
+        draw.text((lx + 44, ly + 3), landmark["name"]["en"], font=normal, fill="#1b3429")
+        door = landmark["entrance"]
+        draw.text((lx + 44, ly + 34), f"{slug(landmark['exteriorMap'])} / door ({door['x']},{door['y']})", font=small, fill="#355c48")
+    ly = top + 1090
+    notes = ["Starting point: Station plaza", "Maps: 40x72, 40x72, 40x64", "Each square: 16x16 native pixels", "Markers: reserved arrival locations", "Water / grass: habitat blockouts", "Source QA: object sprites omitted.", "Buildings use temporary FireRed art."]
+    for i, line in enumerate(notes):
+        draw.text((lx, ly + i * 36), line, font=normal if i == 0 else small, fill="#1b3429" if i == 0 else "#355c48")
+    return image
+
+
+def station_closeup(contract, images):
+    spawn = contract["spawn"]
+    source_map = images[spawn["map"]]
+    rect = (max(0, spawn["x"] - 6), max(0, spawn["y"] - 11), min(source_map.width // 16, spawn["x"] + 10), min(source_map.height // 16, spawn["y"] + 5))
+    crop = source_map.crop(tuple(n * 16 for n in rect))
+    crop = crop.resize((crop.width * 2, crop.height * 2), Image.Resampling.NEAREST)
+    image = Image.new("RGB", (crop.width, crop.height + 100), "#edf3ef")
+    image.paste(crop, (0, 52))
+    draw = ImageDraw.Draw(image)
+    draw.text((12, 12), "Old Station / arrival plaza", font=font(24), fill="#1b3429")
+    x, y = (spawn["x"] - rect[0] + 0.5) * 32, 52 + (spawn["y"] - rect[1] + 0.5) * 32
+    draw.ellipse((x - 11, y - 11, x + 11, y + 11), outline="#e84935", width=3)
+    draw.text((12, crop.height + 62), f"Source QA / spawn ({spawn['x']},{spawn['y']}) / temporary art", font=font(16), fill="#355c48")
+    return image
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--contract", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    contract = json.loads((args.contract or args.source / "docs/taichung-city-contract.json").read_text())
+    layouts = {l.get("id"): l for l in json.loads((args.source / "data/layouts/layouts.json").read_text())["layouts"]}
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    tilesets, images, paths = {}, {}, []
+    for district in contract["districts"]:
+        layout = layouts[district["layout"]]
+        pair = (layout["primary_tileset"], layout["secondary_tileset"])
+        if pair not in tilesets:
+            tilesets[pair] = native.render_metatiles(args.source, *pair)
+        source_map, data = render_layout(args.source, layout, tilesets[pair])
+        images[district["map"]] = source_map
+        prefix = "taichung-" + slug(district["map"]) + "-blockout"
+        for suffix, rendered in (("", source_map.resize((source_map.width * 2, source_map.height * 2), Image.Resampling.NEAREST)), ("-grid", collision_grid(source_map, data, layout["width"]))):
+            path = args.output_dir / f"{prefix}{suffix}.png"
+            rendered.save(path)
+            paths.append(path)
+    for name, image in (("taichung-city-stitched-blockout.png", overview(contract, images)), ("taichung-station-closeup.png", station_closeup(contract, images))):
+        path = args.output_dir / name
+        image.save(path)
+        paths.append(path)
+    print("\n".join(map(str, paths)))
+
+
+if __name__ == "__main__":
+    main()
