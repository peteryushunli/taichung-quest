+#!/usr/bin/env python3
+"""Read-only Greenway private-primary/CMP capacity proof against frozen e9.
+
+Writes only isolated analysis JSON. No native source, bank, map, registry, save,
+browser or ROM is changed; this does not claim runtime transition safety.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
+PRIMARY = "data/tilesets/primary/taichung_old_core"
+SECONDARY = "data/tilesets/secondary/taichung_greenway"
+GREENWAY = "MAP_TAICHUNG_GREENWAY"
+RETIRE = [17, 30, 27, 36]
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(value)
+    return value
+
+
+def analyze(source):
+    support = module("cmp_bank", ROOT / "tools/taichung/landmarks/check_old_core.py")
+    strips = module("cmp_strip", ROOT / "tools/taichung/landmarks/analyze_theater_cohort.py")
+    pack = module("cmp_pack", ROOT / "tools/taichung/landmarks/analyze_xitun_primary.py")
+    files = support.Files(source, BASE)
+    bank = support.Bank(files, PRIMARY, SECONDARY)
+    audit = files.json("data/taichung/landmarks/old-core-bank-audit.json")
+    animated = set(audit["generalAnimation"]["fixedGraphicIds"])
+    general = set(audit["primaryConservativeRawHoleOption"]["requiredRawGraphicIds"]) | animated
+    protected = set(general)
+    protected_mts = set()
+    layouts = {l["id"]: l for l in files.json("data/layouts/layouts.json")["layouts"] if "id" in l}
+    scenes = {}
+    for name in ("TaichungOldCity", "TaichungGreenway", "TaichungXitun"):
+        data = files.json(f"data/maps/{name}/map.json")
+        layout = layouts[data["layout"]]
+        p, _ = support.resolved_folder(files, layout["primary_tileset"])
+        s, _ = support.resolved_folder(files, layout["secondary_tileset"])
+        scenes[data["id"]] = {"data": data, "layout": layout, "words": files.words(layout["blockdata_filepath"]),
+                              "border": files.words(layout["border_filepath"]), "bank": support.Bank(files, p, s)}
+    incoming, records = [], []
+    for mid, view in scenes.items():
+        for c in view["data"]["connections"]:
+            donor = scenes[c["map"]]
+            points = list(strips.visible_cells(view["layout"], donor["layout"], c["direction"], c["offset"]))
+            words = [donor["words"][y * donor["layout"]["width"] + x] for x, y in points]
+            ids = {word & 1023 for word in words}
+            protected_mts.update(ids)
+            refs = {entry & 1023 for n in ids for entry in bank.entries(n)}
+            assert all(n < 640 for n in refs)
+            protected.update(refs)
+            records.append({"viewer": mid, "donor": c["map"], "donorBoundsInclusive": strips.bounds(points), "cells": len(points), "metatileIds": sorted(ids)})
+            if mid == GREENWAY:
+                incoming.extend(words)
+    assert len(general) == 228 and len(animated) == 70 and len(protected) == 278
+    free = sorted(set(range(640)) - protected)
+    simulated = deepcopy(bank)
+    simulated.render_cache = {}
+    lookup = {}
+    for n in sorted(protected - animated):
+        pixels, flags = pack.canonical(bank.graphic(n))
+        lookup.setdefault(pixels, (n, flags))
+    refs = {entry & 1023 for entry in bank.defs[1]}
+    movable = sorted(refs - protected)
+    primary_alloc, secondary, remap, reused = [], [], {}, []
+    for old in movable:
+        pixels, flags = pack.canonical(bank.graphic(old))
+        if pixels not in lookup:
+            if len(primary_alloc) < len(free):
+                n = free[len(primary_alloc)]
+                primary_alloc.append(n)
+                image = simulated.images[0]
+                for y in range(8):
+                    for x in range(8):
+                        image.putpixel((n % (image.width // 8)*8+x, n // (image.width // 8)*8+y), pixels[y*8+x])
+            else:
+                n = 640 + len(secondary)
+                secondary.append(pixels)
+            lookup[pixels] = n, 0
+        else:
+            reused.append(old)
+        n, stored = lookup[pixels]
+        remap[old] = n | (flags ^ stored)
+    for i, entry in enumerate(simulated.defs[1]):
+        n = entry & 1023
+        if n in remap:
+            packed = remap[n]
+            simulated.defs[1][i] = (entry & 0xF000) | ((entry & 0xC00) ^ (packed & 0xC00)) | (packed & 1023)
+    sheet = Image.new("P", (128, max(1, (len(secondary) + 15) // 16)*8))
+    sheet.putpalette(bank.images[1].getpalette())
+    for n, pixels in enumerate(secondary):
+        for y in range(8):
+            for x in range(8):
+                sheet.putpixel((n % 16*8+x, n // 16*8+y), pixels[y*8+x])
+    simulated.images[1] = sheet
+    preserved_general_mts = audit["primaryConservativeRawHoleOption"]["generalMetatileIdsToKeepCompatible"]
+    checked = list(preserved_general_mts) + list(range(640, 640+len(bank.attrs[1])))
+    assert all(simulated.render(n) == bank.render(n) and simulated.attr(n) == bank.attr(n) for n in checked)
+    assert all(simulated.graphic(n) == bank.graphic(n) for n in protected)
+    for record in records:
+        vb = simulated if record["viewer"] == GREENWAY else scenes[record["viewer"]]["bank"]
+        db = simulated if record["donor"] == GREENWAY else scenes[record["donor"]]["bank"]
+        ids = record["metatileIds"]
+        record["entryWordsIdentical"] = all(vb.entries(n) == db.entries(n) for n in ids)
+        record["rgbAndAttributesIdentical"] = all(vb.render(n) == db.render(n) and vb.attr(n) == db.attr(n) for n in ids)
+        assert record["entryWordsIdentical"] and record["rgbAndAttributesIdentical"]
+    greenway = scenes[GREENWAY]
+    cleared = greenway["words"][:]
+    for y in range(RETIRE[1], RETIRE[3]+1):
+        for x in range(RETIRE[0], RETIRE[2]+1):
+            cleared[y*40+x] = 0x3175
+    required_ids = {word & 1023 for word in cleared + greenway["border"] + incoming}
+    indices = {n: set() for n in range(13)}
+    for mt in required_ids:
+        for entry in bank.entries(mt):
+            indices[entry >> 12].update(bank.graphic(entry & 1023))
+    definition_indices = {n: set() for n in range(13)}
+    for mt in checked:
+        for entry in bank.entries(mt):
+            definition_indices[entry >> 12].update(bank.graphic(entry & 1023))
+    assets = {7: set(), 9: set()}
+    for item in files.json("data/taichung/landmarks/greenway-native/manifest.json")["landmarks"]:
+        assets[item["palette"]].update(files.image(item["input"]).get_flattened_data())
+    palette_report = {}
+    for n in range(13):
+        pinned = indices[n] | definition_indices[n] | assets.get(n, set()) | {0}
+        spare = sorted(set(range(16)) - pinned)
+        palette_report[str(n)] = {"sceneAndBorrowedIndices": sorted(indices[n]), "existingApprovedArtIndices": sorted(assets.get(n, set())),
+                                  "allPreservedDefinitionIndices": sorted(definition_indices[n]),
+                                  "unusedIndicesInThisScope": spare, "sourceRgbEntries": bank.palettes[n],
+                                  "wholeBankFixedByContract": n <= 6 or n == 12,
+                                  "potentialEditableUnusedIndices": [] if n <= 6 or n == 12 else spare}
+    return {"baselineCommit": BASE, "scope": "Read-only frozen source simulation; no source installation or runtime safety claim.",
+            "primaryProtection": {"generalRawSlots": len(general), "generalAnimationDestinations": len(animated),
+                                  "additionalBorderReferencedRawSlots": len(protected-general), "protectedRawSlots": len(protected),
+                                  "freeRawSlots": len(free), "protectedRawIds": sorted(protected),
+                                  "protectedBorderMetatileIds": sorted(protected_mts)},
+            "relocation": {"existingSecondaryGraphicRefs": len({n for n in movable if n >= 640}),
+                           "movableUnprotectedPrimaryGraphicRefs": sorted(n for n in movable if n < 640),
+                           "exactProtectedPatternReuses": len(reused), "newPrimarySlots": len(primary_alloc),
+                           "primarySlotsRemaining": len(free)-len(primary_alloc), "secondaryPatternsRemaining": len(secondary),
+                           "staticSecondarySlotsAvailableForCmp": 376-len(secondary), "existingMetatileDefinitionsCompared": len(checked),
+                           "secondaryDefinitionsPreserved": len(bank.attrs[1]), "appendableSecondaryDefinitionCount": 384-len(bank.attrs[1]),
+                           "preservedAllMapWordsAndMetatileRgbAttributes": True,
+                           "rawGraphicRemaps": {str(k): v for k, v in sorted(remap.items())}},
+            "strips": records, "paletteAnalysis": {"authoredRetirementRectangleInclusive": RETIRE,
+                         "actualBaselineCalligraphyFootprint": next(l["footprint"] for l in files.json("docs/taichung-city-contract.json")["landmarks"] if l["id"] == "calligraphy-greenway"),
+                         "remainingUsedBanks": [n for n in range(13) if indices[n]],
+                         "fullFreeSecondaryBanks": [n for n in range(7, 13) if not indices[n]],
+                         "palette12MustStayWhollyFixed": True, "banks": palette_report,
+                         "per8x8TileSinglePaletteLimit": True, "newCmpArtworkFitMeasured": False},
+            "frozenInputSha256": {path: hashlib.sha256(raw).hexdigest() for path, raw in sorted(files.cache.items())}}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--output", type=Path, default=ROOT.parents[1] / "artifacts/worktrees/c291d4842985/greenway-primary-plan/analysis.json")
+    args = parser.parse_args()
+    result = analyze(args.source.resolve())
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2)+"\n")
+    print(json.dumps({"protection": {k: v for k, v in result["primaryProtection"].items() if not k.endswith("Ids")},
+                      "relocation": {k: v for k, v in result["relocation"].items() if k != "rawGraphicRemaps"},
+                      "freeSecondaryPaletteBanks": result["paletteAnalysis"]["fullFreeSecondaryBanks"],
+                      "potentialUnusedIndices": {n: b["potentialEditableUnusedIndices"] for n, b in result["paletteAnalysis"]["banks"].items() if int(n) >= 7},
+                      "output": str(args.output)}, indent=2))
