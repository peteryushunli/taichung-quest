+"""Check the 75-person compiled city and its uniform spawn-viewport census."""
+from pathlib import Path
+import argparse,json
+from collections import Counter
+p=argparse.ArgumentParser();p.add_argument('before',type=Path);p.add_argument('after',type=Path);p.add_argument('--output',type=Path,required=True);p.add_argument('--qualified-trainer-patrols',action='store_true');args=p.parse_args()
+read=lambda x:json.loads(x.read_text());before,after=read(args.before),read(args.after)
+qualified={'TaichungBoulevard_Trainer_RunwayJogger','TaichungBoulevard_Trainer_GreenwayWalker','TaichungBoulevard_Trainer_NorthStudent'}
+for a,b in zip(before['maps'],after['maps']):
+ for k in ['number','worldRect','connections','doors','signs','localWalkable']:assert a[k]==b[k],(a['name'],k)
+ for i,old in enumerate(a['people']):
+  new=b['people'][i]
+  if args.qualified_trainer_patrols and old['script'] in qualified:
+   allowed={'movement_type','movement_range_x','movement_range_y'}
+   if old['script'].endswith('GreenwayWalker'):allowed.add('y');assert new['y']==old['y']-1
+   assert {k:v for k,v in old.items() if k not in allowed}=={k:v for k,v in new.items() if k not in allowed}
+  else:assert old==new,('Existing local ID changed',a['number'],i+1)
+ residents=[e for e in b['people'] if e['script'].startswith('TaichungBoulevard_Ambient_')]
+ for e in residents:
+  assert e['trainer_type']=='TRAINER_TYPE_NONE' and e['flag']=='0'
+  assert e['movement_type'] in ['MOVEMENT_TYPE_WALK_LEFT_AND_RIGHT','MOVEMENT_TYPE_WALK_UP_AND_DOWN']
+  assert sorted([e['movement_range_x'],e['movement_range_y']])==[0,1]
+def census(r):
+ actors=[(m,e,m['worldRect'][0]+e['x'],m['worldRect'][1]+e['y']) for m in r['maps'] for e in m['people']]
+ walk=[(m['worldRect'][0]+x,m['worldRect'][1]+y) for m in r['maps'] for y,row in enumerate(m['localWalkable']) for x,v in enumerate(row) if v=='1']
+ view=[sum(abs(x-a)<=7 and -5<=y-b<=4 for _,_,x,y in actors) for a,b in walk]
+ nearby=[sum(abs(x-a)<=8 and abs(y-b)<=8 for _,_,x,y in actors) for a,b in walk]
+ moving=sum(e['movement_type'].startswith('MOVEMENT_TYPE_WALK_') for _,e,_,_ in actors)
+ return dict(total=len(actors),walking=moving,stationary=len(actors)-moving,trainers=sum(e['script'].startswith('TaichungBoulevard_Trainer_') for _,e,_,_ in actors),residents=sum(e['script'].startswith('TaichungBoulevard_Ambient_') for _,e,_,_ in actors),populatedSections=len({m['number'] for m,e,_,_ in actors}),sections=len(r['maps']),perDistrict=dict(Counter(m['district'] for m,e,_,_ in actors)),walkableCells=len(walk),viewportCovered=sum(n>0 for n in view),viewportPercent=100*sum(n>0 for n in view)/len(walk),maximum15x10=max(view),maximum17x17=max(nearby),maximumPerMap=max(Counter(m['number'] for m,e,_,_ in actors).values()))
+a,b=census(before),census(after);assert a['total']==20 and a['walking']==0 and a['trainers']==8
+assert b['total']==75 and b['residents']==55 and b['trainers']==8 and b['populatedSections']==b['sections']==54
+assert b['walking']==(58 if args.qualified_trainer_patrols else 55)
+assert b['maximumPerMap']+1<16 and b['maximum17x17']+1<16
+r=dict(passed=True,coordinateWindow='Actor x-center[-7,7], y-center[-5,4]; uniform walkable cells/spawn tiles, not travel-route probability',before=a,after=b,allOldLocalIdsPreserved=True,terrainCollisionWarpSignAndConnectivityUnchanged=True,trainerPatrols=args.qualified_trainer_patrols)
+args.output.write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r,indent=2))
