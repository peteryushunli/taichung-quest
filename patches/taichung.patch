+ROOT = Path(__file__).resolve().parents[2]
+IDS = ('old-taichung-station','taichung-park','miyahara','natural-science-museum','calligraphy-greenway','shen-ji-new-village','fine-arts-museum','fengjia-night-market','maple-garden','taichung-theater','wenchang-temple','wanhe-temple','botanical-garden','confucius-temple','yizhong-street','prefectural-hall','second-market','cultural-heritage-park','fengle-sculpture-park','wenxin-forest-park')
+SIGN_SUFFIX = ('OldStation','Park','Miyahara','ScienceMuseum','Greenway','ShenJi','FineArts','Fengjia','MapleGarden','Theater','WenchangTemple','WanheTemple','BotanicalGarden','ConfuciusTemple','YizhongStreet','PrefecturalHall','SecondMarket','CulturalHeritagePark','FengleSculpturePark','WenxinForestPark')
+SIGN_ROSTER = {'TaichungCity_Sign_'+suffix:i for i,suffix in enumerate(SIGN_SUFFIX)}
+# Maps bind these public host labels, rather than the private expanded gym labels.
+LEADERS = {'TaichungCity_Host_'+suffix:(gym,11 if gym==8 else gym) for gym,suffix in enumerate(SIGN_SUFFIX[:10])}
+WORKERS = {'TaichungNpc_Aming':0,'TaichungHistory_StaffPark':1,'TaichungHistory_StaffMiyahara':2,'TaichungNpc_Qiaoqiao':3,'TaichungNpc_Ayan':4,'TaichungHistory_StaffShenJi':5,'TaichungHistory_StaffFineArts':6,'TaichungNpc_Mei':7,'TaichungHistory_StaffMapleGarden':8,'TaichungNpc_Boxun':9}
+HOSTS = {'TaichungCity_Host_WenchangTemple':10,'TaichungCity_Host_WanheTemple':11}
+SITES = {8:0,10:1,12:2,13:3,14:4,15:5,16:6,17:7,18:8,19:9}
+LEADER_HISTORY = {gym:11 if gym==8 else gym for gym in range(10)}
+
+
+def labels(texts):
+    result = {}
+    for text in texts:
+        current, order = None, []
+        for line in text.splitlines():
+            line = line.split('@',1)[0].strip()
+            if not line or line.startswith(('.','#')):
+                continue
+            if line.endswith(':'):
+                current=line.rstrip(':');assert current not in result,current
+                result[current]=[];order.append(current)
+            elif current:
+                result[current].append(line)
+        for left,right in zip(order,order[1:]):
+            result[left].append('goto '+right)
+    return result
+
+
+texts=[(ROOT/('data/scripts/taichung_'+name+'.inc')).read_text() for name in ('gyms','park_gym','miyahara_gym','landmark_history','optional_story','optional_story_bindings','city')]
+macro=(ROOT/'data/scripts/taichung_landmark_gym.inc').read_text()
+for file in ('science','greenway','shen_ji','fine_arts','fengjia','maple_garden','theater'):
+    invocation=(ROOT/('data/scripts/taichung_'+file+'_gym.inc')).read_text().strip()
+    name,gym,trainer=re.fullmatch(r'taichung_landmark_gym (\w+), (\w+), (\w+)',invocation).groups()
+    texts.append(macro.replace(r'\name\()',name).replace(r'\name',name).replace(r'\gym',gym).replace(r'\trainer',trainer))
+texts.append((ROOT/'data/taichung_character_npcs.s').read_text())
+encounter=(ROOT/'data/scripts/taichung_encounters.inc').read_text()
+encounter=re.sub(r'(?ms)^\s*\.macro taichung_encounter_entry.*?^\s*\.endm\s*','\n',encounter)
+encounter=re.sub(r'(?m)^\s*taichung_encounter_entry (\w+), (\w+)',lambda m:'TaichungEncounter_'+m[1]+'::\n\tsetvar VAR_0x8004, '+m[2]+'\n\tgoto TaichungEncounter_Interact',encounter)
+texts.append(encounter)
+PROGRAM=labels(texts)
+SYMBOLS={'TRUE':1,'FALSE':0}
+for name in ('taichung_gyms','taichung_landmark_history','taichung_encounters'):
+    for key,value in re.findall(r'^#define\s+(TAICHUNG_\w+)\s+(\d+)\b',(ROOT/('include/constants/'+name+'.h')).read_text(),re.M):
+        SYMBOLS[key]=int(value)
+manifest=json.loads((ROOT/'data/taichung/optional-story/manifest.json').read_text())
+assert {r['historyId']:r['id'] for r in manifest['records']}==dict(enumerate(IDS))
+for row in manifest['records']:
+    history=row['historyId'];expected_gym=8 if history==11 else history if history<10 and history!=8 else None
+    assert row.get('leaderGymId')==expected_gym,(row['id'],'wrong leader cohort')
+    assert row.get('encounterSite')==SITES.get(history),(row['id'],'wrong capture cohort')
+    assert row['signLabel']=='TaichungCity_Sign_'+SIGN_SUFFIX[history]
