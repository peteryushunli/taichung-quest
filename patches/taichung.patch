+#ifndef GUARD_TAICHUNG_ENCOUNTER_BRIDGE_H
+#define GUARD_TAICHUNG_ENCOUNTER_BRIDGE_H
+#include "global.h"
+
+#define TAICHUNG_ENCOUNTER_BRIDGE_MAGIC_A 0x4E454354 // TCEN
+#define TAICHUNG_ENCOUNTER_BRIDGE_MAGIC_B 0x31525443 // CTR1
+#define TAICHUNG_ENCOUNTER_BRIDGE_VERSION 2
+#define TAICHUNG_ENCOUNTER_BRIDGE_SIZE 72
+#define TAICHUNG_ENCOUNTER_SAVE_FLASH_OK 1
+#define TAICHUNG_ENCOUNTER_ACK_DURABLE 1
+#define TAICHUNG_ENCOUNTER_ACK_FAILED 2
+
+// Main/browser writes only ackSequence, ackStatus, ackAttempts, ackUnlocks and
+// ackSaveCounter. Publish ackSequence LAST after the durable storage transaction.
+struct TaichungEncounterBridge
+{
+    /*00*/ u32 magicA;
+    /*04*/ u32 magicB;
+    /*08*/ u16 version;
+    /*0A*/ u16 size;
+    /*0C*/ u32 selfGbaAddress;
+    /*10*/ u32 publication; // Stable nonzero even; odd during native writes.
+    /*14*/ u32 frameCounter;
+    /*18*/ u32 requestSequence;
+    /*1C*/ u32 ackSequence;
+    /*20*/ u32 attempts;
+    /*24*/ u32 unlocks;
+    /*28*/ u16 species;
+    /*2A*/ u8 site;
+    /*2B*/ u8 phase;
+    /*2C*/ u8 balls;
+    /*2D*/ u8 result;
+    /*2E*/ u8 saveStatus;
+    /*2F*/ u8 ackStatus;
+    /*30*/ u32 ackAttempts;
+    /*34*/ u32 ackUnlocks;
+    /*38*/ u32 saveCounter;
+    /*3C*/ u32 trainerId;
+    /*40*/ u32 ackSaveCounter;
+    /*44*/ u32 reserved;
+};
+extern volatile struct TaichungEncounterBridge gTaichungEncounterBridge;
+void TaichungEncounterBridge_Tick(bool8 callbacksRan);
+void TaichungEncounterBridgeSaved(void);
+bool8 TaichungEncounterBridgeAcked(void);
+bool8 TaichungEncounterBridgeFailed(void);
+#endif
