+TaichungStationWelcome_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, TaichungWelcome_OnFrame
+	.byte 0
+
+@ The room is the pending-opening state. Even after an interrupted confirmed
+@ selection, Continue exits this room without granting a second partner.
+TaichungWelcome_OnFrame::
+	map_script_2 TAICHUNG_LANGUAGE, 0, TaichungWelcome_InitLanguage
+	map_script_2 VAR_TEMP_0, 0, TaichungWelcome_Resume
+	.2byte 0
+
+TaichungWelcome_InitLanguage::
+	turnobject LOCALID_PLAYER, DIR_NORTH
+	goto Taichung_InitLanguage
+
+TaichungWelcome_Resume::
+	setvar VAR_TEMP_0, 1
+	turnobject LOCALID_PLAYER, DIR_NORTH
+	goto Taichung_Welcome
+
+TaichungWelcome_Guide::
+	msgbox Taichung_Text_Welcome, MSGBOX_NPC
+	end
