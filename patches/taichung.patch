+
+
+def encode_part(crop, bbox, output, name, target, subject_max, step, bank, palette_path=None):
+    output.mkdir(parents=True,exist_ok=True)
+    working=(target[0]//step,target[1]//step); limit=(subject_max[0]//step,subject_max[1]//step)
+    scale=min(limit[0]/crop.width,limit[1]/crop.height)
+    size=(max(1,round(crop.width*scale)),max(1,round(crop.height*scale)))
+    offset=((working[0]-size[0])//2,working[1]-size[1])
+    fitted=crop.resize(size,Image.Resampling.NEAREST); canvas=Image.new('RGBA',working);canvas.paste(fitted,offset)
+    reference=canvas.resize(target,Image.Resampling.NEAREST) if step!=1 else canvas.copy()
+    reference.save(output/'reference-nearest-rgba.png')
+    pixels=list(canvas.getdata())
+    palette,allowed=(fixed_palette(palette_path),list(range(1,15))) if palette_path else warm_palette(pixels)
+    indices=[];errors=[]
+    for r,g,b,a in pixels:
+        if not a: indices.append(0);continue
+        best=min(allowed,key=lambda i:sum((v-palette[i][c])**2 for c,v in enumerate((r,g,b))))
+        indices.append(best);errors.append(sum((v-palette[best][c])**2 for c,v in enumerate((r,g,b))))
+    indexed=Image.new('P',working);indexed.putpalette([v for c in palette for v in c]+[0]*(768-48));indexed.putdata(indices);indexed.info['transparency']=0
+    if step!=1:indexed=indexed.resize(target,Image.Resampling.NEAREST);indexed.info['transparency']=0
+    indices=list(indexed.getdata()); tw,th=target[0]//8,target[1]//8;graphics=[];lookup={};entries=[]
+    for ty in range(th):
+        for tx in range(tw):
+            p=tuple(indices[(ty*8+y)*target[0]+tx*8+x] for y in range(8) for x in range(8))
+            canonical,flags=min(((p,0),(flip(p,True),0x400),(flip(p,False,True),0x800),(flip(p,True,True),0xc00)),key=lambda v:(v[0],v[1]))
+            if canonical not in lookup:lookup[canonical]=len(graphics);graphics.append(canonical)
+            entries.append(lookup[canonical]|flags|(bank<<12))
+    indexed.save(output/'candidate-indexed.png');native=indexed.convert('RGBA');native.save(output/'candidate-native.png')
+    sheet=Image.new('P',(128,((len(graphics)+15)//16)*8));sheet.putpalette(indexed.getpalette());sheet.info['transparency']=0
+    for n,g in enumerate(graphics):
+        for y in range(8):
+            for x in range(8):sheet.putpixel((n%16*8+x,n//16*8+y),g[y*8+x])
+    sheet.save(output/'tiles.png')
+    raw=bytes(g[i]|g[i+1]<<4 for g in graphics for i in range(0,64,2));(output/'tiles.4bpp').write_bytes(raw)
+    (output/'foreground-tilemap-relative.bin').write_bytes(struct.pack(f'<{len(entries)}H',*entries))
+    metatiles=[[entries[(my*2+y)*tw+mx*2+x] for y in range(2) for x in range(2)] for my in range(target[1]//16) for mx in range(target[0]//16)]
+    (output/'foreground-metatiles-relative.json').write_text(json.dumps(metatiles,indent=2)+'\n')
+    if palette_path:shutil.copyfile(palette_path,output/f'{bank:02}.pal')
+    else:(output/f'{bank:02}.pal').write_bytes(('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,c)) for c in palette)+'\r\n').encode())
+    palraw=struct.pack('<16H',*(r//8|(g//8)<<5|(b//8)<<10 for r,g,b in palette));(output/f'{bank:02}.gbapal').write_bytes(palraw)
+    # Decode the saved bytes, not the original arrays, with all reference flips.
+    raw=(output/'tiles.4bpp').read_bytes();decoded_g=[tuple(v for b in raw[i:i+32] for v in (b&15,b>>4)) for i in range(0,len(raw),32)]
+    rawmap=(output/'foreground-tilemap-relative.bin').read_bytes();decoded_entries=struct.unpack(f'<{len(rawmap)//2}H',rawmap)
+    decoded=[]
+    for y in range(target[1]):
+        for x in range(target[0]):
+            e=decoded_entries[(y//8)*tw+x//8];xx=7-x%8 if e&0x400 else x%8;yy=7-y%8 if e&0x800 else y%8
+            decoded.append(decoded_g[e&1023][yy*8+xx])
+    if decoded!=indices:raise ValueError('Saved4bpp/flip/tilemap roundtrip failed')
+    actual=struct.unpack('<16H',(output/f'{bank:02}.gbapal').read_bytes())
+    if [((v&31)*8,((v>>5)&31)*8,((v>>10)&31)*8) for v in actual]!=palette:raise ValueError('BGR555 roundtrip failed')
+    occupancy=[];counts=[]
+    for my in range(target[1]//16):
+        row='';per=[]
+        for mx in range(target[0]//16):
+            count=sum(indices[(my*16+y)*target[0]+mx*16+x]!=0 for y in range(16) for x in range(16));row+='1' if count else '0';per.append(count)
+        occupancy.append(row);counts.append(per)
+    occupancy_data=dict(schemaVersion=1,logicalSize=list(target),metatileSize=16,opaqueOccupancyRows=occupancy,opaquePixelCounts=counts,
+        collisionNotInstalled=True,roofCellsRequireBlockingIndependentOfStoryFlags=name=='facade')
+    (output/'occupancy.json').write_text(json.dumps(occupancy_data,indent=2)+'\n')
+    errors.sort(); quality=dict(metric='unweighted RGB Euclidean nearest-color error over opaque nearest-resized source samples; no dithering',
+        samples=len(errors),rmsePerChannel=math.sqrt(sum(errors)/(3*len(errors))),meanEuclidean=sum(math.sqrt(v) for v in errors)/len(errors),
+        p95Euclidean=math.sqrt(errors[min(len(errors)-1,int(.95*len(errors)))]),maxEuclidean=math.sqrt(errors[-1]))
+    info=dict(schemaVersion=1,landmarkId='fine-arts-museum',part=name,status='native format candidate only; not installed',
+        sourceComponentBBoxExclusive=list(bbox),recipe=dict(alphaThreshold=128,resampling='nearest',preserveAspectRatio=True,
+        logicalSize=list(target),workingSize=list(working),pixelClusterSize=step,subjectSize=[v*step for v in size],
+        subjectOffset=[v*step for v in offset],southAligned=True,quantization='exact Science14-color nearest RGB, no dithering' if palette_path else 'adaptive14-color MEDIANCUT; native5-bit rounding; nearest RGB, no dithering'),
+        palette=dict(candidateBank=bank,entries=16,opaqueIndicesUsed=sorted(set(indices)-{0}),opaqueColorsUsed=len(set(indices)-{0}),
+            sharedSource=str(palette_path.relative_to(GAME)) if palette_path else None,exactSharedPaletteBytes=bool(palette_path),
+            paletteSha256=digest(output/f'{bank:02}.pal')),
+        native=dict(unique8x8GraphicsFlipDeduplicated=len(graphics),relativeTilemapDimensions=[tw,th],foregroundMetatileCells=len(metatiles),
+            binaryAlpha=True,saved4bppFlipRoundtripPass=True,savedBgr555RoundtripPass=True,graphicsBeforePrimaryReuse=True,
+            raw4bppLogicalGraphicCount=len(graphics),tilesPngPaddedGraphicSlots=((len(graphics)+15)//16)*16,
+            indexedPngSha256=digest(output/'candidate-indexed.png')),
+        quality=quality,occupancyFile='occupancy.json',integration=dict(registeredInRom=False,nativeReady=False,placementAllocated=False,rootOwnsBankAndGeometry=True))
+    info['recipe']['sourceAspectRatio']=crop.width/crop.height
+    info['recipe']['fittedAspectRatio']=size[0]/size[1]
+    info['recipe']['relativeAspectRoundingError']=abs((size[0]/size[1])/(crop.width/crop.height)-1)
+    (output/'encode-manifest.json').write_text(json.dumps(info,indent=2)+'\n')
+    return native,info,graphics
+
+
+def encode(source=SOURCE,output=HERE/'candidate',facade_step=2):
+    original_hash=digest(source);rgba=Image.open(source).convert('RGBA');parts=components(rgba)
+    facade,meta,graphics=encode_part(parts[0][0],parts[0][1],output/'facade','facade',(160,96),(160,96),facade_step,7,SCIENCE_PALETTE)
+    statue,stat_meta,stat_graphics=encode_part(parts[1][0],parts[1][1],output/'sculpture','sculpture',(32,32),(24,24),1,9)
+    # Source portal outer frame was measured on the unmodified image. Find
+    # actual output samples whose nearest source pixels land inside that ROI.
+    bbox=parts[0][1];subject=meta['recipe']['subjectSize'];offset=meta['recipe']['subjectOffset'];door_pixels=[]
+    for y in range(96):
+        for x in range(160):
+            if not facade.getpixel((x,y))[3]:continue
+            wx=(x-offset[0])//facade_step;wy=(y-offset[1])//facade_step;sw=subject[0]//facade_step;sh=subject[1]//facade_step
+            if not(0<=wx<sw and 0<=wy<sh):continue
+            sx=bbox[0]+int((wx+.5)*(bbox[2]-bbox[0])/sw);sy=bbox[1]+int((wy+.5)*(bbox[3]-bbox[1])/sh)
+            if SOURCE_PORTAL[0]<=sx<SOURCE_PORTAL[2] and SOURCE_PORTAL[1]<=sy<SOURCE_PORTAL[3]:door_pixels.append([x,y])
+    door_box=[min(p[0] for p in door_pixels),min(p[1] for p in door_pixels),max(p[0] for p in door_pixels)+1,max(p[1] for p in door_pixels)+1]
+    center=[(door_box[0]+door_box[2])/2,(door_box[1]+door_box[3])/2];tile=[int(center[0]//16),int(center[1]//16)]
+    portal=dict(schemaVersion=1,sourceOuterPortalBBoxExclusive=list(SOURCE_PORTAL),sourceMeasurement='manually inspected portal frame; native pixels follow nearest-resize sampling',
+        paintedPortalPixels=door_pixels,paintedPortalBBoxExclusive=door_box,centerPixels=center,centerFractionOfFacadeWidth=center[0]/160,
+        metatileCellsTouched=sorted({(x//16,y//16) for x,y in door_pixels}),recommendedPaintedPortalLocalMetatile=tile,
+        fixedWorldDoor=[10,62],originSuggestionOnly=[10-tile[0],62-tile[1]],approach=[10,63],arrival=[10,65],
+        nativeWarpNotCreated=True,rootMustFitNativeDoorAnimation=True)
+    (output/'facade/door-pixels.json').write_text(json.dumps(portal,indent=2)+'\n')
+    review=Image.new('RGBA',(208,96));review.paste(facade,(0,0));review.paste(statue,(176,64))
+    ART.mkdir(parents=True,exist_ok=True);review_path=ART/f'fine-arts-native-candidate-{facade_step}px-v1.png'
+    review.resize((832,384),Image.Resampling.NEAREST).save(review_path)
