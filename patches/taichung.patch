+class Packer:
+ def __init__(self,bank,pinned):
+  self.bank=bank;self.tiles={n:bank.tile(n) for n in pinned};self.lookup={};self.allocated=[]
+  for n in sorted(pinned-ANIMATED-SCRATCH):
+   pattern,flags=canonical(self.tiles[n]);self.lookup.setdefault(pattern,(n,flags))
+  self.free=iter(sorted(set(range(1016))-pinned-ANIMATED))
+ def pack(self,t):
+  pattern,flags=canonical(t)
+  if pattern not in self.lookup:
+   try:n=next(self.free)
+   except StopIteration:raise ValueError(f'Tile capacity exceeded after {len(self.allocated)} allocations')
+   self.tiles[n]=pattern;self.lookup[pattern]=(n,0);self.allocated.append(n)
+  n,stored=self.lookup[pattern];return n|(flags^stored)
