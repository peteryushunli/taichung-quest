+def numeric_address(value):
+    address = int(value, 0)
+    if address % 4 or not 0x02000000 <= address <= 0x02040000 - 48:
+        raise argparse.ArgumentTypeError("navigation address must be four-byte aligned and fit 48 bytes in EWRAM")
