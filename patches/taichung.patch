+#!/usr/bin/env python3
+"""Fetch the official road catalog and ground its public archive IDs.
+
+Archives are hosted on Drive. Retrieve those specific public files via the Drive
+connector/manual download, then pass --road-archive/--transport-archive to record
+local bytes/hashes without putting authenticated download links into provenance.
+"""
+import argparse
+import csv
+import datetime as dt
+import hashlib
+import io
+import json
+from pathlib import Path
+import subprocess
+
+CATALOG = 'https://newdatacenter.taichung.gov.tw/api/v1/no-auth/resource.download?rid=e57517f7-f405-4e24-bd03-c4b354dcecfe'
+DATASET = 'https://data.gov.tw/en/datasets/177459'
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--output-dir',type=Path,required=True)
+    p.add_argument('--road-archive',type=Path)
+    p.add_argument('--transport-archive',type=Path)
+    args=p.parse_args();args.output_dir.mkdir(parents=True,exist_ok=True)
+    result=subprocess.run(['curl','--fail-with-body','--silent','--show-error','--connect-timeout','10','--max-time','30',CATALOG],capture_output=True)
+    if result.returncode:raise SystemExit(result.stderr.decode(errors='replace'))
+    raw=result.stdout;(args.output_dir/'taichung-road-catalog-114.csv').write_bytes(raw)
+    reader=csv.DictReader(io.StringIO(raw.decode('utf-8-sig')))
+    reader.fieldnames=[k.lstrip('\ufeff') for k in reader.fieldnames]
+    row=next(reader)
+    metadata=dict(provider='Taichung City Government',datasetUrl=DATASET,catalogUrl=CATALOG,
+        retrievedAtUTC=dt.datetime.now(dt.timezone.utc).isoformat(),datasetTitle=row.get('圖資名稱'),
+        roadArchivePublicUrl=row['道路中心線網址'],transportArchivePublicUrl=row['特殊道路面網址'],
+        codebookPublicUrl=row.get('道路代碼說明網址'),sourceDescription=row.get('資料描述'),
+        sourceCoordinateSystem='Read .prj in the published Shapefile archive before transformation',
+        licenseAsPublished='Open Government Data License, version1.0',attribution='Taichung City Government',
+        catalogSha256=hashlib.sha256(raw).hexdigest(),archives=[])
+    for role,path in [('roads',args.road_archive),('transport',args.transport_archive)]:
+        if path:
+            data=path.read_bytes()
+            if not data.startswith(b"7z\xbc\xaf'\x1c"):raise SystemExit(f'{role}: expected actual7z archive, not an HTML download page')
+            metadata['archives'].append(dict(role=role,name=path.name,bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
+    (args.output_dir/'catalog-download-metadata.json').write_text(json.dumps(metadata,ensure_ascii=False,indent=2)+'\n')
+    print(json.dumps({k:metadata[k] for k in ('datasetTitle','roadArchivePublicUrl','transportArchivePublicUrl')},ensure_ascii=False,indent=2))
+
+
+if __name__=='__main__':main()
