+#!/usr/bin/env python3
+"""Author the native Taichung blockout, without touching legacy maps or gameplay.
+
+Run only in the mapping checkout. This owns the generated Taichung geometry and
+initial placeholder events; do not rerun over subsequent gameplay/localization
+work without reconciling those changes. Existing map/layout/section IDs are kept.
+"""
+import json
+import struct
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ELEVATION = 3
+GRASS, PAVING, TALL_GRASS, SIGN = 0x001, 0x175, 0x00D, 0x003
+
+DISTRICTS = [
+    ("TaichungOldCity", "OLD_CITY", 40, 72, (80, 48), "OLD TAICHUNG", "MUS_VERMILLION"),
+    ("TaichungGreenway", "GREENWAY", 40, 72, (40, 32), "TAICHUNG GREENWAY", "MUS_PALLET"),
+    ("TaichungXitun", "XITUN", 40, 64, (0, 0), "TAICHUNG XITUN", "MUS_CELADON"),
+]
