+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def same_json(before, after):
+    # Preserve scalar types as well as values, including false/0 and 3/3.0.
+    return json.dumps(before, sort_keys=True, separators=(',', ':'), allow_nan=False) == json.dumps(after, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+class Files:
+    def __init__(self, source, revision=None, overrides=None):
+        self.source, self.revision = Path(source), revision
+        self.cache = dict(overrides or {})
+
+    def read(self, path):
+        if path not in self.cache:
+            if self.revision is None:
+                self.cache[path] = (self.source / path).read_bytes()
+            else:
+                result = subprocess.run(['git', 'show', f'{self.revision}:{path}'], cwd=self.source,
+                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                if result.returncode:
+                    raise FileNotFoundError(f'{self.revision}:{path}')
+                self.cache[path] = result.stdout
+        if self.cache[path] is None:
+            raise FileNotFoundError(path)
+        return self.cache[path]
+
+    def has(self, path):
+        try:
+            self.read(path)
+            return True
+        except FileNotFoundError:
+            return False
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
