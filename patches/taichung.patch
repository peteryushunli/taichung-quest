@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Prove V3 frontage continuity, preserved geometry, native encoding and hashes."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+from tempfile import TemporaryDirectory
+
+from color_check import check as check_native_colors
+from color_compile import compile_colorways, native_tile_images
+from library import ROOT, parse_words, render_tools, require
+from neighborhood_frontage import compile_frontage, fill_frontage
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(output, previous):
+    output = Path(output); previous = [Path(p) for p in previous]
+    require(len(previous) >= 2, 'Pass both preserved V1 and V2 directories')
+    before = {str(folder): {str(p.relative_to(folder)): sha(p) for p in folder.rglob('*') if p.is_file()} for folder in previous}
+    require(all(before.values()), 'Preserved fixture directories must contain artifacts')
+    layout_path = ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json'
+    layout = json.loads(layout_path.read_text()); compiled, blocks, units = compile_frontage(output, layout)
+    baseline = compile_colorways()
+    for field in ('graphics', 'metatiles', 'attributes', 'palettes', 'remaps'):
+        require(compiled[field] == baseline[field], f'Attached source variants unexpectedly change native {field}')
+    source_ids = lambda c: {w & 1023 for p in c['library'].prefabs.values() for row in parse_words(p) for w in row}
+    added_source = source_ids(compiled) - source_ids(baseline)
+    require(added_source <= {0x16e}, 'Attached facades introduce unverified source metatiles')
+    original = render_tools().render_metatiles(ROOT, 'General', 'PewterCity')
+    for tile, image in native_tile_images(compiled, added_source).items():
+        require(image.tobytes() == original[tile].tobytes(), 'Clear source apron render differs')
+    proof = check_native_colors()
+    result = fill_frontage(compiled, layout, blocks, units); repeat = fill_frontage(compiled, layout, blocks, units)
+    require(result['words'] == repeat['words'] and result['placements'] == repeat['placements'], 'Frontage composition is nondeterministic')
+    raw = (output / 'filled-map.bin').read_bytes()
+    require(list(struct.unpack('<4096H', raw)) == result['words'], 'Saved V3 words differ from validated words')
+    invariants = result['roads'] | result['approaches'] | result['gymReserves']
+    for folder in previous:
+        older = struct.unpack('<4096H', (folder / 'filled-map.bin').read_bytes())
+        for x, y in invariants:
+            require(result['words'][y * 64 + x] == older[y * 64 + x], f'Road/gym/arrival cell changed vs {folder.name} at {x},{y}')
+        old_report = json.loads((folder / 'validation.json').read_text())
+        require(old_report['sourceLayoutSha256'] == result['report']['sourceLayoutCanonicalJsonSha256'], 'Approved layout changed')
+    # Offset relocation is the native integrator's actual merge route. Verify
+    # every roof's displayed pixels, rather than only the numeric offset.
+    with TemporaryDirectory(prefix='taichung-frontage-offset-') as temp:
+        moved, moved_blocks, moved_units = compile_frontage(temp, layout, variant_metatile_start=900)
+        shifted = fill_frontage(moved, layout, moved_blocks, moved_units)
+        require(min(v for m in moved['remaps'].values() for v in m.values()) == 900, 'Requested metatile offset not honored')
+        original_images = native_tile_images(compiled)
+        moved_images = native_tile_images(moved)
+        for family, mapping in compiled['remaps'].items():
+            for source_id, target in mapping.items():
+                require(original_images[target].tobytes() == moved_images[moved['remaps'][family][source_id]].tobytes(), 'Relocation changes roof rendering')
+        require(all((a & 0xfc00) == (b & 0xfc00) for a, b in zip(result['words'], shifted['words'])), 'Relocation changes collision/elevation')
+    bank = output / 'native-color-bank'; pixels = (bank / 'tiles.4bpp').read_bytes()
+    unpacked = [tuple(v for byte in pixels[i:i + 32] for v in (byte & 15, byte >> 4)) for i in range(0, len(pixels), 32)]
+    require(unpacked == compiled['graphics'], 'Saved native 4bpp roundtrip differs')
+    entries_raw = (bank / 'metatiles.bin').read_bytes(); entries = struct.unpack(f'<{len(entries_raw) // 2}H', entries_raw)
+    require(list(entries) == [v for row in compiled['metatiles'] for v in row], 'Saved native metatile roundtrip differs')
+    attr_raw = (bank / 'metatile_attributes.bin').read_bytes()
+    require(list(struct.unpack(f'<{len(attr_raw) // 4}I', attr_raw)) == compiled['attributes'], 'Saved attributes roundtrip differs')
+    native_palette = struct.unpack('<16H', (bank / '12.gbapal').read_bytes())
+    require([((v & 31) * 8, ((v >> 5) & 31) * 8, ((v >> 10) & 31) * 8) for v in native_palette] == compiled['palettes'][12], 'Saved BGR555 palette differs')
+    for folder in previous:
+        after = {str(p.relative_to(folder)): sha(p) for p in folder.rglob('*') if p.is_file()}
+        require(after == before[str(folder)], f'Preserved artifact files changed: {folder}')
+    report = dict(result='pass', preservedPreviousFixtureHashes=before,
+        invariantCellsComparedPerVersion=len(invariants), previousVersionsCompared=len(previous),
+        fullWidthStreetwallTiles=result['report']['fullWidthStreetwallTiles'], streetwallGapCells=0,
+        unchangedBaseNativeBank=True, introducedGraphicsOrMetatiles=0,
+        independentSourceRenders=proof['baseMetatileRendersCompared'] + len(added_source), independentRoofRemapRenders=proof['roofRemapRendersCompared'],
+        graphics4bppRoundtripped=len(unpacked), metatileU16EntriesRoundtripped=len(entries), attributeU32EntriesRoundtripped=len(compiled['attributes']),
+        bgr555PaletteColorsRoundtripped=16, offset900RoofRendersCompared=32,
+        savedMapSha256=sha(output / 'filled-map.bin'), geometryAndReachability=result['report'])
+    (output / 'frontage-checks.json').write_text(json.dumps(report, indent=2) + '\n')
+    sources = [
+        'tools/taichung/streetscape/neighborhood_frontage.py', 'tools/taichung/streetscape/neighborhood_frontage_check.py',
+        'tools/taichung/streetscape/neighborhood_density.py', 'tools/taichung/streetscape/neighborhood_fill.py',
+        'tools/taichung/streetscape/neighborhood_pilot.py', 'tools/taichung/streetscape/color_compile.py',
+        'tools/taichung/streetscape/color_check.py', 'tools/taichung/streetscape/library.py',
+        'tools/taichung/geography/profile_pilot.py', 'tools/taichung/render_maps.py',
+        'data/taichung/prefabs/catalog.json', 'data/taichung/prefabs/colorways.json',
+        'data/taichung/neighborhoods/pilot-r2c2-layout.json',
+        'graphics/object_events/pics/people/red_normal.png', 'graphics/object_events/palettes/player.pal',
+    ]
+    for folder in ('primary/general', 'secondary/pewter_city'):
+        path = ROOT / 'data/tilesets' / folder
+        sources.extend(str((path / name).relative_to(ROOT)) for name in ('tiles.png', 'metatiles.bin', 'metatile_attributes.bin'))
+        sources.extend(str(p.relative_to(ROOT)) for p in sorted((path / 'palettes').glob('*.pal')))
+    provenance = dict(schemaVersion=1, status='V3 unregistered source-native review fixture',
+        geometry='24 approved lots retained; seven new infill strips are explicit authored game additions, not actual footprints',
+        art='Recombined General/Pewter FireRed source tiles. No bespoke Taiwan raster art. Four native roof color ramps share palette12.',
+        frontageConvention='South-facing native facade convention; roofs do not imply real building heights or parcel orientations.',
+        roadApronContract='Ten infill apron cells reserve existing road edge cells without painting/changing them. All building solids remain off roads.',
+        nativeRegistration=False, sourceFilesSha256={name: sha(ROOT / name) for name in sources},
+        emittedFilesSha256={str(p.relative_to(output)): sha(p) for p in sorted(output.rglob('*')) if p.is_file() and p.name != 'provenance.json'})
+    (output / 'provenance.json').write_text(json.dumps(provenance, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in report.items() if k not in ('preservedPreviousFixtureHashes', 'geometryAndReachability')}, indent=2))
+    return report
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--previous', type=Path, action='append', required=True)
+    args = parser.parse_args(); check(args.output, args.previous)
