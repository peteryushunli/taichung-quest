+class Sheet:
+    """A secondary tile sheet: indexed pixels, slot by slot."""
+
+    def __init__(self, png=None, slots=0):
+        if png is not None:
+            image = Image.open(png)
+            self.palette = image.getpalette()
+            pixels = np.array(image, dtype=np.uint8)
+            self.tiles = [pixels[n // 16 * 8:n // 16 * 8 + 8, n % 16 * 8:n % 16 * 8 + 8].copy()
+                          for n in range((image.width // 8) * (image.height // 8))]
+        else:
+            self.palette, self.tiles = None, [np.zeros((8, 8), np.uint8) for _ in range(slots)]
+
+    def put(self, slot, pixels):
+        while len(self.tiles) <= slot:
+            self.tiles.append(np.zeros((8, 8), np.uint8))
+        self.tiles[slot] = pixels
+
+    def png(self):
+        count = -(-len(self.tiles) // 16) * 16
+        out = np.zeros((count // 16 * 8, 128), np.uint8)
+        for n, t in enumerate(self.tiles):
+            out[n // 16 * 8:n // 16 * 8 + 8, n % 16 * 8:n % 16 * 8 + 8] = t
+        image = Image.fromarray(out, "P")
+        image.putpalette(self.palette)
+        buffer = io.BytesIO()
+        image.save(buffer, "PNG")
+        return buffer.getvalue()
+
+
+def flips(stored, wanted):
+    for flag, view in ((0, stored), (0x400, stored[:, ::-1]), (0x800, stored[::-1]), (0xC00, stored[::-1, ::-1])):
+        if np.array_equal(view, wanted):
+            return flag
+    return None
+
+
+class Install:
+    """Puts landmark pieces into one primary + secondary pair: new tiles into free secondary
+    slots, new definitions into free IDs. `index` knows every tile the map can already draw."""
+
+    def __init__(self, bank, sheet, defs, attrs, free_slots, free_ids, primary_pixels):
+        self.bank, self.sheet, self.defs, self.attrs = bank, sheet, defs, attrs
+        self.free_slots, self.free_ids = list(free_slots), list(free_ids)
+        self.index = {}
+        for n in range(NUM_PRIMARY):
+            self.know(n, primary_pixels[n // 16 * 8:n // 16 * 8 + 8, n % 16 * 8:n % 16 * 8 + 8])
+        self.by_def = {}
+        self.added_tiles, self.added_defs = [], []
+
+    def know(self, number, pixels):
+        self.index.setdefault(landmark_tiles.canonical(pixels), (number, pixels))
+
+    def tile_word(self, item):
+        """A top-layer word for (indices, palette), placing the tile if the map lacks it."""
+        if item is None:
+            return 0
+        pixels, palette = item
+        key = landmark_tiles.canonical(pixels)
+        if key not in self.index:
+            slot = self.free_slots.pop(0)
+            self.sheet.put(slot, pixels.copy())
+            self.know(NUM_PRIMARY + slot, pixels.copy())
+            self.added_tiles.append(slot)
+        number, stored = self.index[key]
+        return number | flips(stored, pixels) | palette << 12
+
+    def definition(self, words, attr):
+        key = (tuple(words), attr)
+        if key not in self.by_def:
+            m = self.free_ids.pop(0)
+            while len(self.defs) <= m - NUM_PRIMARY:
+                self.defs.append([0] * 8)
+                self.attrs.append(0)
+            self.defs[m - NUM_PRIMARY], self.attrs[m - NUM_PRIMARY] = list(words), attr
+            self.by_def[key] = m
+            self.added_defs.append(m)
+        return self.by_def[key]
+
+    def piece(self, piece):
+        """Cell (dx, dy) -> metatile ID for one built landmark piece."""
+        bank, art, out = piece.bank, np.array(piece.art), {}
+        for y in range(piece.h):
+            for x in range(piece.w):
+                cell = piece.cells[y][x]
+                if cell[0] == "meta":
+                    out[(x, y)] = cell[1]
+                    continue
+                bottom = bank.layers(cell[-1])[0]
+                if cell[0] == "relayer":
+                    top = bank.layers(cell[1])[1]
+                    if cell[2]:
+                        top = [top[i] ^ 0x400 for i in (1, 0, 3, 2)]
+                    words = bottom + top
+                    attr = self.source_attr(cell[1])
+                else:
+                    top = []
+                    for q in range(4):
+                        block = art[y * 16 + q // 2 * 8:y * 16 + q // 2 * 8 + 8, x * 16 + q % 2 * 8:x * 16 + q % 2 * 8 + 8]
+                        tile = piece.quantise(block, piece.prefer)
+                        assert tile is not None, (x, y, q)
+                        top.append(self.tile_word(tile if tile[0].any() else None))
+                    words, attr = bottom + top, COVERED
+                for w in words:
+                    n = w & 0x3FF
+                    assert n < NUM_PRIMARY or n - NUM_PRIMARY < len(self.sheet.tiles), hex(w)
+                out[(x, y)] = self.definition(words, attr)
+        return out
+
+    def source_attr(self, metatile):
+        return self.attrs[metatile - NUM_PRIMARY] if metatile >= NUM_PRIMARY else self.primary_attrs[metatile]
+
+
+def secondary_tiles(defs, ids):
+    """Secondary tile slots the given definitions draw."""
+    out = set()
+    for m in ids:
+        if m >= NUM_PRIMARY and m - NUM_PRIMARY < len(defs):
+            out |= {(w & 0x3FF) - NUM_PRIMARY for w in defs[m - NUM_PRIMARY] if w & 0x3FF >= NUM_PRIMARY}
+    return out
+
