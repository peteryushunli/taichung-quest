+import sys
+from lib2 import *
+import art_station as A
+import art_market as M
+import art_miya as Y
+import art_park as P
+import art_nmfa as N
+import art_theater as T
+ROOMS={}
+def room(fn): ROOMS[fn.__name__]=fn; return fn
+B=BUILDING
+def C(sec,word): return (B,'gTileset_'+sec if not sec.startswith('gTileset_') else sec,word)
+RC=None
+def img_of(c): return metatile(c[0],c[1],c[2]&0x3FF,RC)
+def slices(img,name,solid_=True):
+    """cut an RGBA/RGB image into 16x16 custom cells: returns rows of cells"""
+    rows=[]
+    for ty in range(img.height//16):
+        row=[]
+        for tx in range(img.width//16):
+            t=img.crop((tx*16,ty*16,tx*16+16,ty*16+16)).convert('RGB')
+            row.append(custom(f'{name}_{tx}_{ty}',t,solid_))
+        rows.append(row)
+    return rows
+def over(base_img,sprite,ox=0,oy=0):
+    im=base_img.convert('RGBA').copy(); im.alpha_composite(sprite,(ox,oy)); return im
+
+@room
+def station():
+    r2=cells('ROUTE2_ENTRANCE'); r16=cells('ROUTE16_NORTH_ENTRANCE_1F')
+    GB2='gTileset_GenericBuilding2'
+    W,H=19,15
+    rc={GB2:{7:{(148,172,139):(176,168,156),(180,197,164):(208,200,188),(213,222,197):(232,226,214),(238,255,213):(248,246,238),(115,156,180):(152,64,48)},
+             12:{(189,164,82):(150,146,138),(222,197,106):(182,178,168),(230,222,156):(208,204,194)}}}
+    global RC; RC=rc
+    V=(B,GB2,0x008|0xC00)
+    floor=(B,GB2,0x281); shade=(B,GB2,0x282)
+    g=new(W,H,floor)
+    # --- outdoors: ballast, track, platform
+    bal=A.ballast(); trk=A.track(); con=A.concrete(); edge=A.platform_edge()
+    for x in range(W):
+        g[0][x]=custom('ballast',bal,True); g[1][x]=custom('track',trk,True)
+        g[2][x]=custom('pedge',edge); g[3][x]=custom('concrete',con); g[4][x]=custom('concrete',con)
+    # parked train, 6 tiles, over ballast/track
+    tr=A.train(6); bg=Image.new('RGBA',(96,32))
+    for i in range(6): bg.paste(bal,(i*16,0)); bg.paste(trk,(i*16,16))
+    bg.alpha_composite(tr,(0,0))
+    paste(g,slices(bg,'train'),2,0)
+    # canopy columns
+    for x in (1,6,17):
+        p=A.pillar(con,con); paste(g,slices(p,f'pillar{x}'),x,3)
+    # platform benches
+    for x in (3,14):
+        b=A.bench2(con); paste(g,slices(b,f'pbench{x}'),x,4)
+    # station name board
+    sg=A.sign((edge,con),(edge,con)); paste(g,slices(sg,'sign'),10,2)
+    # clock hung on the canopy column at x=12
+    pc=A.pillar(con,con); pc.paste(A.clock(pc.crop((0,0,16,16)).convert('RGB')),(0,0)); paste(g,slices(pc,'pillarclk'),12,3)
+    # fence line between platform and concourse, fare gates with lanes at 7, 9, 11
+    for x in range(W):
+        end='r' if x==5 else 'l' if x==13 else None
+        g[5][x]=custom(f'fence{end}',A.fence(con,end).convert('RGB'),True)
+    for x in (6,8,10,12): g[5][x]=custom('gatep',A.gate(con).convert('RGB'),True)
+    for x in (7,9,11): g[5][x]=custom('concrete',con)
+    # concourse spans the full width; carpet from the door to the middle gate
+    for y in range(6,H-2):
+        g[y][8]=(B,GB2,0x2c3); g[y][9]=(B,GB2,0x2cb); g[y][10]=(B,GB2,0x2c4)
+    # ticket office: route-16 counter with clerk space behind
+    paste(g,crop(r16,1,14,7,3),1,8)
+    for y in (8,10): g[y][1]=(B,GB2,0x281|(g[y][1][2]&0xC00))   # no wall shadow: the hall is open on this side
+    g[8][3]=custom('tsign',A.ticket_sign(img_of(g[8][3])).convert('RGB'),True)
+    # departure board on legs on the east side
+    paste(g,slices(A.board_stand(img_of(floor)),'bstand'),14,7)
+    # long waiting benches either side of the aisle
+    for y in (10,12):
+        for x in (3,5,12,14):
+            b=A.bench2(img_of(floor)); paste(g,slices(b,f'hb{x}{y}'),x,y)
+    # stone columns with fruit capitals flank the aisle
+    for x in (7,11): paste(g,slices(A.column(img_of(g[11][x]),img_of(g[12][x])),f'col{x}'),x,11)
+    g[H-1]=[V]*W
+    g[H-2][8:11]=[(B,GB2,0x2c5),(B,GB2,0x2c6),(B,GB2,0x2c7)]
+    g[H-1][8:11]=[(B,GB2,0x2cd|0xC00),(B,GB2,0x2ce|0xC00),(B,GB2,0x2cf|0xC00)]
+    meta=dict(leader=(9,3),staff=(2,8),exit=(9,13))
+    return g,rc,meta
+
+@room
