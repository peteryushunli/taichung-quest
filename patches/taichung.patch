+        infillInstalled=infill,infillChangedCells=infill_count)
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+    return manifest
+
+
+def install():
+    p=ROOT/'data/layouts/TaichungOldCity/map.bin';p.write_bytes((DATA/'map.bin').read_bytes())
