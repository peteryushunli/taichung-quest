+import json, struct, sys
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+S=Path(__file__).parent
+sys.path.insert(0,str(S))
+import rm
+SRC=Path(__file__).resolve().parents[3]  # the native root
+LAY={l['id']:l for l in json.load(open(SRC/'data/layouts/layouts.json'))['layouts'] if 'id' in l}
+_tiles={}
+def tiles(sec, pri='gTileset_Building'):
+    k=(pri,sec)
+    if k not in _tiles: _tiles[k]=rm.render_metatiles(SRC,pri,sec)
+    return _tiles[k]
+def L(name): return LAY[name if name.startswith('LAYOUT_') else 'LAYOUT_'+name]
+def grid(name):
+    l=L(name); w=rm.words(SRC/l['blockdata_filepath']); W=l['width']
+    return [list(w[y*W:(y+1)*W]) for y in range(l['height'])]
+def sec(name): return L(name)['secondary_tileset']
+F8=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial.ttf',9)
+def render(g, secondary, scale=1, coords=False, solid=False):
+    t=tiles(secondary); H=len(g); W=len(g[0])
+    im=Image.new('RGB',(W*16,H*16))
+    for y,row in enumerate(g):
+        for x,v in enumerate(row): im.paste(t[v&0x3FF],(x*16,y*16))
+    if scale!=1: im=im.resize((im.width*scale,im.height*scale),Image.NEAREST)
+    if coords or solid:
+        d=ImageDraw.Draw(im,'RGBA'); s=16*scale
+        for y,row in enumerate(g):
+            for x,v in enumerate(row):
+                if solid and (v>>10)&3: d.rectangle([x*s+s//2-2,y*s+s//2-2,x*s+s//2+2,y*s+s//2+2],fill=(255,0,0,180))
+        if coords:
+            for x in range(W): d.text((x*s+2,0),str(x),fill=(255,255,0),font=F8,stroke_width=1,stroke_fill='black')
+            for y in range(H): d.text((0,y*s+2),str(y),fill=(255,255,0),font=F8,stroke_width=1,stroke_fill='black')
+    return im
+def shot(name, out, scale=2):
+    render(grid(name), sec(name), scale, coords=True, solid=True).save(out)
+def crop(g,x,y,w,h): return [row[x:x+w] for row in g[y:y+h]]
+def paste(g,block,x,y,skip=None):
+    for j,row in enumerate(block):
+        for i,v in enumerate(row):
+            if skip is not None and (v&0x3FF) in skip: continue
+            g[y+j][x+i]=v
+def new(w,h,v): return [[v]*w for _ in range(h)]
+def fill(g,x,y,w,h,v):
+    for j in range(y,y+h):
+        for i in range(x,x+w): g[j][i]=v
+def hexdump(g):
+    return '\n'.join(' '.join(f'{v&0x3FF:03x}{"*" if (v>>10)&3 else " "}' for v in row) for row in g)
diff --git a/tools/taichung/gym_interiors/lib2.py b/tools/taichung/gym_interiors/lib2.py
new file mode 100644
index 0000000..779b808
--- /dev/null
+++ b/tools/taichung/gym_interiors/lib2.py
@@ -0,0 +1,137 @@
+"""Multi-source room composer. A cell is (primary, secondary, word): any FireRed or
+Taichung tileset pair, so one room can mix pieces. Rooms can recolour a source's
+palette slots. budget() estimates what a private secondary tileset would need."""
+import json, struct, sys, hashlib
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+S=Path(__file__).parent; sys.path.insert(0,str(S))
+import rm
+SRC=Path(__file__).resolve().parents[3]  # the native root
+LAY={l['id']:l for l in json.load(open(SRC/'data/layouts/layouts.json'))['layouts'] if 'id' in l}
+BUILDING='gTileset_Building'
+def L(name): return LAY[name if name.startswith('LAYOUT_') else 'LAYOUT_'+name]
+def pair(name): l=L(name); return (l['primary_tileset'],l['secondary_tileset'])
+def cells(name):
+    l=L(name); p=pair(name); w=rm.words(SRC/l['blockdata_filepath']); W=l['width']
+    return [[(p[0],p[1],w[y*W+x]) for x in range(W)] for y in range(l['height'])]
+_pal={}; _src={}; _mt={}
+def palettes(pri,sec):
+    k=(pri,sec)
+    if k not in _pal:
+        sets=[rm.tileset_paths(SRC,n) for n in (pri,sec)]
+        pals=[]
+        for p in range(16):
+            folder=sets[0 if p<7 else 1]['palettes']
+            lines=(folder/f'{p:02}.pal').read_text().splitlines()[3:]
+            pals.append([tuple(map(int,ln.split())) for ln in lines if ln.strip()])
+        _pal[k]=pals
+        _src[k]=[Image.open(s['tiles']) for s in sets]
+        _mt[k]=[rm.words(s['metatiles']) for s in sets]
+    return _pal[k]
+def mwords(pri,sec,mid):
+    palettes(pri,sec); d=_mt[(pri,sec)]
+    si,pos=(0,mid) if mid<640 else (1,mid-640)
+    return d[si][pos*8:pos*8+8] if (pos+1)*8<=len(d[si]) else None
+_img={}
+CUSTOM={}  # name -> 16x16 RGB(A) image; cells ('custom', name, collisionbits)
+def custom(name,img,solid_=False):
+    CUSTOM[name]=img; return ('custom',name,0xC00 if solid_ else 0)
+def metatile(pri,sec,mid,recolour=None):
+    if pri=='custom':
+        im=CUSTOM[sec]
+        return im.convert('RGB') if im.mode!='RGBA' else im
+    """recolour: {(pri,sec): {slot: {old_rgb: new_rgb} or [16 rgb]}}"""
+    rc=(recolour or {}).get((pri,sec)) or (recolour or {}).get(sec) or {}
+    key=(pri,sec,mid,repr(sorted((k,repr(v)) for k,v in rc.items())))
+    if key in _img: return _img[key]
+    pals=[list(p) for p in palettes(pri,sec)]
+    for slot,m in rc.items():
+        if isinstance(m,list): pals[slot]=m
+        else: pals[slot]=[m.get(c,c) for c in pals[slot]]
+    words=mwords(pri,sec,mid); im=Image.new('RGB',(16,16))
+    if words:
+        srcs=_src[(pri,sec)]
+        for layer in range(2):
+            for q in range(4):
+                v=words[layer*4+q]; t=v&0x3FF; ts=srcs[0 if t<640 else 1]; t=t if t<640 else t-640
+                sx,sy=(t%16)*8,(t//16)*8
+                if sx+8>ts.width or sy+8>ts.height: continue
+                pal=pals[v>>12]
+                for y in range(8):
+                    for x in range(8):
+                        tx=7-x if v&0x400 else x; ty=7-y if v&0x800 else y
+                        i=ts.getpixel((sx+tx,sy+ty))
+                        if i or layer==0: im.putpixel((q%2*8+x,q//2*8+y),pal[i])
+    _img[key]=im; return im
+F8=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial.ttf',9)
+def render(g,recolour=None,scale=1,coords=False,solid=False):
+    H=len(g); W=len(g[0]); im=Image.new('RGB',(W*16,H*16))
+    for y,row in enumerate(g):
+        for x,c in enumerate(row):
+            if c is None: continue
+            t=metatile(c[0],c[1],c[2]&0x3FF,recolour)
+            if t.mode=='RGBA': im.paste(t,(x*16,y*16),t)
+            else: im.paste(t,(x*16,y*16))
+    if scale!=1: im=im.resize((im.width*scale,im.height*scale),Image.NEAREST)
+    if coords or solid:
+        d=ImageDraw.Draw(im,'RGBA'); s=16*scale
+        for y,row in enumerate(g):
+            for x,c in enumerate(row):
+                if solid and c and (c[2]>>10)&3: d.rectangle([x*s+s//2-2,y*s+s//2-2,x*s+s//2+2,y*s+s//2+2],fill=(255,0,0,180))
+        if coords:
+            for x in range(W): d.text((x*s+2,0),str(x),fill=(255,255,0),font=F8,stroke_width=1,stroke_fill='black')
+            for y in range(H): d.text((0,y*s+2),str(y),fill=(255,255,0),font=F8,stroke_width=1,stroke_fill='black')
+    return im
+def shot(name,out,scale=2): render(cells(name),scale=scale,coords=True,solid=True).save(out)
+def crop(g,x,y,w,h): return [row[x:x+w] for row in g[y:y+h]]
+def paste(g,block,x,y,skip=None):
+    for j,row in enumerate(block):
+        for i,c in enumerate(row):
+            if c is None or (skip and skip(c)): continue
+            if 0<=y+j<len(g) and 0<=x+i<len(g[0]): g[y+j][x+i]=c
+def new(w,h,c): return [[c]*w for _ in range(h)]
+def fill(g,x,y,w,h,c):
+    for j in range(y,y+h):
+        for i in range(x,x+w): g[j][i]=c
+def solid(c): return (c[0],c[1],c[2]|0xC00)
+def walk(c): return (c[0],c[1],c[2]&~0xC00)
+def budget(g,recolour=None,base=BUILDING):
+    """Tiles, palettes and metatiles a private secondary would need on top of gTileset_Building."""
+    rcs=set()
+    for k,v in (recolour or {}).items():
+        for slot in v: rcs.add((k,slot))
+    tiles=set(); pals=set(); metas=set(); cols=set(); seen=set()
+    for row in g:
+        for c in row:
+            if c is None: continue
+            pri,sec,w=c; mid=w&0x3FF
+            if pri=='custom':
+                if ('custom',sec) not in seen:
+                    seen.add(('custom',sec)); im=CUSTOM[sec].convert('RGB'); metas.add(('custom',im.tobytes()))
+                    for qy in (0,8):
+                        for qx in (0,8):
+                            t=im.crop((qx,qy,qx+8,qy+8)); cols.update(t.getdata())
+                            forms=[t.tobytes(),t.transpose(Image.FLIP_LEFT_RIGHT).tobytes(),t.transpose(Image.FLIP_TOP_BOTTOM).tobytes(),t.rotate(180).tobytes()]
+                            tiles.add(('custom',min(forms)))
+                continue
+            words=mwords(pri,sec,mid) or []
+            free=pri==base and mid<640
+            for v in words:
+                t=v&0x3FF; p=v>>12
+                src=(pri if t<640 else sec)
+                recol=((pri,sec),p) in rcs or (sec,p) in rcs
+                if src==base and p<7 and not recol: continue
+                free=False; tiles.add((src,t)); pals.add(((pri,sec) if (p>=7 or recol or src!=base) else base,p))
+            if not free: metas.add((pri,sec,mid))
+    npal=len(pals)+(-(-len(cols)//15) if cols else 0)
+    return dict(tiles=len(tiles),tile_limit=384,palettes=npal,customColours=len(cols),palette_limit=6,metatiles=len(metas),metatile_limit=384)
+def atlas(pri,sec,start=640,count=None,cols=16,scale=2,out=None):
+    palettes(pri,sec); n=len(_mt[(pri,sec)][1 if start>=640 else 0])//8
+    count=count or n
+    rows=(count+cols-1)//cols; s=16*scale
+    im=Image.new('RGB',(cols*s,rows*(s+10)),(40,40,40)); d=ImageDraw.Draw(im)
+    for i in range(count):
+        mid=start+i; t=metatile(pri,sec,mid).resize((s,s),Image.NEAREST)
+        x,y=(i%cols)*s,(i//cols)*(s+10); im.paste(t,(x,y+10)); d.text((x+1,y),f'{mid:x}',fill=(255,255,0),font=F8)
+    if out: im.save(out)
+    return im
