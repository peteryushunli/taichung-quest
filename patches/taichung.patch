diff --git a/src/taichung_gym_progress.c b/src/taichung_gym_progress.c
new file mode 100644
index 0000000..bde44e1
--- /dev/null
+++ b/src/taichung_gym_progress.c
@@ -0,0 +1,128 @@
+#include "global.h"
+#include "event_data.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include "constants/vars.h"
+
+struct TaichungGymChallenge
+{
+    u16 gymId;
+    u16 trainerId;
+    bool8 started;
+    u8 lastResult;
+};
+
+static EWRAM_DATA struct TaichungGymChallenge sChallenge = {TAICHUNG_GYM_NONE, TRAINER_NONE, FALSE, TAICHUNG_GYM_RESULT_NONE};
+
+// Save bit order is permanent. It is independent of vanilla badge order.
+static const char *const sLandmarkIds[TAICHUNG_GYM_COUNT] = {
+    "old-taichung-station", "taichung-park", "miyahara",
+    "natural-science-museum", "calligraphy-greenway", "shen-ji-new-village",
+    "fine-arts-museum", "fengjia-night-market", "maple-garden", "taichung-theater"
+};
+
+static void ClearPendingChallenge(void)
+{
+    sChallenge.gymId = TAICHUNG_GYM_NONE;
+    sChallenge.trainerId = TRAINER_NONE;
+    sChallenge.started = FALSE;
+}
+
+u16 TaichungGymGetCompletedMask(void)
+{
+    // Viewing progress must not replay an older quest-log variable into save.
+    return gSaveBlock1Ptr ? gSaveBlock1Ptr->vars[TAICHUNG_GYM_COMPLETION_VAR - VARS_START] & TAICHUNG_GYM_ALL_MASK : 0;
+}
+
+u8 TaichungGymGetCompletedCount(void)
+{
+    u16 mask = TaichungGymGetCompletedMask();
+    u8 count = 0;
+    while (mask)
+    {
+        count += mask & 1;
+        mask >>= 1;
+    }
+    return count;
+}
+
+bool8 TaichungGymIsComplete(u16 gymId)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT)
+        return FALSE;
+    return (TaichungGymGetCompletedMask() & (1 << gymId)) != 0;
+}
+
+const char *TaichungGymGetLandmarkId(u16 gymId)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT)
+        return NULL;
+    return sLandmarkIds[gymId];
+}
+
+bool8 TaichungGymPrepareChallenge(u16 gymId, u16 trainerId)
+{
+    ClearPendingChallenge();
+    if (gymId >= TAICHUNG_GYM_COUNT || trainerId == TRAINER_NONE || trainerId >= NUM_TRAINERS)
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_INVALID;
+        return FALSE;
+    }
+    if (TaichungGymIsComplete(gymId))
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_ALREADY_COMPLETE;
+        return FALSE;
+    }
+    sChallenge.gymId = gymId;
+    sChallenge.trainerId = trainerId;
+    sChallenge.lastResult = TAICHUNG_GYM_RESULT_NONE;
+    return TRUE;
+}
+
+void TaichungGymCancelChallenge(void)
+{
+    ClearPendingChallenge();
+    sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+}
+
+void TaichungGymOnTrainerBattleStart(u16 trainerId)
+{
+    if (sChallenge.gymId < TAICHUNG_GYM_COUNT && sChallenge.trainerId == trainerId)
+    {
+        sChallenge.started = TRUE;
+    }
+    else
+    {
+        ClearPendingChallenge();
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+    }
+}
+
+void TaichungGymOnTrainerBattleEnd(u16 trainerId, u8 outcome)
+{
+    if (!sChallenge.started || sChallenge.gymId >= TAICHUNG_GYM_COUNT || sChallenge.trainerId != trainerId)
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+    }
+    else if (outcome != B_OUTCOME_WON)
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_LOST;
+    }
+    else if (TaichungGymIsComplete(sChallenge.gymId))
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_ALREADY_COMPLETE;
+    }
+    else
+    {
+        // This is the only writer. It runs after the actual trainer battle ends.
+        VarSet(TAICHUNG_GYM_COMPLETION_VAR, TaichungGymGetCompletedMask() | (1 << sChallenge.gymId));
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_WON;
+    }
+    ClearPendingChallenge();
+}
+
+u8 TaichungGymGetLastResult(void)
+{
+    return sChallenge.lastResult;
+}
