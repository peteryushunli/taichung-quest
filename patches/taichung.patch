+MAP_PATHS = tuple(f'data/maps/{name}/map.json' for name, *_ in ROOMS)
+# The files this increment owns. A guard that peels other layers (the city rework) passes
+# nested_check only its overrides of these; everything else is read from the actual tree.
+OWNED = frozenset(MAP_PATHS + (MANIFEST, SAVE, HEADER, CHARACTERS, IDS))
