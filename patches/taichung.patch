+#!/usr/bin/env python3
+"""Compile approved Greenway art against frozen released city interfaces.
+
+Only this feature checkout is written. The installed primary is immutable;
+static graphics are deduplicated against it before allocating secondary slots.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+from check_old_core import Files, Bank, resolved_folder
+from analyze_theater_cohort import visible_cells
+
+ROOT = Path(__file__).resolve().parents[3]
+BASE = '16625bd'
+DATA = ROOT/'data/taichung/landmarks/greenway-native'
+OUT = ROOT/'data/tilesets/secondary/taichung_greenway'
+PRIMARY = 'data/tilesets/primary/taichung_old_core'
+CORE = 'data/tilesets/secondary/taichung_old_core'
+MID = 'MAP_TAICHUNG_GREENWAY'
+MAP = ROOT/'data/layouts/TaichungGreenway/map.bin'
+ANIMATED = set(range(416,482)) | set(range(508,512))
+SPECS = [dict(id='science-museum', input='science-museum/candidate-compact/candidate-indexed.png',
+              origin=[19,15], door=[24,20], palette=7, retired=[19,14,29,20]),
+         dict(id='shen-ji', input='shen-ji/candidate/nativecourtyard-layout-v2-indexed.png',
+              origin=[7,39], door=[10,44], palette=9, retired=[8,41,13,44]),
+         dict(id='fine-arts', input='fine-arts/candidate/facade/candidate-indexed.png',
+              origin=[5,57], door=[10,62], palette=7, retired=[5,56,15,62]),
+         dict(id='fine-arts-sculpture', input='fine-arts/candidate/sculpture-shared/candidate-indexed.png',
+              origin=[14,64], door=None, palette=9, role='prop', parent='fine-arts')]
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(pixels):
+    return min((tuple(pixels[(7-y if f&0x800 else y)*8+(7-x if f&0x400 else x)] for y in range(8) for x in range(8)),f)
+               for f in (0,0x400,0x800,0xc00))
+
+
+def words(path, values=None, kind='H'):
+    import struct
+    if values is None:
+        raw=path.read_bytes();return list(struct.unpack(f'<{len(raw)//struct.calcsize(kind)}{kind}',raw))
+    path.write_bytes(struct.pack(f'<{len(values)}{kind}',*values))
+
+
+def compile_scene():
+    revision = subprocess.check_output(['git','rev-parse',BASE],cwd=ROOT,text=True).strip()
+    subprocess.run(['git','merge-base','--is-ancestor',revision,'HEAD'],cwd=ROOT,check=True)
+    before = Files(ROOT,revision)
+    layouts = {v['id']:v for v in before.json('data/layouts/layouts.json')['layouts'] if 'id' in v}
+    scenes={}
+    for name in ('TaichungOldCity','TaichungGreenway','TaichungXitun'):
+        data=before.json(f'data/maps/{name}/map.json');layout=layouts[data['layout']]
+        scenes[data['id']]=dict(data=data,layout=layout,grid=before.words(layout['blockdata_filepath']))
+    own=scenes[MID];width,height=own['layout']['width'],own['layout']['height']
+    original=own['grid'];ground=original.copy()
+    allowed_maps={digest(before.read(own['layout']['blockdata_filepath']))}
+    if (DATA/'manifest.json').exists():
+        allowed_maps.add(json.loads((DATA/'manifest.json').read_text())['mapSha256'])
+    assert digest(MAP.read_bytes()) in allowed_maps, 'Registered Greenway has unrelated changes; review a fresh baseline'
+    for spec in SPECS:
+        if not spec.get('retired'):continue
+        x0,y0,x1,y1=spec['retired']
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):ground[y*width+x]=0x3175
+    needed={v&1023 for v in ground+before.words(own['layout']['border_filepath'])}
+    donated=set()
+    for mid,scene in scenes.items():
+        for c in scene['data']['connections']:
+            target=scenes[c['map']]
+            cells=list(visible_cells(scene['layout'],target['layout'],c['direction'],c['offset']))
+            if mid==MID:
+                needed.update(target['grid'][y*target['layout']['width']+x]&1023 for x,y in cells)
+            if c['map']==MID:
+                donated.update(cells)
+    baseline=Bank(before,PRIMARY,CORE)
+    # These used definitions are already repacked entirely into resident primary
+    # graphics, including Old City's borrowed roof-color definitions.
+    used={n for n in needed if n>=640}
+    assert all((v&1023)<640 for n in needed for v in baseline.entries(n)), 'New baseline needs a secondary-graphics remap'
+    count=max(used)-640+1
+    defs=[[0]*8 for _ in range(count)];attrs=[0]*count
+    for n in used:defs[n-640]=baseline.entries(n);attrs[n-640]=baseline.attr(n)
+    free=iter(n for n in range(719,1024) if n not in needed)
+    primary=baseline.images[0]
+    def graphic(image,n):
+        return tuple(image.getpixel((n%16*8+x,n//16*8+y)) for y in range(8) for x in range(8))
+    lookup={}
+    for n in range(640):
+        if n not in ANIMATED:
+            p,f=canonical(graphic(primary,n));lookup.setdefault(p,(n,f))
+    secondary=[]
+    def pack(pixels):
+        p,f=canonical(pixels)
+        if p not in lookup:
+            assert len(secondary)<376, 'Greenway secondary graphic capacity exceeded'
+            lookup[p]=(640+len(secondary),0);secondary.append(p)
+        n,stored=lookup[p]
+        return n|(f^stored)
+    grid=ground.copy();landmarks=[];palettes={};palette_used={}
+    paving=baseline.entries(0x175)
+    assert paving[4:]==[0]*4
+    for spec in SPECS:
+        path=ROOT/'data/taichung/landmarks'/spec['input'];art=Image.open(path)
+        assert art.mode=='P' and art.info.get('transparency')==0 and art.getextrema()[1]<=15
+        assert art.width%16==art.height%16==0
+        palette=art.getpalette()[:48]
+        used_indices=set(art.get_flattened_data())-{0};pn=spec['palette']
+        if pn not in palettes:palettes[pn]=palette.copy();palette_used[pn]=set()
+        for index in used_indices:
+            if index in palette_used[pn]:assert palettes[pn][index*3:index*3+3]==palette[index*3:index*3+3], f'Conflicting used palette index {pn}:{index}'
+            palettes[pn][index*3:index*3+3]=palette[index*3:index*3+3]
+        palette_used[pn].update(used_indices)
+        w,h=art.width//16,art.height//16;ox,oy=spec['origin'];mapping={};occupied=[]
+        for y in range(h):
+            for x in range(w):
+                if not any(art.getpixel((x*16+dx,y*16+dy)) for dy in range(16) for dx in range(16)):continue
+                gx,gy=ox+x,oy+y
+                assert 0<=gx<width and 0<=gy<height and (gx,gy) not in donated, f'Art overlaps a donated seam cell: {gx},{gy}'
+                ground_id=ground[gy*width+gx]&1023
+                assert ground_id in (0x001,0x175), f'Art needs explicit ground review at {gx},{gy}'
+                lower=baseline.entries(ground_id)
+                assert lower[4:]==[0]*4, 'Ground already has foreground; explicit composition required'
+                n=next(free)
+                while len(defs)<=n-640:defs.append([0]*8);attrs.append(0)
+                entries=[]
+                for dy in range(2):
+                    for dx in range(2):
+                        p=tuple(art.getpixel((x*16+dx*8+px,y*16+dy*8+py)) for py in range(8) for px in range(8))
+                        entries.append(pack(p)|spec['palette']<<12)
+                defs[n-640]=lower[:4]+entries;attrs[n-640]=0x20000000 if y==h-1 else 0
+                grid[gy*width+gx]=n|0x400;mapping[f'{x},{y}']=n;occupied.append([gx,gy])
+        if spec.get('door'):
+            x,y=spec['door'];assert original[y*width+x]==0x043d;grid[y*width+x]=0x043d
+        landmarks.append(dict(id=spec['id'],input=str(path.relative_to(ROOT)),inputSha256=digest(path.read_bytes()),
+                              origin=spec['origin'],size=[w,h],door=spec.get('door'),palette=spec['palette'],
+                              role=spec.get('role','landmark'),parent=spec.get('parent'),occupiedCells=occupied,localMetatileIds=mapping))
+    assert len(defs)<=384
+    DATA.mkdir(parents=True,exist_ok=True);OUT.mkdir(parents=True,exist_ok=True)
+    loaded=max(16,(len(secondary)+15)//16*16)
+    sheet=Image.new('P',(128,loaded//16*8));sheet.putpalette(primary.getpalette())
+    for n,p in enumerate(secondary):
+        for y in range(8):
+            for x in range(8):sheet.putpixel((n%16*8+x,n//16*8+y),p[y*8+x])
+    sheet.save(OUT/'tiles.png');words(OUT/'metatiles.bin',[e for group in defs for e in group]);words(OUT/'metatile_attributes.bin',attrs,'I')
+    (OUT/'palettes').mkdir(exist_ok=True)
+    for n in range(16):
+        raw=before.read(f'{CORE}/palettes/{n:02}.pal').replace(b'\r\n',b'\n').replace(b'\n',b'\r\n')
+        if n in palettes:raw=('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,palettes[n][i:i+3])) for i in range(0,48,3))+'\r\n').encode()
+        (OUT/f'palettes/{n:02}.pal').write_bytes(raw)
+    (DATA/'baseline-map.bin').write_bytes(before.read(own['layout']['blockdata_filepath']));words(DATA/'map.bin',grid)
+    manifest=dict(schemaVersion=1,baselineCommit=revision,primary='gTileset_TaichungOldCorePrimary',secondary='gTileset_TaichungGreenway',
+                  primaryFolder=PRIMARY,secondaryFolder=str(OUT.relative_to(ROOT)),mapFile=str((DATA/'map.bin').relative_to(ROOT)),
+                  baselineMapFile=str((DATA/'baseline-map.bin').relative_to(ROOT)),requiredSourceMetatiles=sorted(used),landmarks=landmarks,
+                  retiredFootprints=[s['retired'] for s in SPECS if s.get('retired')],sourceMapSha256=digest(before.read(own['layout']['blockdata_filepath'])),
+                  mapSha256=digest((DATA/'map.bin').read_bytes()),secondaryGraphics=len(secondary),loadedSecondaryGraphics=loaded,
+                  secondaryMetatiles=len(defs),doorScratch=[1016,1024],borrowedDonorCellsPreserved=len(donated),
+                  changedMapWords=sum(a!=b for a,b in zip(grid,original)),registeredInSource=False,runtimeVerifiedByCompiler=False)
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+    return manifest
+
+
+def install(manifest):
+    # Derive the small registration snippets from the same layout as the Theater
+    # installer without changing that already released tool or any primary bank.
+    folder=str(OUT.relative_to(ROOT));label='TaichungGreenway'
+    snippets={
+        'graphics.h':f'const u32 gTilesetTiles_{label}[] = INCBIN_U32("{folder}/tiles.4bpp.lz");\n\nconst u16 gTilesetPalettes_{label}[][16] =\n{{\n'+''.join(f'    INCBIN_U16("{folder}/palettes/{n:02}.gbapal"),\n' for n in range(16))+'};\n',
+        'metatiles.h':f'const u16 gMetatiles_{label}[] = INCBIN_U16("{folder}/metatiles.bin");\nconst u32 gMetatileAttributes_{label}[] = INCBIN_U32("{folder}/metatile_attributes.bin");\n',
+        'headers.h':f'const struct Tileset gTileset_{label} =\n{{\n    .isCompressed = TRUE,\n    .isSecondary = TRUE,\n    .tiles = gTilesetTiles_{label},\n    .palettes = gTilesetPalettes_{label},\n    .metatiles = gMetatiles_{label},\n    .metatileAttributes = gMetatileAttributes_{label},\n    .callback = NULL,\n}};\n'}
+    for name,snippet in snippets.items():
+        p=ROOT/'src/data/tilesets'/name;text=p.read_text()
+        if snippet not in text:
+            assert f'_{label}[' not in text and f'_{label} =' not in text
+            p.write_text(text.rstrip()+'\n\n'+snippet)
+    p=ROOT/'data/layouts/layouts.json';layouts=json.loads(p.read_text());layout=next(v for v in layouts['layouts'] if v.get('id')=='LAYOUT_TAICHUNG_GREENWAY')
+    assert layout['primary_tileset']==manifest['primary']
+    assert layout['secondary_tileset'] in ('gTileset_TaichungOldCore',manifest['secondary'])
+    layout['secondary_tileset']=manifest['secondary'];p.write_text(json.dumps(layouts,indent=2)+'\n')
+    MAP.write_bytes((DATA/'map.bin').read_bytes());manifest['registeredInSource']=True
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--install',action='store_true');args=parser.parse_args()
+    result=compile_scene()
+    if args.install:install(result)
+    print(json.dumps({k:result[k] for k in ('baselineCommit','secondaryGraphics','loadedSecondaryGraphics','secondaryMetatiles','changedMapWords','registeredInSource')},indent=2))
