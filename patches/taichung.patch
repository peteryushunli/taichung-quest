diff --git a/tests/taichung_exploration_test.c b/tests/taichung_exploration_test.c
new file mode 100644
index 0000000..fd44393
--- /dev/null
+++ b/tests/taichung_exploration_test.c
@@ -0,0 +1,92 @@
+#include "global.h"
+#include "taichung_exploration.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sPreferenceWrites;
+static unsigned sProgressWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Preference reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_EXPLORATION_WILD_VAR || id == TAICHUNG_EXPLORATION_SIGHT_VAR || id == TAICHUNG_GYM_COMPLETION_VAR);
+    if (id == TAICHUNG_GYM_COMPLETION_VAR) ++sProgressWrites;
+    else ++sPreferenceWrites;
+    sVariables[id-0x4000] = value;
+    return TRUE;
+}
+
+int main(void)
+{
+    u16 wild, sight, range;
+    u32 rate;
+    unsigned before;
+    const u32 rates[] = {0,1,3,4,7,16,80,1600,0xFFFFFFFF};
+    unsigned i;
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(sPreferenceWrites == 0); // Old saves default without replay or mutation.
+    assert(!TaichungExplorationSetMode(2,1));
+    assert(!TaichungExplorationSetMode(0,0));
+    assert(!TaichungExplorationSetMode(1,4));
+    assert(sPreferenceWrites == 0);
+    sVariables[0xF8] = 65535;
+    sVariables[0xF9] = 8;
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_NORMAL);
+
+    for (wild = 1; wild <= 3; ++wild)
+    {
+        for (sight = 1; sight <= 3; ++sight)
+        {
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_WILD,wild));
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_SIGHT,sight));
+            before = sPreferenceWrites;
+            assert(TaichungExplorationGetMode(0) == wild && TaichungExplorationGetMode(1) == sight);
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            // Script disabling and re-enabling encounters cannot erase saved Off.
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(TaichungExplorationAllowsTrainerSight() == (sight != TAICHUNG_EXPLORATION_OFF));
+            for (i = 0; i < sizeof(rates)/sizeof(rates[0]); ++i)
+            {
+                rate = rates[i];
+                if (wild == TAICHUNG_EXPLORATION_OFF) rate = 0;
+                else if (wild == TAICHUNG_EXPLORATION_LOW && rate > 0) rate = rate/4 ? rate/4 : 1;
+                assert(TaichungExplorationAdjustAutomaticWildRate(rates[i]) == rate);
+            }
+            for (range = 0; range <= 255; ++range)
+            {
+                u8 expected = sight == TAICHUNG_EXPLORATION_OFF ? 0 : sight == TAICHUNG_EXPLORATION_LOW && range > 1 ? 1 : range;
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected);
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected); // Deterministic, no frame reroll.
+            }
+            assert(sPreferenceWrites == before && sProgressWrites == 0);
+        }
+    }
+
+    // Changing preferences during a real tracked battle never cancels its win.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_OLD_STATION,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungExplorationSetMode(0,TAICHUNG_EXPLORATION_OFF);
+    TaichungExplorationSetMode(1,TAICHUNG_EXPLORATION_OFF);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 1 && sProgressWrites == 1);
+    // Voluntary gym preparation still works with both automatic settings Off.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 2 && sProgressWrites == 2);
+    TaichungGymCancelChallenge();
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_OFF);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_OFF);
+    puts("PASS: nine independent encounter/sight combinations; old-save defaults; quarter-rate/minimum; all sight ranges; temporary reset cannot override Off; voluntary and active gym wins remain valid.");
+    return 0;
+}
diff --git a/tests/taichung_gym_progress_test.c b/tests/taichung_gym_progress_test.c
new file mode 100644
index 0000000..f359f73
--- /dev/null
+++ b/tests/taichung_gym_progress_test.c
@@ -0,0 +1,84 @@
+#include "global.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Progress reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value) { assert(id == TAICHUNG_GYM_COMPLETION_VAR); sVariables[id-0x4000]=value; ++sWrites; return TRUE; }
+static void reset(void) { memset(sVariables,0,sizeof(sVariables)); sWrites=0; TaichungGymOnTrainerBattleStart(TRAINER_NONE); }
+
+int main(void)
+{
+    u16 gym;
+    u8 outcome;
+    const char *expected[] = {"old-taichung-station","taichung-park","miyahara","natural-science-museum","calligraphy-greenway","shen-ji-new-village","fine-arts-museum","fengjia-night-market","maple-garden","taichung-theater"};
+    reset();
+    assert(TaichungGymGetCompletedCount()==0);
+    assert(!TaichungGymIsComplete(10) && !TaichungGymIsComplete(65535));
+    assert(TaichungGymGetLandmarkId(10)==NULL);
+    assert(!TaichungGymPrepareChallenge(10,TRAINER_TAICHUNG_STATION_JUN));
+    assert(!TaichungGymPrepareChallenge(0,TRAINER_NONE));
+    assert(!TaichungGymPrepareChallenge(0,NUM_TRAINERS));
+    assert(sWrites==0);
+
+    // A prepared script or a stale old win alone is not a completed challenge.
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0 && TaichungGymGetCompletedMask()==0);
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0);
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN,B_OUTCOME_WON);
+    assert(sWrites==0);
+
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymCancelChallenge();
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0);
+
+    // Every non-win outcome must preserve completion state and allow a retry.
+    for (outcome=0; outcome<16; ++outcome)
+    {
+        if (outcome==B_OUTCOME_WON) continue;
+        assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,outcome);
+        assert(TaichungGymGetCompletedMask()==0 && sWrites==0);
+    }
+
+    // All ten bits are distinct, in the accepted permanent landmark order.
+    for (gym=0; gym<TAICHUNG_GYM_COUNT; ++gym)
+    {
+        assert(strcmp(TaichungGymGetLandmarkId(gym),expected[gym])==0);
+        assert(TaichungGymPrepareChallenge(gym,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        assert(sWrites==gym);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+        assert(TaichungGymIsComplete(gym));
+        assert(TaichungGymGetCompletedCount()==gym+1);
+        assert(TaichungGymGetLastResult()==TAICHUNG_GYM_RESULT_WON);
+        assert(!TaichungGymPrepareChallenge(gym,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+        assert(sWrites==gym+1);
+    }
+    assert(TaichungGymGetCompletedMask()==0x03FF && sWrites==10);
+    // Volatile battle state can clear while saved mask remains intact.
+    TaichungGymOnTrainerBattleStart(TRAINER_NONE);
+    assert(TaichungGymGetCompletedCount()==10);
+    sVariables[0xFA]=0xFC00; // Reserved high bits must not inflate the ten-state count.
+    assert(TaichungGymGetCompletedCount()==0);
+    puts("PASS: ten independent saved states; real-start/matching-trainer/win guards; loss/retry/duplicate/ID boundaries; stable IDs; no writes outside VAR_0x40FA.");
+    return 0;
+}
diff --git a/tests/taichung_save_test.c b/tests/taichung_save_test.c
new file mode 100644
index 0000000..bc9e09c
--- /dev/null
+++ b/tests/taichung_save_test.c
@@ -0,0 +1,83 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_save.h"
+#include "constants/maps.h"
+#include "constants/species.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWarpRequests;
+bool8 VarSet(u16 id, u16 value) { assert(id >= VARS_START && id < VARS_START + 256); sSave.vars[id - VARS_START] = value; return TRUE; }
+void SetContinueGameWarpStatus(void) { sWarpRequests++; }
+#define V(id) sSave.vars[(id) - VARS_START]
+
+static void Reset(void)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.preservedPartyAndBag, 0xA5, sizeof(sSave.preservedPartyAndBag));
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    sSave.location.mapNum = MAP_NUM(MAP_ROUTE1);
+    sSave.location.x = 12;
+    sSave.location.y = 9;
+    sSave.playerPartyCount = 1;
+    V(0x40F8) = 1;
+    V(0x40F9) = 2;
+    V(0x40FA) = 0x155;
+    sWarpRequests = 0;
+}
+
+static void AssertProtected(void)
+{
+    unsigned i;
+    assert(sSave.playerPartyCount == 1);
+    assert(V(0x40F8) == 1 && V(0x40F9) == 2 && V(0x40FA) == 0x155);
+    for (i = 0; i < sizeof(sSave.preservedPartyAndBag); i++) assert(sSave.preservedPartyAndBag[i] == 0xA5);
+}
+
+int main(void)
+{
+    static const u16 starters[] = {SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU};
+    unsigned i, map;
+    Reset();
+    TaichungSaveUpgradeOnContinue();
+    assert(V(0x40F7) == 0 && sWarpRequests == 0); // Untouched vanilla save.
+    for (i = 0; i < sizeof(starters) / sizeof(starters[0]); i++)
+    {
+        Reset();
+        V(0x40FC) = starters[i]; V(0x40FD) = 2; V(0x40FB) = i % 2 ? 2 : 0;
+        TaichungSaveUpgradeOnContinue();
+        assert(V(0x40F7) == 1 && sWarpRequests == 1 && V(0x40FC) == starters[i] && V(0x40FD) == 2);
+        assert(V(0x40FB) == (i % 2 ? 2 : 1));
+        assert(sSave.continueGameWarp.mapGroup == 43 && sSave.continueGameWarp.mapNum == 0);
+        assert(sSave.continueGameWarp.x == 30 && sSave.continueGameWarp.y == 66 && sSave.continueGameWarp.warpId == -1);
+        assert(TaichungSaveUsesStationCheckpoint());
+        AssertProtected();
+        TaichungSaveUpgradeOnContinue();
+        assert(sWarpRequests == 1); // A later Continue does not move the player again.
+    }
+    for (map = 0; map <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM); map++)
+    {
+        struct WarpData location;
+        Reset(); V(0x40FC) = SPECIES_PIKACHU; V(0x40FB) = 2;
+        sSave.location.mapGroup = 43; sSave.location.mapNum = map;
+        location = sSave.location;
+        TaichungSaveUpgradeOnContinue();
+        assert(sWarpRequests == 0 && memcmp(&location, &sSave.location, sizeof(location)) == 0);
+        assert(V(0x40F7) == 1 && V(0x40FB) == 2);
+        AssertProtected();
+    }
+    Reset(); V(0x40FD) = 3;
+    TaichungSaveUpgradeOnContinue();
+    assert(V(0x40FC) == SPECIES_BULBASAUR && V(0x40FD) == 3 && sWarpRequests == 1);
+    Reset(); V(0x40FC) = SPECIES_PIKACHU; sSave.playerPartyCount = 0;
+    TaichungSaveUpgradeOnContinue(); assert(V(0x40F7) == 0 && sWarpRequests == 0);
+    Reset(); V(0x40FC) = SPECIES_PIKACHU; V(0x40F7) = 2;
+    TaichungSaveUpgradeOnContinue(); assert(V(0x40F7) == 2 && sWarpRequests == 0);
+    Reset(); TaichungSaveInitNewGame();
+    assert(V(0x40F7) == 1 && V(0x40FB) == 0 && V(0x40FC) == 0 && sWarpRequests == 0);
+    assert(TaichungSaveUsesStationCheckpoint());
+    puts("PASS: four prototype starters, legacy Bulbasaur, 13 city locations, one-time relocation, party/bag/progress preservation, native startup and vanilla/future saves.");
+    return 0;
+}
diff --git a/tests/test_taichung_language_bridge.c b/tests/test_taichung_language_bridge.c
new file mode 100644
index 0000000..e9da37f
--- /dev/null
+++ b/tests/test_taichung_language_bridge.c
@@ -0,0 +1,155 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "taichung_language_bridge.h"
+
+#define PACKET_ADDRESS 0x0203F000
+
+static volatile struct TaichungLanguageBridge sPacket;
+static struct
+{
+    u32 partyChecksum;
+    u16 language;
+    u16 starter;
+    u16 quest;
+    u16 cityPass;
+    u16 positionX;
+    u16 positionY;
+} sSave;
+static u32 sWrites;
+static bool8 sWriterSucceeds;
+
+static bool8 WriteLanguage(u8 language)
+{
+    // Ack must still describe the previous request while VarSet is in flight.
+    assert(sPacket.ackSequence != sPacket.requestSequence);
+    if (!sWriterSucceeds)
+        return 0;
+    sSave.language = language;
+    sWrites++;
+    return 1;
+}
+
+static void Tick(bool8 ready, bool8 safe)
+{
+    TaichungLanguageBridge_UpdatePacket(&sPacket, PACKET_ADDRESS,
+                                       sSave.language, ready, safe, WriteLanguage);
+}
+
+static void Request(u32 sequence, u8 language)
+{
+    sPacket.requestedLanguage = language;
+    sPacket.requestSequence = sequence;
+}
+
+static void Reset(void)
+{
+    memset((void *)&sPacket, 0, sizeof(sPacket));
+    sSave.partyChecksum = 0x12345678;
+    sSave.language = 0;
+    sSave.starter = 4;
+    sSave.quest = 2;
+    sSave.cityPass = 0x155;
+    sSave.positionX = 10;
+    sSave.positionY = 14;
+    sWrites = 0;
+    sWriterSucceeds = 1;
+    Tick(0, 0);
+}
+
+int main(void)
+{
+    u32 frame;
+    unsigned i;
+    const unsigned char *bytes;
+
+    Reset();
+    assert(sizeof(sPacket) == 32);
+    bytes = (const unsigned char *)&sPacket;
+    assert(memcmp(bytes, "TCLANG01", 8) == 0);
+    assert(sPacket.version == 1 && sPacket.size == 32);
+    assert(sPacket.selfGbaAddress == PACKET_ADDRESS && sPacket.frameCounter == 1);
+    assert(sPacket.activeLanguage == 0 && sPacket.flags == 0);
+
+    // A website preference can never answer the initial native choice.
+    Request(1, 2);
+    Tick(0, 0);
+    assert(sPacket.ackSequence == 1 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_UNSET);
+    assert(sSave.language == 0 && sWrites == 0);
+    Request(2, 1);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 2 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_UNSET);
+    assert(sSave.language == 0 && sWrites == 0);
+
+    // Native selection publishes immediately, then a busy field queues web input.
+    sSave.language = 1;
+    TaichungLanguageBridge_PublishNativeChoice(&sPacket, 1);
+    Tick(1, 0);
+    Request(3, 2);
+    frame = sPacket.frameCounter;
+    for (i = 0; i < 60; i++)
+        Tick(1, 0);
+    assert(sPacket.frameCounter == frame + 60);
+    assert(sPacket.flags == TAICHUNG_LANGUAGE_BRIDGE_READY);
+    assert(sPacket.ackSequence == 2 && sPacket.requestedLanguage == 2 && sWrites == 0);
+    Tick(1, 1);
+    assert(sPacket.flags == (TAICHUNG_LANGUAGE_BRIDGE_READY | TAICHUNG_LANGUAGE_BRIDGE_SAFE_FIELD));
+    assert(sPacket.ackSequence == 3 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_APPLIED);
+    assert(sPacket.activeLanguage == 2 && sPacket.requestedLanguage == 0);
+    assert(sSave.language == 2 && sWrites == 1);
+    Tick(1, 1);
+    assert(sWrites == 1); // Acknowledged sequences never apply twice.
+
+    // A native re-selection of the SAME current language wins an older queue.
+    Request(4, 1);
+    Tick(1, 0);
+    TaichungLanguageBridge_PublishNativeChoice(&sPacket, 2);
+    assert(sPacket.ackSequence == 4 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+    Tick(1, 1);
+    assert(sSave.language == 2 && sWrites == 1);
+
+    // A direct native var change is also detected without the menu notification.
+    Request(5, 2);
+    sSave.language = 1;
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 5 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+    assert(sPacket.activeLanguage == 1 && sWrites == 1);
+
+    Request(6, 9);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 6 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_INVALID);
+    assert(sSave.language == 1 && sWrites == 1);
+
+    // A failed native write must not be acknowledged as a successful change.
+    Request(7, 2);
+    sWriterSucceeds = 0;
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 6 && sPacket.requestedLanguage == 2 && sSave.language == 1);
+    sWriterSucceeds = 1;
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 7 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_APPLIED);
+    assert(sSave.language == 2 && sWrites == 2);
+
+    Request(8, 0);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 8 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_INVALID);
+    Request(0, 1);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 8 && sSave.language == 2 && sWrites == 2);
+    sPacket.frameCounter = 0xFFFFFFFF;
+    Tick(1, 1);
+    assert(sPacket.frameCounter == 1);
+
+    // Language writes preserve unrelated progression and player data.
+    assert(sSave.partyChecksum == 0x12345678 && sSave.starter == 4 && sSave.quest == 2);
+    assert(sSave.cityPass == 0x155 && sSave.positionX == 10 && sSave.positionY == 14);
+
+    // A stale/invalid packet cannot retain an old browser request after reinit.
+    sPacket.selfGbaAddress = 0x02000000;
+    Request(9, 1);
+    Tick(1, 1);
+    assert(sPacket.selfGbaAddress == PACKET_ADDRESS && sPacket.frameCounter == 1);
+    assert(sPacket.requestSequence == 0 && sPacket.ackSequence == 0 && sWrites == 2);
+    puts("Language bridge protocol: startup, queue/apply, native override, validation, ack ordering and state preservation passed.");
+    return 0;
+}
