diff --git a/tests/test_chinese_glyph_font.py b/tests/test_chinese_glyph_font.py
new file mode 100644
index 0000000..fbc630e
--- /dev/null
+++ b/tests/test_chinese_glyph_font.py
@@ -0,0 +1,104 @@
+"""Host checks for bitmap-source integrity and the persistent FC19 codebook."""
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+GAME = Path(__file__).resolve().parents[1]
+TOOLS = GAME / 'tools/taichung_gameplay'
+SPEC = importlib.util.spec_from_file_location('native_glyph_append', TOOLS / 'extend-chinese-glyphs.py')
+APPEND = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(APPEND)
+
+
+class BitmapGlyphTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.font = APPEND.load_font(GAME)
+        cls.charmap = (GAME / 'charmap.txt').read_bytes()
+        cls.header = (GAME / 'src/data/taichung_glyphs.h').read_bytes()
+        cls.existing = APPEND.parse_existing(cls.charmap, cls.header)
+
+    def fixture(self, path):
+        shutil.copytree(GAME / 'assets/fonts/fusion-pixel-12', path / 'assets/fonts/fusion-pixel-12')
+        shutil.copyfile(GAME / 'assets/fonts/taichung-native-font.json', path / 'assets/fonts/taichung-native-font.json')
+        (path / 'src/data').mkdir(parents=True)
+        (path / 'charmap.txt').write_bytes(self.charmap)
+        (path / 'src/data/taichung_glyphs.h').write_bytes(self.header)
+        (path / 'src/start_menu.c').write_text('/* retained menu fixture */\n')
+        (path / 'src/taichung_language.c').write_text('/* retained translation fixture */\n')
+        return path
+
+    def run_helper(self, name, game, artifacts, *extra):
+        result = subprocess.run([sys.executable, str(TOOLS / name), '--game', str(game),
+                                 '--artifacts', str(artifacts), *extra], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return result
+
+    def test_every_existing_glyph_matches_pinned_bitmap_without_clipping(self):
+        self.assertEqual(self.font.metadata['provider'], 'bdf-gzip')
+        for row in self.existing['rows']:
+            self.assertEqual(row['masks'], self.font.render(row['character']))
+            self.assertEqual(len(row['masks']), 14)
+            self.assertTrue(all(0 <= mask <= 0xfff for mask in row['masks']))
+
+    def test_append_keeps_every_old_mapping_and_row_and_uses_same_source(self):
+        with tempfile.TemporaryDirectory() as folder:
+            game = self.fixture(Path(folder) / 'game')
+            char = next(c for c in '字像鯨貓蝶嶺' if c not in self.existing['mappings'] and ord(c) in self.font.glyphs)
+            (game / 'src/taichung_test.c').write_text('static const u8 sExample[] = _("' + char + '");\n')
+            self.run_helper('extend-chinese-glyphs.py', game, Path(folder) / 'report', '--write')
+            cmap = (game / 'charmap.txt').read_bytes()
+            current = APPEND.parse_existing(cmap, (game / 'src/data/taichung_glyphs.h').read_bytes())
+            self.assertTrue(cmap.startswith(self.charmap))
+            self.assertEqual(current['rows'][:-1], self.existing['rows'])
+            self.assertEqual(current['rows'][-1]['character'], char)
+            self.assertEqual(current['rows'][-1]['index'], len(self.existing['rows']))
+            self.assertEqual(current['rows'][-1]['masks'], self.font.render(char))
+
+    def test_refresh_is_idempotent_and_does_not_rewrite_content_or_codes(self):
+        with tempfile.TemporaryDirectory() as folder:
+            game = self.fixture(Path(folder) / 'game')
+            protected = {p: (game / p).read_bytes() for p in ['src/start_menu.c', 'src/taichung_language.c', 'charmap.txt']}
+            self.run_helper('refresh-chinese-glyphs.py', game, Path(folder) / 'one', '--write')
+            self.assertEqual((game / 'src/data/taichung_glyphs.h').read_bytes(), self.header)
+            for path, raw in protected.items():
+                self.assertEqual((game / path).read_bytes(), raw)
+            self.run_helper('refresh-chinese-glyphs.py', game, Path(folder) / 'two', '--write')
+            report = json.loads((Path(folder) / 'two/refresh-chinese-glyphs.json').read_text())
+            self.assertEqual(report['changedExistingShapes'], 0)
+            self.assertEqual(report['addedGlyphCount'], 0)
+            self.assertEqual(report['before'], report['candidate'])
+
+    def test_wrong_source_checksum_is_rejected(self):
+        with tempfile.TemporaryDirectory() as folder:
+            game = self.fixture(Path(folder) / 'game')
+            source = game / json.loads((game / 'assets/fonts/taichung-native-font.json').read_text())['source']
+            raw = bytearray(source.read_bytes())
+            raw[-1] ^= 1
+            source.write_bytes(raw)
+            with self.assertRaisesRegex(ValueError, 'checksum mismatch'):
+                APPEND.load_font(game)
+
+    def test_legacy_noto_cannot_silently_mix_with_bitmap_source(self):
+        with self.assertRaisesRegex(ValueError, 'authoritative'):
+            APPEND.load_font(GAME, Path('/unused/NotoSansTC.ttf'))
+
+    def test_missing_character_fails_without_notdef_or_fallback(self):
+        with self.assertRaisesRegex(ValueError, 'no fallback'):
+            self.font.render(chr(0x10ffff))
+
+    def test_bitmap_that_would_clip_is_rejected(self):
+        font = APPEND.load_font(GAME)
+        font.glyphs[ord('字')] = 'DWIDTH 12 0\nBBX 13 1 0 0\nBITMAP\nFFF8\nENDCHAR\n'
+        with self.assertRaisesRegex(ValueError, 'would clip'):
+            font.render('字')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_taichung_language_bridge.c b/tests/test_taichung_language_bridge.c
new file mode 100644
index 0000000..e9da37f
--- /dev/null
+++ b/tests/test_taichung_language_bridge.c
@@ -0,0 +1,155 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "taichung_language_bridge.h"
+
+#define PACKET_ADDRESS 0x0203F000
+
+static volatile struct TaichungLanguageBridge sPacket;
+static struct
+{
+    u32 partyChecksum;
+    u16 language;
+    u16 starter;
+    u16 quest;
+    u16 cityPass;
+    u16 positionX;
+    u16 positionY;
+} sSave;
+static u32 sWrites;
+static bool8 sWriterSucceeds;
+
+static bool8 WriteLanguage(u8 language)
+{
+    // Ack must still describe the previous request while VarSet is in flight.
+    assert(sPacket.ackSequence != sPacket.requestSequence);
+    if (!sWriterSucceeds)
+        return 0;
+    sSave.language = language;
+    sWrites++;
+    return 1;
+}
+
+static void Tick(bool8 ready, bool8 safe)
+{
+    TaichungLanguageBridge_UpdatePacket(&sPacket, PACKET_ADDRESS,
+                                       sSave.language, ready, safe, WriteLanguage);
+}
+
+static void Request(u32 sequence, u8 language)
+{
+    sPacket.requestedLanguage = language;
+    sPacket.requestSequence = sequence;
+}
+
+static void Reset(void)
+{
+    memset((void *)&sPacket, 0, sizeof(sPacket));
+    sSave.partyChecksum = 0x12345678;
+    sSave.language = 0;
+    sSave.starter = 4;
+    sSave.quest = 2;
+    sSave.cityPass = 0x155;
+    sSave.positionX = 10;
+    sSave.positionY = 14;
+    sWrites = 0;
+    sWriterSucceeds = 1;
+    Tick(0, 0);
+}
+
+int main(void)
+{
+    u32 frame;
+    unsigned i;
+    const unsigned char *bytes;
+
+    Reset();
+    assert(sizeof(sPacket) == 32);
+    bytes = (const unsigned char *)&sPacket;
+    assert(memcmp(bytes, "TCLANG01", 8) == 0);
+    assert(sPacket.version == 1 && sPacket.size == 32);
+    assert(sPacket.selfGbaAddress == PACKET_ADDRESS && sPacket.frameCounter == 1);
+    assert(sPacket.activeLanguage == 0 && sPacket.flags == 0);
+
+    // A website preference can never answer the initial native choice.
+    Request(1, 2);
+    Tick(0, 0);
+    assert(sPacket.ackSequence == 1 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_UNSET);
+    assert(sSave.language == 0 && sWrites == 0);
+    Request(2, 1);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 2 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_UNSET);
+    assert(sSave.language == 0 && sWrites == 0);
+
+    // Native selection publishes immediately, then a busy field queues web input.
+    sSave.language = 1;
+    TaichungLanguageBridge_PublishNativeChoice(&sPacket, 1);
+    Tick(1, 0);
+    Request(3, 2);
+    frame = sPacket.frameCounter;
+    for (i = 0; i < 60; i++)
+        Tick(1, 0);
+    assert(sPacket.frameCounter == frame + 60);
+    assert(sPacket.flags == TAICHUNG_LANGUAGE_BRIDGE_READY);
+    assert(sPacket.ackSequence == 2 && sPacket.requestedLanguage == 2 && sWrites == 0);
+    Tick(1, 1);
+    assert(sPacket.flags == (TAICHUNG_LANGUAGE_BRIDGE_READY | TAICHUNG_LANGUAGE_BRIDGE_SAFE_FIELD));
+    assert(sPacket.ackSequence == 3 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_APPLIED);
+    assert(sPacket.activeLanguage == 2 && sPacket.requestedLanguage == 0);
+    assert(sSave.language == 2 && sWrites == 1);
+    Tick(1, 1);
+    assert(sWrites == 1); // Acknowledged sequences never apply twice.
+
+    // A native re-selection of the SAME current language wins an older queue.
+    Request(4, 1);
+    Tick(1, 0);
+    TaichungLanguageBridge_PublishNativeChoice(&sPacket, 2);
+    assert(sPacket.ackSequence == 4 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+    Tick(1, 1);
+    assert(sSave.language == 2 && sWrites == 1);
+
+    // A direct native var change is also detected without the menu notification.
+    Request(5, 2);
+    sSave.language = 1;
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 5 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+    assert(sPacket.activeLanguage == 1 && sWrites == 1);
+
+    Request(6, 9);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 6 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_INVALID);
+    assert(sSave.language == 1 && sWrites == 1);
+
+    // A failed native write must not be acknowledged as a successful change.
+    Request(7, 2);
+    sWriterSucceeds = 0;
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 6 && sPacket.requestedLanguage == 2 && sSave.language == 1);
+    sWriterSucceeds = 1;
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 7 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_APPLIED);
+    assert(sSave.language == 2 && sWrites == 2);
+
+    Request(8, 0);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 8 && sPacket.result == TAICHUNG_LANGUAGE_BRIDGE_INVALID);
+    Request(0, 1);
+    Tick(1, 1);
+    assert(sPacket.ackSequence == 8 && sSave.language == 2 && sWrites == 2);
+    sPacket.frameCounter = 0xFFFFFFFF;
+    Tick(1, 1);
+    assert(sPacket.frameCounter == 1);
+
+    // Language writes preserve unrelated progression and player data.
+    assert(sSave.partyChecksum == 0x12345678 && sSave.starter == 4 && sSave.quest == 2);
+    assert(sSave.cityPass == 0x155 && sSave.positionX == 10 && sSave.positionY == 14);
+
+    // A stale/invalid packet cannot retain an old browser request after reinit.
+    sPacket.selfGbaAddress = 0x02000000;
+    Request(9, 1);
+    Tick(1, 1);
+    assert(sPacket.selfGbaAddress == PACKET_ADDRESS && sPacket.frameCounter == 1);
+    assert(sPacket.requestSequence == 0 && sPacket.ackSequence == 0 && sWrites == 2);
+    puts("Language bridge protocol: startup, queue/apply, native override, validation, ack ordering and state preservation passed.");
+    return 0;
+}
