+#!/usr/bin/env python3
+"""Encode one approved Miyahara study into an unmerged Station-palette candidate.
+
+This is mechanical format conversion authorized after architecture approval.
+The original study, native map, registry and all shared banks remain untouched.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ARTIFACT = PROJECT / "artifacts/worktrees/c291d4842985/landmark-art"
+STATION = GAME / "data/taichung/landmarks/old-station/native.png"
+SIZE, BODY_WIDTH, PIXEL_STEP = (160, 128), 128, 2
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+def encode(source, output, review):
+    rgba = Image.open(source).convert("RGBA")
+    station = Image.open(STATION)
+    if station.mode != "P" or station.info.get("transparency") != 0 or station.getextrema()[1] > 15:
+        raise ValueError("Station palette source must remain indexed 4bpp with transparent index0")
+    palette = [tuple(station.getpalette()[i:i+3]) for i in range(0, 48, 3)]
+    mask = rgba.getchannel("A").point(lambda a: 255 if a >= 224 else 0)
+    crop_box = mask.getbbox()
+    if crop_box is None:
+        raise ValueError("No building at alpha threshold224")
+    crop = rgba.crop(crop_box)
+    crop.putalpha(mask.crop(crop_box))
+    working = tuple(value//PIXEL_STEP for value in SIZE)
+    scale = min((BODY_WIDTH//PIXEL_STEP)/crop.width, working[1]/crop.height)
+    subject_size = tuple(max(1, round(value*scale)) for value in crop.size)
+    # Keep architectural mass/aspect intact. Its off-center photographed portal
+    # aligns near logical x88 when the visible body occupies x0..127; x128..159
+    # is explicitly empty, not an invented extension or mirrored facade.
+    offset = (0, working[1]-subject_size[1])
+    canvas = Image.new("RGBA", working)
+    canvas.paste(crop.resize(subject_size, Image.Resampling.NEAREST), offset)
+    indices = []
+    for r, g, b, a in canvas.get_flattened_data():
+        if not a:
+            indices.append(0)
+        else:
+            index = min(range(1, 16), key=lambda n:
+                        sum((value-palette[n][channel])**2 for channel, value in enumerate((r, g, b))))
+            indices.append(index)
+    indexed = Image.new("P", working)
+    indexed.putpalette([component for color in palette for component in color] + [0]*720)
+    indexed.putdata(indices)
+    indexed = indexed.resize(SIZE, Image.Resampling.NEAREST)
+    indexed.info["transparency"] = 0
+    indices = list(indexed.get_flattened_data())
+    graphics, lookup, tilemap = [], {}, []
+    for ty in range(SIZE[1]//8):
+        for tx in range(SIZE[0]//8):
+            pixels = tuple(indices[(ty*8+y)*SIZE[0]+tx*8+x] for y in range(8) for x in range(8))
+            canonical, flags = min((flip(pixels, flags), flags) for flags in (0, 0x400, 0x800, 0xC00))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tilemap.append(lookup[canonical] | flags | 0x7000)
+    metatiles, occupied, occupancy_rows = [], 0, []
+    for my in range(SIZE[1]//16):
+        row = ""
+        for mx in range(SIZE[0]//16):
+            metatiles.append([tilemap[(my*2+y)*20+mx*2+x] for y in range(2) for x in range(2)])
+            ink = any(indexed.getpixel((mx*16+x, my*16+y)) for y in range(16) for x in range(16))
+            occupied += ink
+            row += "1" if ink else "0"
+        occupancy_rows.append(row)
+    decoded = []
+    for y in range(SIZE[1]):
+        for x in range(SIZE[0]):
+            word = tilemap[(y//8)*20+x//8]
+            sx, sy = (7-x%8 if word & 0x400 else x%8), (7-y%8 if word & 0x800 else y%8)
+            decoded.append(graphics[word & 1023][sy*8+sx])
+    if decoded != indices:
+        raise ValueError("Flip-aware candidate tilemap round-trip failed")
+    output.mkdir(parents=True, exist_ok=True)
+    indexed.save(output / "candidate-indexed.png")
+    native = indexed.convert("RGBA")
+    native.save(output / "candidate-native.png")
+    # After visual identification of the main entrance, measure its actual dark
+    # glass interior in this fixed local band. This is an art measurement, not a
+    # collision mask or an assertion that a map door has been activated.
+    portal_pixels = [(x, y) for y in range(116, 124) for x in range(78, 100)
+                     if indexed.getpixel((x, y)) in (2, 3, 4, 11, 12)]
+    if not portal_pixels:
+        raise ValueError("The visually identified central portal has no glass pixels")
+    portal_box = [min(x for x, _ in portal_pixels), min(y for _, y in portal_pixels),
+                  max(x for x, _ in portal_pixels), max(y for _, y in portal_pixels)]
+    portal_center = [(portal_box[0]+portal_box[2])/2, (portal_box[1]+portal_box[3])/2]
+    review.parent.mkdir(parents=True, exist_ok=True)
+    native.resize((SIZE[0]*4, SIZE[1]*4), Image.Resampling.NEAREST).save(review)
+    physical_count = ((len(graphics)+15)//16)*16
+    sheet = Image.new("P", (128, physical_count//16*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info["transparency"] = 0
+    for n, pixels in enumerate(graphics):
+        for y in range(8):
+            for x in range(8):
+                sheet.putpixel((n%16*8+x, n//16*8+y), pixels[y*8+x])
+    sheet.save(output / "tiles.png")
+    (output / "tiles.4bpp").write_bytes(bytes(pixels[i] | pixels[i+1] << 4 for pixels in graphics for i in range(0, 64, 2)))
+    (output / "foreground-tilemap-relative.bin").write_bytes(struct.pack("<320H", *tilemap))
+    (output / "foreground-metatiles-relative.json").write_text(json.dumps(metatiles, indent=2)+"\n")
+    text = "JASC-PAL\r\n0100\r\n16\r\n" + "".join(" ".join(map(str, color))+"\r\n" for color in palette)
+    (output / "07.pal").write_bytes(text.encode())
+    (output / "07.gbapal").write_bytes(struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in palette)))
+    metadata = {
+        "schemaVersion": 1, "landmarkId": "miyahara",
+        "status": "architecture approved; independent native candidate encoded; unmerged and unregistered",
+        "sourceArtifact": str(source), "sourceSha256": sha(source),
+        "recipe": {"alphaThreshold": 224, "sourceCropBox": list(crop_box), "preserveAspectRatio": True,
+                   "resampling": "nearest", "logicalSizePixels": list(SIZE), "visibleBodyTargetWidth": BODY_WIDTH,
+                   "workingResolution": list(working), "nativePixelClusterSize": PIXEL_STEP,
+                   "fittedSubjectSize": [value*PIXEL_STEP for value in subject_size],
+                   "subjectOffset": [value*PIXEL_STEP for value in offset], "transparentRightBufferPixels": SIZE[0]-BODY_WIDTH,
+                   "quantization": "nearest RGB squared distance to exact existing Station indices1..15; no dithering or new colors",
+                   "PillowVersion": PIL.__version__},
+        "palette": {"bank": 7, "source": str(STATION.relative_to(GAME)), "sourceSha256": sha(STATION),
+                    "exactSourcePalette16": [list(color) for color in palette],
+                    "usedOpaqueIndexes": sorted(set(indices)-{0}), "newColorCount": 0, "additionalPaletteBankCount": 0,
+                    "sharedPaletteMatchesStationExactly": indexed.getpalette()[:48] == station.getpalette()[:48]},
+        "native": {"unique8x8GraphicsBeforeAnyBankMerge": len(graphics), "uniqueIncludesTransparentGraphic": True,
+                   "sheetSlotsIncludingPadding": physical_count, "foregroundTilemapDimensions8x8": [20, 16],
+                   "foregroundMetatileCells": len(metatiles), "occupiedMetatileCells": occupied,
+                   "distinctForegroundMetatileDefinitions": len({tuple(mt) for mt in metatiles}),
+                   "occupiedRows": occupancy_rows, "relativeGraphicIndexes": True,
+                   "binaryAlpha": set(native.getchannel("A").get_flattened_data()) == {0, 255},
+                   "tilemapRoundTripPass": True, "mapOrCollisionGenerated": False},
+        "entrance": {"targetLocalMetatile": [5, 7], "targetLocalCellPixelsInclusive": [80, 112, 95, 127],
+                     "targetCellCenterPixels": [88, 120],
+                     "measurementMethod": "visually identified main portal; dark/glass indices2,3,4,11,12 inside x78..99,y116..123",
+                     "measuredDoorGlassBoxPixelsInclusive": portal_box, "measuredDoorGlassCenterPixels": portal_center,
+                     "centerDeltaFromTargetPixels": [portal_center[0]-88, portal_center[1]-120],
+                     "doorGlassFitsTargetCell": 80 <= portal_box[0] <= portal_box[2] <= 95 and 112 <= portal_box[1] <= portal_box[3] <= 127,
+                     "baselineDoor": [20, 52], "baselineApproach": [20, 53], "baselineArrival": [20, 55],
+                     "proposedBaselineOrigin": [15, 45], "paintedDoorIsNotActiveWarp": True},
+        "budget": {"mergedWithOldCity": False, "stationAndOtherLandmarksNotIncludedInCost": True,
+                   "secondaryCapacity": 384, "rootOwnsCombinedPrimarySecondaryAndColorBudget": True,
+                   "fitsCombinedOldCity": None, "noSeparateFullBankAllocationAssumed": True},
+        "integration": {"registeredInRom": False, "nativeReady": False, "geometryReviewed": False,
+                        "requires": ["actual portal alignment check", "shared OldCity budget/graphic remapping", "source ground/collision composition", "door binding and runtime validation"]},
+        "reviewArtifact": str(review), "nativePngSha256": sha(output / "candidate-native.png"),
+    }
+    (output / "encode-manifest.json").write_text(json.dumps(metadata, indent=2)+"\n")
+    return metadata
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ARTIFACT / "miyahara-study-v1.png")
+    parser.add_argument("--output", type=Path, default=HERE / "candidate")
+    parser.add_argument("--review", type=Path, default=ARTIFACT / "miyahara-native-candidate-v1.png")
+    args = parser.parse_args()
+    result = encode(args.source, args.output, args.review)
+    print(json.dumps({"recipe": result["recipe"], "native": result["native"], "reviewArtifact": result["reviewArtifact"]}, indent=2))
