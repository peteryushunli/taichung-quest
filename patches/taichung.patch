@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Mechanically quantize the sculpture to unused Shen Ji palette slots.
+
+The indexed sculpture's dimensions, alpha mask and grounded base are unchanged.
+All 13 palette entries actually used by the approved Shen Ji candidate stay exact.
+"""
+from collections import Counter
+import hashlib
+from itertools import combinations
+import json
+from pathlib import Path
+
+from PIL import Image
+
+HERE=Path(__file__).resolve().parent
+SHEN=HERE.parent/'shen-ji/candidate/candidate-indexed.png'
+SOURCE=HERE/'candidate/sculpture/candidate-indexed.png'
+OUTPUT=HERE/'candidate/sculpture-shared'
+
+
+def distance(a,b):
+    return sum((x-y)**2 for x,y in zip(a,b))
+
+
+def main():
+    shen,source=Image.open(SHEN),Image.open(SOURCE)
+    palette=[tuple(shen.getpalette()[i:i+3]) for i in range(0,48,3)]
+    old=[tuple(source.getpalette()[i:i+3]) for i in range(0,48,3)]
+    used=set(shen.get_flattened_data())-{0}
+    free=[i for i in range(1,16) if i not in used]
+    assert len(free)>=2
+    counts=Counter(old[i] for i in source.get_flattened_data() if i)
+    base=[palette[i] for i in used]
+    extra=min(combinations(counts,2),key=lambda pair:sum(n*min(distance(c,p) for p in base+list(pair)) for c,n in counts.items()))
+    for i,c in zip(free,extra):palette[i]=c
+    indices=[0 if not i else min(range(1,16),key=lambda k:distance(old[i],palette[k])) for i in source.get_flattened_data()]
+    assert [bool(i) for i in indices]==[bool(i) for i in source.get_flattened_data()]
+    OUTPUT.mkdir(exist_ok=True)
+    result=Image.new('P',source.size);result.putpalette([v for c in palette for v in c]+[0]*720)
+    result.putdata(indices);result.info['transparency']=0
+    result.save(OUTPUT/'candidate-indexed.png')
+    result.convert('RGBA').resize((128,128),Image.Resampling.NEAREST).save(OUTPUT/'preview-4x.png')
+    (OUTPUT/'09.pal').write_bytes(('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,c)) for c in palette)+'\r\n').encode())
+    report=dict(sourceIndexed='../sculpture/candidate-indexed.png',sourceSha256=hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
+                palette9SharedWith='shen-ji/candidate/candidate-indexed.png',shenJiUsedIndicesPreserved=sorted(used),
+                newColorsOnlyInPreviouslyUnusedIndices=dict(zip(map(str,free),map(list,extra))),
+                geometryAlphaAndNonzeroPixelMaskUnchanged=True,
+                quantization='nearest RGB to shared warm palette plus two optimally selected native sculpture reds; no dithering',
+                rgbRmsePerChannel=(sum(distance(old[a],palette[b]) for a,b in zip(source.get_flattened_data(),indices) if a)/sum(counts.values())/3)**.5,
+                baseAlignment='same32x32south-alignedmask; placebottomonmuseumplazaground')
+    (OUTPUT/'encode-manifest.json').write_text(json.dumps(report,indent=2)+'\n')
+
+
+if __name__=='__main__':main()
