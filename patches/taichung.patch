@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Primary tile and metatile budget for the shared city kit (read-only).
+
+For each private Taichung primary (taichung_xitun_private,
+taichung_greenway_private, taichung_old_core) this lists the 640 primary tile
+indices that something can draw:
+
+  - tiles of the primary metatile definitions its maps use (map.bin and
+    border.bin words below 640, and setmetatile targets in their scripts);
+  - tiles below 640 in every definition of every secondary paired with it,
+    used or not (no interior pairs with these primaries);
+  - General's animation slots, which TilesetAnim_General rewrites every few
+    frames: water/current/land edge 416-463, sand edge 464-481, flower 508-511.
+
+A tile in none of these, in all three primaries, is free for the kit. The
+primary metatile definitions free in all three are those no Taichung exterior,
+border or script uses, minus the IDs C code names (door animation keys and
+Cut's grass and tree swaps). Cut can also draw a mowed definition on a map that
+holds the grass it replaces; those definitions' tiles count as used. So do the
+primary tiles and definitions of Codex's city-v3 object library (LIBRARY at
+LIBRARY_COMMIT), which the district passes place from.
+
+  audit_primaries.py                      print the summary
+  audit_primaries.py --json out.json      also write the full audit
+"""
+import argparse
+import hashlib
+import json
+import re
+import struct
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+PRIMARIES = {
+    "taichung_xitun_private": "gTileset_TaichungXitunPrivatePrimary",
+    "taichung_greenway_private": "gTileset_TaichungGreenwayPrivate",
+    "taichung_old_core": "gTileset_TaichungOldCorePrimary",
+}
+ANIMATION = {"water_current_landwatersedge": (416, 48), "sandwatersedge": (464, 18), "flower": (508, 4)}
+PRIMARY_SIZE = 640
+LIBRARY_COMMIT = "890b0caf238b371e8205ab1b09355ed13bb6c301"
+LIBRARY = "data/taichung/neighborhoods/city-v3-object-library.json"
+
+
+class Source:
+    """Reads the tree once; overrides (path -> bytes) stand in for files."""
+    def __init__(self, root, overrides=None):
+        self.root, self.raw = Path(root), dict(overrides or {})
+
+    def read(self, path):
+        if path not in self.raw:
+            self.raw[path] = (self.root / path).read_bytes()
+        return self.raw[path]
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path):
+        raw = self.read(path)
+        return struct.unpack(f"<{len(raw) // 2}H", raw)
+
+    def git(self, commit, path):
+        key = f"{commit}:{path}"
+        if key not in self.raw:
+            self.raw[key] = subprocess.run(["git", "-C", str(self.root), "show", key], check=True, capture_output=True).stdout
+        return self.raw[key]
+
+    def provenance(self):
+        return {path: hashlib.sha256(raw).hexdigest() for path, raw in sorted(self.raw.items())}
+
+
+def ranges(values):
+    out = []
+    for n in sorted(values):
+        if out and n == out[-1][1] + 1:
+            out[-1][1] = n
+        else:
+            out.append([n, n])
+    return [f"0x{a:03X}" if a == b else f"0x{a:03X}-0x{b:03X}" for a, b in out]
+
+
+def tileset_files(src, label):
+    """Metatile and tile paths for a tileset label, read from the C declarations."""
+    header = re.search(rf"\b{label}\s*=\s*\{{(.*?)\}};", src.text("src/data/tilesets/headers.h"), re.S).group(1)
+    decls = src.text("src/data/tilesets/metatiles.h") + src.text("src/data/tilesets/graphics.h")
+    out = {}
+    for field in ("metatiles", "tiles", "callback"):
+        value = re.search(rf"\.{field}\s*=\s*(\w+)", header).group(1)
+        if field == "callback":
+            out[field] = value
+            continue
+        out[field] = re.search(rf"\b{value}\[\]\s*=\s*INCBIN_\w+\(\"([^\"]+)\"\)", decls).group(1)
+    return out
+
+
+def metatile_labels(src):
+    return {m.group(1): int(m.group(2), 16) for m in re.finditer(
+        r"#define\s+(METATILE_\w+)\s+0x([0-9A-Fa-f]+)", src.text("include/constants/metatile_labels.h"))}
+
+
+def audit(root, src=None, ignore=()):
+    """(report, kit tile slots, free definitions). Definitions in ignore (the
+    installed kit itself) neither use tiles nor count as used."""
+    src = src or Source(root)
+    layouts = [l for l in src.json("data/layouts/layouts.json")["layouts"] if l]
+    maps = {}
+    for path in sorted((Path(root) / "data/maps").glob("*/map.json")):
+        rel = str(path.relative_to(root))
+        maps.setdefault(src.json(rel)["layout"], []).append(path.parent.name)
+    labels = metatile_labels(src)
+    code_ids = set()
+    for path in sorted((Path(root) / "src").rglob("*.c")):
+        text = path.read_text(errors="ignore")
+        names = set(re.findall(r"\bMETATILE_General_\w+", text))
+        names |= {f"METATILE_General_{m}" for m in re.findall(r"METATILE_ID\(\s*General\s*,\s*(\w+)\s*\)", text)}
+        code_ids |= {labels[name] for name in names}
+    report, used_defs_all = {}, set()
+    for folder, label in PRIMARIES.items():
+        files = tileset_files(src, label)
+        defs = src.words(files["metatiles"])
+        assert len(defs) == PRIMARY_SIZE * 8, f"{folder}: {len(defs) // 8} definitions"
+        paired = [l for l in layouts if l["primary_tileset"] == label]
+        used_defs, secondary_tiles, secondaries, sources = set(), set(), [], {}
+        for layout in paired:
+            for key in ("blockdata_filepath", "border_filepath"):
+                ids = {w & 0x3FF for w in src.words(layout[key])}
+                used_defs |= {i for i in ids if i < PRIMARY_SIZE and i not in ignore}
+            for name in maps.get(layout["id"], []):
+                script = Path(root) / f"data/maps/{name}/scripts.inc"
+                if script.exists():
+                    for target in re.findall(r"setmetatile\s+\w+\s*,\s*\w+\s*,\s*(\w+)", src.text(f"data/maps/{name}/scripts.inc")):
+                        value = labels.get(target, None) if not target[0].isdigit() else int(target, 0)
+                        if value is not None and value < PRIMARY_SIZE:
+                            used_defs.add(value)
+            sec = tileset_files(src, layout["secondary_tileset"])
+            if layout["secondary_tileset"] not in secondaries:
+                secondaries.append(layout["secondary_tileset"])
+                tiles = {w & 0x3FF for w in src.words(sec["metatiles"])} - {t for t in range(PRIMARY_SIZE, 1024)}
+                sources[layout["secondary_tileset"]] = len(tiles)
+                secondary_tiles |= tiles
+        primary_tiles = {defs[i * 8 + k] & 0x3FF for i in used_defs for k in range(8)}
+        assert all(t < PRIMARY_SIZE for t in primary_tiles), f"{folder}: a primary definition reaches the secondary"
+        animated = {base + k for base, count in ANIMATION.values() for k in range(count)} if files["callback"] == "InitTilesetAnim_General" else set()
+        used = primary_tiles | secondary_tiles | animated
+        used_defs_all |= used_defs
+        report[folder] = dict(
+            tileset=label, layouts=[l["id"] for l in paired], secondaries=secondaries, animationCallback=files["callback"],
+            usedPrimaryMetatiles=ranges(used_defs), usedPrimaryMetatileCount=len(used_defs),
+            tilesFromPrimaryMetatiles=len(primary_tiles), tilesFromSecondaries=len(secondary_tiles),
+            secondaryPrimaryTileCounts=sources, animationSlots=len(animated),
+            usedTileCount=len(used), usedTiles=ranges(used),
+            freeTileCount=PRIMARY_SIZE - len(used), freeTiles=ranges(set(range(PRIMARY_SIZE)) - used),
+            _used=used)
+    common_free = set(range(PRIMARY_SIZE))
+    for item in report.values():
+        common_free -= item.pop("_used")
+    identical = {name: hashlib.sha256(src.read(f"data/tilesets/primary/{f}/{name}")).hexdigest()
+                 for f in PRIMARIES for name in ("metatiles.bin", "metatile_attributes.bin")}
+    same_defs = len({hashlib.sha256(src.read(f"data/tilesets/primary/{f}/metatiles.bin")).digest() for f in PRIMARIES}) == 1
+    same_attrs = len({hashlib.sha256(src.read(f"data/tilesets/primary/{f}/metatile_attributes.bin")).digest() for f in PRIMARIES}) == 1
+    same_pals = all(len({src.read(f"data/tilesets/primary/{f}/palettes/{p:02}.pal") for f in PRIMARIES}) == 1 for p in range(16))
+    free_defs = set(range(PRIMARY_SIZE)) - used_defs_all - code_ids
+    cut = re.findall(r"\{\s*METATILE_ID\(General,\s*(\w+)\),\s*METATILE_ID\(General,\s*(\w+)\)\s*\}",
+                     src.text("src/fldeff_cut.c"))
+    mowed = {labels[f"METATILE_General_{b}"] for a, b in cut if labels[f"METATILE_General_{a}"] in used_defs_all}
+    defs = src.words(f"data/tilesets/primary/{next(iter(PRIMARIES))}/metatiles.bin")
+    runtime = {defs[i * 8 + k] & 0x3FF for i in mowed for k in range(8)}
+    library = json.loads(src.git(LIBRARY_COMMIT, LIBRARY))
+    library_defs = {c["metatile"] for e in library["entries"] for row in e.get("cells") or [] for c in row
+                    if c and c.get("metatile") is not None and c["metatile"] < PRIMARY_SIZE}
+    library_tiles = {defs[i * 8 + k] & 0x3FF for i in library_defs for k in range(8)}
+    library_tiles |= {int(word, 16) & 0x3FF for bank in library["banks"].values() for m in bank["metatiles"].values()
+                      for word in m["entries"] if int(word, 16) & 0x3FF < PRIMARY_SIZE}
+    free_defs -= library_defs
+    kit_free = common_free - runtime - library_tiles
+    return dict(
+        primaries=report,
+        commonFreeTileCount=len(common_free), commonFreeTiles=ranges(common_free),
+        usedPrimaryMetatileCount=len(used_defs_all), usedPrimaryMetatiles=ranges(used_defs_all),
+        codeMetatiles=ranges(code_ids), cutReachableMetatiles=ranges(mowed), runtimeTiles=ranges(runtime),
+        libraryMetatiles=ranges(library_defs), libraryTilesInCommonFree=ranges(library_tiles & common_free),
+        kitFreeTileCount=len(kit_free), kitFreeTiles=ranges(kit_free),
+        commonFreeMetatileCount=len(free_defs), commonFreeMetatiles=ranges(free_defs),
+        identicalDefinitions=same_defs, identicalAttributes=same_attrs, identicalPalettes=same_pals,
+        animation={k: f"0x{b:03X}-0x{b + c - 1:03X}" for k, (b, c) in ANIMATION.items()},
+        inputs=src.provenance()), kit_free, free_defs
+
+
+def summary(result):
+    lines = []
+    for name, item in result["primaries"].items():
+        lines.append(f"{name}: {item['usedTileCount']} of 640 tiles used ({item['tilesFromPrimaryMetatiles']} from "
+                     f"{item['usedPrimaryMetatileCount']} primary definitions, {item['tilesFromSecondaries']} from "
+                     f"{', '.join(item['secondaries'])}, {item['animationSlots']} animation), {item['freeTileCount']} free")
+    lines.append(f"free in all three: {result['commonFreeTileCount']} tiles; "
+                 f"{result['commonFreeMetatileCount']} metatile definitions "
+                 f"({result['usedPrimaryMetatileCount']} used by exteriors; held back for code "
+                 f"{', '.join(result['codeMetatiles'])} and the city-v3 library {', '.join(result['libraryMetatiles'])})")
+    lines.append(f"kit tiles: {result['kitFreeTileCount']} (free in all three, not drawn by Cut's swap to "
+                 f"{', '.join(result['cutReachableMetatiles'])}, not referenced by the city-v3 library: "
+                 f"{', '.join(result['libraryTilesInCommonFree']) or 'none'} held back)")
+    lines.append(f"definitions identical: {result['identicalDefinitions']}, attributes: {result['identicalAttributes']}, "
+                 f"palettes: {result['identicalPalettes']}")
+    return "\n".join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--json", type=Path)
+    args = parser.parse_args()
+    result, _, _ = audit(args.source)
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(json.dumps(result, indent=1) + "\n")
+    print(summary(result))
+
+
+if __name__ == "__main__":
+    main()
