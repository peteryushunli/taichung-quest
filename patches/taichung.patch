new file mode 100644
index 00000000..6b052383
--- /dev/null
+++ b/tests/test_capture_gameplay_guard.py
@@ -0,0 +1,88 @@
+"""Immutable source identity, old-probe preservation and live override checks."""
+import ast
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+BASE = 'ae3c49b2ee8909b57cad1e93343ac6abe68ff3ed'
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, ROOT / path)
+    result = importlib.util.module_from_spec(spec); spec.loader.exec_module(result)
+    return result
+
+
+guard = module('capture_gameplay_test', 'tools/taichung/capture_gameplay_guard.py')
+gym = module('gym_capture_test', 'tools/taichung/gym_interiors_guard.py')
+home = module('home_capture_test', 'tools/taichung/home_start.py')
+
+
+def frozen(revision, path):
+    return subprocess.check_output(['git', 'show', revision + ':' + path], cwd=ROOT)
+
+
+class CaptureGuardTests(unittest.TestCase):
+    def test_complete_current_and_corruption_probes(self):
+        report = guard.self_test(ROOT)
+        self.assertTrue(report['passed'], report)
+        self.assertEqual(len(report['rejectedInputChanges']), 40)
+        self.assertEqual(report['current']['checkedGameplayInputs'], 32)
+        self.assertEqual(report['current']['historicalInputs'], 20)
+
+    def test_exact_immutable_capture_source_and_underlay(self):
+        read = guard.reader(ROOT)
+        registration = json.loads(read(guard.MANIFEST))
+        under = guard.peel(read)
+        self.assertNotIn('src/taichung_save.c', under)
+        for path, item in registration['inputs'].items():
+            self.assertEqual(read(path), frozen(registration['acceptedSourceCommit'], path), path)
+            if item['kind'] == 'edited':
+                self.assertEqual(under[path], frozen(registration['baselineCommit'], path), path)
+        for path in registration['glyphAppend']['files']:
+            self.assertEqual(read(path), frozen(registration['fontCommit'], path), path)
+            self.assertEqual(under[path], frozen(registration['baselineCommit'], path), path)
+
+    def test_original_registrations_and_probes_remain_exact(self):
+        for path in (
+            'data/taichung/encounter-save-init/registration.json',
+            'tools/taichung/encounter_save_init_guard.py',
+            'data/taichung/gym-interiors/manifest.json',
+            'tools/taichung/approved_art_guard.py', 'tools/taichung/home_start.py',
+            'tools/taichung/landmarks/check_cmp.py', 'tools/taichung/landmarks/check_old_core.py',
+            'tools/taichung/streetscape/check_xitun_streets.py',
+        ):
+            self.assertEqual((ROOT / path).read_bytes(), frozen(BASE, path), path)
+        path = 'tools/taichung/gym_interiors_guard.py'
+        old, new = frozen(BASE, path).decode(), (ROOT / path).read_text()
+        for name in ('self_test', 'manifest', 'baseline'):
+            def segment(text):
+                tree = ast.parse(text)
+                node = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == name)
+                return ast.get_source_segment(text, node)
+            self.assertEqual(segment(old), segment(new), name)
+
+    def test_foreign_change_stays_live_and_old_guard_rejects(self):
+        path = 'src/new_game.c'
+        raw = (ROOT / path).read_bytes() + b'\n/* unrelated edit */\n'
+        under = guard.peel(guard.reader(ROOT, {path: raw}))
+        self.assertNotIn(path, under)
+        self.assertFalse(home.check(ROOT, {path: raw})['passed'])
+
+    def test_wenchang_binding_and_bridge_underlay_reach_older_guards(self):
+        class View:
+            source = ROOT
+            read = staticmethod(guard.reader(ROOT))
+        under = gym.underneath(View)
+        self.assertEqual(under['data/scripts/taichung_city.inc'], frozen('8d3694b', 'data/scripts/taichung_city.inc'))
+        self.assertEqual(under['src/main.c'], frozen('8d3694b', 'src/main.c'))
+        self.assertTrue(home.check(ROOT)['passed'])
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
