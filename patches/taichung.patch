+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { open } from '../north-xitun/cdp.mjs';
+import { installTravelEmulator } from '../north-xitun/emulator.mjs';
+const qa=process.argv[2];
+const metadata=JSON.parse(await readFile(join(qa,'roms/build.json'),'utf8'));
+// Read-only EWRAM variable; address is checked against this candidate's ELF.
+const install=installTravelEmulator.toString().replace("    frame: () => canvas.toDataURL('image/png'),",
+  "    site: () => memory.getUint16(base + 0x020370c6 - address, true),\n    frame: () => canvas.toDataURL('image/png'),");
+const results=[];
+for(const [i,item] of [{id:'ding-sign',map:36,x:11,y:17,site:22},{id:'ntc-sign',map:36,x:14,y:17,site:21},
+                      {id:'the-lin-guide',map:29,x:18,y:14,site:23}].entries())
+ for(const [j,mode] of ['walk','bike'].entries()) {
+  const fixture=(await readFile(join(qa,item.id+'.sav'))).toString('base64');
+  const browser=await open({url:'http://127.0.0.1:8341/',debugPort:9450+i*2+j,outDir:qa,
+    bootstrap:async evaluate=>{
+      for(let n=0;n<100;n++) {
+        if(await evaluate('crossOriginIsolated && !!document.body').catch(()=>false))break;
+        await new Promise(resolve=>setTimeout(resolve,50));
+      }
+      await evaluate('('+install+')('+JSON.stringify({metadata,fixture,mode,speed:6,start:[item.map,item.x,item.y],graph:{points:[],neighbors:[],signWalls:[]},actions:[]})+')');
+    }});
+  try {
+    await browser.evaluate('qa.boot()');
+    await browser.evaluate("qa.press(null,0,80)");
+    await browser.evaluate("qa.press('Up',12,30)");
+    await browser.evaluate("qa.press('A',8,80)");
+    assert.equal(await browser.evaluate('qa.site()'),item.site);
+    assert(!(await browser.state()).field,'The sign should open the common native interaction');
+    await browser.shot(mode+'-'+item.id+'-interaction');
+    results.push({id:item.id,mode,siteId:item.site,approach:[item.map,item.x,item.y],interactionReached:true,
+      note:'Map binding proof only; new capture availability/species requires Gameplay registry update.'});
+  } finally {browser.close();}
+ }
+await writeFile(join(qa,'sign-interactions.json'),JSON.stringify(results,null,2)+'\n');
+console.log('PASS both tower signs and The Lin guide on foot/bike with stable site IDs21–23.');
diff --git a/tools/taichung/boulevard_city/qa/north-xitun-continue/emulator.mjs b/tools/taichung/boulevard_city/qa/north-xitun-continue/emulator.mjs
