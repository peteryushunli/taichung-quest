+"""Shared, pinned glyph source for native refresh and append operations.
+
+The configured bitmap source is authoritative. Rendering reads original BDF
+bits directly: no antialiasing, resampling, synthetic weight or fallback face.
+"""
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import re
+
+
+MANIFEST = 'assets/fonts/taichung-native-font.json'
+NOTO_SHA256 = '864727d210d54f2537bbe23b3a839436c3992af72de9322af5270897246bd44f'
+METRICS = {'advance': 12, 'cellWidth': 12, 'cellHeight': 14,
+           'sourcePixelSize': 12, 'sourceAscent': 10, 'sourceDescent': 2, 'topPadding': 1}
+
+
+def sha256(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+class BitmapFont:
+    def __init__(self, game, manifest, supplied_font=None):
+        if manifest.get('schemaVersion') != 1 or manifest.get('provider') != 'bdf-gzip':
+            raise ValueError('Unsupported native bitmap font manifest')
+        if manifest.get('metrics') != METRICS:
+            raise ValueError('Native font must retain the reviewed 12px advance and 12x14 cell')
+        source = (game / manifest['source']).resolve()
+        source.relative_to(game.resolve())
+        if supplied_font is not None and supplied_font.resolve() != source:
+            raise ValueError('The configured bitmap font is authoritative; omit legacy --font or pass its manifest source')
+        packed = source.read_bytes()
+        if sha256(packed) != manifest['sourceSha256']:
+            raise ValueError('Native bitmap source checksum mismatch')
+        raw = gzip.decompress(packed)
+        if sha256(raw) != manifest['uncompressedSha256']:
+            raise ValueError('Native uncompressed BDF checksum mismatch')
+        for name in manifest['licenseFiles']:
+            path = (game / name).resolve()
+            path.relative_to(game.resolve())
+            if not path.read_bytes():
+                raise ValueError('Native bitmap font license is missing: ' + name)
+        self.metadata = {'provider': 'bdf-gzip', 'family': manifest['upstreamFamily'],
+                         'version': manifest['upstreamVersion'], 'fontSha256': manifest['sourceSha256'],
+                         'bdfSha256': manifest['uncompressedSha256'], 'source': manifest['source'],
+                         'rendering': METRICS, 'licenseFiles': manifest['licenseFiles']}
+        text = raw.decode('ascii')
+        ascent = re.search(r'^FONT_ASCENT (\d+)$', text, re.M)
+        descent = re.search(r'^FONT_DESCENT (\d+)$', text, re.M)
+        size = re.search(r'^PIXEL_SIZE (\d+)$', text, re.M)
+        if not ascent or not descent or not size or tuple(map(int, (ascent[1], descent[1], size[1]))) != (10, 2, 12):
+            raise ValueError('BDF does not have the reviewed 12px metrics')
+        self.glyphs = {}
+        for block in text.split('STARTCHAR ')[1:]:
+            code = re.search(r'^ENCODING (\d+)$', block, re.M)
+            if not code:
+                continue
+            code = int(code[1])
+            if code in self.glyphs:
+                raise ValueError('Duplicate BDF encoding: ' + str(code))
+            self.glyphs[code] = block
+
+    def render(self, character):
+        block = self.glyphs.get(ord(character))
+        if block is None:
+            raise ValueError(f'Configured bitmap font lacks U+{ord(character):04X} {character}; no fallback is allowed')
+        advance = re.search(r'^DWIDTH (-?\d+) (-?\d+)$', block, re.M)
+        box = re.search(r'^BBX (\d+) (\d+) (-?\d+) (-?\d+)$', block, re.M)
+        if not advance or tuple(map(int, advance.groups())) != (12, 0) or not box:
+            raise ValueError('Glyph must retain 12px advance: ' + character)
+        width, height, left, bottom = map(int, box.groups())
+        bitmap = block.split('BITMAP\n', 1)[1].split('\nENDCHAR', 1)[0].splitlines()
+        if len(bitmap) != height:
+            raise ValueError('BDF row count mismatch: ' + character)
+        top = 1 + 10 - bottom - height
+        masks = [0] * 14
+        for row, line in enumerate(bitmap):
+            word, bits = int(line, 16), len(line) * 4
+            if bits < width:
+                raise ValueError('BDF row is too short: ' + character)
+            for x in range(width):
+                if word & (1 << (bits - 1 - x)):
+                    dx, dy = left + x, top + row
+                    if not (0 <= dx < 12 and 0 <= dy < 14):
+                        raise ValueError('Native glyph would clip: ' + character)
+                    masks[dy] |= 1 << dx
+        if not any(masks):
+            raise ValueError('Blank native glyph: ' + character)
+        return masks
+
+
+class LegacyNotoFont:
+    """For older copied fixtures only, never an override of a bitmap manifest."""
+    def __init__(self, path):
+        if path is None or sha256(path.read_bytes()) != NOTO_SHA256:
+            raise ValueError('A legacy checkout requires its pinned NotoSansTC.ttf via --font')
+        try:
+            from PIL import ImageFont
+        except ImportError as error:
+            raise ValueError('Pillow is required only for the explicitly selected legacy Noto source') from error
+        self.font = ImageFont.truetype(str(path), 12)
+        self.font.set_variation_by_name('Medium')
+        self.metadata = {'provider': 'legacy-noto', 'family': 'Noto Sans TC Medium',
+                         'fontSha256': NOTO_SHA256,
+                         'rendering': {'variation': 'Medium', 'fontPixels': 12, 'width': 12, 'height': 14, 'threshold': 96}}
+
+    def render(self, character):
+        from PIL import Image, ImageDraw
+        bitmap = Image.new('L', (12, 14), 0)
+        box = self.font.getbbox(character)
+        ImageDraw.Draw(bitmap).text((-box[0], 1 - box[1]), character, font=self.font, fill=255)
+        masks = [sum(1 << x for x in range(12) if bitmap.getpixel((x, y)) >= 96) for y in range(14)]
+        if not any(masks):
+            raise ValueError('Blank new glyph: ' + character)
+        return masks
+
+
+def load_font(game, supplied_font=None):
+    path = game / MANIFEST
+    if path.exists():
+        return BitmapFont(game, json.loads(path.read_text()), supplied_font)
+    return LegacyNotoFont(supplied_font)
+
+
+def glyph_records(font, characters, first_index):
+    records = []
+    for index, character in enumerate(characters, first_index):
+        if index >= 240 * 240:
+            raise ValueError('FC19 two-digit base240 capacity exhausted')
+        records.append({'character': character, 'index': index,
+                        'encoding': [0xFC, 0x19, index % 240 + 1, index // 240 + 1],
+                        'masks': font.render(character)})
+    return records
