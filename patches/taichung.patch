+"""Compile retained release placements into staged native outputs and a build report.
+
+The infill compiler also reproduces its small, tracked sand-play PNG from code.
+"""
+import json
+import os
+from pathlib import Path
+import sys
+
+game, authoring, output = map(Path, sys.argv[1:])
+os.environ["FILL_RAW"] = "1"
+sys.path.insert(0, str(authoring / "src"))
+import events
+
+raw = json.loads((authoring / "out/fill-raw.json").read_text())
+build_world = events.build
+
+def build_from_snapshot():
+    world = build_world()
+    # The release export is authoritative for prop placement. The live
+    # block-population scripts can propose additional decorative sprites.
+    placements = []
+    for item in raw["placements"]:
+        width, height = item["tiles"]
+        sprite = item["sprite"] + ("@flip" if item["mirrored"] else "")
+        placed = dict(sprite=sprite, kind=item["kind"], x=item["x"], y=item["y"], w=width, h=height)
+        if "solidTiles" in item:
+            placed["solid"] = item["solidTiles"]
+        placements.append(placed)
+    world.objects = placements
+    return world
+
+events.build = build_from_snapshot
+sys.path.insert(0, str(game / "tools/taichung/boulevard_city"))
+import build_city as compiler
+
+generate_outputs = compiler.outputs_for
+
+def capture_outputs(*args):
+    for path, content in generate_outputs(*args).items():
+        supplied = output / path
+        supplied.parent.mkdir(parents=True, exist_ok=True)
+        supplied.write_bytes(content)
+    return {}
+
+compiler.outputs_for = capture_outputs
+sys.argv = [compiler.__file__, str(authoring), "--report", str(output / "build-report.json")]
+compiler.main()
