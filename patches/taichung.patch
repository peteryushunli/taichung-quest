+work=Path('/Users/peter/devday_hackathon/artifacts/qa/2026-11-23-landmark-art-refresh')/'north-xitun'
+kit=root/'artifacts/boulevard-plan/fill/out/native-city-edges/authoring/kit'
+current=Image.open(work/'current-native.png').convert('RGBA')
+proposal=current.copy()
+sheet=Image.open(kit/'tiles-north.png').convert('RGBA')
+origin=(44,60)
+def point(x,y):
+    return ((x-origin[0])*16,(y-origin[1])*16)
+def tile(n):
+    l,t=(n%32)*16,(n//32)*16
+    return sheet.crop((l,t,l+16,t+16))
+paving=tile(0x1c1)
+grass=tile(0x001)
+
+def ground(rect, texture=paving):
+    left,top,right,bottom=rect
+    for y in range(top,bottom):
+        for x in range(left,right):
+            proposal.paste(texture,point(x,y))
+
+def place(name,x,y):
+    with Image.open(kit/'sprites'/f'{name}.png') as im:
+        proposal.alpha_composite(im.convert('RGBA'),point(x,y))
+
+# Keep the main roads and the established parcels framing the new frontage.
+market=(55,76,70,89)
+ground(market)
+place('wider-attached-shops',58,77)
+place('flower-shrub',56,77)
+place('courtyard-tree',56,78)
+place('market-produce-cart',56,82)
+place('steel-breakfast-cart',66,82)
+place('umbrella-tea-cart',61,84)
+place('planted-concrete-trough',56,85)
+
+park=(100,67,118,87)
+ground(park,grass)
+paths=[
+    (104,71,115,73),(113,73,115,81),(104,81,117,83),(104,73,106,81),
+    (108,67,110,71),(108,83,110,87),(100,76,104,78),(115,77,118,79)
+]
+for path in paths:
+    ground(path)
+for name,x,y in [
+    ('camphor',100,67),('courtyard-tree',104,68),('courtyard-tree',112,68),('camphor',114,67),
+    ('camphor',106,75),('camphor',100,80),('courtyard-tree',115,73),('courtyard-tree',115,84),
+    ('flower-shrub',101,74),('flower-shrub',111,84),('flower-shrub',106,74),
+    ('fern-stone',110,71),('meadow-tuft',102,84),('meadow-tuft',114,86),
+    ('wood-park-bench',106,79),('wood-park-bench',110,69),('wood-park-bench',111,84)
+]:
+    # The park loop is graded as open paving. Use its planting edges for props.
+    if (name,x,y)==('fern-stone',110,71):
+        continue
+    if (name,x,y)==('flower-shrub',111,84):
+        continue
+    place(name,x,y)
+# A small sand play area sits within the loop under the main grove's canopy.
+l,t=point(110,75)
+r,b=point(113,79)
+draw=ImageDraw.Draw(proposal)
+draw.rectangle((l,t,r-1,b-1),fill='#9b8661')
+draw.rectangle((l+2,t+2,r-3,b-3),fill='#dbc48c')
+draw.rectangle((l+3,t+3,r-4,t+5),fill='#eddaab')
+for y in range(t+10,b-3,7):
+    for x in range(l+5+(y%3),r-5,9):
+        draw.rectangle((x,y,x+1,y),fill='#c7ac7f')
+draw.rectangle((l+10,t+12,l+20,t+14),fill='#935f48')
+draw.rectangle((l+12,t+12,l+13,t+21),fill='#795948')
+draw.rectangle((l+18,t+12,l+19,t+21),fill='#795948')
+draw.rectangle((l+13,t+19,l+18,t+20),fill='#d4a05e')
+
+housing=(98,92,109,104)
+ground(housing)
+place('full-lot-apartments',98,93)
+ground((100,101,106,103),grass)
+ground((102,100,104,104))
+place('courtyard-tree',100,100)
+place('courtyard-tree',104,100)
+place('concrete-bench',99,102)
+place('flower-shrub',104,102)
+
+# Check the visual proof only changes the three selected infill sites.
+base=current.convert('RGB')
+draft=proposal.convert('RGB')
+changes=ImageChops.difference(base,draft)
+mask=Image.new('1',base.size)
+allowed=ImageDraw.Draw(mask)
+for rect in [market,park,housing]:
+    l,t=point(*rect[:2]);r,b=point(*rect[2:])
+    allowed.rectangle((l,t,r-1,b-1),fill=1)
+outside=Image.new('RGB',changes.size)
+outside.paste(changes,(0,0),ImageChops.invert(mask.convert('L')))
+assert outside.getbbox() is None, outside.getbbox()
+draft.save(work/'proposal-native.png',optimize=True)
+draft.resize((808,536), Image.Resampling.NEAREST).save(work/'proposal-review.png',optimize=True)
+for name,im in [('current',base),('proposal',draft)]:
+    im.resize((1212,804),Image.Resampling.NEAREST).save(work/f'{name}.webp',lossless=True,method=6)
+plan={
+    'status':'layout proposal for review',
+    'base':'Taichung Quest Boulevard native preview 21fd3d7a',
+    'crop':[44,60,145,127],
+    'sites':[
+        {'id':'market','name':'Sakura Evening Market','zh':'櫻花黃昏市場','block':market,'reference':'https://tcrt.taichung.gov.tw/df_ufiles/051/G8a%E5%9C%9F%E9%96%8B%E9%96%8B%E7%99%BC%E5%A4%A7%E6%A8%93%E7%95%8C%E9%9D%A2%E5%A0%B1%E5%91%8A%E6%9B%B8.pdf'},
+        {'id':'park','name':'Huimin Park','zh':'惠民公園','block':park,'reference':'https://www.xitun.taichung.gov.tw/2365142/post'},
+        {'id':'housing','name':'Xitun Civic Housing','zh':'西屯市政好宅','block':housing,'reference':'https://thd.taichung.gov.tw/981499/981508/981509/2101626/2101628/1366398'}
+    ],
+    'parkPaths':paths
+}
+(work/'placement-draft.json').write_text(json.dumps(plan,indent=2,ensure_ascii=False)+'\\n')
+print('Two views use', sum((work/f'{key}.webp').stat().st_size for key in ('current','proposal')), 'WebP bytes total.')
+print(work)
