+      report.targetArrivalFrame = last.frame;
+      report.firstMovementFrameRange = first.possibleEventFrame;
+      report.targetArrivalFrameRange = last.possibleEventFrame;
+      report.timedTileIntervals = tiles - 1;
+      report.observedNativeFrames = last.frame - first.frame;
+      report.nativeFrameRange = {
+        min: last.possibleEventFrame.min - first.possibleEventFrame.max,
+        max: last.possibleEventFrame.max - first.possibleEventFrame.min,
