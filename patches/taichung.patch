+        protectedGeneralMetatileIds=sorted(allowed_general), protectedBorrowedMetatileIds=sorted(borrowed_ids),
+        primaryAnimationCallback="InitTilesetAnim_General", doorScratch=[1016, 1024],
+        graphicsBudget=dict(primaryTotal=640, protectedPrimary=278, oldArtMovedToPrimary=350, cmpNewPrimary=12,
