+#!/usr/bin/env python3
+"""Fit the approved new landmarks to real tiles and count the tiles each one would add.
+
+Each set piece from the board's plan art (`setpieces.py`, transparent RGBA at 16 px per
+tile) is laid on its district's own ground metatile, then cut into 8x8 tiles. Every tile is
+fitted to the best of the map's 13 background palettes (primary 0-6, secondary 7-12) as
+they are today, and matched against the tiles both banks already hold, flips included.
+Tiles with no match are new; so are 16x16 cells that match no existing metatile.
+
+Writes, per landmark, the real-tile render (what the game could show with today's
+palettes and no new palette), a comparison sheet, and `landmark-tiles.json` with the
+budget: new tiles, new metatiles, palettes used and the colour error of the fit.
+
+  python3 tools/taichung/rework/landmark_tiles.py --output-dir DIR [--plan-dir DIR]
+
+Requires Pillow and NumPy. It writes no game data.
+"""
+
+import argparse
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import render_maps as native  # noqa: E402
+
+TILE = 16
+BANKS = {
+    "Old City": ("gTileset_TaichungOldCorePrimary", "gTileset_TaichungOldCore", 0x175),
+    "Greenway": ("gTileset_TaichungGreenwayPrivate", "gTileset_TaichungGreenwayCmp", 0x001),
+}
+# Landmark number -> (plan name, bank, file stem)
+LANDMARKS = {
+    13: ("Botanical Garden", "Greenway", "13-botanical-garden"),
+    14: ("Taichung Confucius Temple", "Old City", "14-taichung-confucius-temple"),
+    15: ("Yizhong Street", "Old City", "15-yizhong-street"),
+    16: ("Taichung Prefectural Hall", "Old City", "16-taichung-prefectural-hall"),
+    17: ("Second Market", "Old City", "17-second-market"),
+}
+
+
+class Bank:
+    """A primary and secondary pair as the map loads them."""
+
+    def __init__(self, source, primary, secondary, ground):
+        sets = [native.tileset_paths(source, name) for name in (primary, secondary)]
+        self.palettes = []
+        for p in range(13):
+            folder = sets[0 if p < 7 else 1]["palettes"]
+            lines = (folder / f"{p:02}.pal").read_text().splitlines()[3:]
+            self.palettes.append(np.array([list(map(int, l.split())) for l in lines if l.strip()][:16], dtype=np.int32))
+        self.known = set()
+        self.tile_counts = []
+        for s in sets:
+            image = Image.open(s["tiles"])
+            pixels = np.array(image, dtype=np.uint8)
+            count = (image.width // 8) * (image.height // 8)
+            self.tile_counts.append(count)
+            for n in range(count):
+                tx, ty = n % (image.width // 8), n // (image.width // 8)
+                self.known.add(canonical(pixels[ty * 8:ty * 8 + 8, tx * 8:tx * 8 + 8]))
+        metatiles = native.render_metatiles(source, primary, secondary)
+        self.metatiles = {m.tobytes() for m in metatiles}
+        self.ground = metatiles[ground]
+        self.definitions = [len(native.words(s["metatiles"])) // 8 for s in sets]
+
+    def fit(self, block):
+        """Best palette for an 8x8 RGB block: (palette, indices, squared error)."""
+        flat = block.reshape(-1, 3).astype(np.int32)
+        best = None
+        for p, pal in enumerate(self.palettes):
+            dist = ((flat[:, None, :] - pal[None, :, :]) ** 2).sum(axis=2)
+            idx = dist.argmin(axis=1)
+            err = int(dist[np.arange(64), idx].sum())
+            if best is None or err < best[2]:
+                best = (p, idx.reshape(8, 8).astype(np.uint8), err)
+        return best
+
+
+def canonical(a):
+    return min(a.tobytes(), a[:, ::-1].tobytes(), a[::-1, :].tobytes(), a[::-1, ::-1].tobytes())
+
+
+def load_setpieces(plan_dir):
+    spec = importlib.util.spec_from_file_location("setpieces", plan_dir / "landmarks" / "setpieces.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.SETPIECES
+
+
+def fit_landmark(bank, art):
+    """Lay the art on the bank's ground, fit every tile, and count what is new."""
+    w, h = art.width // TILE, art.height // TILE
+    ground = Image.new("RGBA", art.size)
+    for y in range(h):
+        for x in range(w):
+            ground.paste(bank.ground, (x * TILE, y * TILE))
+    target = np.array(Image.alpha_composite(ground, art).convert("RGB"), dtype=np.int32)
+    out = np.zeros_like(target)
+    new_tiles, reused, palettes, errors = set(), 0, set(), []
+    for ty in range(h * 2):
+        for tx in range(w * 2):
+            block = target[ty * 8:ty * 8 + 8, tx * 8:tx * 8 + 8]
+            p, idx, err = bank.fit(block)
+            out[ty * 8:ty * 8 + 8, tx * 8:tx * 8 + 8] = bank.palettes[p][idx]
+            key = canonical(idx)
+            if key in bank.known:
+                reused += 1
+            else:
+                new_tiles.add(key)
+                palettes.add(p)
+            errors.append((err / 64) ** 0.5)
+    render = Image.fromarray(out.astype(np.uint8), "RGB")
+    cells, new_cells = set(), set()
+    for y in range(h):
+        for x in range(w):
+            cell = render.crop((x * TILE, y * TILE, x * TILE + TILE, y * TILE + TILE)).tobytes()
+            cells.add(cell)
+            if cell not in bank.metatiles:
+                new_cells.add(cell)
+    errors = np.array(errors)
+    return render, {
+        "sizeTiles": [w, h],
+        "tiles8": w * h * 4,
+        "newTiles": len(new_tiles),
+        "reusedTiles": reused,
+        "newMetatiles": len(new_cells),
+        "palettesForNewTiles": sorted(palettes),
+        "rmsColourError": round(float(errors.mean()), 1),
+        "tilesWithVisibleError": int((errors > 24).sum()),
+    }, new_tiles
+
+
+def font(size):
+    for name in ("/System/Library/Fonts/Supplemental/Arial Bold.ttf", "DejaVuSans.ttf"):
+        try:
+            return ImageFont.truetype(name, size)
+        except OSError:
+            pass
+    return ImageFont.load_default()
+
+
+def sheet(rows):
+    """Plan art beside its real-tile fit, one landmark per row, at 2x."""
+    s = 2
+    width = max(a.width + b.width for _, a, b, _ in rows) * s + 420
+    height = sum(max(a.height, b.height) * s + 56 for _, a, b, _ in rows) + 70
+    out = Image.new("RGB", (width, height), "#f4f5f2")
+    d = ImageDraw.Draw(out)
+    d.text((16, 14), "New landmarks: plan art (left) and fitted to today's palettes as real tiles (right)", font=font(20), fill="#1e1e1e")
+    y = 60
+    for title, plan, real, stats in rows:
+        d.text((16, y), title, font=font(16), fill="#1e1e1e")
+        out.paste(plan.resize((plan.width * s, plan.height * s), Image.NEAREST), (16, y + 24))
+        out.paste(real.resize((real.width * s, real.height * s), Image.NEAREST), (32 + plan.width * s, y + 24))
+        tx = 48 + (plan.width + real.width) * s
+        lines = [f"{stats['bank']} bank", f"new 8x8 tiles: {stats['newTiles']}", f"new metatiles: {stats['newMetatiles']}",
+                 f"reused tiles: {stats['reusedTiles']} of {stats['tiles8']}",
+                 f"palettes: {', '.join(map(str, stats['palettesForNewTiles'])) or '-'}",
+                 f"colour error: {stats['rmsColourError']} (visible in {stats['tilesWithVisibleError']} tiles)"]
+        for i, line in enumerate(lines):
+            d.text((tx, y + 28 + i * 20), line, font=font(13), fill="#1e1e1e")
+        y += max(plan.height, real.height) * s + 56
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[3])
+    parser.add_argument("--plan-dir", type=Path, default=Path("/Users/peter/devday_hackathon/artifacts/city-rework"))
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    out = args.output_dir
+    out.mkdir(parents=True, exist_ok=True)
+    plan = json.loads((args.plan_dir / "masterplan.json").read_text())
+    rects = {l["n"]: l["rect"] for l in plan["newLandmarks"]}
+    pieces = load_setpieces(args.plan_dir)
+    banks = {name: Bank(args.source, *spec) for name, spec in BANKS.items()}
+    result, rows, per_bank = {}, [], {}
+    for n, (name, bank_name, stem) in LANDMARKS.items():
+        x0, y0, x1, y1 = rects[n]
+        art = pieces[name](x1 - x0, y1 - y0)
+        render, stats, new = fit_landmark(banks[bank_name], art)
+        stats.update({"name": name, "bank": bank_name, "rect": rects[n]})
+        render.save(out / f"{stem}-tiles.png")
+        result[n] = stats
+        per_bank.setdefault(bank_name, set()).update(new)
+        plan_view = Image.alpha_composite(Image.new("RGBA", art.size, (234, 223, 196, 255)), art).convert("RGB")
+        rows.append((f"{n} {name}", plan_view, render, stats))
+    totals = {b: {"newTilesShared": len(keys), "primaryTiles": banks[b].tile_counts[0], "secondaryTiles": banks[b].tile_counts[1],
+                  "secondaryDefinitions": banks[b].definitions[1]} for b, keys in per_bank.items()}
+    sheet(rows).save(out / "landmark-tiles.png")
+    (out / "landmark-tiles.json").write_text(json.dumps({"landmarks": result, "banks": totals}, indent=1) + "\n")
+    for n, s in result.items():
+        print(n, s["name"], s["bank"], "new tiles", s["newTiles"], "new metatiles", s["newMetatiles"],
+              "palettes", s["palettesForNewTiles"], "err", s["rmsColourError"], "visible", s["tilesWithVisibleError"])
+    print(json.dumps(totals))
+
+
+if __name__ == "__main__":
+    main()
