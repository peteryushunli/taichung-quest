@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Check Station source identity, palette/VRAM limits and reproducible encoding."""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import tempfile
+
+from PIL import Image, ImageChops
+
+from compile_station import ROOT, OUTPUT, INPUT, ORIGIN, SIZE, values, compile_bank
+
+
+def main():
+    spec = importlib.util.spec_from_file_location("native_render", ROOT / "tools/taichung/render_maps.py")
+    renderer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(renderer)
+    manifest = json.loads((OUTPUT / "compile-manifest.json").read_text())
+    original = renderer.render_metatiles(ROOT, "General", "PewterCity")
+    packed = renderer.render_metatiles(ROOT, "General", "TaichungOldCity")
+    for tile in manifest["preservedSourceMetatiles"]:
+        assert ImageChops.difference(original[tile], packed[tile]).getbbox() is None, hex(tile)
+    native = Image.open(OUTPUT / "tiles.png")
+    physical_count = native.width * native.height // 64
+    assert physical_count <= 384 and native.mode == "P" and native.getextrema()[1] <= 15
+    entries = values(OUTPUT / "metatiles.bin", "H")
+    assert len(entries) // 8 <= 384
+    assert all((w & 1023) < min(1016, 640 + physical_count) and w >> 12 < 13 for w in entries)
+    attrs = values(OUTPUT / "metatile_attributes.bin", "I")
+    source_attrs = values(ROOT / "data/tilesets/secondary/pewter_city/metatile_attributes.bin", "I")
+    assert all(attrs[t-640] == source_attrs[t-640] for t in manifest["preservedSourceMetatiles"])
+    baseline = json.loads(INPUT.with_name("native-source-contract.json").read_text())
+    current = values(ROOT / "data/layouts/TaichungOldCity/map.bin", "H")
+    outside = [i for i in range(len(current)) if not
+               (ORIGIN[0] <= i%40 < ORIGIN[0]+SIZE[0] and ORIGIN[1] <= i//40 < ORIGIN[1]+SIZE[1])]
+    assert len(outside) == baseline["mapCellsOutsideEnvelope"]
+    digest = hashlib.sha256(struct.pack(f"<{len(outside)}H", *(current[i] for i in outside))).hexdigest()
+    assert digest == baseline["outsideEnvelopeWordsSha256"]
+    assert all(current[a["y"]*40+a["x"]] == a["word"] for a in baseline["preservedAnchors"])
+    with tempfile.TemporaryDirectory(prefix="taichung-station-") as temp:
+        out = Path(temp)
+        again, _ = compile_bank(out)
+        assert again == manifest
+        generated = sorted(p.relative_to(out) for p in out.rglob("*") if p.is_file())
+        assert all((OUTPUT / p).read_bytes() == (out / p).read_bytes() for p in generated)
+    raw = (OUTPUT / "tiles.4bpp").read_bytes()
+    decoded = [v for b in raw for v in (b & 15, b >> 4)]
+    expected = [native.getpixel((n%16*8+x, n//16*8+y))
+                for n in range(physical_count) for y in range(8) for x in range(8)]
+    assert decoded == expected
+    lines = (OUTPUT / "palettes/07.pal").read_text().splitlines()[3:]
+    colors = [tuple(map(int, line.split())) for line in lines if line.strip()]
+    assert len(colors) == 16 and all(0 <= c <= 248 and c%8 == 0 for rgb in colors for c in rgb)
+    native_colors = values(OUTPUT / "palettes/07.gbapal", "H")
+    assert native_colors == [r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors]
+    print(json.dumps({"result": "pass", "preservedSourceMetatilesCompared": len(manifest["preservedSourceMetatiles"]),
+                      "mapCellsOutsideFootprintUnchanged": len(outside), "graphicsBudget": manifest["graphics"],
+                      "loadedGraphicsIncludingPadding": physical_count, "native4bppPixelsRoundtripped": len(decoded),
+                      "reproducibleSourceFiles": len(generated), "paletteColorsBgr555Roundtripped": 16,
+                      "inputSha256": hashlib.sha256(INPUT.read_bytes()).hexdigest(),
+                      "scope": "Source/format checks; running door, return and layering need emulator validation."}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung/landmarks/compile_station.py b/tools/taichung/landmarks/compile_station.py
new file mode 100644
index 0000000..4f7df66
--- /dev/null
+++ b/tools/taichung/landmarks/compile_station.py
@@ -0,0 +1,175 @@
+#!/usr/bin/env python3
+"""Pack the approved Station into a native secondary bank, preserving source IDs.
+
+The input is the reviewed 192x128, 15-color indexed raster. This is a mechanical
+GBA conversion, not an image generator. Original General/Pewter assets stay intact.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+INPUT = ROOT / "data/taichung/landmarks/old-station/native.png"
+OUTPUT = ROOT / "data/tilesets/secondary/taichung_old_city"
+PRIMARY = ROOT / "data/tilesets/primary/general"
+SECONDARY = ROOT / "data/tilesets/secondary/pewter_city"
+ORIGIN, SIZE, DOOR = (26, 57), (12, 8), (32, 64)
+
+
+def values(path, kind):
+    data = path.read_bytes()
+    return list(struct.unpack(f"<{len(data) // struct.calcsize(kind)}{kind}", data))
+
+
+def save_values(path, items, kind):
+    path.write_bytes(struct.pack(f"<{len(items)}{kind}", *items))
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+class Bank:
+    def __init__(self):
+        self.graphics, self.lookup = [], {}
+
+    def pack(self, pixels):
+        canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xc00))
+        if canonical not in self.lookup:
+            self.lookup[canonical] = len(self.graphics)
+            self.graphics.append(canonical)
+        return (640 + self.lookup[canonical]) | flags
+
+
+def pixels(image, tile):
+    x, y = tile % (image.width // 8) * 8, tile // (image.width // 8) * 8
+    return tuple(image.getpixel((x+dx, y+dy)) for dy in range(8) for dx in range(8))
+
+
+def compile_bank(output=OUTPUT):
+    art = Image.open(INPUT)
+    if art.mode != "P" or art.size != (192, 128) or art.getextrema()[1] > 15:
+        raise ValueError("Station must be a 192x128 indexed 4bpp source")
+    if art.info.get("transparency") != 0:
+        raise ValueError("Station palette index zero must be transparent")
+    source_image = Image.open(SECONDARY / "tiles.png")
+    source_metatiles = values(SECONDARY / "metatiles.bin", "H")
+    source_attrs = values(SECONDARY / "metatile_attributes.bin", "I")
+    source_count = len(source_attrs)
+    catalog = json.loads((ROOT / "data/taichung/prefabs/catalog.json").read_text())
+    needed = {int(word, 0) & 1023 for p in catalog["prefabs"] for row in p["words"] for word in row}
+    # Keep the original map's required IDs on repeat builds after its placeholder
+    # facade has been replaced. The bank remains safe for existing source cells.
+    baseline = json.loads(INPUT.with_name("native-source-contract.json").read_text())
+    needed.update(baseline["preservedSourceMetatiles"])
+    map_words = values(ROOT / "data/layouts/TaichungOldCity/map.bin", "H")
+    needed |= {w & 1023 for w in map_words if (w & 1023) < 640 + source_count}
+    needed |= {w & 1023 for w in values(ROOT / "data/layouts/TaichungOldCity/border.bin", "H")}
+    bank = Bank()
+    entries, attrs = [0] * len(source_metatiles), [0] * source_count
+    source_graphics = set()
+    for tile in sorted(t for t in needed if t >= 640):
+        offset = (tile - 640) * 8
+        for i, word in enumerate(source_metatiles[offset:offset+8]):
+            graphic = word & 1023
+            if graphic >= 640:
+                source_graphics.add(graphic)
+                packed = bank.pack(pixels(source_image, graphic - 640))
+                word = (word & 0xf000) | ((word & 0xc00) ^ (packed & 0xc00)) | (packed & 1023)
+            entries[offset+i] = word
+        attrs[tile - 640] = source_attrs[tile - 640]
+    source_used = len(bank.graphics)
+    primary = values(PRIMARY / "metatiles.bin", "H")
+    grass = primary[8:12]
+    first = 640 + len(attrs)
+    cells, blocked = [], []
+    for y in range(SIZE[1]):
+        mask = ""
+        for x in range(SIZE[0]):
+            tile = 640 + len(attrs)
+            top = [bank.pack(pixels(art, (y*2+dy)*24 + x*2+dx)) | 0x7000
+                   for dy in range(2) for dx in range(2)]
+            entries.extend(grass + top)
+            # The facade's lowest row belongs behind a player standing in
+            # front. Upper roof/tower rows stay on the covering layer.
+            attrs.append(0x20000000 if y == SIZE[1]-1 else 0)
+            occupied = any(art.getpixel((x*16+dx, y*16+dy)) for dy in range(16) for dx in range(16))
+            cells.append((tile | 0x400) if occupied else 0x3001)
+            mask += "1" if occupied else "0"
+        blocked.append(mask)
+    # field_door.c overwrites graphics1016..1023 during door animation.
+    if len(bank.graphics) > 376 or len(attrs) > 384:
+        raise ValueError("Native secondary bank capacity exceeded")
+    output.mkdir(parents=True, exist_ok=True)
+    image = Image.new("P", (128, ((len(bank.graphics)+15)//16)*8))
+    image.putpalette(art.getpalette())
+    for n, data in enumerate(bank.graphics):
+        for y in range(8):
+            for x in range(8):
+                image.putpixel((n%16*8+x, n//16*8+y), data[y*8+x])
+    image.save(output / "tiles.png")
+    save_values(output / "metatiles.bin", entries, "H")
+    save_values(output / "metatile_attributes.bin", attrs, "I")
+    palettes = output / "palettes"
+    palettes.mkdir(exist_ok=True)
+    for n in range(16):
+        text = (SECONDARY / "palettes" / f"{n:02}.pal").read_text()
+        if n == 7:
+            raw = art.getpalette()[:48]
+            text = "JASC-PAL\n0100\n16\n" + "\n".join(" ".join(map(str, raw[i:i+3])) for i in range(0, 48, 3)) + "\n"
+        # This repository checks JASC palettes out with CRLF (.gitattributes).
+        # Match that representation so byte-for-byte regeneration survives Git.
+        (palettes / f"{n:02}.pal").write_bytes(text.replace("\r\n", "\n").replace("\n", "\r\n").encode())
+    manifest = {
+        "schemaVersion": 1, "assetId": "landmark-old-taichung-station-v1",
+        "status": "native-encoded bank; runtime validation tracked separately",
+        "input": str(INPUT.relative_to(ROOT)), "inputSha256": hashlib.sha256(INPUT.read_bytes()).hexdigest(),
+        "graphics": {"sourceGraphicsBeforeDedup": len(source_graphics), "sourceGraphicsAfterDedup": source_used,
+                     "stationGraphicsAdded": len(bank.graphics)-source_used, "secondaryTotal": len(bank.graphics),
+                     "secondaryCapacity": 384, "sceneGraphicsCapacity": 376,
+                     "doorAnimationScratchSlots": 8, "doorAnimationScratchGlobalRange": [1016, 1024],
+                     "spare": 376-len(bank.graphics),
+                     "loadedIncludingSheetPadding": image.width*image.height//64,
+                     "availableAfterPaddingAndDoorScratch": max(0, 376-image.width*image.height//64)},
+        "metatiles": {"preservedSourceIdCount": source_count, "firstStationId": first,
+                      "stationCount": 96, "secondaryTotal": len(attrs)},
+        "palettes": {"station": 7, "sharedAccentReserved": 12, "sourcePreserved": [8, 9, 10, 11]},
+        "placement": {"origin": list(ORIGIN), "size": list(SIZE), "door": list(DOOR),
+                      "doorMetatile": "0x03D", "doorBehavior": "MB_WARP_DOOR", "blockedRows": blocked,
+                      "frontFacadeLayerType": "COVERED; player renders in front", "roofLayerType": "NORMAL; covers player behind"},
+        "preservedSourceMetatiles": sorted(t for t in needed if t >= 640),
+    }
+    (output / "compile-manifest.json").write_text(json.dumps(manifest, indent=2)+"\n")
+    return manifest, cells
+
+
+def install(cells):
+    path = ROOT / "data/layouts/TaichungOldCity/map.bin"
+    words = values(path, "H")
+    for y in range(SIZE[1]):
+        for x in range(SIZE[0]):
+            words[(ORIGIN[1]+y)*40+ORIGIN[0]+x] = cells[y*SIZE[0]+x]
+    words[DOOR[1]*40+DOOR[0]] = 0x043d
+    save_values(path, words, "H")
+    path = ROOT / "data/layouts/layouts.json"
+    layouts = json.loads(path.read_text())
+    layout = next(x for x in layouts["layouts"] if x.get("id") == "LAYOUT_TAICHUNG_OLD_CITY")
+    layout["secondary_tileset"] = "gTileset_TaichungOldCity"
+    path.write_text(json.dumps(layouts, indent=2)+"\n")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    parser.add_argument("--install", action="store_true", help="Apply only Station cells and the OldCity bank label")
+    args = parser.parse_args()
+    result, cells = compile_bank(args.output)
+    if args.install:
+        install(cells)
+    print(json.dumps(result["graphics"], indent=2))
diff --git a/tools/taichung/qa.html b/tools/taichung/qa.html
new file mode 100644
index 0000000..13a900e
--- /dev/null
+++ b/tools/taichung/qa.html
@@ -0,0 +1,253 @@
+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Taichung native map QA</title>
+<style>
+  :root { color-scheme: dark; font: 15px system-ui, sans-serif; background: #172223; color: #e8f0ed; }
+  body { max-width: 950px; margin: 12px auto; padding: 0 20px; }
+  h1 { font-size: 22px; margin: 8px 0; }
+  p { margin: 8px 0; }
+  canvas { width: 480px; max-width: 100%; height: auto; image-rendering: pixelated; background: #000; display: block; margin: 8px 0; }
+  button, input { font: inherit; padding: 8px 12px; margin: 3px; }
+  button { cursor: pointer; }
+  button:disabled { cursor: default; opacity: .5; }
+  input[type=number] { width: 85px; }
+  pre { white-space: pre-wrap; background: #0b1516; padding: 12px; min-height: 24px; }
+  .controls { display: flex; flex-wrap: wrap; gap: 4px; margin: 12px 0; }
+  label { display: inline-block; margin-right: 12px; }
+</style>
+<h1>Taichung native map QA</h1>
+<p>Isolated feature ROM and fresh save. Use the in-game Save menu before reading the saved location.</p>
+<button id="load">Load cartridge</button>
+<label><input id="mute" type="checkbox" checked>mute audio</label>
+<span id="timing">Timing not started.</span>
+<p id="status" role="status">Ready to load.</p>
+<canvas id="screen" width="240" height="160" aria-label="Native Game Boy Advance game screen"></canvas>
+<label>hold ms <input id="hold-ms" type="number" value="300" min="16" max="10000" step="10"></label>
+<label>repeat count <input id="repeat-count" type="number" value="1" min="1" max="50"></label>
+<div class="controls" id="keys">
+  <button data-key="Up" disabled>up</button>
+  <button data-key="Down" disabled>down</button>
+  <button data-key="Left" disabled>left</button>
+  <button data-key="Right" disabled>right</button>
+  <button data-key="A" disabled>a</button>
+  <button data-key="B" disabled>b</button>
+  <button data-key="Start" disabled>start</button>
+  <button data-key="Select" disabled>select</button>
+</div>
+<pre id="last-action" aria-live="polite">No input sent.</pre>
+<button id="read-location" disabled>Read saved location</button>
+<button id="reset" disabled>Reset cartridge (keep save)</button>
+<button id="download-screen" disabled>Download screen</button>
+<button id="download-save" disabled>Download save</button>
+<pre id="location">No saved location read.</pre>
+<script type="module">
+  import createMgba from '/mgba.js';
+
+  const byId = id => document.getElementById(id);
+  const canvas = byId('screen');
+  const originalGetContext = canvas.getContext.bind(canvas);
+  // The bundled runtime calls canvas.getContext('webgl2', attributes) and does
+  // not request preservation. Set it before the first context is created so a
+  // PNG capture can read the displayed frame after the browser has presented it.
+  canvas.getContext = (type, attributes) => originalGetContext(type,
+    ['webgl', 'webgl2', 'experimental-webgl'].includes(type)
+      ? { ...attributes, preserveDrawingBuffer: true }
+      : attributes);
+  const status = message => { byId('status').textContent = message; };
+  const keyButtons = [...document.querySelectorAll('[data-key]')];
+  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+  let emulator;
+  let busy = false;
+  let saveDescription = '';
+
+  function configureTiming() {
+    // Local mGBA declarations link to this API, and the bundled implementation
+    // confirms mode 0 = setTimeout with value in milliseconds:
+    // https://emscripten.org/docs/api_reference/emscripten.h.html#c.emscripten_set_main_loop_timing
+    // Timers can still be throttled in a hidden tab; this avoids depending on RAF.
+    emulator.setMainLoopTiming(0, 16);
+    byId('timing').textContent = `Timing: mode ${emulator.getMainLoopTimingMode()}, value ${emulator.getMainLoopTimingValue()} (0 = timer ms).`;
+  }
+
+  function download(bytes, type, filename) {
+    const url = URL.createObjectURL(new Blob([bytes], { type }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = filename;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 30000);
+  }
+
+  byId('load').addEventListener('click', async () => {
+    byId('load').disabled = true;
+    status('Loading isolated cartridge…');
+    try {
+      if (!crossOriginIsolated || typeof SharedArrayBuffer === 'undefined') {
+        throw new Error('This tab needs COOP/COEP headers and SharedArrayBuffer.');
+      }
+      const response = await fetch('/mapping.gba', { cache: 'no-store' });
+      if (!response.ok) throw new Error(`ROM request failed: ${response.status}`);
+      const rom = new Uint8Array(await response.arrayBuffer());
+      emulator = await createMgba({ canvas });
+      await emulator.FSInit();
+      emulator.setCoreSettings({
+        autoSaveStateEnable: false,
+        restoreAutoSaveStateOnLoad: false,
+        rewindEnable: false,
+        allowOpposingDirections: false,
+      });
+      emulator.addCoreCallbacks({ coreCrashedCallback: () => status('Emulator reported a core crash.') });
+      const requestedToken = new URLSearchParams(location.search).get('qaSave');
+      if (requestedToken !== null && !/^[A-Za-z0-9_-]{1,100}$/.test(requestedToken)) {
+        throw new Error('qaSave must contain 1–100 letters, numbers, hyphens or underscores.');
+      }
+      const token = requestedToken ?? crypto.randomUUID();
+      const romPath = `${emulator.filePaths().gamePath}/mapping-qa-${token}.gba`;
+      const savePath = `${emulator.filePaths().savePath}/mapping-qa-${token}.sav`;
+      const saveExisted = emulator.FS.analyzePath(savePath).exists;
+      saveDescription = requestedToken === null ? `Fresh unique save ${token}.`
+        : saveExisted ? `Reusing named save ${token}; persisted file found.`
+        : `Named save ${token}; no persisted file found, starting fresh.`;
+      emulator.FS.writeFile(romPath, rom);
+      if (!emulator.loadGame(romPath, savePath)) throw new Error('mGBA could not open the cartridge.');
+      emulator.toggleInput(false);
+      configureTiming();
+      emulator.setVolume(byId('mute').checked ? 0 : 0.5);
+      if (!byId('mute').checked) {
+        emulator.resumeAudio();
+        await emulator.SDL2?.audioContext?.resume();
+      }
+      keyButtons.forEach(button => { button.disabled = false; });
+      byId('read-location').disabled = false;
+      for (const id of ['reset', 'download-screen', 'download-save']) byId(id).disabled = false;
+      status(`Running feature cartridge (${rom.length.toLocaleString()} bytes). ${saveDescription}`);
+    } catch (error) {
+      status(`Load failed: ${error.message}`);
+      byId('load').disabled = false;
+    }
+  });
+
+  byId('mute').addEventListener('change', async () => {
+    if (!emulator) return;
+    emulator.setVolume(byId('mute').checked ? 0 : 0.5);
+    if (!byId('mute').checked) {
+      emulator.resumeAudio();
+      await emulator.SDL2?.audioContext?.resume();
+    }
+  });
+
+  for (const button of keyButtons) {
+    button.addEventListener('click', async () => {
+      if (!emulator || busy) return;
+      busy = true;
+      keyButtons.forEach(b => { b.disabled = true; });
+      const key = button.dataset.key;
+      const hold = Math.max(16, Math.min(10000, Number(byId('hold-ms').value) || 300));
+      const repeat = Math.max(1, Math.min(50, Math.floor(Number(byId('repeat-count').value) || 1)));
+      byId('last-action').textContent = `Sending ${key}, ${hold} ms, ${repeat} time(s)…`;
+      try {
+        for (let i = 0; i < repeat; i++) {
+          emulator.buttonPress(key);
+          await wait(hold);
+          emulator.buttonUnpress(key);
+          if (i + 1 < repeat) await wait(100);
+        }
+        byId('last-action').textContent = `Sent ${key}, ${hold} ms, ${repeat} time(s).`;
+      } catch (error) {
+        byId('last-action').textContent = `Input failed: ${error.message}`;
+      } finally {
+        emulator.buttonUnpress(key);
+        busy = false;
+        keyButtons.forEach(b => { b.disabled = false; });
+      }
+    });
+  }
+
+  byId('reset').addEventListener('click', async () => {
+    if (!emulator || busy) return;
+    busy = true;
+    byId('reset').disabled = true;
+    keyButtons.forEach(button => { button.disabled = true; });
+    try {
+      await emulator.FSSync();
+      emulator.quickReload();
+      configureTiming();
+      status(`Cartridge reset. Native save retained; choose Continue to verify it. ${saveDescription}`);
+    } catch (error) {
+      status(`Reset failed: ${error.message}`);
+    } finally {
+      busy = false;
+      byId('reset').disabled = false;
+      keyButtons.forEach(button => { button.disabled = false; });
+    }
+  });
+
+  byId('download-screen').addEventListener('click', async () => {
+    try {
+      const filename = `taichung-map-qa-${Date.now()}.png`;
+      // Capture the actual displayed native-ROM canvas. This runtime's separate
+      // screenshot API returned an all-black file during QA, so do not use it as
+      // evidence. Copy unchanged pixels into a 2D canvas and reject blank frames.
+      const frame = document.createElement('canvas');
+      frame.width = canvas.width;
+      frame.height = canvas.height;
+      const context = frame.getContext('2d', { willReadFrequently: true });
+      context.drawImage(canvas, 0, 0);
+      const pixels = context.getImageData(0, 0, frame.width, frame.height).data;
+      let nonBlackPixels = 0;
+      for (let i = 0; i < pixels.length; i += 4) {
+        if (pixels[i] || pixels[i + 1] || pixels[i + 2]) nonBlackPixels++;
+      }
+      if (!nonBlackPixels) throw new Error('Captured frame is entirely black. Reload this updated QA page, load the cartridge, and retry after the game is visible.');
+      const blob = await new Promise(resolve => frame.toBlob(resolve, 'image/png'));
+      if (!blob) throw new Error('Could not encode the game canvas.');
+      download(blob, 'image/png', filename);
+      byId('last-action').textContent = `Downloaded ${filename}; ${frame.width}×${frame.height}, ${nonBlackPixels} non-black pixels from the native game canvas.`;
+    } catch (error) {
+      byId('last-action').textContent = `Screen download failed: ${error.message}`;
+    }
+  });
+
+  byId('download-save').addEventListener('click', () => {
+    try {
+      const bytes = emulator.getSave();
+      if (!bytes) throw new Error('Save through the game menu first.');
+      const filename = `taichung-map-qa-${Date.now()}.sav`;
+      download(bytes, 'application/octet-stream', filename);
+      byId('last-action').textContent = `Downloaded ${filename} (${bytes.length} bytes).`;
+    } catch (error) {
+      byId('last-action').textContent = `Save download failed: ${error.message}`;
+    }
+  });
+
+  byId('read-location').addEventListener('click', () => {
+    try {
+      const bytes = emulator?.getSave();
+      if (!bytes) throw new Error('No save exists yet. Save through the game menu first.');
+      const data = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+      const sectors = [];
+      for (let offset = 0; offset + 0x1000 <= bytes.length; offset += 0x1000) {
+        if (data.getUint16(offset + 0xFF4, true) === 1 && data.getUint32(offset + 0xFF8, true) === 0x08012025) {
+          sectors.push({ offset, counter: data.getUint32(offset + 0xFFC, true) });
+        }
+      }
+      if (!sectors.length) throw new Error('No valid SaveBlock1 sector found. Finish saving in the game first.');
+      sectors.sort((a, b) => b.counter - a.counter);
+      const { offset, counter } = sectors[0];
+      byId('location').textContent = JSON.stringify({
+        saveCounter: counter,
+        x: data.getInt16(offset, true),
+        y: data.getInt16(offset + 2, true),
+        mapGroup: data.getUint8(offset + 4),
+        mapNumber: data.getUint8(offset + 5),
+        partyCount: data.getUint8(offset + 0x34),
+        saveBytes: bytes.length,
+      }, null, 2);
+    } catch (error) {
+      byId('location').textContent = error.message;
+    }
+  });
+</script>
+</html>
