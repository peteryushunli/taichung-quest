new file mode 100644
index 0000000..bfd0ff3
--- /dev/null
+++ b/src/taichung_landmark_history.c
@@ -0,0 +1,73 @@
+#include "global.h"
+#include "event_data.h"
+#include "string_util.h"
+#include "taichung_gym_progress.h"
+#include "taichung_landmark_history.h"
+#include "taichung_language.h"
+
+const u8 gTaichungHistoryChallengeEn[] = _("Challenge");
+const u8 gTaichungHistoryChallengeZh[] = _("挑戰");
+const u8 gTaichungHistoryLeaveEn[] = _("Leave");
+const u8 gTaichungHistoryLeaveZh[] = _("離開");
+
+static const u8 sUnavailableEn[] = _("No history is available here.");
+static const u8 sUnavailableZh[] = _("沒有地標故事。");
+
+static bool8 HasFacts(u16 gymId)
+{
+    return gymId < TAICHUNG_LANDMARK_HISTORY_COUNT
+        && gTaichungLandmarkHistory[gymId].sign[0] != NULL
+        && gTaichungLandmarkHistory[gymId].sign[1] != NULL
+        && gTaichungLandmarkHistory[gymId].tour[0] != NULL
+        && gTaichungLandmarkHistory[gymId].tour[1] != NULL;
+}
+
+// Muqing's gym (save bit 8) moved into Wanhe Temple, whose host beside her
+// already tells the temple's story, and Maple Garden's own story stays with its
+// guide there. Only her challenge asks for gym 8's tour, so it has none.
+static bool8 HasLeaderTour(u16 gymId)
+{
+    return HasFacts(gymId) && gymId != TAICHUNG_GYM_MAPLE_GARDEN;
+}
+
+void TaichungHistory_ScriptHasFacts(void)
+{
+    gSpecialVar_Result = HasLeaderTour(gSpecialVar_0x8004);
+}
+
+static void BufferHistory(bool8 tour)
+{
+    u16 gymId = gSpecialVar_0x8004;
+    const u8 *text;
+    if (!HasFacts(gymId))
+        text = TaichungText(sUnavailableEn, sUnavailableZh);
+    else if (tour)
+        text = TaichungText(gTaichungLandmarkHistory[gymId].tour[0], gTaichungLandmarkHistory[gymId].tour[1]);
+    else
+        text = TaichungText(gTaichungLandmarkHistory[gymId].sign[0], gTaichungLandmarkHistory[gymId].sign[1]);
+    StringCopy(gStringVar4, text);
+}
+
+void TaichungHistory_ScriptBufferSign(void)
+{
+    BufferHistory(FALSE);
+}
+
+void TaichungHistory_ScriptBufferTour(void)
+{
+    BufferHistory(TRUE);
+}
+
+const u8 *TaichungHistory_GetStaffText(u16 historyId)
+{
+    if (historyId >= TAICHUNG_LANDMARK_HISTORY_COUNT
+        || gTaichungLandmarkHistory[historyId].staff[0] == NULL
+        || gTaichungLandmarkHistory[historyId].staff[1] == NULL)
+        return TaichungText(sUnavailableEn, sUnavailableZh);
+    return TaichungText(gTaichungLandmarkHistory[historyId].staff[0], gTaichungLandmarkHistory[historyId].staff[1]);
+}
+
+void TaichungHistory_ScriptBufferStaff(void)
+{
+    StringCopy(gStringVar4, TaichungHistory_GetStaffText(gSpecialVar_0x8004));
+}
