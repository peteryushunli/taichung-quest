@@ -0,0 +1,913 @@
+#!/usr/bin/env python3
+"""Build Nantun North (45x40) and Wanhe (85x72) on the city-rework master plan.
+
+Phase 2b of the city rework, on the fill pass the user approved on 2026-11-09 with that day's
+raised freeway and one-street canal (master plan c23c806f): the freeway's retaining wall at
+cols 1-2, homes backing onto it, every street that meets no other street stopping at a kerb,
+and a railed walk on the canal's west bank where Wanhe Rd ran (a sidewalk off the street grid).
+rework_layout.py places it from the plan's cell file and art; this paints it in native words:
+  - streets, water and the west highway with the city kit in the primaries, by the kit's rules
+    (docs/city-kit.md), with crosswalks where a park path crosses a street, a path bridge
+    where the riverside path crosses the canal, and a kerb's sidewalk across a dead end;
+  - the freeway's retaining wall, kerb bollards and waterside railings with the kit's pieces
+    (city-kit cb2214e): the wall's top runs on over the river as the bridge's side;
+  - every other cell with the metatile plan.png draws there, read off the art by matching each
+    cell against today's Nantun bank over the installed primary, and the collision today's
+    maps give that metatile;
+  - landmarks 18-20 as new metatiles: landmark_art.py's tiles on a ground bottom layer.
+Both Nantun banks are reclaimed from SOURCE: definitions neither map uses are cleared (the old
+3-wide edge kit among them), and the set pieces take the lowest free slots. North's bank is a
+copy of Wanhe's, so the North-Wanhe seam draws the same from either side.
+
+Save migration, heal and fly spots, the minimap and the city guide belong to integration.
+
+  python3 tools/taichung/nantun/build_rework.py          # write + print the report
+  python3 tools/taichung/nantun/build_rework.py --check  # rebuild in memory, exit 1 on drift
+"""
+import argparse
+import hashlib
+import io
+import json
+from pathlib import Path
+import random
+import struct
+import subprocess
+import sys
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import landmark_art  # noqa: E402
+import rework_layout  # noqa: E402
+from plan_mask import rect_cells  # noqa: E402
+
+# city-kit 63cd81b: today's Wanhe map and both Nantun banks, unchanged since 6366b9e.
+SOURCE = "63cd81b147f73042560de8d3e5abb861b8230bde"
+PLAN = "data/taichung/nantun/rework/masterplan.json"
+PLAN_SHA256 = "c23c806fa95a1a2fd0de198992c9edc00996dd07183362a233348d2bd732af81"
+# The plan's cell file, and plan.png (sha256 bcf8450c7280c246...) cut to each map's rect, 16 px a cell.
+PLAN_CELLS = "data/taichung/nantun/rework/plan-cells.txt"
+PLAN_CELLS_SHA256 = "735b2b25836e1d1f28ece0126025f4b1ab2252abd2ae78a825cd97048b02b1e3"
+PLAN_ART = {"north": "data/taichung/nantun/rework/plan-north.png", "wanhe": "data/taichung/nantun/rework/plan-wanhe.png"}
+PLAN_ART_SHA256 = "8d98f93ee8a99914f9b37bc0d55ef6eea6a5aed80d56ec1ba3a5814665d71c58"  # both crops, North first
+REPORT = "data/taichung/nantun/rework/report.json"
+KIT = "data/taichung/city-kit/kit.json"
+LAYOUTS = "data/layouts/layouts.json"
+CONTRACT = "docs/taichung-city-contract.json"
+ENCOUNTERS = "src/data/wild_encounters.json"
+SCRIPTS = "data/scripts/taichung_city.inc"
+PRIMARY = "data/tilesets/primary/taichung_greenway_private"
+WANHE_BANK = "data/tilesets/secondary/taichung_nantun"
+NORTH_BANK = "data/tilesets/secondary/taichung_nantun_north"
+BANK_FILES = ("metatiles.bin", "metatile_attributes.bin", "tiles.png")
+
+WALK, SOLID, SIGN_WORD = 0x3000, 0x0400, 0x3403
+COVERED = 1 << 29
+# Secondary limits: 384 metatiles; tiles 0x3F8-0x3FF are the door animation's.
+SECONDARY_METATILES, SECONDARY_TILES = 384, 376
+GROUND_BOTTOM = {"grass": 0x001, "paver": 0x175, "water": None}  # water: the kit's still body
+GROUND_WORDS = {"grass": WALK | 0x001, "paver": WALK | 0x175, "flowers": WALK | 0x004, "tall": WALK | 0x00D}
+
+MAPS = {
+    "north": {"id": "MAP_TAICHUNG_NANTUN_NORTH", "name": "TaichungNantunNorth", "layout": "LAYOUT_TAICHUNG_NANTUN_NORTH",
+              "folder": "data/layouts/TaichungNantunNorth", "bank": NORTH_BANK, "old_origin": (0, 64)},
+    "wanhe": {"id": "MAP_TAICHUNG_NANTUN_WANHE", "name": "TaichungNantunWanhe", "layout": "LAYOUT_TAICHUNG_NANTUN_WANHE",
+              "folder": "data/layouts/TaichungNantunWanhe", "bank": WANHE_BANK, "old_origin": (0, 104)},
+}
+DISTRICT_MAPS = {"xitun": "MAP_TAICHUNG_XITUN", "greenway": "MAP_TAICHUNG_GREENWAY", "oldcity": "MAP_TAICHUNG_OLD_CITY",
+                 "north": "MAP_TAICHUNG_NANTUN_NORTH", "wanhe": "MAP_TAICHUNG_NANTUN_WANHE"}
+DIRECTIONS = ("up", "right", "down", "left")
+
+# Signs. Landmark signs stand where their set piece puts them; road signs stand on a grass or
+# path cell beside the named street's sidewalk, and the river sign at the riverside path's end.
+# Names come from the master plan's streets and Maps' brief (Fazi River); no other facts.
+SET_PIECE_SIGNS = {
+    "18": ("CulturalHeritagePark", "CULTURAL HERITAGE PARK\\nOld Taichung Winery, 1916."),
+    "19": ("FengleSculpturePark", "FENGLE SCULPTURE PARK\\nTaiwan's first sculpture park."),
+    "20": ("WenxinForestPark", "WENXIN FOREST PARK\\nOpen-air stage under ribbon roofs."),
+}
+ROAD_SIGNS = [  # (world x, y, what the sign stands beside, script, text)
+    (14, 87, "Gongyi Rd", "GongyiRd", "GONGYI RD."),          # Wenxin Forest Park's north edge
+    (12, 89, "Liming Rd", "LimingRd", "LIMING RD."),          # Wenxin's west edge
+    (57, 123, "Huiwen S St", "HuiwenSSt", "HUIWEN S. ST."),   # the flower fields' west edge
+    (3, 167, "river", "FaziRiver", "FAZI RIVER"),             # the riverside path's west end
+]
+
+# Wild encounters on tall grass (FireRed land slots 20,20,10,10,10,10,5,5,4,4,1,1).
+ENCOUNTER_TABLES = {
+    "north": [("PIDGEY", 2, 3), ("PIDGEY", 3, 4), ("CATERPIE", 2, 3), ("CATERPIE", 3, 4), ("WEEDLE", 2, 3), ("WEEDLE", 3, 4),
+              ("RATTATA", 2, 3), ("RATTATA", 3, 4), ("ODDISH", 3, 4), ("ODDISH", 4, 5), ("ODDISH", 5, 5), ("ODDISH", 5, 5)],
+    "wanhe": [("RATTATA", 2, 3), ("PIDGEY", 2, 3), ("RATTATA", 3, 4), ("PIDGEY", 3, 4), ("ODDISH", 2, 3), ("SPEAROW", 2, 3),
+              ("ODDISH", 3, 4), ("SPEAROW", 3, 4), ("ODDISH", 4, 5), ("SPEAROW", 4, 5), ("ODDISH", 5, 5), ("SPEAROW", 5, 5)],
+}
+ENCOUNTER_RATE = 12
+SCRIPT_MARK = "@ Nantun rework signs: written by tools/taichung/nantun/build_rework.py"
+
+
+# ---------------------------------------------------------------- sources
+class Tree:
+    """Reads the working tree, or SOURCE through git."""
+    def __init__(self, revision=None):
+        self.revision = revision
+
+    def read(self, path):
+        if self.revision:
+            return subprocess.check_output(["git", "show", f"{self.revision}:{path}"], cwd=ROOT)
+        return (ROOT / path).read_bytes()
+
+    def json(self, path):
+        return json.loads(self.read(path).decode())
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        return list(struct.unpack(f"<{len(raw) // struct.calcsize(kind)}{kind}", raw))
+
+    def image(self, path):
+        image = Image.open(io.BytesIO(self.read(path)))
+        image.load()
+        return image
+
+
+def dump_json(value):
+    return (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode()
+
+
+def load_plan(tree):
+    raw = tree.read(PLAN)
+    if hashlib.sha256(raw).hexdigest() != PLAN_SHA256:
+        raise SystemExit(f"{PLAN} is not plan {PLAN_SHA256[:8]}")
+    return json.loads(raw)
+
+
+def kit_ids(tree):
+    return {name: int(value, 16) for name, value in tree.json(KIT)["metatiles"].items()}
+
+
+def load_cells(tree):
+    raw = tree.read(PLAN_CELLS)
+    if hashlib.sha256(raw).hexdigest() != PLAN_CELLS_SHA256:
+        raise SystemExit(f"{PLAN_CELLS} is not the pinned cell file")
+    return rework_layout.read_cells(raw.decode())
+
+
+def collision_table(source):
+    """Collision and elevation of each metatile where today's maps place it (the most common
+    if it varies): secondary IDs from the two Nantun maps, primary IDs from all five exteriors."""
+    seen = {}
+    for name in ("TaichungNantunNorth", "TaichungNantunWanhe", "TaichungGreenway", "TaichungXitun", "TaichungOldCity"):
+        for w in source.words(f"data/layouts/{name}/map.bin"):
+            if name.startswith("TaichungNantun") or w & 0x3FF < 640:
+                counts = seen.setdefault(w & 0x3FF, {})
+                counts[w & 0xFC00] = counts.get(w & 0xFC00, 0) + 1
+    return {n: min(c, key=lambda bits: (-c[bits], bits)) for n, c in seen.items()}
+
+
+def read_art(tree, name, rendered):
+    """{world cell: the metatile plan.png draws there, or None} for one map."""
+    x0, y0, x1, y1 = rework_layout.MAPS[name]
+    image = Image.open(io.BytesIO(tree.read(PLAN_ART[name]))).convert("RGB")
+    if image.size != ((x1 - x0) * 16, (y1 - y0) * 16):
+        raise SystemExit(f"{PLAN_ART[name]} is not {name}'s rect")
+    return {(x, y): rendered.get(image.crop(((x - x0) * 16, (y - y0) * 16, (x - x0 + 1) * 16, (y - y0 + 1) * 16)).tobytes())
+            for y in range(y0, y1) for x in range(x0, x1)}
+
+
+# ---------------------------------------------------------------- the city kit's pieces
+def street_piece(plan, cell):
+    """Xitun's profile and junction rules (docs/city-kit.md), by each street's role at the cell.
+    Returns the piece and the cell's row in its east-west street (-1 north sidewalk ... 3 south).
+    A street's end row that meets no other street is a kerb: its sidewalk wraps across the end,
+    and its asphalt cells take bollards on the side the street runs in from ("kerb-n" ...)."""
+    role = {-1: "sw", 0: "asph", 1: "centre", 2: "asph", 3: "sw"}
+    x, y = cell
+    ew = ns = None
+    for s in plan["streetsEastWest"]:
+        r = s["firstAsphaltRow"]
+        if s["x0"] <= x < s["x1"] and r - 1 <= y <= r + 3:
+            ew = (role[y - r], s, y - r)
+    for s in plan["streetsNorthSouth"]:
+        c = s["firstAsphaltCol"]
+        if s["y0"] <= y < s["y1"] and c - 1 <= x <= c + 3:
+            ns = (role[x - c], s)
+    if ns is None:
+        if ew[0] != "sw" and x in (ew[1]["x0"], ew[1]["x1"] - 1):
+            return ("kerb-e" if x == ew[1]["x0"] else "kerb-w"), ew[2]
+        kind = {"sw": "sidewalk", "asph": "st-asphalt", "centre": "st-ew-centre"}[ew[0]]
+        if x == ew[1]["x0"] and x == plan["highway"]["west"][2]:
+            kind = {"sidewalk": "st-ew-sidewalk-under-w", "st-asphalt": "st-ew-asphalt-under-w",
+                    "st-ew-centre": "st-ew-centre-under-w"}[kind]
+        return kind, ew[2]
+    if ew is None:
+        if ns[0] != "sw" and y in (ns[1]["y0"], ns[1]["y1"] - 1):
+            return ("kerb-s" if y == ns[1]["y0"] else "kerb-n"), None
+        return {"sw": "sidewalk", "asph": "st-asphalt", "centre": "st-ns-centre"}[ns[0]], None
+    if ew[0] != "sw" and ns[0] != "sw":
+        return "st-asphalt", ew[2]
+    if ew[0] != "sw":
+        return "st-ew-crosswalk", ew[2]
+    if ns[0] != "sw":
+        return "st-ns-crosswalk", ew[2]
+    return "sidewalk", ew[2]
+
+
+def water_piece(plan, cell):
+    """Wanhe's water: the river flows west along the south edge, its east arm flows south into
+    it, and the Wanhe canal flows south into the river. Each kind takes its own flow's pieces."""
+    x, y = cell
+    river_top = next(r[1] for r in plan["river"] if r[0] == plan["highway"]["west"][0])
+    east = next(r for r in plan["river"] if r[1] < river_top and r[3] > river_top)
+    canal = plan["canals"]["Wanhe canal"][0]
+    first = plan["highway"]["west"][2]
+    if y >= river_top:
+        if x == first:  # the wall's top carries on as the bridge's side
+            return "wall-w-top"
+        if x == first + 1:
+            return "wa-west-bank-n-abut-w" if y == river_top else "wa-west-body-under-w"
+        if y == river_top:
+            if x == canal[0] or x == east[0]:
+                return "wa-west-inner-nw"
+            if x == canal[2] - 1:
+                return "wa-west-inner-ne"
+            return "wa-west-body" if x > east[0] else "wa-west-bank-n"
+        return "wa-west-body"
+    if east[0] <= x < east[2]:
+        if y == east[1]:
+            return "wa-south-outer-nw" if x == east[0] else "wa-south-bank-n"
+        return "wa-south-bank-w" if x == east[0] else "wa-south-body"
+    if canal[0] <= x < canal[2]:
+        west = x == canal[0]
+        if y == canal[1]:
+            return "wa-south-outer-nw" if west else "wa-south-outer-ne"
+        return "wa-south-bank-w" if west else "wa-south-bank-e"
+    raise ValueError(f"No water rule for {cell}")
+
+
+def highway_piece(plan, rng, x, lane_car):
+    """Lane x+3 of Freeway 1, with a car in roughly one cell in seven and never two in a row."""
+    lane = x - plan["highway"]["west"][0]
+    if lane_car.get(lane) or rng.random() >= 1 / 7:
+        lane_car[lane] = False
+        return f"hw-ns-{lane}"
+    lane_car[lane] = True
+    return f"hw-ns-{lane}-car-{rng.choice(('red', 'blue', 'maroon'))}"
+
+
+# ---------------------------------------------------------------- set pieces
+def path_bridge(lay, cell):
+    """Planks across water that runs north-south, with a rail on each outer row of the path."""
+    x, y = cell
+    if not {(x, y - 1), (x, y + 1)} & lay.water:
+        raise ValueError(f"No path bridge rule for {cell}: the water does not run north-south")
+    north, south = lay.cls.get((x, y - 1)) == "b", lay.cls.get((x, y + 1)) == "b"
+    return "pb-ew" if north and south else "pb-ew-s" if north else "pb-ew-n" if south else "pb-ew-single"
+
+
+def tile_variants(t):
+    """The four flips of an 8x8 tile, keyed by the GBA's hflip/vflip entry bits."""
+    h = tuple(tuple(r[::-1]) for r in t)
+    return {0: t, 0x400: h, 0x800: t[::-1], 0xC00: h[::-1]}
+
+
+class SetPieceArt:
+    """New metatiles drawn as a top layer over a ground metatile's bottom layer: landmarks 18-20
+    from landmark_art, and signs redrawn on pavers (SourceArt)."""
+    def __init__(self, primary_defs, kit):
+        self.primary_defs, self.kit = primary_defs, kit
+        self.metatiles = []          # (bottom words, top [(tile, flip, palette) or None], attr) in first-seen order
+        self.index = {}
+        self.tiles = []              # canonical 8x8 tiles in first-seen order
+        self.tile_index = {}
+        self.by_piece = {}
+
+    def bottom(self, ground):
+        n = GROUND_BOTTOM[ground] if ground != "water" else self.kit["wa-still-body"]
+        words = self.primary_defs[n * 8:n * 8 + 8]
+        if any(words[4:]):
+            raise ValueError(f"Ground metatile {n:#x} draws on its top layer")
+        return tuple(words[:4])
+
+    def tile(self, quarter):
+        variants = tile_variants(quarter)
+        canonical = min(variants.values())
+        if canonical not in self.tile_index:
+            self.tile_index[canonical] = len(self.tiles)
+            self.tiles.append(canonical)
+        # Flips undo themselves: the flip that made the canonical tile draws the quarter from it.
+        return self.tile_index[canonical], next(f for f, v in variants.items() if v == canonical)
+
+    def cell(self, piece, ground, art, palette, attr=COVERED):
+        top = []
+        for q in landmark_art.quarters(art):
+            q = tuple(tuple(r) for r in q)
+            if not any(any(r) for r in q):
+                top.append(None)
+                continue
+            index, flip = self.tile(q)
+            top.append((index, flip, palette))
+        key = (self.bottom(ground), tuple(top), attr)
+        if key not in self.index:
+            self.index[key] = len(self.metatiles)
+            self.metatiles.append(key)
+        self.by_piece.setdefault(piece, {"tiles": set(), "metatiles": set()})
+        self.by_piece[piece]["metatiles"].add(self.index[key])
+        self.by_piece[piece]["tiles"].update(t[0] for t in top if t)
+        return self.index[key]
+
+
+class SourceArt:
+    """Today's Nantun bank over the installed primary. It renders metatiles as the engine draws
+    them (a bottom-layer pixel always, a top-layer pixel unless its index is 0), which reads
+    plan.png back into metatiles, and redraws one on another ground: every pixel the grass under
+    it shows (the same colour at the same place) shows the new ground instead.
+
+    Where the art already sits on the top layer over plain grass, the cell keeps that top layer
+    over the new bottom and costs no tiles. Otherwise (a sign carries its grass in the bottom
+    layer) the visible pixels that are not grass merge into one new top layer, in a palette that
+    holds all their colours."""
+    def __init__(self, tree, source, primary_defs, source_defs):
+        self.sheets = (tree.image(f"{PRIMARY}/tiles.png"), source.image(f"{WANHE_BANK}/tiles.png"))
+        self.palettes = [palette(tree, PRIMARY if n < 7 else WANHE_BANK, n) for n in range(13)]
+        self.defs = (primary_defs, source_defs)
+        self.grass = self.visible(self.words(GROUND_BOTTOM["grass"]))
+
+    def words(self, n):
+        defs, local = (self.defs[0], n) if n < 640 else (self.defs[1], n - 640)
+        return defs[local * 8:local * 8 + 8]
+
+    def layer(self, words, layer):
+        out = [None] * 256
+        for q in range(4):
+            entry = words[layer * 4 + q]
+            n, p = entry & 0x3FF, entry >> 12
+            sheet, local = (self.sheets[0], n) if n < 640 else (self.sheets[1], n - 640)
+            sx, sy = local % 16 * 8, local // 16 * 8
+            for y in range(8):
+                for x in range(8):
+                    i = sheet.getpixel((sx + (7 - x if entry & 0x400 else x), sy + (7 - y if entry & 0x800 else y)))
+                    out[(q // 2 * 8 + y) * 16 + q % 2 * 8 + x] = (i, p)
+        return out
+
+    def visible(self, words):
+        bottom, top = self.layer(words, 0), self.layer(words, 1)
+        return [t if t[0] else b for b, t in zip(bottom, top)]
+
+    def colour(self, pixel):
+        return self.palettes[pixel[1]][pixel[0]]
+
+    def rendered(self):
+        """{RGB bytes of a 16x16 render: the lowest metatile that draws it}."""
+        out = {}
+        for n in [*range(640), *range(640, 640 + len(self.defs[1]) // 8)]:
+            out.setdefault(bytes(v for px in self.visible(self.words(n)) for v in self.colour(px)), n)
+        return out
+
+    def redraw(self, n, ground, attr, art):
+        """("same", None) when no grass shows, ("words", definition) for a free re-lay, or
+        ("piece", art metatile index)."""
+        words = self.words(n)
+        top, shown = self.layer(words, 1), self.visible(words)
+        keep = [None if self.colour(px) == self.colour(g) else px for px, g in zip(shown, self.grass)]
+        if None not in keep:
+            return "same", None
+        if all((k is None) == (t[0] == 0) and (k is None or k == t) for k, t in zip(keep, top)):
+            return "words", (list(art.bottom(ground)) + list(words[4:]), attr)
+        colours = {self.colour(k) for k in keep if k}
+        own = sorted({k[1] for k in keep if k})
+        fits = [p for p in own + [p for p in range(13) if p not in own] if colours <= set(self.palettes[p][1:])]
+        if not fits:
+            raise ValueError(f"{n:#x} on {ground}: no palette holds its colours")
+        p = fits[0]
+        index = lambda k: k[0] if k[1] == p else self.palettes[p].index(self.colour(k), 1)  # noqa: E731
+        grid = [[index(keep[y * 16 + x]) if keep[y * 16 + x] else 0 for x in range(16)] for y in range(16)]
+        # Merged art draws in front of the ground, so both layers sit below the player.
+        return "piece", art.cell("paved", ground, grid, p, attr & ~(3 << 29) | COVERED)
+
+
+def palette(tree, folder, n):
+    lines = tree.read(f"{folder}/palettes/{n:02}.pal").decode().splitlines()
+    return [tuple(map(int, line.split())) for line in lines[3:3 + int(lines[2])]]
+
+
+POND_PIECES = {  # a still pond, by (row, column) class: edge or interior
+    ("n", "w"): "wa-still-outer-nw", ("n", "m"): "wa-still-bank-n", ("n", "e"): "wa-still-outer-ne",
+    ("m", "w"): "wa-still-bank-w", ("m", "m"): "wa-still-body", ("m", "e"): "wa-still-bank-e",
+    ("s", "w"): "wa-still-outer-sw", ("s", "m"): "wa-still-bank-s", ("s", "e"): "wa-still-outer-se",
+}
+
+
+def pond_piece(cells, cell):
+    xs, ys = [c[0] for c in cells], [c[1] for c in cells]
+    x, y = cell
+    row = "n" if y == min(ys) else "s" if y == max(ys) else "m"
+    col = "w" if x == min(xs) else "e" if x == max(xs) else "m"
+    return POND_PIECES[(row, col)]
+
+
+# ---------------------------------------------------------------- painting
+def paint(name, lay, plan, kit, table, art):
+    """World cell -> map word, ("piece", n, flags) for a set-piece metatile, or ("variant", n,
+    ground, flags) for an existing metatile redrawn on another ground; both are placed later."""
+    rng = random.Random(f"nantun-highway-{name}")
+    lane_car = {}
+    out = {}
+    for c in lay.cells():
+        if c in lay.highway:
+            out[c] = SOLID | kit[highway_piece(plan, rng, c[0], lane_car)]
+        elif c in lay.streets:
+            kind, row = street_piece(plan, c)
+            if c in lay.water:  # a road bridge keeps its asphalt; its sidewalks get parapets
+                if kind != "sidewalk" and row in (-1, 3) or row is None:
+                    raise ValueError(f"No bridge rule for {kind} at {c}")
+                if kind == "sidewalk":
+                    kind = "br-ew-sidewalk-n" if row == -1 else "br-ew-sidewalk-s"
+            elif kind.startswith("kerb-"):
+                kind = "st-bollards-" + kind[-1]
+                lay.kerbs.append(c)
+            elif kind != "sidewalk":
+                kind = lay.crossing(c) or kind
+            out[c] = WALK | (0x175 if kind == "sidewalk" else kit[kind])
+        elif c in lay.water:
+            out[c] = WALK | kit[path_bridge(lay, c)] if lay.cls[c] == "b" else SOLID | kit[water_piece(plan, c)]
+        elif lay.cls[c] == "s":  # a walk off the street grid (the canal walk): the kit's sidewalk
+            out[c] = WALK | 0x175
+        elif lay.cls[c] == "W":  # the freeway's retaining wall: its top, then its shadow on a bank
+            top = plan["highway"]["west"][2]
+            if c[0] not in (top, top + 1):
+                raise ValueError(f"{name}: wall cell {c} is not beside the west highway")
+            out[c] = SOLID | kit["wall-w-top" if c[0] == top else "wall-w-bank"]
+        elif c in lay.art:
+            n = lay.art[c]
+            if n not in table:
+                raise ValueError(f"{name}: {n:#x} at {c} is placed nowhere today, so it has no collision")
+            out[c] = table[n] | n
+    ground = {0x001: "grass", 0x175: "paver"}
+
+    def sign(c):
+        n = out[c] & 0x3FF
+        if n not in ground:
+            raise ValueError(f"{name}: a sign at {c} stands on {n:#x}, which is neither grass nor paver")
+        return SIGN_WORD if ground[n] == "grass" else ("variant", SIGN_WORD & 0x3FF, ground[n], SIGN_WORD & 0xFC00)
+
+    for note in lay.notes:
+        out[tuple(note["to"])] = sign(tuple(note["to"]))
+    for x, y, beside, _, _ in ROAD_SIGNS:
+        c = (x, y)
+        if not lay.inside(x, y):
+            continue
+        if lay.cls[c] not in "gfp" or c in lay.strip_cells or not isinstance(out[c], int) or out[c] & 0xC00:
+            raise ValueError(f"Sign for {beside} at {c} is not a free verge or path cell")
+        near = {(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)}
+        if not any(lay.water & near if beside == "river" else (lay.streets.get(n) == beside for n in near)):
+            raise ValueError(f"Sign at {c} does not stand beside {beside}")
+        out[c] = sign(c)
+    # Railings: a sidewalk-paver cell on a bank takes the kit's rail on its water side(s).
+    corners = {frozenset("nw"): "nw", frozenset("ne"): "ne", frozenset("sw"): "sw", frozenset("se"): "se"}
+    for x, y in map(tuple, lay.railings()):
+        c = (x, y)
+        sides = frozenset(d for d, n in (("n", (x, y - 1)), ("s", (x, y + 1)), ("w", (x - 1, y)), ("e", (x + 1, y)))
+                          if lay.plan_cells.get(n) == "~")
+        if not isinstance(out[c], int) or out[c] & 0x3FF != 0x175:
+            lay.unrailed.append({"cell": [x, y], "word": f"{out[c]:#06x}" if isinstance(out[c], int) else out[c][0]})
+            continue
+        rail = next(iter(sides)) if len(sides) == 1 else corners.get(sides)
+        if rail is None:
+            raise ValueError(f"{name}: no railing for water on sides {sorted(sides)} of {c}")
+        out[c] = WALK | kit["st-rail-" + rail]
+        lay.rails[rail] = lay.rails.get(rail, 0) + 1
+    # Inner corners: a sidewalk-paver cell with water only at a corner, where the walk's side rail
+    # meets the run across the water's end, takes st-rail-inner on that diagonal.
+    rails = {v for k, v in kit.items() if k.startswith("st-rail-")}
+    for (x, y), w in list(out.items()):
+        if not isinstance(w, int) or w & 0x3FF != 0x175 \
+                or any(lay.plan_cells.get(n) == "~" for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1))):
+            continue
+        for diag, (dx, dy) in (("nw", (-1, -1)), ("ne", (1, -1)), ("sw", (-1, 1)), ("se", (1, 1))):
+            beside = [out.get((x + dx, y)), out.get((x, y + dy))]
+            if lay.plan_cells.get((x + dx, y + dy)) == "~" \
+                    and all(isinstance(n, int) and n & 0x3FF in rails for n in beside):
+                out[(x, y)] = WALK | kit["st-rail-inner-" + diag]
+                lay.rails["inner-" + diag] = lay.rails.get("inner-" + diag, 0) + 1
+    for p in lay.pieces:
+        spec, (px, py) = p["spec"], p["rect"][:2]
+        pond = {c for c, kind in spec["ground"].items() if kind == "water"}
+        for (lx, ly), kind in spec["ground"].items():
+            c = (px + lx, py + ly)
+            if (lx, ly) in spec["signs"]:
+                out[c] = SIGN_WORD
+            elif (lx, ly) in spec["layer"]:
+                n = art.cell(p["n"], kind, spec["layer"][(lx, ly)], int(spec["palette"][1:]))
+                walk = (lx, ly) in spec.get("walk", set())
+                out[c] = ("piece", n, WALK if walk else SOLID)
+            elif kind == "water":
+                out[c] = SOLID | kit[pond_piece(pond, (lx, ly))]
+            else:
+                out[c] = GROUND_WORDS[kind]
+    return out
+
+
+# Plan classes a neighbour builds as open ground.
+OPEN_CLASSES = set("SsPp.gGb")
+
+
+def close_seam(drafts, painted, table):
+    """validate_city wants each open cell on a map's edge to step onto open ground across it. Where
+    the plan puts Wenxin's grass over a Wanhe lot, or a Wanhe alley under a park tree, the open
+    side takes a hedge."""
+    hedge = table[rework_layout.HEDGE] | rework_layout.HEDGE
+    if not hedge & 0xC00:
+        raise ValueError("The hedge can be walked through")
+    north, wanhe = drafts["north"], drafts["wanhe"]
+
+    def is_open(w):
+        return not (w[-1] if isinstance(w, tuple) else w) & 0xC00
+
+    for x in range(max(north.x0, wanhe.x0), min(north.x1, wanhe.x1)):
+        sides = {"north": (x, north.y1 - 1), "wanhe": (x, wanhe.y0)}
+        opened = [n for n, c in sides.items() if is_open(painted[n][c])]
+        if len(opened) == 1:
+            name, c = opened[0], sides[opened[0]]
+            if drafts[name].cls[c] not in "gG.p":  # the hedge is primary, so strip cells may take it too
+                raise ValueError(f"{name}: seam cell {c} '{drafts[name].cls[c]}' cannot take a hedge")
+            painted[name][c] = hedge
+            drafts[name].seam_hedges.append(list(c))
+
+
+def open_xitun_seam(drafts, painted, table):
+    """The same rule on North's seam with Xitun, which builds the plan's last row as it stands: where
+    the plan opens that row over a North hedge, the hedge takes paving (primary, so a strip cell may)."""
+    north = drafts["north"]
+    paving = table[rework_layout.PAVING] | rework_layout.PAVING
+    if paving & 0xC00:
+        raise ValueError("The paving cannot be walked on")
+    for x in range(north.x0, north.x1):
+        c, above = (x, north.y0), (x, north.y0 - 1)
+        w = painted["north"][c]
+        if north.plan_cells.get(above) in OPEN_CLASSES and (w[-1] if isinstance(w, tuple) else w) & 0xC00:
+            if north.cls[c] != "h":
+                raise ValueError(f"north: seam cell {c} '{north.cls[c]}' under Xitun's open {above} is not a hedge")
+            painted["north"][c] = paving
+            north.seam_openings.append(list(c))
+
+
+# ---------------------------------------------------------------- the reclaimed bank
+def source_bank(source):
+    return (source.words(f"{WANHE_BANK}/metatiles.bin"), source.words(f"{WANHE_BANK}/metatile_attributes.bin", "I"),
+            source.image(f"{WANHE_BANK}/tiles.png"))
+
+
+def build_bank(source, used, art, variants):
+    """Keep SOURCE's definitions the maps use, clear the rest, then place the set pieces and the
+    ground variants (full definitions over kept tiles) in the lowest free slots."""
+    defs, attrs, sheet = source_bank(source)
+    kept = sorted(n - 640 for n in used if n >= 640)
+    if any(n >= len(attrs) for n in kept):
+        raise ValueError("A map uses a secondary metatile SOURCE does not define")
+    kept_tiles = set()
+    for words in [defs[n * 8:n * 8 + 8] for n in kept] + [words for words, _ in variants]:
+        for entry in words:
+            if entry & 0x3FF >= 640:
+                kept_tiles.add((entry & 0x3FF) - 640)
+    if any(t >= SECONDARY_TILES for t in kept_tiles):
+        raise ValueError("A kept metatile draws a door-animation tile")
+
+    def tile_pixels(image, t):
+        sx, sy = t % 16 * 8, t // 16 * 8
+        return tuple(tuple(image.getpixel((sx + x, sy + y)) for x in range(8)) for y in range(8))
+
+    # New tiles reuse an identical kept tile (in any flip) or take the lowest free slot.
+    kept_lookup = {}
+    for t in sorted(kept_tiles):
+        for flip, v in tile_variants(tile_pixels(sheet, t)).items():
+            kept_lookup.setdefault(v, (t, flip))
+    free_tiles = [t for t in range(SECONDARY_TILES) if t not in kept_tiles]
+    tile_slot, new_tiles = {}, []
+    for i, tile in enumerate(art.tiles):
+        if tile in kept_lookup:
+            tile_slot[i] = kept_lookup[tile]
+        else:
+            tile_slot[i] = (free_tiles[len(new_tiles)], 0)
+            new_tiles.append((tile_slot[i][0], tile))
+    free_ids = [n for n in range(SECONDARY_METATILES) if n not in set(kept)]
+    if len(art.metatiles) + len(variants) > len(free_ids) or len(new_tiles) > len(free_tiles):
+        raise ValueError("The set pieces do not fit the reclaimed bank")
+    piece_ids = free_ids[:len(art.metatiles)]
+    variant_ids = free_ids[len(art.metatiles):len(art.metatiles) + len(variants)]
+    count = max(kept + piece_ids + variant_ids) + 1
+    out_defs, out_attrs = [0] * (count * 8), [0] * count
+    for n in kept:
+        out_defs[n * 8:n * 8 + 8] = defs[n * 8:n * 8 + 8]
+        out_attrs[n] = attrs[n]
+    for n, (bottom, top, attr) in zip(piece_ids, art.metatiles):
+        words = list(bottom)
+        for q in top:
+            if q is None:
+                words.append(0)
+                continue
+            index, flip, palette = q
+            slot, slot_flip = tile_slot[index]
+            words.append((640 + slot) | (flip ^ slot_flip) | palette << 12)
+        out_defs[n * 8:n * 8 + 8] = words
+        out_attrs[n] = attr
+    for n, (words, attr) in zip(variant_ids, variants):
+        out_defs[n * 8:n * 8 + 8] = words
+        out_attrs[n] = attr
+    image = Image.new("P", sheet.size, 0)
+    image.putpalette(sheet.getpalette())
+    for t in kept_tiles:
+        sx, sy = t % 16 * 8, t // 16 * 8
+        image.paste(sheet.crop((sx, sy, sx + 8, sy + 8)), (sx, sy))
+    for slot, tile in new_tiles:
+        sx, sy = slot % 16 * 8, slot // 16 * 8
+        for y in range(8):
+            for x in range(8):
+                image.putpixel((sx + x, sy + y), tile[y][x])
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG", optimize=False)
+    summary = {
+        "sourceMetatiles": len(attrs), "keptMetatiles": len(kept), "keptTiles": len(kept_tiles),
+        "clearedMetatiles": len(attrs) - len(kept), "newMetatiles": len(piece_ids), "newTiles": len(new_tiles),
+        "tilesReusedFromKept": len(art.tiles) - len(new_tiles), "pavedVariants": len(variant_ids),
+        "metatilesUsed": len(kept) + len(piece_ids) + len(variant_ids), "metatileCapacity": SECONDARY_METATILES,
+        "tilesUsed": len(kept_tiles) + len(new_tiles), "tileCapacity": SECONDARY_TILES,
+        "pieceMetatileIds": [f"{640 + n:#05x}" for n in piece_ids],
+        "variantMetatileIds": [f"{640 + n:#05x}" for n in variant_ids],
+    }
+    files = {
+        "metatiles.bin": struct.pack(f"<{len(out_defs)}H", *out_defs),
+        "metatile_attributes.bin": struct.pack(f"<{len(out_attrs)}I", *out_attrs),
+        "tiles.png": buffer.getvalue(),
+    }
+    return files, [640 + n for n in piece_ids], [640 + n for n in variant_ids], summary
+
+
+# ---------------------------------------------------------------- events, connections, text
+def connections(plan, name):
+    x0, y0, x1, y1 = plan["districts"][name]["plan"]
+    out = []
+    for other, mid in DISTRICT_MAPS.items():
+        if other == name:
+            continue
+        a0, b0, a1, b1 = plan["districts"][other]["plan"]
+        if b1 == y0 and a0 < x1 and x0 < a1:
+            out.append(("up", a0 - x0, mid))
+        if b0 == y1 and a0 < x1 and x0 < a1:
+            out.append(("down", a0 - x0, mid))
+        if a0 == x1 and b0 < y1 and y0 < b1:
+            out.append(("right", b0 - y0, mid))
+        if a1 == x0 and b0 < y1 and y0 < b1:
+            out.append(("left", b0 - y0, mid))
+    out.sort(key=lambda c: (DIRECTIONS.index(c[0]), c[1]))
+    return [{"map": mid, "offset": offset, "direction": d} for d, offset, mid in out]
+
+
+def sign_event(x, y, script):
+    return {"type": "sign", "x": x, "y": y, "elevation": 0, "player_facing_dir": "BG_EVENT_PLAYER_FACING_ANY",
+            "script": script}
+
+
+def events(name, dr, source, origin):
+    """Warps keep today's doors, shifted by the map's rule; signs stand where the layout puts them."""
+    old = source.json(f"data/maps/{MAPS[name]['name']}/map.json")
+    ox, oy = MAPS[name]["old_origin"]
+    nx, ny = origin
+    shift = (ox - nx, oy - ny)
+    warps = [dict(w, x=w["x"] + shift[0], y=w["y"] + shift[1]) for w in old["warp_events"]]
+    signs, moved = [], []
+    old_signs = {(b["x"] + ox, b["y"] + oy): b["script"] for b in old["bg_events"]}
+    for note in dr.notes:
+        if note["type"] == "sign-moved":
+            script = old_signs.pop(tuple(note["from"]))
+            to = tuple(note["to"])
+            signs.append(sign_event(to[0] - nx, to[1] - ny, script))
+            moved.append({"script": script, "from": [note["from"][0] - ox, note["from"][1] - oy],
+                          "to": [to[0] - nx, to[1] - ny], "beyondShift": [to[0] - note["from"][0], to[1] - note["from"][1]]})
+    for (x, y), script in old_signs.items():
+        signs.append(sign_event(x - nx, y - ny, script))
+    for p in dr.pieces:
+        for x, y in p["signs"]:
+            signs.append(sign_event(x - nx, y - ny, f"TaichungCity_Sign_{SET_PIECE_SIGNS[p['n']][0]}"))
+    for x, y, street, script, text in ROAD_SIGNS:
+        if dr.inside(x, y):
+            signs.append(sign_event(x - nx, y - ny, f"TaichungCity_Sign_{script}"))
+    return warps, signs, {"shift": list(shift), "movedBeyondShift": moved}
+
+
+def script_block():
+    lines = [SCRIPT_MARK, ""]
+    entries = [v for v in SET_PIECE_SIGNS.values()] + [(script, text) for _, _, _, script, text in ROAD_SIGNS]
+    for script, text in entries:
+        lines += [f"TaichungCity_Sign_{script}::", f"\tmsgbox TaichungCity_Text_{script}, MSGBOX_SIGN", "\tend", "",
+                  f"TaichungCity_Text_{script}::", f'\t.string "{text}$"', ""]
+    return "\n".join(lines)
+
+
+def own_block(text):
+    """Nantun's sign block: from its mark to the next "@ " section (a later layer's) or the end."""
+    at = text.index(SCRIPT_MARK)
+    end = text.find("\n@ ", at)
+    return text[at:end] if end >= 0 else text[at:]
+
+
+def with_scripts(text):
+    """The shared script file with Nantun's block rewritten; later layers' sections after it are kept."""
+    head, mark, rest = text.partition("\n" + SCRIPT_MARK)
+    later = rest[rest.find("\n@ "):] if mark and "\n@ " in rest else ""
+    return head.rstrip("\n") + "\n" + "\n" + script_block() + later
+
+
+def rework_entries(layouts, contract, encounters, scripts):
+    """Nantun's entries in the four shared files, as the install record pins them."""
+    ids, layout_ids = {m["id"] for m in MAPS.values()}, {m["layout"] for m in MAPS.values()}
+    return {"layouts": [l for l in layouts["layouts"] if l.get("id") in layout_ids],
+            "districts": [d for d in contract["districts"] if d["map"] in ids],
+            "landmarks": [l for l in contract["landmarks"] if l["exteriorMap"] in ids],
+            "encounters": [e for g in encounters["wild_encounter_groups"] for e in g["encounters"] if e.get("map") in ids],
+            "scriptsSha256": hashlib.sha256(own_block(scripts).encode()).hexdigest()}
+
+
+def encounter_entry(name):
+    mons = [{"min_level": lo, "max_level": hi, "species": f"SPECIES_{s}"} for s, lo, hi in ENCOUNTER_TABLES[name]]
+    return {"map": MAPS[name]["id"], "base_label": f"s{MAPS[name]['name']}",
+            "land_mons": {"encounter_rate": ENCOUNTER_RATE, "mons": mons}}
+
+
+# ---------------------------------------------------------------- build
+def build(tree):
+    source = Tree(SOURCE)
+    plan = load_plan(tree)
+    cells = load_cells(tree)
+    if hashlib.sha256(b"".join(tree.read(PLAN_ART[n]) for n in MAPS)).hexdigest() != PLAN_ART_SHA256:
+        raise SystemExit("The plan art crops are not the pinned ones")
+    kit = kit_ids(tree)
+    table = collision_table(source)
+    primary_defs = tree.words(f"{PRIMARY}/metatiles.bin")
+    primary_attrs = tree.words(f"{PRIMARY}/metatile_attributes.bin", "I")
+    art = SetPieceArt(primary_defs, kit)
+    source_defs, source_attrs, _ = source_bank(source)
+    paved = SourceArt(tree, source, primary_defs, source_defs)
+    rendered = paved.rendered()
+    drafts, painted = {}, {}
+    for name in MAPS:
+        dr = rework_layout.build(name, plan, cells, read_art(tree, name, rendered))
+        drafts[name], painted[name] = dr, paint(name, dr, plan, kit, table, art)
+    close_seam(drafts, painted, table)
+    open_xitun_seam(drafts, painted, table)
+
+    wanted = sorted({w[1:3] for cells in painted.values() for w in cells.values() if isinstance(w, tuple) and w[0] == "variant"})
+    variants, relaid = [], {}
+    for n, ground in wanted:
+        kind, value = paved.redraw(n, ground, primary_attrs[n] if n < 640 else source_attrs[n - 640], art)
+        if kind == "words":
+            relaid[(n, ground)] = ("variant", len(variants))
+            variants.append(value)
+        else:
+            relaid[(n, ground)] = (kind, value)
+    for cells in painted.values():
+        for c, w in cells.items():
+            if isinstance(w, tuple) and w[0] == "variant":
+                kind, i = relaid[w[1:3]]
+                cells[c] = w[3] | w[1] if kind == "same" else (kind, i, w[3])
+    used = {w & 0x3FF for cells in painted.values() for w in cells.values() if not isinstance(w, tuple)}
+    bank, piece_ids, variant_ids, bank_summary = build_bank(source, used, art, variants)
+    files, report = {}, {"plan": PLAN_SHA256[:8], "planCells": PLAN_CELLS_SHA256[:8], "planArt": PLAN_ART_SHA256[:8],
+                         "source": SOURCE[:7], "maps": {}, "bank": bank_summary}
+    report["setPieces"] = {n: {"name": next(p["name"] for d in drafts.values() for p in d.pieces if p["n"] == n),
+                               "metatiles": len(v["metatiles"]), "tiles": len(v["tiles"])}
+                           for n, v in sorted(art.by_piece.items()) if n in SET_PIECE_SIGNS}
+    if "paved" in art.by_piece or variants:
+        paved_art = art.by_piece.get("paved", {"metatiles": (), "tiles": ()})
+        report["pavedSigns"] = {"metatiles": len(paved_art["metatiles"]), "tiles": len(paved_art["tiles"]),
+                                "freeRelays": len(variants)}
+
+    layouts = tree.json(LAYOUTS)
+    contract = tree.json(CONTRACT)
+    encounters = tree.json(ENCOUNTERS)
+    for name, meta in MAPS.items():
+        dr, cells = drafts[name], painted[name]
+        x0, y0, x1, y1 = rework_layout.MAPS[name]
+        width, height = x1 - x0, y1 - y0
+        words = []
+        for y in range(y0, y1):
+            for x in range(x0, x1):
+                w = cells[(x, y)]
+                if isinstance(w, tuple) and w[0] == "piece":
+                    w = w[2] | piece_ids[w[1]]
+                elif isinstance(w, tuple):
+                    w = w[2] | variant_ids[w[1]]
+                words.append(w)
+        # Neighbours on other banks draw these cells with their own tileset.
+        foreign = [c for c in dr.strip_cells if words[(c[1] - y0) * width + c[0] - x0] & 0x3FF >= 640]
+        if foreign:
+            raise SystemExit(f"{name}: seam strip cells use secondary art: {sorted(foreign)[:6]}")
+        files[f"{meta['folder']}/map.bin"] = struct.pack(f"<{len(words)}H", *words)
+        layout = next(l for l in layouts["layouts"] if l.get("id") == meta["layout"])
+        layout["width"], layout["height"] = width, height
+
+        data = tree.json(f"data/maps/{meta['name']}/map.json")
+        warps, signs, moves = events(name, dr, source, (x0, y0))
+        data["connections"] = connections(plan, name)
+        data["warp_events"], data["bg_events"] = warps, signs
+        files[f"data/maps/{meta['name']}/map.json"] = dump_json(data)
+
+        district = next(d for d in contract["districts"] if d["map"] == meta["id"])
+        district.update(width=width, height=height, worldOrigin=[x0, y0], connections=data["connections"])
+        district["status"] = ("city rework phase 2b: master plan " + PLAN_SHA256[:8] +
+                              "; fill from its cell file and art; streets, water and highway from the city kit")
+        for i, l in enumerate(contract["landmarks"]):
+            if l["exteriorMap"] != meta["id"]:
+                continue
+            # Shift today's entry, so a rebuild never shifts twice.
+            l = contract["landmarks"][i] = next(o for o in source.json(CONTRACT)["landmarks"] if o["id"] == l["id"])
+            sx, sy = moves["shift"]
+            l["entrance"].update(x=l["entrance"]["x"] + sx, y=l["entrance"]["y"] + sy)
+            l["approach"].update(x=l["approach"]["x"] + sx, y=l["approach"]["y"] + sy)
+            l["arrival"].update(x=l["arrival"]["x"] + sx, y=l["arrival"]["y"] + sy)
+            fx0, fy0, fx1, fy1 = l["footprint"]
+            l["footprint"] = [fx0 + sx, fy0 + sy, fx1 + sx, fy1 + sy]
+            script = l["host"]["script"].replace("_Host_", "_Sign_")
+            sign = next(b for b in signs if b["script"] == script)
+            l["sign"] = {"x": sign["x"], "y": sign["y"]}
+
+        group = next(g for g in encounters["wild_encounter_groups"] if g["label"] == "gWildMonHeaders")
+        group["encounters"] = [e for e in group["encounters"] if e["map"] != meta["id"]] + [encounter_entry(name)]
+
+        tall = sum(1 for w in words if w & 0x3FF == 0x00D)
+        report["maps"][name] = {
+            "map": meta["id"], "size": [width, height], "worldOrigin": [x0, y0], **moves,
+            "connections": data["connections"], "warps": [[w["x"], w["y"], w["dest_map"]] for w in warps],
+            "signs": [[b["x"], b["y"], b["script"]] for b in signs], "tallGrassCells": tall,
+            "secondaryMetatilesUsed": len({w & 0x3FF for w in words if w & 0x3FF >= 640}),
+            "seamStripCells": len(dr.strip_cells), "lotsAsTerraces": dr.terraced,
+            "seamHedges": dr.seam_hedges, "seamOpenings": dr.seam_openings,
+            "wallCells": sum(1 for k in dr.cls.values() if k == "W"), "bollardCells": sorted(map(list, dr.kerbs)),
+            "railingCells": len(dr.railings()), "railingsByPiece": dr.rails, "unrailed": dr.unrailed,
+            "standIns": dr.stand_ins,
+            "crosswalkCells": sum(1 for c in dr.streets if dr.inside(*c) and c not in dr.water and dr.crossing(c)),
+        }
+    files[LAYOUTS] = dump_json(layouts)
+    files[CONTRACT] = dump_json(contract)
+    files[ENCOUNTERS] = dump_json(encounters)
+    files[SCRIPTS] = with_scripts(tree.read(SCRIPTS).decode()).encode()
+    for folder in (WANHE_BANK, NORTH_BANK):
+        for leaf, raw in bank.items():
+            files[f"{folder}/{leaf}"] = raw
+        files[f"{folder}/compile-manifest.json"] = dump_json({
+            "schemaVersion": 2,
+            "status": ("Nantun bank, city rework phase 2b: today's Wanhe definitions the reworked North and Wanhe "
+                       "use, kept at their IDs; everything else cleared (the old 3-wide edge kit among it); "
+                       "landmarks 18-20 in the lowest free slots. North's bank is a byte copy of Wanhe's."),
+            "source": f"{SOURCE} {WANHE_BANK}", "builder": "tools/taichung/nantun/build_rework.py",
+            **bank_summary, "setPieces": report["setPieces"],
+        })
+    for n in range(16):  # Wanhe's palettes are SOURCE's; North takes the same bytes (CRLF on disk)
+        path = f"{WANHE_BANK}/palettes/{n:02}.pal"
+        raw = tree.read(path)
+        if raw.replace(b"\r\n", b"\n") != source.read(path):
+            raise SystemExit(f"{path} differs from SOURCE")
+        files[f"{NORTH_BANK}/palettes/{n:02}.pal"] = raw
+    # The install record: frozen guards read the state underneath exactly these outputs.
+    shared = (LAYOUTS, CONTRACT, ENCOUNTERS, SCRIPTS)
+    report["install"] = {
+        "baseCommit": SOURCE,
+        "outputs": {path: hashlib.sha256(raw).hexdigest() for path, raw in sorted(files.items())
+                    if path not in shared and "/palettes/" not in path},
+        "entries": rework_entries(layouts, contract, encounters, files[SCRIPTS].decode()),
+    }
+    files[REPORT] = dump_json(report)
+    return files, report, drafts, painted
+
+
+def same_png(a, b):
+    ia, ib = Image.open(io.BytesIO(a)), Image.open(io.BytesIO(b))
+    return ia.mode == ib.mode and ia.size == ib.size and ia.getpalette() == ib.getpalette() and \
+        ia.tobytes() == ib.tobytes()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    tree = Tree()
+    files, report, _, _ = build(tree)
+    drift = []
+    for path, raw in files.items():
+        target = ROOT / path
+        current = target.read_bytes() if target.exists() else None
+        same = current == raw or (current is not None and path.endswith(".png") and same_png(current, raw))
+        if not same:
+            drift.append(path)
+            if not args.check:
+                target.write_bytes(raw)
+    if args.check:
+        if drift:
+            print("Nantun rework source drifts from its builder:\n  " + "\n  ".join(drift))
+            sys.exit(1)
+        print(f"Nantun rework source matches plan {PLAN_SHA256[:8]} ({len(files)} files)")
+        return
+    print(json.dumps(report, indent=1))
+    print(f"wrote {len(drift)} of {len(files)} files", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
