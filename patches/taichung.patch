+            origins={(r[0],r[1]) for r in repairs if isinstance(r,list) and len(r)==4}
+            if len(origins)!=len(repairs) or origins!=expected:
+                raise ValueError(f'{mid}: repair origins differ; missing={sorted(expected-origins)}, extra={sorted(origins-expected)}')
+            for row in repairs:
