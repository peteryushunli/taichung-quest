+
+STREET_SIGNS_GUARD = 'tools/taichung/street_signs.py'
+
+
+def street_signs_underneath(files):
+    path = Path(files.source) / STREET_SIGNS_GUARD
+    if not path.exists():
+        return {}
+    spec = importlib.util.spec_from_file_location('registered_street_signs_guard', path)
+    guard = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(guard)
+    return guard.underneath(files)
+
+
+def actor(local, graphics, script):
+    return dict(local_id='LOCALID_TAICHUNG_STAFF_' + local, type='object',
+                graphics_id='OBJ_EVENT_GFX_' + graphics, x=3, y=9, elevation=3,
+                movement_type='MOVEMENT_TYPE_FACE_DOWN', movement_range_x=0,
+                movement_range_y=0, trainer_type='TRAINER_TYPE_NONE',
+                trainer_sight_or_berry_tree_id='0', script='TaichungHistory_Staff' + script, flag='0')
+
+
+def function_text(text, name):
+    match = re.search(r'^(?:static\s+)?\w+\s+' + re.escape(name) + r'\([^;]*?\)\s*\{', text, re.M)
+    if match is None:
+        raise ValueError('Missing function: ' + name)
+    start, depth = match.start(), 1
+    for end in range(match.end(), len(text)):
+        depth += (text[end] == '{') - (text[end] == '}')
+        if depth == 0:
+            return text[start:end + 1]
+    raise ValueError('Unclosed function: ' + name)
+
+
+def matches_map(before, after, name, proof):
+    """Restore exactly one registered appended actor; preserve the whole map."""
+    path = f'data/maps/{name}/map.json'
+    if not proof.get('active') or path not in MAP_PATHS:
+        return same_json(before, after)
+    if not proof.get('passed') or path not in proof.get('maps', {}):
+        return False
+    expected = proof['maps'][path]
+    if not same_json(before, expected['before']) or not same_json(after, expected['after']):
+        return False
+    restored = deepcopy(after)
+    if len(restored.get('object_events', [])) != len(before.get('object_events', [])) + 1:
+        return False
+    if not same_json(restored['object_events'][-1], expected['actor']):
+        return False
+    restored['object_events'].pop()
+    return same_json(before, restored)
+
+
+def header_underneath(raw, proof):
+    if not proof.get('active') or not proof.get('passed'):
+        return raw
+    if digest(raw) not in (proof['sourceSha256'][HEADER], proof.get('legacySourceSha256', {}).get(HEADER)):
+        return raw
+    text = raw.decode()
+    if text.count(HEADER_ADDITION) != 1:
+        return raw
+    return text.replace(HEADER_ADDITION, '', 1).encode()
+
+
+def save_underneath(raw, proof):
+    """Remove only the already independently attested wrapper for v9 proof."""
+    if not proof.get('active') or not proof.get('passed'):
+        return raw
+    if digest(raw) not in (proof['sourceSha256'][SAVE], proof.get('legacySourceSha256', {}).get(SAVE)):
+        return raw
+    text = raw.decode()
+    wrapper = function_text(text, API_NAME) + '\n\n'
+    if text.count(wrapper) != 1:
+        return raw
+    return text.replace(wrapper, '', 1).encode()
+
+
+class StaffProjection(dict):
+    """A legacy view that retains the actual inputs for nested current guards."""
+    def __init__(self, values, source, actual):
+        super().__init__(values)
