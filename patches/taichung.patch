+
+def _nantun_increment(source, overrides):
+    support = load("xitun_nantun_delegation_support", source/"tools/taichung/landmarks/check_old_core.py")
+    tree = support.Files(source)
+    tree.cache.update(overrides or {})
+    guard = load("xitun_registered_nantun_guard", source/NANTUN_GUARD)
+    delta = guard.underneath(tree)
+    return delta, (guard.check(source, overrides) if delta else None)
