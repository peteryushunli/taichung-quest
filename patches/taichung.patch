+            "distinctForegroundMetatileDefinitions":len({tuple(row) for row in metatiles}),
+            "CRLFPaletteAndGbaColorBytesMatch":True,"redBarrierPreservedAtIntendedDoorCenter":True,
+            "combinedOldCityFitAssessed":False,"mapOrCollisionWritten":False,"nativeReady":False,
+            "candidateNativeSha256":manifest["nativePngSha256"],
