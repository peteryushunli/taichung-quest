@@ -0,0 +1,73 @@
+"""Generate isolated production-derived v12 saves and candidate ROM receipts."""
+from pathlib import Path
+import hashlib
+import json
+import re
+import shutil
+import struct
+import subprocess
+import sys
+
+game,qa,reference,production,seed_path,web=map(Path,sys.argv[1:])
+qa.mkdir(parents=True,exist_ok=True);(qa/'roms').mkdir(exist_ok=True)
+read=lambda p:json.loads(p.read_text())
+repairs=read(game/'data/taichung/north-xitun-continue/repairs.json')
+groups=read(game/'data/maps/map_groups.json')['gMapGroup_Taichung']
+layouts={r['id']:i+1 for i,r in enumerate(read(game/'data/layouts/layouts.json')['layouts']) if r}
+symbols_bin=Path('/Users/peter/devday_hackathon/.tools/binutils/arm-none-eabi-binutils/2.47/bin/arm-none-eabi-nm')
+for name,source in [('fixed',game),('base',reference),('production',production)]:
+    meta=read(web/'web/public/roms/build.json');raw=(source/'pokefirered.gba').read_bytes()
+    nm=subprocess.check_output([str(symbols_bin),'--defined-only',str(source/'pokefirered.elf')],text=True)
+    symbols={parts[2]:int(parts[0],16) for line in nm.splitlines() if len(parts:=line.split())==3}
+    meta.update(file=name+'.gba',sha256=hashlib.sha256(raw).hexdigest(),ramSymbols={n:symbols[n] for n in ['gSaveBlock1Ptr','gSaveBlock2Ptr','gSaveBlock1','gSaveBlock2','gPlayerParty','sStartMenuCursorPos','sStartMenuOrder']})
+    meta['navigationBridge']['address']=symbols['gTaichungNavigationBridge']
+    (qa/'roms'/(name+'.gba')).write_bytes(raw);(qa/(name+'-metadata.json')).write_text(json.dumps(meta,indent=2)+'\n')
+
+permutations={int(n):list(map(int,(a,b,c,d))) for n,a,b,c,d in re.findall(r'SUBSTRUCT_CASE\(\s*(\d+),(\d),(\d),(\d),(\d)\)',(game/'src/pokemon.c').read_text())}
+seed=bytearray(seed_path.read_bytes())
+# Give the partner visibly depleted HP and PP, with a correct BoxPokemon checksum.
+for offset in range(0,0x1c000,0x1000):
+    section,_,signature,_=struct.unpack_from('<HHII',seed,offset+0xff4)
+    if signature!=0x08012025 or section!=1:continue
+    p=offset+0x38;personality,ot=struct.unpack_from('<II',seed,p)
+    plain=bytearray(struct.pack('<12I',*(v^personality^ot for v in struct.unpack_from('<12I',seed,p+0x20))))
+    plain[permutations[personality%24][1]*12+8]=1
+    struct.pack_into('<H',seed,p+0x1c,sum(struct.unpack('<24H',plain))&0xffff)
+    struct.pack_into('<12I',seed,p+0x20,*(v^personality^ot for v in struct.unpack('<12I',plain)))
+    struct.pack_into('<H',seed,p+0x56,7)
+
+
+def fixture(name,number,x,y,pending=False):
+    data=bytearray(seed);record=read(game/'data/maps'/groups[number]/'map.json')
+    for offset in range(0,0x1c000,0x1000):
+        section,_,signature,_=struct.unpack_from('<HHII',data,offset+0xff4)
+        if signature!=0x08012025 or section not in (0,1):continue
+        if section==0:
+            data[offset+9]=(data[offset+9]&~1)|(1 if pending else 0);length=0xf24
+        else:
+            struct.pack_into('<hh',data,offset,x,y)
+            for entry in (4,12):struct.pack_into('<bbbBhh',data,offset+entry,43,number,-1,0,x,y)
+            struct.pack_into('<H',data,offset+0x32,layouts[record['layout']]);length=0xf80
+        checksum=sum(struct.unpack_from(f'<{length//4}I',data,offset))&0xffffffff
+        struct.pack_into('<H',data,offset+0xff6,((checksum>>16)+checksum)&0xffff)
+    (qa/(name+'.sav')).write_bytes(data)
+
+
+samples={(75,113),(78,113),(94,125)}
+origins={27:(39,62),35:(72,62),36:(72,108)}
+cases=[]
+for m in repairs['maps']:
+    number=int(m['nativeKey'].split(':')[1]);a,b=origins[number]
+    for x,y,tx,ty in m['repairs']:
+        if (a+x,b+y) not in samples:continue
+        for pending in [False,True]:
+            name=f"{number}-{x}-{y}-"+('pending' if pending else 'ordinary')
+            fixture(name,number,x,y,pending)
+            if not pending:fixture('bootstrap-'+name,number,x,y,True)
+            cases.append(dict(id=name,start=[number,x,y],expected=[number,tx,ty],world=[a+x,b+y],pending=pending))
+for number,x,y in [(27,23,26),(35,36,24),(76,14,38)]:
+    name=f'control-{number}-{x}-{y}';fixture(name,number,x,y)
+    fixture('bootstrap-'+name,number,x,y,True)
+    cases.append(dict(id=name,start=[number,x,y],expected=[number,x,y],control=True))
+(qa/'cases.json').write_text(json.dumps(cases,indent=2)+'\n')
+print(f'Prepared {len(cases)} native ordinary/pending/control cases; partner HP7 and move1 PP1.')
diff --git a/tools/taichung/boulevard_city/qa/named-xitun-continue/run.mjs b/tools/taichung/boulevard_city/qa/named-xitun-continue/run.mjs
new file mode 100644
index 00000000..6b792f1e
--- /dev/null
+++ b/tools/taichung/boulevard_city/qa/named-xitun-continue/run.mjs
@@ -0,0 +1,110 @@
+// Actual mGBA Continue, SRAM export and read-only native progress snapshots.
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { open } from '../north-xitun/cdp.mjs';
+import { installContinueEmulator } from '../north-xitun-continue/emulator.mjs';
+const qa=process.argv[2];
+const read=async name=>JSON.parse(await readFile(join(qa,name),'utf8'));
+const cases=await read('cases.json');
+const pokemonSource=await readFile(new URL('../../../../../src/pokemon.c',import.meta.url),'utf8');
+const attacksOrder=new Map([...pokemonSource.matchAll(/SUBSTRUCT_CASE\(\s*(\d+),(\d),(\d),(\d),(\d)\)/g)].map(m=>[Number(m[1]),Number(m[3])]));
+function partnerPP(snapshot) {
+  const mon=Buffer.from(snapshot.liveParty);
+  const personality=mon.readUInt32LE(0),ot=mon.readUInt32LE(4);
+  return (mon.readUInt32LE(0x20+attacksOrder.get(personality%24)*12+8)^personality^ot)&255;
+}
+let port=9401;
+async function boot(kind,fixture,start) {
+  const metadata=await read(kind+'-metadata.json');
+  const browser=await open({url:'http://127.0.0.1:8341/',debugPort:port++,outDir:qa,
+    bootstrap:async evaluate=>{
+      for(let n=0;n<120;n++) {
+        if(await evaluate('crossOriginIsolated && !!document.body').catch(()=>false))break;
+        await new Promise(resolve=>setTimeout(resolve,50));
+      }
+      await evaluate('('+installContinueEmulator.toString()+')('+JSON.stringify({metadata,fixture:fixture.toString('base64'),speed:6,mode:'walk',start,graph:{points:[],neighbors:[],signWalls:[]},actions:[]})+')');
+    }});
+  try {
+    await browser.evaluate('qa.boot()');
+    // Navigation becomes visible before the native warp-exit fade releases input.
+    await browser.evaluate('qa.press(null,0,100)');
+    return browser;
+  }
+  catch(e) {browser.close();throw e;}
+}
+
+// Ordinary Continue restores native object caches too: produce consistent saves
+// through the old game's own menu instead of merely editing a saved coordinate.
+const authentic=cases.find(c=>c.world?.join(',')==='75,113'&&!c.pending);
+assert(authentic);
+for(const item of cases.filter(c=>!c.pending)) {
+ if(process.argv.includes('--reuse-native-menu-saves')) {
+  const bytes=await readFile(join(qa,item.id+'.sav'));
+  let ordinary=false;
+  for(let offset=0;offset<0x1c000;offset+=0x1000)
+    if(bytes.readUInt32LE(offset+0xff8)===0x08012025 && bytes.readUInt16LE(offset+0xff4)===0
+      && bytes.readUInt32LE(offset+0xffc)>2 && !(bytes[offset+9]&1))ordinary=true;
+  assert(ordinary,'Reused fixture is not a completed native ordinary save: '+item.id);
+  item.authentic=true;continue;
+ }
+ const old=await boot('production',await readFile(join(qa,'bootstrap-'+item.id+'.sav')),item.start);
+ try {
+  await old.evaluate("qa.press('Start',8,80)");
+  for(let n=0;n<12;n++) {
+    if(await old.evaluate('qa.menuAction()')===4)break;
+    await old.evaluate("qa.press('Down',6,18)");
+  }
+  assert.equal(await old.evaluate('qa.menuAction()'),4);
+  await old.evaluate("qa.press('A',8,90)");
+  for(let n=0;n<25;n++) {
+    await old.evaluate("qa.press('A',8,90)");
+    if(n>2 && (await old.state())?.field)break;
+  }
+  assert((await old.state())?.field,'Native Save menu did not return to the field');
+  const bytes=await old.evaluate('qa.save()');
+  assert([131072,131088].includes(bytes.length),'Expected 128 KiB SRAM with optional 16-byte RTC trailer');
+  await writeFile(join(qa,item.id+'.sav'),Buffer.from(bytes));
+  if(item.id===authentic.id) {
+    await writeFile(join(qa,'authentic-production-menu.sav'),Buffer.from(bytes));
+    await old.shot('production-saved-before-infill');
+  }
+  item.authentic=true;
+  console.log('Created genuine pre-infill v12 native-menu save: '+item.id);
+ } finally {old.close();}
+}
+cases.unshift({...authentic,id:'authentic-production-menu',authentic:true});
+
+const results=[];
+for(const item of process.argv.includes('--party-input-proof-only')?cases.slice(0,1):cases) {
+  const fixture=await readFile(join(qa,item.id+'.sav'));
+  const states={};
+  for(const kind of ['base','fixed']) {
+    const start=kind==='fixed'?item.expected:item.start;
+    const browser=await boot(kind,fixture,start);
+    try {
+      const position=await browser.state();
+      const snapshot=await browser.evaluate('qa.snapshot()');
+      assert.equal(snapshot.version,12);assert.equal(snapshot.hp,7);
+      assert.equal(partnerPP(snapshot),1,'The depleted first move PP must survive native Continue');
+      states[kind]={position,snapshot};
+      if(item.authentic || item.id==='control-76-14-38')await browser.shot(kind+'-'+item.id);
+      if(kind==='fixed'&&!item.control) {
+        let moved=false;
+        for(const key of ['Down','Left','Right','Up']) {
+          // A changed facing needs its native turn delay before the first step.
+          await browser.evaluate('qa.press('+JSON.stringify(key)+',36,40)');
+          const next=await browser.state();
+          if(next.field&&[next.map,next.x,next.y].join(',')!==start.join(',')){moved=true;break;}
+        }
+        if(!moved)await browser.shot('blocked-'+item.id);
+        assert(moved,'Repaired player could not leave arrival cell: '+item.id+' '+JSON.stringify(await browser.state()));
+      }
+    } finally {browser.close();}
+  }
+  assert.deepEqual(states.fixed.snapshot,states.base.snapshot,'Native party/HP/PP/progress/preferences changed: '+item.id);
+  results.push({id:item.id,pending:!!item.pending,authentic:!!item.authentic,control:!!item.control,
+                before:item.start,after:item.expected,protectedNativeBytesIdentical:true,hp:states.fixed.snapshot.hp,move1PP:partnerPP(states.fixed.snapshot)});
+  await writeFile(join(qa,process.argv.includes('--party-input-proof-only')?'party-input-proof.json':'native-continue-results.json'),JSON.stringify(results,null,2)+'\n');
+  console.log('PASS '+item.id+' '+item.start+' -> '+item.expected+'; protected native bytes identical');
+}
