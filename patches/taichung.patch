+}
+
+// Only the shared after-win script calls these adapters. Collection/history reads
+// never consume or create an award, and no new progress field is stored.
+void TaichungBadge_ScriptPrepareAward(void)
+{
+    sPreparedAward = TAICHUNG_GYM_NONE;
+    gSpecialVar_Result = FALSE;
+    if (QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+    {
+        TaichungGymCancelChallenge();
+        return;
+    }
+    if (TaichungGymConsumeNewBadge(gSpecialVar_0x8004))
+    {
+        sPreparedAward = gSpecialVar_0x8004;
+        gSpecialVar_Result = TRUE;
+    }
+}
+
+void TaichungBadge_ScriptOpenAward(void)
+{
+    u16 gym = sPreparedAward;
+    sPreparedAward = TAICHUNG_GYM_NONE;
+    CleanupOverworldWindowsAndTilemaps();
+    if (gym < TAICHUNG_GYM_COUNT && TaichungGymIsComplete(gym))
+        ShowTaichungBadgeAward(gym, CB2_ReturnToFieldContinueScriptPlayMapMusic);
+    else
+        SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+}
