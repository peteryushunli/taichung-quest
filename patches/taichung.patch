+class Builder:
+    def __init__(self, ref=BASE):
+        self.ref = ref
+        self._tmp, self.base = base_tree(ref)
+        self.plan = draft.load_plan((ROOT / PLAN).parent)
+        self.kit = {name: int(v, 16) for name, v in json.loads((ROOT / KIT).read_text())["metatiles"].items()}
+        self.outputs = {}
+        self.edge_ids = {}   # (paving, kit edges) -> the shared OldCore / Old City North definition
+        self.report = {"base": git("rev-parse", "--short", ref, text=True).strip()}
+
+    # ----------------------------------------------------------------- landmarks and grids
+    def pieces(self):
+        banks = {name: lr.Tiles(self.base, *spec[:2]) for name, spec in landmark_tiles.BANKS.items()}
+        banks["Old City North"] = lr.Tiles(self.base, "gTileset_TaichungOldCorePrimary", "gTileset_TaichungOldCore", fresh=True)
+        self.banks = banks
+        return {n: fn(banks[bank]) for n, (_, bank, fn) in lr.LANDMARKS.items()}
+
+    def grids(self):
+        draft._PRIMARY["source"] = self.base
+        self.landmarks = self.pieces()
+        fitted = {}
+        for n, piece in self.landmarks.items():
+            bank = lr.LANDMARKS[n][1]
+            open_cells = {piece.bank.render_layers(piece.bank.layers(m)).tobytes(): cls
+                          for m, cls in draft.OPEN_CELLS[bank].items()}
+            fitted[n] = (piece.render, open_cells)
+        self.gw = draft.greenway(self.base, self.plan, fitted)
+        self.oc = draft.old_city(self.base, self.plan, fitted)
+        for name, (style, x0, y0) in STYLE_SOURCES.items():
+            for dy, row in enumerate(style):
+                for dx, m in enumerate(row):
+                    assert self.oc.old[(y0 + dy) * 40 + x0 + dx] & 0x3FF == m, (name, dx, dy)
+        live = self.oc.old
+        for dy, row in enumerate(FIRERED_HOUSE):
+            for dx, m in enumerate(row):
+                assert any(w & 0x3FF == m for w in live[54 * 40:63 * 40]), hex(m)
+
+    # ----------------------------------------------------------------- cells to words
+    def water_kind(self, g, x, y):
+        wx, wy = x + g.ox, y + g.oy
+        cls = g.c[y][x]
+        if cls == "lake":
+            return "still"
+        kind = None
+        for (x0, y0, x1, y1), flow in RIVER_FLOW if cls == "riv" else CANAL_FLOW:
+            if x0 <= wx < x1 and y0 <= wy < y1:
+                kind = flow
+        assert kind, (g.name, x, y, cls)
+        return kind
+
+    def wet(self, g, x, y):
+        """Water for bank shapes: water cells, bridged cells over water, and beyond the map edge."""
+        if not (0 <= x < g.w and 0 <= y < g.h):
+            return True
+        if g.c[y][x] in ("hwy", "culvert") and y + 1 < g.h and g.c[y + 1][x] in draft.WATER:
+            return True     # the water runs on under the highway deck or the wall's culvert
+        return g.c[y][x] in draft.WATER or (x, y) in g.under
+
+    def water_piece(self, g, x, y):
+        kind = self.water_kind(g, x, y)
+        land = {d: not self.wet(g, x + dx, y + dy) for d, (dx, dy) in
+                {"n": (0, -1), "s": (0, 1), "w": (-1, 0), "e": (1, 0), "nw": (-1, -1), "ne": (1, -1), "sw": (-1, 1), "se": (1, 1)}.items()}
+        if land["n"] and land["s"] or land["w"] and land["e"]:
+            raise ValueError(f"{g.name} {x},{y}: water one cell wide")
+        part = next((f"outer-{a}{b}" for a in "ns" for b in "we" if land[a] and land[b]), None)
+        part = part or next((f"bank-{d}" for d in "nswe" if land[d]), None)
+        part = part or next((f"inner-{d}" for d in ("nw", "ne", "sw", "se") if land[d]), "body")
+        if y > 0 and g.c[y - 1][x] == "hwy" and kind == "south":
+            part = {"body": "body-under-n", "bank-w": "bank-w-abut-n", "bank-e": "bank-e-abut-n"}[part]
+        return self.kit[f"wa-{kind}-{part}"]
+
+    def street_parts(self, g):
+        parts = {}
+        for s in g.streets:
+            for i in range(len(s["profile"])):
+                for t in range(s["span"][0], s["span"][1] + 1):
+                    cell = (t, s["at"] + i) if s["axis"] == "h" else (s["at"] + i, t)
+                    parts.setdefault(cell, (s["axis"], i, len(s["profile"])))
+        return parts
+
+    def resolve(self, g, landmark_ids, partial=False):
+        """Every cell of a draft grid -> map word. `partial` leaves landmarks not yet installed as 0."""
+        kit, words, made = self.kit, {}, {}
+        old_city = g.name == "TaichungOldCity"
+        pavers = PAVERS if old_city else SIDEWALK
+        yard = PAVERS if old_city else GRASS
+        parts = self.street_parts(g)
+        rng = {lane: random.Random(f"hwy-{lane}") for lane in range(6)}
+        cars = {lane: {wx: rng[lane].choice(("red", "blue", "maroon")) for wx in range(-3, 124) if rng[lane].random() < 1 / 7}
+                for lane in range(6)}
+        trees = set()
+        for (x0, y0, x1, y1, cls, (name, rows, cols)) in g.lot_rects:
+            assert all(g.c[y][x] == cls for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)), (g.name, x0, y0)
+            assert (len(cols), len(rows)) == (x1 - x0 + 1, y1 - y0 + 1), (g.name, x0, y0)
+            for dy, r in enumerate(rows):
+                for dx, c in enumerate(cols):
+                    words[(x0 + dx, y0 + dy)], made[(x0 + dx, y0 + dy)] = SOLID | STYLES[name][r][c], cls
+        for y in range(g.h):
+            for x in range(g.w):
+                if (x, y) in words:
+                    continue
+                cls = g.c[y][x]
+                if (x, y) in landmark_ids:
+                    word = landmark_ids[(x, y)] | (WALK if cls in draft.WALKABLE else SOLID)
+                elif (x, y) in g.art:
+                    ox, oy = g.art[(x, y)]
+                    word = g.old[oy * g.old_w + ox]
+                    cls = "live"
+                elif (x, y) in g.prefab_ids:
+                    word = SOLID | g.prefab_ids[(x, y)]
+                elif cls == "hwy":
+                    car = cars[y].get(x + g.ox)
+                    word = SOLID | kit[f"hw-ew-{y}-car-{car}" if car else f"hw-ew-{y}"]
+                elif cls in draft.WATER:
+                    word = WET | self.water_piece(g, x, y)
+                elif cls == "wall":
+                    word = SOLID | kit["wall-n-upper" if g.get(x, y - 1) == "hwy" else "wall-n-lower"]
+                elif cls == "culvert":     # the arch over a two-wide channel
+                    row, side = "n" if g.get(x, y - 1) == "hwy" else "s", "w" if g.get(x - 1, y) != "culvert" else "e"
+                    word = SOLID | kit[f"wall-culvert-{row}{side}"]
+                elif self.edge_overlays(g, x, y):
+                    base = pavers if cls == "pave" else SIDEWALK
+                    overlays = self.edge_overlays(g, x, y)
+                    assert cls in ("side", "walk", "pave"), (g.name, x, y, cls)
+                    if base == SIDEWALK and len(overlays) == 1:
+                        word = WALK | kit[overlays[0]]
+                    else:
+                        word = WALK | self.edge_ids.get((base, overlays), base)   # base alone before install_edges
+                elif cls == "side":
+                    axis, i, n = parts[(x, y)]
+                    if (x, y) in g.under:
+                        side = ("n" if i == 0 else "s") if axis == "h" else ("w" if i == 0 else "e")
+                        word = WALK | kit[f"br-{'ew' if axis == 'h' else 'ns'}-sidewalk-{side}"]
+                    else:
+                        word = WALK | SIDEWALK
+                elif cls in ("asp", "line_h", "line_v", "xwalk_h", "xwalk_v"):
+                    word = WALK | kit[{"asp": "st-asphalt", "line_h": "st-ew-centre", "line_v": "st-ns-centre",
+                                       "xwalk_h": "st-ew-crosswalk", "xwalk_v": "st-ns-crosswalk"}[cls]]
+                elif cls == "pave":
+                    word = WALK | pavers
+                elif cls == "walk":
+                    word = WALK | SIDEWALK
+                elif cls == "yard":
+                    word = WALK | yard
+                elif cls == "grass":
+                    word = WALK | GRASS
+                elif cls == "tall":
+                    word = WALK | TALL
+                elif cls == "flower":
+                    word = WALK | FLOWER
+                elif cls == "pbridge":     # a path across the water: deck edges where it ends
+                    n, s_ = g.get(x, y - 1) == "pbridge", g.get(x, y + 1) == "pbridge"
+                    word = WALK | kit["pb-ew" if n and s_ else "pb-ew-s" if n else "pb-ew-n" if s_ else "pb-ew-single"]
+                elif cls == "shrub":
+                    word = SOLID | SHRUB
+                elif cls == "tree":
+                    trees.add((x, y))
+                    continue
+                elif cls == "lmk" and partial:
+                    word = SOLID
+                else:
+                    raise ValueError(f"{g.name} {x},{y}: no word for {cls}")
+                words[(x, y)], made[(x, y)] = word, cls
+        # Trees: the plan's 2x2 trees, then whole trees wherever else the draft has room, and a
+        # bush where it has a single cell.
+        for x, y in sorted(g.tree_anchors):
+            block = [(x, y), (x + 1, y), (x, y + 1), (x + 1, y + 1)]
+            assert all(c in trees and c not in words for c in block), (g.name, x, y)
+            for (cx, cy) in block:
+                words[(cx, cy)], made[(cx, cy)] = SOLID | TREE[cy - y][cx - x], "tree"
+        for y in range(g.h):
+            for x in range(g.w):
+                block = [(x, y), (x + 1, y), (x, y + 1), (x + 1, y + 1)]
+                if all(c in trees and c not in words for c in block):
+                    for (cx, cy) in block:
+                        words[(cx, cy)], made[(cx, cy)] = SOLID | TREE[cy - y][cx - x], "tree"
+        for c in trees:
+            if c not in words:
+                words[c], made[c] = SOLID | SHRUB, "shrub"
+        return words, made
+
+    # ----------------------------------------------------------------- tilesets
+    def base_files(self, folder):
+        f = self.base / folder
+        return Sheet(f / "tiles.png"), read_defs(f / "metatiles.bin"), read_attrs(f / "metatile_attributes.bin")
+
+    def primary_pixels(self, folder):
+        return np.array(Image.open(self.base / folder / "tiles.png"), dtype=np.uint8)
+
+    def install_greenway(self):
+        sheet, defs, attrs = self.base_files("data/tilesets/secondary/taichung_greenway_cmp")
+        first = len(sheet.tiles)
+        inst = Install(self.banks["Greenway"], sheet, defs, attrs, range(first, SLOTS),
+                       range(NUM_PRIMARY + len(defs), NUM_PRIMARY + DEFS),
+                       self.primary_pixels("data/tilesets/primary/taichung_greenway_private"))
+        inst.primary_attrs = read_attrs(self.base / "data/tilesets/primary/taichung_greenway_private/metatile_attributes.bin")
+        for n in range(len(sheet.tiles)):
+            inst.know(NUM_PRIMARY + n, sheet.tiles[n])
+        ids = {13: inst.piece(self.landmarks[13])}
+        self.write_tileset("data/tilesets/secondary/taichung_greenway_cmp", sheet, defs, attrs)
+        self.report["GreenwayCmp"] = {"tilesAdded": len(inst.added_tiles), "slots": [min(inst.added_tiles), max(inst.added_tiles)],
+                                      "definitionsAdded": len(inst.added_defs),
+                                      "ids": [hex(min(inst.added_defs)), hex(max(inst.added_defs))]}
+        return ids
+
+    def install_old_core(self, kept_ids):
+        """16 into OldCore: tiles into slots no kept definition draws, definitions into IDs
+        today's map does not use and the new map does not keep."""
+        sheet, defs, attrs = self.base_files("data/tilesets/secondary/taichung_old_core")
+        live = {w & 0x3FF for w in self.oc.old}
+        # 16 also lifts top layers from OldCore definitions it relayers, so their tiles stay.
+        reused = {c[1] for row in self.landmarks[16].cells for c in row if c[0] in ("meta", "relayer")}
+        used_slots = secondary_tiles(defs, set(kept_ids) | reused)
+        free_slots = [s for s in range(SLOTS) if s not in used_slots]
+        free_ids = [m for m in range(NUM_PRIMARY, NUM_PRIMARY + DEFS) if m not in kept_ids and m not in live]
+        inst = Install(self.banks["Old City"], sheet, defs, attrs, free_slots, free_ids,
+                       self.primary_pixels("data/tilesets/primary/taichung_old_core"))
+        inst.primary_attrs = read_attrs(self.base / "data/tilesets/primary/taichung_old_core/metatile_attributes.bin")
+        for n in sorted(used_slots):
+            inst.know(NUM_PRIMARY + n, sheet.tiles[n])
+        ids = {16: inst.piece(self.landmarks[16])}
+        self.old_core = (sheet, defs, attrs, inst)
+        self.report["OldCore"] = {"tilesAdded": len(inst.added_tiles), "slots": sorted(inst.added_tiles),
+                                  "freeSlotsBefore": len(free_slots), "keptDefinitions": len([m for m in kept_ids if m >= NUM_PRIMARY]),
+                                  "definitionsAdded": len(inst.added_defs), "ids": [hex(m) for m in inst.added_defs]}
+        return ids
+
+    def install_north(self):
+        """Old City North's new secondary: OldCore's palettes, city-v3 styles and FireRed house at
+        the same slots and IDs, then 14, 15 and 17."""
+        old_sheet, old_defs, old_attrs = self.base_files("data/tilesets/secondary/taichung_old_core")
+        sheet = Sheet(slots=SLOTS)
+        sheet.palette = old_sheet.palette
+        defs, attrs = [[0] * 8 for _ in range(DEFS)], [0] * DEFS
+        carry = sorted(set(CITY_V3) | set(FIRERED_IDS))
+        carried = secondary_tiles(old_defs, carry)
+        for s in carried:
+            sheet.put(s, old_sheet.tiles[s].copy())
+        for m in carry:
+            defs[m - NUM_PRIMARY], attrs[m - NUM_PRIMARY] = list(old_defs[m - NUM_PRIMARY]), old_attrs[m - NUM_PRIMARY]
+        free_ids = [m for m in range(NUM_PRIMARY, NUM_PRIMARY + DEFS) if m not in carry]
+        inst = Install(self.banks["Old City North"], sheet, defs, attrs, [s for s in range(SLOTS) if s not in carried],
+                       free_ids, self.primary_pixels("data/tilesets/primary/taichung_old_core"))
+        inst.primary_attrs = read_attrs(self.base / "data/tilesets/primary/taichung_old_core/metatile_attributes.bin")
+        for s in sorted(carried):
+            inst.know(NUM_PRIMARY + s, sheet.tiles[s])
+        ids = {}
+        for n in (14, 15, 17):
+            piece = self.landmarks[n]
+            assert all(c[1] < NUM_PRIMARY for row in piece.cells for c in row if c[0] == "meta"), n
+            ids[n] = inst.piece(piece)
+        self.north = (sheet, defs, attrs, inst, carried)
+        for p in range(16):
+            self.outputs[f"{OCN_DIR}/palettes/{p:02}.pal"] = (self.base / f"data/tilesets/secondary/taichung_old_core/palettes/{p:02}.pal").read_bytes()
+        self.report["OldCityNorth"] = {"carriedTiles": len(carried), "carriedDefinitions": len(carry),
+                                       "tilesAdded": len(inst.added_tiles), "definitionsAdded": len(inst.added_defs),
+                                       "freeTiles": SLOTS - len(carried) - len(inst.added_tiles),
+                                       "freeDefinitions": DEFS - len(carry) - len(inst.added_defs)}
+        return ids
+
+    def install_edges(self):
+        """Paving with kit edges the kit has no single piece for (`edge_combos`): one definition
+        each, at the lowest ID free in both OldCore and Old City North, so the two maps draw it
+        alike in each other's connection strip. It draws primary tiles only. Then both secondaries
+        are written."""
+        o_sheet, o_defs, o_attrs, o_inst = self.old_core
+        n_sheet, n_defs, n_attrs, n_inst, carried = self.north
+        common = [m for m in o_inst.free_ids if m in set(n_inst.free_ids)]
+        for key, (words, attr) in self.edge_combos().items():
+            m = common.pop(0)
+            for defs, attrs in ((o_defs, o_attrs), (n_defs, n_attrs)):
+                while len(defs) <= m - NUM_PRIMARY:
+                    defs.append([0] * 8)
+                    attrs.append(0)
+                defs[m - NUM_PRIMARY], attrs[m - NUM_PRIMARY] = list(words), attr
+            self.edge_ids[key] = m
+        self.write_tileset("data/tilesets/secondary/taichung_old_core", o_sheet, o_defs, o_attrs)
+        last = max(m for m in range(NUM_PRIMARY, NUM_PRIMARY + DEFS) if any(n_defs[m - NUM_PRIMARY]))
+        n_defs, n_attrs = n_defs[:last - NUM_PRIMARY + 1], n_attrs[:last - NUM_PRIMARY + 1]
+        while not n_sheet.tiles[-1].any() and len(n_sheet.tiles) > max(carried | set(n_inst.added_tiles)) + 1:
+            n_sheet.tiles.pop()
+        self.write_tileset(OCN_DIR, n_sheet, n_defs, n_attrs)
+        self.report["edgeDefinitions"] = {f"{base:#05x} + {' + '.join(overlays)}": hex(m) for (base, overlays), m in self.edge_ids.items()}
+        self.report["OldCityNorth"]["freeDefinitions"] -= len(self.edge_ids)
+
+    def write_tileset(self, folder, sheet, defs, attrs):
+        self.outputs[f"{folder}/tiles.png"] = sheet.png()
+        self.outputs[f"{folder}/metatiles.bin"] = pack_words([w for d in defs for w in d])
+        self.outputs[f"{folder}/metatile_attributes.bin"] = struct.pack(f"<{len(attrs)}I", *attrs)
+
+    # ----------------------------------------------------------------- maps
+    def landmark_cells(self, g, ids):
+        out = {}
+        for lm in g.landmarks:
+            x0, y0 = lm["rect"][:2]
+            for (dx, dy), m in ids.get(lm["n"], {}).items():
+                out[(x0 + dx, y0 + dy)] = m
+        return out
+
+    def edge_overlays(self, g, x, y):
+        """Kit edges on a paved cell: bollards on the side its street's asphalt comes from (a
+        kerb), a railing on the side or two sides that meet water (not on a bridge), or an inner
+        corner where water touches only the corner a canal ends at (not where a bridge spans it)."""
+        out = ()
+        if (x, y) in g.kerbs:
+            out += (f"st-bollards-{next(d for d, (dx, dy) in SIDES.items() if g.get(x + dx, y + dy) in ROAD)}",)
+        if (x, y) in g.railings:
+            wx, wy = x + g.ox, y + g.oy
+            out += ("st-rail-" + "".join(d for d, (dx, dy) in SIDES.items() if g.cells.get((wx + dx, wy + dy)) == "~"),)
+        if (x, y) in g.rail_corners:
+            out += (f"st-rail-inner-{g.rail_corners[(x, y)]}",)
+        return out
+
+    def paved(self, base, overlays):
+        """(words, attribute) of a paving metatile carrying the kit edges' upper layers. The kit
+        draws them over the sidewalk, so the same tiles go over any paving; the railing on a
+        south edge stands in front of the player, so its layer type wins."""
+        defs = read_defs(self.base / "data/tilesets/primary/taichung_old_core/metatiles.bin")
+        attrs = read_attrs(self.base / "data/tilesets/primary/taichung_old_core/metatile_attributes.bin")
+        assert not any(defs[base][4:]) and attrs[base] == 0, hex(base)
+        top, attr = [0] * 4, None
+        for name in overlays:
+            words = defs[self.kit[name]]
+            assert words[:4] == defs[SIDEWALK][:4], name
+            for q, w in enumerate(words[4:]):
+                if w:
+                    assert not top[q], overlays
+                    top[q] = w
+            attr = attrs[self.kit[name]] if attr is None else min(attr, attrs[self.kit[name]])
+        return defs[base][:4] + top, attr
+
+    def edge_combos(self):
+        """Every paving-and-edges combination the kit has no single piece for, on Old City's grid."""
+        g, out = self.oc, {}
+        for y in range(g.h):
+            for x in range(g.w):
+                overlays = self.edge_overlays(g, x, y)
+                base = PAVERS if g.c[y][x] == "pave" else SIDEWALK
+                if overlays and (base != SIDEWALK or len(overlays) > 1):
+                    out[(base, overlays)] = self.paved(base, overlays)
+        assert all(len(self.edge_overlays(self.gw, x, y)) <= 1 for y in range(self.gw.h) for x in range(self.gw.w)), \
+            "Greenway's edges are all single kit pieces on the sidewalk"
+        return dict(sorted(out.items()))
+
+    def rows(self, name):
+        """A map's grid and its rows in that grid."""
+        if MAPS[name][1] is None:
+            return self.gw, (0, self.gw.h)
+        g = self.oc
+        return g, ((0, g.split) if MAPS[name][1] == "north" else (g.split, g.h))
+
+    def build(self):
+        self.grids()
+        ids = self.install_greenway()
+        ids.update(self.install_north())
+        # Old City's words without 16 first: they decide which OldCore definitions stay.
+        oc_words, _ = self.resolve(self.oc, {}, partial=True)
+        split = self.oc.split
+        lm16 = next(lm for lm in self.oc.landmarks if lm["n"] == 16)
+        x0, y0, x1, y1 = lm16["rect"]
+        kept = {w & 0x3FF for (x, y), w in oc_words.items() if y >= split and not (x0 <= x <= x1 and y0 <= y <= y1)}
+        ids.update(self.install_old_core(kept))
+        self.install_edges()
+        self.words, self.made = {}, {}
+        gw_words, self.made["TaichungGreenway"] = self.resolve(self.gw, self.landmark_cells(self.gw, ids))
+        oc_words, made = self.resolve(self.oc, self.landmark_cells(self.oc, ids))
+        for _, (x, y), _ in place_signs(self.oc):
+            assert self.oc.c[y][x] in draft.FREE, (x, y, self.oc.c[y][x])
+            oc_words[(x, y)], made[(x, y)] = WALK | SOLID | SIGNPOST, "sign"   # as the live signs
+        self.seam_hedges(gw_words, oc_words, made)
+        self.words["TaichungGreenway"] = [gw_words[(x, y)] for y in range(self.gw.h) for x in range(self.gw.w)]
+        for name in ("TaichungOldCityNorth", "TaichungOldCity"):
+            _, (r0, r1) = self.rows(name)
+            self.words[name] = [oc_words[(x, y)] for y in range(r0, r1) for x in range(self.oc.w)]
+            self.made[name] = {(x, y - r0): made[(x, y)] for (x, y) in made if r0 <= y < r1}
+        for name, words in self.words.items():
+            folder = f"data/layouts/{name}"
+            self.outputs[f"{folder}/map.bin"] = pack_words(words)
+            water = WET | self.kit["wa-still-body"]
+            border = [SOLID | 0x00E, SOLID | 0x00F, SOLID | 0x016, SOLID | 0x017] if name == "TaichungGreenway" else [water] * 4
+            self.outputs[f"{folder}/border.bin"] = pack_words(border)
+        self.registries()
+        return self
+
+    def seam_pairs(self):
+        """Cells that face each other across the seams between these three maps, in grid cells:
+        Greenway's east column against Old City North's and Old City's west one (the grids share
+        their rows), and Old City North's last row against Old City's first."""
+        gw, oc = self.gw, self.oc
+        assert gw.oy == oc.oy and gw.ox + gw.w == oc.ox
+        pairs = [(("gw", gw.w - 1, y), ("oc", 0, y)) for y in range(min(gw.h, oc.h))]
+        return pairs + [(("oc", x, oc.split - 1), ("oc", x, oc.split)) for x in range(oc.w)]
+
+    def seam_hedges(self, gw_words, oc_words, made):
+        """An open cell must step onto open ground across a seam (validate_city). Where the
+        draft leaves paving, lawn or tall grass facing a tree, building or stall across one, it
+        becomes a shrub: a short hedge along the map edge."""
+        grids = {"gw": (self.gw, gw_words, self.made["TaichungGreenway"]), "oc": (self.oc, oc_words, made)}
+        hedges, grown = [], True
+        while grown:        # a hedge can face a cell already checked (Old City North's corner)
+            grown = False
+            for a, b in self.seam_pairs():
+                for (ka, xa, ya), (kb, xb, yb) in ((a, b), (b, a)):
+                    ga, wa, ma = grids[ka]
+                    wb = grids[kb][1][(xb, yb)]
+                    if wa[(xa, ya)] & 0xC00 or not wb & 0xC00:
+                        continue
+                    assert ga.c[ya][xa] in draft.FREE | {"tall"}, (ka, xa, ya, ga.c[ya][xa])
+                    wa[(xa, ya)], ma[(xa, ya)] = SOLID | SHRUB, "hedge"
+                    hedges.append([ka, xa, ya])
+                    grown = True
+        for a, b in self.seam_pairs():
+            wa, wb = grids[a[0]][1][a[1:]], grids[b[0]][1][b[1:]]
+            assert wa & 0xC00 or wb & 0xC00 or wa >> 12 == wb >> 12, (a, b)
+        self.report["seamHedges"] = len(hedges)
+
+    # ----------------------------------------------------------------- registries and events
+    def base_text(self, rel):
+        return git("show", f"{self.ref}:{rel}", text=True)
+
+    def base_json(self, rel):
+        return json.loads(self.base_text(rel))
+
+    def put_json(self, rel, data):
+        self.outputs[rel] = (json.dumps(data, indent=2, ensure_ascii=False) + "\n").encode()
+
+    def connections(self, name):
+        rects = {key: self.plan["districts"][key]["plan"] for key in self.plan["districts"]}
+        frames = {"TaichungGreenway": rects["greenway"], "TaichungOldCityNorth": rects["oldcity_north"],
+                  "TaichungOldCity": rects["oldcity"], "TaichungXitun": rects["xitun"],
+                  "TaichungNantunNorth": rects["north"], "TaichungNantunWanhe": rects["wanhe"]}
+        links = {"TaichungGreenway": [("TaichungOldCityNorth", "right"), ("TaichungOldCity", "right"), ("TaichungXitun", "left"),
+                                      ("TaichungNantunNorth", "left"), ("TaichungNantunWanhe", "down")],
+                 "TaichungOldCityNorth": [("TaichungGreenway", "left"), ("TaichungOldCity", "down")],
+                 "TaichungOldCity": [("TaichungOldCityNorth", "up"), ("TaichungGreenway", "left"), ("TaichungNantunWanhe", "left")]}
+        me = frames[name]
+        out = []
+        for other, direction in links[name]:
+            o = frames[other]
+            offset = o[1] - me[1] if direction in ("left", "right") else o[0] - me[0]
+            out.append({"map": "MAP_" + draft_snake(other), "offset": offset, "direction": direction})
+        return out
+
+    def events(self):
+        """Doors, signs and guides on each new map, from the drafts."""
+        gw, oc, split = self.gw, self.oc, self.oc.split
+        out = {}
+        for name, g, base_name, rows in (("TaichungGreenway", gw, "TaichungGreenway", (0, gw.h)),
+                                         ("TaichungOldCity", oc, "TaichungOldCity", (split, oc.h))):
+            m = self.base_json(f"data/maps/{base_name}/map.json")
+            dy = -rows[0]
+            assert len(m["warp_events"]) == len(g.doors) and len(m["bg_events"]) == len(g.signs)
+            for warp, door in zip(m["warp_events"], g.doors):
+                warp["x"], warp["y"] = door["door"][0], door["door"][1] + dy
+            for sign, s in zip(m["bg_events"], g.signs):
+                sign["x"], sign["y"] = s["at"][0], s["at"][1] + dy
+            for obj, npc in zip(m["object_events"], g.npcs):
+                obj["x"], obj["y"] = npc["at"][0], npc["at"][1] + dy
+            out[name] = m
+        north = self.base_json("data/maps/TaichungOldCity/map.json")
+        north.update({"id": "MAP_TAICHUNG_OLD_CITY_NORTH", "name": "TaichungOldCityNorth", "layout": "LAYOUT_TAICHUNG_OLD_CITY_NORTH",
+                      "object_events": [], "warp_events": [], "coord_events": [], "bg_events": []})
+        out["TaichungOldCityNorth"] = north
+        for g in (gw, oc):
+            for lm in g.landmarks:
+                x, y = lm["sign"]["at"]
+                name = "TaichungGreenway" if g is gw else "TaichungOldCityNorth" if y < split else "TaichungOldCity"
+                y -= split if name == "TaichungOldCity" else 0
+                out[name]["bg_events"].append({"type": "sign", "x": x, "y": y, "elevation": 0,
+                                               "player_facing_dir": "BG_EVENT_PLAYER_FACING_ANY",
+                                               "script": f"TaichungCity_Sign_{LANDMARK_SIGNS[lm['n']][0]}"})
+        for label, (x, y), _ in place_signs(oc):
+            name = "TaichungOldCityNorth" if y < split else "TaichungOldCity"
+            out[name]["bg_events"].append({"type": "sign", "x": x, "y": y - (split if y >= split else 0), "elevation": 0,
+                                           "player_facing_dir": "BG_EVENT_PLAYER_FACING_ANY",
+                                           "script": f"TaichungCity_Sign_{label}"})
+        for name, m in out.items():
+            m["connections"] = self.connections(name)
+        return out
+
+    def registries(self):
+        maps = self.events()
+        for name, m in maps.items():
+            self.put_json(f"data/maps/{name}/map.json", m)
+        self.outputs["data/maps/TaichungOldCityNorth/scripts.inc"] = (
+            "TaichungOldCityNorth_MapScripts::\n"
+            "\tmap_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition\n"
+            "\tmap_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition\n"
+            "\t.byte 0\n").encode()
