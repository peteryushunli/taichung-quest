diff --git a/src/taichung_language_bridge.c b/src/taichung_language_bridge.c
new file mode 100644
index 0000000..234d028
--- /dev/null
+++ b/src/taichung_language_bridge.c
@@ -0,0 +1,83 @@
+#include "global.h"
+#include "event_data.h"
+#include "field_message_box.h"
+#include "link.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "quest_log.h"
+#include "script.h"
+#include "taichung_language.h"
+#include "taichung_language_bridge.h"
+#include "text.h"
+
+EWRAM_DATA volatile struct TaichungLanguageBridge gTaichungLanguageBridge = {0};
+static EWRAM_DATA bool8 sHasEnteredOverworld = FALSE;
+static EWRAM_DATA bool8 sApplyingBrowserRequest = FALSE;
+
+static bool8 SaveVariablesReady(void)
+{
+    u32 address = (u32)gSaveBlock1Ptr;
+
+    // Pointers exist during the title screen, before a new game/save has been
+    // initialized. Do not inspect them until a real field callback has run.
+    if (Overworld_IsMainFieldCallback())
+        sHasEnteredOverworld = TRUE;
+    return sHasEnteredOverworld
+        && address >= EWRAM_START
+        && address <= EWRAM_END - sizeof(*gSaveBlock1Ptr)
+        && (address & 3) == 0;
+}
+
+static bool8 IsSafeField(bool8 gameCallbacksRan)
+{
+    u8 printer;
+
+    if (!gameCallbacksRan || !Overworld_IsMainFieldCallback()
+        || gMain.inBattle || gPaletteFade.active
+        || gReceivedRemoteLinkPlayers || IsUpdateLinkStateCBActive()
+        || ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled()
+        || !IsFieldMessageBoxHidden()
+        || QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+        return FALSE;
+
+    for (printer = 0; printer < NUM_TEXT_PRINTERS; printer++)
+    {
+        if (IsTextPrinterActive(printer))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static bool8 ApplyBrowserLanguage(u8 language)
+{
+    bool8 written;
+
+    sApplyingBrowserRequest = TRUE;
+    written = VarSet(TAICHUNG_LANGUAGE_VAR, language);
+    sApplyingBrowserRequest = FALSE;
+    return written;
+}
+
+void TaichungLanguageBridge_OnNativeChoice(u16 language)
+{
+    if (!sApplyingBrowserRequest)
+        TaichungLanguageBridge_PublishNativeChoice(&gTaichungLanguageBridge, language);
+}
+
+void TaichungLanguageBridge_Tick(bool8 gameCallbacksRan)
+{
+    bool8 ready = SaveVariablesReady();
+    u16 language = 0;
+
+    // VarGet can replay quest-log values. Reading this one saved variable
+    // directly publishes the current preference without those side effects.
+    if (ready)
+        language = gSaveBlock1Ptr->vars[TAICHUNG_LANGUAGE_VAR - VARS_START];
+
+    TaichungLanguageBridge_UpdatePacket(&gTaichungLanguageBridge,
+                                       (u32)&gTaichungLanguageBridge,
+                                       language <= 2 ? language : 0,
+                                       ready, ready && IsSafeField(gameCallbacksRan),
+                                       ApplyBrowserLanguage);
+}
diff --git a/src/taichung_language_bridge_protocol.c b/src/taichung_language_bridge_protocol.c
new file mode 100644
index 0000000..08f92e7
--- /dev/null
+++ b/src/taichung_language_bridge_protocol.c
@@ -0,0 +1,116 @@
+#include <stddef.h>
+#include "taichung_language_bridge.h"
+
+typedef char PacketSizeCheck[sizeof(struct TaichungLanguageBridge) == TAICHUNG_LANGUAGE_BRIDGE_SIZE ? 1 : -1];
+typedef char FrameOffsetCheck[offsetof(struct TaichungLanguageBridge, frameCounter) == 16 ? 1 : -1];
+typedef char RequestOffsetCheck[offsetof(struct TaichungLanguageBridge, requestSequence) == 24 ? 1 : -1];
+typedef char AckOffsetCheck[offsetof(struct TaichungLanguageBridge, ackSequence) == 28 ? 1 : -1];
+
+static bool8 IsLanguage(u16 language)
+{
+    return language == 1 || language == 2;
+}
+
+static bool8 HasHeader(volatile struct TaichungLanguageBridge *packet)
+{
+    return packet->magicA == TAICHUNG_LANGUAGE_BRIDGE_MAGIC_A
+        && packet->magicB == TAICHUNG_LANGUAGE_BRIDGE_MAGIC_B
+        && packet->version == TAICHUNG_LANGUAGE_BRIDGE_VERSION
+        && packet->size == TAICHUNG_LANGUAGE_BRIDGE_SIZE;
+}
+
+static void InitializePacket(volatile struct TaichungLanguageBridge *packet, u32 selfGbaAddress)
+{
+    packet->magicA = 0;
+    packet->magicB = 0;
+    packet->version = TAICHUNG_LANGUAGE_BRIDGE_VERSION;
+    packet->size = TAICHUNG_LANGUAGE_BRIDGE_SIZE;
+    packet->selfGbaAddress = selfGbaAddress;
+    packet->frameCounter = 0;
+    packet->activeLanguage = 0;
+    packet->requestedLanguage = 0;
+    packet->flags = 0;
+    packet->result = TAICHUNG_LANGUAGE_BRIDGE_NONE;
+    packet->requestSequence = 0;
+    packet->ackSequence = 0;
+    // Publish the signature after the remaining fields are initialized.
+    packet->magicB = TAICHUNG_LANGUAGE_BRIDGE_MAGIC_B;
+    packet->magicA = TAICHUNG_LANGUAGE_BRIDGE_MAGIC_A;
+}
+
+static void Acknowledge(volatile struct TaichungLanguageBridge *packet, u32 sequence, u8 result)
+{
+    packet->requestedLanguage = 0;
+    packet->result = result;
+    packet->ackSequence = sequence;
+}
+
+void TaichungLanguageBridge_PublishNativeChoice(volatile struct TaichungLanguageBridge *packet, u16 language)
+{
+    u32 sequence;
+
+    if (!IsLanguage(language) || !HasHeader(packet))
+        return;
+
+    packet->activeLanguage = language;
+    sequence = packet->requestSequence;
+    if (sequence != 0 && sequence != packet->ackSequence)
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+}
+
+void TaichungLanguageBridge_UpdatePacket(volatile struct TaichungLanguageBridge *packet,
+                                       u32 selfGbaAddress, u8 nativeLanguage,
+                                       bool8 variablesReady, bool8 safeField,
+                                       TaichungLanguageBridgeWriter writer)
+{
+    u32 sequence;
+    u8 requested;
+    u8 previousLanguage;
+
+    if (!HasHeader(packet) || packet->selfGbaAddress != selfGbaAddress)
+        InitializePacket(packet, selfGbaAddress);
+
+    packet->frameCounter++;
+    if (packet->frameCounter == 0)
+        packet->frameCounter = 1;
+
+    previousLanguage = packet->activeLanguage;
+    packet->activeLanguage = variablesReady && IsLanguage(nativeLanguage) ? nativeLanguage : 0;
+    packet->flags = variablesReady ? TAICHUNG_LANGUAGE_BRIDGE_READY : 0;
+    if (variablesReady && safeField)
+        packet->flags |= TAICHUNG_LANGUAGE_BRIDGE_SAFE_FIELD;
+
+    sequence = packet->requestSequence;
+    requested = packet->requestedLanguage;
+    if (sequence == 0 || sequence == packet->ackSequence)
+        return;
+    // One outstanding request is required. A half-published/replaced request
+    // is left for the next frame, rather than acknowledging the wrong value.
+    if (sequence != packet->requestSequence || requested != packet->requestedLanguage)
+        return;
+
+    // Also catches a native variable change made outside the normal menu hook.
+    if (packet->activeLanguage != 0 && previousLanguage != packet->activeLanguage)
+    {
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+        return;
+    }
+    if (!IsLanguage(requested))
+    {
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_INVALID);
+        return;
+    }
+    if (!variablesReady || packet->activeLanguage == 0)
+    {
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_UNSET);
+        return;
+    }
+    if (!safeField || writer == 0)
+        return;
+
+    if (writer(requested))
+    {
+        packet->activeLanguage = requested;
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_APPLIED);
+    }
+}
diff --git a/src/taichung_save.c b/src/taichung_save.c
new file mode 100644
index 0000000..480c0ba
--- /dev/null
+++ b/src/taichung_save.c
@@ -0,0 +1,86 @@
+#include "global.h"
+#include "event_data.h"
+#include "load_save.h"
+#include "taichung_language.h"
+#include "taichung_save.h"
+#include "constants/maps.h"
+#include "constants/species.h"
+
+#define TAICHUNG_STARTER_VAR 0x40FC
+#define TAICHUNG_TEA_VAR 0x40FD
+
+static u16 SavedVar(u16 id)
+{
+    // Continue and map callbacks can overlap quest-log playback. Preferences
+    // and migration must inspect the current save, not a replayed variable.
+    return gSaveBlock1Ptr->vars[id - VARS_START];
+}
+
+static void SetStationWarp(struct WarpData *warp)
+{
+    warp->mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    warp->mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    warp->warpId = -1;
+    warp->x = 30;
+    warp->y = 66;
+}
+
+void TaichungSaveSetStationCheckpoint(void)
+{
+    SetStationWarp(&gSaveBlock1Ptr->lastHealLocation);
+}
+
+void TaichungSaveInitNewGame(void)
+{
+    VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+    TaichungSaveSetStationCheckpoint();
+}
+
+bool8 TaichungSaveUsesStationCheckpoint(void)
+{
+    const struct WarpData *warp = &gSaveBlock1Ptr->lastHealLocation;
+    return SavedVar(TAICHUNG_SAVE_VERSION_VAR) == TAICHUNG_SAVE_VERSION
+        && warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+}
+
+static bool8 HasPrototypeStarter(void)
+{
+    u16 species = SavedVar(TAICHUNG_STARTER_VAR);
+    return species == SPECIES_BULBASAUR || species == SPECIES_CHARMANDER
+        || species == SPECIES_SQUIRTLE || species == SPECIES_PIKACHU;
+}
+
+void TaichungSaveUpgradeOnContinue(void)
+{
+    bool8 inCity;
+
+    if (SavedVar(TAICHUNG_SAVE_VERSION_VAR) != 0
+        || gSaveBlock1Ptr->playerPartyCount == 0)
+        return;
+
+    // The earliest prototype had a fixed Bulbasaur and only the tea marker.
+    // Untouched FireRed saves have neither marker and are left alone.
+    if (!HasPrototypeStarter())
+    {
+        if (SavedVar(TAICHUNG_STARTER_VAR) != 0 || SavedVar(TAICHUNG_TEA_VAR) == 0)
+            return;
+        VarSet(TAICHUNG_STARTER_VAR, SPECIES_BULBASAUR);
+    }
+
+    if (SavedVar(TAICHUNG_LANGUAGE_VAR) != TAICHUNG_LANGUAGE_EN
+        && SavedVar(TAICHUNG_LANGUAGE_VAR) != TAICHUNG_LANGUAGE_ZH)
+        VarSet(TAICHUNG_LANGUAGE_VAR, TAICHUNG_LANGUAGE_EN);
+
+    inCity = gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY)
+        && gSaveBlock1Ptr->location.mapNum <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM);
+    if (!inCity)
+    {
+        // Use the engine's full map-load path rather than editing a saved
+        // position under an old layout/object-event cache.
+        SetStationWarp(&gSaveBlock1Ptr->continueGameWarp);
+        SetContinueGameWarpStatus();
+    }
+    VarSet(TAICHUNG_SAVE_VERSION_VAR, TAICHUNG_SAVE_VERSION);
+    TaichungSaveSetStationCheckpoint();
+}
