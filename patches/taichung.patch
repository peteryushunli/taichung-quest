+    'data/taichung/optional-story/wanhe-temple.json',
+    'data/taichung/optional-story/wenchang-temple.json',
+    'data/taichung/optional-story/wenxin-forest-park.json',
+    'data/taichung/optional-story/yizhong-street.json',
+    'docs/localization/optional-story-all20-glyphs.json',
+    'docs/localization/optional-story-glyphs.json',
