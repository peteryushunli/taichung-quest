+"""Hand-drawn railway pieces in FireRed's style: RGB555 colours, dark outlines, one light source from the top-left."""
+from PIL import Image
+def q(c): return tuple(v//8*8 for v in c)
+B0,B1,B2,B3=q((150,142,126)),q((110,102,92)),q((186,178,160)),q((128,120,108))
+S0,S1,S2=q((112,78,50)),q((146,104,66)),q((70,46,30))
+R0,R1,R2=q((224,226,232)),q((150,152,166)),q((60,60,76))
+def track():
+    im=Image.new('RGB',(16,16),B0); p=im.load()
+    import random; r=random.Random(7)
+    for y in range(16):
+        for x in range(16):
+            v=r.random()
+            p[x,y]=B1 if v<.07 else B2 if v<.15 else B3 if v<.22 else B0
+    for x0 in (1,6,11):
+        for y in range(2,14):
+            for x in range(x0,x0+3): p[x,y]=S0
+            p[x0,y]=S1; p[x0+2,y]=S2
+        for x in range(x0,x0+3): p[x,2]=S1; p[x,13]=S2
+    for ry in (4,10):
+        for x in range(16): p[x,ry]=R0; p[x,ry+1]=R1; p[x,ry+2]=R2 if p[x,ry+2] in (S0,S1,S2) else B1
+    return im
+def tile_sheet():
+    t=track(); sheet=Image.new('RGB',(16*6,16*3)); 
+    for i in range(6):
+        for j in range(3): sheet.paste(t,(i*16,j*16))
+    return t,sheet
+if __name__=='__main__':
+    t,s=tile_sheet(); t.save('art/track.png'); s.resize((s.width*4,s.height*4),Image.NEAREST).save('art/track-preview.png')
