+"""Night-market pieces in FireRed's manner: RGB555 colours, dark outline, top-left light."""
+from PIL import Image, ImageDraw
+import random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((32,32,48))
+# night asphalt + kerb-less paving
+N0,N1,N2,N3=q((72,72,92)),q((62,62,80)),q((84,84,104)),q((52,52,68))
+GL0,GL1=q((112,100,92)),q((96,88,88))           # warm light spilled from stalls
+BULB,BULB2=q((255,244,176)),q((248,208,96))
+WD0,WD1,WD2=q((184,136,80)),q((152,104,56)),q((104,68,36))
+MT0,MT1,MT2=q((208,212,220)),q((164,168,180)),q((116,120,132))
+WH0,WH1=q((244,240,228)),q((204,200,192))
+COL={'red':(q((224,72,64)),q((176,40,40))),'yellow':(q((248,208,72)),q((208,160,40))),
+     'blue':(q((80,136,216)),q((48,88,168))),'green':(q((88,176,96)),q((48,128,64))),
+     'orange':(q((248,144,56)),q((200,96,32))),'pink':(q((240,136,168)),q((200,88,128))),
+     'white':(WH0,WH1),'teal':(q((72,184,176)),q((40,136,136)))}
+
+def ground(seed=1,glow=False):
+    im=Image.new('RGB',(16,16),N0); p=im.load(); r=random.Random(seed)
+    for y in range(16):
+        for x in range(16):
+            v=r.random(); p[x,y]=N1 if v<.08 else N2 if v<.12 else N0
+    if glow:
+        for y in range(7):
+            for x in range(16):
+                if (x+y)%2==0 or y<4: p[x,y]=GL0 if y<3 else GL1
+    return im
+
+def lanterns(base,colours=('red','orange','yellow'),white=False,phase=0):
+    """a sagging string of paper lanterns across the top of a lane tile (drawn on the cover layer)."""
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    sag=[1,1,2,2,3,3,3,3,3,3,3,3,2,2,1,1]
+    for x in range(16): d.point((x,sag[x]),fill=q((40,40,40)))
+    x=8; c=COL['white'] if white else COL[colours[phase%len(colours)]]
+    y=sag[x]+1
+    d.line([x-1,y,x+2,y],fill=OUT)
+    d.rectangle([x-2,y+1,x+3,y+5],fill=c[0]); d.line([x-2,y+5,x+3,y+5],fill=c[1]); d.line([x+3,y+1,x+3,y+5],fill=c[1])
+    d.line([x-1,y+3,x+2,y+3],fill=c[1] if not white else q((232,200,160)))
+    d.line([x-1,y+6,x+2,y+6],fill=OUT); d.point((x,y+2),fill=BULB if not white else q((255,255,255)))
+    d.point((x,y+7),fill=q((200,40,40)) if not white else q((200,40,40)))
+    return im
+
+def awning(w,colour,stripe='white',base=None,bulbs=True):
+    """top row of a stall: striped canopy seen from the south, w tiles wide (RGBA, opaque)."""
+    W=w*16; im=Image.new('RGBA',(W,16));
+    if base:
+        for i in range(w): im.paste(base,(i*16,0))
+    d=ImageDraw.Draw(im); a=COL[colour]; b=COL[stripe]
+    for x in range(1,W-1):
+        c=a if (x//4)%2==0 else b
+        d.line([x,2,x,9],fill=c[0]); d.point((x,9),fill=c[1])
+    d.line([1,2,W-2,2],fill=q((255,255,255)) if stripe=='white' else b[0])
+    for x0 in range(1,W-1,8):   # scalloped valance
+        c=a if (x0//4)%2==0 else b
+        d.pieslice([x0,7,x0+7,14],0,180,fill=c[1])
+    d.line([0,1,W-1,1],fill=OUT); d.line([0,1,0,10],fill=OUT); d.line([W-1,1,W-1,10],fill=OUT)
+    for x0 in range(1,W-1,8): d.arc([x0,7,x0+7,14],0,180,fill=OUT)
+    if bulbs:
+        for x in range(8,W-4,16): d.rectangle([x-1,13,x+1,15],fill=BULB); d.point((x,12),fill=OUT)
+    return im
+
+def counter(w,goods,panel='wood',base=None,sign=None,menu=True):
+    """bottom row of a stall: lit back, counter with goods, front panel (RGBA)."""
+    W=w*16; im=Image.new('RGBA',(W,16));
+    if base:
+        for i in range(w): im.paste(base,(i*16,0))
+    d=ImageDraw.Draw(im)
+    d.rectangle([1,0,W-2,4],fill=q((88,72,64)))              # lit stall interior
+    d.rectangle([1,0,W-2,1],fill=q((120,96,72)))
+    d.rectangle([0,5,W-1,6],fill=MT0); d.line([0,7,W-1,7],fill=MT2)      # counter top
+    f0,f1,f2=(WD0,WD1,WD2) if panel=='wood' else (MT1,MT2,q((88,92,104))) if panel=='metal' else (COL[panel][0],COL[panel][1],OUT)
+    d.rectangle([1,8,W-2,13],fill=f1); d.line([1,8,W-2,8],fill=f0)
+    if panel=='wood':
+        for x in range(6,W-2,6): d.line([x,9,x,13],fill=f2)
+    d.rectangle([0,4,W-1,14],outline=OUT); d.line([0,0,0,14],fill=OUT); d.line([W-1,0,W-1,14],fill=OUT)
+    d.line([1,15,W-2,15],fill=q((40,40,52)))
+    if menu:
+        mx=W//2-6 if sign is None else 3
+        d.rectangle([mx,9,mx+11,12],fill=WH0,outline=OUT)
+        for i,c in enumerate(('red','yellow','green')): d.rectangle([mx+1+i*4,10,mx+2+i*4,11],fill=COL[c][1])
+    if sign:
+        sx=W-14; d.rectangle([sx,9,sx+10,12],fill=COL[sign][0],outline=OUT); d.line([sx+2,10,sx+8,10],fill=WH0); d.line([sx+3,11,sx+7,11],fill=WH0)
+    G=GOODS.get(goods)
+    if G: G(d,W)
+    return im
+
+def _skewers(d,W):
+    for x in range(3,W-3,3):
+        d.line([x,1,x,5],fill=q((216,192,144))); d.rectangle([x-1,1,x+1,3],fill=q((168,88,48))); d.point((x,1),fill=q((216,128,72)))
+def _tea(d,W):
+    for x in range(3,W-4,5):
+        d.rectangle([x,1,x+3,5],fill=q((232,224,208)),outline=OUT); d.rectangle([x+1,3,x+2,4],fill=q((176,120,72)))
+        d.line([x+2,0,x+3,0],fill=q((240,96,96)))
+def _chicken(d,W):
+    for x in range(2,W-8,9):
+        d.ellipse([x,1,x+7,6],fill=q((224,168,72)),outline=q((152,96,40))); d.point((x+3,3),fill=q((248,208,120)))
