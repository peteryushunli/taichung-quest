+        const fixtureResponse = await fetch('/fixture.sav', { cache: 'no-store' });
+        if (!fixtureResponse.ok) throw new Error(`Native SRAM fixture request failed: ${fixtureResponse.status}`);
+        const fixtureBytes = new Uint8Array(await fixtureResponse.arrayBuffer());
+        if (![0x20000, 0x20010].includes(fixtureBytes.length) || fixtureBytes.length !== qaConfig.fixture.bytes) {
+          throw new Error('Explicit native SRAM fixture has an incompatible size.');
+        }
+        const hash = [...new Uint8Array(await crypto.subtle.digest('SHA-256', fixtureBytes))]
+          .map(byte => byte.toString(16).padStart(2, '0')).join('');
+        if (hash !== qaConfig.fixture.sha256) throw new Error('Native SRAM fixture hash changed.');
+        emulator.FS.writeFile(savePath, fixtureBytes);
+        await emulator.FSSync();
+        saveDescription = `EXPLICIT NATIVE SRAM FIXTURE imported: ${qaConfig.fixture.name} (${fixtureBytes.length} bytes), into ${token}. Choose native Continue; no emulator snapshot or RAM patch was used.`;
+        byId('fixture-status').textContent = saveDescription;
