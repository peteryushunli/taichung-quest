+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+from tempfile import TemporaryDirectory
+
+from PIL import Image, ImageDraw
+
+from color_compile import compile_colorways, color_grid, native_tile_images
+from library import ROOT, parse_words, render_tools, require
+from neighborhood_blocks import block_prefab
+from neighborhood_fill import cells
+from neighborhood_frontage import bay_widths
+from neighborhood_pilot import player_reference
+
+PROPOSAL = ROOT / 'data/taichung/neighborhoods/old-city-route-fill.json'
+MAP_ID = 'MAP_TAICHUNG_OLD_CITY'
+WIDTH, HEIGHT = 40, 72
+ROW_SPECS = [
+    ('west-north-upper', [2, 2, 11, 9], 'residential', 'terracotta'),
+    ('west-north-lower', [2, 12, 11, 19], 'residential', 'terracotta'),
+    ('west-middle-upper', [2, 24, 11, 31], 'residential', 'slate'),
+    ('west-middle-centre', [2, 33, 11, 40], 'residential', 'terracotta'),
+    ('west-middle-lower', [2, 42, 11, 49], 'shop', 'terracotta'),
+    ('west-south-upper', [2, 54, 11, 61], 'residential', 'slate'),
+    ('west-south-lower', [2, 62, 11, 69], 'residential', 'terracotta'),
+    ('north-attached-run', [16, 2, 37, 7], 'residential', 'teal'),
+    ('miyahara-north-shops', [16, 37, 29, 44], 'shop', 'terracotta'),
+    ('miyahara-east-shops', [26, 45, 29, 52], 'shop', 'mustard'),
+    ('east-park-shops', [34, 34, 37, 41], 'shop', 'teal'),
+    ('east-middle-shops', [34, 42, 37, 49], 'shop', 'slate'),
+    ('east-station-shops', [34, 51, 37, 56], 'shop', 'slate'),
+]
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
+    return value
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def adjacent(point):
+    x, y = point
+    return ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1))
+
+
+def source_context():
+    contract_path = ROOT / 'docs/taichung-city-contract.json'
+    map_path = ROOT / 'data/maps/TaichungOldCity/map.json'; layout_path = ROOT / 'data/layouts/layouts.json'
+    contract = json.loads(contract_path.read_text()); data = json.loads(map_path.read_text())
+    layout = next(l for l in json.loads(layout_path.read_text())['layouts'] if l.get('id') == data['layout'])
+    require((layout['width'], layout['height']) == (WIDTH, HEIGHT), 'Proposal only applies to current 40x72 Old City')
+    validator = module('route_source_geometry', ROOT / 'tools/taichung/validate_city.py')
+    native = validator.Map(ROOT, data, layout, {})
+    # The registered map may already contain this proposal. Always observe the
+    # compiler's three-landmark pre-infill snapshot when it is available, so
+    # rebuild/check never replans from installed ordinary buildings.
+    landmark_path = ROOT / 'data/taichung/landmarks/old-core-native/landmark-map.bin'
+    native.proposal_base_path = landmark_path if landmark_path.exists() else ROOT / layout['blockdata_filepath']
+    native.cells = struct.unpack('<2880H', native.proposal_base_path.read_bytes())
+    baseline_path = ROOT / 'data/taichung/landmarks/old-core-native/baseline-map.bin'
+    native.baseline_cells = struct.unpack('<2880H', baseline_path.read_bytes())
+    paths = [contract_path, map_path, layout_path, native.proposal_base_path,
+             ROOT / 'src/data/tilesets/headers.h', ROOT / 'src/data/tilesets/metatiles.h', ROOT / 'src/data/tilesets/graphics.h',
+             ROOT / 'data/taichung/prefabs/catalog.json', ROOT / 'data/taichung/prefabs/colorways.json', baseline_path]
+    for label in (layout['primary_tileset'], layout['secondary_tileset']):
+        resolved = render_tools().tileset_paths(ROOT, label)
