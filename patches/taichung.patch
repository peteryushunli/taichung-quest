+TaichungCity_StationGuide::
+	lock
+	faceplayer
+	msgbox TaichungCity_Text_StationGuide
+	special HealPlayerParty
+	playfanfare MUS_HEAL
+	waitfanfare
+	release
+	end
+
+TaichungCity_GreenwayGuide::
+	msgbox TaichungCity_Text_GreenwayGuide, MSGBOX_NPC
+	end
+
+TaichungCity_Text_StationGuide::
+	.string "Welcome to the OLD STATION!\p"
+	.string "Your POKéMON are rested and ready.\n"
+	.string "Open MENU for your BICYCLE.\p"
+	.string "MIYAHARA is just northwest.\n"
+	.string "Head west for the GREENWAY.$"
+
+TaichungCity_Text_GreenwayGuide::
+	.string "This green corridor links art,\n"
+	.string "science, and neighborhood life.\p"
+	.string "West: MAPLE GARDEN and THEATER.\n"
+	.string "East: OLD STATION and CITY PARK.$"
+
+TaichungCity_Sign_OldStation::
+	setvar VAR_0x8004, TAICHUNG_GYM_OLD_STATION
+	callnative TaichungHistory_ScriptBufferSign
+	msgbox gStringVar4, MSGBOX_SIGN
+	end
+
+TaichungCity_Host_OldStation::
+	goto TaichungGym_EventScript_StationChallenge
+
+TaichungCity_Text_OldStation::
+	.string "Old Taichung Station\n"
+	.string "Red brick. A city's stories.$"
+
+TaichungCity_Text_Host_OldStation::
+	.string "Welcome to this landmark hall!\p"
+	.string "Our city league is preparing\n"
+	.string "this hall for future challenges.$"
+
+TaichungCity_Sign_Park::
+	setvar VAR_0x8004, TAICHUNG_GYM_PARK
+	callnative TaichungHistory_ScriptBufferSign
+	msgbox gStringVar4, MSGBOX_SIGN
+	end
+
+TaichungCity_Host_Park::
+	goto TaichungGym_EventScript_ParkChallenge
+
+TaichungCity_Text_Park::
+	.string "Taichung Park\n"
+	.string "Lake light, pavilion shade.$"
+
+TaichungCity_Text_Host_Park::
+	.string "Welcome to TAICHUNG PARK!\p"
+	.string "Our city league is preparing\n"
+	.string "this hall for future challenges.$"
+
