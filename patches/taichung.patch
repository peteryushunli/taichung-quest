@@ -0,0 +1,468 @@
+#!/usr/bin/env python3
+"""Independent Xitun final-bank and semantic-map checks; no source writes.
+
+Expected pixels come from Git-pinned approved PNGs; geometry comes from fixed
+reviewed masks and the original map. No compiler module or CMP guard is imported.
+Use --proposal before Root registers the assembled landmarks secondary bank.
+"""
+from __future__ import annotations
+
+import argparse
+from io import BytesIO
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
