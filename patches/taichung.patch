+        tests.require([h for h in mine["habitatRegions"] if h["map"] == install.MID] == habitats,
+                      "Contract habitats are not the Maple Garden park's")
+        signs = {(e["x"], e["y"]) for e in data["bg_events"] if e["type"] == "sign"}
+        for l in landmarks.values():
+            warp = data["warp_events"][l["entrance"]["warpId"]]
+            tests.require((warp["x"], warp["y"]) == (l["entrance"]["x"], l["entrance"]["y"]), f"{l['id']}: door and warp disagree")
+            tests.require((l["sign"]["x"], l["sign"]["y"]) in signs, f"{l['id']}: contract sign is not a map sign")
