+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWarpRequests;
+static unsigned sVariableWrites;
+static bool8 sHasContinueWarp;
+static unsigned sChallengeCancels;
+// Independent expected origins come from the actual before/after map words,
+// not from the migration's relocation table.
+static bool8 sV9Solid[64][40];
+// Collision of the released v9 Xitun map, an independent bound on the v10 record's repair keys.
+static bool8 sReleasedXitunWall[64][40];
+#define V(id) sSave.vars[(id) - VARS_START]
+#include "save-v11-expect.inc"
+
+static u16 ReadMapWord(FILE *file)
+{
+    int low = fgetc(file), high = fgetc(file);
+    assert(low != EOF && high != EOF);
+    return low | high << 8;
+}
+
+static void LoadV9CollisionTruth(const char *before, const char *after)
+{
+    FILE *old = fopen(before, "rb"), *now = fopen(after, "rb");
+    unsigned x, y, changed = 0;
+    assert(old && now);
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 40; x++)
+        {
+            u16 a = ReadMapWord(old), b = ReadMapWord(now);
+            sReleasedXitunWall[y][x] = (b & 0xC00) != 0;
+            if (a == b) continue;
+            assert(!(a & 0xC00) && b == (a | 0x400));
+            sV9Solid[y][x] = TRUE;
+            changed++;
+        }
+    assert(fgetc(old) == EOF && fgetc(now) == EOF && changed == 44);
+    fclose(old); fclose(now);
+    assert(!sV9Solid[32][12] && !sV9Solid[33][12] && !sV9Solid[35][12]);
+}
+
+// Save v10 truth, flattened by test-save.sh from data/taichung/city-rework/save-v10.json and never
+// read back from the C tables. A released (v9) cell moves by its district's shift unless the record
+// repairs it; a repair always leaves the shifted cell, which the rework closed.
+#define V10_DISTRICTS 5
+static struct V10District
+{
+    const char *name;
+    u8 mapNum, width, height, newWidth, newHeight;
+    s8 dx, dy;
+    unsigned repairs;
+    bool8 repaired[72][64];
+    u8 to[72][64][2];
+} sV10[V10_DISTRICTS];
+
+static const struct V10District *FindV10(unsigned mapNum)
+{
+    unsigned i;
+    for (i = 0; i < V10_DISTRICTS; i++)
+        if (sV10[i].mapNum == mapNum) return &sV10[i];
+    return NULL;
+}
+
+// Where v10 puts a released explicit position: its repair if the rework closed it, else the shift.
+static bool8 ExpectV10(unsigned mapNum, s16 *x, s16 *y)
+{
+    const struct V10District *d = FindV10(mapNum);
+    assert(d);
+    if (*x >= 0 && *y >= 0 && *x < d->width && *y < d->height && d->repaired[*y][*x])
+    {
+        s16 tx = d->to[*y][*x][0], ty = d->to[*y][*x][1];
+        *x = tx; *y = ty;
+        return TRUE;
+    }
+    *x += d->dx; *y += d->dy;
+    return FALSE;
+}
+
+static void LoadV10Truth(const char *path)
+{
+    // Released sizes are fixed by 2c48f28; only the reworked side may still be regenerated.
+    static const struct { const char *constant, *name; u8 mapNum, width, height; } districts[V10_DISTRICTS] = {
+        {"MAP_TAICHUNG_XITUN", "Xitun", MAP_NUM(MAP_TAICHUNG_XITUN), 40, 64},
+        {"MAP_TAICHUNG_GREENWAY", "Greenway", MAP_NUM(MAP_TAICHUNG_GREENWAY), 40, 72},
+        {"MAP_TAICHUNG_OLD_CITY", "OldCity", MAP_NUM(MAP_TAICHUNG_OLD_CITY), 40, 72},
+        {"MAP_TAICHUNG_NANTUN_NORTH", "NantunNorth", MAP_NUM(MAP_TAICHUNG_NANTUN_NORTH), 40, 40},
+        {"MAP_TAICHUNG_NANTUN_WANHE", "NantunWanhe", MAP_NUM(MAP_TAICHUNG_NANTUN_WANHE), 64, 72},
+    };
+    FILE *file = fopen(path, "r");
+    char name[64];
+    int dx, dy, w, h, nw, nh, count, sx, sy, tx, ty;
+    unsigned i, k, seen = 0;
+    s16 x = 30, y = 66;
+    assert(file);
+    while (fscanf(file, "%63s %d %d %d %d %d %d %d", name, &dx, &dy, &w, &h, &nw, &nh, &count) == 8)
+    {
+        struct V10District *d;
+        i = 0;
+        while (i < V10_DISTRICTS && strcmp(name, districts[i].constant) != 0) i++;
+        assert(i < V10_DISTRICTS && !(seen & 1u << i));
+        seen |= 1u << i;
+        d = &sV10[i];
+        assert(w == districts[i].width && h == districts[i].height);
+        // Every district grew outward, so the shifted released map lies inside the reworked one.
+        assert(dx >= 0 && dy >= 0 && w + dx <= nw && h + dy <= nh && nw < 256 && nh < 256 && count >= 0);
+        d->name = districts[i].name; d->mapNum = districts[i].mapNum; d->width = w; d->height = h;
+        d->newWidth = nw; d->newHeight = nh; d->dx = dx; d->dy = dy; d->repairs = count;
+        for (k = 0; k < (unsigned)count; k++)
+        {
+            assert(fscanf(file, "%d %d %d %d", &sx, &sy, &tx, &ty) == 4);
+            assert(sx >= 0 && sy >= 0 && sx < w && sy < h && !d->repaired[sy][sx]);
+            assert(tx >= 0 && ty >= 0 && tx < nw && ty < nh && (tx != sx + dx || ty != sy + dy));
+            // A repair key was open in the released map; the Maple cells were already solid there.
+            assert(d->mapNum != MAP_NUM(MAP_TAICHUNG_XITUN) || (!sReleasedXitunWall[sy][sx] && !sV9Solid[sy][sx]));
+            d->repaired[sy][sx] = TRUE; d->to[sy][sx][0] = tx; d->to[sy][sx][1] = ty;
+        }
+    }
+    assert(feof(file) && seen == (1u << V10_DISTRICTS) - 1);
+    fclose(file);
+    // Versioned saves keep their checkpoint bytes and SetStationWarp is never shifted, so the
+    // station must be the same open tile before and after the rework.
+    assert(!ExpectV10(MAP_NUM(MAP_TAICHUNG_OLD_CITY), &x, &y) && x == 30 && y == 66);
+}
+
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_SAVE_VERSION_VAR || id == 0x40FB || id == 0x40FC);
+    V(id) = value;
+    sVariableWrites++;
+    return TRUE;
+}
+
+void SetContinueGameWarpStatus(void)
+{
+    sHasContinueWarp = TRUE;
+    sWarpRequests++;
+}
+
+bool32 UseContinueGameWarp(void)
+{
+    return sHasContinueWarp;
+}
+
+void TaichungGymCancelChallenge(void)
+{
+    sChallengeCancels++;
+}
+
+static void Reset(void)
+{
+    unsigned i;
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.preservedPartyAndBag, 0xA5, sizeof(sSave.preservedPartyAndBag));
+    for (i = 0; i < 256; i++)
+        sSave.vars[i] = i ^ 0x5A5A;
+    V(0x40F7) = 0;
+    V(0x40FB) = 0;
+    V(0x40FC) = 0;
+    V(0x40FD) = 0;
+    V(0x40F8) = 1;
+    V(0x40F9) = 2;
+    V(0x40FA) = 0x155;
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    sSave.location.mapNum = MAP_NUM(MAP_ROUTE1);
+    sSave.location.warpId = 2;
+    sSave.location.x = 7;
+    sSave.location.y = 8;
+    sSave.pos.x = 12;
+    sSave.pos.y = 9;
+    sSave.playerPartyCount = 1;
+    sSave.lastHealLocation = sSave.location;
+    sSave.continueGameWarp = sSave.location;
+    sSave.continueGameWarp.x = 4;
+    sSave.continueGameWarp.y = 5;
+    sWarpRequests = 0;
+    sVariableWrites = 0;
+    sHasContinueWarp = FALSE;
+    sChallengeCancels = 0;
+}
+
+static void InOldCity(s16 x, s16 y)
+{
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    sSave.pos.x = x;
+    sSave.pos.y = y;
+}
+
+static void AssertProtected(const struct SaveBlock1 *before, bool8 legacy)
+{
+    unsigned i;
+    if (!legacy)
+        assert(memcmp(&sSave.lastHealLocation, &before->lastHealLocation, sizeof(sSave.lastHealLocation)) == 0);
+    assert(sSave.playerPartyCount == before->playerPartyCount);
+    assert(memcmp(sSave.preservedPartyAndBag, before->preservedPartyAndBag, sizeof(sSave.preservedPartyAndBag)) == 0);
+    assert(memcmp(&sSave.location, &before->location, sizeof(sSave.location)) == 0);
+    assert(memcmp(&sSave.pos, &before->pos, sizeof(sSave.pos)) == 0);
+    assert(sSave.mapLayoutId == before->mapLayoutId);
+    assert(memcmp(sSave.objectEvents, before->objectEvents, sizeof(sSave.objectEvents)) == 0);
+    for (i = 0; i < 256; i++)
+    {
+        if (i == TAICHUNG_SAVE_VERSION_VAR - VARS_START)
+            continue;
+        if (legacy && (i == 0xFB || i == 0xFC))
+            continue;
+        assert(sSave.vars[i] == before->vars[i]);
+    }
+}
+
+// Every older explicit position in a reworked district takes its historical chain (the caller's
+// released x/y), then v10.
+static void AssertDistrictWarp(unsigned mapNum, s16 x, s16 y)
+{
+    ExpectV10(mapNum, &x, &y);
+    ExpectApprovedArtV11(MAP_GROUP(MAP_TAICHUNG_OLD_CITY), mapNum, &x, &y);
+    assert(sHasContinueWarp);
+    assert(sSave.continueGameWarp.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(sSave.continueGameWarp.mapNum == (s8)mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == x && sSave.continueGameWarp.y == y);
+}
+
+static void AssertWarp(s16 x, s16 y)
+{
+    AssertDistrictWarp(MAP_NUM(MAP_TAICHUNG_OLD_CITY), x, y);
+}
+
+// SetStationWarp writes the reworked station itself; it is never a migrated position.
+static void AssertStationWarp(void)
+{
+    assert(sHasContinueWarp && sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(sSave.continueGameWarp.mapNum == MAP_NUM(MAP_TAICHUNG_OLD_CITY));
+    assert(sSave.continueGameWarp.x == 30 && sSave.continueGameWarp.y == 66);
+}
+
+// A pending explicit target in a reworked district: only its x/y change, to the v10 cell.
+static void AssertPendingV10(const struct WarpData *before)
+{
+    struct WarpData expected = *before;
+    assert(expected.warpId == -1 && expected.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    ExpectV10(expected.mapNum, &expected.x, &expected.y);
+    ExpectApprovedArtV11(expected.mapGroup, expected.mapNum, &expected.x, &expected.y);
+    assert(sHasContinueWarp && memcmp(&sSave.continueGameWarp,&expected,sizeof(expected)) == 0);
+}
