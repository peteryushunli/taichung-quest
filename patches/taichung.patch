+"""Generate isolated production-derived v12 saves and candidate ROM receipts."""
+from pathlib import Path
+import hashlib
+import json
+import re
+import shutil
+import struct
+import subprocess
+import sys
+
+game,qa,reference,production,seed_path,web=map(Path,sys.argv[1:])
+qa.mkdir(parents=True,exist_ok=True);(qa/'roms').mkdir(exist_ok=True)
+read=lambda p:json.loads(p.read_text())
+repairs=read(game/'data/taichung/north-xitun-continue/repairs.json')
+groups=read(game/'data/maps/map_groups.json')['gMapGroup_Taichung']
+layouts={r['id']:i+1 for i,r in enumerate(read(game/'data/layouts/layouts.json')['layouts']) if r}
+symbols_bin=Path('/Users/peter/devday_hackathon/.tools/binutils/arm-none-eabi-binutils/2.47/bin/arm-none-eabi-nm')
+for name,source in [('fixed',game),('base',reference),('production',production)]:
+    meta=read(web/'web/public/roms/build.json');raw=(source/'pokefirered.gba').read_bytes()
+    nm=subprocess.check_output([str(symbols_bin),'--defined-only',str(source/'pokefirered.elf')],text=True)
+    symbols={parts[2]:int(parts[0],16) for line in nm.splitlines() if len(parts:=line.split())==3}
+    meta.update(file=name+'.gba',sha256=hashlib.sha256(raw).hexdigest(),ramSymbols={n:symbols[n] for n in ['gSaveBlock1Ptr','gSaveBlock2Ptr','gSaveBlock1','gSaveBlock2','gPlayerParty','sStartMenuCursorPos','sStartMenuOrder']})
+    meta['navigationBridge']['address']=symbols['gTaichungNavigationBridge']
+    (qa/'roms'/(name+'.gba')).write_bytes(raw);(qa/(name+'-metadata.json')).write_text(json.dumps(meta,indent=2)+'\n')
+
+permutations={int(n):list(map(int,(a,b,c,d))) for n,a,b,c,d in re.findall(r'SUBSTRUCT_CASE\(\s*(\d+),(\d),(\d),(\d),(\d)\)',(game/'src/pokemon.c').read_text())}
+seed=bytearray(seed_path.read_bytes())
+# Give the partner visibly depleted HP and PP, with a correct BoxPokemon checksum.
+for offset in range(0,0x1c000,0x1000):
+    section,_,signature,_=struct.unpack_from('<HHII',seed,offset+0xff4)
+    if signature!=0x08012025 or section!=1:continue
+    p=offset+0x38;personality,ot=struct.unpack_from('<II',seed,p)
+    plain=bytearray(struct.pack('<12I',*(v^personality^ot for v in struct.unpack_from('<12I',seed,p+0x20))))
+    plain[permutations[personality%24][1]*12+8]=1
+    struct.pack_into('<H',seed,p+0x1c,sum(struct.unpack('<24H',plain))&0xffff)
+    struct.pack_into('<12I',seed,p+0x20,*(v^personality^ot for v in struct.unpack('<12I',plain)))
+    struct.pack_into('<H',seed,p+0x56,7)
+
+
+def fixture(name,number,x,y,pending=False):
+    data=bytearray(seed);record=read(game/'data/maps'/groups[number]/'map.json')
+    for offset in range(0,0x1c000,0x1000):
+        section,_,signature,_=struct.unpack_from('<HHII',data,offset+0xff4)
+        if signature!=0x08012025 or section not in (0,1):continue
+        if section==0:
+            data[offset+9]=(data[offset+9]&~1)|(1 if pending else 0);length=0xf24
+        else:
+            struct.pack_into('<hh',data,offset,x,y)
+            for entry in (4,12):struct.pack_into('<bbbBhh',data,offset+entry,43,number,-1,0,x,y)
+            struct.pack_into('<H',data,offset+0x32,layouts[record['layout']]);length=0xf80
+        checksum=sum(struct.unpack_from(f'<{length//4}I',data,offset))&0xffffffff
+        struct.pack_into('<H',data,offset+0xff6,((checksum>>16)+checksum)&0xffff)
+    (qa/(name+'.sav')).write_bytes(data)
+
+
+samples={(63,80),(64,78),(59,79),(107,95),(108,96),(104,69)}
+origins={27:(39,62),35:(72,62)}
+cases=[]
+for m in repairs['maps']:
+    number=int(m['nativeKey'].split(':')[1]);a,b=origins[number]
+    for x,y,tx,ty in m['repairs']:
+        if (a+x,b+y) not in samples:continue
+        for pending in [False,True]:
+            name=f"{number}-{x}-{y}-"+('pending' if pending else 'ordinary')
+            fixture(name,number,x,y,pending)
+            if not pending:fixture('bootstrap-'+name,number,x,y,True)
+            cases.append(dict(id=name,start=[number,x,y],expected=[number,tx,ty],world=[a+x,b+y],pending=pending))
+for number,x,y in [(27,23,26),(35,36,24),(76,14,38)]:
+    name=f'control-{number}-{x}-{y}';fixture(name,number,x,y)
+    fixture('bootstrap-'+name,number,x,y,True)
+    cases.append(dict(id=name,start=[number,x,y],expected=[number,x,y],control=True))
+(qa/'cases.json').write_text(json.dumps(cases,indent=2)+'\n')
+print(f'Prepared {len(cases)} native ordinary/pending/control cases; partner HP7 and move1 PP1.')
diff --git a/tools/taichung/boulevard_city/qa/north-xitun-continue/run.mjs b/tools/taichung/boulevard_city/qa/north-xitun-continue/run.mjs
