+                  'quantization':('nearest RGB in supplied palette; no dithering' if palette_source else 'MEDIANCUT over opaque pixels only; no dithering'),'gbaColorRounding':'nearest multiple of8 clamped248',
+                  'logicalSize':list(logical_size),'workingResolution':list(working_size),'nativePixelClusterSize':pixel_step,
+                  'fittedSubjectSize':[v*pixel_step for v in size],'subjectOffset':[v*pixel_step for v in offset],'paletteBankCandidate':8,
+                  'opaqueColors':len(palette),'PillowVersion':PIL.__version__,'sharedPaletteSource':str(palette_source) if palette_source else None},
