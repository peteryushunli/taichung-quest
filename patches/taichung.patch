+static bool8 MetatileBehavior_IsHorizontalRail(u8 tile) { return !!(tile & 4); }
+static bool8 MetatileBehavior_IsIsolatedVerticalRail(u8 tile) { return !!(tile & 8); }
+static bool8 MetatileBehavior_IsIsolatedHorizontalRail(u8 tile) { return !!(tile & 16); }
+bool8 IsBikingDisallowedByPlayer(void) { return sNativeBlocked; }
+static u8 CanBikeFaceDirectionOnRail(u8 direction, u8 tile) { (void)direction; (void)tile; return sRailFacing; }
