+def summary(g):
+    counts = {}
+    for row in g.c:
+        for cls in row:
+            counts[cls] = counts.get(cls, 0) + 1
+    return {
+        "map": g.name, "size": [g.w, g.h], "worldOrigin": [g.ox, g.oy], "liveShift": list(g.shift),
+        "splitInto": None if g.split is None else [
+            {"map": "TaichungOldCityNorth", "localRows": [0, g.split - 1], "size": [g.w, g.split], "worldOrigin": [g.ox, g.oy], "liveShift": None},
+            {"map": g.name, "localRows": [g.split, g.h - 1], "size": [g.w, g.h - g.split], "worldOrigin": [g.ox, g.oy + g.split],
+             "liveShift": [g.shift[0], g.shift[1] - g.split]}],
+        "streets": g.streets, "doors": g.doors, "signs": g.signs, "signsMoved": g.moved, "npcs": g.npcs,
+        "newLandmarks": g.landmarks,
+        "strips": [{"viewer": v, "rect": [x0, y0, x1, min(y1, g.h - 1)], "drawn": sorted(c)} for v, x0, y0, x1, y1, c in strips(g)],
+        "cellClasses": dict(sorted(counts.items())),
+        "rows": ["".join(CODE[c] for c in row) for row in g.c],
+    }
+
+
+CODE = {"hwy": "H", "riv": "R", "can": "C", "lake": "L", "walk": "w", "asp": "a",
+        "line_h": "-", "line_v": "|", "xwalk_h": "!", "xwalk_v": "=", "side": "s", "pave": ".", "grass": ",",
+        "tall": '"', "flower": "*", "pbridge": "=", "yard": "y", "tree": "T", "shrub": "o", "bldg": "B", "bldgc": "b",
+        "lmk": "M", "prim": "P", "keep": "#"}
+
+
+def live_tall_grass(source):
+    out = {}
+    for name in ("TaichungGreenway", "TaichungOldCity"):
+        out[name] = sum(1 for w in words(source / f"data/layouts/{name}/map.bin") if w & 0x3FF == 0x00D)
+    return out
+
+
+def secondary_budget(source, layout_id, g, keep=None):
+    """Secondary tile slots: used today, still needed once the draft is built, and so free for new art.
+    Needed = tiles of the live metatiles the draft keeps as art, plus `keep` (label -> metatile IDs).
+    The last 8 slots (0x3F8-0x3FF) are never free: field_door.c copies door animations there."""
+    layout = next(l for l in json.loads((source / "data/layouts/layouts.json").read_text())["layouts"] if l.get("id") == layout_id)
+    data = [w & 0x3FF for w in native.words(source / layout["blockdata_filepath"])]
+    live = {(n % layout["width"], n // layout["width"]): m for n, m in enumerate(data)}
+    paths = native.tileset_paths(source, layout["secondary_tileset"])
+    defs = native.words(paths["metatiles"])
+    image = Image.open(paths["tiles"])
+    count = (image.width // 8) * (image.height // 8)
+
+    def tiles_of(ids):
+        out = set()
+        for m in ids:
+            if m >= 640:
+                out |= {w & 0x3FF for w in defs[(m - 640) * 8:(m - 640) * 8 + 8] if w & 0x3FF >= 640}
+        return out
+
+    groups = {"kept landmark art": {live[o] for o in g.art.values()}}
+    groups.update({k: v(live) for k, v in (keep or {}).items()})
+    needed = tiles_of(set().union(*groups.values())) - set(range(1016, 1024))
+    referenced = tiles_of(range(640, 640 + len(defs) // 8))
+    drawn = tiles_of(set(live.values()))
+    return {
+        "secondary": layout["secondary_tileset"], "capacity": 1024 - 640, "doorScratch": "0x3F8-0x3FF (8)",
+        "sheetTiles": count, "referencedOnlyByUnusedDefinitions": len(referenced - drawn),
+        "freedByRebuild": len(drawn - needed), "neededAfterRebuild": len(needed), "freeAfterRebuild": 1016 - 640 - len(needed),
+        "onlyNeededBy": {k: len(tiles_of(v) - tiles_of(set().union(*(w for kk, w in groups.items() if kk != k)))) for k, v in groups.items()},
+    }
+
+
+PREFABS = {  # city-v3 library objects in the primaries, at the same IDs in all three
+    "kiosk": ((0x028, 0x029, 0x02A, 0x02B), (0x030, 0x031, 0x032, 0x033), (0x034, 0x035, 0x036, 0x037), (0x03C, 0x03E, 0x03E, 0x03F)),
+    "stall": ((0x048, 0x049, 0x04A, 0x04B), (0x050, 0x051, 0x052, 0x053), (0x054, 0x055, 0x056, 0x057)),
+}
+_PRIMARY = {}
+
+
+def primary_render(metatile):
+    """16x16 render of an Old City primary metatile."""
+    if "tiles" not in _PRIMARY:
+        _PRIMARY["tiles"] = native.render_metatiles(_PRIMARY["source"], "gTileset_TaichungOldCorePrimary", "gTileset_TaichungOldCore")
+    return _PRIMARY["tiles"][metatile]
+
+
+OPEN_CELLS = {"Old City": {0x175: "pave", 0x001: "grass"}, "Greenway": {0x001: "grass", 0x004: "flower"},
+              "Old City North": {0x1C1: "pave", 0x175: "pave", 0x001: "grass"}}
+
+
+def fit_landmarks(source, plan_dir, plan):
+    """Landmark number -> (render on real tiles, {cell render bytes: walkable class}). Landmarks
+    with a tile-efficient redraw (landmark_redraw.py) use it; the rest show the board's set piece
+    fitted to today's palettes."""
+    rects = {l["n"]: l["rect"] for l in plan["newLandmarks"]}
+    pieces = landmark_tiles.load_setpieces(plan_dir)
+    banks = {name: landmark_tiles.Bank(source, *spec) for name, spec in landmark_tiles.BANKS.items()}
+    redrawn = landmark_redraw.redraw(source)
+    out = {}
+    for n, (name, bank, _) in landmark_tiles.LANDMARKS.items():
+        x0, y0, x1, y1 = rects[n]
+        if n in redrawn:
+            render = redrawn[n].render
+        else:
+            render, _, _ = landmark_tiles.fit_landmark(banks[bank], pieces[name](x1 - x0, y1 - y0))
+        if n in redrawn:
+            tiles, bank = redrawn[n].bank, landmark_redraw.LANDMARKS[n][1]
+        else:
+            tiles = landmark_redraw.Tiles(source, *landmark_tiles.BANKS[bank][:2])
+        open_cells = {tiles.render_layers(tiles.layers(m)).tobytes(): cls for m, cls in OPEN_CELLS[bank].items()}
+        out[n] = (render, open_cells)
+    return out, redrawn
+
+
+def new_secondary_budget(redrawn, bank, carried):
+    """A map that gets a new secondary: slots its redrawn landmarks and any carried sets take.
+    `carried` maps a label to (tiles, metatile definitions)."""
+    pieces = [(n, p) for n, p in sorted(redrawn.items()) if landmark_redraw.LANDMARKS[n][1] == bank]
+    tiles = set().union(*(p.secondary_tiles for _, p in pieces))
+    definitions = sum(p.stats["newMetatiles"] for _, p in pieces)
+    used_tiles = len(tiles) + sum(t for t, _ in carried.values())
+    used_definitions = definitions + sum(d for _, d in carried.values())
+    return {"secondary": "new, 384 slots", "doorScratch": "0x3F8-0x3FF (8)", "palettes": "OldCore 7-12 to start",
+            "landmarks": {str(n): {"tiles": p.stats["newSecondaryTiles"], "definitions": p.stats["newMetatiles"]} for n, p in pieces},
+            "landmarkTilesShared": len(tiles), "landmarkDefinitions": definitions,
+            "carried": {k: {"tiles": t, "definitions": d} for k, (t, d) in carried.items()},
+            "freeTiles": 376 - used_tiles, "freeDefinitions": 384 - used_definitions}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[3])
+    parser.add_argument("--plan-dir", type=Path, default=Path("/Users/peter/devday_hackathon/artifacts/city-rework"))
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--drafts-dir", type=Path, help="also write the plain map-local PNGs here (greenway.png, oldcity.png)")
+    args = parser.parse_args()
+    out = args.output_dir
+    out.mkdir(parents=True, exist_ok=True)
+    plan = load_plan(args.plan_dir)
+    _PRIMARY["source"] = args.source
+    fitted, redrawn = fit_landmarks(args.source, args.plan_dir, plan)
+    gw, oc = greenway(args.source, plan, fitted), old_city(args.source, plan, fitted)
+    result = {"source": "native 6366b9e live layouts", "plan": str(args.plan_dir / "masterplan.json"),
+              "checks": checks(gw, oc, plan), "liveTallGrass": live_tall_grass(args.source),
+              "maps": [summary(gw), summary(oc)],
+              "secondaryBudget": {
+                  "TaichungGreenway": secondary_budget(args.source, "LAYOUT_TAICHUNG_GREENWAY", gw),
+                  "TaichungOldCity": secondary_budget(args.source, "LAYOUT_TAICHUNG_OLD_CITY", oc, {
+                      "city-v3 lots (939-1010)": lambda live: set(range(939, 1011)),
+                      "carried FireRed houses": lambda live: {live[(x, y)] for x in range(2, 8) for y in range(54, 63)}}),
+                  "TaichungOldCityNorth": new_secondary_budget(redrawn, "Old City North", {
+                      "city-v3 styles at Old City's IDs (939-1010), for OCN's own lots": (118, 72)})}}
+    images = []
+    for g, layout_id, slug, title, notes in (
+        (gw, "LAYOUT_TAICHUNG_GREENWAY", "greenway",
+         f"Greenway draft: {gw.w}x{gw.h} at ({gw.ox},{gw.oy}); rows 0-{gw.shift[1] - 1} new",
+         "The Calligraphy Greenway spine between G41 and G72. Live park content, landmarks, doors and signs stay."),
+        (oc, "LAYOUT_TAICHUNG_OLD_CITY", "oldcity",
+         f"Old City North {oc.w}x{oc.split} at ({oc.ox},{oc.oy}) over Old City {oc.w}x{oc.h - oc.split} at ({oc.ox},{oc.oy + oc.split})",
+         "The plan's grid: Green River through the lake, park, plaza, landmarks kept, generic blocks rebuilt as lots."),
+    ):
+        live = render_layout(args.source, layout_id)
+        img = paint(g, live)
+        images.append((g, img))
+        frame(g, img, title, notes).save(out / f"{slug}-blockout.png")
+        clean = paint(g, live, strips=False)
+        clean.save(out / f"{slug}.png")
+        if args.drafts_dir:
+            args.drafts_dir.mkdir(parents=True, exist_ok=True)
+            clean.save(args.drafts_dir / f"{slug}.png")
+    world(images, args.plan_dir / "plan.png", min(plan["cells"])).save(out / "world-draft.png")
+    close = miyahara_closeup(old_city(args.source, plan, fitted, miyahara_dy=0), oc, render_layout(args.source, "LAYOUT_TAICHUNG_OLD_CITY"))
+    close.save(out / "oldcity-miyahara.png")
+    if args.drafts_dir:
+        close.save(args.drafts_dir / "oldcity-miyahara.png")
+    (out / "draft.json").write_text(json.dumps(result, indent=1) + "\n")
+    c = result["checks"]
+    print(json.dumps({k: v for k, v in c.items() if k not in ("doors",)}, indent=1)[:6000])
+    print("doors:", [(d["map"][7:], d["name"], d["reachable"], d["approachClass"]) for d in c["doors"]])
+    print("tall grass live:", result["liveTallGrass"], "draft:", {m["map"]: m["cellClasses"].get("tall", 0) for m in result["maps"]})
+    print("signs moved:", [(m["map"], s) for m in result["maps"] for s in m["signsMoved"]])
+    print("landmark signs:", [(s["landmark"], s["sign"], s["reachable"]) for s in c["landmarkSigns"]])
+    print("secondary budget:", json.dumps(result["secondaryBudget"]))
+
+
+if __name__ == "__main__":
+    main()
