+    Sprites stack in the order open_sources draws them. A crown or canopy also
+    covers another object's base beneath it, so the player's head goes under it."""
+    alphas = {}
+    top = {}
+    for item in sorted(world.objects, key=lambda item: (item["y"] + item["h"], item["x"])):
+        if item["sprite"] == "tree":
+            continue
+        name, _, flip = item["sprite"].partition("@")
+        if name not in alphas:
+            alphas[name] = Image.open(sprite_path(fill_dir, name)).convert("RGBA").getchannel("A")
+        alpha = alphas[name]
+        footprint = world.solid_cells(item)
+        upper = item["kind"] in OVERHEAD_KINDS and footprint
+        base = max(y for _, y in footprint) if upper else None
+        for j in range(item["h"]):
+            for i in range(item["w"]):
+                column = item["w"] - 1 - i if flip else i
+                box = (column * 16, j * 16, column * 16 + 16, j * 16 + 16)
+                if alpha.crop(box).getextrema()[1] >= 128:
+                    point = item["x"] + i, item["y"] + j
