+static void TestReworkV10Migration(void)
+{
+    static const s8 warpIds[] = {-3, 0, 1, 2};
+    static const u8 roomPositions[][2] = {{6,9}, {11,33}, {30,66}};
+    static const u8 apart[][4] = {{2,2,7,2}};
+    struct SaveBlock1 before;
+    unsigned d, version, x, y, i, pending, map, cells, keys, maple = 0, rooms = 0;
+    s16 ex, ey;
+
+    assert(FindV10(18) == NULL && FindV10(MAP_NUM(MAP_TAICHUNG_STATION_WELCOME)) == NULL);
+    for (d = 0; d < V10_DISTRICTS; d++)
+    {
+        const struct V10District *district = &sV10[d];
+        map = district->mapNum; cells = keys = 0;
+        for (y = 0; y < district->height; y++)
+            for (x = 0; x < district->width; x++)
+            {
+                // v9 reloads once onto the same world tile, or the repair of a closed one, even with a
+                // prototype starter id; the next Continue is current and byte-exact.
+                Versioned(9); InDistrict(map,x,y); if (x & 1) V(0x40FC) = SPECIES_PIKACHU; before = sSave;
+                TaichungSaveUpgradeOnContinue(); AssertDistrictWarp(map,x,y);
+                assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+                sHasContinueWarp = FALSE; before = sSave; TaichungSaveUpgradeOnContinue();
+                assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && sWarpRequests == 1 && !sHasContinueWarp);
+                // A pending explicit target from an unrelated map is repaired in place, with no new request.
+                Versioned(9); PendingTarget(map,x,y); before = sSave;
+                TaichungSaveUpgradeOnContinue(); AssertPendingV10(&before.continueGameWarp);
+                assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+                sV10Cases[d] += 2;
+                // Native warp IDs resolve through authored doors, which moved with their district.
+                for (i = 0; i < COUNT(warpIds); i++)
+                {
+                    Versioned(9); InDistrict(map,x,y); PendingTarget(map,x,y);
+                    sSave.continueGameWarp.warpId = warpIds[i]; before = sSave;
+                    TaichungSaveUpgradeOnContinue();
+                    assert(sHasContinueWarp && sWarpRequests == 0);
+                    assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+                    AssertSamePartyAndVars(&before); sV10Cases[d]++;
+                }
+                // Older sources chain their own historical repairs first, saved or pending.
+                for (version = 1; version <= 8; version++)
+                    for (pending = 0; pending < 2; pending++)
+                    {
+                        ex = x; ey = y; ExpectHistorical(version,map,&ex,&ey);
+                        Versioned(version);
+                        if (pending) PendingTarget(map,x,y); else InDistrict(map,x,y);
+                        if (x & 1) V(0x40FC) = SPECIES_PIKACHU;
+                        before = sSave; TaichungSaveUpgradeOnContinue(); AssertDistrictWarp(map,ex,ey);
+                        assert(sWarpRequests == (pending ? 0u : 1u)); AssertSamePartyAndVars(&before); sV10Cases[d]++;
+                    }
+                // Current and future saves keep every byte, with no, a native or an explicit pending return.
+                for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+                    for (pending = 0; pending < 3; pending++)
+                    {
+                        Versioned(version); InDistrict(map,x,y);
+                        if (pending) PendingTarget(map,x,y);
+                        if (pending == 1) sSave.continueGameWarp.warpId = 0;
+                        before = sSave; TaichungSaveUpgradeOnContinue();
+                        assert(memcmp(&sSave,&before,sizeof(sSave)) == 0);
+                        assert(sWarpRequests == 0 && sVariableWrites == 0 && sChallengeCancels == 1 && sHasContinueWarp == (pending != 0));
+                        sV10Cases[d]++;
+                    }
+                // Unversioned prototypes: the three original districts chain every table, then v10; the
+                // Nantun districts postdate them and use the station like any other unknown map.
+                Reset(); V(0x40FC) = SPECIES_PIKACHU; InDistrict(map,x,y); before = sSave;
+                TaichungSaveUpgradeOnContinue();
+                if (map <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM))
+                {
+                    ex = x; ey = y; ExpectHistorical(0,map,&ex,&ey); AssertDistrictWarp(map,ex,ey);
+                }
+                else AssertStationWarp();
+                assert(sWarpRequests == 1 && V(0x40F7) == TAICHUNG_SAVE_VERSION && TaichungSaveUsesStationCheckpoint());
+                AssertProtected(&before,TRUE); sV10Cases[d]++;
+                // The district tables are keyed by group too: the same number elsewhere is untouched.
+                Versioned(9); InDistrict(map,x,y); sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+                PendingTarget(map,x,y); sSave.continueGameWarp.mapGroup = MAP_GROUP(MAP_ROUTE1); before = sSave;
+                TaichungSaveUpgradeOnContinue();
+                assert(sHasContinueWarp && sWarpRequests == 0);
+                assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+                AssertSamePartyAndVars(&before);
+                Versioned(9); InDistrict(map,x,y); sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1); before = sSave;
+                TaichungSaveUpgradeOnContinue(); assert(!sHasContinueWarp && sWarpRequests == 0);
+                assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+                AssertSamePartyAndVars(&before); sV10Cases[d] += 2;
+                ex = x; ey = y; keys += ExpectV10(map,&ex,&ey);
+                cells++;
+            }
+        assert(cells == (unsigned)district->width * district->height && keys == district->repairs);
+    }
+    // The Maple chain: a v8 save or pending target on any of the 44 v9 cells ends on (12,35)'s v10 tile.
+    for (y = 0; y < 64; y++)
+        for (x = 0; x < 40; x++)
+        {
+            if (!sV9Solid[y][x]) continue;
+            for (pending = 0; pending < 2; pending++)
+            {
+                Versioned(8);
+                if (pending) PendingXitunTarget(x,y); else InXitun(x,y);
+                before = sSave; TaichungSaveUpgradeOnContinue(); AssertXitunWarp(12,35);
+                assert(sWarpRequests == (pending ? 0u : 1u)); AssertSamePartyAndVars(&before);
+            }
+            maple++;
+        }
+    assert(maple == 44);
+    // Gym rooms, the welcome room and temple halls keep their cache and pending
+    // targets. Old City North now has a v11 art-bank refresh and is tested by
+    // the exhaustive v11 suite instead of being classified as an unchanged room.
+    for (map = MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM); map <= 18; map++)
+    {
+        if (FindV10(map) || map == MAP_NUM(MAP_TAICHUNG_OLD_CITY_NORTH)) continue;
+        for (d = 0; d < V10_DISTRICTS; d++)
+            for (y = 0; y < sV10[d].height; y++)
+                for (x = 0; x < sV10[d].width; x++)
+                    if (sV10[d].repaired[y][x]) AssertRoomUnchanged(9,map,x,y);
+        for (version = 1; version <= 8; version++)
+            for (i = 0; i < COUNT(roomPositions); i++)
+                AssertRoomUnchanged(version,map,roomPositions[i][0],roomPositions[i][1]);
+        rooms++;
+    }
+    assert(rooms == 13);
+    AssertV10Apart(MAP_NUM(MAP_TAICHUNG_XITUN), sXitunV4Cases, COUNT(sXitunV4Cases));
+    AssertV10Apart(MAP_NUM(MAP_TAICHUNG_XITUN), sXitunV7Cases, COUNT(sXitunV7Cases));
+    AssertV10Apart(MAP_NUM(MAP_TAICHUNG_GREENWAY), sGreenwayV5Cases, COUNT(sGreenwayV5Cases));
+    AssertV10Apart(MAP_NUM(MAP_TAICHUNG_GREENWAY), sGreenwayV6Cases, COUNT(sGreenwayV6Cases));
+    AssertV10Apart(MAP_NUM(MAP_TAICHUNG_OLD_CITY), apart, COUNT(apart));
+}
