new file mode 100644
index 00000000..ae1ecbcd
--- /dev/null
+++ b/tools/taichung/check_connection_boundaries.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Check which neighbour the engine picks at every walkable outdoor edge cell.
+
+GetIncomingConnection (src/fieldmap.c) returns the first connection listed for the
+direction whose range holds the player's coordinate along that side, as decided by
+IsCoordInIncomingConnectingMap. This guard models that exactly, reading the bound from
+the engine source, and requires every walkable edge cell of every connected Taichung
+exterior to resolve to the neighbour that actually lies across the edge, at an in-bounds
+cell. It also lists the cells the original inclusive bound (`coord <= srcMax`) sends to
+the wrong map, which the city rework's two-neighbour sides reach.
+
+  python3 tools/taichung/check_connection_boundaries.py
+  python3 tools/taichung/check_connection_boundaries.py --self-test
+"""
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+FIELDMAP = "src/fieldmap.c"
+BOUNDS = {"coord < srcMax": "exclusive", "coord <= srcMax": "inclusive"}
+# Along-side coordinate, side length and the neighbour cell, per direction the player leaves by.
+SIDES = {
+    "left": lambda m, x, y: x == 0,
+    "right": lambda m, x, y: x == m.width - 1,
+    "up": lambda m, x, y: y == 0,
+    "down": lambda m, x, y: y == m.height - 1,
+}
+
+
+def load_validator(source):
+    spec = importlib.util.spec_from_file_location("connection_boundaries_validate_city", source / "tools/taichung/validate_city.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def engine_bound(text):
+    """The bound IsCoordInIncomingConnectingMap uses, read from the engine source."""
+    body = re.search(r"static bool8 IsCoordInIncomingConnectingMap\(s32 coord, s32 srcMax, s32 destMax, s32 offset\)\s*\{(.*?)\n\}", text, re.S)
+    if body is None:
+        raise SystemExit("IsCoordInIncomingConnectingMap not found in " + FIELDMAP)
+    found = [kind for snippet, kind in BOUNDS.items() if f"offset2 <= coord && {snippet})" in body.group(1)]
+    if len(found) != 1:
+        raise SystemExit("IsCoordInIncomingConnectingMap's bound is not one this guard models")
+    return found[0]
+
+
+def incoming(coord, src_max, dest_max, offset, bound):
+    """IsCoordInIncomingConnectingMap."""
+    if dest_max + offset < src_max:
+        src_max = dest_max + offset
+    low = max(offset, 0)
+    return low <= coord < src_max if bound == "exclusive" else low <= coord <= src_max
+
+
+def load_maps(source, overrides):
+    rules = load_validator(source)
+    read = lambda path: overrides.get(path)
+    layouts = {x["id"]: x for x in json.loads(overrides.get("data/layouts/layouts.json") or (source / "data/layouts/layouts.json").read_bytes())["layouts"] if "id" in x}
+    maps, cache = {}, {}
+    for folder in sorted((source / "data/maps").glob("Taichung*/map.json")):
+        rel = str(folder.relative_to(source))
+        data = json.loads(overrides.get(rel) or folder.read_bytes())
+        if data.get("connections"):
+            maps[data["id"]] = rules.Map(source, data, layouts[data["layout"]], cache, read)
+    return maps
+
+
+def resolve(maps, bound):
+    """Every walkable edge cell: the neighbour the engine picks against the one across the edge."""
+    checked, wrong = 0, []
+    for mid, view in maps.items():
+        for direction, on_side in SIDES.items():
+            listed = [c for c in view.data["connections"] if c["direction"] == direction]
+            if not listed:
+                continue
+            along_x = direction in ("up", "down")
+            for y in range(view.height):
+                for x in range(view.width):
+                    if not on_side(view, x, y) or not view.ground(x, y):
+                        continue
+                    coord, src = (x, view.width) if along_x else (y, view.height)
+                    def size(c):
+                        other = maps.get(c["map"])
+                        return None if other is None else (other.width if along_x else other.height)
+                    across = [c for c in listed if size(c) is not None and c["offset"] <= coord < c["offset"] + size(c)]
+                    picked = next((c for c in listed if size(c) is not None and incoming(coord, src, size(c), c["offset"], bound)), None)
+                    checked += 1
+                    expected = across[0]["map"] if len(across) == 1 else None
+                    got = picked["map"] if picked else None
+                    lands = picked is not None and 0 <= coord - picked["offset"] < size(picked)
+                    if got != expected or (picked is not None and not lands):
+                        wrong.append({"map": mid, "cell": [x, y], "leaving": direction,
+                                      "engineGoesTo": got, "acrossTheEdge": expected, "landsInBounds": lands})
+    return checked, wrong
+
+
+def check(source=ROOT, overrides=None):
+    source, overrides = Path(source).resolve(), overrides or {}
+    bound = engine_bound((overrides.get(FIELDMAP) or (source / FIELDMAP).read_bytes()).decode())
+    maps = load_maps(source, overrides)
+    checked, wrong = resolve(maps, bound)
+    _, inclusive = resolve(maps, "inclusive")
+    return {"passed": not wrong, "engineBound": bound, "connectedExteriors": len(maps), "walkableEdgeCells": checked,
+            "misrouted": wrong, "misroutedUnderInclusiveBound": inclusive}
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve()
+    text = (source / FIELDMAP).read_text()
+    inclusive = text.replace("offset2 <= coord && coord < srcMax)", "offset2 <= coord && coord <= srcMax)", 1)
+    probes = {"inclusiveBoundRejected": not check(source, {FIELDMAP: inclusive.encode()})["passed"]}
+    # The exclusive bound is order-independent: reversing every map's connection list still passes.
+    reversed_maps = {}
+    for folder in sorted((source / "data/maps").glob("Taichung*/map.json")):
+        data = json.loads(folder.read_text())
+        if data.get("connections"):
+            data["connections"] = data["connections"][::-1]
+            reversed_maps[str(folder.relative_to(source))] = json.dumps(data).encode()
+    probes["reversedConnectionOrderPasses"] = check(source, reversed_maps)["passed"]
+    return probes
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    report = check(args.source)
+    if args.self_test:
+        report["probes"] = self_test(args.source)
+        report["passed"] = report["passed"] and all(report["probes"].values())
+    print(json.dumps(report, indent=2))
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/taichung/check_gym_staff.py b/tools/taichung/check_gym_staff.py
new file mode 100644
index 00000000..3511f308
--- /dev/null
+++ b/tools/taichung/check_gym_staff.py
@@ -0,0 +1,441 @@
+#!/usr/bin/env python3
+"""Read-only proof for the five reviewed optional gym staff and cache handoff.
+
+The immutable staff/API commits are feature inputs, not a substitute for Main's
+separate final source-profile binding. Script dependencies and runtime acceptance
+are reported separately. No map, source, manifest or binding is generated here.
+"""
+import argparse
+from collections import deque
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+BASE = '2c48f28b998b67413baf058557752723ea121500'
+STAFF = 'aade361f18d95ec9cfcef3209ac18fe9e5baa518'
+API = '4bc70520f29d6070666c6d6c36b57a28c1e7e7b8'
+# The registered city rework (save v10). When its record is in the tree, inputs outside the five
+# staff rooms are compared with the city instead of BASE, and the facing wrapper delegates with the
+# current save version over the city's save pair. Guards frozen at v9 read the save pair peeled back
+# by save_v10.py to the polish's own pair, which is exactly the frozen API pair, so that pair is
+# accepted too. The five rooms, their layout and the actors are unchanged by the city, so the
+# staff delta is proved on the same base either way.
+CITY = 'a2f2afaeaebd0fd5a30c4547bed8a0df5dac00fd'
+CITY_RECORD = 'data/taichung/city-rework/save-v10.json'
+DELEGATE_V9 = 'RememberCacheRefreshFacing(warp);'
+DELEGATE_CITY = 'RememberCacheRefreshFacing(warp, TAICHUNG_SAVE_VERSION);'
+CITY_NOTE = '    // The save is already current here (the upgrade ran first), so no v10 shift applies.\n'
+MANIFEST = 'data/taichung/gym-staff/manifest.json'
+MANIFEST_SHA256 = '6239ee27e7a517407df04124fc578ded3116a2f9b73b1a4d1defecfa08ae7827'
+SAVE, HEADER = 'src/taichung_save.c', 'include/taichung_save.h'
+CHARACTERS, IDS = 'src/taichung_characters.c', 'include/constants/event_objects.h'
+API_NAME = 'TaichungSaveRememberObjectCacheRefreshFacing'
+HEADER_ADDITION = ('// A qualified object-cache refresh calls this after filling continueGameWarp,\n'
+                   '// before setting its pending flag. Reuses the existing one-shot facing state.\n'
+                   'void TaichungSaveRememberObjectCacheRefreshFacing(void);\n')
+ROOMS = (
+    ('TaichungMiyahara_Gym', 'MIYAHARA', 'WOMAN_2', 'Miyahara'),
+    ('TaichungPark_Gym', 'PARK', 'MAN', 'Park'),
+    ('TaichungShenJi_Gym', 'SHEN_JI', 'LASS', 'ShenJi'),
+    ('TaichungFineArts_Gym', 'FINE_ARTS', 'WOMAN_1', 'FineArts'),
+    ('TaichungMapleGarden_Gym', 'MAPLE_GARDEN', 'SCIENTIST', 'MapleGarden'),
+)
+MAP_PATHS = tuple(f'data/maps/{name}/map.json' for name, *_ in ROOMS)
+# The files this increment owns. A guard that peels other layers (the city rework) passes
+# nested_check only its overrides of these; everything else is read from the actual tree.
+OWNED = frozenset(MAP_PATHS + (MANIFEST, SAVE, HEADER, CHARACTERS, IDS))
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def same_json(before, after):
+    # Preserve scalar types as well as values, including false/0 and 3/3.0.
+    return json.dumps(before, sort_keys=True, separators=(',', ':'), allow_nan=False) == json.dumps(after, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+class Files:
+    def __init__(self, source, revision=None, overrides=None):
+        self.source, self.revision = Path(source), revision
+        self.cache = dict(overrides or {})
+
+    def read(self, path):
+        if path not in self.cache:
+            if self.revision is None:
+                self.cache[path] = (self.source / path).read_bytes()
+            else:
+                result = subprocess.run(['git', 'show', f'{self.revision}:{path}'], cwd=self.source,
+                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                if result.returncode:
+                    raise FileNotFoundError(f'{self.revision}:{path}')
+                self.cache[path] = result.stdout
+        if self.cache[path] is None:
+            raise FileNotFoundError(path)
+        return self.cache[path]
+
+    def has(self, path):
+        try:
+            self.read(path)
+            return True
+        except FileNotFoundError:
+            return False
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
+        return json.loads(self.read(path))
+
+
+STREET_SIGNS_GUARD = 'tools/taichung/street_signs.py'
+
+
+def street_signs_underneath(files):
+    path = Path(files.source) / STREET_SIGNS_GUARD
+    if not path.exists():
+        return {}
+    spec = importlib.util.spec_from_file_location('registered_street_signs_guard', path)
+    guard = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(guard)
+    return guard.underneath(files)
+
+
+def actor(local, graphics, script):
+    return dict(local_id='LOCALID_TAICHUNG_STAFF_' + local, type='object',
+                graphics_id='OBJ_EVENT_GFX_' + graphics, x=3, y=9, elevation=3,
+                movement_type='MOVEMENT_TYPE_FACE_DOWN', movement_range_x=0,
+                movement_range_y=0, trainer_type='TRAINER_TYPE_NONE',
+                trainer_sight_or_berry_tree_id='0', script='TaichungHistory_Staff' + script, flag='0')
+
+
+def function_text(text, name):
+    match = re.search(r'^(?:static\s+)?\w+\s+' + re.escape(name) + r'\([^;]*?\)\s*\{', text, re.M)
+    if match is None:
+        raise ValueError('Missing function: ' + name)
+    start, depth = match.start(), 1
+    for end in range(match.end(), len(text)):
+        depth += (text[end] == '{') - (text[end] == '}')
+        if depth == 0:
+            return text[start:end + 1]
+    raise ValueError('Unclosed function: ' + name)
+
+
+def matches_map(before, after, name, proof):
+    """Restore exactly one registered appended actor; preserve the whole map."""
+    path = f'data/maps/{name}/map.json'
+    if not proof.get('active') or path not in MAP_PATHS:
+        return same_json(before, after)
+    if not proof.get('passed') or path not in proof.get('maps', {}):
+        return False
+    expected = proof['maps'][path]
+    if not same_json(before, expected['before']) or not same_json(after, expected['after']):
+        return False
+    restored = deepcopy(after)
+    if len(restored.get('object_events', [])) != len(before.get('object_events', [])) + 1:
+        return False
+    if not same_json(restored['object_events'][-1], expected['actor']):
+        return False
+    restored['object_events'].pop()
+    return same_json(before, restored)
+
+
+def header_underneath(raw, proof):
+    if not proof.get('active') or not proof.get('passed'):
+        return raw
+    if digest(raw) not in (proof['sourceSha256'][HEADER], proof.get('legacySourceSha256', {}).get(HEADER)):
+        return raw
+    text = raw.decode()
+    if text.count(HEADER_ADDITION) != 1:
+        return raw
+    return text.replace(HEADER_ADDITION, '', 1).encode()
+
+
+def save_underneath(raw, proof):
+    """Remove only the already independently attested wrapper for v9 proof."""
+    if not proof.get('active') or not proof.get('passed'):
+        return raw
+    if digest(raw) not in (proof['sourceSha256'][SAVE], proof.get('legacySourceSha256', {}).get(SAVE)):
+        return raw
+    text = raw.decode()
+    wrapper = function_text(text, API_NAME) + '\n\n'
+    if text.count(wrapper) != 1:
+        return raw
+    return text.replace(wrapper, '', 1).encode()
+
+
+class StaffProjection(dict):
+    """A legacy view that retains the actual inputs for nested current guards."""
+    def __init__(self, values, source, actual):
+        super().__init__(values)
+        self._staff_projection_source = str(Path(source).resolve())
+        self._staff_actual_overrides = dict(actual or {})
+
+
+def legacy_overrides(source, proof, overrides=None):
+    """Forward all edits, substituting only fully proved five-map underlays."""
+    edits = dict(overrides or {})
+    if not proof.get('active'):
+        return edits
+    if not proof.get('passed') or set(proof.get('maps', {})) != set(MAP_PATHS):
+        raise ValueError('Cannot substitute staff maps before the complete current proof')
+    baseline = Files(source, BASE)
+    edits.update({path: baseline.read(path) for path in MAP_PATHS})
+    return StaffProjection(edits, source, overrides)
+
+
+def current_overrides(source, overrides):
+    """Re-prove, then unwrap a legacy projection at a current-guard boundary.
+
+    FinalXitun delegates back to the current streets guard. That guard must see
+    the original actual inputs, not mistake its caller's verified historical
+    map view for a current staff deletion. Ordinary mutation dicts have no view
+    metadata and are never normalized or excused here.
+    """
+    if not hasattr(overrides, '_staff_actual_overrides'):
+        return overrides
+    if overrides._staff_projection_source != str(Path(source).resolve()):
+        raise ValueError('Staff projection belongs to a different source')
+    actual = dict(overrides._staff_actual_overrides)
+    proof = check(source, actual)
+    if not proof['active'] or not proof['passed']:
+        raise ValueError('Staff projection no longer has a complete current proof')
+    expected = legacy_overrides(source, proof, actual)
+    if set(overrides) != set(expected) or any(overrides[path] != expected[path] for path in expected):
+        raise ValueError('Staff projection changed beyond its independently proved map underlay')
+    return actual
+
+
+def check_final_xitun(source=ROOT, overrides=None):
+    """Current-batch wrapper; the raw FinalXitun checker stays unchanged/strict."""
+    proof = check(source, overrides)
+    if not proof['passed']:
+        return dict(passed=False, errors=proof['errors'], checks={},
+                    registeredStaff=dict(currentProofPassed=False, substitutedMaps=[]))
+    path = Path(source) / 'tools/taichung/landmarks/check_xitun_final.py'
+    spec = importlib.util.spec_from_file_location('gym_staff_legacy_final_xitun', path)
+    legacy = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(legacy)
+    if proof.get('cityRework'):
+        # With the registered city, FinalXitun reads the staff rooms through this proof itself
+        # (its city layering would drop a projection), so it gets the actual inputs.
+        result = legacy.check(Path(source), overrides)
+        return {**result, 'registeredStaff': dict(currentProofPassed=True, substitutedMaps=[],
+                forwardedOverridePaths=sorted(overrides or {}), rawGuardModified=True, runtimeProof=False)}
+    edits = legacy_overrides(source, proof, overrides)
+    result = legacy.check(Path(source), edits)
+    return {**result, 'registeredStaff': dict(currentProofPassed=True,
+            substitutedMaps=list(MAP_PATHS) if proof['active'] else [],
+            forwardedOverridePaths=sorted(path for path in (overrides or {}) if path not in MAP_PATHS),
+            rawGuardModified=False, runtimeProof=False)}
+
+
+def script_dependencies(files):
+    wanted = sorted('TaichungHistory_Staff' + script for _, _, _, script in ROOMS)
+    found, seen = {label: [] for label in wanted}, set()
+    pending = ['data/event_scripts.s']
+    while pending:
+        path = pending.pop()
+        if path in seen or not files.has(path):
+            continue
+        seen.add(path)
+        text = files.text(path)
+        for label in wanted:
+            for _ in re.finditer(r'^' + label + r'::?\s*$', text, re.M):
+                found[label].append(path)
+        pending.extend(re.findall(r'^\s*\.include\s+"([^"]+)"', text, re.M))
+    missing = [label for label, paths in found.items() if len(paths) != 1]
+    return dict(resolved=not missing, definitions=found, missingOrDuplicate=missing)
+
+
+def check(source=ROOT, overrides=None, revision=None):
+    now, before, staff, api = (Files(source, revision, overrides), Files(source, BASE),
+                               Files(source, STAFF), Files(source, API))
+    active = now.has(MANIFEST) or any('LOCALID_TAICHUNG_STAFF_' in now.text(path) for path in MAP_PATHS if now.has(path))
+    active = active or (now.has(HEADER) and API_NAME in now.text(HEADER))
+    result = dict(active=active, passed=True, errors=[], checks={}, maps={}, sourceSha256={},
+                  scriptDependencies=dict(resolved=True, definitions={}, missingOrDuplicate=[]))
+    if not active:
+        return result
+    city = Files(source, CITY) if now.has(CITY_RECORD) else None
+    comparison = city or before
+    result['cityRework'] = CITY if city else None
+    # The registered street-sign layer edits three outdoor maps after the city; its own
+    # guard proves that delta, so the other maps are compared underneath it.
+    signs = street_signs_underneath(now)
+
+    def reviewed(path):
+        return signs.get(path, now.read(path)) == comparison.read(path)
+
+    def require(condition, message):
+        if not condition:
+            raise ValueError(message)
+
+    registration = None
+
+    def registered_maps():
+        nonlocal registration
+        raw = now.read(MANIFEST)
+        require(digest(raw) == MANIFEST_SHA256 and raw == staff.read(MANIFEST), 'Manifest/current/immutable staff registration differs')
+        registration = json.loads(raw)
+        require(registration['schemaVersion'] == 1 and registration['baselineCommit'] == BASE, 'Staff registration baseline/schema differs')
+        require(len(registration['staff']) == len(ROOMS), 'Staff cohort must contain exactly five rooms')
+        for item, (name, local, graphics, script) in zip(registration['staff'], ROOMS):
+            path = f'data/maps/{name}/map.json'
+            require(item['mapPath'] == path, 'Staff registration room/order differs')
+            old, current = before.json(path), now.json(path)
+            expected_actor = actor(local, graphics, script)
+            require(same_json(item['addedObject'], expected_actor), 'Unreviewed actor record: ' + name)
+            require(item['localIdValue'] == 2 and type(item['localIdValue']) is int, 'Unreviewed local ID value')
+            require(digest(before.read(path)) == item['baselineMapSha256'], 'Immutable baseline map differs: ' + name)
+            require(digest(now.read(path)) == item['installedMapSha256'] and now.read(path) == staff.read(path), 'Current/immutable installed map differs: ' + name)
+            require(len(old['object_events']) == 1 and len(current['object_events']) == 2, 'Staff count/order differs: ' + name)
+            restored = deepcopy(current)
+            require(same_json(restored['object_events'][-1], expected_actor), 'Staff appended object differs: ' + name)
+            restored['object_events'].pop()
+            require(same_json(old, restored), 'Existing host/warps/layout/metadata changed: ' + name)
+            require(item['preservedHostIndex'] == 0 and same_json(item['unchangedWarpEvents'], old['warp_events']), 'Registered host/warp evidence differs')
+            require(current['id'] == item['mapId'] and current['layout'] == 'LAYOUT_TAICHUNG_LANDMARK_GYM' and current['connections'] is None, 'Room interface differs')
+            result['maps'][path] = dict(before=old, after=current, actor=expected_actor)
+        for path, expected in registration['unchangedInputsSha256'].items():
+            require(digest(before.read(path)) == expected, 'Immutable unrelated input registration changed: ' + path)
+            require(reviewed(path), 'Unrelated input changed: ' + path)
+        if city:
+            for path in MAP_PATHS + ('data/layouts/TaichungLandmarkGym/map.bin', 'data/layouts/TaichungLandmarkGym/border.bin'):
+                require(city.read(path) == before.read(path), 'Registered city changed a staff room: ' + path)
+        for name in comparison.json('data/maps/map_groups.json')['gMapGroup_Taichung']:
+            path = f'data/maps/{name}/map.json'
+            if path not in MAP_PATHS:
+                require(reviewed(path), 'Unregistered map/actor changed: ' + name)
+        return dict(rooms=5, allOriginalMapFieldsRestored=True)
+
+    def source_and_facing():
+        require(registration is not None, 'Missing verified registration')
+        require(registration['facingBridgeDependency']['sourceCommit'] == API and registration['facingBridgeDependency']['function'] == API_NAME, 'Facing dependency differs')
+        for path, expected in registration['sourceFilesSha256'].items():
+            require(now.read(path) == staff.read(path) and digest(now.read(path)) == expected, 'Staff source/immutable attestation differs: ' + path)
+        wrapper = function_text(api.text(SAVE), API_NAME)
+        frozen_pair = all(now.read(path) == api.read(path) for path in (SAVE, HEADER))
+        if city:
+            result['legacySourceSha256'] = {path: digest(api.read(path)) for path in (SAVE, HEADER)}
+        if city and not frozen_pair:
+            # Over the city's save pair: the frozen wrapper, delegating with the current version.
+            require(wrapper.count('    ' + DELEGATE_V9) == 1, 'Frozen facing wrapper differs')
+            wrapper = wrapper.replace('    ' + DELEGATE_V9, CITY_NOTE + '    ' + DELEGATE_CITY)
+            delegate, underneath = DELEGATE_CITY, city
+        else:
+            for path in (SAVE, HEADER):
+                require(now.read(path) == api.read(path), 'Facing API source/immutable attestation differs: ' + path)
+            delegate, underneath = DELEGATE_V9, before
+        require(reviewed('src/overworld.c'), 'Existing object-init/Continue hook changed')
+        header = now.text(HEADER)
+        require(header.count(HEADER_ADDITION) == 1 and header.replace(HEADER_ADDITION, '', 1) == underneath.text(HEADER), 'Header differs beyond exact API declaration/comments')
+        code = now.text(SAVE)
+        require(code.count(wrapper + '\n\n') == 1 and code.replace(wrapper + '\n\n', '', 1) == underneath.text(SAVE), 'Save source differs beyond exact API wrapper')
+        require('gSaveBlock1Ptr == NULL || UseContinueGameWarp()' in wrapper and 'warp->warpId != -1' in wrapper and 'warp->mapGroup != gSaveBlock1Ptr->location.mapGroup' in wrapper and 'warp->mapNum != gSaveBlock1Ptr->location.mapNum' in wrapper, 'Facing API priority/identity guard differs')
+        require(wrapper.count('RememberCacheRefreshFacing(') == 1 and wrapper.count(delegate) == 1, 'Facing wrapper must delegate once')
+        characters = now.text(CHARACTERS)
+        body = function_text(characters, 'TaichungCharactersRefreshOnContinue')
+        ordered = ('gSaveBlock1Ptr == NULL || UseContinueGameWarp()', '*warp = gSaveBlock1Ptr->location;', 'warp->warpId = -1;', 'warp->x = gSaveBlock1Ptr->pos.x;', 'warp->y = gSaveBlock1Ptr->pos.y;', API_NAME + '();', 'SetContinueGameWarpStatus();')
+        offsets = [body.find(fragment) for fragment in ordered]
+        require(all(offset >= 0 for offset in offsets) and offsets == sorted(offsets) and body.count(API_NAME + '();') == 1, 'Qualified cache/facing handoff order differs')
+        qualified = function_text(characters, 'IsNewGymStaff')
+        for _, local, graphics, _ in ROOMS:
+            require(f'case MAP_NUM(MAP_TAICHUNG_{local}_GYM):' in qualified and f'return localId == LOCALID_TAICHUNG_STAFF_{local} && graphicsId == OBJ_EVENT_GFX_{graphics};' in qualified, 'Vanilla staff identity qualification differs: ' + local)
+            require(re.search(r'#ifndef ' + 'LOCALID_TAICHUNG_STAFF_' + local + r'\s*\n#define LOCALID_TAICHUNG_STAFF_' + local + r'\s+2\s*\n#endif', now.text(IDS)), 'Guarded local-ID definition differs: ' + local)
+        for path in (SAVE, HEADER, 'src/overworld.c', CHARACTERS, IDS):
+            result['sourceSha256'][path] = digest(now.read(path))
+        return dict(exactFrozenApi=True, existingSaveBodiesTablesStorageAndOverworldUnchanged=True, exactQualifiedCaller=True)
+
+    def geometry():
+        require(registration is not None, 'Missing verified registration')
+        native_path = 'tools/taichung/validate_city.py'
+        require(reviewed(native_path), 'Native movement rules changed')
+        spec = importlib.util.spec_from_file_location('gym_staff_native_rules', Path(source) / native_path)
+        native = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(native)
+        layouts = {item['id']: item for item in now.json('data/layouts/layouts.json')['layouts'] if 'id' in item}
+        for path in ('src/data/tilesets/headers.h', 'src/data/tilesets/metatiles.h'):
+            require(reviewed(path), 'Native room binding changed: ' + path)
+        headers, declarations = now.text('src/data/tilesets/headers.h'), now.text('src/data/tilesets/metatiles.h')
+
+        def attributes(label):
+            header = re.search(r'\b' + re.escape(label) + r'\s*=\s*\{(.*?)\};', headers, re.S)
+            require(header is not None, 'Missing room tileset')
+            paths = {}
+            for field in ('metatiles', 'metatileAttributes'):
+                symbol = re.search(r'\.' + field + r'\s*=\s*(\w+)', header[1])[1]
+                declaration = re.search(r'\b' + symbol + r'\s*\[.*?=\s*(.*?);', declarations, re.S)
+                path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration[1])[1]
+                require(now.read(path) == before.read(path), 'Room metatiles/attributes changed: ' + path)
+                paths[field] = now.read(path)
+            values = struct.unpack('<' + 'I' * (len(paths['metatileAttributes']) // 4), paths['metatileAttributes'])
+            require(len(paths['metatiles']) == len(values) * 16, 'Room native bank lengths disagree')
+            return values
+
+        cases = []
+        for item in registration['staff']:
+            data = before.json(item['mapPath']); layout = layouts[data['layout']]
+            original = next(row for row in before.json('data/layouts/layouts.json')['layouts'] if row.get('id') == data['layout'])
+            require(same_json(layout, original), 'Staff room layout changed')
+            view = native.Map.__new__(native.Map)
+            view.data, view.layout, view.id = data, layout, data['id']
+            view.width, view.height = layout['width'], layout['height']
+            view.cells = struct.unpack('<' + 'H' * (len(now.read(layout['blockdata_filepath'])) // 2), now.read(layout['blockdata_filepath']))
+            view.attributes = [attributes(layout[key]) for key in ('primary_tileset', 'secondary_tileset')]
+            view.actors = {(obj['x'], obj['y']) for obj in data['object_events']}
+            view.signs = {(obj['x'], obj['y']) for obj in data['bg_events']}
+            view.obstacles = view.actors | view.signs
+            require(same_json(item['authored'], [3, 9]) and same_json(item['overlapFallback'], [4, 9]), 'Staff positions differ')
+            for x, y in ((3, 9), (4, 9)):
+                require(view.walkable(x, y) and view.cell(x, y) == 0x3294 and view.behavior(x, y) == 0 and view.elevation(x, y) == 3, 'Staff/fallback is not ordinary elevation3 ground')
+                blocked = view.obstacles | {(x, y)}
+                visited, queue = {(6, 14)}, deque([(6, 14)])
+                while queue:
+                    a, b = queue.popleft()
+                    for c, d in ((a - 1, b), (a + 1, b), (a, b - 1), (a, b + 1)):
+                        if (c, d) not in visited and (c, d) not in blocked and view.can_step(a, b, view, c, d):
+                            visited.add((c, d)); queue.append((c, d))
+                targets = {(5, 14), (6, 14), (7, 14), (6, 6), (x, y + 1)}
+                if x == 4:
+                    targets.add((3, 9))
+                require(targets <= visited and len(visited) == 130, 'Staff strands an exit/leader/talk/player position')
+                cases.append(dict(map=item['mapId'], staff=[x, y], reachableFloorCells=len(visited)))
+        return dict(nativeCases=cases)
+
+    for label, function in (('registrationAndExactMapDelta', registered_maps), ('sourceAndFacingHandoff', source_and_facing), ('authoredAndFallbackGeometry', geometry)):
+        try:
+            result['checks'][label] = dict(passed=True, **function())
+        except (ValueError, KeyError, IndexError, TypeError, FileNotFoundError, AssertionError, AttributeError, struct.error) as error:
+            result['checks'][label] = dict(passed=False)
+            result['errors'].append(label + ': ' + str(error))
+    result['passed'] = not result['errors']
+    result['scriptDependencies'] = script_dependencies(now)
+    return result
+
+
+def nested_check(source=ROOT, overrides=None):
+    """check() for a guard that peels other registered layers: only its overrides of the files
+    this increment owns reach the proof; every other input is the actual tree's."""
+    return check(source, {path: data for path, data in (overrides or {}).items() if path in OWNED})
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ROOT)
+    parser.add_argument('--revision')
+    parser.add_argument('--final-xitun', action='store_true', help='Verify current staff first, then run unchanged FinalXitun against only its five proved map underlays')
+    args = parser.parse_args()
+    if args.final_xitun and args.revision is not None:
+        parser.error('--final-xitun checks the actual current tree, not a historical revision')
+    report = check_final_xitun(args.source) if args.final_xitun else check(args.source, revision=args.revision)
+    print(json.dumps({key:value for key,value in report.items() if key != 'maps'}, indent=2))
+    raise SystemExit(0 if report['passed'] else 1)
