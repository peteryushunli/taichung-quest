+def render(data, path):
+    from PIL import Image,ImageDraw,ImageFont
+    image=Image.new("RGB",(1480,1240),"#f4f1e8");d=ImageDraw.Draw(image)
+    font_path="/System/Library/Fonts/STHeiti Light.ttc"
+    title=ImageFont.truetype(font_path,30);font=ImageFont.truetype(font_path,18);small=ImageFont.truetype(font_path,15);heading=ImageFont.truetype(font_path,21)
+    d.text((35,22),"Taichung · 16-section neighborhood character inputs",font=title,fill="#24323b")
+    d.text((35,66),"Background authoring metadata. All bars are game-design targets, not surveyed percentages. R2C2 is the active approved pilot.",font=font,fill="#465661")
+    colors={"residential":"#9db8c6","retailFood":"#d5a560","officeService":"#9b97b8","civicCultural":"#8fae7b","workshopIndustry":"#a3a6a1","olderMasonry":"#b96c4c","midEraMixedUse":"#aaa692","contemporary":"#64a6a0"}
+    def bar(x,y,m,width=305):
+        cursor=x
+        for key,v in m.items():
+            end=cursor+width*v
+            d.rectangle((round(cursor),y,round(end),y+12),fill=colors[key])
+            cursor=end
+    for s in data["sections"]:
+        x=35+s["gridCol"]*360;y=111+s["gridRow"]*250
+        active=s["id"]=="city-v2-r2-c2"
+        d.rounded_rectangle((x,y,x+335,y+232),radius=8,fill="#fffdf8",outline="#4f6d7a" if active else "#d4d6cc",width=3 if active else 1)
+        label=f"R{s['gridRow']}C{s['gridCol']}  {s['nameZh']}"
+        d.text((x+13,y+12),label,font=heading,fill="#24323b")
+        name_lines=textwrap.wrap(s["name"],width=34)
+        for i,line in enumerate(name_lines[:2]): d.text((x+13,y+42+i*20),line,font=small,fill="#465661")
+        t=s["authoredVisualTargets"]
+        d.text((x+13,y+86),"USE · home / retail / office / civic / work",font=small,fill="#465661")
+        bar(x+13,y+110,t["useMix"])
+        d.text((x+13,y+134),"STYLE · older / mature / contemporary",font=small,fill="#465661")
+        bar(x+13,y+158,t["ageStyleMix"])
+        d.text((x+13,y+183),f"Infill {t['builtCoverageTarget']:.0%}  Green {t['greenSpaceFraction']:.0%}  High-rise intent {t['heightMix']['highRise']:.0%}",font=small,fill="#24323b")
+        d.text((x+13,y+208),f"Evidence transfer: {s['confidence']['broadCharacter']}"+(" · PILOT" if active else ""),font=small,fill="#4f6d7a")
+    d.text((35,1133),"Each section has separate main-frontage and residential-side-street overrides. Palette and height vary by coherent frontage runs.",font=font,fill="#465661")
+    d.text((35,1170),"No exact building age, parcel zoning, building footprint or population-density layer is claimed. No native maps or baseline doors changed.",font=font,fill="#465661")
+    image.save(path)
