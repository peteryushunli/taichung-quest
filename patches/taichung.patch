+
+ROOT = Path(__file__).resolve().parents[2]
+CONTRACT = 'data/taichung/minimap-contract.json'
+
+
+def require(condition, message):
+    if not condition: raise ValueError(message)
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()
+
+
+def in_bounds(x, y, width, height):
+    return type(x) is int and type(y) is int and 0 <= x < width and 0 <= y < height
+
+
+def project_position(contract, native_key, x, y):
+    """Unknown/invalid inputs return None. Indoor XY never becomes world XY."""
+    entry = contract['mapsByNativeKey'].get(native_key)
+    if entry is None or not in_bounds(x, y, entry['width'], entry['height']): return None
+    indoor = entry['kind'] == 'interior'
+    world = entry['parentEntranceWorld'][:] if indoor else [entry['worldOrigin'][0] + x, entry['worldOrigin'][1] + y]
+    bounds = contract['world']
+    if not in_bounds(world[0], world[1], bounds['width'], bounds['height']): return None
+    return dict(world=world, indoor=indoor, mode='parent-entrance' if indoor else 'live-outdoor',
+                parentMarkerId=entry.get('parentMarkerId'), inBounds=True,
+                normalizedCellCenter=[(world[0] + .5) / bounds['width'], (world[1] + .5) / bounds['height']])
+
+
+def inverse_world(contract, x, y):
+    """Return the one covering exterior and local tile, or None for blank canvas."""
+    if not in_bounds(x, y, contract['world']['width'], contract['world']['height']): return None
+    found = []
+    for key, entry in contract['mapsByNativeKey'].items():
+        if entry['kind'] != 'exterior': continue
+        lx, ly = x - entry['worldOrigin'][0], y - entry['worldOrigin'][1]
+        if in_bounds(lx, ly, entry['width'], entry['height']): found.append(dict(nativeKey=key, local=[lx, ly]))
+    require(len(found) <= 1, 'Exterior world rectangles overlap')
+    return found[0] if found else None
+
+
+def build_contract(source=ROOT):
+    source = Path(source); loaded_hashes = {}
+    def load(path):
+        raw = path.read_bytes(); loaded_hashes[path] = hashlib.sha256(raw).hexdigest()
