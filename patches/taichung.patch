+)
+SIGNS = ("OldStation", "Park", "Miyahara", "ScienceMuseum", "Greenway", "ShenJi",
+         "FineArts", "Fengjia", "MapleGarden", "Theater", "WenchangTemple", "WanheTemple",
+         "BotanicalGarden", "ConfuciusTemple", "YizhongStreet", "PrefecturalHall", "SecondMarket",
+         "CulturalHeritagePark", "FengleSculpturePark", "WenxinForestPark")
+SITES = {8: 0, 10: 1, 12: 2, 13: 3, 14: 4, 15: 5, 16: 6, 17: 7, 18: 8, 19: 9}
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def reader(source=ROOT, overrides=None):
+    overrides = overrides or {}
+    def read(path):
+        if path in overrides:
+            if overrides[path] is None:
+                raise FileNotFoundError(path)
+            return overrides[path]
+        return (Path(source) / path).read_bytes()
+    return read
+
+
+def active(read):
+    for path in (REGISTRATION, *INTRODUCED_INPUTS):
+        try:
+            read(path)
+            return True
+        except FileNotFoundError:
+            pass
+    for path, marker in (("data/scripts/taichung_city.inc", b"goto TaichungStory_Sign"),
+                         ("include/constants/menu.h", b"MULTICHOICE_TAICHUNG_STORY_"),
+                         ("src/script_menu.c", b"MULTICHOICE_TAICHUNG_STORY_CHALLENGE")):
+        try:
+            if marker in read(path):
+                return True
+        except FileNotFoundError:
+            pass
+    # A partially removed layer must not escape qualification by retaining only
+    # its append or an older script entry point after deleting its manifest.
+    for path, marker in (("data/scripts/taichung_landmark_history.inc", b"TaichungStory_"),
+                         ("data/taichung_character_npcs.s", b"TaichungStory_")):
+        if marker in read(path):
+            return True
+    if len(re.findall(r"^'.' = FC 19 [0-9A-F]{2} [0-9A-F]{2}$", read(CHARMAP).decode(), re.M)) > 808:
+        return True
+    if len(re.findall(r"^\s*\{[^{}\n]+\}, // \d+: .\n", read(GLYPHS).decode(), re.M)) > 808:
+        return True
+    return False
+
+
+def load(read):
+    raw = read(REGISTRATION)
+    require(sha(raw) == REGISTRATION_SHA256, "Compact Story registration changed")
+    record = json.loads(raw)
+    require(record["baseline"] == BASE and record["feature"] == FEATURE, "Story source pins changed")
+    require(len(record["edited"]) == 7 and len(record["added"]) == 37, "Story input inventory changed")
+    require(set(record["added"]) == set(INTRODUCED_INPUTS), "Story activation inventory changed")
+    return record
+
+
+def bundle(read, record):
+    raw = read(BUNDLE)
+    require(sha(raw) == record["baselineBundleSha256"], "Story baseline bundle changed")
+    with zipfile.ZipFile(BytesIO(raw)) as archive:
+        names = archive.namelist()
+        require(len(names) == len(set(names)) and set(names) == set(record["baselineBundleEntries"]),
+                "Story baseline inventory changed")
+        result = {name: archive.read(name) for name in names}
+    for path, expected in record["baselineBundleEntries"].items():
+        require(sha(result[path]) == expected, "Story baseline member changed: " + path)
+    return result
+
+
+def glyph_append(old_map, new_map, old_header, new_header, count):
+    mapping = re.compile(r"^'(.)' = FC 19 ([0-9A-F]{2}) ([0-9A-F]{2})$", re.M)
+    rows = re.compile(r"^([ \t]*\{([^{}\n]+)\}, // (\d+): (.)\n)", re.M)
+    old_codes, codes = mapping.findall(old_map.decode()), mapping.findall(new_map.decode())
+    old_rows, current = rows.findall(old_header.decode()), rows.findall(new_header.decode())
+    require(new_map.startswith(old_map), "Story changed old charmap bytes")
+    require(len(old_codes) == len(old_rows) == count and len(codes) == len(current) == 1023,
+            "Story glyph count changed")
+    require(codes[:count] == old_codes and current[:count] == old_rows, "Story changed earlier glyph indices/bitmaps")
+    suffix = new_map[len(old_map):].decode().splitlines()
+    require(len(suffix) == 1023 - count and all(mapping.fullmatch(line) for line in suffix),
+            "Story charmap append changed")
+    restored, chars = new_header.decode(), set()
+    for index, ((line, masks, number, char), (mapped, low, high)) in enumerate(zip(current, codes)):
+        require(int(number) == index and char == mapped and char not in chars, "Story glyph index/character differs")
+        require((int(low, 16), int(high, 16)) == (index % 240 + 1, index // 240 + 1), "Story glyph encoding differs")
+        values = [int(value.strip(), 16) for value in masks.split(",")]
+        require(len(values) == 14 and all(0 <= value <= 0xFFF for value in values) and any(values),
+                "Story glyph cell differs")
+        chars.add(char)
+        if index >= count:
+            require(restored.count(line) == 1, "Ambiguous Story glyph row")
+            restored = restored.replace(line, "", 1)
+    require(restored.encode() == old_header, "Story font changed outside appended rows")
+    return current
+
+
+def semantics(read, stored):
+    rows = glyph_append(stored["before/" + CHARMAP], read(CHARMAP),
+                        stored["before/" + GLYPHS], read(GLYPHS), 808)
+    glyph_append(stored["prefix857/" + CHARMAP], read(CHARMAP),
+                 stored["prefix857/" + GLYPHS], read(GLYPHS), 857)
+    for path, start, end in (("docs/localization/optional-story-glyphs.json", 808, 857),
+                             ("docs/localization/optional-story-all20-glyphs.json", 857, 1023)):
+        doc = json.loads(read(path))
+        require((doc["existingCount"], doc["finalCount"], doc["addedCount"]) == (start, end, end - start),
+                "Story glyph receipt count differs")
+        require(len(doc["additions"]) == end - start, "Story glyph receipt rows differ")
+        for index, row in enumerate(doc["additions"], start):
+            _, masks, number, char = rows[index]
+            require(row["index"] == int(number) == index and row["character"] == char
+                    and row["encoding"] == [252, 25, index % 240 + 1, index // 240 + 1]
+                    and [int(x, 16) for x in row["masks"]] == [int(x.strip(), 16) for x in masks.split(",")],
+                    "Story glyph receipt does not describe the real bitmap")
+    manifest = json.loads(read(MANIFEST))
+    require(manifest["baselineNative"] == BASE and manifest["frontendSourceCommit"] ==
+            "bdde783a0ee7077918b09b713150903eee2b46a1", "Story package source changed")
+    records = manifest["records"]
+    require([r["historyId"] for r in records] == list(range(20)), "Story package roster changed")
+    city = read("data/scripts/taichung_city.inc").decode()
+    bindings = read("data/scripts/taichung_optional_story_bindings.inc").decode()
+    for index, row in enumerate(records):
+        require(sha(read("data/taichung/optional-story/" + row["file"])) == row["sha256"], "Story package differs")
+        require(row["signLabel"] == "TaichungCity_Sign_" + SIGNS[index], "Story sign/place binding changed")
+        require(row.get("leaderGymId") == (8 if index == 11 else index if index < 10 and index != 8 else None),
+                "Story leader/history cohort changed")
+        require(row.get("encounterSite") == SITES.get(index), "Story capture/history cohort changed")
+        require(re.search(r"^" + row["signLabel"] + r"::\n\tgoto TaichungStory_Sign" + str(index) + r"\n", city, re.M),
+                "Installed Story sign redirects to the wrong place")
+        body = re.search(r"^TaichungStory_Sign" + str(index) + r"::\n(.*?)(?=^\w+::|\Z)", bindings, re.M | re.S)[1]
+        require("\tsetvar VAR_0x8004, " + str(index) + "\n" in body and "MSGBOX_SIGN" in body,
+                "Story sign lost its identity/short sign")
+        if index in SITES and index != 10:
+            require("\tcall TaichungStory_SiteMenu\n" in body and "\tgoto " + row["encounterWrapper"] + "\n" in body,
+                    "Existing capture sign lost its original wrapper")
+        else:
+            require("\tcall TaichungStory_VisitMenu\n" in body and "TaichungEncounter_" not in body,
+                    "Informational sign became a capture entry")
+    menu = read("include/constants/menu.h").decode()
+    for index, name in enumerate(("CHALLENGE", "VISIT", "STAFF", "SCIENCE", "SITE"), 70):
+        require(re.search(r"^#define MULTICHOICE_TAICHUNG_STORY_" + name + r"\s+" + str(index) + r"$", menu, re.M),
+                "Story menu ID changed")
+    require(re.search(rb"#define TAICHUNG_SAVE_VERSION 12\b", read("include/taichung_save.h")), "Story changed Save version")
+    require(json.loads(read("data/taichung/minimap-contract.json"))["geometryFingerprintSha256"] == GEOMETRY,
+            "Story geometry changed")
+    require(len(json.loads(read("data/maps/map_groups.json"))["gMapGroup_Taichung"]) == 21,
+            "Story activated a new native context")
+    require(re.search(rb"#define TAICHUNG_ENCOUNTER_BRIDGE_SIZE 64\b", read("include/taichung_encounter_bridge.h")),
+            "Story changed the capture bridge ABI")
+    require(re.search(rb"#define TAICHUNG_ENCOUNTER_COUNT 14\b", read("include/constants/taichung_encounters.h")),
+            "Story changed stable capture count")
+    return dict(packages=20, signs=20, leaders=10, captureSites=10, nativeContexts=21,
+                glyphs=1023, releasedGlyphPrefix=808, intermediateGlyphPrefix=857,
+                geometry=GEOMETRY, saveVersion=12, captureBridgeAbiBytes=64, stableCaptureIds=list(range(14)),
+                newPlacesActivated=False, earlierBitmapsByteExact=True)
+
+
+def verified(read):
+    record = load(read)
+    for path, row in record["edited"].items():
+        require(sha(read(path)) == row["after"], "Story edited input changed: " + path)
+    for path, expected in {**record["added"], **record["dependencies"]}.items():
+        require(sha(read(path)) == expected, "Story added/dependency changed: " + path)
+    stored = bundle(read, record)
+    before = {path: stored["before/" + path] for path in record["edited"]}
+    for path, raw in before.items():
+        require(sha(raw) == record["edited"][path]["before"], "Story prior input differs: " + path)
+    require(not any(p.startswith(("data/maps/", "data/layouts/", "data/tilesets/", "graphics/")) for p in before),
+            "Story qualifier must not substitute geometry/art")
+    detail = semantics(read, stored)
+    return dict(passed=True, active=True, baseline=BASE, feature=FEATURE, edited=len(before),
+                added=len(record["added"]), dependencies=len(record["dependencies"]), checks=detail,
+                runtimeAcceptanceClaimed=False), before
+
+
+def peel(read):
+    return verified(read)[1] if active(read) else {}
+
+
+def hidden(read):
+    if not active(read):
+        return set()
+    verified(read)
+    return set(load(read)["added"]) | {REGISTRATION, BUNDLE}
+
+
+def check(source=ROOT, overrides=None):
+    try:
+        read = reader(source, overrides)
+        return verified(read)[0] if active(read) else dict(passed=True, active=False)
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        return dict(passed=False, errors=[str(error)])
+
+
+@contextlib.contextmanager
+def qualified_mirror(source=ROOT, overrides=None):
+    """Verify *all* current inputs before materializing only the exact old view.
+
+    Unknown files stay present; there are no directory/C-source exemptions.
+    All source files are copied so __file__.resolve() and Git's working-tree
+    scan both observe this exact view. Git is read-only provenance for the fixed
+    archived tests. Build output is a fresh disposable directory.
+    """
+    source = Path(source).resolve(); read = reader(source, overrides)
+    _, replacements = verified(read); absent = hidden(read)
+    replacements = {**(overrides or {}), **replacements}
+    with tempfile.TemporaryDirectory(prefix="taichung-compact-story-qualified-") as folder:
+        target = Path(folder).resolve()
+        def ignored(folder, names):
+            return {"build"} if Path(folder) == source and "build" in names else set()
+        shutil.copytree(source, target, dirs_exist_ok=True, ignore=ignored)
+        for name in absent:
+            (target / name).unlink()
+        for name, raw in replacements.items():
+            dest = target / name
+            if raw is None:
+                dest.unlink(missing_ok=True)
+            else:
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                dest.write_bytes(raw)
+        yield target
+
+
+PREVIOUS_GUARDS = {
+    "capture-release": ("tools/taichung/capture_release_guard.py", "--self-test"),
+    "capture-provenance": ("tests/test_capture_release_guard.py",),
+    "gym": ("tools/taichung/gym_interiors_guard.py", "--self-test"),
+    "home": ("tools/taichung/home_start.py", "--self-test"),
+    "art": ("tools/taichung/approved_art_guard.py", "--self-test"),
+    "archived": ("tools/taichung/approved_art_guard.py", "--historical", "all", "--self-test"),
+    "field-init-capture": ("tools/taichung_gameplay/test-capture-release.py", "--previous-guard-tests"),
+}
+
+
+def previous_guards(source=ROOT):
+    current = check(source)
+    if not current["passed"]:
+        return current
+    checks = {}
+    with qualified_mirror(source) as view:
+        for name, command in PREVIOUS_GUARDS.items():
+            result = subprocess.run([sys.executable, "-B", *command], cwd=view, capture_output=True, text=True)
+            checks[name] = dict(passed=result.returncode == 0, stdout=result.stdout, stderr=result.stderr)
+    return dict(passed=all(row["passed"] for row in checks.values()), current=current, checks=checks,
+                scope="Source/historical compatibility only; current runtime acceptance remains separate")
+
+
+def self_test(source=ROOT):
+    read = reader(source); good = check(source); require(good["passed"], str(good))
+    probes = {}
+    def rejected(name, edits):
+        require(all(raw != read(path) for path, raw in edits.items()), "No-op Story probe: " + name)
+        denied = not check(source, edits)["passed"]
+        try:
+            peel(reader(source, edits)); blocked = False
+        except (OSError, ValueError, KeyError, TypeError, IndexError):
+            blocked = True
+        probes[name] = denied and blocked
+    record = load(read)
+    for path in [REGISTRATION, BUNDLE, *record["edited"], *record["added"]]:
+        rejected("changed:" + path, {path: read(path) + b"\nforeign-mutation"})
+    for path in (REGISTRATION, "data/scripts/taichung_optional_story_bindings.inc", MANIFEST,
+                 "data/taichung/optional-story/taichung-park.json", "src/taichung_optional_story.c"):
+        rejected("missing:" + path, {path: None})
+    for name, path, old, new in (
+        ("wrong-maple-sign-place", "data/scripts/taichung_city.inc", b"goto TaichungStory_Sign8\n", b"goto TaichungStory_Sign11\n"),
+        ("back-starts-challenge", "data/scripts/taichung_optional_story.inc", b"setvar VAR_RESULT, 1\n", b"setvar VAR_RESULT, 0\n"),
+        ("wrong-menu-binding", "src/script_menu.c", b"MULTICHOICE(sMultichoiceList_TaichungStorySite)", b"MULTICHOICE(sMultichoiceList_TaichungStoryVisit)"),
+        ("future-site-activation", "data/scripts/taichung_optional_story_bindings.inc", b"goto TaichungEncounter_BotanicalGarden\n", b"goto TaichungEncounter_LuceChapel\n"),
+        ("old-glyph-bitmap", GLYPHS, b"0x000", b"0x001"),
+        ("old-glyph-encoding", CHARMAP, b"= FC 19 01 01", b"= FC 19 02 01"),
+        ("save-version", "include/taichung_save.h", b"TAICHUNG_SAVE_VERSION 12", b"TAICHUNG_SAVE_VERSION 13"),
+        ("wrong-native-worker", "data/maps/TaichungPark_Gym/map.json", b"TaichungHistory_StaffPark", b"TaichungHistory_StaffMiyahara"),
+    ):
+        raw = read(path); changed = raw.replace(old, new, 1)
+        rejected(name, {path: changed})
+    for path in ("src/taichung_encounter.c", "src/taichung_encounter_bridge.c", "src/taichung_encounter_field.c",
+                 "include/taichung_encounter_bridge.h", "include/constants/taichung_encounters.h",
+                 "src/taichung_save.c", "src/taichung_team.c", "src/battle_main.c",
+                 "data/scripts/taichung_encounters.inc", "data/taichung/encounters/sites.json",
+                 "data/layouts/TaichungOldCity/map.bin", "data/taichung/minimap-contract.json",
+                 "tools/taichung/capture_release_guard.py"):
+        raw = read(path); changed = bytearray(raw); changed[len(changed) // 2] ^= 1
+        rejected("protected:" + path, {path: bytes(changed)})
+    require(all(probes.values()), "Story corruptions accepted: " + ", ".join(name for name, denied in probes.items() if not denied))
+    return dict(passed=True, current=good, rejectedCorruptionProbes=probes)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    parser.add_argument("--previous-guards", action="store_true")
+    args = parser.parse_args()
+    try:
+        report = previous_guards(args.source) if args.previous_guards else self_test(args.source) if args.self_test else check(args.source)
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        report = dict(passed=False, errors=[str(error)])
+    print(json.dumps(report, indent=2)); sys.exit(0 if report["passed"] else 1)
