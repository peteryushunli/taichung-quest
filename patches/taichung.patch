+ # door graphics. Non-gym signs are relocated only to explicit clear front cells.
+ for sc in byname.values():
+  for e in sc['data']['warp_events']:
+   pt=e['x'],e['y'];sc['overlays'].pop(pt,None);sc['grid'][pt[1]*sc['layout']['width']+pt[0]]=sc['old'][pt[1]*sc['layout']['width']+pt[0]]
+ fixed={mid:set() for mid in scenes};strip_checks=[]
