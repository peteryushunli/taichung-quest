+def install_capture_signs(world, fill):
+    events = fill["events"]["list"]
+    capture_signs = []
+    for name, (x, y), suffix in NEW_CAPTURE_SIGNS:
+        tile = [x, y]
+        read_from = [x, y + 1]
+        sign = next((event for event in events if event.get("place") == name and event["type"] == "sign"), None)
+        if sign is None:
+            require(name == "central-park" and world.at(x, y) == "o", f"No approved sign approach for {name}.")
+            sign = {"type": "sign", "place": name, "tile": tile, "readFrom": read_from}
+            events.append(sign)
+        else:
+            require(sign["tile"] == tile and sign["readFrom"] == read_from and world.at(x, y) == "n",
+                    f"The authored sign placement has changed for {name}.")
+        world.put((x, y, x + 1, y + 1), "n")
+        script = f"TaichungBoulevard_Sign_{suffix}"
+        sign.update(script=script, inLiveGame=True)
+        capture_signs.append({"id": name, "signTile": tile, "readFrom": read_from, "script": script})
+    return capture_signs
