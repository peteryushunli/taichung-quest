+    TaichungEncounter_ScriptOffer();
+    assert(!strstr((char *)gStringVar4, sChinese ? "三顆" : "ULTRA") && !sSaves);
+    Reset(); sSave = persisted; TaichungEncounterResetSession();
+    TaichungEncounter_ScriptOffer(); // Next normal save/Continue retains flag.
+    assert(!strstr((char *)gStringVar4, sChinese ? "三顆" : "ULTRA"));
+    Reset(); assert(TaichungEncounterBegin(1)); // Legacy attempted save, flag clear.
+    TaichungEncounterResetSession(); TaichungEncounter_ScriptOffer();
+    assert(!strstr((char *)gStringVar4, sChinese ? "三顆" : "ULTRA"));
+    Reset(); gQuestLogState = QL_STATE_PLAYBACK; TaichungEncounterOfferMenuShown();
+    assert(!(sSave.flags[FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN / 8] & (1 << (FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN % 8))));
+    Reset(); gSpecialVar_0x8007 = TAICHUNG_ENCOUNTER_COUNT; TaichungEncounterOfferMenuShown();
+    assert(!(sSave.flags[FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN / 8] & (1 << (FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN % 8))));
+    Reset(); TaichungEncounter_ScriptOffer(); // Fresh playthrough starts full.
+    assert(strstr((char *)gStringVar4, sChinese ? "三顆" : "3 ULTRA BALLS"));
+}
+
+int main(void)
+{
+    struct Pokemon original[PARTY_SIZE];
+    u8 outcome, textSite, site, failure;
+    for (sChinese = FALSE; sChinese <= TRUE; sChinese++)
+    {
+        TestRotatedFieldRoutes();
+        TestPlaceNames();
+        TestGlobalRules();
+        for (site = 0; site < TAICHUNG_ENCOUNTER_COUNT; site++)
+        {
+            if (!TaichungEncounterSiteAvailable(site)) continue;
+            Reset(); gSpecialVar_0x8007 = site;
+            TaichungEncounter_ScriptOpenTeam();
+            memset(&gPlayerParty[0], 0x3C, sizeof(gPlayerParty[0])); // Prepared team chosen by the player.
+            memcpy(original, gPlayerParty, sizeof(original));
+            sPreparedStart = TRUE; sMenuCallback(); sFadeFinished = TRUE; Frame();
+            assert(gSpecialVar_0x8007 == site && sLastScript == TaichungEncounter_Begin && !sPreparedStart);
+            TaichungEncounter_ScriptOffer();
+            assert(!gSpecialVar_Result && !TaichungEncounterGetAttemptMask() && !sSaves);
+            assert(!memcmp(original, gPlayerParty, sizeof(original)));
+        }
+        for (textSite = 0; textSite < 2; textSite++)
+        {
+            Reset(); gSpecialVar_0x8007 = textSite;
+            TaichungEncounter_ScriptOffer();
+            assert(strstr((char *)gStringVar4, "{STR_VAR_") == NULL);
+            assert(strstr((char *)gStringVar4, textSite ? "GYARADOS" : "LAPRAS"));
+            assert(strstr((char *)gStringVar4, textSite ? "70" : "65"));
+            StringExpandPlaceholders(gStringVar4, gStringVar4);
+        }
+        Reset(); memcpy(original, gPlayerParty, sizeof(original));
+        TaichungEncounter_ScriptOffer(); assert(!gSpecialVar_Result && !sSaves);
+        TaichungEncounter_ScriptOpenTeam(); assert(sTeams == 1 && !TaichungEncounterGetAttemptMask());
+        sMenuCallback(); Frame(); assert(!sReturns);
+        sFadeFinished = TRUE; Frame();
+        assert(sLastScript == TaichungEncounter_Leave && gSpecialVar_0x8007 == 0 && sReturns == 1);
+        TaichungEncounter_ScriptOffer(); assert(!gSpecialVar_Result && !sSaves && !TaichungEncounterGetAttemptMask());
+        sReturns = 0;
+        assert(memcmp(original, gPlayerParty, sizeof(original)) == 0);
+        sHealthy = FALSE; TaichungEncounter_ScriptBegin(); assert(!gSpecialVar_Result && !TaichungEncounterGetAttemptMask());
+        sHealthy = TRUE; gQuestLogState = QL_STATE_PLAYBACK;
+        TaichungEncounter_ScriptBegin(); assert(!gSpecialVar_Result && !TaichungEncounterGetAttemptMask());
+        gQuestLogState = 0;
+        TaichungEncounter_ScriptBegin(); assert(gSpecialVar_Result && TaichungEncounterGetAttemptMask() == 1 && !sSaves);
+        TaichungEncounter_ScriptSaveBegin(); Frame(); assert(!sSaves && !sBattles); Frame(); assert(sSaves == 1 && !sCreates && !sBattles && !sReturns);
+        Frame(); Frame(); assert(!sCreates && !sBattles && !sReturns);
+        Ack(); Frame(); assert(sCreates == 1 && sBattles == 1 && !sReturns);
+        assert(sEnemySpecies == SPECIES_LAPRAS && sEnemyLevel == 65);
+        assert(memcmp(sEnemyMoves, TaichungEncounterGetSite(0)->moves, sizeof(sEnemyMoves)) == 0);
+        assert(memcmp(original, gPlayerParty, sizeof(original)) == 0);
+        assert(TaichungEncounterTakeBall() && TaichungEncounterRecordCapture(SPECIES_LAPRAS));
+        gBattleOutcome = B_OUTCOME_CAUGHT; CB2_EndScriptedWildBattle();
+        assert(gMain.callback2 == TaichungEncounterReturnToField);
+        assert(sFlashUnlocks == 0 && TaichungEncounterGetUnlockMask() == 1);
+        gMain.callback2(); Frame(); Frame();
+        assert(sSaves == 2 && sMapRefreshes == 2 && sFlashUnlocks == 1 && !sReturns);
+        Frame(); assert(!sReturns); Ack(); Frame();
+        assert(TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_DONE && !sReturns);
+        Frame(); assert(!sReturns); // Early ACK must survive multiple fade frames.
+        sFadeFinished = TRUE; Frame();
+        assert(sReturns == 1 && sLastScript == TaichungEncounter_Result && gSpecialVar_0x8007 == 0);
+        TaichungEncounter_ScriptResult(); assert(gSpecialVar_Result && strstr((char *)gStringVar4, sChinese ? "捕捉" : "caught"));
+        assert(strstr((char *)gStringVar4, "{STR_VAR_") == NULL);
+        assert(strstr((char *)gStringVar4, "LAPRAS"));
+        StringExpandPlaceholders(gStringVar4, gStringVar4);
+        assert(memcmp(original, gPlayerParty, sizeof(original)) == 0 && !sHeals);
+        assert(sSave.vars[0xF8] == 1 && sSave.vars[0xFA] == 0x155 && sSave.vars[0xFB] == 2);
+        TaichungEncounter_ScriptAddCaught();
+        assert(!gSpecialVar_Result && sAddedSpecies == SPECIES_LAPRAS && sAddedSlot == 2);
+        sPartyCount = PARTY_SIZE;
+        TaichungEncounter_ScriptAddCaught();
+        assert(gSpecialVar_Result);
+        TaichungEncounter_ScriptChooseReplacement();
+        TaichungEncounter_ScriptConfirmReplacement();
+        assert(!gSpecialVar_Result && sAddedSlot == 2);
+        gSpecialVar_0x8004 = 4;
+        sReturns = 0; sMenuCallback(); Frame(); assert(!sReturns);
+        sFadeFinished = TRUE; Frame();
+        assert(sReturns == 1 && sLastScript == TaichungEncounter_ConfirmReplacement && gSpecialVar_0x8004 == 4 && gSpecialVar_0x8007 == 0);
+        TaichungEncounter_ScriptConfirmReplacement();
+        assert(gSpecialVar_Result && strstr((char *)gStringVar4, "PARTNER") && strstr((char *)gStringVar4, "LAPRAS"));
+        TaichungEncounter_ScriptReplaceWithCaught();
+        assert(sAddedSlot == 4 && sAddedSpecies == SPECIES_LAPRAS);
+        sPartyCount = 2;
+        TaichungEncounter_ScriptOffer(); assert(gSpecialVar_Result); // Used, no new offer.
+        TaichungEncounterResetSession(); TaichungEncounter_ScriptBegin(); assert(!gSpecialVar_Result);
+        for (outcome = 1; outcome <= 8; outcome++)
+        {
+            if (outcome == B_OUTCOME_CAUGHT) continue;
+            Reset(); TaichungEncounter_ScriptBegin(); TaichungEncounter_ScriptSaveBegin(); Frame(); Frame(); Ack(); Frame();
+            if (outcome == B_OUTCOME_NO_SAFARI_BALLS)
+                assert(TaichungEncounterTakeBall() && TaichungEncounterTakeBall() && TaichungEncounterTakeBall());
+            gBattleOutcome = outcome; CB2_EndScriptedWildBattle();
+            assert(gMain.callback2 == TaichungEncounterReturnToField);
+            assert(TaichungEncounterWasAttempted(0) && !TaichungEncounterGetUnlockMask());
+            assert(sHeals == (outcome == B_OUTCOME_LOST));
+            gMain.callback2(); Frame(); Frame();
+            sFadeFinished = TRUE; Frame(); assert(!sReturns); // Fade can finish before ACK too.
+            Ack(); Frame();
+            assert(sFlashAttempts == 1 && !sFlashUnlocks && sLastScript == TaichungEncounter_Result);
+            TaichungEncounter_ScriptResult(); assert(gStringVar4[0] && sReturns == 1);
+        }
+        Reset(); TaichungEncounter_ScriptBegin(); sSaveFail = TRUE; TaichungEncounter_ScriptSaveBegin(); Frame(); Frame(); Frame();
+        assert(!sBattles && !sCreates && sReturns == 1 && TaichungEncounterWasAttempted(0));
+        TaichungEncounter_ScriptResult(); assert(strstr((char *)gStringVar4, sChinese ? "儲存" : "Save"));
+        for (failure = 0; failure < 2; failure++)
+        {
+            Reset(); TaichungEncounter_ScriptBegin(); TaichungEncounter_ScriptSaveBegin(); Frame(); Frame(); Ack(); Frame();
+            assert(TaichungEncounterTakeBall() && TaichungEncounterRecordCapture(SPECIES_LAPRAS));
+            gBattleOutcome = B_OUTCOME_CAUGHT; CB2_EndScriptedWildBattle(); gMain.callback2();
+            sSaveFail = failure == 0; Frame(); Frame();
+            if (failure)
+            {
+                gTaichungEncounterBridge.ackSequence = TaichungEncounterGetSequence();
+                gTaichungEncounterBridge.ackStatus = TAICHUNG_ENCOUNTER_ACK_FAILED;
+            }
+            Frame(); assert(!sReturns);
+            sFadeFinished = TRUE; Frame();
+            assert(sReturns == 1 && sLastScript == TaichungEncounter_Result);
+            assert(TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_ERROR);
+            TaichungEncounter_ScriptResult(); assert(!gSpecialVar_Result);
+            assert(strstr((char *)gStringVar4, sChinese ? "儲存" : "Save"));
+            assert(TaichungEncounterWasAttempted(0));
+        }
+        // Ordinary scripted wild battles retain their existing return/blackout.
+        Reset(); gBattleOutcome = B_OUTCOME_LOST; CB2_EndScriptedWildBattle();
+        assert(gMain.callback2 == CB2_WhiteOut);
+        gBattleOutcome = B_OUTCOME_WON; CB2_EndScriptedWildBattle();
+        assert(gMain.callback2 == CB2_ReturnToFieldContinueScriptPlayMapMusic);
+    }
+    puts("PASS: actual field adapter C in both locales; explicit Prepare returns directly to Begin after commit or safely leaves after cancel, without spending early; replacement selection survives field reset; battle starts only after exact ACK; outcome saves during fade and immediate result waits for ACK plus fade (either order); party preserved; all consumed outcomes retain spent state");
+    return 0;
+}
diff --git a/tests/taichung_encounter_save_test.c b/tests/taichung_encounter_save_test.c
new file mode 100644
index 00000000..c7af07c7
--- /dev/null
+++ b/tests/taichung_encounter_save_test.c
@@ -0,0 +1,335 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "constants/flags.h"
+#include "taichung_save.h"
+#include "taichung_encounter.h"
+#include "constants/battle.h"
+#include "constants/maps.h"
+#include "constants/species.h"
+
+void BaselineTaichungSaveInitNewGame(void);
+void BaselineTaichungSaveUpgradeOnContinue(void);
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+// A separate protected block stands for name/OT and other SaveBlock2 bytes.
+// Neither real implementation references it; no native offsets are claimed.
+static u8 sProtectedSaveBlock2[0xF24];
+static bool32 sPending;
+static unsigned sWrites, sEncounterWrites, sWarpRequests, sCancels, sCases;
+static unsigned sFailAt, sIgnoreAt;
+static u16 sEncounterWriteOrder[4];
+#define V(id) sSave.vars[(id) - VARS_START]
+
+bool8 VarSet(u16 id, u16 value)
+{
+    if ((id >= TAICHUNG_ENCOUNTER_SCHEMA_VAR && id <= TAICHUNG_ENCOUNTER_UNLOCK_VAR)
+        || id == TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR
+        || id == TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR
+        || id == TAICHUNG_ENCOUNTER_EXTRA_VAR)
+    {
+        assert(sEncounterWrites < 4);
+        sEncounterWriteOrder[sEncounterWrites++] = id;
+        if (sEncounterWrites == sFailAt) return FALSE;
+        if (sEncounterWrites == sIgnoreAt) return TRUE;
+    }
+    else
+        assert(id == TAICHUNG_SAVE_VERSION_VAR || id == 0x40FB || id == 0x40FC);
+    sWrites++;
+    V(id) = value;
+    return TRUE;
+}
+bool32 UseContinueGameWarp(void) { return sPending; }
+void SetContinueGameWarpStatus(void) { sPending = TRUE; sWarpRequests++; }
+void TaichungGymCancelChallenge(void) { sCancels++; }
+
+static void ClearCalls(void)
+{
+    sWrites = sEncounterWrites = sWarpRequests = sCancels = sFailAt = sIgnoreAt = 0;
+    memset(sEncounterWriteOrder, 0, sizeof(sEncounterWriteOrder));
+}
+
+static void Fixture(u16 version, u16 schema, u16 attempts, u16 unlocks, bool8 party)
+{
+    unsigned i;
+    memset(&sSave, 0xA5, sizeof(sSave));
+    memset(sProtectedSaveBlock2, 0x73, sizeof(sProtectedSaveBlock2));
+    for (i = 0; i < 256; i++) sSave.vars[i] = i ^ 0x5A5A;
+    V(TAICHUNG_SAVE_VERSION_VAR) = version;
+    V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) = schema;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) = attempts;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) = unlocks;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) = schema == 0 ? 0 : 0x9555;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) = schema == 0 ? 0 : 0x0555;
+    V(TAICHUNG_ENCOUNTER_EXTRA_VAR) = schema == TAICHUNG_ENCOUNTER_SCHEMA ? 0 : 0xA5EF;
+    V(0x40FB) = 2;
+    V(0x40FC) = SPECIES_PIKACHU;
+    V(0x40FD) = 1;
+    sSave.playerPartyCount = party ? 6 : 0;
+    sSave.location = (struct WarpData){43, MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM), -1, 6, 10};
+    sSave.pos = (struct Coords16){6, 10};
+    sSave.continueGameWarp = (struct WarpData){43, MAP_NUM(MAP_TAICHUNG_GREENWAY), -1, 22, 62};
+    sSave.lastHealLocation = (struct WarpData){43, MAP_NUM(MAP_TAICHUNG_OLD_CITY), -1, 30, 66};
+    sPending = FALSE;
+    ClearCalls();
+}
+
+static bool8 Authenticated(void)
+{
+    u16 version = V(TAICHUNG_SAVE_VERSION_VAR), starter = V(0x40FC);
+    bool8 startup = sSave.location.mapGroup == 43
+        && (sSave.location.mapNum == 13 || sSave.location.mapNum == 19 || sSave.location.mapNum == 20);
+    if (version > TAICHUNG_SAVE_VERSION || (!sSave.playerPartyCount && !(version != 0 && startup))) return FALSE;
+    if (version != 0) return TRUE;
+    return starter == SPECIES_BULBASAUR || starter == SPECIES_CHARMANDER
+        || starter == SPECIES_SQUIRTLE || starter == SPECIES_PIKACHU
+        || (starter == 0 && V(0x40FD) != 0);
+}
+
+static void DirtySession(u8 phase)
+{
+    struct SaveBlock1 before = sSave;
+    const struct TaichungEncounterSite *site = TaichungEncounterGetSite(0);
+    TaichungEncounterResetSession();
+    V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) = TAICHUNG_ENCOUNTER_SCHEMA;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) = V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) = 0;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) = V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) = 0;
+    V(TAICHUNG_ENCOUNTER_EXTRA_VAR) = 0;
+    ClearCalls();
+    assert(TaichungEncounterBegin(0));
+    if (phase >= TAICHUNG_ENCOUNTER_PHASE_ARMED && phase != TAICHUNG_ENCOUNTER_PHASE_ERROR)
+        assert(TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), 0));
+    if (phase >= TAICHUNG_ENCOUNTER_PHASE_BATTLE && phase != TAICHUNG_ENCOUNTER_PHASE_ERROR)
+        assert(TaichungEncounterOnBattleStart(site->species, site->level));
+    if (phase >= TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT && phase != TAICHUNG_ENCOUNTER_PHASE_ERROR)
+        assert(TaichungEncounterOnBattleEnd(site->species, B_OUTCOME_RAN));
+    if (phase == TAICHUNG_ENCOUNTER_PHASE_DONE)
+        assert(TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), 0));
+    if (phase == TAICHUNG_ENCOUNTER_PHASE_ERROR) TaichungEncounterStorageFailed();
+    assert(TaichungEncounterGetPhase() == phase);
+    sSave = before;
+    ClearCalls();
+}
+
+static void CompareBaseline(bool8 fresh, u8 phase, unsigned fail, unsigned ignore)
+{
+    struct SaveBlock1 input = sSave, expected;
+    bool32 pending = sPending, expectedPending;
+    unsigned expectedWrites, expectedWarps, expectedCancels, i;
+    u32 sequence;
+    bool8 virgin = V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) == 0
+        && V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) == 0 && V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) == 0
+        && V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) == 0 && V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) == 0;
+    bool8 legacy = V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) == TAICHUNG_ENCOUNTER_SCHEMA_V1
+        || V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) == TAICHUNG_ENCOUNTER_SCHEMA_V2;
+    // Independent EC03 contract: historical EC02 preserves only IDs0..23.
+    u16 upperMask = V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) == 0xEC02 ? 0x3FFF : 0;
+    bool8 initialize = (virgin || legacy) && (fresh || Authenticated());
+    if (fresh) BaselineTaichungSaveInitNewGame(); else BaselineTaichungSaveUpgradeOnContinue();
+    expected = sSave;
+    if (fresh) expected.flags[FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN / 8] &= ~(1 << (FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN % 8));
+    expectedPending = sPending; expectedWrites = sWrites;
+    expectedWarps = sWarpRequests; expectedCancels = sCancels;
+    sSave = input; sPending = pending;
+    DirtySession(phase);
+    sequence = TaichungEncounterGetSequence();
+    sFailAt = fail; sIgnoreAt = ignore;
+    if (fresh) TaichungSaveInitNewGame(); else TaichungSaveUpgradeOnContinue();
+    assert(sPending == expectedPending && sWarpRequests == expectedWarps && sCancels == expectedCancels);
+    assert(TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_IDLE);
+    assert(TaichungEncounterGetCurrentSite() == TAICHUNG_ENCOUNTER_NONE);
+    assert(TaichungEncounterGetBalls() == 0 && TaichungEncounterGetResult() == TAICHUNG_ENCOUNTER_RESULT_NONE);
+    assert(TaichungEncounterGetSequence() == sequence);
+    if (initialize)
+    {
+        unsigned attemptedWrites = fail ? fail : 4;
+        assert(sEncounterWrites == attemptedWrites);
+        assert(sEncounterWriteOrder[0] == TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR);
+        if (attemptedWrites >= 2) assert(sEncounterWriteOrder[1] == TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR);
+        if (attemptedWrites >= 3) assert(sEncounterWriteOrder[2] == TAICHUNG_ENCOUNTER_EXTRA_VAR);
+        if (attemptedWrites >= 4) assert(sEncounterWriteOrder[3] == TAICHUNG_ENCOUNTER_SCHEMA_VAR);
+        if (fail != 1 && ignore != 1) expected.vars[TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR - VARS_START] &= upperMask;
+        if ((!fail || fail > 2) && ignore != 2) expected.vars[TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR - VARS_START] &= upperMask;
+        if ((!fail || fail > 3) && ignore != 3) expected.vars[TAICHUNG_ENCOUNTER_EXTRA_VAR - VARS_START] = 0;
+        if (!fail && ignore != 4) expected.vars[TAICHUNG_ENCOUNTER_SCHEMA_VAR - VARS_START] = 0xEC03;
+        assert(sWrites == expectedWrites + attemptedWrites - !!fail - !!ignore);
+    }
+    else assert(sEncounterWrites == 0 && sWrites == expectedWrites);
+    // Entire modeled native save, including all256 vars, raw party/bag bytes,
+    // every object, padding and all pending/checkpoint/location fields.
+    assert(!memcmp(&sSave, &expected, sizeof(sSave)));
+    for (i = 0; i < sizeof(sProtectedSaveBlock2); i++) assert(sProtectedSaveBlock2[i] == 0x73);
+    sCases++;
+}
+
+int main(void)
+{
+    static const u16 states[][3] = {
+        {0, 0, 0}, {TAICHUNG_ENCOUNTER_SCHEMA, 0, 0}, {TAICHUNG_ENCOUNTER_SCHEMA, 0xC001, 0x8001},
+        {TAICHUNG_ENCOUNTER_SCHEMA, 0xFFFF, 0xFFFF}, {0, 1, 0}, {0, 0, 0x8000},
+        {1, 0, 0}, {TAICHUNG_ENCOUNTER_SCHEMA_V1, 0xA203, 0x8201}, {0xFFFF, 0xFFFF, 0xFFFF},
+        {0xEC02, 0, 0}, {0xEC02, 0xC001, 0x8001}, {0xEC02, 0xFFFF, 0xFFFF}
+    };
+    static const u16 starters[] = {0, SPECIES_BULBASAUR, SPECIES_CHARMANDER, SPECIES_SQUIRTLE, SPECIES_PIKACHU, 0xFFFF};
+    static const u16 futures[] = {TAICHUNG_SAVE_VERSION + 1, 0xEC01, 0xFFFF};
+    unsigned version, state, party, pending, starter, tea, phase, mask, failure;
+    for (version = 0; version <= TAICHUNG_SAVE_VERSION; version++)
+        for (state = 0; state < sizeof(states) / sizeof(states[0]); state++)
+            for (party = 0; party < 2; party++) for (pending = 0; pending < 2; pending++)
+            {
+                Fixture(version, states[state][0], states[state][1], states[state][2], party);
+                sPending = pending;
+                CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, 0);
+                ClearCalls();
+                CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ERROR, 0, 0); // Repeated Continue.
+            }
+    for (starter = 0; starter < sizeof(starters) / sizeof(starters[0]); starter++) for (tea = 0; tea < 2; tea++)
+    {
+        Fixture(0, 0, 0, 0, TRUE); V(0x40FC) = starters[starter]; V(0x40FD) = tea;
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ARMED, 0, 0);
+    }
+    for (version = 0; version < sizeof(futures) / sizeof(futures[0]); version++)
+        for (state = 0; state < sizeof(states) / sizeof(states[0]); state++)
+    {
+        Fixture(futures[version], states[state][0], states[state][1], states[state][2], TRUE);
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_BATTLE, 0, 0);
+    }
+    for (state = 0; state < sizeof(states) / sizeof(states[0]); state++)
+    {
+        Fixture(0, states[state][0], states[state][1], states[state][2], FALSE);
+        CompareBaseline(TRUE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0);
+    }
+    Fixture(0, 0, 0, 0, FALSE);
+    memset(&sSave, 0, sizeof(sSave)); // The engine's actual cleared-new-save precondition.
+    CompareBaseline(TRUE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, 0);
+    // Every raw16-bit mask, including high bits and inconsistent unlock masks,
+    // remains authoritative: initialization is not mask repair or sanitization.
+    for (mask = 0; mask <= 0xFFFF; mask++)
+    {
+        Fixture(TAICHUNG_SAVE_VERSION, TAICHUNG_ENCOUNTER_SCHEMA, mask, mask ^ 0xA55A, TRUE);
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_DONE, 0, 0);
+    }
+    for (version = 0; version <= TAICHUNG_SAVE_VERSION; version++) for (failure = 1; failure <= 4; failure++)
+    {
+        Fixture(version, 0, 0, 0, TRUE);
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, failure, 0);
+        ClearCalls();
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0); // Retry after migration early exit.
+        Fixture(version, 0, 0, 0, TRUE);
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, failure);
+        ClearCalls();
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0);
+    }
+    for (phase = TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN; phase <= TAICHUNG_ENCOUNTER_PHASE_ERROR; phase++)
+    {
+        Fixture(TAICHUNG_SAVE_VERSION, TAICHUNG_ENCOUNTER_SCHEMA, 0, 0, TRUE);
+        CompareBaseline(FALSE, phase, 0, 0);
+        Fixture(0, 0, 0, 0, FALSE); V(0x40FC) = V(0x40FD) = 0;
+        CompareBaseline(FALSE, phase, 0, 0);
+        Fixture(0, 0, 0, 0, FALSE);
+        CompareBaseline(TRUE, phase, 0, 0);
+    }
+    // Authenticated unfinished startup has no partner yet. Initialization must
+    // happen on this first entry, without migrating its location/version or
+    // requiring a later Continue after the partner is granted. Numeric IDs are
+    // independent expectations for the released21-context registry.
+    {
+        static const s8 contexts[][2] = {{43, 13}, {43, 19}, {43, 20}, {43, 3}, {43, 0}, {0, 20}, {43, 127}};
+        unsigned map;
+        for (version = 0; version <= TAICHUNG_SAVE_VERSION; version++)
+            for (map = 0; map < sizeof(contexts) / sizeof(contexts[0]); map++)
+                for (state = 0; state < sizeof(states) / sizeof(states[0]); state++)
+                    for (pending = 0; pending < 2; pending++)
+                    {
+                        Fixture(version, states[state][0], states[state][1], states[state][2], FALSE);
+                        sSave.location.mapGroup = contexts[map][0]; sSave.location.mapNum = contexts[map][1];
+                        sPending = pending;
+                        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, 0);
+                        ClearCalls();
+                        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ERROR, 0, 0);
+                    }
+        for (version = 0; version < sizeof(futures) / sizeof(futures[0]); version++)
+            for (map = 0; map < 3; map++) for (state = 0; state < sizeof(states) / sizeof(states[0]); state++)
+            {
+                Fixture(futures[version], states[state][0], states[state][1], states[state][2], FALSE);
+                sSave.location.mapNum = contexts[map][1];
+                CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ARMED, 0, 0);
+            }
+        for (version = 1; version <= TAICHUNG_SAVE_VERSION; version++)
+            for (map = 0; map < 3; map++) for (failure = 1; failure <= 4; failure++)
+            {
+                Fixture(version, 0, 0, 0, FALSE); sSave.location.mapNum = contexts[map][1];
+                CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, failure, 0);
+                ClearCalls(); CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0);
+                Fixture(version, 0, 0, 0, FALSE); sSave.location.mapNum = contexts[map][1];
+                CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, failure);
+                ClearCalls(); CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0);
+            }
+        Fixture(0, 0, 0, 0, FALSE);
+        memset(&sSave, 0, sizeof(sSave));
+        TaichungSaveInitNewGame(); // Before any partner/Continue.
+        assert(sSave.playerPartyCount == 0 && TaichungEncounterStateReady());
+        assert(V(TAICHUNG_SAVE_VERSION_VAR) == 12 && sEncounterWrites == 4);
+    }
+    for (failure = 1; failure <= 4; failure++)
+    {
+        Fixture(0, 0, 0, 0, FALSE);
+        CompareBaseline(TRUE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, failure, 0);
+        ClearCalls(); sSave.playerPartyCount = 1; // Starter arrives after new-game entry.
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0);
+        Fixture(0, 0, 0, 0, FALSE);
+        CompareBaseline(TRUE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, failure);
+        ClearCalls(); sSave.playerPartyCount = 1;
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT, 0, 0);
+    }
+    // Independent EC03 field contract, including every historically ignored
+    // upper-word and unallocated EF value. The whole modeled save still equals
+    // the immutable baseline plus only the four specified migration fields.
+    for (mask = 0; mask <= 0xFFFF; mask++)
+    {
+        Fixture(12, 0xEC02, mask, mask ^ 0xA55A, TRUE);
+        V(0x40F0) = mask; V(0x40F2) = mask ^ 0xA55A;
+        V(0x40EF) = mask ^ 0xCAFE;
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_DONE, 0, 0);
+        assert(V(0x40F0) == (mask & 0x3FFF));
+        assert(V(0x40F2) == ((mask ^ 0xA55A) & 0x3FFF));
+        assert(V(0x40F4) == mask && V(0x40F5) == (mask ^ 0xA55A));
+        assert(V(0x40EF) == 0 && V(0x40F3) == 0xEC03);
+        assert(!(TaichungEncounterGetAttemptMask() & 0x07000000));
+        assert(!(TaichungEncounterGetUnlockMask() & 0x07000000));
+        ClearCalls(); CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ERROR, 0, 0);
+        assert(sEncounterWrites == 0);
+    }
+    // Current valid EC03 is idempotent even with arbitrary raw low reserved
+    // bits; every reserved EF bit fails closed without rewriting any byte.
+    for (mask = 0; mask <= 0xFFFF; mask++)
+    {
+        Fixture(12, 0xEC03, 0xFC01, 0xA001, TRUE); V(0x40EF) = mask;
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_DONE, 0, 0);
+        assert(V(0x40EF) == mask && sEncounterWrites == 0);
+        if (mask & 0xFEFE)
+        {
+            assert(!TaichungEncounterStateReady());
+            assert(TaichungEncounterGetAttemptMask() == 0 && TaichungEncounterGetUnlockMask() == 0);
+            assert(!TaichungEncounterBegin(24) && !TaichungEncounterBegin(25) && !TaichungEncounterBegin(26));
+        }
+        else assert(TaichungEncounterStateReady());
+    }
+    // Every prior schema migration and all four physical writes: false returns
+    // stop before the stamp; true no-op writes remain precisely modeled. Retry
+    // must never modify unrelated save bytes, party, or raw low reserved bits.
+    for (state = 0; state < 3; state++) for (failure = 1; failure <= 4; failure++)
+    {
+        u16 schema = state == 0 ? 0 : state == 1 ? 0xEC01 : 0xEC02;
+        Fixture(12, schema, schema ? 0xF803 : 0, schema ? 0xA001 : 0, TRUE);
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, failure, 0);
+        assert(V(0x40F3) == schema);
+        ClearCalls(); CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ERROR, 0, 0);
+        Fixture(12, schema, schema ? 0xF803 : 0, schema ? 0xA001 : 0, TRUE);
+        CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN, 0, failure);
+        ClearCalls(); CompareBaseline(FALSE, TAICHUNG_ENCOUNTER_PHASE_ERROR, 0, 0);
+    }
+    printf("PASS: %u actual-C encounter/save cases vs immutable baseline, with legacy migration, protected save bytes, every low word, and initialization retry\n", sCases);
+    return 0;
+}
diff --git a/tests/taichung_encounter_team_test.c b/tests/taichung_encounter_team_test.c
new file mode 100644
index 00000000..543f7552
--- /dev/null
+++ b/tests/taichung_encounter_team_test.c
@@ -0,0 +1,149 @@
+// Reuse modeled mon/stat services, but link the real encounter state and team C
+// together so saved unlocks, all current site levels, and refresh are exercised.
+#define main ExistingTeamTestMain
+#define TaichungEncounterSiteForSpecies LegacySiteForSpecies
+#define TaichungEncounterGetSite LegacyGetSite
+#define TaichungEncounterGetUnlockMask LegacyGetUnlockMask
+#define TaichungEncounterSpeciesSelectable LegacySpeciesSelectable
+#include "taichung_team_test.c"
+#undef main
+#undef TaichungEncounterSiteForSpecies
+#undef TaichungEncounterGetSite
+#undef TaichungEncounterGetUnlockMask
+#undef TaichungEncounterSpeciesSelectable
+#include "constants/battle.h"
+u8 TaichungEncounterSiteForSpecies(u16 species);
+const struct TaichungEncounterSite *TaichungEncounterGetSite(u16 site);
+u32 TaichungEncounterGetUnlockMask(void);
+bool8 TaichungEncounterSpeciesSelectable(u16 species);
+#include "taichung_gym_progress.h"
+#include "constants/opponents.h"
+u16 gSpecialVar_0x8004, gSpecialVar_0x8005, gSpecialVar_Result;
+#include "native-gym-prepare.inc"
+u16 VarGet(u16 id) { (void)id; assert(0); return 0; }
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_ENCOUNTER_ATTEMPT_VAR || id == TAICHUNG_ENCOUNTER_UNLOCK_VAR
+        || id == TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR || id == TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR
+        || id == TAICHUNG_ENCOUNTER_SCHEMA_VAR || id == TAICHUNG_GYM_COMPLETION_VAR
+        || id == TAICHUNG_ENCOUNTER_EXTRA_VAR);
+    sSave.vars[id - VARS_START] = value; return TRUE;
+}
+static void NewSave(void)
+{
+    Reset(); memset(sSave.vars, 0, sizeof(sSave.vars));
+    TaichungGymCancelChallenge();
+    TaichungEncounterResetSession(); assert(TaichungEncounterInitSaveState());
+}
+static void Battle(u8 id, u8 outcome)
+{
+    const struct TaichungEncounterSite *site = TaichungEncounterGetSite(id);
+    assert(TaichungEncounterBegin(id));
+    assert(TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), TaichungEncounterGetUnlockMask()));
+    assert(TaichungEncounterOnBattleStart(site->species, site->level));
+    if (outcome == B_OUTCOME_CAUGHT)
+        assert(TaichungEncounterTakeBall() && TaichungEncounterRecordCapture(site->species));
+    assert(TaichungEncounterOnBattleEnd(site->species, outcome));
+    assert(TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), TaichungEncounterGetUnlockMask()));
+}
+static void TestExistingNewRarePartners(void)
+{
+    const u16 species[] = {SPECIES_MAGNETON, SPECIES_KABUTOPS, SPECIES_PERSIAN,
+        SPECIES_LAPRAS, SPECIES_NINETALES, SPECIES_VICTREEBEL,
+        SPECIES_CHARIZARD, SPECIES_BLASTOISE, SPECIES_VENUSAUR};
+    const u8 levels[] = {5, 50, 80};
+    struct Pokemon before[PARTY_SIZE];
+    struct SaveBlock1 saved;
+    u8 phase, level, member, pass, slot;
+    for (member = 0; member < sizeof(species) / sizeof(species[0]); member++)
+        for (phase = 0; phase < 3; phase++)
+            for (level = 0; level < 3; level++)
+            {
+                u8 site = TaichungEncounterSiteForSpecies(species[member]);
+                NewSave();
+                gPlayerParty[0] = OldPartner(species[member], levels[level]);
+                gPlayerParty[0].hp = 0; gPlayerParty[0].status = 8;
+                gPlayerParty[0].pp[0] = 1; gPlayerParty[0].pp[1] = 0;
+                gPlayerParty[0].pp[2] = 3; gPlayerParty[0].pp[3] = 4;
+                gPlayerParty[0].ppBonuses = 0x55;
+                gPlayerParty[1] = OldPartner(SPECIES_PIKACHU, 50);
+                gPlayerParty[2] = OldPartner(SPECIES_SCYTHER, 50);
+                for (slot = 1; slot < 3; slot++)
+                    memcpy(gPlayerParty[slot].moves, TaichungTeamGetPresetMoves(gPlayerParty[slot].species), sizeof(gPlayerParty[slot].moves));
+                CalculatePlayerPartyCount();
+                if (phase)
+                {
+                    u16 var = site < 10 ? TAICHUNG_ENCOUNTER_ATTEMPT_VAR : site < 26 ? TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR : TAICHUNG_ENCOUNTER_EXTRA_VAR;
+                    sSave.vars[var - VARS_START] |= site < 10 ? 1u << site : site < 26 ? 1u << (site - 10) : 1;
+                }
+                if (phase == 2)
+                {
+                    u16 var = site < 10 ? TAICHUNG_ENCOUNTER_UNLOCK_VAR : site < 26 ? TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR : TAICHUNG_ENCOUNTER_EXTRA_VAR;
+                    sSave.vars[var - VARS_START] |= site < 10 ? 1u << site : site < 26 ? 1u << (site - 10) : 0x100;
+                }
+                memcpy(before, gPlayerParty, sizeof(before)); saved = sSave;
+                for (pass = 0; pass < 2; pass++)
+                {
+                    TaichungEncounterResetSession(); assert(TaichungEncounterInitSaveState());
+                    gSpecialVar_0x8004 = TAICHUNG_GYM_CONFUCIUS_TEMPLE;
+                    gSpecialVar_0x8005 = TRAINER_TAICHUNG_CONFUCIUS_WENYI;
+                    TaichungGym_ScriptPrepareChallenge(); assert(gSpecialVar_Result);
+                    TaichungTeamEnsurePartyLevel(); TaichungTeamSyncPresetMoves();
+                    assert(!memcmp(before, gPlayerParty, sizeof(before)));
+                    assert(!memcmp(&saved, &sSave, sizeof(saved)));
+                    assert(CalculatePlayerPartyCount() == 3 && gPlayerParty[0].hp == 0 && gPlayerParty[1].hp);
+                    assert(TaichungEncounterSpeciesSelectable(species[member]) == (!TaichungEncounterSiteAvailable(site) || phase == 2));
+                }
+                assert(!TaichungTeamSetSlot(3, species[member]));
+                assert(TaichungTeamSetSlot(0, species[member]));
+                assert(!memcmp(before, gPlayerParty, sizeof(before)));
+            }
+    puts("PASS:9 existing rotated/new-lock species atLv5/50/80 retain entire party records through repeated Continue/gym maintenance in available/spent/caught states; firstfainted/otherhealthy remains usable, no heal/PP/moves/identity/level changes or clone.");
+}
+
+int main(void)
+{
+    u8 id, count = 0;
+    TestExistingNewRarePartners();
+    for (id = 0; id < TAICHUNG_ENCOUNTER_COUNT; id++)
+    {
+        struct SaveBlock1 durable;
+        struct Pokemon partner, party[PARTY_SIZE];
+        const struct TaichungEncounterSite *site = TaichungEncounterGetSite(id);
+        if (!TaichungEncounterSiteAvailable(id)) continue;
+        NewSave();
+        partner = OldPartner(site->species, 50);
+        memcpy(partner.moves, TaichungTeamGetPresetMoves(site->species), sizeof(partner.moves));
+        partner.pp[0] = 1; partner.pp[1] = partner.pp[2] = partner.pp[3] = 0;
+        gPlayerParty[0] = partner;
+        assert(!TaichungEncounterSpeciesSelectable(site->species));
+        TaichungTeamEnsurePartyLevel();
+        assert(!memcmp(&partner, &gPlayerParty[0], sizeof(partner))); // Existing locked species remains usable.
+        Battle(id, B_OUTCOME_CAUGHT); durable = sSave;
+        assert(TaichungEncounterSpeciesSelectable(site->species));
+        assert(!TaichungTeamSetSlot(1, site->species)); // Capture cannot clone an existing legacy partner.
+        TaichungTeamEnsurePartyLevel();
+        assert(gPlayerParty[0].level == (id == 0 || id >= 21 ? partner.level : site->level) && gPlayerParty[0].hp == partner.hp);
+        assert(gPlayerParty[0].status == partner.status && !memcmp(gPlayerParty[0].pp, partner.pp, 4));
+        assert(!memcmp(&gPlayerParty[0].identity, &partner.identity, sizeof(partner.identity)));
+        assert(TaichungTeamSetSlot(0, SPECIES_RATICATE));
+        assert(TaichungTeamSetSlot(1, site->species)); // Explicitly freed species is now a fresh caught choice.
+        assert(gPlayerParty[1].level == site->level);
+        assert(gPlayerParty[1].exp == gExperienceTables[gSpeciesInfo[site->species].growthRate][site->level]);
+        memcpy(party, gPlayerParty, sizeof(party));
+        // Native Continue/refresh restores saved masks and levels, no attempt reset.
+        TaichungEncounterResetSession(); sSave = durable;
+        assert(TaichungEncounterInitSaveState() && !TaichungEncounterBegin(id));
+        TaichungTeamEnsurePartyLevel(); assert(!memcmp(party, gPlayerParty, sizeof(party)));
+        assert(!TaichungTeamSetSlot(0, site->species));
+        assert(TaichungTeamSetSlot(1, SPECIES_PIKACHU));
+        assert(TaichungTeamSetSlot(0, site->species) && gPlayerParty[0].level == site->level);
+        NewSave(); Battle(id, B_OUTCOME_WON); durable = sSave;
+        assert(TaichungEncounterWasAttempted(id) && !TaichungEncounterGetUnlockMask());
+        TaichungEncounterResetSession(); sSave = durable; assert(TaichungEncounterInitSaveState());
+        assert(TaichungEncounterWasAttempted(id) && !TaichungEncounterSpeciesSelectable(site->species) && !TaichungEncounterBegin(id));
+        count++;
+    }
+    printf("PASS: %u active sites with real encounter/team C; caught append/replace/normalization keep captured levels and identity; old locked party remains usable; catch/KO saved masks survive transient reset without another attempt\n", count);
+    return 0;
+}
diff --git a/tests/taichung_encounter_test.c b/tests/taichung_encounter_test.c
new file mode 100644
index 00000000..1c02633e
--- /dev/null
+++ b/tests/taichung_encounter_test.c
@@ -0,0 +1,272 @@
+#include "global.h"
+#include "event_data.h"
+#include "taichung_encounter.h"
+#include "constants/battle.h"
+#include "constants/species.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWrites;
+static bool8 sFailWrite, sIgnoreWrite;
+#define V(id) sSave.vars[(id) - 0x4000]
+
+static bool8 IsEncounterVar(u16 var)
+{
+    return (var >= TAICHUNG_ENCOUNTER_SCHEMA_VAR && var <= TAICHUNG_ENCOUNTER_UNLOCK_VAR)
+        || var == TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR || var == TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR
+        || var == TAICHUNG_ENCOUNTER_EXTRA_VAR;
+}
+
+u16 VarGet(u16 var) { (void)var; assert(0 && "No quest-log or caught-flag reads"); return 0; }
+bool8 VarSet(u16 var, u16 value)
+{
+    assert(IsEncounterVar(var));
+    sWrites++;
+    if (sFailWrite) return FALSE;
+    if (!sIgnoreWrite) sSave.vars[var - 0x4000] = value;
+    return TRUE;
+}
+static void Fixture(u32 attempts, u32 unlocks)
+{
+    unsigned i;
+    for (i = 0; i < 256; i++) sSave.vars[i] = i ^ 0x735A;
+    V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) = TAICHUNG_ENCOUNTER_SCHEMA;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) = (attempts & TAICHUNG_ENCOUNTER_SAVE_LOW_MASK) | 0xC000;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) = (unlocks & TAICHUNG_ENCOUNTER_SAVE_LOW_MASK) | 0x8000;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) = attempts >> TAICHUNG_ENCOUNTER_SAVE_LOW_BITS;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) = unlocks >> TAICHUNG_ENCOUNTER_SAVE_LOW_BITS;
+    V(TAICHUNG_ENCOUNTER_EXTRA_VAR) = ((attempts & (1u << 26)) ? TAICHUNG_ENCOUNTER_EXTRA_ATTEMPT_BIT : 0)
+        | ((unlocks & (1u << 26)) ? TAICHUNG_ENCOUNTER_EXTRA_UNLOCK_BIT : 0);
+    TaichungEncounterResetSession();
+    sWrites = 0;
+    sFailWrite = sIgnoreWrite = FALSE;
+}
+static void Protected(void)
+{
+    unsigned i;
+    for (i = 0; i < 256; i++)
+        if (!IsEncounterVar(i + 0x4000))
+            assert(sSave.vars[i] == (i ^ 0x735A));
+}
+static void Arm(u8 site)
+{
+    const struct TaichungEncounterSite *s = TaichungEncounterGetSite(site);
+    assert(TaichungEncounterBegin(site));
+    assert(!TaichungEncounterIsActive());
+    assert(!TaichungEncounterOnBattleStart(s->species, s->level));
+    assert(!TaichungEncounterAcknowledge(TaichungEncounterGetSequence() - 1, TaichungEncounterGetAttemptMask(), 0));
+    assert(!TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask() ^ (1u << 20), 0));
+    assert(TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), TaichungEncounterGetUnlockMask()));
+    assert(!TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), TaichungEncounterGetUnlockMask()));
+    assert(!TaichungEncounterOnBattleStart(SPECIES_MEW, s->level));
+    assert(!TaichungEncounterOnBattleStart(s->species, 50));
+    assert(TaichungEncounterOnBattleStart(s->species, s->level));
+}
+static void TestEc03Migration(void)
+{
+    const u8 oldSites[] = {0, 13, 18, 22};
+    const u16 noise[] = {0, 1, 0x100, 0x101, 0xFFFF, 0xFEFE};
+    u16 before[256];
+    unsigned site, phase, junk, i, writes;
+    for (site = 0; site < 4; site++)
+        for (phase = 0; phase < 3; phase++)
+            for (junk = 0; junk < sizeof(noise) / sizeof(noise[0]); junk++)
+            {
+                u32 attempts = (1u << 6) | (phase ? 1u << oldSites[site] : 0);
+                u32 caught = (1u << 6) | (phase == 2 ? 1u << oldSites[site] : 0);
+                Fixture(attempts, caught);
+                V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) = TAICHUNG_ENCOUNTER_SCHEMA_V2;
+                V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) |= 0xC000;
+                V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) |= 0xC000;
+                V(TAICHUNG_ENCOUNTER_EXTRA_VAR) = noise[junk];
+                memcpy(before, sSave.vars, sizeof(before));
+                assert(TaichungEncounterInitSaveState());
+                assert(TaichungEncounterGetAttemptMask() == attempts && TaichungEncounterGetUnlockMask() == caught);
+                assert(V(TAICHUNG_ENCOUNTER_EXTRA_VAR) == 0);
+                assert(!(V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) & 0xC000));
+                assert(!(V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) & 0xC000));
+                for (i = 0; i < 256; i++)
+                    if (i + 0x4000 != TAICHUNG_ENCOUNTER_SCHEMA_VAR && i + 0x4000 != TAICHUNG_ENCOUNTER_EXTRA_VAR
+                        && i + 0x4000 != TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR && i + 0x4000 != TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR)
+                        assert(sSave.vars[i] == before[i]);
+                for (i = 24; i < 27; i++)
+                    assert(!TaichungEncounterWasAttempted(i) && !TaichungEncounterSpeciesSelectable(TaichungEncounterGetSite(i)->species));
+                writes = sWrites; assert(TaichungEncounterInitSaveState() && sWrites == writes);
+            }
+    Fixture(TAICHUNG_ENCOUNTER_ALL_MASK, TAICHUNG_ENCOUNTER_ALL_MASK);
+    assert(TaichungEncounterGetAttemptMask() == TAICHUNG_ENCOUNTER_ALL_MASK);
+    assert(TaichungEncounterGetUnlockMask() == TAICHUNG_ENCOUNTER_ALL_MASK);
+    assert(V(TAICHUNG_ENCOUNTER_EXTRA_VAR) == 0x0101);
+    for (site = 0; site < 27; site++) assert(!TaichungEncounterBegin(site));
+    assert(TaichungEncounterInitSaveState() && !sWrites);
+    for (junk = 1; junk < 0x10000; junk <<= 1)
+    {
+        if (!(junk & TAICHUNG_ENCOUNTER_EXTRA_RESERVED_MASK)) continue;
+        Fixture(0, 0); V(TAICHUNG_ENCOUNTER_EXTRA_VAR) = junk;
+        memcpy(before, sSave.vars, sizeof(before));
+        assert(!TaichungEncounterStateReady() && !TaichungEncounterInitSaveState());
+        assert(!memcmp(before, sSave.vars, sizeof(before)) && !sWrites);
+    }
+    puts("PASS: EC02 available/spent/caught at all4rotated sites, all historical bits, upper24/25 noise and arbitrary oldEF sanitized; all other variables protected; current27-bit history/idempotence and reserved-bit rejection.");
+}
+
+int main(void)
+{
+    u16 site, species;
+    u32 bits, mask;
+    u8 outcome;
+    TestEc03Migration();
+    // A failed Snorlax throw, including the misleading near-catch line, is not
+    // capture provenance. Even a bogus caught outcome cannot grant its unlock.
+    for (outcome = 0; outcome < 4; outcome++)
+    {
+        const struct TaichungEncounterSite *snorlax = TaichungEncounterGetSite(TAICHUNG_ENCOUNTER_SECOND_MARKET);
+        assert(snorlax->species == SPECIES_SNORLAX);
+        Fixture(0, 0); Arm(TAICHUNG_ENCOUNTER_SECOND_MARKET);
+        assert(TaichungEncounterTakeBall());
+        assert(!TaichungEncounterGetUnlockMask());
+        assert(TaichungEncounterOnBattleEnd(snorlax->species, B_OUTCOME_CAUGHT));
