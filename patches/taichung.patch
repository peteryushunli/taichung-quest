+"""Miyahara pieces: red brick, dark-wood book towers, the Hogwarts stair, glass dessert case."""
+from PIL import Image, ImageDraw
+import random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((40,28,32))
+BR0,BR1,BR2,MOR=q((176,80,56)),q((144,60,44)),q((200,104,72)),q((216,184,160))
+DW0,DW1,DW2,DW3=q((120,72,44)),q((88,52,32)),q((152,96,60)),q((64,36,24))
+PL0,PL1,PL2=q((160,104,64)),q((136,88,52)),q((184,128,80))
+GD0,GD1=q((232,192,88)),q((176,136,48))
+GLS0,GLS1=q((200,232,240)),q((160,208,224))
+BOOK=[q(c) for c in ((200,56,56),(56,104,176),(232,192,72),(64,144,96),(232,224,208),(160,72,136),(224,128,64),(40,48,72))]
+
+def brick(seed=0,skirting=False):
+    im=Image.new('RGB',(16,16),MOR); d=ImageDraw.Draw(im); r=random.Random(seed)
+    for row in range(4):
+        y=row*4; off=0 if row%2==0 else 4
+        for x in range(-8+off,16,8):
+            c=r.choice((BR0,BR0,BR1,BR2)); d.rectangle([x,y,x+6,y+2],fill=c)
+    if skirting:
+        d.rectangle([0,11,15,15],fill=DW1); d.line([0,11,15,11],fill=DW2); d.line([0,15,15,15],fill=DW3)
+    return im
+
+def planks(seed=0):
+    im=Image.new('RGB',(16,16),PL0); d=ImageDraw.Draw(im); r=random.Random(seed)
+    for y in (3,7,11,15): d.line([0,y,15,y],fill=PL1)
+    for row in range(4):
+        x=r.choice((3,6,9,12)); d.line([x,row*4,x,row*4+2],fill=PL1)
+        d.line([0,row*4,15,row*4],fill=PL2) if row==0 else None
+    return im
+
+def marble(seed=0):
+    im=Image.new('RGB',(16,16),q((232,228,220))); d=ImageDraw.Draw(im); r=random.Random(seed)
+    for _ in range(3):
+        x=r.randrange(16); y=r.randrange(16)
+        for i in range(6): d.point(((x+i)%16,(y+i//2)%16),fill=q((196,192,188)))
+    d.line([0,15,15,15],fill=q((200,196,192))); d.line([15,0,15,15],fill=q((200,196,192)))
+    return im
+
+def inlay(base_l,base_m,base_r):
+    """'宮原眼科 1927' set into the entrance marble, 3x1."""
+    im=Image.new('RGB',(48,16));
+    for i,b in enumerate((base_l,base_m,base_r)): im.paste(b,(i*16,0))
+    d=ImageDraw.Draw(im)
+    d.rectangle([3,3,44,12],fill=q((72,56,48)),outline=GD1)
+    for i,x in enumerate((6,13,20,27)):    # four glyph blocks
+        d.rectangle([x,5,x+4,9],outline=GD0); d.point((x+2,7),fill=GD0)
+    for x in (34,37,40): d.line([x,6,x,9],fill=GD0)
+    d.line([33,6,33,9],fill=GD0)
+    return im
+
+def book_tower(seed,h=3,drawers=False):
+    """two-tile-wide dark-wood shelf tower, h tiles tall: gift boxes styled as books."""
+    W,H=32,h*16; im=Image.new('RGB',(W,H),DW1); d=ImageDraw.Draw(im); r=random.Random(seed)
+    d.rectangle([0,0,W-1,H-1],outline=OUT); d.rectangle([1,1,W-2,3],fill=DW2); d.line([1,4,W-2,4],fill=DW0)
+    d.line([15,5,15,H-2],fill=DW0); d.line([16,5,16,H-2],fill=DW3)
+    shelf_h=8
+    for y0 in range(5,H-3,shelf_h):
+        d.line([1,y0+shelf_h-1,W-2,y0+shelf_h-1],fill=DW2)
+        for half in (0,1):
+            x=2+half*15
+            if drawers:
+                for dx in range(x,x+12,4):
+                    d.rectangle([dx,y0+1,dx+3,y0+5],fill=DW0,outline=DW3); d.point((dx+1,y0+3),fill=GD0)
+                continue
+            while x<half*15+14:
+                w=r.choice((1,2,2,3)); hh=r.choice((4,5,6,6)); c=r.choice(BOOK)
+                d.rectangle([x,y0+shelf_h-1-hh,x+w-1,y0+shelf_h-2],fill=c)
+                if w>1: d.point((x,y0+shelf_h-1-hh),fill=q((255,255,255)) if c!=BOOK[4] else GD0)
+                x+=w+(1 if r.random()<.25 else 0)
+    d.rectangle([1,H-3,W-2,H-2],fill=DW3)
+    return im
+
+def mirror(base_row):
+    """big gold-framed mirror on the stair landing wall, 3x2 (over brick)."""
+    im=Image.new('RGB',(48,32));
+    for i in range(3):
+        im.paste(base_row[0],(i*16,0)); im.paste(base_row[1],(i*16,16))
+    d=ImageDraw.Draw(im)
+    d.rounded_rectangle([6,1,41,27],radius=6,fill=GD1,outline=OUT); d.rounded_rectangle([8,3,39,25],radius=5,fill=GD0)
+    d.rounded_rectangle([10,5,37,23],radius=4,fill=GLS1); d.rectangle([12,8,35,22],fill=GLS0)
+    d.line([15,20,24,7],fill=q((248,252,255))); d.line([18,21,26,10],fill=q((248,252,255)))
+    d.ellipse([21,0,26,4],fill=GD0,outline=OUT)
+    return im
+
+def stair(w=3,h=2):
+    """wooden main stair rising north, carpet runner, w x h tiles (treads only; rails separate)."""
+    W,H=w*16,h*16; im=Image.new('RGB',(W,H),PL1); d=ImageDraw.Draw(im)
+    for y in range(0,H,4):
+        d.rectangle([0,y,W-1,y+1],fill=PL2); d.line([0,y+2,W-1,y+2],fill=PL0); d.line([0,y+3,W-1,y+3],fill=DW1)
+    d.rectangle([W//2-8,0,W//2+7,H-1],fill=q((168,48,56)))
+    for y in range(0,H,4): d.line([W//2-8,y,W//2+7,y],fill=q((208,80,80))); d.line([W//2-8,y+3,W//2+7,y+3],fill=q((120,32,40)))
+    for y in range(3,H,4): d.point((W//2-9,y),fill=GD0); d.point((W//2+8,y),fill=GD0)
+    return im
+
+def banister(h=3,side='l',base=None):
+    """dark wood banister seen from the front, 1 x h tiles (RGBA over base)."""
+    im=Image.new('RGBA',(16,h*16));
+    if base:
+        for i in range(h): im.paste(base,(0,i*16))
+    d=ImageDraw.Draw(im); x=10 if side=='l' else 2
+    d.rectangle([x,6,x+3,h*16-2],fill=DW0,outline=OUT); d.line([x+1,7,x+1,h*16-3],fill=DW2)
+    d.rectangle([x-1,2,x+4,7],fill=DW2,outline=OUT); d.ellipse([x,0,x+3,3],fill=GD0,outline=OUT)
+    for y in range(12,h*16-4,6): d.line([x,y,x+3,y],fill=DW3)
+    return im
+
+def dessert_case(w=4):
+    """curved glass dessert counter, w x 2 tiles (RGBA, ends rounded)."""
+    W=w*16; im=Image.new('RGBA',(W,32)); d=ImageDraw.Draw(im)
+    d.rounded_rectangle([0,2,W-1,30],radius=8,fill=DW0,outline=OUT)
+    d.rounded_rectangle([2,3,W-3,16],radius=7,fill=GLS1); d.rounded_rectangle([3,4,W-4,14],radius=6,fill=GLS0)
+    cakes=[q((240,176,192)),q((248,240,224)),q((128,72,48)),q((232,200,96)),q((200,232,176))]
+    for i,x in enumerate(range(7,W-9,7)):
+        c=cakes[i%5]; d.rectangle([x,7,x+4,11],fill=c,outline=q((136,104,96))); d.point((x+2,6),fill=q((224,48,64)))
+    d.line([6,5,W-10,5],fill=q((255,255,255)))
+    d.rectangle([3,17,W-4,22],fill=GLS1)
+    for i,x in enumerate(range(8,W-8,9)): d.rectangle([x,18,x+5,21],fill=cakes[(i+2)%5])
+    d.line([3,23,W-4,23],fill=GD0); d.rectangle([3,24,W-4,28],fill=DW1)
+    return im
+
+def gift_table(base_l,base_r,seed=0):
+    """low table piled with book-style gift boxes and tea tins, 2x1."""
+    im=Image.new('RGBA',(32,16)); im.paste(base_l,(0,0)); im.paste(base_r,(16,0)); d=ImageDraw.Draw(im); r=random.Random(seed)
+    d.rectangle([1,6,30,12],fill=DW0,outline=OUT); d.line([2,7,29,7],fill=DW2)
+    for x in (3,27): d.line([x,13,x,15],fill=OUT)
+    x=3
+    while x<27:
+        c=r.choice(BOOK); hh=r.choice((3,4,5))
+        d.rectangle([x,7-hh,x+4,7],fill=c,outline=OUT); d.line([x+1,8-hh,x+3,8-hh],fill=q((255,255,255)) if c!=BOOK[4] else GD0)
+        x+=6
+    return im
+
+def well(base):
+    """the old well kept as a glass-topped donation box, 1x1."""
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    d.ellipse([1,3,14,14],fill=q((152,148,140)),outline=OUT); d.ellipse([3,4,12,11],fill=GLS1,outline=q((96,92,88)))
+    d.point((5,6),fill=q((255,255,255))); d.point((8,8),fill=GD0); d.point((10,7),fill=GD0)
+    return im
+
+def goldfish(base_top,base_bot):
+    """big goldfish ornament on a stand, 1x2 tiles."""
+    im=Image.new('RGBA',(16,32)); im.paste(base_top,(0,0)); im.paste(base_bot,(0,16)); d=ImageDraw.Draw(im)
+    F0,F1=q((248,128,48)),q((208,80,32))
+    d.line([7,16,7,28],fill=DW1); d.line([8,16,8,28],fill=DW0); d.rectangle([4,28,11,30],fill=DW1,outline=OUT)
+    d.ellipse([2,5,12,15],fill=F0,outline=OUT); d.polygon([(12,10),(15,5),(15,15)],fill=F1,outline=OUT)
+    d.point((5,8),fill=OUT); d.point((4,8),fill=q((255,255,255))); d.line([6,12,9,12],fill=F1)
+    return im
