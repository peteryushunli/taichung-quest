@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Require every stock local-player sentence to select a complete template."""
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parents[2]
+battle = (root / "src/battle_message.c").read_text()
+field = (root / "src/strings.c").read_text()
+templates = (root / "src/taichung_player_text.c").read_text()
+definition = re.compile(r'(?:static )?const u8 (\w+)\[\] = _\("([^\n]*)"\);')
+battle_named = {name for name, text in definition.findall(battle) if "{B_PLAYER_NAME}" in text or text.startswith("Player ")}
+field_c_named = {name for name, text in definition.findall(field) if "{PLAYER}" in text}
+save_asm = (root / "data/text/save.inc").read_text()
+assert re.search(r'gText_PlayerSavedTheGame::\s*\n\s*\.string "\{PLAYER\} saved the game\.\$"', save_asm)
+field_asm_named = {"gText_PlayerSavedTheGame"}
+field_named = field_c_named | field_asm_named
+battle_map = dict(re.findall(r'\{(\w+), (TAICHUNG_PLAYER_\w+)\}', battle))
+field_map = dict(re.findall(r'\{(\w+), (TAICHUNG_PLAYER_\w+)\}', templates))
+assert battle_named <= battle_map.keys(), f"Unmapped battle templates: {battle_named - battle_map.keys()}"
+assert field_named == field_map.keys(), f"Field template coverage differs: {field_named ^ field_map.keys()}"
+assert len(battle_named) == 25 and len(field_c_named) == 10 and len(field_asm_named) == 1 and len(field_named) == 11
+assert 'src = TaichungPlayerBattleText(src);' in battle
+assert 'src = TaichungPlayerFieldText(src);' in (root / "src/string_util.c").read_text()
+for _, text in definition.findall(templates):
+    assert not re.search(r'\{(?:B_PLAYER_NAME|PLAYER)\}|Walker|\byou.s\b|\byou (?:is|has)\b', text, re.I), text
+print(f"PASS: all {len(battle_named)} battle and {len(field_named)} field player-name/outcome templates routed")
diff --git a/tools/taichung_gameplay/audit-quest-log-player-text.py b/tools/taichung_gameplay/audit-quest-log-player-text.py
