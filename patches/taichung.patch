+    selected = [name for name in c["roads"] if name in available_names]
+    missing = [name for name in c["roads"] if name not in available_names]
+    assert selected, f"no source road matched {section['id']}"
+    refs=["municipal-roads-114"]+c["refs"]
+    retail={
+        "sourceRoadNames": selected, "evidenceRefs": refs,
+        "sourceGeometryMatchedWithinSection": True,
+        "status": "authored selection of retail/service frontages on verified roads; not surveyed parcel use",
+        "frontageContinuity": round(min(.95,c["frontage"]+.14),2),
+        "setbackTiles": [max(0,c["setback"][0]-1), max(1,c["setback"][1]-1)],
+        "arcadeFrequency": round(min(.9,c["arcade"]+.18),2),
+        "signageIntensity": round(min(.98,c["signage"]+.2),2),
+        "builtCoverageTarget": round(min(.8,c["coverage"]+.08),2),
+        "prefabRoleWeights": mix(ROLE_KEYS,[.10,.15,.51,.03,.16,.05]),
+    }
+    side={
+        "sourceRoadNames": [], "status": "authored subordinate block interiors, not a claim that every actual side street is residential",
+        "frontageContinuity": round(max(.3,c["frontage"]-.08),2),
+        "setbackTiles": c["setback"],
+        "arcadeFrequency": round(max(.05,c["arcade"]-.22),2),
+        "signageIntensity": round(max(.1,c["signage"]-.3),2),
+        "builtCoverageTarget": round(max(.35,c["coverage"]-.04),2),
+        "prefabRoleWeights": mix(ROLE_KEYS,[.47,.38,.07,.03,.05,0]),
+    }
+    result={
+        "id": section["id"], "name": c["name"], "nameZh": c["zh"],
+        "gridRow": section["gridRow"], "gridCol": section["gridCol"],
+        "worldOrigin": section["worldOrigin"], "width":64,"height":64,
+        "sourceBoundsWgs84": section["sourceBoundsWgs84"],
+        "districtAtSectionCenter": section["sourceDistrictAtCenter"],
+        "landmarkGymIds": section["landmarkGymIds"],
+        "visualArchetype": c["arch"], "sourceEvidenceRefs": refs,
+        "confidence": {"broadCharacter":c["confidence"],"withinSectionVariation":"low" if c["confidence"]=="low" else "medium",
+                       "exactBuildingAgeOrUse":"unavailable","note":c["note"]},
+        "authoredVisualTargets":target,
+        "streetBands":{"primaryRetailFrontage":retail,"residentialSideStreet":side},
+        "sourceMatchingNotes":{"omittedRequestedRoadNamesWithoutSelectedGeometry":missing},
+    }
+    if c["rc"] == "22":
+        # Do not silently change a consumed/approved pilot while building background metadata.
+        pilot=json.loads((DATA/"pilot-profile.json").read_text())["section"]
+        result["authoredVisualTargets"]=copy.deepcopy(pilot["authoredVisualTargets"])
+        result["streetBands"]=copy.deepcopy(pilot["streetBands"])
+        result["compositionRules"]=pilot["compositionRules"]
+        result["approvedPilotLayoutRef"]="data/taichung/neighborhoods/pilot-r2c2-layout.json"
