+        ordered = ('gSaveBlock1Ptr == NULL || UseContinueGameWarp()', '*warp = gSaveBlock1Ptr->location;', 'warp->warpId = -1;', 'warp->x = gSaveBlock1Ptr->pos.x;', 'warp->y = gSaveBlock1Ptr->pos.y;', API_NAME + '();', 'SetContinueGameWarpStatus();')
+        offsets = [body.find(fragment) for fragment in ordered]
+        require(all(offset >= 0 for offset in offsets) and offsets == sorted(offsets) and body.count(API_NAME + '();') == 1, 'Qualified cache/facing handoff order differs')
