+void DmaClearLarge16(u8 channel, void *dest, u32 size, u32 block) { (void)channel; (void)dest; (void)size; (void)block; }
+void DmaClear32(u8 channel, void *dest, u32 size) { (void)channel; (void)dest; (void)size; }
