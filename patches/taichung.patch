+def script_lines(text):
+    return [re.sub(r"\s+", " ", line.split("@", 1)[0].strip()) for line in text.splitlines() if line.split("@", 1)[0].strip()]
+
+
+def script_block(text, label):
+    match = re.search(rf"^{re.escape(label)}::\s*\n(.*?)(?=^\w+::|\Z)", text, re.S | re.M)
+    if not match:
+        raise ValueError(f"Missing script block {label}")
+    return script_lines(match.group(1))
