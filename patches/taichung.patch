+    output = HERE / "candidate-v2"
+    manifest = json.loads((output / "encode-manifest.json").read_text())
+    source = Path(manifest["sourceArtifact"])
+    generation = json.loads((HERE / "generation.json").read_text())
+    assert sha(source) == manifest["sourceSha256"] == generation["artifactSha256"]
+    indexed = Image.open(output / "candidate-indexed.png")
+    native = Image.open(output / "candidate-native.png")
+    station = Image.open(STATION)
+    assert indexed.mode == "P" and indexed.size == SIZE and indexed.info.get("transparency") == 0
+    assert indexed.getpalette()[:48] == station.getpalette()[:48]
+    assert set(native.getchannel("A").get_flattened_data()) == {0, 255}
+    assert native.getchannel("A").getbbox() == (0, 52, 128, 128)
+    assert not indexed.crop((128, 0, 160, 128)).getbbox()
+    assert not indexed.crop((0, 0, 160, 52)).getbbox()
+    raw = (output / "tiles.4bpp").read_bytes()
+    graphics = [tuple(value for byte in raw[n:n+32] for value in (byte & 15, byte >> 4))
+                for n in range(0, len(raw), 32)]
+    tile_raw = (output / "foreground-tilemap-relative.bin").read_bytes()
+    tilemap = struct.unpack("<320H", tile_raw)
+    assert len(graphics) == manifest["native"]["unique8x8GraphicsBeforeAnyBankMerge"]
+    assert all(word >> 12 == 7 and word & 1023 < len(graphics) for word in tilemap)
+    decoded = []
+    for y in range(128):
+        for x in range(160):
+            word = tilemap[y//8*20+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            decoded.append(graphics[word & 1023][sy*8+sx])
+    assert decoded == list(indexed.get_flattened_data())
+    assert manifest["entrance"]["measuredDoorGlassBoxPixelsInclusive"] == [79, 116, 94, 123]
+    assert manifest["entrance"]["doorGlassFitsTargetCell"] is False
+    assert manifest["entrance"]["portalCenterInsideTargetCell"] is True
+    assert manifest["entrance"]["maximumGlassBorderSpillPixels"] == 1
+    frozen = json.loads((HERE / "candidate-v2-preservation.json").read_text())["v1SourceAndOutputsSha256BeforeTrial"]
+    assert all(sha(Path(path)) == digest for path, digest in frozen.items()), "V1 source or outputs changed"
+    assert manifest["integration"]["nativeReady"] is False and manifest["budget"]["mergedWithOldCity"] is False
+    with tempfile.TemporaryDirectory(prefix="miyahara-candidate-") as folder:
+        temporary = Path(folder)
+        repeated = temporary / "candidate"
+        again = encode(source, repeated, temporary / "review.png")
+        again["reviewArtifact"] = manifest["reviewArtifact"]
+        assert again == manifest
+        compared = [p.relative_to(repeated) for p in repeated.rglob("*") if p.is_file() and p.name != "encode-manifest.json"]
+        assert all((output / relative).read_bytes() == (repeated / relative).read_bytes() for relative in compared)
+        assert (temporary / "review.png").read_bytes() == Path(manifest["reviewArtifact"]).read_bytes()
+        converter = GAME / "tools/gbagfx/gbagfx"
+        subprocess.run([str(converter), str(output / "tiles.png"), str(temporary / "sheet.4bpp")], check=True, capture_output=True)
+        converted = (temporary / "sheet.4bpp").read_bytes()
