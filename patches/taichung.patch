+    palette_text = 'JASC-PAL\n0100\n16\n'+'\n'.join(' '.join(map(str,color)) for color in full_palette)+'\n'
+    (output/'07.pal').write_bytes(palette_text.replace('\n','\r\n').encode())
+    (output/'07.gbapal').write_bytes(struct.pack('<16H',*(r//8|(g//8)<<5|(b//8)<<10 for r,g,b in full_palette)))
