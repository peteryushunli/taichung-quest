+def render_new(sc,n):
+ im=Image.new('RGB',(16,16))
+ for k,word in enumerate(sc['newdefs'][n]):
+  t=flip(sc['newtiles'][word&1023],word&0xC00);pal=sc['newpals'][word>>12]
+  for i,c in enumerate(t):
+   if k<4 or c:im.putpixel(((k%4%2)*8+i%8,(k%4//2)*8+i//8),pal[c])
+ return im
