+#!/usr/bin/env python3
+"""Execute real battle text dispatch/getter; audit actual failed/caught scripts."""
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/playtest-messages"
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("extract", ROOT / "tools/taichung_gameplay/test-save-facing.py")
+extract = importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+battle = (ROOT / "src/battle_message.c").read_text()
+text = (ROOT / "src/taichung_player_text.c").read_text()
+dispatch = extract.definition(battle, "TaichungPlayerBattleText")[0]
+originals = re.findall(r"\{(\w+), TAICHUNG_PLAYER_\w+\}", dispatch)
+failed = ["sText_PkmnBrokeFree", "sText_ItAppearedCaught", "sText_AarghAlmostHadIt", "sText_ShootSoClose"]
+declarations = []
+for name in originals:
+    if name in failed:
+        declarations.append(re.search(r"^static const u8 " + name + r"\[\] = _\(.*?\);$", battle, re.M)[0])
+    else:
+        declarations.append(f"static const u8 {name}[1] = {{0}};")
+for name in ("sBallBrokeFreeEn", "sBallBrokeFreeZh"):
+    declaration = re.search(r"^static const u8 " + name + r"\[\] = _\(.*?\);$", text, re.M)[0]
+    declarations.append(declaration)
+    literal = json.loads(re.search(r"_\((.*)\)", declaration)[1])
+    if name.endswith("Zh"):
+        charmap = (ROOT / "charmap.txt").read_text()
+        for char in set(literal) - {"\n"}:
+            assert re.search(r"^'" + re.escape(char) + r"'\s*=", charmap, re.M), char
+row = re.search(r"^\s*\[TAICHUNG_PLAYER_BALL_BROKE_FREE\].*$", text, re.M)[0].rstrip(",")
+prefix = '''#include "global.h"
+#include "taichung_player_text.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+static bool8 sChinese;
+static const u8 sEmpty[] = "";
+static const u8 *TaichungText(const u8 *en, const u8 *zh) { return sChinese ? zh : en; }
+'''
+getter = extract.definition(text, "TaichungPlayerTextGet")[0]
+main = '''int main(void) {
+    const u8 *variants[] = {sText_PkmnBrokeFree, sText_ItAppearedCaught, sText_AarghAlmostHadIt, sText_ShootSoClose};
+    unsigned i;
+    for (sChinese = 0; sChinese < 2; sChinese++) for (i = 0; i < 4; i++) {
+        const char *shown = (const char *)TaichungPlayerBattleText(variants[i]);
+        assert(strstr(shown, sChinese ? "捕捉失敗" : "It was not caught"));
+        assert(!strstr(shown, "appeared to be caught") && !strstr(shown, "Almost had"));
+    }
+    { const u8 other[] = "true catch/other message"; assert(TaichungPlayerBattleText(other) == other); }
+    puts("PASS: eight actual EN/ZH breakout dispatch/getter cases; other messages unchanged"); return 0;
+}
+'''
+source = OUT / "messages.c"
+source.write_text(prefix + "\n".join(declarations) + "\nstatic const u8 *const sText[TAICHUNG_PLAYER_TEXT_COUNT][2] = {\n" + row + "\n};\n" + getter + "\n" + dispatch + "\n" + main)
+subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-pointer-sign", "-I" + str(ROOT / "include"), str(source), "-o", str(OUT / "messages")], check=True)
+subprocess.run([str(OUT / "messages")], check=True)
+scripts = (ROOT / "data/battle_scripts_2.s").read_text()
+def block(label):
+    return re.search(r"^" + label + r"::\n(.*?)(?=^\w+::|\Z)", scripts, re.M | re.S)[1]
+for name in ("BattleScript_TaichungEncounterLastBallFailed", "BattleScript_TaichungEncounterNoBalls", "BattleScript_ShakeBallThrow", "BattleScript_CatchFailEnd"):
+    assert "givecaughtmon" not in block(name) and "B_OUTCOME_CAUGHT" not in block(name), name
+assert "givecaughtmon" in block("BattleScript_TaichungEncounterCaught")
+field = (ROOT / "data/scripts/taichung_encounters.inc").read_text()
+begin = field.split("TaichungEncounter_Begin::", 1)[1].split("TaichungEncounter_Result::", 1)[0]
+assert "message gStringVar4" not in begin and "waitmessage" not in begin
+assert "closemessage" in begin and "TaichungEncounter_ScriptSaveBegin" in begin and "waitstate" in begin
+assert "TaichungEncounter_MessageAndLeave" in begin
+assert "TaichungEncounter_ScriptSaveResult" not in begin
+prepared = field.split("TaichungEncounter_OfferPrepared::", 1)[1].split("TaichungEncounter_Prepare::", 1)[0]
+assert "TaichungEncounter_ScriptOffer" in prepared and "multichoicedefault 0, 0, MULTICHOICE_TAICHUNG_ENCOUNTER, 1, FALSE" in prepared
+result = field.split("TaichungEncounter_Result::",1)[1].split("TaichungEncounter_MessageAndLeave::",1)[0]
+assert "TaichungEncounter_OfferCaught" in result and "TaichungEncounter_ScriptChooseReplacement" in result and "TaichungEncounter_ConfirmReplacement::" in result
+adapter = (ROOT / "src/taichung_encounter_field.c").read_text()
+assert "Saving this attempt" not in adapter and "sStorageEn" in adapter
+print("PASS: actual failure scripts cannot run capture grant; Begin silent with durable waits and error dispatch retained")
