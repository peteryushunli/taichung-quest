+def paint_perimeter(engine, world, owners, refs):
+    rail, = [edge["rect"] for edge in engine.P.EDGES if edge["kind"] == "rail"]
+    rail_left, rail_top, rail_right, rail_bottom = rail
+    require(rail_right - rail_left == 6, "The railway has a six-tile cross-section.")
+    highways = [edge["rect"] for edge in engine.P.EDGES if edge["kind"] == "highway"]
+    west_highway = max(highways, key=lambda rect: rect[3])
+    north_highway = max(highways, key=lambda rect: rect[2])
+    south_edge = {}
+    for x, y in owners:
+        south_edge[x] = max(y + 1, south_edge.get(x, 0))
+    east_end = south_edge[rail_left - 1]
+    west_end = min(south_edge)
+
+    # Carry the roads and tracks through the camera margin at their ends.
+    # They can be seen from the corner even after the playable shore turns.
+    for (x, y), ref in refs.items():
+        if rail_left <= x < rail_right and rail_top <= y < max(rail_bottom, east_end) + MARGIN:
+            require((x, y) not in owners, "The railway must be outside the playable map.")
+            refs[x, y] = GroundRef(x - rail_left, "rail")
+        elif west_highway[0] <= x < west_highway[2] and y >= west_highway[3]:
+            refs[x, y] = world.edge_tile(x, west_highway[3] - 1)
+        elif x >= north_highway[2] and north_highway[1] <= y < north_highway[3]:
+            refs[x, y] = world.edge_tile(north_highway[2] - 1, y)
+        elif ref is None:
+            if y >= south_edge.get(x, east_end) and x >= west_end:
+                row = 0 if (x, y - 1) in owners and world.at(x, y - 1) != "~" else 1
+                refs[x, y] = GroundRef(engine.LAKE[row][1], "old")
+            else:
+                refs[x, y] = GroundRef(GRASS, "north")
+
