+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../src/taichung_theater_access.c"
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static u16 sTiles[23*12];
+static struct MapLayout sLayout = {.width=23,.height=12,.map=sTiles};
+static struct MapHeader sHeader = {.mapLayout=&sLayout};
+static bool8 sPending;
+static unsigned sRemember,sRequests,sCases;
+bool32 UseContinueGameWarp(void) { return sPending; }
+void SetContinueGameWarpStatus(void) { assert(sRemember==1); sPending=TRUE;sRequests++; }
+void TaichungSaveRememberObjectCacheRefreshFacing(void) { assert(!sPending);assert(sSave.continueGameWarp.x==sSave.pos.x && sSave.continueGameWarp.y==sSave.pos.y);sRemember++; }
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group,u16 number) { assert(group==43 && number==12);return &sHeader; }
+static void Reset(s16 x,s16 y)
+{
+ memset(&sSave,0xA5,sizeof(sSave));memset(sTiles,0,sizeof(sTiles));
+ sHeader.mapLayout=&sLayout;sLayout.map=sTiles;
+ sSave.playerPartyCount=3;sSave.vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START]=12;
+ sSave.pos=(struct Coords16){x,y};sSave.location=(struct WarpData){43,12,1,99,98};
+ sPending=FALSE;sRemember=sRequests=0;
+}
+static void Check(bool8 shouldRefresh)
+{
+ struct SaveBlock1 before=sSave;bool8 wasPending=sPending;
+ TaichungTheaterRefreshOnContinue();assert(sRequests==shouldRefresh && sRemember==shouldRefresh);
+ if(shouldRefresh){assert(sPending && sSave.continueGameWarp.warpId==-1);assert(sSave.continueGameWarp.mapGroup==43 && sSave.continueGameWarp.mapNum==12);before.continueGameWarp=sSave.continueGameWarp;}
+ else assert(sPending==wasPending);
+ assert(memcmp(&before,&sSave,sizeof(sSave))==0);sCases++;
+ TaichungTheaterRefreshOnContinue();assert(sRequests==shouldRefresh && sRemember==shouldRefresh);assert(memcmp(&before,&sSave,sizeof(sSave))==0);sCases++;
+}
+int main(void)
+{
+ unsigned x,y,n;
+ for(y=0;y<12;y++)for(x=0;x<23;x++){Reset(x,y);Check(TRUE);Reset(x,y);sTiles[y*23+x]=0x400;Check(FALSE);Reset(x,y);sPending=TRUE;Check(FALSE);}
+ for(n=0;n<14;n++)if(n!=12){Reset(11,10);sSave.vars[TAICHUNG_SAVE_VERSION_VAR-VARS_START]=n;Check(FALSE);}
+ for(n=0;n<128;n++)if(n!=12){Reset(11,10);sSave.location.mapNum=n;Check(FALSE);}
+ for(n=0;n<128;n++)if(n!=43){Reset(11,10);sSave.location.mapGroup=n;Check(FALSE);}
+ Reset(-1,5);Check(FALSE);Reset(23,5);Check(FALSE);Reset(5,-1);Check(FALSE);Reset(5,12);Check(FALSE);
+ Reset(11,10);sSave.playerPartyCount=0;Check(FALSE);Reset(11,10);sSave.playerPartyCount=7;Check(FALSE);
+ Reset(11,10);sHeader.mapLayout=NULL;Check(FALSE);Reset(11,10);sLayout.map=NULL;Check(FALSE);
+ gSaveBlock1Ptr=NULL;TaichungTheaterRefreshOnContinue();printf("PASS: %u exact Theater cache refresh/protected-save/control cases; pending native returns and other maps/versions preserved\n",sCases);return 0;
+}
