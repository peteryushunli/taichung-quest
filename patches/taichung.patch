+        return sZh_TaichungCity_Text_ShenJi;
+    if (text == TaichungCity_Text_Host_ShenJi)
+        return sZh_TaichungCity_Text_Host_ShenJi;
+    if (text == TaichungCity_Text_FineArts)
+        return sZh_TaichungCity_Text_FineArts;
+    if (text == TaichungCity_Text_Host_FineArts)
+        return sZh_TaichungCity_Text_Host_FineArts;
+    if (text == TaichungCity_Text_Fengjia)
+        return sZh_TaichungCity_Text_Fengjia;
+    if (text == TaichungCity_Text_Host_Fengjia)
+        return sZh_TaichungCity_Text_Host_Fengjia;
+    if (text == TaichungCity_Text_MapleGarden)
+        return sZh_TaichungCity_Text_MapleGarden;
+    if (text == TaichungCity_Text_Host_MapleGarden)
+        return sZh_TaichungCity_Text_Host_MapleGarden;
