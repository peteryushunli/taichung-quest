+    "data/tilesets/secondary/taichung_xitun_final/palettes/00.pal": "52262e9fff5988d487f576afb341fe8820a6faff5689ee7b791f79c1dce3232f",
+    "data/tilesets/secondary/taichung_xitun_final/palettes/01.pal": "5332cb1fe4cce13c2704cdc1e04cdb0b6cd5c731622c14bd3bf5af6a0c3454e7",
