+    native.resize((SIZE[0]*4, SIZE[1]*4), Image.Resampling.NEAREST).save(review)
+    physical_count = ((len(graphics)+15)//16)*16
+    sheet = Image.new("P", (128, physical_count//16*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info["transparency"] = 0
+    for n, pixels in enumerate(graphics):
