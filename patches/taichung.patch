+                    assert ('staff' in events)==(choices[0]==0)
+                    assert ('garden' in events)==(history==3 and choices[0]==0);count+=1
+                assert run(entry,[],complete=complete,replay=True,locale=locale,namespace=namespace)==[];count+=1
+for entry,history in (SIGN_ROSTER|HOSTS).items():
