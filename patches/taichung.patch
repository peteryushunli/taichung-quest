+def put_events(fill, maps, owners, walk):
+    script_labels = {line.split(":", 1)[0] for path in (ROOT / "data").rglob("*.inc")
+                     for line in path.read_text(errors="replace").splitlines()
+                     if re.match(r"^\w+::?", line)}
+    ambient = ROOT / "data/scripts/taichung_ambient_npcs.inc"
+    if ambient.is_file():
+        script_labels.update("TaichungBoulevard_Ambient_" + name for name in
+                             re.findall(r"^\s*taichung_ambient_npc (\w+)$", ambient.read_text(), re.M))
+    installed = Counter()
+    deferred = []
+    for event in fill["events"]["list"]:
+        point = tuple(event["tile"]) if event["tile"] else None
+        if not event.get("inLiveGame"):
+            deferred.append(event)
+            continue
+        require(point in owners, f"Event is outside the map book: {event}")
+        game_map = maps[owners[point]]
+        x, y = point[0] - game_map["rect"][0], point[1] - game_map["rect"][1]
+        if event["type"] == "door":
+            require(tuple(event["approach"]) in walk, f"Blocked door approach: {event}")
+            game_map["warps"].append({"x": x, "y": y, "elevation": 0, "dest_map": event["destMap"],
+                                      "dest_warp_id": str(event["destWarp"])})
+        elif event["type"] == "sign":
+            script = event["script"].removeprefix("Taichung_EventScript_")
+            if script == "TaichungCity_Sign_CulturalHeritage":
+                script = "TaichungCity_Sign_CulturalHeritagePark"
+            require(script in script_labels, f"Missing sign script: {script}")
+            require(tuple(event["readFrom"]) in walk, f"Blocked sign approach: {event}")
+            game_map["signs"].append({"type": "sign", "x": x, "y": y, "elevation": 0,
+                                      "player_facing_dir": "BG_EVENT_PLAYER_FACING_ANY",
+                                      "script": script})
+        else:
+            require(event["script"] in script_labels and point in walk, f"Invalid guide: {event}")
+            game_map["people"].append({
+                "type": "object", "graphics_id": event["graphics"], "x": x, "y": y,
+                "elevation": ELEVATION, "movement_type": event.get("movement_type", "MOVEMENT_TYPE_FACE_DOWN"),
+                "movement_range_x": event.get("movement_range_x", 0),
+                "movement_range_y": event.get("movement_range_y", 0), "trainer_type": "TRAINER_TYPE_NONE",
+                "trainer_sight_or_berry_tree_id": "0", "script": event["script"], "flag": "0",
+            })
+        installed[event["type"]] += 1
+    return installed, deferred
+
+
+def validate_street_motion(people, fill, maps, owners, walk, world):
+    """Validate every possible paused-wander cell, not just the spawn or a sample."""
+    modes = {"MOVEMENT_TYPE_FACE_DOWN": (0, 0),
+             "MOVEMENT_TYPE_WALK_LEFT_AND_RIGHT": (1, 0),
+             "MOVEMENT_TYPE_WALK_UP_AND_DOWN": (0, 1),
+             "MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT": (1, 0),
+             "MOVEMENT_TYPE_WANDER_UP_AND_DOWN": (0, 1),
+             "MOVEMENT_TYPE_WANDER_AROUND_SLOWER": (1, 1)}
+
+    def envelope(person):
+        x, y = person["tile"]
+        mode = person.get("movement_type", "MOVEMENT_TYPE_FACE_DOWN")
+        rx, ry = person.get("movement_range_x", 0), person.get("movement_range_y", 0)
+        require(mode in modes and 0 <= rx <= 2 and 0 <= ry <= 2, "Unsupported street movement")
+        dx, dy = modes[mode]
+        require((not rx or dx) and (not ry or dy), "Movement range must match its axis")
+        if mode == "MOVEMENT_TYPE_WANDER_AROUND_SLOWER":
+            require(rx >= 1 and ry >= 1, "Native two-axis wandering needs positive ranges")
+        return {(x + xx, y + yy) for xx in range(-rx, rx + 1) for yy in range(-ry, ry + 1)}
+
+    critical = set()
+    for event in fill["events"]["list"]:
+        if not event.get("inLiveGame") or event.get("role") == "ambient":
+            continue
+        for key in ("tile", "approach", "readFrom"):
+            if event.get(key) and not (event.get("type") == "person" and event.get("script") in TRAINER_PATROL_SCRIPTS):
+                critical.add(tuple(event[key]))
+    trainer_routes = {person["script"]: envelope(person) for person in people
+                      if person["script"] in TRAINER_PATROL_SCRIPTS}
+    # Stationed people are critical points; moving trainers protect their whole
+    # envelope for every OTHER actor, without masking a sign inside their own.
+    for person in people:
+        if person.get("role") != "ambient" and person["script"] not in TRAINER_PATROL_SCRIPTS:
+            critical.update(envelope(person))
+    repairs = json.loads((ROOT / "data/taichung/north-xitun-continue/repairs.json").read_text())
+    for row in repairs["maps"]:
+        game_map = next(m for m in maps if m["nativeName"] == row["name"])
+        x0, y0, _, _ = game_map["rect"]
+        for _, _, x, y in row["repairs"]:
+            critical.add((x0 + x, y0 + y))
+    critical.update((x + dx, y + dy) for x, y in walk if world.at(x, y) in "=~"
+                    for dx in range(-2, 3) for dy in range(-2, 3))
+    all_routes = set()
+    manifest = []
+    for person in people:
+        x, y = person["tile"]
+        mode = person.get("movement_type", "MOVEMENT_TYPE_FACE_DOWN")
+        rx, ry = person.get("movement_range_x", 0), person.get("movement_range_y", 0)
+        route = envelope(person)
+        require(route <= walk and {owners[p] for p in route} == {owners[x, y]},
+                f"Street patrol leaves its native map: {person['script']}")
+        require(not route & all_routes, "Street patrol envelopes overlap")
+        all_routes.update(route)
+        ambient = person.get("role") == "ambient"
+        if not ambient and person["script"] not in TRAINER_PATROL_SCRIPTS:
+            require(mode == "MOVEMENT_TYPE_FACE_DOWN", "Affiliated guides and stationed workers remain fixed")
+            continue
+        turning_trainer = not ambient and mode == "MOVEMENT_TYPE_WANDER_AROUND_SLOWER"
+        if ambient or turning_trainer:
+            require(mode.startswith("MOVEMENT_TYPE_WANDER_"), "Regular residents must use paused wandering")
+            require(all(world.at(px, py) not in "BSLu" for px, py in route),
+                    f"Resident wanders onto a road or crossing: {person['id']}")
+        else:
+            # Existing manual trainers retain the already reviewed broad one-axis paths.
+            halo = {(px + xx, py + yy) for px, py in route for xx in (-1, 0, 1) for yy in (-1, 0, 1)}
+            require(halo <= walk and {owners[p] for p in halo} == {owners[x, y]},
+                    f"Trainer patrol has no broad bypass: {person['script']}")
+        protected = critical | set().union(*(cells for script, cells in trainer_routes.items()
+                                             if script != person["script"]))
+        clearance = 2 if ambient or turning_trainer else 3
+        require(all(abs(px - qx) + abs(py - qy) >= clearance for px, py in route for qx, qy in protected),
+                f"Street patrol approaches a protected event: {person['script']}")
+        manifest.append(dict(id=person["id"], role=person["role"], script=person["script"], worldStart=[x, y],
+                             worldRoute=sorted(route), worldEnvelope=sorted(route), movement=mode, rangeX=rx, rangeY=ry,
+                             safeOverlapWorldCandidates=sorted(route - {(x, y)},
+                                 key=lambda p: (abs(p[0] - x) + abs(p[1] - y), p))))
+    # Even simultaneous occupation of every possible patrol tile must leave one city network.
+    unobstructed = walk - all_routes
+    reachable, _ = reachability(maps, owners, unobstructed)
+    require(reachable == unobstructed, "Combined patrol envelopes divide a city route")
+    return manifest
+
+
+def assign_metatiles(maps, cells):
+    # Two maps that can show the same cell must agree on its number. A
+    # number can be reused if the maps using those artwork keys are disjoint.
+    uses = defaultdict(int)
+    for game_map in maps:
+        keys = {cells[point] for point in points(padded(game_map["rect"], MARGIN))}
+        keys = {key for key in keys if key >= PRIMARY_TILES}
+        game_map["keys"] = keys
+        bit = 1 << game_map["index"]
+        for key in keys:
+            uses[key] |= bit
+
+    taken = []
+    assignment = {}
+    for key, bits in sorted(uses.items(), key=lambda item: (-item[1].bit_count(), item[0])):
+        slot = next((i for i, used in enumerate(taken) if not used & bits), len(taken))
+        if slot == len(taken):
+            taken.append(0)
+        require(slot < SECONDARY_METATILES, "Connected maps need more than 2,048 metatile IDs.")
+        taken[slot] |= bits
+        assignment[key] = slot
+    return assignment, len(taken)
+
+
+def draw_budget(cells, tiles, walk):
+    # A 17×17 union covers the current draw window plus the exposed row and
+    # column during a step. The pinned500-511 range includes both flower quartets.
+    usage = []
+    for entries, _ in tiles:
+        tile_bits, palette_bits = 0, 0
+        for tile, _, palette in (entry for entry in entries if entry is not None):
+            if tile not in FLOWERS:
+                tile_bits |= 1 << tile
+            palette_bits |= 1 << palette
+        usage.append((tile_bits, palette_bits))
+    rows = {}
+    worst_tiles = worst_pals = (0, ())
+    exceeded = []
+    for x, y in sorted(walk):
+        ts = ps = 0
+        for row in range(y - 8, y + 9):
+            row_key = x, row
+            if row_key not in rows:
+                rt = rp = 0
+                for col in range(x - 8, x + 9):
+                    t, p = usage[cells[col, row]]
+                    rt |= t
+                    rp |= p
+                rows[row_key] = rt, rp
+            t, p = rows[row_key]
+            ts |= t
+            ps |= p
+        nt, np = ts.bit_count(), ps.bit_count()
+        worst_tiles = max(worst_tiles, (nt, (x, y)))
+        worst_pals = max(worst_pals, (np, (x, y)))
+        if nt > TILE_SLOTS or np > PALETTE_SLOTS:
+            exceeded.append((x, y, nt, np))
+    require(not exceeded, f"Over the camera budget in {len(exceeded)} cells: {exceeded[:12]}")
+    return {"tileSlots": TILE_SLOTS, "paletteSlots": PALETTE_SLOTS,
+            "worstTiles": worst_tiles, "worstPalettes": worst_pals, "positions": len(walk)}
+
+
+def outputs_for(maps, owners, cells, tiles, walk, assignment, palettes, pool):
+    outputs = {}
+    layout_file = Path("data/layouts/layouts.json")
+    group_file = Path("data/maps/map_groups.json")
+    layouts = json.loads((ROOT / layout_file).read_text())
+    group = json.loads((ROOT / group_file).read_text())
+    group_maps = group["gMapGroup_Taichung"]
+    original_names = [item["nativeName"] for item in maps]
+    layout_names = {name + "_Layout" for name in original_names}
+    layout_indexes = {item["name"]: i for i, item in enumerate(layouts["layouts"])
+                      if item and item["name"] in layout_names}
+    indexed = original_names[0] in group_maps
+    first = group_maps.index(original_names[0]) if indexed else len(group_maps)
+    require(first + len(maps) <= 128, "The city exceeds the signed native warp map index.")
+    if indexed:
+        require(group_maps[first:first + len(maps)] == original_names and len(layout_indexes) == len(maps),
+                "The existing city registration is incomplete or out of order.")
+    else:
+        require(not layout_indexes and not any(name in group_maps for name in original_names),
+                "The existing city registration is incomplete.")
+        group_maps.extend(original_names)
+    headers, definitions, scripts = [], [], []
+    wild_tables = json.loads((ROOT / "src/data/wild_encounters.json").read_text())
+    wild_sources = {
+        entry["base_label"]: entry["map"]
+        for group in wild_tables["wild_encounter_groups"]
+        for entry in group["encounters"]
+        if entry["map"].startswith("MAP_TAICHUNG_")
+    }
+    wild_aliases = []
+
+    def grid_word(point, solid):
+        key = cells[point]
+        if key >= PRIMARY_TILES:
+            key = assignment[key] + PRIMARY_TILES
+        # Bit 11 extends the metatile ID; bit 10 remains collision.
+        return (key & 0x3ff) | ((key & 0x400) << 1) | (COLLISION if solid else 0) | (ELEVATION << 12)
+
+    for game_map in maps:
+        x0, y0, x1, y1 = game_map["rect"]
+        w, h = game_map["size"]
+        bw, bh = w + 2 * MARGIN, h + 2 * MARGIN
+        name = game_map["nativeName"]
+        map_id = game_map["nativeId"]
+        layout_id = "LAYOUT_" + map_id.removeprefix("MAP_")
+        layout_dir = Path("data/layouts") / name
+        block_path = layout_dir / "map.bin"
+        border_path = layout_dir / "border.bin"
+        core = [grid_word(point, point not in walk) for point in points(game_map["rect"])]
+        border = []
+        for y in range(bh):
+            yy = y0 + (y if y < h + MARGIN else y - bh)
+            for x in range(bw):
+                xx = x0 + (x if x < w + MARGIN else x - bw)
+                border.append(grid_word((xx, yy), True))
+        outputs[block_path] = struct.pack(f"<{len(core)}H", *core)
+        outputs[border_path] = struct.pack(f"<{len(border)}H", *border)
+        num = first + game_map["index"]
+        game_map["number"] = num
+        source = game_map.get("wildTable")
+        wild_aliases.append(f"    MAP_NUM({wild_sources[source]})," if source else "    0xFF,")
+        part = f"map_{num:02}"
+        table = [((None,) * 8, 0)] * (max((assignment[key] for key in game_map["keys"]), default=0) + 1)
+        for key in game_map["keys"]:
+            table[assignment[key]] = tiles[key]
+        for kind, ctype, data in zip(("Metatiles", "Banks", "Attributes"), ("u16", "u8", "u32"), encode_tables(table)):
+            path = TILESET_DIR / f"{part}_{kind.lower()}.bin"
+            outputs[path] = data
+            definitions.append(f'const {ctype} gBoulevard{kind}_{num}[] = INCBIN_{ctype.upper()}("{path}");')
+        headers.append(f"""const struct Tileset gTileset_Boulevard{num} =
+{{
+    .isCompressed = FALSE,
+    .isSecondary = TRUE,
+    .tiles = gTilesetTiles_TaichungBoulevard,
+    .palettes = (const u16 (*)[16])gTilesetPalettes_TaichungBoulevard,
+    .metatiles = gBoulevardMetatiles_{num},
+    .metatileAttributes = gBoulevardAttributes_{num},
+    .streamBanks = gBoulevardBanks_{num},
+    .streamNumTiles = {len(pool.patterns)},
+    .streamNumMetatiles = {len(table)},
+    .streamNumPalettes = {len(palettes) + PRIMARY_PALETTES},
+}};
+""")
+        layout = {
+            "id": layout_id, "name": name + "_Layout", "width": w, "height": h,
+            "border_width": bw, "border_height": bh,
+            "primary_tileset": "gTileset_TaichungBoulevardPrimary",
+            "secondary_tileset": f"gTileset_Boulevard{num}", "border_filepath": str(border_path),
+            "blockdata_filepath": str(block_path),
+        }
+        if indexed:
+            layouts["layouts"][layout_indexes[layout["name"]]] = layout
+        else:
+            layouts["layouts"].append(layout)
+        outputs[Path("data/maps") / name / "map.json"] = json_bytes({
+            "id": map_id, "name": name, "layout": layout_id, "music": "MUS_VERMILLION",
+            "region_map_section": "MAPSEC_TAICHUNG_BLVD_" + game_map["district"].upper(),
+            "requires_flash": False, "weather": "WEATHER_SUNNY", "map_type": "MAP_TYPE_CITY",
+            "allow_cycling": True, "allow_escaping": False, "allow_running": True,
+            "show_map_name": True, "floor_number": 0, "battle_scene": "MAP_BATTLE_SCENE_NORMAL",
+            "connections": game_map["nativeConnections"] or None,
+            "object_events": game_map["people"], "warp_events": game_map["warps"],
+            "coord_events": [], "bg_events": game_map["signs"],
+        })
+        scripts.append(name + "_MapScripts::\n\t.byte 0")
+    outputs[layout_file] = json_bytes(layouts)
+    outputs[group_file] = json_bytes(group)
+    nantun_cutoffs = {NANTUN_START_ROW - game_map["rect"][1]
+                      for game_map in maps if game_map["nativeId"] in NANTUN_EDGE_MAPS}
+    require(len(nantun_cutoffs) == 1, "The Nantun edge maps must start on the same row.")
+    outputs[Path("include/constants/taichung_boulevard.h")] = (
+        "#ifndef GUARD_CONSTANTS_TAICHUNG_BOULEVARD_H\n"
+        "#define GUARD_CONSTANTS_TAICHUNG_BOULEVARD_H\n"
+        f"#define TAICHUNG_BOULEVARD_FIRST {maps[0]['nativeId']}\n"
+        f"#define TAICHUNG_BOULEVARD_LAST  {maps[-1]['nativeId']}\n"
+        f"#define TAICHUNG_BOULEVARD_NANTUN_LOCAL_ROW {nantun_cutoffs.pop()}\n"
+        "#endif\n"
+    ).encode()
+    outputs[Path("src/data/taichung_boulevard_wild.h")] = (
+        "static const u8 sTaichungBoulevardWildSources[] =\n{\n" +
+        "\n".join(wild_aliases) + "\n};\n"
+    ).encode()
+    outputs[TILESET_DIR / "tiles.bin"] = bytes(pool.raw)
+    words = [0] * (16 * PRIMARY_PALETTES)
+    for palette in palettes:
+        words.extend([0, *palette, *([0] * (15 - len(palette)))])
+    outputs[TILESET_DIR / "palettes.bin"] = struct.pack(f"<{len(words)}H", *words)
+
+    tables_dir = Path("src/data/tilesets")
+    includes = {
+        "graphics": [
+            f'const u32 gTilesetTiles_TaichungBoulevard[] = INCBIN_U32("{TILESET_DIR / "tiles.bin"}");',
+            f'const u16 gTilesetPalettes_TaichungBoulevard[] = INCBIN_U16("{TILESET_DIR / "palettes.bin"}");',
+        ],
+        "metatiles": definitions, "headers": headers,
+    }
+    for part, lines in includes.items():
+        include = tables_dir / f"taichung_boulevard_{part}.h"
+        outputs[include] = ("\n".join(lines).rstrip() + "\n").encode()
+        path = tables_dir / f"{part}.h"
+        line = f'#include "{include.name}"'
+        current = (ROOT / path).read_text()
+        outputs[path] = (current if line in current else current.rstrip() + "\n\n" + line + "\n").encode()
+
+    station = maps[owners[STATION_SPAWN]]
+    x0, y0, _, _ = station["rect"]
+    scripts.append(f"""TaichungBoulevard_EnterPreview::
+    lockall
+    warp {station['nativeId']}, {STATION_SPAWN[0] - x0}, {STATION_SPAWN[1] - y0}
+    waitstate
+    releaseall
+    end""")
+    script_path = Path("data/scripts/taichung_boulevard.inc")
+    outputs[script_path] = ("\n\n".join(scripts) + "\n").encode()
+    path = Path("data/scripts/taichung_city.inc")
+    text = (ROOT / path).read_text()
+    line = f'\t.include "{script_path}"'
+    outputs[path] = (text if line in text else text.rstrip() + "\n\n" + line + "\n").encode()
+    uses_preview = {"type": "trigger", "x": PREVIEW_ENTRY[0], "y": PREVIEW_ENTRY[1],
+                    "elevation": 3, "var": "VAR_TEMP_1", "var_value": "0",
+                    "script": "TaichungBoulevard_EnterPreview"}
+    old_city = Path("data/maps/TaichungOldCity/map.json")
+    data = json.loads((ROOT / old_city).read_text())
+    data["coord_events"] = [event for event in data["coord_events"]
+                            if event["script"] != uses_preview["script"]] + [uses_preview]
+    outputs[old_city] = json_bytes(data)
+    guest_house = Path("data/maps/TaichungGuestHouse_1F/map.json")
+    house = json.loads((ROOT / guest_house).read_text())
+    porch = next(i for i, warp in enumerate(station["warps"])
+                 if warp["dest_map"] == house["id"])
+    for warp in house["warp_events"]:
+        if warp["dest_map"] in (data["id"], station["nativeId"]):
+            warp.update(dest_map=station["nativeId"], dest_warp_id=str(porch))
+    outputs[guest_house] = json_bytes(house)
+    return outputs
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("fill_directory", type=Path)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    engine, world, fill, book, inputs = load_inputs(args.fill_directory)
+    xitun_towers = install_xitun_towers(world, fill)
+    north_xitun = install_north_xitun(world, fill, args.fill_directory, LANDMARK_ART)
+    named_xitun_signs = install_named_xitun_signs(world, fill)
+    confucius_doors = install_confucius_gym(fill)
+    inputs["northXitunPlan"] = digest(HERE / "north-xitun.json")
+    inputs["northXitunCompiler"] = digest(HERE / "north_xitun.py")
+    landmarks = install_landmarks(world, fill)
+    capture_signs = install_capture_signs(world, fill)
+    capture_signs.extend({key: site[key] for key in ("id", "signTile", "readFrom", "script")}
+                         for site in landmarks)
+    people_path = HERE / "street-people.json"
+    street_people = json.loads(people_path.read_text())
+    inputs["streetPeople"] = digest(people_path)
+    fill["events"]["list"].extend(dict(person, type="person", inLiveGame=True) for person in street_people)
+    maps, owners = prepare_maps(book)
+    extent = padded((min(x for x, _ in owners), min(y for _, y in owners),
+                     max(x for x, _ in owners) + 1, max(y for _, y in owners) + 1), MARGIN)
+    refs, keys, extras, palettes, palette_for, pool, art, art_hashes = open_sources(
+        engine, world, fill, extent, owners, args.fill_directory)
+    cells, tiles, walk, optional_ground = world_cells(
+        engine, world, fill, extent, owners, refs, keys, extras, pool, palette_for, art,
+        overhead_cells(world, args.fill_directory))
+    install_pavilion_deck(engine, world, owners, refs, cells, tiles, walk, pool, palette_for["extra", 0, 0])
+    occupied = {tuple(person["tile"]) for person in street_people}
+    require(len(occupied) == len(street_people), "Street NPCs overlap.")
+    # Open clear paving and formal lawn where visitors can reach them past the NPCs.
+    connected, _ = reachability(maps, owners, (walk | optional_ground) - occupied)
+    # A wandering resident can start on already connected formal lawn. Its
+    # temporary occupation must not turn that ground into solid terrain.
+    walk.update(optional_ground & (connected | occupied))
+    tower_walk = set(points((84, 112, 86, 127))) | set(points((76, 126, 94, 127)))
+    require(tower_walk <= walk - occupied, "The Xitun tower block blocks its passage or sidewalk.")
+    reached, seams = reachability(maps, owners, walk)
+    installed, deferred = put_events(fill, maps, owners, walk)
+    walk_around_people = walk - occupied
+    open_routes, _ = reachability(maps, owners, walk_around_people)
+    require(open_routes == walk_around_people, "A street NPC blocks a city route.")
+    for person in street_people:
+        x, y = person["tile"]
+        require(any((x + dx, y + dy) in open_routes for dx, dy in ((0, 1), (1, 0), (0, -1), (-1, 0))),
+                f"No approach to {person['script']}.")
+    street_motion = validate_street_motion(street_people, fill, maps, owners, walk, world)
+    reached_maps = {owners[point] for point in reached}
+    print(f"{len(reached_maps)}/{len(maps)} maps reachable, {len(reached)}/{len(walk)} walkable cells reachable, "
+          f"{len(seams)} traversable directed connections.", flush=True)
+    require(len(reached_maps) == len(maps), "There are unreachable maps in the map book.")
+    require(reached == walk, "Some playable cells cannot be reached from Old Station.")
+    assignment, max_metatiles = assign_metatiles(maps, cells)
+    budget = draw_budget(cells, tiles, walk)
+    budget["graphicsPool"] = len(pool.patterns) + PRIMARY_TILES
+    budget["metatileIdsUsed"] = max_metatiles + PRIMARY_TILES
+    print(budget, flush=True)
+    outputs = outputs_for(maps, owners, cells, tiles, walk, assignment, palettes, pool)
+    report = {
+        "sourceSha256": inputs, "spriteSha256": art_hashes, "budget": budget,
+        "entry": {"legacyOldCity": PREVIEW_ENTRY, "boulevardWorld": STATION_SPAWN},
+        "events": {"installed": installed, "pending": deferred},
+        "installedLandmarks": landmarks,
+        "xitunTowerBlock": xitun_towers,
+        "northXitun": north_xitun,
+        "namedXitunSigns": named_xitun_signs,
+        "confuciusGymDoors": confucius_doors,
+        "captureSigns": capture_signs,
+        "streetPeople": street_people,
+        "streetMotion": street_motion,
+        "theaterGroundAudit": world_cells.theater_audit,
+        "pavilionDeck": {"platform": PLATFORM, "causeway": CAUSEWAY},
+        "reachable": {"maps": len(reached_maps), "tiles": len(reached), "walkableTiles": len(walk),
+                      "seams": sorted(seams)},
+        "maps": [{
+            "nativeId": game_map["nativeId"], "name": game_map["nativeName"], "number": game_map["number"],
+            "worldRect": game_map["rect"], "district": game_map["district"],
+            "connections": game_map["nativeConnections"], "wildTable": game_map.get("wildTable"),
+            "doors": game_map["warps"], "people": game_map["people"], "signs": game_map["signs"],
+            "localWalkable": ["".join("1" if (x, y) in walk else "0"
+                                     for x in range(game_map["rect"][0], game_map["rect"][2]))
+                              for y in range(game_map["rect"][1], game_map["rect"][3])],
+            **({"districtBefore": {"y": NANTUN_START_ROW, "district": "xitun"}}
+               if game_map["nativeId"] in NANTUN_EDGE_MAPS else {}),
+        } for game_map in maps],
+    }
+    for path, data in outputs.items():
+        file = ROOT / path
+        file.parent.mkdir(parents=True, exist_ok=True)
+        pending = file.with_suffix(file.suffix + ".tmp")
+        pending.write_bytes(data)
+        pending.replace(file)
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_bytes(json_bytes(report))
+
+
+if __name__ == "__main__":
+    main()
