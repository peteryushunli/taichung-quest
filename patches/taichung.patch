+s=(ROOT/'src/taichung_team_menu.c').read_text();(OUT/'native-choice.inc').write_text('\n'.join(m.definition(s,f)[0]for f in ['KeepingCurrentPartner','ChoiceLevel','ChoiceMove'])+'\n')
