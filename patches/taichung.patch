+    paths = {}
+    for identity, end in approaches.items():
+        p = tuple(end); chain = [list(p)]
+        while p != spawn: p = previous[p]; chain.append(list(p))
+        paths[identity] = list(reversed(chain))
+    result = dict(schemaVersion=1, status='proposal only; native installation and bank merge belong to Main', mapId=MAP_ID,
+        dimensions=[WIDTH, HEIGHT], baseMapSha256=fingerprints[str(native.proposal_base_path.relative_to(ROOT))],
+        proposalBasePath=str(native.proposal_base_path.relative_to(ROOT)), sourceSha256=fingerprints,
+        frozenBaselineSha256=fingerprints['data/taichung/landmarks/old-core-native/baseline-map.bin'],
+        sourceTileNamespace=dict(primary='General', secondary='PewterCity', targetSecondary=layout['secondary_tileset'],
+            colorVariantMetatilesInclusive=[815, 846], installedNativeRenderAndBehaviorVerified=True, extraMetatilesRequired=0),
+        landmarkEnvelopes=[r for r in rules if 'candidate' in r['id'] or 'placeholder' in r['id']],
