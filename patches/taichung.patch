+#!/usr/bin/env python3
+"""Meaningful placement-contract fault checks, without changing native source."""
+from copy import deepcopy
+import json
+import unittest
+
+from build_library import build_catalog
+from library import Library, PrefabError
+
+
+class PrefabContractChecks(unittest.TestCase):
+    def setUp(self):
+        self.library=Library()
+
+    def place(self,**kwargs):
+        p=dict(id='test-home',prefab='building-rowhouse-compact',x=2,y=2)
+        p.update(kwargs)
+        return p
+
+    def test_all_native_assets_fit_current_tileset_and_palette_contract(self):
+        result=self.library.validate()
+        self.assertEqual(result['result'],'pass')
+        self.assertEqual(result['implementedPrefabs'],17)
+
+    def test_deterministic_builder_and_composition(self):
+        self.assertEqual(build_catalog(),self.library.catalog)
+        a=self.library.compose(20,20,[self.place()])
+        b=self.library.compose(20,20,[self.place()])
+        self.assertEqual(a,b)
+        self.assertTrue(all(e['status']=='dormant-reservation' for e in a['entrances']))
+        self.assertFalse(any((self.library.attr(w&0x3ff)&0x1ff)==0x69 for w in a['words']))
+
+    def test_building_cannot_block_protected_street(self):
+        with self.assertRaises(PrefabError):
+            self.library.compose(20,20,[self.place()],protected_paths=[(2,2)])
+
+    def test_clear_apron_cannot_be_placed_on_tree_or_water(self):
+        for blocked in (0x040e,0x112b,0x300d):
+            base=[0x3001]*400;base[6*20+3]=blocked
+            with self.assertRaises(PrefabError):
+                self.library.compose(20,20,[self.place()],base=base)
+            self.assertEqual(base[2*20+2],0x3001,'Failed composition changed caller grid')
+
+    def test_placement_context_is_checked_when_provided(self):
+        with self.assertRaises(PrefabError):
+            self.library.compose(20,20,[self.place(context='river')])
+
+    def test_modules_cannot_overlap_or_block_each_others_aprons(self):
+        for p in (self.place(id='overlap',x=3,y=3),self.place(id='apron-block',x=2,y=6)):
+            with self.assertRaises(PrefabError):
+                self.library.compose(20,20,[self.place(),p])
+
+    def test_unbound_entrance_never_activates_native_door(self):
+        binding={'warpIndex':0,'destMap':'MAP_TAICHUNG_OLD_STATION_GYM','destWarpId':1}
+        with self.assertRaises(PrefabError):
+            self.library.compose(20,20,[self.place(doors={'front':binding})])
+
+    def test_only_existing_paired_native_warp_can_activate(self):
+        p=self.place(x=31,y=61,doors={'front':{'warpIndex':0,'destMap':'MAP_TAICHUNG_OLD_STATION_GYM','destWarpId':1}})
+        result=self.library.compose(40,72,[p],source_map='MAP_TAICHUNG_OLD_CITY')
+        self.assertEqual(result['words'][64*40+32],0x043d)
+        self.assertEqual(result['entrances'][0]['status'],'active-verified-pair')
+        self.library.map_index()['MAP_TAICHUNG_OLD_STATION_GYM']['warp_events'][1]['dest_map']='MAP_TAICHUNG_GREENWAY'
+        with self.assertRaises(PrefabError):
+            self.library.compose(40,72,[p],source_map='MAP_TAICHUNG_OLD_CITY')
+
+    def test_dormant_catalog_rejects_warp_behavior(self):
+        catalog=deepcopy(self.library.catalog)
+        catalog['prefabs'][0]['words'][3][1]='0x043D'
+        with self.assertRaises(PrefabError):Library(catalog=catalog).validate()
+
+    def test_palette_outside_active_background_banks_is_rejected(self):
+        entries=list(self.library.metatiles[0]);index=0x175*8;entries[index]=(entries[index]&0x0fff)|0xf000
+        self.library.metatiles[0]=entries
+        with self.assertRaises(PrefabError):self.library.validate()
+
+    def test_out_of_bounds_placement_is_rejected(self):
+        with self.assertRaises(PrefabError):self.library.compose(6,6,[self.place()])
+
+
+if __name__=='__main__':unittest.main(verbosity=2)
