+    (output / "tiles.4bpp").write_bytes(bytes(pixels[i] | pixels[i+1] << 4 for pixels in graphics for i in range(0, 64, 2)))
+    (output / "foreground-tilemap-relative.bin").write_bytes(struct.pack("<320H", *tilemap))
+    (output / "foreground-metatiles-relative.json").write_text(json.dumps(metatiles, indent=2)+"\n")
+    text = "JASC-PAL\r\n0100\r\n16\r\n" + "".join(" ".join(map(str, color))+"\r\n" for color in palette)
+    (output / "07.pal").write_bytes(text.encode())
+    (output / "07.gbapal").write_bytes(struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in palette)))
+    metadata = {
+        "schemaVersion": 1, "landmarkId": "miyahara",
+        "status": "architecture approved; independent native candidate encoded; unmerged and unregistered",
+        "sourceArtifact": str(source), "sourceSha256": sha(source),
+        "recipe": {"alphaThreshold": 224, "sourceCropBox": list(crop_box), "preserveAspectRatio": True,
+                   "resampling": "nearest", "logicalSizePixels": list(SIZE), "visibleBodyTargetWidth": BODY_WIDTH,
+                   "workingResolution": list(working), "nativePixelClusterSize": PIXEL_STEP,
+                   "fittedSubjectSize": [value*PIXEL_STEP for value in subject_size],
+                   "subjectOffset": [value*PIXEL_STEP for value in offset], "transparentRightBufferPixels": SIZE[0]-BODY_WIDTH,
+                   "quantization": "nearest RGB squared distance to exact existing Station indices1..15; no dithering or new colors",
+                   "PillowVersion": PIL.__version__},
+        "palette": {"bank": 7, "source": str(STATION.relative_to(GAME)), "sourceSha256": sha(STATION),
+                    "exactSourcePalette16": [list(color) for color in palette],
+                    "usedOpaqueIndexes": sorted(set(indices)-{0}), "newColorCount": 0, "additionalPaletteBankCount": 0,
+                    "sharedPaletteMatchesStationExactly": indexed.getpalette()[:48] == station.getpalette()[:48]},
+        "native": {"unique8x8GraphicsBeforeAnyBankMerge": len(graphics), "uniqueIncludesTransparentGraphic": True,
+                   "sheetSlotsIncludingPadding": physical_count, "foregroundTilemapDimensions8x8": [20, 16],
+                   "foregroundMetatileCells": len(metatiles), "occupiedMetatileCells": occupied,
+                   "distinctForegroundMetatileDefinitions": len({tuple(mt) for mt in metatiles}),
+                   "occupiedRows": occupancy_rows, "relativeGraphicIndexes": True,
+                   "binaryAlpha": set(native.getchannel("A").get_flattened_data()) == {0, 255},
+                   "tilemapRoundTripPass": True, "mapOrCollisionGenerated": False},
+        "entrance": {"targetLocalMetatile": [5, 7], "targetLocalCellPixelsInclusive": [80, 112, 95, 127],
+                     "targetCellCenterPixels": [88, 120],
+                     "measurementMethod": "visually identified main portal; dark/glass indices2,3,4,11,12 inside x78..99,y116..123",
+                     "measuredDoorGlassBoxPixelsInclusive": portal_box, "measuredDoorGlassCenterPixels": portal_center,
+                     "centerDeltaFromTargetPixels": [portal_center[0]-88, portal_center[1]-120],
+                     "doorGlassFitsTargetCell": 80 <= portal_box[0] <= portal_box[2] <= 95 and 112 <= portal_box[1] <= portal_box[3] <= 127,
+                     "baselineDoor": [20, 52], "baselineApproach": [20, 53], "baselineArrival": [20, 55],
+                     "proposedBaselineOrigin": [15, 45], "paintedDoorIsNotActiveWarp": True},
+        "budget": {"mergedWithOldCity": False, "stationAndOtherLandmarksNotIncludedInCost": True,
+                   "secondaryCapacity": 384, "rootOwnsCombinedPrimarySecondaryAndColorBudget": True,
