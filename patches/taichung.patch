+        "files": {"indexed": "candidate-indexed.png", "rgba": "candidate-native.png", "preview": "preview-4x.png",
+                  "palette": "09.pal", "graphics4bpp": "tiles.4bpp", "foregroundTilemapRelative": "foreground-tilemap-relative.bin"},
