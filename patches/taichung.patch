+static void FieldCB_ReturnFromEncounterMenu(void)
+{
+    LockPlayerFieldControls();
+    Overworld_PlaySpecialMapMusic();
+    FadeInFromBlack();
+    CreateTask(Task_ReturnFromEncounterMenu, 10);
+}
