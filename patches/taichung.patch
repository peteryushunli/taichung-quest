+static bool8 Relocated(const u8 (*table)[4], unsigned count, s16 *x, s16 *y)
+{
+    unsigned i;
+    for (i = 0; i < count; i++)
+        if (*x == table[i][0] && *y == table[i][1])
+        {
+            *x = table[i][2]; *y = table[i][3];
+            return TRUE;
+        }
+    return FALSE;
+}
+
+// The test-side historical chain of an older explicit position, from the case tables above, in
+// released (v9) coordinates; v10 comes after it.
+static void ExpectHistorical(unsigned version, unsigned mapNum, s16 *x, s16 *y)
+{
+    unsigned i;
+    if (mapNum == MAP_NUM(MAP_TAICHUNG_OLD_CITY) && version < 3 && !Relocated(sV3Cases, COUNT(sV3Cases), x, y) && version < 2)
+        for (i = 0; i < COUNT(sV1Cases); i++)
+            if (*x == sV1Cases[i][0] && *y == sV1Cases[i][1]) { *x = 30; *y = 66; break; }
+    if (mapNum == MAP_NUM(MAP_TAICHUNG_GREENWAY))
+    {
+        if (version < 5) Relocated(sGreenwayV5Cases, COUNT(sGreenwayV5Cases), x, y);
+        if (version < 6) Relocated(sGreenwayV6Cases, COUNT(sGreenwayV6Cases), x, y);
+    }
+    if (mapNum == MAP_NUM(MAP_TAICHUNG_XITUN))
+    {
+        if (version < 4) Relocated(sXitunV4Cases, COUNT(sXitunV4Cases), x, y);
+        if (version < 7) Relocated(sXitunV7Cases, COUNT(sXitunV7Cases), x, y);
+        if (version < 8) Relocated(sXitunV8Cases, COUNT(sXitunV8Cases), x, y);
+        if (version < 9 && *x >= 0 && *y >= 0 && *x < 40 && *y < 64 && sV9Solid[*y][*x]) { *x = 12; *y = 35; }
+    }
+}
+
+// An age gate proven above stays observable after v10: a skipped repair and its replay never share a tile.
+static void AssertV10Apart(unsigned mapNum, const u8 (*table)[4], unsigned count)
+{
+    unsigned i;
+    for (i = 0; i < count; i++)
+    {
+        s16 x = table[i][0], y = table[i][1], rx = table[i][2], ry = table[i][3];
+        ExpectV10(mapNum,&x,&y); ExpectV10(mapNum,&rx,&ry);
+        assert(x != rx || y != ry);
+    }
+}
