+#!/usr/bin/env python3
+"""Read-only capacity audit for a possible scene-specialized OldCity primary.
+
+Writes only the audit JSON. It does not create a tileset, alter General, remap a
+metatile, assign a bank, or assert that arbitrary runtime mutations are safe.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
