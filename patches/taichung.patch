+#!/usr/bin/env python3
+"""Combine frozen Fengjia and approved Maple semantics in NEW proposal files.
+
+Only xitun-final-native/final-scene is written. Packed graphics, palettes,
+Fengjia's prior variant, registered maps/C and saved games remain unchanged.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+import tempfile
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+from check_old_core import Files, Bank, resolved_folder, load_native
+from analyze_theater_cohort import visible_cells, bounds
+
+ROOT = Path(__file__).resolve().parents[3]
+DATA = "data/taichung/landmarks/xitun-final-native"
+OUT = ROOT / DATA / "final-scene"
+PRIMARY = "data/tilesets/primary/taichung_xitun_private"
+PACKED = "data/tilesets/secondary/taichung_xitun_final"
+FENGJIA_BANK = DATA+"/fengjia-only-bank"
+MAPLE = "data/taichung/landmarks/maple-garden/placement-v2.json"
+MAPLE_SHA = "562969d29003c2353dae6e7fcf9fdc95b664295efb72b26144eabab401d62f16"
+BASE = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
+CITY = "c1bc28900f0ae46f9a15d74d4089317c66a28b00"
+MID = "MAP_TAICHUNG_XITUN"
+COVERED, DOOR = 0x20000000, 0x043D
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def values(raw, kind="H"):
+    return list(struct.unpack("<"+str(len(raw)//struct.calcsize(kind))+kind, raw))
+
+
+def binary(words, kind="H"):
+    return struct.pack("<"+str(len(words))+kind, *words)
+
+
+def rect_cells(rect):
+    x0, y0, x1, y1 = rect
+    return {(x, y) for y in range(y0, y1+1) for x in range(x0, x1+1)}
+
+
+class SceneFiles(Files):
+    def __init__(self, output):
+        super().__init__(ROOT)
+        self.output = output
+
+    def read(self, path):
+        for name in ("metatiles.bin", "metatile_attributes.bin"):
+            if str(path) == PACKED+"/"+name:
+                return (self.output / name).read_bytes()
+        return super().read(path)
+
+
+def native_map(native, data, layout, cells, border, attrs):
+    m = native.Map.__new__(native.Map)
+    m.data, m.layout, m.id = data, layout, data["id"]
+    m.width, m.height = layout["width"], layout["height"]
+    m.cells, m.border, m.attributes = cells, border, attrs
+    m.actors = {(o["x"], o["y"]) for o in data.get("object_events", [])}
+    m.signs = {(o["x"], o["y"]) for o in data.get("bg_events", []) if o.get("type") == "sign"}
+    m.obstacles = m.actors | m.signs
+    return m
+
+
+def render(bank, grid, width, box, scale):
+    x0, y0, x1, y1 = box
+    image = Image.new("RGB", ((x1-x0)*16, (y1-y0)*16))
+    for y in range(y0, y1):
+        for x in range(x0, x1):
+            tile = Image.new("RGB", (16, 16))
+            tile.putdata(bank.render(grid[y*width+x] & 1023))
+            image.paste(tile, ((x-x0)*16, (y-y0)*16))
+    return image.resize((image.width*scale, image.height*scale), Image.Resampling.NEAREST)
+
+
+def compile_scene(output=OUT, verify_rebuild=True):
+    data = ROOT / DATA
+    pack = json.loads((data / "pack-plan.json").read_text())
+    fengjia = json.loads((data / "fengjia-placement.json").read_text())
+    maple_raw = (ROOT / MAPLE).read_bytes()
+    assert digest(maple_raw) == MAPLE_SHA, "Maple semantics changed after Root's frozen v2 decision"
+    maple = json.loads(maple_raw)
+    watched = {path: expected for path, expected in pack["outputFilesSha256"].items()}
+    watched.update({DATA+"/"+name: expected for name, expected in fengjia["outputSha256"].items()})
+    watched[MAPLE] = MAPLE_SHA
+    for name in ("pack-plan.json", "fengjia-placement.json"):
+        watched[DATA+"/"+name] = digest((data / name).read_bytes())
+    assert all(digest((ROOT / path).read_bytes()) == expected for path, expected in watched.items())
+    frozen, city = Files(ROOT, BASE), Files(ROOT, CITY)
+    layouts = {l["id"]: l for l in city.json("data/layouts/layouts.json")["layouts"] if "id" in l}
+    own_data = city.json("data/maps/TaichungXitun/map.json")
+    layout = layouts[own_data["layout"]]
+    baseline_raw = frozen.read(layout["blockdata_filepath"])
+    assert baseline_raw == city.read(layout["blockdata_filepath"])
+    assert digest(baseline_raw) == fengjia["sourceMapSha256"]
+    original, grid = values(baseline_raw), values((data / "fengjia-map.bin").read_bytes())
+    assert digest(binary(grid)) == fengjia["mapSha256"]
+    width, height = layout["width"], layout["height"]
+    assert (width, height) == (40, 64)
+    p, _ = resolved_folder(city, layout["primary_tileset"])
+    s, _ = resolved_folder(city, layout["secondary_tileset"])
+    old_bank = Bank(city, p, s)
+    prior = Bank(Files(ROOT), PRIMARY, FENGJIA_BANK)
+    definitions, attributes = prior.defs[1].copy(), prior.attrs[1].copy()
+    retirement = maple["retiredGeometry"]
+    retired = rect_cells(retirement["oldHouseInclusive"]) | rect_cells(retirement["oldPondInclusive"])
+    restores = retirement["underlayRestorations"]
+    assert {(item["x"], item["y"]) for item in restores} == retired and len(restores) == 108
+    for item in restores:
+        x, y = item["x"], item["y"]
+        assert grid[y*width+x] == int(item["sourceWord"], 0), f"Retirement conflict at{x},{y}"
+        word = int(item["underlayWord"], 0)
+        assert word in (0x3001, 0x3175)
+        grid[y*width+x] = word
+    origin = tuple(maple["candidate"]["originMapMetatile"])
+    assert origin == (10, 27) and maple["portalAdaptation"]["selectedLocalMetatile"] == [2, 5]
+    rows, meanings = maple["semanticMask"]["rows"], maple["semanticMask"]["meanings"]
+    assert len(rows) == 7 and all(len(row) == 10 for row in rows)
+    counts = Counter("".join(rows))
+    assert sum(count for key, count in counts.items() if meanings[key]["walkable"]) == 49
+    assert sum(count for key, count in counts.items() if not meanings[key]["walkable"]) == 21
+    landmark = next(item for item in pack["landmarks"] if item["id"] == "maple-garden")
+    assert landmark["sizePixels"] == [160, 112] and landmark["occupiedCells"] == 66
+    art = Image.open(ROOT / landmark["input"])
+    assert digest((ROOT / landmark["input"]).read_bytes()) == landmark["inputSha256"]
+    ids = landmark["localMetatileIds"]
+    cells, corner_cells = [], []
+    for y, row in enumerate(rows):
+        for x, semantic in enumerate(row):
+            gx, gy = origin[0]+x, origin[1]+y
+            walkable = meanings[semantic]["walkable"]
+            assert maple["semanticMask"]["collisionRows"][y][x] == ("0" if walkable else "1")
+            ground_id = 0x175 if semantic in "PRKD" else 1
+            ground = old_bank.entries(ground_id)
+            assert ground[4:] == [0]*4
+            n = ids.get(f"{x},{y}")
+            if n is None:
+                assert semantic in ("G", "P") and walkable
+                word = 0x3000 | ground_id
+                corner_cells.append([x, y])
+            else:
+                assert 925 <= n <= 990
+                offset = (n-640)*8
+                assert definitions[offset:offset+4] == [0]*4
+                definitions[offset:offset+4] = ground[:4]
+                attributes[n-640] = COVERED if walkable or semantic == "D" else 0
+                word = n | (0x3000 if walkable else 0x400)
+            if semantic == "D":
+                assert (x, y) == (2, 5) and (gx, gy) == (12, 32)
+                word = DOOR
+            grid[gy*width+gx] = word
+            cells.append({"local": [x, y], "global": [gx, gy], "semantic": semantic,
+                          "walkableByAuthoredMask": walkable, "word": word, "artMetatileId": n,
+                          "underlayGeneralMetatileId": ground_id, "nativeDoorOverridesRaster": semantic == "D"})
+    assert len(corner_cells) == 4
+    assert original[32*width+12] == grid[32*width+12] == DOOR
+    # Root's explicit native landing keeps the old approach word and makes the
+    # paved step directly below the door readable. The source raster and the
+    # unused local2,6 art template remain exact in the bank.
+    approach = next(cell for cell in cells if cell["local"] == [2, 6])
+    assert approach["global"] == [12, 33] and approach["semantic"] == "G"
+    assert original[33*width+12] == 0x3175
+    grid[33*width+12] = original[33*width+12]
+    approach["word"] = 0x3175
+    approach["nativeApproachOverridesRaster"] = True
+    approach["actualMapGroundOverrideMetatileId"] = 0x175
+    approach["unusedRasterTemplateUnchanged"] = True
+    # Fengjia is carried forward byte-for-byte, including its exact native door.
+    fengjia_rect = rect_cells(fengjia["retiredInclusive"])
+    fengjia_grid = values((data / "fengjia-map.bin").read_bytes())
+    assert all(grid[y*width+x] == fengjia_grid[y*width+x] for x, y in fengjia_rect)
+    assert definitions[:(925-640)*8] == prior.defs[1][:(925-640)*8]
+    assert attributes[:925-640] == prior.attrs[1][:925-640]
+    assert len(attributes) == 351 and len(definitions) == 351*8
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "baseline-map.bin").write_bytes(baseline_raw)
+    (output / "map.bin").write_bytes(binary(grid))
+    (output / "metatiles.bin").write_bytes(binary(definitions))
+    (output / "metatile_attributes.bin").write_bytes(binary(attributes, "I"))
+    assert (output / "baseline-map.bin").read_bytes() == baseline_raw
+    assert values((output / "map.bin").read_bytes()) == grid
+    assert values((output / "metatiles.bin").read_bytes()) == definitions
+    assert values((output / "metatile_attributes.bin").read_bytes(), "I") == attributes
+    actual = Bank(SceneFiles(output), PRIMARY, PACKED)
+    assert all(actual.render(n) == old_bank.render(n) and actual.attr(n) == old_bank.attr(n) for n in range(640, 879))
+    assert all(actual.entries(n) == prior.entries(n) and actual.attr(n) == prior.attr(n) for n in range(879, 925))
+    for cell in cells:
+        if cell["artMetatileId"] is None or cell["semantic"] == "D":
+            continue
+        x, y = cell["local"]
+        layer = actual.layer(cell["artMetatileId"], 1)
+        for py in range(16):
+            for px in range(16):
+                index = art.getpixel((x*16+px, y*16+py))
+                assert layer[py*16+px] == (index, actual.palettes[8][index])
+    native = load_native(ROOT)
+    assert (ROOT / "tools/taichung/validate_city.py").read_bytes() == city.read("tools/taichung/validate_city.py")
+    contract = city.json("docs/taichung-city-contract.json")
+    geometry = native.Validator.__new__(native.Validator)
+    geometry.source, geometry.contract, geometry.errors = ROOT, contract, []
+    geometry.maps, geometry.tilesets = {}, {}
+    geometry.district_ids = {d["map"] for d in contract["districts"]}
+    wanted = geometry.district_ids | {l["gymMap"] for l in contract["landmarks"]}
+    groups = city.json("data/maps/map_groups.json")
+    by_id = {}
+    for group in groups["group_order"]:
+        for name in groups[group]:
+            if name.startswith("Taichung"):
+                item = city.json(f"data/maps/{name}/map.json")
+                by_id[item["id"]] = item
+    banks = {}
+    for mid in sorted(wanted):
+        item = by_id[mid]
+        item_layout = layouts[item["layout"]]
+        p, _ = resolved_folder(city, item_layout["primary_tileset"])
+        s, _ = resolved_folder(city, item_layout["secondary_tileset"])
+        if (p, s) not in banks:
+            banks[p, s] = Bank(city, p, s)
+        bank = actual if mid == MID else banks[p, s]
+        words = grid if mid == MID else city.words(item_layout["blockdata_filepath"])
+        geometry.maps[mid] = native_map(native, item, item_layout, words, city.words(item_layout["border_filepath"]), bank.attrs)
+    geometry.run()
+    assert not geometry.errors, geometry.errors
+    proposed = geometry.maps[MID]
+    old_geometry = native_map(native, own_data, layout, original, city.words(layout["border_filepath"]), old_bank.attrs)
+    for cell in cells:
+        x, y = cell["global"]
+        assert proposed.walkable(x, y) == cell["walkableByAuthoredMask"]
+        if cell["walkableByAuthoredMask"]:
+            assert proposed.elevation(x, y) == 3 and proposed.behavior(x, y) == 0
+            assert (MID, x, y) in geometry.distances
+            if cell["artMetatileId"] is not None:
+                assert actual.attr(cell["artMetatileId"]) == COVERED
+        elif cell["semantic"] != "D":
+            assert proposed.elevation(x, y) == 0 and proposed.cell(x, y) >> 10 & 3 == 1
+            assert actual.attr(cell["artMetatileId"]) == 0
