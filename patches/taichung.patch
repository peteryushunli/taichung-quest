+static void TestMapleV9Migration(void)
+{
+    struct SaveBlock1 before;
+    unsigned version, x, y, changed, kept = 0, map, i, pending;
+    static const u8 chains[][2] = {{16,29}, {16,30}, {18,32}};
+    static const s8 warpIds[] = {-3, 0, 1, 2};
+    for (version = 1; version <= 8; version++)
+    {
+        changed = 0;
+        for (y = 0; y < 64; y++)
+            for (x = 0; x < 40; x++)
+            {
+                if (!sV9Solid[y][x]) continue;
+                Versioned(version); InXitun(x,y); before = sSave;
+                TaichungSaveUpgradeOnContinue(); AssertXitunAfter(version,x,y);
+                if (version == 8) AssertXitunWarp(12,35);
+                assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+                // Pending explicit target is repaired from an unrelated source map.
+                Versioned(version); PendingXitunTarget(x,y); before = sSave;
+                TaichungSaveUpgradeOnContinue(); AssertXitunAfter(version,x,y);
+                if (version == 8) AssertXitunWarp(12,35);
+                assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+                // Native warp IDs always take priority over these ignored XYs.
+                for (i = 0; i < COUNT(warpIds); i++)
+                {
+                    Versioned(version); InXitun(11,33); PendingXitunTarget(x,y);
+                    sSave.continueGameWarp.warpId = warpIds[i]; before = sSave;
+                    TaichungSaveUpgradeOnContinue();
+                    assert(sHasContinueWarp && sWarpRequests == 0);
+                    assert(memcmp(&before.continueGameWarp,&sSave.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+                    AssertSamePartyAndVars(&before);
+                }
+                changed++;
+            }
+        assert(changed == 44);
+    }
+    // All three historical v7 fallbacks now need the final v9 repair, after
+    // every older table, for both saved field positions and pending targets.
+    for (version = 1; version <= 6; version++)
+        for (i = 0; i < COUNT(chains); i++)
+        {
+            Versioned(version); InXitun(chains[i][0],chains[i][1]); before = sSave;
+            TaichungSaveUpgradeOnContinue(); AssertXitunWarp(12,35);
+            assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+            Versioned(version); PendingXitunTarget(chains[i][0],chains[i][1]); before = sSave;
+            TaichungSaveUpgradeOnContinue(); AssertXitunWarp(12,35);
+            assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+        }
+    // Every retained v8 walking tile refreshes in place; only those44 move.
+    for (i = 0; i < COUNT(sXitunV8SafeRuns); i++)
+        for (x = sXitunV8SafeRuns[i][1]; x <= sXitunV8SafeRuns[i][2]; x++)
+        {
+            y = sXitunV8SafeRuns[i][0];
+            if (sV9Solid[y][x]) continue;
+            Versioned(8); InXitun(x,y); before = sSave;
+            TaichungSaveUpgradeOnContinue(); AssertXitunWarp(x,y);
+            assert(sWarpRequests == 1); AssertSamePartyAndVars(&before); kept++;
+        }
+    assert(kept == 1367 - 44);
+    // The one v9 cache invalidation is Xitun only, and v10 reloads every outdoor district
+    // (TestReworkV10Migration covers them), so rooms and temple halls keep theirs.
+    // Old City North(18) now refreshes at v11. No version8 save may fall into
+    // prototype recognition or overwrite its own heal checkpoint.
+    for (map = MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM); map <= 18; map++)
+    {
+        if (map == MAP_NUM(MAP_TAICHUNG_NANTUN_NORTH) || map == MAP_NUM(MAP_TAICHUNG_NANTUN_WANHE)
+            || map == MAP_NUM(MAP_TAICHUNG_OLD_CITY_NORTH)) continue;
+        Versioned(8); InOldCity(11,33); sSave.location.mapNum = map;
+        V(0x40FC) = SPECIES_PIKACHU; before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(!sHasContinueWarp && sWarpRequests == 0);
+        assert(memcmp(&before.continueGameWarp,&sSave.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        AssertSamePartyAndVars(&before);
+        // An unrelated pending return is unchanged even if the source is blocked.
+        Versioned(8); InXitun(11,33); PendingXitunTarget(11,33);
+        sSave.continueGameWarp.mapNum = map; before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(sHasContinueWarp && sWarpRequests == 0);
+        assert(memcmp(&before.continueGameWarp,&sSave.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        AssertSamePartyAndVars(&before);
+    }
+    Versioned(8); InXitun(11,33); PendingXitunTarget(12,35); before = sSave;
+    TaichungSaveUpgradeOnContinue(); AssertXitunWarp(12,35);
+    assert(sWarpRequests == 0); AssertSamePartyAndVars(&before);
+    // v9 already owns the Maple repair: a (synthetic) v9 save on one of its origins takes only v10,
+    // which must stay apart from a replayed (12,35).
+    for (pending = 0; pending < 2; pending++)
+        for (y = 0; y < 64; y++)
+            for (x = 0; x < 40; x++)
+            {
+                s16 ax = x, ay = y, rx = 12, ry = 35;
+                if (!sV9Solid[y][x]) continue;
+                Versioned(9);
+                if (pending) PendingXitunTarget(x,y); else InXitun(x,y);
+                before = sSave; TaichungSaveUpgradeOnContinue();
+                if (pending) AssertPendingV10(&before.continueGameWarp); else AssertXitunWarp(x,y);
+                assert(sWarpRequests == (pending ? 0u : 1u)); AssertSamePartyAndVars(&before);
+                ExpectV10(MAP_NUM(MAP_TAICHUNG_XITUN),&ax,&ay); ExpectV10(MAP_NUM(MAP_TAICHUNG_XITUN),&rx,&ry);
+                assert(ax != rx || ay != ry);
+            }
+    // Current/future saves remain byte-exact, even on a formerly invalid origin, with no, a native or an
+    // explicit pending return.
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+        for (pending = 0; pending < 3; pending++)
+            for (y = 0; y < 64; y++)
+                for (x = 0; x < 40; x++)
+                {
+                    if (!sV9Solid[y][x]) continue;
+                    Versioned(version); InXitun(x,y);
+                    sHasContinueWarp = pending != 0;
+                    sSave.continueGameWarp = sSave.location;
+                    sSave.continueGameWarp.x = x; sSave.continueGameWarp.y = y;
+                    if (pending == 2) sSave.continueGameWarp.warpId = -1;
+                    before = sSave; TaichungSaveUpgradeOnContinue();
+                    assert(memcmp(&sSave,&before,sizeof(sSave)) == 0);
+                    assert(sWarpRequests == 0 && sVariableWrites == 0 && sChallengeCancels == 1 && sHasContinueWarp == (pending != 0));
+                }
+}
