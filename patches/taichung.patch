new file mode 100644
index 0000000..e7e9152
--- /dev/null
+++ b/tools/taichung/kit/install_city_kit.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Install the city kit into the three private Taichung primaries.
+
+Each primary is rebuilt from BASE (the live native source) plus the kit, so
+reruns are byte-identical: kit tiles at the same tile slots, kit metatile
+definitions and attributes at the same IDs, in all three. Nothing else in a
+primary changes, and no secondary, map or palette is touched. Writes the
+three primaries and data/taichung/city-kit/kit.json (names, IDs, slots and
+output hashes), which check_city_kit.py pins.
+
+  install_city_kit.py           write the primaries and kit.json
+  install_city_kit.py --check   exit 1 unless the tree already matches
+"""
+import argparse
+import hashlib
+import importlib.util
+from io import BytesIO
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "6366b9e5c037647ce4d2a007efa3d3dfbedcdb48"
+PRIMARIES = ("data/tilesets/primary/taichung_xitun_private", "data/tilesets/primary/taichung_greenway_private",
+             "data/tilesets/primary/taichung_old_core")
+CONTRACT = "data/taichung/city-kit/kit.json"
+_spec = importlib.util.spec_from_file_location("city_kit_art", Path(__file__).resolve().parent / "city_kit_art.py")
+art = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(art)
+
+
+def git(source, path):
+    return subprocess.run(["git", "-C", str(source), "show", f"{BASE}:{path}"], check=True, capture_output=True).stdout
+
+
+def build(read):
+    """{path: bytes} for the three primaries, from read(path) at BASE."""
+    tiles, slots, entries = art.tiles(), art.slots(), art.encoded()
+    out = {}
+    for folder in PRIMARIES:
+        image = Image.open(BytesIO(read(f"{folder}/tiles.png")))
+        image.load()
+        assert image.mode == "P" and image.size == (128, 320), f"{folder}: unexpected tile sheet"
+        for name, slot in slots.items():
+            for y, row in enumerate(tiles[name]):
+                for x, value in enumerate(row):
+                    image.putpixel((slot % 16 * 8 + x, slot // 16 * 8 + y), value)
+        png = BytesIO()
+        image.save(png, format="PNG", optimize=False)
+        defs = bytearray(read(f"{folder}/metatiles.bin"))
+        attrs = bytearray(read(f"{folder}/metatile_attributes.bin"))
+        for metatile, words, attribute in entries:
+            defs[metatile * 16:metatile * 16 + 16] = struct.pack("<8H", *words)
+            attrs[metatile * 4:metatile * 4 + 4] = struct.pack("<I", attribute)
+        out[f"{folder}/tiles.png"] = png.getvalue()
+        out[f"{folder}/metatiles.bin"] = bytes(defs)
+        out[f"{folder}/metatile_attributes.bin"] = bytes(attrs)
+    return out
+
+
+def contract(outputs):
+    ids = art.ids()
+    return {
+        "baseCommit": BASE,
+        "primaries": [folder.rsplit("/", 1)[1] for folder in PRIMARIES],
+        "palettes": art.PALETTE_NOTES,
+        "composesWith": {"sidewalk": f"0x{art.SIDEWALK:03X}", "grass": f"0x{art.GRASS:03X}",
+                         "leafTiles": [f"0x{tile:03X}" for tile in art.LEAF_TILES]},
+        "water": {kind: f"0x{first:03X}-0x{first + 3:03X}" for kind, (first, _) in art.WATER.items()},
+        "tileSlots": {name: f"0x{slot:03X}" for name, slot in art.slots().items()},
+        "spareTileSlots": [f"0x{slot:03X}" for slot in art.TILE_SLOTS[len(art.tiles()):]],
+        "metatiles": {name: f"0x{metatile:03X}" for name, metatile in ids.items()},
+        "metatileRange": f"0x{min(ids.values()):03X}-0x{max(ids.values()):03X}",
+        "outputs": {path: hashlib.sha256(data).hexdigest() for path, data in sorted(outputs.items())},
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    outputs = build(lambda path: git(args.source, path))
+    text = json.dumps(contract(outputs), indent=1) + "\n"
+    files = {**outputs, CONTRACT: text.encode()}
+    if args.check:
+        stale = [path for path, data in files.items() if not (args.source / path).exists() or (args.source / path).read_bytes() != data]
+        print("\n".join(stale) or "city kit installed")
+        raise SystemExit(1 if stale else 0)
+    for path, data in files.items():
+        (args.source / path).parent.mkdir(parents=True, exist_ok=True)
+        (args.source / path).write_bytes(data)
+    print(f"{len(art.tiles())} tiles at {len(art.slots())} slots, {len(art.ids())} metatiles {contract(outputs)['metatileRange']}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung/kit/install_xitun.py b/tools/taichung/kit/install_xitun.py
new file mode 100644
index 0000000..9af07f9
--- /dev/null
+++ b/tools/taichung/kit/install_xitun.py
@@ -0,0 +1,248 @@
+#!/usr/bin/env python3
+"""Install Xitun on the city-rework master plan as the native map (phase 2b,
+with the 2026-11-09 fill pass and raised highway).
+
+Everything is rebuilt from BASE (claude/city-rework 3634df4: today's live 40x64
+Xitun, with the Maple Garden's registered collision (save v9), and the city
+kit 842e9da installed) and
+data/taichung/xitun-rework/fill.json (the plan's cells and the buildings on
+its lots), so reruns are byte-identical:
+  - data/layouts/TaichungXitun/map.bin: draft_xitun.draft()'s 45x69 words;
+  - data/maps/TaichungXitun/map.json: every event moved by SHIFT, except the
+    Maple Garden sign, which moves to the park path's mouth
+    (draft_xitun.SIGN_MOVES), and the Greenway and Nantun North connections at
+    the master plan's offsets;
+  - Xitun's entries in three shared files: its layout (45x69, same tilesets and
+    border) in layouts.json; its district and landmark points, moved the same
+    way, and the Maple Garden park's tall grass as its habitats (HABITATS) in
+    docs/taichung-city-contract.json; and a land table for that grass in
+    src/data/wild_encounters.json.
+No other entry of a shared file changes. data/taichung/xitun-rework/install.json
+records BASE, the fill, the shift, the offsets, today's walkable cells the new
+map blocks (for the save migration) and the output hashes, which
+check_xitun_rework.py pins.
+
+  install_xitun.py [--plan masterplan.json]   write (--plan cross-checks PLAN)
+  install_xitun.py --check                    exit 1 unless the tree matches
+"""
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "3634df42a776a602f955046213bf8d569002f8e1"
+MID, LAYOUT_ID = "MAP_TAICHUNG_XITUN", "LAYOUT_TAICHUNG_XITUN"
+MAP, MAP_JSON = "data/layouts/TaichungXitun/map.bin", "data/maps/TaichungXitun/map.json"
+LAYOUTS, CONTRACT, ENCOUNTERS = "data/layouts/layouts.json", "docs/taichung-city-contract.json", "src/data/wild_encounters.json"
+RECORD = "data/taichung/xitun-rework/install.json"
+FILL = "data/taichung/xitun-rework/fill.json"
+# artifacts/city-rework/masterplan.json "districts": plan rects in today's world
+# tiles (x0, y0, x1, y1).
+PLAN = {"xitun": (-5, -5, 40, 64), "greenway": (40, -5, 80, 104), "north": (-5, 64, 40, 104)}
+NEIGHBOURS = {"MAP_TAICHUNG_GREENWAY": ("greenway", "right"), "MAP_TAICHUNG_NANTUN_NORTH": ("north", "down")}
+TODAY_ORIGIN = (0, 0)
+SHIFT = (TODAY_ORIGIN[0] - PLAN["xitun"][0], TODAY_ORIGIN[1] - PLAN["xitun"][1])
+SIZE = (PLAN["xitun"][2] - PLAN["xitun"][0], PLAN["xitun"][3] - PLAN["xitun"][1])
+EVENTS = ("object_events", "warp_events", "coord_events", "bg_events")
+POINTS = ("entrance", "approach", "arrival", "sign")
+# The Maple Garden park's tall grass (fill.json's G cells) in four disjoint
+# rectangles, world tiles (x0, y0, x1, y1) inclusive. It replaces today's Fengjia
+# pocket garden as Xitun's only tall grass.
+HABITATS = {"maple-garden-park-north": (5, 26, 22, 26), "maple-garden-park-west": (5, 27, 9, 36),
+            "maple-garden-park-east": (20, 27, 22, 33), "maple-garden-park-south": (10, 36, 19, 36)}
+# Its encounters: a small early table, rate 12, levels 2-5.
+LAND_MONS = [("PIDGEY", 2, 3), ("RATTATA", 2, 3), ("PIDGEY", 3, 4), ("RATTATA", 3, 4), ("PIDGEY", 3, 4), ("RATTATA", 3, 4),
+             ("PIDGEY", 4, 4), ("RATTATA", 4, 4), ("PIDGEY", 4, 5), ("RATTATA", 4, 5), ("PIDGEY", 5, 5), ("RATTATA", 5, 5)]
+ENCOUNTER = {"map": MID, "base_label": "sTaichungXitun",
+             "land_mons": {"encounter_rate": 12, "mons": [{"min_level": lo, "max_level": hi, "species": f"SPECIES_{name}"}
+                                                          for name, lo, hi in LAND_MONS]}}
+ENCOUNTER_AFTER = "MAP_TAICHUNG_OLD_CITY"
+_spec = importlib.util.spec_from_file_location("draft_xitun", Path(__file__).resolve().parent / "draft_xitun.py")
+draft_xitun = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(draft_xitun)
+
+
+def git(source, path, rev=BASE):
+    return subprocess.run(["git", "-C", str(source), "show", f"{rev}:{path}"], check=True, capture_output=True).stdout
+
+
+def dump(value):
+    return (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode()
+
+
+def moved(point):
+    out = dict(point)
+    out["x"], out["y"] = point["x"] + SHIFT[0], point["y"] + SHIFT[1]
+    return out
+
+
+def moved_sign(point):
+    """A sign moved by SHIFT, or to its new cell (draft_xitun.SIGN_MOVES)."""
+    x, y = draft_xitun.SIGN_MOVES.get((point["x"], point["y"]), (point["x"], point["y"]))
+    return moved({**point, "x": x, "y": y})
+
+
+def offset(neighbour, direction):
+    """Connection offset along the shared edge: the neighbour's plan origin less Xitun's."""
+    axis = 1 if direction in ("left", "right") else 0
+    return PLAN[neighbour][axis] - PLAN["xitun"][axis]
+
+
+def connections(base):
+    out = []
+    for c in base:
+        c = dict(c)
+        if c["map"] in NEIGHBOURS:
+            neighbour, direction = NEIGHBOURS[c["map"]]
+            assert c["direction"] == direction, c
+            c["offset"] = offset(neighbour, direction)
+        out.append(c)
+    return out
+
+
+def map_json(base):
+    out = copy.deepcopy(base)
+    for key in EVENTS:
+        out[key] = [(moved_sign if key == "bg_events" else moved)(e) for e in base[key]]
+    out["connections"] = connections(base["connections"])
+    return out
+
+
+def layout_entry(base_layouts):
+    entry = dict(next(l for l in base_layouts["layouts"] if l.get("id") == LAYOUT_ID))
+    entry["width"], entry["height"] = SIZE
+    return entry
+
+
+def contract_entries(base_contract):
+    """(district, {landmark id: entry}, [habitat entries]) for Xitun."""
+    district = copy.deepcopy(next(d for d in base_contract["districts"] if d["map"] == MID))
+    district["width"], district["height"] = SIZE
+    district["worldOrigin"] = list(PLAN["xitun"][:2])
+    district["connections"] = connections(district["connections"])
+    landmarks = {}
+    for l in base_contract["landmarks"]:
+        if l["exteriorMap"] != MID:
+            continue
+        l = copy.deepcopy(l)
+        for key in POINTS:
+            l[key] = (moved_sign if key == "sign" else moved)(l[key])
+        x0, y0, x1, y1 = l["footprint"]
+        l["footprint"] = [x0 + SHIFT[0], y0 + SHIFT[1], x1 + SHIFT[0], y1 + SHIFT[1]]
+        landmarks[l["id"]] = l
+    habitats = [{"id": hid, "map": MID, "rect": [x0 + SHIFT[0], y0 + SHIFT[1], x1 + SHIFT[0], y1 + SHIFT[1]],
+                 "terrain": "tall-grass"} for hid, (x0, y0, x1, y1) in HABITATS.items()]
+    return district, landmarks, habitats
+
+
+def put_layout(layouts, entry):
+    out = copy.deepcopy(layouts)
+    out["layouts"] = [entry if l.get("id") == LAYOUT_ID else l for l in out["layouts"]]
+    return out
+
+
+def put_contract(contract, district, landmarks, habitats):
+    out = copy.deepcopy(contract)
+    out["districts"] = [district if d["map"] == MID else d for d in out["districts"]]
+    out["landmarks"] = [landmarks.get(l["id"], l) if l["exteriorMap"] == MID else l for l in out["landmarks"]]
+    if "habitatRegions" in out:
+        # Xitun's run of habitats is replaced where its first one stood.
+        regions = out["habitatRegions"]
+        at = next((i for i, h in enumerate(regions) if h["map"] == MID), len(regions))
+        rest = [h for h in regions if h["map"] != MID]
+        out["habitatRegions"] = rest[:at] + list(habitats) + rest[at:]
+    return out
+
+
+def put_encounter(encounters, entry):
+    """Xitun's table set to entry (after Old City's), or removed when entry is None."""
+    out, placed = copy.deepcopy(encounters), 0
+    for group in out["wild_encounter_groups"]:
+        rows = [e for e in group["encounters"] if e["map"] != MID]
+        at = next((i for i, e in enumerate(rows) if e["map"] == ENCOUNTER_AFTER), None)
+        if entry is not None and at is not None:
+            rows.insert(at + 1, entry)
+            placed += 1
+        group["encounters"] = rows
+    assert entry is None or placed == 1, f"{ENCOUNTER_AFTER} is in {placed} encounter groups"
+    return out
+
+
+def build(read_base, read_now):
+    """{path: bytes}: Xitun's own files from BASE and the tree's fill.json, and
+    the current shared files with only Xitun's entries rebuilt from BASE."""
+    words = draft_xitun.draft(read=read_base, fill=json.loads(read_now(FILL)))[0]
+    assert len(words) == SIZE[0] * SIZE[1]
+    base_contract = json.loads(read_base(CONTRACT))
+    return {
+        MAP: struct.pack(f"<{len(words)}H", *words),
+        MAP_JSON: dump(map_json(json.loads(read_base(MAP_JSON)))),
+        LAYOUTS: dump(put_layout(json.loads(read_now(LAYOUTS)), layout_entry(json.loads(read_base(LAYOUTS))))),
+        CONTRACT: dump(put_contract(json.loads(read_now(CONTRACT)), *contract_entries(base_contract))),
+        ENCOUNTERS: dump(put_encounter(json.loads(read_now(ENCOUNTERS)), ENCOUNTER)),
+    }
+
+
+def newly_blocked(base_map, built_map):
+    """Today's walkable cells (today's coordinates) that the built map blocks;
+    every other saved position just moves by SHIFT."""
+    today = struct.unpack(f"<{len(base_map) // 2}H", base_map)
+    built = struct.unpack(f"<{len(built_map) // 2}H", built_map)
+    width = SIZE[0] - SHIFT[0]
+    return [[i % width, i // width] for i, word in enumerate(today) if not word & 0x0C00
+            and built[(i // width + SHIFT[1]) * SIZE[0] + i % width + SHIFT[0]] & 0x0C00]
+
+
+def record(outputs, base_map, fill_raw):
+    return {
+        "baseCommit": BASE,
+        "fill": {"path": FILL, "sha256": hashlib.sha256(fill_raw).hexdigest(),
+                 "planCellsSha256": json.loads(fill_raw)["plan"]["sha256"]},
+        "plan": {name: list(rect) for name, rect in PLAN.items()},
+        "shift": list(SHIFT), "size": list(SIZE),
+        "connections": {mid: offset(*v) for mid, v in NEIGHBOURS.items()},
+        "draft": "tools/taichung/kit/draft_xitun.py --rev " + BASE[:7],
+        "signMoves": {f"{x},{y}": list(to) for (x, y), to in draft_xitun.SIGN_MOVES.items()},
+        "sharedFiles": "only Xitun's entries: layout, contract district/landmarks/habitats, encounter table",
+        "newlyBlocked": newly_blocked(base_map, outputs[MAP]),
+        "outputs": {MAP: hashlib.sha256(outputs[MAP]).hexdigest(), MAP_JSON: hashlib.sha256(outputs[MAP_JSON]).hexdigest()},
+    }
+
+
+def check_plan(path):
+    districts = json.loads(Path(path).read_text())["districts"]
+    wrong = [name for name, rect in PLAN.items() if tuple(districts[name]["plan"]) != rect]
+    if wrong:
+        raise SystemExit(f"PLAN disagrees with {path}: {wrong}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--plan", type=Path, help="master plan to cross-check PLAN against")
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    if args.plan:
+        check_plan(args.plan)
+    outputs = build(lambda path: git(args.source, path), lambda path: (args.source / path).read_bytes())
+    fill_raw = (args.source / FILL).read_bytes()
+    files = {**outputs, RECORD: (json.dumps(record(outputs, git(args.source, MAP), fill_raw), indent=1) + "\n").encode()}
+    if args.check:
+        stale = [path for path, data in files.items() if not (args.source / path).exists() or (args.source / path).read_bytes() != data]
+        print("\n".join(stale) or "Xitun rework installed")
+        raise SystemExit(1 if stale else 0)
+    for path, data in files.items():
+        (args.source / path).parent.mkdir(parents=True, exist_ok=True)
+        (args.source / path).write_bytes(data)
+    print(f"Xitun {SIZE[0]}x{SIZE[1]}, shift {SHIFT}, offsets {json.loads(files[RECORD])['connections']}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung/kit/landmark_budget.py b/tools/taichung/kit/landmark_budget.py
new file mode 100644
index 0000000..e44ce80
--- /dev/null
+++ b/tools/taichung/kit/landmark_budget.py
@@ -0,0 +1,593 @@
+#!/usr/bin/env python3
+"""Tile budget for the city kit plus new landmark art (read-only).
+
+For each private Taichung primary and each secondary paired with it, this
+counts what today's maps and the installed city kit leave, measures what each
+new landmark's plan art needs, and says where each landmark fits.
+
+Secondaries (tiles and definitions 0x280-0x3FF, palettes 7-12):
+
+  - a definition is drawn when its own map.bin, border.bin or a setmetatile
+    names it, and carried when a connected map's strip shows it (fieldmap.c
+    draws that strip with this bank, as preview_carry.strip() lists it);
+  - it is held when it has any art or sits in the edge-kit range 0x3E0-0x3FF;
+    held but neither drawn nor carried is reclaimable; the rest is free;
+  - tiles follow the definitions that use them; the last 8 tile slots
+    (0x3F8-0x3FF) are never free, because field_door.c copies each door
+    animation frame there (DOOR_TILE_START), so 376 slots are usable;
+  - a palette is kept when a drawn, carried or edge-kit definition uses it,
+    reclaimable when only reclaimable art uses it, and free otherwise. A kept
+    palette's free colour slots are entries 1-15 that no kept tile draws.
+
+Carried art is reclaimable too once every district keeps the 7-row (8-column
+east) strips beside its seams to primary and kit pieces, as the rework does.
+Phase 2b also frees the secondary tiles that today's maps draw only on cells
+the plan repaints with the kit (its streets, highway, river, canals and lake):
+an estimate, since streets the plan moves free more.
+
+Primaries: audit_primaries.py's free tiles less the kit's slots (kit.json) and
+the slots held for the city-v3 library and Cut.
+All seven primary palettes are in use, and a primary is shared by every map it
+pairs with and pinned by check_city_kit.py, so it is an overflow pool only.
+
+Landmark demand, from the plan art (setpieces.py's transparent layers when the
+art folder has it, else the PNGs' own alpha):
+
+  - as drawn: the art cut into 8x8 tiles at 15-bit colour, flips folded
+    together, transparent pixels left to the ground beneath, half-transparent
+    pixels laid over that ground (grass where the board PNG shows the game's
+    grass, else paving). That is the cost of the plan art's own detail.
+    Definitions: one per distinct 16x16 art cell (low) to one per art cell
+    (high, as shipped landmarks run);
+  - at shipped detail: the distinct tiles (primary or secondary; the private
+    primaries hold much landmark art) that the secondary definitions inside
+    each of today's landmark rects draw, per cell there drawing a secondary
+    definition, times the plan art's art cells (the median landmark's detail);
+  - the lower of the two is the low figure and the higher the high one;
+  - palettes: a tile fits an existing palette when every colour has an entry
+    within OKLab distance 0.04 in one of the target's palettes (primary 0-6,
+    secondary 7-12). Tiles that fit none are packed into new 15-colour palettes.
+
+A landmark a district has drawn on real tiles is counted exactly instead:
+--measured names a JSON file of landmark number -> secondaryTiles,
+primaryTiles (new tiles placed in the district's primary), definitions,
+palettes and source.
+
+  landmark_budget.py ART_DIR PLAN_JSON                 print the summary
+  landmark_budget.py ART_DIR PLAN_JSON --json out.json also write the full budget
+  landmark_budget.py ART_DIR PLAN_JSON --png out.png   also draw the budget chart
+  landmark_budget.py ... --measured landmark_measured.json   use exact counts for drawn landmarks
+"""
+import argparse
+import hashlib
+import importlib.util
+import io
+import json
+import re
+import statistics
+import sys
+from pathlib import Path
+
+from PIL import Image
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "nantun"))
+import audit_primaries  # noqa: E402
+import city_kit_art  # noqa: E402
+from preview_carry import strip  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[3]
+KIT = "data/taichung/city-kit/kit.json"
+SECONDARY_SIZE, SECONDARY_PALETTES = 384, range(7, 13)
+EDGE_KIT = set(range(0x3E0, 0x400))
+DOOR_TILES = set(range(0x3F8, 0x400))  # field_door.c: DOOR_TILE_START = NUM_TILES_TOTAL - 8
+NEAR = 0.04
+DISTRICTS = {"xitun": "LAYOUT_TAICHUNG_XITUN", "greenway": "LAYOUT_TAICHUNG_GREENWAY", "oldcity": "LAYOUT_TAICHUNG_OLD_CITY",
+             "north": "LAYOUT_TAICHUNG_NANTUN_NORTH", "wanhe": "LAYOUT_TAICHUNG_NANTUN_WANHE"}
+# Planned maps with no layout yet. Each gets a new secondary on its sibling layout's primary, starting from
+# the sibling's secondary palettes, and carries the sibling's definitions in `carry` at the same IDs.
+NEW_DISTRICTS = {"oldcity_north": dict(sibling="LAYOUT_TAICHUNG_OLD_CITY", carry=(939, 1010), carryNote="city-v3 styles")}
+# Today's landmarks for the shipped density: the plan's landmarkArt plus Maple Garden's park rect.
+SHIPPED_EXTRA = {"Maple Garden": [3, 20, 24, 37]}
+
+
+class Bank:
+    """Definitions, indexed tile pixels and palettes of one tileset half."""
+    def __init__(self, src, label, count, palettes):
+        files = audit_primaries.tileset_files(src, label)
+        folder = str(Path(files["metatiles"]).parent)
+        words = src.words(files["metatiles"])
+        assert len(words) <= count * 8, f"{folder}: {len(words) // 8} definitions"
+        words += (0,) * (count * 8 - len(words))  # a secondary's file may stop short; the slots past it are empty
+        self.label, self.folder = label, folder
+        self.defs = [words[i * 8:i * 8 + 8] for i in range(count)]
+        image = Image.open(io.BytesIO(src.read(f"{folder}/tiles.png")))
+        px, across = image.load(), image.width // 8
+        self.tiles = [tuple(px[i % across * 8 + x, i // across * 8 + y] for y in range(8) for x in range(8))
+                      for i in range(across * (image.height // 8))]
+        self.palettes = {n: [tuple(map(int, line.split())) for line in
+                             src.text(f"{folder}/palettes/{n:02}.pal").splitlines()[3:19]] for n in palettes}
+
+
+def map_specs(src, root):
+    """{MAP_ID: map.json} for every map."""
+    return {spec["id"]: spec for spec in (src.json(str(p.relative_to(root))) for p in sorted((Path(root) / "data/maps").glob("*/map.json")))}
+
+
+def own_ids(src, root, layout, specs):
+    ids = {w & 0x3FF for key in ("blockdata_filepath", "border_filepath") for w in src.words(layout[key])}
+    labels = audit_primaries.metatile_labels(src)
+    for path in sorted((Path(root) / "data/maps").glob("*/scripts.inc")):
+        if specs.get(src.json(str(path.parent.relative_to(root) / "map.json"))["id"], {}).get("layout") != layout["id"]:
+            continue
+        for target in re.findall(r"setmetatile\s+\w+\s*,\s*\w+\s*,\s*(\w+)", src.text(str(path.relative_to(root)))):
+            value = int(target, 0) if target[0].isdigit() else labels.get(target)
+            if value is not None:
+                ids.add(value)
+    return ids
+
+
+def strip_ids(src, layout, specs, layouts):
+    """Neighbour cells this layout's maps show across their connections, drawn with this layout's banks."""
+    ids = set()
+    for spec in specs.values():
+        if spec["layout"] != layout["id"]:
+            continue
+        for c in spec.get("connections") or []:
+            other = layouts[specs[c["map"]]["layout"]]
+            words = src.words(other["blockdata_filepath"])
+            for x, y in strip(layout["width"], layout["height"], other["width"], other["height"], c["direction"], c["offset"]):
+                ids.add(words[y * other["width"] + x] & 0x3FF)
+    return ids
+
+
+def colour_slots(primary, secondary, ids):
+    """{palette 7-12: colour indices 1-15 the given definitions' tiles draw}."""
+    used = {p: set() for p in SECONDARY_PALETTES}
+    for n in ids:
+        bank, i = (primary, n) if n < 640 else (secondary, n - 640)
+        for word in bank.defs[i]:
+            g, p = word & 0x3FF, word >> 12
+            source, gi = (primary, g) if g < 640 else (secondary, g - 640)
+            if p in used and gi < len(source.tiles):
+                used[p] |= set(source.tiles[gi]) - {0}
+    return used
+
+
+def plan_kit_cells(plan):
+    """World cells the plan paints with the kit: street profiles, highway, river, canals and lake."""
+    rects = [*plan["highway"].values(), *plan["river"], *(r for rs in plan["canals"].values() for r in rs)]
+    rects += [plan[k] for k in ("lake", "pond") if plan.get(k)]
+    rects += [[s["x0"], s["firstAsphaltRow"] - 1, s["x1"] + 1, s["firstAsphaltRow"] + 4] for s in plan["streetsEastWest"]]
+    rects += [[s["firstAsphaltCol"] - 1, s["y0"], s["firstAsphaltCol"] + 4, s["y1"] + 1] for s in plan["streetsNorthSouth"]]
+    return {(x, y) for x0, y0, x1, y1 in rects for y in range(y0, y1) for x in range(x0, x1)}
+
+
+def new_secondary(name, primary, sibling, carry, note):
+    """A planned map's own secondary: the sibling's definitions in `carry` (first, last) at the same IDs and
+    their tiles, counted as drawn; palettes copied from the sibling, kept where the carried art uses them."""
+    ids = range(carry[0], carry[1] + 1) if carry else range(0)
+    tiles = {w & 0x3FF for i in ids for w in sibling.defs[i - 640] if w & 0x3FF >= 640}
+    kept = sorted({w >> 12 for i in ids for w in sibling.defs[i - 640] if w} & set(SECONDARY_PALETTES))
+    held = [p for p in SECONDARY_PALETTES if any(c != (0, 0, 0) for c in sibling.palettes[p][1:])]
+    return dict(tileset=f"New secondary ({name})", folder=None, layout=None, primary=primary, planned=True,
+                carry=dict(ids=f"0x{carry[0]:03X}-0x{carry[1]:03X}", tiles=len(tiles), definitions=len(ids), note=note)
+                if carry else None,
+                tiles=dict(drawn=len(tiles), carried=0, reclaimable=0, doors=len(DOOR_TILES),
+                           free=SECONDARY_SIZE - len(DOOR_TILES) - len(tiles), phase2b=0),
+                definitions=dict(drawn=len(ids), carried=0, edgeKit=0, reclaimable=0, free=SECONDARY_SIZE - len(ids)),
+                palettes=dict(kept=kept, reclaimable=[p for p in held if p not in kept],
+                              free=[p for p in SECONDARY_PALETTES if p not in held], freeColourSlots={}))
+
+
+def secondary_budget(src, root, layout, specs, layouts, primary, origin, kit_cells):
+    sec = Bank(src, layout["secondary_tileset"], SECONDARY_SIZE, SECONDARY_PALETTES)
+    own = {i for i in own_ids(src, root, layout, specs) if i >= 640}
+    words = src.words(layout["blockdata_filepath"])
+    staying = {w & 0x3FF for i, w in enumerate(words)
+               if (i % layout["width"] + origin[0], i // layout["width"] + origin[1]) not in kit_cells}
+    staying |= {w & 0x3FF for w in src.words(layout["border_filepath"])} | (own - {w & 0x3FF for w in words})
+    carried = {i for i in strip_ids(src, layout, specs, layouts) if i >= 640} - own
+    art = {640 + i for i, d in enumerate(sec.defs) if any(d)}
+    edge = art & EDGE_KIT
+    held = art | own | EDGE_KIT
+    keep = own | carried | edge
+    tiles = lambda ids: {w & 0x3FF for i in ids for w in sec.defs[i - 640] if w & 0x3FF >= 640}
+    t_own, t_carried, t_held = tiles(own), tiles(carried), tiles(held)
+    pals = lambda ids: {w >> 12 for i in ids for w in sec.defs[i - 640] if w} & set(SECONDARY_PALETTES)
+    kept, any_pal = pals(keep), pals(art)
+    slots = colour_slots(primary, sec, keep)
+    return dict(
+        tileset=sec.label, folder=sec.folder, layout=layout["id"], primary=layout["primary_tileset"],
+        tiles=dict(drawn=len(t_own), carried=len(t_carried - t_own),
+                   reclaimable=len(t_held - t_own - t_carried - DOOR_TILES), doors=len(DOOR_TILES - t_own - t_carried),
+                   free=SECONDARY_SIZE - len(t_held | DOOR_TILES), phase2b=len(t_own - tiles(own & staying) - t_carried)),
+        definitions=dict(drawn=len(own), carried=len(carried), edgeKit=len(EDGE_KIT),
+                         reclaimable=len(held - keep - EDGE_KIT), free=SECONDARY_SIZE - len(held)),
+        palettes=dict(kept=sorted(kept), reclaimable=sorted(any_pal - kept), free=sorted(set(SECONDARY_PALETTES) - any_pal),
+                      freeColourSlots={str(p): 15 - len(slots[p]) for p in sorted(kept)})), sec
+
+
+def primary_budget(src, root):
+    result, _, free_defs = audit_primaries.audit(root, src)
+    kit = src.json(KIT)
+    kit_tiles = {int(s, 16) for s in kit["tileSlots"].values()}
+    first, last = (int(v, 16) for v in kit["metatileRange"].split("-"))
+    held = {n for r in result["libraryTilesInCommonFree"] + result["runtimeTiles"] for n in expand(r)}
+    out = {}
+    for folder, item in result["primaries"].items():
+        free = {n for r in item["freeTiles"] for n in expand(r)}
+        out[folder] = dict(tileset=item["tileset"], layouts=item["layouts"], freeTilesBeforeKit=len(free),
+                           freeTiles=len(free - kit_tiles - held))
+    return dict(primaries=out, kitTiles=len(kit_tiles), kitSpareTiles=len(kit["spareTileSlots"]),
+                kitDefinitions=last - first + 1, commonFreeDefinitions=len(free_defs - set(range(first, last + 1))))
+
+
+def expand(text):
+    a, _, b = text.partition("-")
+    return range(int(a, 16), int(b or a, 16) + 1)
+
+
+def district_of(rect, districts, key):
+    x0, y0, x1, y1 = rect
+    for name, d in districts.items():
+        if not d.get(key):
+            continue
+        dx0, dy0, dx1, dy1 = d[key]
+        if dx0 <= x0 and x1 <= dx1 and dy0 <= y0 and y1 <= dy1:
+            return name
+    raise ValueError(f"{rect} is in no single district")
+
+
+def shipped_density(src, plan, layouts, banks):
+    """Per landmark of today's maps: distinct tiles its secondary definitions draw, per cell drawing one."""
+    rows = []
+    for name, rect in {**plan["landmarkArt"], **SHIPPED_EXTRA}.items():
+        district = district_of(rect, plan["districts"], "today")
+        layout = layouts[DISTRICTS[district]]
+        sec = banks[district]
+        ox, oy = plan["districts"][district]["today"][:2]
+        inside, cells = set(), 0
+        for i, w in enumerate(src.words(layout["blockdata_filepath"])):
+            x, y, n = i % layout["width"] + ox, i // layout["width"] + oy, w & 0x3FF
+            if rect[0] <= x < rect[2] and rect[1] <= y < rect[3]:
+                inside.add(n)
+                cells += n >= 640
+        tiles = {w & 0x3FF for i in inside if i >= 640 for w in sec.defs[i - 640]}
+        rows.append(dict(name=name, district=district, rect=rect, artCells=cells, tiles=len(tiles),
+                         tilesPerCell=round(len(tiles) / cells, 3) if cells else None))
+    return rows
+
+
+def oklab(rgb):
+    lin = [((c / 255 + 0.055) / 1.055) ** 2.4 if c / 255 > 0.04045 else c / 255 / 12.92 for c in rgb]
+    l, m, s = (sum(k * c for k, c in zip(row, lin)) ** (1 / 3) for row in
+               ((0.4122214708, 0.5363325363, 0.0514459929), (0.2119034982, 0.6806995451, 0.1073969566),
+                (0.0883024619, 0.2817188376, 0.6299787005)))
+    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s, 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
+            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)
+
+
+def rgb15(c):
+    return tuple((v << 3) | (v >> 2) for v in (c >> 10, c >> 5 & 31, c & 31))
+
+
+def measure_art(layer, ground, palettes):
+    """As drawn: tiles (flips folded), definitions, colours, and the tiles no existing palette draws."""
+    width, height = layer.size
+    px = layer.load()
+
+    def colour(x, y):
+        r, g, b, a = px[x, y]
+        if a == 0:
+            return -1
+        if a < 255:
+            r, g, b = (round((c * a + k * (255 - a)) / 255) for c, k in zip((r, g, b), ground))
+        return (r >> 3) << 10 | (g >> 3) << 5 | b >> 3
+
+    tiles = {}
+    for ty in range(0, height, 8):
+        for tx in range(0, width, 8):
+            t = [[colour(tx + x, ty + y) for x in range(8)] for y in range(8)]
+            if any(c >= 0 for row in t for c in row):
+                flips = (t, [r[::-1] for r in t], t[::-1], [r[::-1] for r in t[::-1]])
+                key = min(tuple(c for r in f for c in r) for f in flips)
+                tiles[key] = {c for c in key if c >= 0}
+    cells, art_cells = set(), 0
+    for cy in range(0, height, 16):
+        for cx in range(0, width, 16):
+            cell = tuple(colour(cx + x, cy + y) for y in range(16) for x in range(16))
+            if any(c >= 0 for c in cell):
+                art_cells += 1
+                cells.add(cell)
+    colours = set().union(*tiles.values())
+    labs = {n: [oklab(e) for e in entries[1:]] for n, entries in palettes.items()}
+    near = {c: {n for n, lab in labs.items() if min(sum((a - b) ** 2 for a, b in zip(oklab(rgb15(c)), e)) ** 0.5
+                                                     for e in lab) <= NEAR} for c in colours}
+    stranded = [s for s in tiles.values() if not set.intersection(*(near[c] for c in s))]
+    return dict(artCells=art_cells, tiles=len(tiles), distinctCells=len(cells), colours=len(colours),
+                coloursNearExisting=sum(1 for c in colours if near[c]), tilesNoExistingPalette=len(stranded),
+                newPalettes=pack(stranded), _stranded=stranded)
+
+
+def pack(sets):
+    """15-colour palettes for these colour sets, first fit by size (an upper bound on the minimum)."""
+    bins = []
+    for s in sorted(sets, key=len, reverse=True):
+        s = set(sorted(s)[:15])
+        for b in bins:
+            if len(b | s) <= 15:
+                b |= s
+                break
+        else:
+            bins.append(set(s))
+    return len(bins)
+
+
+def setpieces(art_dir):
+    path = Path(art_dir) / "setpieces.py"
+    if not path.exists():
+        return None
+    spec = importlib.util.spec_from_file_location("setpieces", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.SETPIECES
+
+
+def budget(root, art_dir, plan_path, measured_path=None):
+    measured = json.loads(Path(measured_path).read_text()) if measured_path else {}
+    src = audit_primaries.Source(root)
+    plan = json.loads(Path(plan_path).read_text())
+    layouts = {l["id"]: l for l in src.json("data/layouts/layouts.json")["layouts"] if l}
+    specs = map_specs(src, root)
+    primaries_banks = {}
+    secondaries, banks = {}, {}
+    kit_cells = plan_kit_cells(plan)
+    for district, spec in plan["districts"].items():
+        planned = NEW_DISTRICTS.get(district, {})
+        layout = layouts[DISTRICTS.get(district) or planned["sibling"]]
+        label = layout["primary_tileset"]
+        if label not in primaries_banks:
+            primaries_banks[label] = Bank(src, label, 640, range(7))
+        if district in DISTRICTS:
+            secondaries[district], banks[district] = secondary_budget(src, root, layout, specs, layouts, primaries_banks[label],
+                                                                      spec["today"][:2], kit_cells)
+        else:
+            sibling = Bank(src, layout["secondary_tileset"], SECONDARY_SIZE, SECONDARY_PALETTES)
+            secondaries[district] = new_secondary(spec["name"], label, sibling, planned.get("carry"), planned.get("carryNote"))
+            banks[district] = sibling  # its palettes are the new bank's starting palettes
+    rendered = city_kit_art.renderer(Path(root) / "data/tilesets/primary/taichung_xitun_private/tiles.png")
+    grounds = {k: rendered[k].convert("RGB") for k in ("grass", "sidewalk")}
+    shipped = shipped_density(src, plan, layouts, banks)
+    density = statistics.median(r["tilesPerCell"] for r in shipped if r["artCells"])
+    pieces = setpieces(art_dir)
+    landmarks = []
+    for item in plan["newLandmarks"]:
+        art_file = next(Path(art_dir).glob(f"{item['n']}-*.png"))
+        board = Image.open(art_file).convert("RGBA")
+        x0, y0, x1, y1 = item["rect"]
+        layer = pieces[item["name"]](x1 - x0, y1 - y0) if pieces else board
+        assert layer.size == board.size, f"{art_file.name}: {layer.size} against {board.size}"
+        grass = list(grounds["grass"].getdata())
+        on_grass = any(list(board.convert("RGB").crop((cx, cy, cx + 16, cy + 16)).getdata()) == grass
+                       for cy in range(0, board.height, 16) for cx in range(0, board.width, 16))
+        ground_image = grounds["grass" if on_grass else "sidewalk"]
+        pixels = list(ground_image.getdata())
+        district = district_of(item["rect"], plan["districts"], "plan")
+        primary = primaries_banks[secondaries[district]["primary"]]
+        own = banks[district].palettes if banks[district] else {}
+        drawn = measure_art(layer, max(set(pixels), key=pixels.count), {**primary.palettes, **own})
+        entry = dict(
+            n=item["n"], name=item["name"], owner=item["owner"], rect=item["rect"], district=district,
+            secondary=secondaries[district]["tileset"], art=art_file.name, layer="setpieces.py" if pieces else "png",
+            ground="grass" if on_grass else "paving", asDrawn=drawn,
+            tiles=dict(low=min(round(density * drawn["artCells"]), drawn["tiles"]),
+                       high=max(round(density * drawn["artCells"]), drawn["tiles"])),
+            definitions=dict(low=drawn["distinctCells"], high=drawn["artCells"]), primaryTiles=0)
+        exact = measured.get(str(item["n"]))
+        if exact:
+            # Drawn on real tiles in existing palettes: the counts are exact and need no new palette.
+            entry.update(measured=exact, primaryTiles=exact["primaryTiles"],
+                         planEstimate=dict(tiles=entry["tiles"], definitions=entry["definitions"]),
+                         tiles=dict(low=exact["secondaryTiles"], high=exact["secondaryTiles"]),
+                         definitions=dict(low=exact["definitions"], high=exact["definitions"]))
+            drawn["_stranded"] = []
+        landmarks.append(entry)
+    fit = {}
+    for district, sec in secondaries.items():
+        mine = [l for l in landmarks if l["district"] == district]
+        if not mine:
+            continue
+        t_low, t_high = sum(l["tiles"]["low"] for l in mine), sum(l["tiles"]["high"] for l in mine)
+        d_low, d_high = sum(l["definitions"]["low"] for l in mine), sum(l["definitions"]["high"] for l in mine)
+        new_pals = pack([s for l in mine for s in l["asDrawn"]["_stranded"]])
+        t, d, p = sec["tiles"], sec["definitions"], sec["palettes"]
+        pal_room = len(p["free"]) + len(p["reclaimable"])
+        room = (("in free slots", t["free"]), ("after reclaiming art no map draws", t["free"] + t["reclaimable"]),
+                ("after phase 2b (kit streets, strips no longer carried)",
+                 t["free"] + t["reclaimable"] + t["carried"] + t["phase2b"]))
+        low_fit = next((label for label, n in room if t_low <= n), None)
+        high_fit = next((label for label, n in room if t_high <= n), None)
+        short_defs = d_low > d["free"] + d["reclaimable"] + d["carried"]
+        if short_defs or not low_fit:
+            verdict = "needs a new secondary tileset" + {(True, True): " (tiles and definitions)",
+                                                         (True, False): " (definitions)"}.get((short_defs, not low_fit), "")
+        elif high_fit:
+            verdict = f"fits at shipped detail {high_fit}"
+        else:
+            verdict = (f"fits at the plan art's detail {low_fit}; shipped detail "
+                       + ("would overflow it" if sec.get("planned") else "needs a new secondary tileset"))
+        drawn_ones = [l for l in mine if l.get("measured")]
+        if len(drawn_ones) == len(mine):
+            verdict = f"drawn: fits {low_fit}" if low_fit and not short_defs else "drawn: " + verdict
+        elif drawn_ones:
+            need = sum(l["tiles"]["low"] for l in drawn_ones)
+            where = next((label for label, n in room if need <= n), None)
+            verdict += (f"; drawn {', '.join(str(l['n']) for l in drawn_ones)} alone "
+                        + (f"fits {where}" if where else "does not fit"))
+        spare = ", ".join(f"{len(p[k])} {k}" for k in ("free", "reclaimable") if p[k]) or "none free or reclaimable"
+        if not new_pals:
+            palette_verdict = "no new palette"
+        elif new_pals <= pal_room:
+            palette_verdict = f"{new_pals} new palette(s) as drawn, {spare}"
+        else:
+            palette_verdict = f"{new_pals} new palette(s) as drawn, {spare}: draw in existing colours"
+        fit[district] = dict(secondary=sec["tileset"], landmarks=[l["n"] for l in mine], tiles=[t_low, t_high],
+                             drawn=[l["n"] for l in drawn_ones], primaryTiles=sum(l["primaryTiles"] for l in mine),
+                             definitions=[d_low, d_high], newPalettes=new_pals, freeTiles=t["free"],
+                             reclaimableTiles=t["reclaimable"], carriedTiles=t["carried"], phase2bTiles=t["phase2b"],
+                             freeDefinitions=d["free"],
+                             reclaimableDefinitions=d["reclaimable"], freePalettes=len(p["free"]),
+                             reclaimablePalettes=len(p["reclaimable"]), verdict=verdict, palettes=palette_verdict)
+    for l in landmarks:
+        l["asDrawn"].pop("_stranded")
+    art = {f"{art_dir.name}/{p.name}": hashlib.sha256(p.read_bytes()).hexdigest()
+           for p in sorted(Path(art_dir).iterdir()) if p.suffix in (".png", ".py")}
+    art[Path(plan_path).name] = hashlib.sha256(Path(plan_path).read_bytes()).hexdigest()
+    if measured_path:
+        art[Path(measured_path).name] = hashlib.sha256(Path(measured_path).read_bytes()).hexdigest()
+    return dict(primaries=primary_budget(src, root), secondaries=secondaries, shipped=shipped,
+                shippedMedianTilesPerCell=density, landmarks=landmarks, fit=fit, inputs=src.provenance(), art=art)
+
+
+def summary(result):
+    p = result["primaries"]
+    lines = [f"primaries after the kit ({p['kitTiles']} tiles, {p['kitDefinitions']} definitions; "
+             f"{p['kitSpareTiles']} spare slots free in all three):"]
+    for name, item in p["primaries"].items():
+        lines.append(f"  {name}: {item['freeTiles']} tiles free, all 7 palettes in use ({', '.join(item['layouts'])})")
+    lines.append(f"  {p['commonFreeDefinitions']} definitions free in all three")
+    lines.append("secondaries (384 tiles, 384 definitions, palettes 7-12):")
+    for district, s in result["secondaries"].items():
+        t, d, pal = s["tiles"], s["definitions"], s["palettes"]
+        lines.append(f"  {s['tileset']} ({district}): tiles {t['drawn']} drawn, {t['carried']} carried for neighbours, "
+                     f"{t['reclaimable']} reclaimable, {t['free']} free, {t['doors']} held for doors, ~{t['phase2b']} freed by phase 2b; definitions {d['drawn']} drawn, {d['carried']} "
+                     f"carried, {d['reclaimable']} reclaimable, {d['free']} free; palettes free {pal['free'] or 'none'}, "
+                     f"reclaimable {pal['reclaimable'] or 'none'}, free colour slots {pal['freeColourSlots']}")
+    lines.append(f"shipped landmarks: median {result['shippedMedianTilesPerCell']} distinct tiles per art cell "
+                 f"({len(result['shipped'])} landmarks)")
+    for l in result["landmarks"]:
+        a, m = l["asDrawn"], l.get("measured")
+        if m:
+            lines.append(f"  {l['n']} {l['name']} ({l['district']}): drawn, {m['secondaryTiles']} secondary + "
+                         f"{m['primaryTiles']} primary tiles, {m['definitions']} definitions, palettes {m['palettes']} "
+                         f"(plan estimate {l['planEstimate']['tiles']['low']}-{l['planEstimate']['tiles']['high']}; {m['source']})")
+            continue
+        lines.append(f"  {l['n']} {l['name']} ({l['district']}, {l['ground']}): {l['tiles']['low']}-{l['tiles']['high']} tiles, "
+                     f"{l['definitions']['low']}-{l['definitions']['high']} definitions, {a['artCells']} art cells; "
+                     f"{a['colours']} colours, {a['coloursNearExisting']} near an existing entry, "
+                     f"{a['tilesNoExistingPalette']} tiles fit no existing palette ({a['newPalettes']} new)")
+    for district, f in result["fit"].items():
+        lines.append(f"  {f['secondary']} <- {f['landmarks']}: tiles {f['tiles'][0]}-{f['tiles'][1]} against {f['freeTiles']} free "
+                     f"(+{f['reclaimableTiles']} reclaimable, +{f['carriedTiles']} carried, +~{f['phase2bTiles']} phase 2b); definitions "
+                     f"{f['definitions'][0]}-{f['definitions'][1]} against {f['freeDefinitions']} free "
+                     f"(+{f['reclaimableDefinitions']}); {f['primaryTiles']} new tiles in the primary; {f['verdict']}; {f['palettes']}")
+    return "\n".join(lines)
+
+
+def chart(result, out):
+    """One bar per secondary: 384 tile slots by state, with the new landmarks' low and high need laid from where kept art ends."""
+    from PIL import ImageDraw, ImageFont
+
+    def font(size, bold=False):
+        for path in ("/System/Library/Fonts/Supplemental/Arial Bold.ttf" if bold else "/System/Library/Fonts/Supplemental/Arial.ttf",
+                     "/Library/Fonts/Arial.ttf"):
+            try:
+                return ImageFont.truetype(path, size)
+            except OSError:
+                pass
+        return ImageFont.load_default()
+
+    surface, ink, ink2 = "#fcfcfb", "#0b0b0b", "#52514e"
+    states = (("drawn", "Drawn by its map", "#8f8d88"), ("carried", "Carried for a neighbour's strip", "#cfcdc7"),
+              ("reclaimable", "Reclaimable (no map draws it)", "#9ec5f0"), ("free", "Free", "#ecebe7"),
+              ("doors", "Door animation (never free)", "#4f4d49"))
+    needs = (("Landmarks at the plan art's detail (low)", "#2a78d6"), ("at shipped landmarks' detail (high)", "#eb6834"))
+    scale, x0, bar_h, row_h = 2, 300, 26, 116
+    x1 = x0 + SECONDARY_SIZE * scale
+    secs = result["secondaries"]
+    image = Image.new("RGB", (x1 + 330, 200 + row_h * len(secs) + 60), surface)
+    d = ImageDraw.Draw(image)
+    d.text((40, 24), "Landmark budget: secondary tile slots", fill=ink, font=font(24, True))
+    d.text((40, 58), "Each district's secondary holds 384 tiles; doors overwrite the last 8, so 376 are usable. "
+                     "The primaries are full once the kit is in, and no existing secondary has a free palette.", fill=ink2, font=font(15))
+    lx, ly = 40, 96
+    for key, label, colour in states:
+        d.rounded_rectangle((lx, ly + 2, lx + 14, ly + 16), radius=2, fill=colour)
+        d.text((lx + 20, ly), label, fill=ink, font=font(13))
+        lx += 34 + int(d.textlength(label, font=font(13)))
+    lx, ly = 40, 122
+    for label, colour in needs:
+        d.rectangle((lx, ly + 7, lx + 22, ly + 11), fill=colour)
+        d.text((lx + 28, ly), label, fill=ink, font=font(13))
+        lx += 48 + int(d.textlength(label, font=font(13)))
+    y = 170
+    for district, s in secs.items():
+        f = result["fit"].get(district)
+        d.text((40, y), s["tileset"].replace("gTileset_", ""), fill=ink, font=font(15, True))
+        if f and set(f["drawn"]) == set(f["landmarks"]):
+            label = ", ".join(map(str, f["landmarks"])) + ", drawn"
+        else:
+            label = ", ".join(f"{n} (drawn)" if n in f["drawn"] else str(n) for n in f["landmarks"]) if f else ""
+        d.text((40, y + 22), f"landmarks {label}" if f else "no new landmark", fill=ink2, font=font(13))
+        if s.get("carry"):
+            c = s["carry"]
+            d.text((40, y + 40), f"+ {c['note']} at {c['ids']}", fill=ink2, font=font(12))
+            d.text((40, y + 56), f"({c['tiles']} tiles, {c['definitions']} definitions)", fill=ink2, font=font(12))
+        x = x0
+        for key, _, colour in states:
+            w = s["tiles"][key] * scale
+            if w:
+                d.rectangle((x, y, x + w - 1, y + bar_h), fill=colour)
+            x += w
+        d.rectangle((x0, y, x1 - 1, y + bar_h), outline="#b8b6b0")
+        t = s["tiles"]
+        if f:
+            start, end = x0 + (t["drawn"] + t["carried"]) * scale, x1 - t["doors"] * scale
+            for k, ((_, colour), want) in enumerate(zip(needs, f["tiles"])):
+                yy = y + bar_h + 6 + k * 8
+                d.rectangle((start, yy, min(start + want * scale, end) - 1, yy + 4), fill=colour)
+                if start + want * scale > end:
+                    d.polygon([(end + 2, yy - 2), (end + 9, yy + 2), (end + 2, yy + 6)], fill=colour)
+            want = f"{f['tiles'][0]}" if f["tiles"][0] == f["tiles"][1] else f"{f['tiles'][0]}-{f['tiles'][1]}"
+            d.text((x1 + 18, y), f"{t['free']} free; want {want}", fill=ink, font=font(14, True))
+            d.text((x1 + 18, y + 20), f"+{t['reclaimable']} reclaimable, +{t['carried']} carried, ~{t['phase2b']} from 2b",
+                   fill=ink2, font=font(12))
+            d.text((x0, y + bar_h + 26), f["verdict"] + "; " + f["palettes"], fill=ink2, font=font(13))
+        else:
+            d.text((x1 + 18, y), f"{t['free']} free", fill=ink, font=font(14, True))
+            d.text((x1 + 18, y + 20), f"+{t['reclaimable']} reclaimable, ~{t['phase2b']} from 2b", fill=ink2, font=font(12))
+        y += row_h
+    p = result["primaries"]
+    taken = {}
+    for district, f in result["fit"].items():
+        taken[secs[district]["primary"]] = taken.get(secs[district]["primary"], 0) + f["primaryTiles"]
+    d.text((40, y), "Primaries after the kit: " + ", ".join(
+        f"{k} {v['freeTiles']} tiles free" + (f" ({taken[v['tileset']]} taken by drawn landmarks)" if taken.get(v["tileset"]) else "")
+        for k, v in p["primaries"].items()) + f"; {p['kitSpareTiles']} of them are free in all three.", fill=ink2, font=font(13))
+    d.text((40, y + 20), "Need bars start where drawn and carried art ends, so they count reclaimable slots as room; "
+                         "past the door slots they end in an arrow.", fill=ink2, font=font(13))
+    image.save(out)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("art", type=Path)
+    parser.add_argument("plan", type=Path)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--json", type=Path)
+    parser.add_argument("--png", type=Path)
+    parser.add_argument("--measured", type=Path, help="exact counts for landmarks drawn on real tiles")
+    args = parser.parse_args()
+    result = budget(args.source, args.art, args.plan, args.measured)
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(json.dumps(result, indent=1) + "\n")
+    if args.png:
+        args.png.parent.mkdir(parents=True, exist_ok=True)
+        chart(result, args.png)
+    print(summary(result))
+
+
+if __name__ == "__main__":
+    main()
