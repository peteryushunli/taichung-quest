+class Files:
+    def __init__(self, source, revision=None):
+        self.source, self.revision, self.cache = source, revision, {}
+
+    def read(self, path):
+        key = str(path)
+        if key not in self.cache:
+            if self.revision:
+                self.cache[key] = subprocess.check_output(["git", "show", f"{self.revision}:{key}"], cwd=self.source)
+            else:
+                self.cache[key] = (self.source/path).read_bytes()
+        return self.cache[key]
+
+    def text(self, path):
+        return self.read(path).decode("utf-8")
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        if len(raw) % struct.calcsize(kind):
+            raise ValueError(f"Invalid {kind} file size: {path}")
+        return list(struct.unpack(f"<{len(raw)//struct.calcsize(kind)}{kind}", raw))
+
+    def image(self, path):
+        image = Image.open(BytesIO(self.read(path)))
+        image.load()
+        return image
