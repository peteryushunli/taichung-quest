+    // Virgin entry is covered separately against the immutable baseline C.
+    sSave.vars[TAICHUNG_ENCOUNTER_SCHEMA_VAR - VARS_START] = TAICHUNG_ENCOUNTER_SCHEMA;
+    sSave.vars[TAICHUNG_ENCOUNTER_ATTEMPT_VAR - VARS_START] = 0xC155;
+    sSave.vars[TAICHUNG_ENCOUNTER_UNLOCK_VAR - VARS_START] = 0x8151;
+    sSave.vars[0xF6] = 0xA109;
+    sSave.vars[0xF8] = 1;
+    sSave.vars[0xF9] = 2;
+    sSave.vars[0xFA] = 0x7F;
+    sSave.vars[0xFB] = 2;
+    sSave.vars[0xFC] = 25;
+    sSave.location = (struct WarpData){MAP_GROUP(MAP_TAICHUNG_OLD_CITY), mapNum, -1, 7, 8};
+    sSave.pos = (struct Coords16){x, y};
+    sSave.mapLayoutId = 1;
