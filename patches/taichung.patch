+def function_body(text, name):
+    match = re.search(r"\b" + re.escape(name) + r"\s*\([^;]*?\)\s*\{", text, re.S)
+    if match is None: raise ValueError("Missing native function: " + name)
+    start, level = match.end() - 1, 1
+    end = start + 1
+    while level and end < len(text):
+        level += (text[end] == "{") - (text[end] == "}"); end += 1
+    if level: raise ValueError("Unclosed native function: " + name)
+    return text[start:end]
+
+
+def compact(text):
+    return " ".join(re.sub(r"//[^\n]*", "", text).split())
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def table(text, name):
+    start = text.index(name + "[]")
+    body = text[start:text.index("};", start)]
+    return [tuple(map(int, row)) for row in re.findall(ROW, body)]
+
+
+def underneath(source, files, base, support):
+    """Shared files with the registered Nantun and OldCity buildings deltas removed."""
+    out = {}
+    if (source / NANTUN_GUARD).exists():
+        nantun = load("xitun_streets_nantun_guard", source / NANTUN_GUARD)
+        delta = nantun.underneath(files)
+        if delta:
+            out.update({path: delta[path] for path in UNCHANGED if path in delta})
+            ids = {files.json(f"data/maps/{name}/map.json")["layout"] for name, _, _ in nantun.EXTERIORS.values()}
+            layouts = files.json(LAYOUTS)
+            layouts["layouts"] = [item for item in layouts["layouts"] if item.get("id") not in ids]
+            out[LAYOUTS] = nantun.dump(layouts)
+            out["nantunXitunSeam"] = set(nantun.seam_cells(files.json(nantun.PLAN), "TaichungXitun"))
+    if (source / OLDCITY_INSTALL).exists():
+        install = files.json(OLDCITY_INSTALL)
+        changed = sum(a != b for a, b in zip(files.words(OLDCITY_MAP), base.words(OLDCITY_MAP)))
+        if (install["baseCommit"] == base.revision and changed == install["changedCells"]
+                and support.digest(files.read(OLDCITY_MAP)) == install["outputs"][OLDCITY_MAP]):
+            out[OLDCITY_MAP] = base.read(OLDCITY_MAP)
+    return out
