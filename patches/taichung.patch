+    paving=baseline.entries(0x175)
+    assert paving[4:]==[0]*4
+    for spec in SPECS:
+        path=ROOT/'data/taichung/landmarks'/spec['input'];art=Image.open(path)
+        assert art.mode=='P' and art.info.get('transparency')==0 and art.getextrema()[1]<=15
+        assert art.width%16==art.height%16==0
+        palette=art.getpalette()[:48]
+        used_indices=set(art.get_flattened_data())-{0};pn=spec['palette']
+        if pn not in palettes:palettes[pn]=palette.copy();palette_used[pn]=set()
+        for index in used_indices:
+            if index in palette_used[pn]:assert palettes[pn][index*3:index*3+3]==palette[index*3:index*3+3], f'Conflicting used palette index {pn}:{index}'
+            palettes[pn][index*3:index*3+3]=palette[index*3:index*3+3]
+        palette_used[pn].update(used_indices)
