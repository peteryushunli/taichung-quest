@@ -0,0 +1,341 @@
+#!/usr/bin/env python3
+"""Read-only proof for the city kit in the three private Taichung primaries.
+
+The kit's tiles, metatile definitions and attributes are pinned by name and ID
+(data/taichung/city-kit/kit.json, whose hash is pinned here) and must be the
+installer's exact output from BASE. The three primaries must stay byte-identical
+in definitions, attributes, palettes 0-6 and kit tile slots, so any map draws a
+neighbour's kit cells as the neighbour does. No slot that anything draws
+(a used definition, a paired secondary, General's animation, Cut's swap or the
+city-v3 library) may hold kit art, and nothing outside the kit may change:
+every other tile, definition, attribute and palette, every secondary, map,
+border and tileset declaration equals BASE, and all five exteriors render
+pixel-identically to BASE. Kit water is behaviour 0 over General's animated
+fields: not surfable, not a current. Runtime animation stays a runtime gate.
+
+  check_city_kit.py               print the report
+  check_city_kit.py --self-test   also prove each corruption probe is caught
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+CONTRACT_SHA256 = "d5dd66b3537b9b50bf700db65272626357afa5b0a121f8fc7f4335b23293a8cd"
+# 239 named kit metatiles over 0x063-0x157; six IDs there are retired (base content).
+FIRST_METATILE, METATILE_COUNT, METATILE_SPAN, TILE_COUNT = 0x063, 239, 245, 35
+TILE_SLOTS = (0x00B, 0x0C4, 0x0CA, 0x0CB, 0x0CC, 0x0CD, 0x0CE, 0x0DA, 0x0DB, 0x0DC, 0x0DD, 0x0DE,
+              0x0EA, 0x0EB, 0x0EC, 0x0ED, 0x0FA, 0x0FB, 0x0FC, 0x0FD, 0x108, 0x109, 0x10A, 0x10B,
+              0x10C, 0x10D, 0x10E, 0x118, 0x119, 0x11A, 0x11B, 0x11C, 0x11D, 0x11E, 0x124)
+# The 0x175 sidewalk paving, which the overpass, bridge, kerb and railing
+# sidewalks draw, and General's leaf tiles, which the wall's planted bank draws.
+PAVING_TILES = {0x152, 0x153, 0x162, 0x163}
+LEAF_TILES = {0x044, 0x045, 0x054, 0x055}
+ANIMATED = set(range(416, 482)) | set(range(508, 512))
+WATER_FIELDS = {416, 434, 438, 442, 446}
+EXTERIORS = ("TaichungXitun", "TaichungGreenway", "TaichungOldCity", "TaichungNantunNorth", "TaichungNantunWanhe")
+SECONDARIES = ("taichung_xitun_landmarks", "taichung_greenway_cmp", "taichung_old_core", "taichung_nantun_north", "taichung_nantun")
+DECLARATIONS = ("data/layouts/layouts.json", "src/data/tilesets/headers.h", "src/data/tilesets/metatiles.h",
+                "src/data/tilesets/graphics.h", "src/tileset_anims.c", "src/fldeff_cut.c", "include/constants/metatile_labels.h")
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def same(a, b, path):
+    """Byte equality; JASC palettes are checked out with CRLF, stored with LF."""
+    return a.replace(b"\r\n", b"\n") == b.replace(b"\r\n", b"\n") if path.endswith(".pal") else a == b
+
+
+def watched(base):
+    """Files outside the kit that must equal BASE."""
+    out = list(DECLARATIONS)
+    for name in EXTERIORS:
+        out += [f"data/layouts/{name}/map.bin", f"data/layouts/{name}/border.bin", f"data/maps/{name}/map.json"]
+    for folder in SECONDARIES:
+        out += [f"data/tilesets/secondary/{folder}/{f}" for f in ("tiles.png", "metatiles.bin", "metatile_attributes.bin")]
+        out += [f"data/tilesets/secondary/{folder}/palettes/{p:02}.pal" for p in range(16)]
+    return out
+
+
+def check(source=ROOT, overrides=None):
+    source = Path(source).resolve()
+    support = load("city_kit_support", source / "tools/taichung/landmarks/check_old_core.py")
+    install = load("city_kit_install", HERE / "install_city_kit.py")
+    audit = load("city_kit_audit", HERE / "audit_primaries.py")
+    art = install.art
+    now, base = support.Files(source), support.Files(source, install.BASE)
+    now.cache.update(overrides or {})
+    # The registered still-water layer edits one definition (0x1A9) in each
+    # primary; its own guard proves that delta, so the kit is checked
+    # underneath it (the latest layer, stripped first).
+    now.cache.update(support.still_water_underneath(now))
+    # The registered Old City rework grows Greenway and Old City and adds Old City North;
+    # its own guard proves that delta, so the exteriors here are checked underneath it
+    # (the latest layer, stripped first).
+    now.cache.update(support.oldcity_rework_underneath(now))
+    # The registered Xitun rework draws kit pieces on a grown map, and the
+    # registered landmark collision layer sets collision bits on the release
+    # map; their own guards prove those deltas, so the exteriors here are
+    # checked underneath them.
+    now.cache.update(support.xitun_rework_underneath(now))
+    now.cache.update(support.landmark_collision_underneath(now))
+    tests = support.Checks()
+    folders = install.PRIMARIES
+    ids = art.ids()
+    kit_ids = set(ids.values())
+    entries = art.encoded()
+    # The registered Nantun rework draws kit pieces on grown maps with a rebuilt
+    # bank; check_nantun proves that delta, so the kit is checked underneath it.
+    now.cache.update(support.nantun_rework_underneath(now))
+
+    def block(image, n):
+        return tuple(image.getpixel((n % 16 * 8 + x, n // 16 * 8 + y)) for y in range(8) for x in range(8))
+
+    def contract():
+        raw = now.read(install.CONTRACT)
+        tests.require(hashlib.sha256(raw).hexdigest() == CONTRACT_SHA256, "kit.json differs from the pinned contract")
+        data = json.loads(raw)
+        tests.require(len(ids) == METATILE_COUNT and min(kit_ids) == FIRST_METATILE
+                      and max(kit_ids) == FIRST_METATILE + METATILE_SPAN - 1, "Kit metatile IDs moved")
+        tests.require(tuple(art.slots().values()) == TILE_SLOTS and len(art.tiles()) == TILE_COUNT, "Kit tile slots moved")
+        tests.require(data["metatiles"] == {k: f"0x{v:03X}" for k, v in ids.items()}, "kit.json names or IDs differ from the art")
+        tests.require(data["tileSlots"] == {k: f"0x{v:03X}" for k, v in art.slots().items()}, "kit.json tile slots differ from the art")
+        return {"metatiles": len(ids), "metatileRange": data["metatileRange"], "tiles": len(art.tiles())}
+
+    def installer():
+        outputs = install.build(base.read)
+        stale = [path for path, data in outputs.items() if now.read(path) != data]
+        tests.require(not stale, f"Primaries are not the installer's output from BASE: {stale}")
+        tests.require(json.loads(now.read(install.CONTRACT)) == install.contract(outputs), "kit.json is not the installer's contract")
+        return {"outputs": len(outputs)}
+
+    def identity():
+        first = folders[0]
+        names = ["metatiles.bin", "metatile_attributes.bin"] + [f"palettes/{p:02}.pal" for p in range(7)]
+        for name in names:
+            tests.require(all(same(now.read(f"{f}/{name}"), now.read(f"{first}/{name}"), name) for f in folders[1:]),
+                          f"Primaries differ in {name}")
+        images = [now.image(f"{f}/tiles.png") for f in folders]
+        for slot in (*TILE_SLOTS, *sorted(PAVING_TILES | LEAF_TILES)):
+            tests.require(len({block(image, slot) for image in images}) == 1, f"Kit tile 0x{slot:03X} differs between primaries")
+        layouts = {l["id"]: l for l in now.json("data/layouts/layouts.json")["layouts"] if l}
+        renders = []
+        for name in EXTERIORS:
+            info = layouts[now.json(f"data/maps/{name}/map.json")["layout"]]
+            primary = next(f for f in folders if f.endswith(_folder(now, info["primary_tileset"])))
+            bank = support.Bank(now, primary, "data/tilesets/secondary/" + _folder(now, info["secondary_tileset"]))
+            renders.append(tuple(bank.render(m) for m in sorted(kit_ids)))
+        tests.require(len(set(renders)) == 1, "Kit metatiles render differently in some exterior's banks")
+        return {"identicalFiles": len(names), "kitTiles": len(TILE_SLOTS)}
+
+    def kit_content():
+        art_tiles = art.tiles()
+        for folder in folders:
+            defs, attrs = now.words(f"{folder}/metatiles.bin"), now.words(f"{folder}/metatile_attributes.bin", "I")
+            image = now.image(f"{folder}/tiles.png")
+            for name, slot in art.slots().items():
+                tests.require(block(image, slot) == tuple(v for row in art_tiles[name] for v in row),
+                              f"{folder}: kit tile {name} at 0x{slot:03X} differs from the art")
+            for metatile, words, attribute in entries:
+                tests.require(defs[metatile * 8:metatile * 8 + 8] == words, f"{folder}: kit metatile 0x{metatile:03X} differs")
+                tests.require(attrs[metatile] == attribute and attrs[metatile] & 0x1FF == 0,
+                              f"{folder}: kit metatile 0x{metatile:03X} attribute is not plain (behaviour 0)")
+        water = 0
+        for name, metatile in ids.items():
+            if name.startswith("wa-"):
+                words = next(w for m, w, _ in entries if m == metatile)
+                lower = [w & 0x3FF for w in words[:4]]
+                tests.require(lower[0] in WATER_FIELDS and lower == list(range(lower[0], lower[0] + 4))
+                              and all(w >> 12 == 4 for w in words[:4]),
+                              f"{name}: water must sit on one of General's animated fields in palette 4")
+                water += 1
+        referenced = {w & 0x3FF for _, words, _ in entries for w in words} - {0}
+        tests.require(referenced <= set(TILE_SLOTS) | PAVING_TILES | LEAF_TILES | {f + i for f in WATER_FIELDS for i in range(4)},
+                      "A kit metatile draws a tile outside the kit slots, the sidewalk paving, General's leaves and water")
+        return {"waterMetatiles": water}
+
+    def preserved():
+        for folder in folders:
+            old, new = base.image(f"{folder}/tiles.png"), now.image(f"{folder}/tiles.png")
+            tests.require(old.size == new.size and old.getpalette() == new.getpalette(), f"{folder}: tile sheet shape or PNG palette changed")
+            changed = [n for n in range(640) if block(old, n) != block(new, n)]
+            tests.require(set(changed) <= set(TILE_SLOTS), f"{folder}: tiles outside the kit changed: {changed[:8]}")
+            for name, size in (("metatiles.bin", 8), ("metatile_attributes.bin", 1)):
+                kind = "H" if size == 8 else "I"
+                a, b = base.words(f"{folder}/{name}", kind), now.words(f"{folder}/{name}", kind)
+                tests.require(len(a) == len(b), f"{folder}: {name} size changed")
+                moved = [n for n in range(len(a) // size) if a[n * size:n * size + size] != b[n * size:n * size + size] and n not in kit_ids]
+                tests.require(not moved, f"{folder}: {name} changed outside the kit: {[hex(n) for n in moved[:8]]}")
+            for p in range(16):
