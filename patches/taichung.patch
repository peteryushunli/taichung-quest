+"""Station pieces drawn in FireRed's manner: RGB555 colours, dark outline, top-left light."""
+from PIL import Image, ImageDraw
+import random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((32,32,48))
+# concrete platform
+C0,C1,C2,C3=q((190,188,178)),q((168,166,158)),q((206,204,196)),q((150,148,140))
+Y0,Y1=q((232,200,72)),q((200,160,48))
+W0=q((240,240,232))
+def concrete(seed=1):
+    im=Image.new('RGB',(16,16),C0); p=im.load(); r=random.Random(seed)
+    for y in range(16):
+        for x in range(16):
+            v=r.random(); p[x,y]=C1 if v<.06 else C2 if v<.11 else C0
+    for x in range(16): p[x,15]=C3 if x%8 else C1
+    return im
+def platform_edge():
+    im=concrete(2); p=im.load()
+    for x in range(16): p[x,0]=OUT; p[x,1]=W0; p[x,2]=W0
+    for y in range(5,9):
+        for x in range(16): p[x,y]=Y0
+    for y in (6,8):
+        for x in range(1,16,3): p[x,y]=Y1
+    return im
+# ballast + rails (from art_rail)
+import art_rail
+def track(): return art_rail.track()
+def ballast():
+    im=Image.new('RGB',(16,16),art_rail.B0); p=im.load(); r=random.Random(11)
+    for y in range(16):
+        for x in range(16):
+            v=r.random(); p[x,y]=art_rail.B1 if v<.07 else art_rail.B2 if v<.15 else art_rail.B3 if v<.22 else art_rail.B0
+    return im
+# train car, 6x2 tiles, transparent background
+TB0,TB1,TB2=q((56,88,160)),q((40,64,128)),q((80,120,192))
+TR0,TR1,TR2=q((200,202,208)),q((168,170,178)),q((128,130,140))
+GL0,GL1=q((176,212,236)),q((120,160,200))
+WS=q((236,236,228)); UC=q((48,48,58)); WH=q((96,96,108))
+def train(tiles=6):
+    w,h=tiles*16,32
+    im=Image.new('RGBA',(w,h),(0,0,0,0)); d=ImageDraw.Draw(im)
+    # roof
+    d.rectangle([1,1,w-2,8],fill=TR1); d.rectangle([2,1,w-3,3],fill=TR0); d.line([1,8,w-2,8],fill=TR2)
+    for x in range(10,w-10,16): d.rectangle([x,4,x+5,6],fill=TR2)   # roof vents
+    # body
+    d.rectangle([1,9,w-2,25],fill=TB0); d.line([1,9,w-2,9],fill=TB2)
+    for x in range(14,w-14,12):
+        d.rectangle([x,12,x+7,18],fill=GL0); d.line([x,12,x+7,12],fill=GL1); d.line([x,12,x,18],fill=GL1)
+    for x0 in (3,w-12):  # doors
+        d.rectangle([x0,11,x0+8,24],fill=TB1); d.rectangle([x0+2,13,x0+6,17],fill=GL0)
+    d.rectangle([1,20,w-2,21],fill=WS)
+    d.rectangle([1,24,w-2,25],fill=TB1)
+    # undercarriage + bogies
+    d.rectangle([4,26,w-5,28],fill=UC)
+    for bx in (8,w-24):
+        d.rectangle([bx,26,bx+15,30],fill=UC)
+        for wx in (bx+2,bx+10): d.ellipse([wx,26,wx+4,30],fill=WH,outline=UC)
+    # outline
+    d.rounded_rectangle([0,0,w-1,26],radius=3,outline=OUT)
+    return im
+def bench(base):
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    W0_,W1_,W2_=q((184,136,80)),q((152,104,56)),q((104,68,36))
+    d.rectangle([1,3,14,5],fill=W1_); d.line([1,3,14,3],fill=W0_)        # backrest
+    d.rectangle([1,7,14,10],fill=W0_); d.line([1,10,14,10],fill=W2_)     # seat
+    for x in (2,13): d.line([x,11,x,13],fill=W2_)
+    d.rectangle([1,3,14,10],outline=None)
+    return im
+def bench2(base):
+    """two-tile bench (32x16) over base tile pair."""
+    im=Image.new('RGBA',(32,16)); im.paste(base,(0,0)); im.paste(base,(16,0)); d=ImageDraw.Draw(im)
+    W0_,W1_,W2_=q((184,136,80)),q((152,104,56)),q((104,68,36))
+    d.rectangle([1,2,30,5],fill=W1_); d.line([1,2,30,2],fill=W0_); d.line([1,5,30,5],fill=W2_)
+    d.rectangle([1,7,30,10],fill=W0_); d.line([1,10,30,10],fill=W2_)
+    d.rectangle([0,1,31,11],outline=OUT)
+    for x in (3,15,28): d.line([x,12,x,14],fill=OUT)
+    return im
+def pillar(base_top,base_bot):
+    """iron canopy column, 1x2 tiles."""
+    im=Image.new('RGBA',(16,32)); im.paste(base_top,(0,0)); im.paste(base_bot,(0,16)); d=ImageDraw.Draw(im)
+    G0,G1,G2=q((72,112,88)),q((48,80,64)),q((104,144,112))
+    d.rectangle([3,0,12,3],fill=G1,outline=OUT)
+    d.rectangle([6,4,9,27],fill=G0); d.line([6,4,6,27],fill=G2); d.line([9,4,9,27],fill=G1)
+    d.rectangle([4,27,11,30],fill=G1,outline=OUT)
+    d.line([5,4,5,26],fill=OUT); d.line([10,4,10,26],fill=OUT)
+    return im
+def sign(base_l,base_r):
+    """station name board on two posts, 2x2 tiles."""
+    im=Image.new('RGBA',(32,32)); 
+    for i,b in enumerate((base_l,base_r)): im.paste(b[0],(i*16,0)); im.paste(b[1],(i*16,16))
+    d=ImageDraw.Draw(im)
+    for x in (5,26): d.rectangle([x,14,x+1,30],fill=q((64,64,72)))
+    d.rectangle([1,2,30,15],fill=W0,outline=OUT); d.rectangle([2,12,29,14],fill=q((48,88,168)))
+    ink=q((40,40,56))
+    # 台中
+    d.line([9,3,7,6],fill=ink); d.line([7,6,12,6],fill=ink); d.point([11,5],fill=ink)
+    d.rectangle([7,8,12,10],outline=ink)
+    d.rectangle([17,5,23,8],outline=ink); d.line([20,3,20,11],fill=ink)
+    return im
+def clock(base):
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    d.ellipse([2,1,13,12],fill=q((248,248,240)),outline=OUT)
+    d.line([7,7,7,3],fill=OUT); d.line([7,7,10,7],fill=OUT)
+    d.point([7,2],fill=q((200,48,48)))
+    return im
+def board(base_l,base_r):
+    """departure board on the wall, 2x1."""
+    im=Image.new('RGBA',(32,16)); im.paste(base_l,(0,0)); im.paste(base_r,(16,0)); d=ImageDraw.Draw(im)
+    d.rectangle([1,1,30,12],fill=q((32,56,48)),outline=OUT)
+    for y in (3,6,9):
+        d.line([3,y,12,y],fill=q((232,216,120))); d.line([15,y,28,y],fill=q((200,232,208)))
+    return im
+def gate(base):
+    """fare gate cabinet seen from the front (1x1), over a floor tile."""
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    G0,G1,G2=q((200,204,212)),q((156,160,172)),q((112,116,128))
+    d.rectangle([3,1,12,13],fill=G0,outline=OUT); d.rectangle([4,9,11,12],fill=G1)
+    d.rectangle([5,3,10,6],fill=q((48,56,64))); d.line([6,4,8,4],fill=q((112,224,120))); d.point([8,5],fill=q((112,224,120)))
+    d.line([3,14,12,14],fill=G2)
+    d.rectangle([0,7,2,9],fill=q((232,88,72)),outline=OUT); d.rectangle([13,7,15,9],fill=q((232,88,72)),outline=OUT)
+    return im
+def ticket_sign(base):
+    """small hanging 'tickets' plate."""
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    d.rectangle([1,3,14,11],fill=q((48,88,168)),outline=OUT)
+    for x in (3,7,11): d.rectangle([x,6,x+1,8],fill=W0)
+    return im
+def column(base_top,base_bot):
+    """stone hall column with a carved fruit capital (banana, pineapple, pomegranate), 1x2 tiles."""
+    im=Image.new('RGBA',(16,32)); im.paste(base_top,(0,0)); im.paste(base_bot,(0,16)); d=ImageDraw.Draw(im)
+    S0,S1,S2=q((236,228,208)),q((208,196,172)),q((168,156,136))
+    d.rectangle([2,0,13,6],fill=S0,outline=OUT); d.line([3,5,12,5],fill=S1)
+    d.rectangle([4,2,5,4],fill=q((240,208,72))); d.rectangle([7,1,8,4],fill=q((216,160,56))); d.point((7,1),fill=q((96,160,72)))
+    d.rectangle([10,2,11,4],fill=q((200,64,64)))
+    d.rectangle([4,7,11,27],fill=S0); d.line([4,7,4,27],fill=OUT); d.line([11,7,11,27],fill=OUT)
+    for x in (6,9): d.line([x,8,x,26],fill=S1)
+    d.line([10,7,10,27],fill=S2)
+    d.rectangle([3,27,12,30],fill=S1,outline=OUT)
+    return im
+FG0,FG1,FG2=q((72,112,88)),q((48,80,64)),q((104,144,112))
+def fence(base,end=None):
+    """low green iron railing between platform and concourse, over a ground tile."""
+    im=base.copy().convert('RGB'); p=im.load()
+    for y in (13,14):
+        for x in range(16):
+            r,g_,b=p[x,y]; p[x,y]=q((int(r*.82),int(g_*.82),int(b*.82)))
+    im=im.convert('RGBA'); d=ImageDraw.Draw(im)
+    for x in range(1,16,4):
+        d.line([x,7,x,12],fill=FG0); d.line([x+1,7,x+1,12],fill=OUT)
+    d.line([0,3,15,3],fill=OUT); d.line([0,4,15,4],fill=FG2); d.line([0,5,15,5],fill=FG0); d.line([0,6,15,6],fill=OUT)
+    d.line([0,11,15,11],fill=FG0); d.line([0,12,15,12],fill=OUT)
+    if end in ('l','r'):
+        x0=0 if end=='l' else 12
+        d.rectangle([x0,1,x0+3,13],fill=FG1,outline=OUT); d.line([x0+1,2,x0+1,12],fill=FG2)
+        d.rectangle([x0,0,x0+3,1],fill=FG2,outline=OUT)
+    return im
+def board_stand(base):
+    """departure board on two legs, 2x2, over the hall floor."""
+    im=Image.new('RGBA',(32,32))
+    for i in range(2):
+        for j in range(2): im.paste(base,(i*16,j*16))
+    d=ImageDraw.Draw(im)
+    for x in (6,25): d.rectangle([x,14,x+1,29],fill=q((64,64,72))); d.line([x-1,30,x+2,30],fill=OUT)
+    d.rectangle([1,1,30,16],fill=q((32,56,48)),outline=OUT); d.line([2,2,29,2],fill=q((64,96,84)))
+    for y in (4,8,12):
+        d.line([3,y,12,y],fill=q((232,216,120))); d.line([15,y,28,y],fill=q((200,232,208)))
+    return im
diff --git a/tools/taichung/gym_interiors/art_theater.py b/tools/taichung/gym_interiors/art_theater.py
