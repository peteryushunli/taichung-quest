@@ -0,0 +1,109 @@
+"""Generate native controller sweeps and isolated save fixtures for the three sites."""
+from collections import deque
+import json
+from pathlib import Path
+import struct
+import sys
+
+game, qa, seed_path = map(Path, sys.argv[1:])
+report = json.loads((qa/'towers/build-report.json').read_text())
+maps = report['maps']
+directions = ((1,0),(0,1),(-1,0),(0,-1))
+owners, world_walk, actors, warps, signs = {}, set(), set(), set(), set()
+layouts = json.loads((game/'data/layouts/layouts.json').read_text())['layouts']
+layout_ids = {row['id']:i+1 for i,row in enumerate(layouts) if row}
+for m in maps:
+    a,b,c,d = m['worldRect']
+    record = json.loads((game/'data/maps'/m['name']/'map.json').read_text())
+    m['layoutId'] = layout_ids[record['layout']]
+    for y,row in enumerate(m['localWalkable']):
+        for x,value in enumerate(row):
+            owners[a+x,b+y]=m
+            if value=='1':world_walk.add((a+x,b+y))
+    for key,target in [('object_events',actors),('warp_events',warps),('bg_events',signs)]:
+        target.update((a+e['x'],b+e['y']) for e in record[key])
+walk = world_walk-actors
+
+
+def fixture(start):
+    data=bytearray(seed_path.read_bytes())
+    m=owners[start];x=start[0]-m['worldRect'][0];y=start[1]-m['worldRect'][1]
+    for offset in range(0,0x1c000,0x1000):
+        section,_,signature,_=struct.unpack_from('<HHII',data,offset+0xff4)
+        if signature!=0x08012025 or section not in (0,1):continue
+        if section==0:
+            data[offset+9]|=1
+            length=0xf24
+        else:
+            struct.pack_into('<hh',data,offset,x,y)
+            for entry in (4,12):
+                struct.pack_into('<bbbBhh',data,offset+entry,43,m['number'],-1,0,x,y)
+            struct.pack_into('<H',data,offset+0x32,m['layoutId'])
+            length=0xf80
+        checksum=sum(struct.unpack_from(f'<{length//4}I',data,offset))&0xffffffff
+        struct.pack_into('<H',data,offset+0xff6,((checksum>>16)+checksum)&0xffff)
+    return data
+
+
+cases=[]
+for site in [dict(id='tower-gap',block=[75,110,95,126],approaches=[[84,125]]),dict(id='the-lin-guide',block=[54,138,60,144],approaches=[[57,141]])]:
+    a,b,c,d=site['block']
+    margin=4 if site['id']=='tower-gap' else 2
+    region=(a-margin,b-margin,c+margin,d+margin)
+    wanted={p for p in walk if region[0]<=p[0]<region[2] and region[1]<=p[1]<region[3]}
+    start=tuple(site['approaches'][0]);assert start in wanted
+    reached={start};pending=deque(reached)
+    while pending:
+        x,y=pending.popleft()
+        for dx,dy in directions:
+            to=(x+dx,y+dy)
+            if to in wanted and to not in reached:
+                reached.add(to);pending.append(to)
+    # Every walkable cell in the changed block must belong to this sweep.
+    assert {p for p in wanted if a<=p[0]<c and b<=p[1]<d}<=reached
+    points=sorted(reached);index={p:i for i,p in enumerate(points)}
+    graph=[];walls=[]
+    for x,y in points:
+        row=[];blocked=[]
+        for dx,dy in directions:
+            to=(x+dx,y+dy)
+            row.append(index.get(to,-1))
+            blocked.append(to in owners and to not in world_walk and to not in warps|actors|signs
+                           and a<=to[0]<c and b<=to[1]<d)
+        graph.append(row);walls.append(blocked)
+    remaining=[sum(1<<d for d,to in enumerate(row) if to>=0) for row in graph]
+    stack=[(index[start],-1)];edges=[]
+    while stack:
+        p,entered=stack[-1];options=remaining[p]
+        if not options:
+            stack.pop()
+            if entered>=0:edges.append(entered)
+            continue
+        straight=entered%4
+        side=straight if entered>=0 and options&(1<<straight) else (options&-options).bit_length()-1
+        remaining[p]^=1<<side;stack.append((graph[p][side],p*4+side))
+    edges.reverse()
+    assert len(edges)==sum(to>=0 for row in graph for to in row)
+    actions=[];used=set();wallbase=len(points)*4
+    for edge in edges:
+        p=edge//4
+        for side,blocked in enumerate(walls[p]):
+            probe=p*4+side
+            if blocked and probe not in used:used.add(probe);actions.append(wallbase+probe)
+        actions.append(edge)
+    native=[]
+    for x,y in points:
+        m=owners[x,y];native.append([m['number'],x-m['worldRect'][0],y-m['worldRect'][1]])
+    signwalls=[p*4+side for p,(x,y) in enumerate(points) for side,(dx,dy) in enumerate(directions) if (x+dx,y+dy) in signs]
+    case=dict(id=site['id'],start=native[index[start]],edges=len(edges),wallProbes=len(used),
+              graph=dict(points=native,neighbors=graph,signWalls=signwalls),actions=actions,
+              nativeMaps=sorted({p[0] for p in native}),worldRegion=region)
+    (qa/(site['id']+'.sav')).write_bytes(fixture(start))
+    photo={'tower-gap':(84,125),'the-lin-guide':(57,141)}[site['id']]
+    assert photo in reached
+    (qa/(site['id']+'-photo.sav')).write_bytes(fixture(photo))
+    case['photoStart']=native[index[photo]]
+    (qa/(site['id']+'-plan.json')).write_text(json.dumps(case,separators=(',',':'))+'\n')
+    cases.append({k:v for k,v in case.items() if k not in ('graph','actions')})
+(qa/'movement-cases.json').write_text(json.dumps(cases,indent=2)+'\n')
+print(json.dumps(cases,indent=2))
