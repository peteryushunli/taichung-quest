+        floor = {(x,y) for y in range(room.height) for x in range(room.width) if room.walkable(x,y)}
+        checks.require((6,3) in room.actors and len(floor)==65, "Expected integrated guide reservation/floor count changed")
+        return {"reference":opening_ref,"guideLocalId":"LOCALID_TAICHUNG_WELCOME_GUIDE","walkableCellsAfterGuide":len(floor),"frameTransitionResumeAndStarterGuardsRetained":True,
+                "reviewedOnboardingProfile":({"sourceCommit":approved_profile["sourceCommit"],"sourceOnly":True,
+                    "glyphPrefixRows":approved_profile["glyphPrefixRows"],"allowedLegacyBlockAlternatives":approved_profile["allowedLegacyBlockAlternatives"],
+                    "onboardingBaseCommit":approved_profile["onboardingBaseCommit"],"codebookBaseCommit":approved_profile["codebookBaseCommit"],"fontProfile":approved_profile["fontProfile"]}
+                    if onboarding["active"] and onboarding["passed"] else None),
+                "approvedNamedGuideGraphicsChange":({"localId":"LOCALID_TAICHUNG_WELCOME_GUIDE",
+                    "from":"OBJ_EVENT_GFX_WOMAN_1", "to":"OBJ_EVENT_GFX_TAICHUNG_XIAOYU"}
+                    if same_guide_map and not same_json_value(expected,data) else None)}
+
+    for label,function in (("generalCloneProtection",preserve_primary),("actualBankFormat",bank_integrity),("sourceRenderingAndAttributes",preserved_contexts),("actualLandmarkComposition",actual_landmarks),("oldCityBuildingsIncrement",oldcity_buildings),("geometryAndBindings",route_and_bindings),("sharedDistrictBankCohort",shared_cohort),("connectionPreviewStrips",seam_previews),("currentDynamicMetatileRoots",dynamic_roots),("mainWelcomeBindings",welcome)):
+        checks.section(label,function)
+    if self_test:
+        # Fault probes operate on private in-memory copies; never alter files.
+        probes = {}
+        damaged = deepcopy(bank)
+        first = min(reserved)
+        image = damaged.images[0]
+        sx,sy=first%(image.width//8)*8,first//(image.width//8)*8
+        image.putpixel((sx,sy),(image.getpixel((sx,sy))+1)%16)
+        probes["protectedGraphicCorruptionDetected"] = damaged.graphic(first)!=reference.graphic(first)
+        damaged = deepcopy(bank)
+        damaged.defs[1][0] = (damaged.defs[1][0]&~1023)|1016
+        probes["doorScratchReferenceDetected"] = any((e&1023)>=1016 for e in damaged.defs[1])
+        damaged = deepcopy(bank)
+        damaged.attrs[1][0] ^= 0x20000000
+        probes["layerCorruptionDetected"] = damaged.attr(640)!=bank.attr(640)
+        if buildings:
+            compiled, installed = current.words(manifest["mapFile"]), current.words(OLDCITY_MAP)
+            edited = next(i for i,(a,b) in enumerate(zip(compiled,installed)) if a!=b)
+            other = next(i for i,w in enumerate(compiled) if (i%40,i//40) not in strip and (w&1023) not in GENERIC_APARTMENTS and w!=installed[edited])
+            for name,index,word in (("CollisionChange",edited,installed[edited]^0x400),("GreenwayStripEdit",52*40,installed[edited]),("NonApartmentEdit",other,installed[edited])):
+                damaged_grid = list(installed)
+                damaged_grid[index] = word
+                probes["oldCityBuildings"+name+"Rejected"] = bool(oldcity_building_edit_errors(compiled,damaged_grid,strip))
+        # Explicit guide-casting exceptions remain field-level, never file-wide.
+        for map_name, local_id in (("TaichungOldCity","LOCALID_TAICHUNG_STATION_GUIDE"),
+                                   ("TaichungStationWelcome","LOCALID_TAICHUNG_WELCOME_GUIDE")):
+            original = deepcopy(current.json(f"data/maps/{map_name}/map.json"))
+            index = next(i for i,obj in enumerate(original["object_events"]) if obj["local_id"] == local_id)
+            original["object_events"][index]["graphics_id"] = "OBJ_EVENT_GFX_WOMAN_1"
+            approved = deepcopy(original)
+            approved["object_events"][index]["graphics_id"] = "OBJ_EVENT_GFX_TAICHUNG_XIAOYU"
+            probes[map_name+"NamedGuideCastAccepted"] = matches_approved_xiaoyu_graphics(original,approved,map_name)
+            for field, value in (("x",original["object_events"][index]["x"]+1),("script","UnapprovedScript"),
+                                 ("local_id","UNAPPROVED_GUIDE"),("graphics_id","OBJ_EVENT_GFX_WOMAN_2"),
+                                 ("x",float(original["object_events"][index]["x"]))):
+                changed = deepcopy(approved)
+                changed["object_events"][index][field] = value
+                probes[map_name+field+str(value)+"Rejected"] = not matches_approved_xiaoyu_graphics(original,changed,map_name)
+            changed = deepcopy(approved)
+            changed["warp_events"] = [{"x":1,"y":1}]
+            probes[map_name+"WarpChangeRejected"] = not matches_approved_xiaoyu_graphics(original,changed,map_name)
+            changed = deepcopy(approved)
+            changed["object_events"].append(deepcopy(changed["object_events"][index]))
+            probes[map_name+"ExtraActorRejected"] = not matches_approved_xiaoyu_graphics(original,changed,map_name)
+        if reviewed_onboarding_profile(current)["active"]:
+            probes.update(onboarding_profile_fault_probes(current))
+        checks.require(all(probes.values()), "An in-memory native fault probe failed")
+        checks.results["faultProbes"]={"passed":all(probes.values()),**probes}
+    checks.warnings.append("Runtime door animation/primary reloads, walking/cycling layering and Main-owned old-save map-cache migration remain unproven by static checks.")
+    snapshot = sorted((path,digest(raw)) for path,raw in current.cache.items())
+    return {"result":"pass" if not checks.errors else "fail","scope":"actual installed/proposed source; no source writes or runtime claim","checkerSha256":digest(Path(__file__).read_bytes()),"manifest":str(manifest_path),"manifestSha256":digest(current.read(manifest_path)),"sourceReadFingerprint":digest(json.dumps(snapshot).encode()),"sourceFilesFingerprinted":len(snapshot),"auditReference":audit_ref,"openingReference":opening_ref,"checks":checks.results,"errors":checks.errors,"warnings":checks.warnings,"saveMapCacheCompatibility":{"owner":"Main","newGeometryAndMetatileIdsRequireReview":True,"migrationOrInvalidationImplementedByThisChecker":False,"verifiedWithPreRetileContinue":False},"engineSafetyClaim":False,"nativeRuntimeTested":False}
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source",type=Path,default=ROOT)
+    parser.add_argument("--manifest",type=Path,default=Path(DEFAULT_MANIFEST))
+    parser.add_argument("--audit-reference",default="a155d17")
+    parser.add_argument("--opening-reference",default="21c08cb")
+    parser.add_argument("--self-test",action="store_true")
+    parser.add_argument("--json",action="store_true")
+    args=parser.parse_args()
+    result=check(args.source.resolve(),args.manifest,args.audit_reference,args.opening_reference,args.self_test)
+    if args.json:
+        print(json.dumps(result,indent=2))
+    else:
+        print(f"Old-core native checks: {result['result'].upper()}")
+        for label,details in result["checks"].items():print(f"  {label}: {'PASS' if details['passed'] else 'FAIL'}")
+        for message in result["errors"]:print("ERROR:",message)
+        for message in result["warnings"]:print("NOTE:",message)
+    raise SystemExit(0 if result["result"]=="pass" else 1)
+
+
+if __name__=="__main__":
+    main()
