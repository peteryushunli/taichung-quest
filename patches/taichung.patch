+void TaichungGym_ScriptGetParkMessage(void)
+{
+    u16 message = gSpecialVar_0x8005;
+    if (message >= ARRAY_COUNT(sMessages))
+        message = TAICHUNG_GYM_MESSAGE_UNAVAILABLE;
