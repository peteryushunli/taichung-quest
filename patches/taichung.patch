+    if (sourceVersion < 4 && IsXitun(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sXitunV4Relocations, sizeof(sXitunV4Relocations) / sizeof(sXitunV4Relocations[0]));
+    if (sourceVersion < 5 && IsGreenway(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sGreenwayV5Relocations, sizeof(sGreenwayV5Relocations) / sizeof(sGreenwayV5Relocations[0]));
+    if (sourceVersion < 6 && IsGreenway(warp) && warp->warpId == -1)
+        ApplyRelocation(warp, sGreenwayV6Relocations, sizeof(sGreenwayV6Relocations) / sizeof(sGreenwayV6Relocations[0]));
+}
