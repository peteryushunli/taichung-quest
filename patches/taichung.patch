+static const u8 sBulbasaurZh[] = _("妙蛙種子");
+static const u8 sSquirtleEn[] = _("SQUIRTLE");
+static const u8 sSquirtleZh[] = _("傑尼龜");
+static const u8 sPikachuEn[] = _("PIKACHU");
+static const u8 sPikachuZh[] = _("皮卡丘");
+
+void TaichungOpening_ScriptIsWelcomeRoom(void)
