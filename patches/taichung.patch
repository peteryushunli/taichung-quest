+
+bool8 TaichungTeamSpeciesAllowed(u16 species)
+{
+    return species >= SPECIES_BULBASAUR && species <= SPECIES_MEWTWO;
+}
+
+const u16 *TaichungTeamGetPresetMoves(u16 species)
+{
+    if (!TaichungTeamSpeciesAllowed(species))
+        return NULL;
+    return sTaichungTeamPresetMoves[species - SPECIES_BULBASAUR];
+}
+
+void TaichungTeamApplyPreset(struct Pokemon *mon)
+{
+    const u16 *moves;
+    u8 slot;
+    u8 ppBonuses = 0;
+
+    if (mon == NULL)
+        return;
+    moves = TaichungTeamGetPresetMoves(GetMonData(mon, MON_DATA_SPECIES, NULL));
+    if (moves == NULL)
+        return;
+
+    // Reset old PP Ups before installing a different moveset.
+    SetMonData(mon, MON_DATA_PP_BONUSES, &ppBonuses);
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+        SetMonMoveSlot(mon, moves[slot], slot);
+}
