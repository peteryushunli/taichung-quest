+def fit_landmarks(source, plan_dir, plan):
+    """Landmark number -> (render on real tiles, {cell render bytes: walkable class}). Landmarks
+    with a tile-efficient redraw (landmark_redraw.py) use it; the rest show the board's set piece
+    fitted to today's palettes."""
+    rects = {l["n"]: l["rect"] for l in plan["newLandmarks"]}
+    pieces = landmark_tiles.load_setpieces(plan_dir)
+    banks = {name: landmark_tiles.Bank(source, *spec) for name, spec in landmark_tiles.BANKS.items()}
+    redrawn = landmark_redraw.redraw(source)
+    out = {}
+    for n, (name, bank, _) in landmark_tiles.LANDMARKS.items():
+        x0, y0, x1, y1 = rects[n]
+        if n in redrawn:
+            render = redrawn[n].render
+        else:
+            render, _, _ = landmark_tiles.fit_landmark(banks[bank], pieces[name](x1 - x0, y1 - y0))
+        if n in redrawn:
+            tiles, bank = redrawn[n].bank, landmark_redraw.LANDMARKS[n][1]
+        else:
+            tiles = landmark_redraw.Tiles(source, *landmark_tiles.BANKS[bank][:2])
+        open_cells = {tiles.render_layers(tiles.layers(m)).tobytes(): cls for m, cls in OPEN_CELLS[bank].items()}
+        out[n] = (render, open_cells)
+    return out, redrawn
