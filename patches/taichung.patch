+    ('TaichungMiyahara_Gym', 'MIYAHARA', 'WOMAN_2', 'Miyahara'),
+    ('TaichungPark_Gym', 'PARK', 'MAN', 'Park'),
+    ('TaichungShenJi_Gym', 'SHEN_JI', 'LASS', 'ShenJi'),
+    ('TaichungFineArts_Gym', 'FINE_ARTS', 'WOMAN_1', 'FineArts'),
