+ROOT = Path(__file__).resolve().parents[3]
+PROJECT = ROOT.parents[1]
+DEFAULT_MANIFEST = "data/taichung/landmarks/old-core-native/manifest.json"
+GENERAL = "data/tilesets/primary/general"
+PEWTER = "data/tilesets/secondary/pewter_city"
+DISTRICTS = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def number(value):
+    return int(value, 0) if isinstance(value, str) and value.lower().startswith("0x") else int(value)
+
+
+def same_json_value(before, after):
+    # Preserve scalar types as well as values: JSON false/0 and 3/3.0 differ.
+    return json.dumps(before, sort_keys=True, separators=(",", ":")) == json.dumps(after, sort_keys=True, separators=(",", ":"))
