+void TaichungEncounter_ScriptChooseReplacement(void)
+{
+    sReturnSite = TaichungEncounterGetCurrentSite();
+    sMenuReturnScript = TaichungEncounter_ConfirmReplacement;
+    gSpecialVar_0x8004 = PARTY_SIZE;
+    CleanupOverworldWindowsAndTilemaps();
+    InitPartyMenu(PARTY_MENU_TYPE_FIELD, PARTY_LAYOUT_SINGLE, PARTY_ACTION_CHOOSE_AND_CLOSE,
+                  FALSE, PARTY_MSG_CHOOSE_MON, Task_HandleChooseMonInput, CB2_ReturnFromEncounterMenu);
+}
+
+void TaichungEncounter_ScriptConfirmReplacement(void)
+{
+    gSpecialVar_Result = CaughtSite() != NULL && gSpecialVar_0x8004 < CalculatePlayerPartyCount();
+    if (gSpecialVar_Result)
+    {
+        BufferTarget();
+        StringCopy(gStringVar2, gStringVar1);
+        GetMonNickname(&gPlayerParty[gSpecialVar_0x8004], gStringVar1);
+        StringExpandPlaceholders(gStringVar4, TaichungText(sConfirmReplaceEn, sConfirmReplaceZh));
+    }
+}
+
+void TaichungEncounter_ScriptReplaceWithCaught(void)
+{
+    const struct TaichungEncounterSite *site = CaughtSite();
+    u16 slot = gSpecialVar_0x8004;
+    if (site != NULL && slot < CalculatePlayerPartyCount() && TaichungTeamSetSlot(slot, site->species))
+    {
+        BufferTarget();
+        StringExpandPlaceholders(gStringVar4, TaichungText(sJoinedEn, sJoinedZh));
+    }
+    else
+        StringCopy(gStringVar4, TaichungText(sUseTeamEn, sUseTeamZh));
+}
