+#!/usr/bin/env python3
+"""Prove V3 frontage continuity, preserved geometry, native encoding and hashes."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+from tempfile import TemporaryDirectory
+
+from color_check import check as check_native_colors
+from color_compile import compile_colorways, native_tile_images
+from library import ROOT, parse_words, render_tools, require
+from neighborhood_frontage import compile_frontage, fill_frontage
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(output, previous):
+    output = Path(output); previous = [Path(p) for p in previous]
+    require(len(previous) >= 2, 'Pass both preserved V1 and V2 directories')
+    before = {str(folder): {str(p.relative_to(folder)): sha(p) for p in folder.rglob('*') if p.is_file()} for folder in previous}
+    require(all(before.values()), 'Preserved fixture directories must contain artifacts')
+    layout_path = ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json'
+    layout = json.loads(layout_path.read_text()); compiled, blocks, units = compile_frontage(output, layout)
+    baseline = compile_colorways()
+    for field in ('graphics', 'metatiles', 'attributes', 'palettes', 'remaps'):
+        require(compiled[field] == baseline[field], f'Attached source variants unexpectedly change native {field}')
+    source_ids = lambda c: {w & 1023 for p in c['library'].prefabs.values() for row in parse_words(p) for w in row}
+    added_source = source_ids(compiled) - source_ids(baseline)
+    require(added_source <= {0x16e}, 'Attached facades introduce unverified source metatiles')
+    original = render_tools().render_metatiles(ROOT, 'General', 'PewterCity')
+    for tile, image in native_tile_images(compiled, added_source).items():
+        require(image.tobytes() == original[tile].tobytes(), 'Clear source apron render differs')
+    proof = check_native_colors()
+    result = fill_frontage(compiled, layout, blocks, units); repeat = fill_frontage(compiled, layout, blocks, units)
+    require(result['words'] == repeat['words'] and result['placements'] == repeat['placements'], 'Frontage composition is nondeterministic')
+    raw = (output / 'filled-map.bin').read_bytes()
+    require(list(struct.unpack('<4096H', raw)) == result['words'], 'Saved V3 words differ from validated words')
+    invariants = result['roads'] | result['approaches'] | result['gymReserves']
+    for folder in previous:
+        older = struct.unpack('<4096H', (folder / 'filled-map.bin').read_bytes())
+        for x, y in invariants:
+            require(result['words'][y * 64 + x] == older[y * 64 + x], f'Road/gym/arrival cell changed vs {folder.name} at {x},{y}')
+        old_report = json.loads((folder / 'validation.json').read_text())
+        require(old_report['sourceLayoutSha256'] == result['report']['sourceLayoutCanonicalJsonSha256'], 'Approved layout changed')
+    # Offset relocation is the native integrator's actual merge route. Verify
+    # every roof's displayed pixels, rather than only the numeric offset.
+    with TemporaryDirectory(prefix='taichung-frontage-offset-') as temp:
+        moved, moved_blocks, moved_units = compile_frontage(temp, layout, variant_metatile_start=900)
+        shifted = fill_frontage(moved, layout, moved_blocks, moved_units)
+        require(min(v for m in moved['remaps'].values() for v in m.values()) == 900, 'Requested metatile offset not honored')
+        original_images = native_tile_images(compiled)
+        moved_images = native_tile_images(moved)
+        for family, mapping in compiled['remaps'].items():
+            for source_id, target in mapping.items():
+                require(original_images[target].tobytes() == moved_images[moved['remaps'][family][source_id]].tobytes(), 'Relocation changes roof rendering')
+        require(all((a & 0xfc00) == (b & 0xfc00) for a, b in zip(result['words'], shifted['words'])), 'Relocation changes collision/elevation')
+    bank = output / 'native-color-bank'; pixels = (bank / 'tiles.4bpp').read_bytes()
+    unpacked = [tuple(v for byte in pixels[i:i + 32] for v in (byte & 15, byte >> 4)) for i in range(0, len(pixels), 32)]
+    require(unpacked == compiled['graphics'], 'Saved native 4bpp roundtrip differs')
+    entries_raw = (bank / 'metatiles.bin').read_bytes(); entries = struct.unpack(f'<{len(entries_raw) // 2}H', entries_raw)
+    require(list(entries) == [v for row in compiled['metatiles'] for v in row], 'Saved native metatile roundtrip differs')
+    attr_raw = (bank / 'metatile_attributes.bin').read_bytes()
+    require(list(struct.unpack(f'<{len(attr_raw) // 4}I', attr_raw)) == compiled['attributes'], 'Saved attributes roundtrip differs')
+    native_palette = struct.unpack('<16H', (bank / '12.gbapal').read_bytes())
+    require([((v & 31) * 8, ((v >> 5) & 31) * 8, ((v >> 10) & 31) * 8) for v in native_palette] == compiled['palettes'][12], 'Saved BGR555 palette differs')
+    for folder in previous:
+        after = {str(p.relative_to(folder)): sha(p) for p in folder.rglob('*') if p.is_file()}
+        require(after == before[str(folder)], f'Preserved artifact files changed: {folder}')
+    report = dict(result='pass', preservedPreviousFixtureHashes=before,
+        invariantCellsComparedPerVersion=len(invariants), previousVersionsCompared=len(previous),
+        fullWidthStreetwallTiles=result['report']['fullWidthStreetwallTiles'], streetwallGapCells=0,
+        unchangedBaseNativeBank=True, introducedGraphicsOrMetatiles=0,
+        independentSourceRenders=proof['baseMetatileRendersCompared'] + len(added_source), independentRoofRemapRenders=proof['roofRemapRendersCompared'],
+        graphics4bppRoundtripped=len(unpacked), metatileU16EntriesRoundtripped=len(entries), attributeU32EntriesRoundtripped=len(compiled['attributes']),
+        bgr555PaletteColorsRoundtripped=16, offset900RoofRendersCompared=32,
+        savedMapSha256=sha(output / 'filled-map.bin'), geometryAndReachability=result['report'])
+    (output / 'frontage-checks.json').write_text(json.dumps(report, indent=2) + '\n')
+    sources = [
+        'tools/taichung/streetscape/neighborhood_frontage.py', 'tools/taichung/streetscape/neighborhood_frontage_check.py',
+        'tools/taichung/streetscape/neighborhood_density.py', 'tools/taichung/streetscape/neighborhood_fill.py',
+        'tools/taichung/streetscape/neighborhood_pilot.py', 'tools/taichung/streetscape/color_compile.py',
+        'tools/taichung/streetscape/color_check.py', 'tools/taichung/streetscape/library.py',
+        'tools/taichung/geography/profile_pilot.py', 'tools/taichung/render_maps.py',
+        'data/taichung/prefabs/catalog.json', 'data/taichung/prefabs/colorways.json',
+        'data/taichung/neighborhoods/pilot-r2c2-layout.json',
+        'graphics/object_events/pics/people/red_normal.png', 'graphics/object_events/palettes/player.pal',
+    ]
+    for folder in ('primary/general', 'secondary/pewter_city'):
+        path = ROOT / 'data/tilesets' / folder
+        sources.extend(str((path / name).relative_to(ROOT)) for name in ('tiles.png', 'metatiles.bin', 'metatile_attributes.bin'))
+        sources.extend(str(p.relative_to(ROOT)) for p in sorted((path / 'palettes').glob('*.pal')))
+    provenance = dict(schemaVersion=1, status='V3 unregistered source-native review fixture',
+        geometry='24 approved lots retained; seven new infill strips are explicit authored game additions, not actual footprints',
+        art='Recombined General/Pewter FireRed source tiles. No bespoke Taiwan raster art. Four native roof color ramps share palette12.',
+        frontageConvention='South-facing native facade convention; roofs do not imply real building heights or parcel orientations.',
+        roadApronContract='Ten infill apron cells reserve existing road edge cells without painting/changing them. All building solids remain off roads.',
+        nativeRegistration=False, sourceFilesSha256={name: sha(ROOT / name) for name in sources},
+        emittedFilesSha256={str(p.relative_to(output)): sha(p) for p in sorted(output.rglob('*')) if p.is_file() and p.name != 'provenance.json'})
+    (output / 'provenance.json').write_text(json.dumps(provenance, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in report.items() if k not in ('preservedPreviousFixtureHashes', 'geometryAndReachability')}, indent=2))
+    return report
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--previous', type=Path, action='append', required=True)
+    args = parser.parse_args(); check(args.output, args.previous)
diff --git a/tools/taichung/streetscape/neighborhood_pilot.py b/tools/taichung/streetscape/neighborhood_pilot.py
new file mode 100644
index 00000000..813ec0f5
--- /dev/null
+++ b/tools/taichung/streetscape/neighborhood_pilot.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""One progressive, game-scale block study with native indexed roof colorways."""
+import argparse
+from collections import deque
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image,ImageDraw
+
+from color_compile import compile_colorways,color_grid,native_tile_images,save_native
+from library import ROOT,WALK,require
+
+
+def pilot_plan():
+    return dict(schemaVersion=1,status='single unregistered source block study; palette-index colors; not installed in ROM',
+        width=32,height=24,profileId='city-v2-r2-c2',archetype='old-mixed-residential',spawn=[29,14],
+        exits=[[0,13],[31,13],[29,0],[29,23]],
+        groundRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,16,26,23]],
+        protectedRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,23,31,23],[0,0,0,23],[31,0,31,23]],
+        placements=[
+            dict(id='old-home-a',prefab='building-rowhouse-compact',x=1,y=0,colorway='terracotta',context='residential'),
+            dict(id='old-home-b',prefab='building-rowhouse-compact',x=7,y=0,colorway='source',context='residential'),
+            dict(id='old-home-c',prefab='building-rowhouse-compact',x=13,y=0,colorway='slate',context='residential'),
+            dict(id='old-home-pair',prefab='building-rowhouse-pair',x=1,y=6,colorway='terracotta',context='residential'),
+            dict(id='old-home-d',prefab='building-rowhouse-compact',x=13,y=6,colorway='source',context='residential'),
+            dict(id='new-walkup',prefab='building-walkup-tall',x=21,y=2,colorway='teal',context='residential'),
+            dict(id='shop-corner',prefab='building-corner-store',x=1,y=18,colorway='mustard',context='shopping'),
+            dict(id='shop-wide',prefab='building-shopfront-wide',x=8,y=17,colorway='source',context='shopping'),
+            dict(id='market-a',prefab='stall-market-red',x=17,y=19,colorway='source',context='market'),
+            dict(id='market-b',prefab='stall-market-red',x=22,y=19,colorway='source',context='market'),
+            dict(id='front-lawn-shrub',prefab='prop-shrub',x=19,y=0,context='residential'),
+            dict(id='side-lawn-shrub',prefab='prop-shrub',x=26,y=1,context='residential'),
+            dict(id='front-flowers',prefab='prop-flower-bed',x=19,y=10,context='residential'),
+            dict(id='corner-sign',prefab='prop-sign-board',x=26,y=10,context='street')])
+
+
+def make_pilot(compiled,plan):
+    width,height=plan['width'],plan['height'];base=[0x3001]*(width*height);protected=set()
+    for x0,y0,x1,y1 in plan['groundRects']:
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):base[y*width+x]=0x3175
+    for x0,y0,x1,y1 in plan['protectedRects']:
+        protected|={(x,y) for y in range(y0,y1+1) for x in range(x0,x1+1)}
+    source_placements=[{k:v for k,v in p.items() if k!='colorway'} for p in plan['placements']]
+    composed=compiled['library'].compose(width,height,source_placements,base=base,protected_paths=protected)
+    words=color_grid(compiled,composed,plan['placements'])
+    def attr(word):
+        t=word&1023
+        return compiled['library'].attr(t) if t<640 else compiled['attributes'][t-640]
+    def walk(x,y):
+        if not(0<=x<width and 0<=y<height):return False
+        w=words[y*width+x]
+        return not w&0xc00 and w>>12==3 and attr(w)&0x1ff in WALK
+    spawn=tuple(plan['spawn']);seen={spawn};queue=deque([spawn]);require(walk(*spawn),'Player reference is not on clear ground')
+    while queue:
+        x,y=queue.popleft()
+        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
+            n=(x+dx,y+dy)
+            if n not in seen and walk(*n):seen.add(n);queue.append(n)
+    for exit in plan['exits']:require(tuple(exit) in seen,f'Blocked pilot egress:{exit}')
+    for e in composed['entrances']:
+        require(e['status']=='dormant-reservation','Pilot cannot contain an active unregistered door')
+        require(tuple(e['southApproach']) in seen,f'Unreachable building approach:{e}')
+    for i,w in enumerate(words):
+        require((w&0xfc00)==(composed['words'][i]&0xfc00),'Coloring changed collision/elevation')
+        require(attr(w)&0x1ff not in range(0x60,0x70),'Pilot contains accidental warp behavior')
+    colors=sorted({p['colorway'] for p in plan['placements'] if p.get('colorway') not in (None,'source')})
+    require({'terracotta','teal','mustard'}<=set(colors),'Pilot needs three new material colors simultaneously')
+    result=dict(result='pass',dimensions=[width,height],reachableCells=len(seen),solidCells=composed['solidCells'],
+        exits=plan['exits'],reservedEntrances=len(composed['entrances']),colorwaysSimultaneous=colors,
+        profileId=plan['profileId'],status='source fixture checked; native ROM registration/playtest remains with mapping integrator',
+        nativeBankBudget=compiled['budget'])
+    return words,result
+
+
+def player_reference(source):
+    path=Path(source)/'graphics/object_events/pics/people/red_normal.png'
+    palette_path=Path(source)/'graphics/object_events/palettes/player.pal'
+    if not(path.exists() and palette_path.exists()):return None
+    source_image=Image.open(path);palette=[tuple(map(int,s.split())) for s in palette_path.read_text().splitlines()[3:] if s.strip()]
+    image=Image.new('RGBA',(16,32))
+    for y in range(32):
+        for x in range(16):
+            i=source_image.getpixel((x,y))
+            if i:image.putpixel((x,y),(*palette[i],255))
+    return image
+
+
+def write_pilot(output):
+    output=Path(output);output.mkdir(parents=True,exist_ok=True)
+    compiled=compile_colorways();plan=pilot_plan();words,validation=make_pilot(compiled,plan)
+    tiles=native_tile_images(compiled,{w&1023 for w in words});image=Image.new('RGB',(32*16,24*16))
+    for i,w in enumerate(words):image.paste(tiles[w&1023],(i%32*16,i//32*16))
+    player=player_reference(compiled['library'].source)
+    if player:
+        x,y=plan['spawn'];image.paste(player,(x*16,y*16-16),player)
+    image.save(output/'pilot-block-native.png')
+    # The frame is an engineering caption; the inner map is exact native pixels.
+    board=Image.new('RGB',(image.width*2,image.height*2+96),'#e9efeb');board.paste(image.resize((image.width*2,image.height*2),Image.Resampling.NEAREST),(0,64))
+    draw=ImageDraw.Draw(board);draw.text((12,10),'OLD CORE BLOCK STUDY / actual indexed roof colors / source prefabs',fill='#18382d')
+    draw.text((12,28),'Older homes + new walk-up above; close retail and market frontage below. Player is a native16x32 scale reference.',fill='#36594b')
+    draw.text((12,46),'32x24 metatiles. Preview only; regional profile weights are authored, not a parcel survey.',fill='#36594b')
+    draw.text((12,board.height-24),'One palette12 supports terracotta / teal / mustard / slate together; existing blue / red / cream remain.',fill='#36594b')
+    board.save(output/'pilot-block-overview.png')
+    # A native-resolution camera crop for scale, rather than a fabricated emulator frame.
+    image.crop((11*16,8*16,26*16,18*16)).save(output/'pilot-camera-crop-240x160.png')
+    (output/'pilot-map.bin').write_bytes(struct.pack(f'<{len(words)}H',*words))
+    (output/'pilot-plan.json').write_text(json.dumps(plan,indent=2)+'\n')
+    profile=ROOT/'data/taichung/neighborhoods/pilot-profile.json'
+    validation['sourceProfile']=str(profile.relative_to(ROOT)) if profile.exists() else None
+    if profile.exists():validation['authoredProfileTargets']=json.loads(profile.read_text())['section']['authoredVisualTargets']
+    (output/'pilot-validation.json').write_text(json.dumps(validation,indent=2)+'\n')
+    save_native(compiled,output/'native-color-bank')
+    print(json.dumps({k:v for k,v in validation.items() if k not in ('nativeBankBudget','authoredProfileTargets')},indent=2))
+    print(output/'pilot-block-overview.png')
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--output',type=Path,required=True);args=parser.parse_args();write_pilot(args.output)
