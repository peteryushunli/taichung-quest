@@ -0,0 +1,286 @@
+#!/usr/bin/env python3
+"""Validate final approved-art collision independently and generate save-v11 tables.
+
+The manifest is integration input, never collision truth. Old maps come from the
+fixed v10 native commit; current source attributes, connections and authored
+events produce independent walking reachability and the exact repair origin set.
+Historical v10 tables are never regenerated by this script.
+"""
+from __future__ import annotations
+
+import argparse
+import contextlib
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).resolve().parents[2]
+BASELINE='2362263510dfa38987c36b6cc40dca8d9372fc3c'
+RECORD=Path('data/taichung/approved-landmarks/save-v11.json')
+OUTPUT=Path('src/data/taichung/approved_art_save_v11.h')
+VALIDATION=Path('data/taichung/approved-landmarks/save-v11-validation.json')
+MAPS={
+    'MAP_TAICHUNG_OLD_CITY':'TaichungOldCity',
+    'MAP_TAICHUNG_GREENWAY':'TaichungGreenway',
+    'MAP_TAICHUNG_OLD_CITY_NORTH':'TaichungOldCityNorth',
+    'MAP_TAICHUNG_NANTUN_NORTH':'TaichungNantunNorth',
+    'MAP_TAICHUNG_NANTUN_WANHE':'TaichungNantunWanhe',
+}
+STATION=('MAP_TAICHUNG_OLD_CITY',30,66)
+
+
+def digest(raw):return hashlib.sha256(raw).hexdigest()
+
+
+def module(path):
+    spec=importlib.util.spec_from_file_location('approved_art_save_geometry',path)
+    result=importlib.util.module_from_spec(spec);spec.loader.exec_module(result)
+    return result
+
+
+def beneath_newer_layers(root):
+    """The tree beneath the later guest house layer (tools/taichung/home_start.py),
+    whose own guard proves it only opens signpost cells and makes one solid painted
+    door a working door, so no saved position needs a new repair. It also peels the
+    newer gym interiors layer, which only changes rooms that save v12 reloads on
+    their exit mat. A tree without those exact layers is used as it is."""
+    path=Path(root)/'tools/taichung/home_start.py'
+    if not path.exists():return contextlib.nullcontext(Path(root))
+    return module(path).beneath(root)
+
+
+def validator(source,rules):
+    contract=json.loads((source/'docs/taichung-city-contract.json').read_text())
+    result=rules.Validator(source,contract)
+    if result.errors:raise ValueError('; '.join(result.errors))
+    if not result.maps[STATION[0]].walkable(*STATION[1:]):
+        raise ValueError('Station checkpoint is not walkable')
+    return result,result.flood(STATION,result.district_ids)
+
+
+def derive(root=ROOT):
+    """Derive actual newly invalid cells and deterministic safe targets, not placeholders."""
+    with beneath_newer_layers(root) as view:
+        return _derive(view)
+
+
+def _derive(root):
+    root=Path(root)
+    report=json.loads((root/'data/taichung/approved-landmarks/integration-report.json').read_text())
+    if not report.get('installed') or report.get('baseline')!=BASELINE:
+        raise ValueError('Final approved-art maps are not installed against the expected baseline')
+    rules=module(root/'tools/taichung/validate_city.py')
+    current,current_reached=validator(root,rules)
+    archive=subprocess.check_output(['git','-C',str(root),'archive',BASELINE,
+        'data','src/data','docs/taichung-city-contract.json'])
+    record={'schemaVersion':1,'baselineNativeCommit':BASELINE,'maps':[]}
+    with tempfile.TemporaryDirectory(prefix='approved-art-save-derive-') as tmp:
+        before=Path(tmp);subprocess.run(['tar','-x','-C',str(before)],input=archive,check=True)
+        old,old_reached=validator(before,rules)
+        for mid,name in sorted(MAPS.items()):
+            a,b=old.maps[mid],current.maps[mid]
+            native_warps={(w['x'],w['y']) for w in b.data.get('warp_events',[])}
+            safe=[(x,y) for m,x,y in current_reached if m==mid
+                  and (x,y) not in native_warps and b.behavior(x,y)!=0x02]
+            if not safe:raise ValueError(f'{mid}: no safe target')
+            repairs=[]
+            for y in range(a.height):
+                for x in range(a.width):
+                    if not a.ground(x,y):continue
+                    if b.ground(x,y) and not ((mid,x,y) in old_reached and (mid,x,y) not in current_reached):continue
+                    def rank(point):
+                        dx,dy=point[0]-x,point[1]-y
+                        side=0 if dy>0 else 1 if dx<0 else 2 if dx>0 else 3
+                        return abs(dx)+abs(dy),side,point[1],point[0]
+                    tx,ty=min(safe,key=rank)
+                    repairs.append([x,y,tx,ty])
+            old_sha=digest((before/a.layout['blockdata_filepath']).read_bytes())
+            new_sha=digest((root/b.layout['blockdata_filepath']).read_bytes())
+            bound=report['maps'][name]
+            if (bound['mapId'],bound['oldMapSha256'],bound['newMapSha256'])!=(mid,old_sha,new_sha):
+                raise ValueError(f'{mid}: installer binding differs from actual maps')
+            record['maps'].append({'mapId':mid,'width':b.width,'height':b.height,
+                'oldMapSha256':old_sha,'newMapSha256':new_sha,'repairs':repairs})
+    return record
+
+
+def validate(root=ROOT,manifest=None):
+    manifest=Path(manifest or Path(root)/RECORD)
+    with beneath_newer_layers(root) as view:
+        return _validate(view,manifest)
+
+
+def _validate(root,manifest):
+    root=Path(root)
+    record=json.loads(manifest.read_text())
+    if record.get('schemaVersion')!=1 or record.get('baselineNativeCommit')!=BASELINE:
+        raise ValueError('Expected schema1 against the latest Claude v10 source2362263')
+    entries=record.get('maps',[])
+    if len(entries)!=len(MAPS) or {m.get('mapId') for m in entries}!=set(MAPS):
+        raise ValueError('Save-v11 manifest must name each of the five changed-bank maps exactly once')
+    integration=json.loads((root/'data/taichung/approved-landmarks/integration-report.json').read_text())
+    if not integration.get('installed') or integration.get('baseline')!=BASELINE:
+        raise ValueError('Expected the installed approved-art layer over the v10 baseline')
+    rules=module(root/'tools/taichung/validate_city.py')
+    current,current_reached=validator(root,rules)
+    archive=subprocess.check_output(['git','-C',str(root),'archive',BASELINE,
+        'data','src/data','docs/taichung-city-contract.json'])
+    results=[]
+    with tempfile.TemporaryDirectory(prefix='approved-art-save-v10-') as tmp:
+        before=Path(tmp)
+        # Input is a local fixed-commit git archive. System tar also works with
+        # the project's macOS Python3.9, before tarfile's filter API was added.
+        subprocess.run(['tar','-x','-C',str(before)],input=archive,check=True)
+        old,old_reached=validator(before,rules)
+        if current.district_ids!=old.district_ids:
+            raise ValueError('This art migration must not add or remove districts')
+        if (root/'data/maps/map_groups.json').read_bytes()!=(before/'data/maps/map_groups.json').read_bytes():
+            raise ValueError('Existing map IDs changed')
+        for entry in sorted(entries,key=lambda x:x['mapId']):
+            mid=entry['mapId'];a,b=old.maps[mid],current.maps[mid]
+            if (a.width,a.height)!=(b.width,b.height) or (b.width,b.height)!=(entry['width'],entry['height']):
+                raise ValueError(f'{mid}: geography/dimensions changed')
+            if max(b.width,b.height)>255:
+                raise ValueError(f'{mid}: saved relocation coordinates exceed u8')
+            old_sha=digest((before/a.layout['blockdata_filepath']).read_bytes())
+            new_sha=digest((root/b.layout['blockdata_filepath']).read_bytes())
+            if entry.get('oldMapSha256')!=old_sha or entry.get('newMapSha256')!=new_sha:
+                raise ValueError(f'{mid}: map hash binding differs from the actual maps')
+            binding=integration['maps'][MAPS[mid]]
+            if (binding['mapId'],binding['oldMapSha256'],binding['newMapSha256'])!=(mid,old_sha,new_sha):
+                raise ValueError(f'{mid}: map hashes do not match the integration report')
+            if a.data.get('connections')!=b.data.get('connections'):
+                raise ValueError(f'{mid}: connections changed')
+            if a.data.get('warp_events')!=b.data.get('warp_events'):
+                raise ValueError(f'{mid}: native doors/returns changed')
+            native_warps={(w['x'],w['y']) for w in b.data.get('warp_events',[])}
+            safe={(x,y) for map_id,x,y in current_reached if map_id==mid
+                  and (x,y) not in native_warps and b.behavior(x,y)!=0x02}
+            if not safe:raise ValueError(f'{mid}: no reachable safe repair target')
+            expected=set();blocked=set();cutoff=set()
+            for y in range(a.height):
+                for x in range(a.width):
+                    if not a.ground(x,y):continue
+                    if not b.ground(x,y):
+                        expected.add((x,y));blocked.add((x,y))
+                    elif (mid,x,y) in old_reached and (mid,x,y) not in current_reached:
+                        expected.add((x,y));cutoff.add((x,y))
+            repairs=entry.get('repairs',[])
+            origins={(r[0],r[1]) for r in repairs if isinstance(r,list) and len(r)==4}
+            if len(origins)!=len(repairs) or origins!=expected:
+                raise ValueError(f'{mid}: repair origins differ; missing={sorted(expected-origins)}, extra={sorted(origins-expected)}')
+            for row in repairs:
+                if any(type(v) is not int for v in row):raise ValueError(f'{mid}: noninteger repair')
+                x,y,tx,ty=row
+                if (tx,ty) not in safe:raise ValueError(f'{mid}: unsafe target {row}')
+                distance=abs(x-tx)+abs(y-ty)
+                nearest=min(abs(x-sx)+abs(y-sy) for sx,sy in safe)
+                if distance!=nearest:raise ValueError(f'{mid}: target is not nearest reachable safe cell {row}')
+            results.append({'mapId':mid,'name':MAPS[mid],'width':b.width,'height':b.height,
+                'oldMapSha256':old_sha,'newMapSha256':new_sha,
+                'newlyBlockedCount':len(blocked),'newlyCutOffCount':len(cutoff),
+                'unchangedReachableCount':sum(m==mid and (x,y) not in expected for m,x,y in current_reached),
+                'repairs':sorted(repairs,key=lambda r:(r[1],r[0]))})
+    return record,results
+
+
+def c_header(results):
+    lines=['// Generated by tools/taichung_gameplay/generate-approved-art-save.py.',
+        '// Save v11: approved landmark art, after all historical v10 coordinate repairs.',
+        '// Each origin is independently checked against real maps, attributes and reachability.',
+        '// Baseline native source: '+BASELINE,
+        '#define APPROVED_ART_SAVE_V11_READY 1','']
+    for entry in results:
+        symbol='sApprovedArtV11'+entry['name'].removeprefix('Taichung')+'Relocations'
+        entry['symbol']=symbol
+        lines+=['// '+entry['mapId']+': '+str(len(entry['repairs']))+' newly invalid saved cells.',
+            '// Previous map SHA256: '+entry['oldMapSha256'],
+            '// Current map SHA256: '+entry['newMapSha256']]
+        if entry['repairs']:
+            lines+=['static const struct SavedPositionRelocation '+symbol+'[] =','{']
+            lines+=['    {%d, %d, %d, %d},'%tuple(row) for row in entry['repairs']]
+            lines+=['};','']
+    lines+=['static const struct ApprovedArtSaveMap sApprovedArtSaveV11Maps[] =','{']
+    for entry in results:
+        pointer=entry['symbol'] if entry['repairs'] else 'NULL'
+        lines+=['    {MAP_GROUP(%s), MAP_NUM(%s), %s, %d},'%(entry['mapId'],entry['mapId'],pointer,len(entry['repairs']))]
+    lines+=['};','']
+    return '\n'.join(lines)
+
+
+def c_expectations(results):
+    """Host expectations from validated manifest truth, never native C table text."""
+    rows=[]
+    for m in results:
+        for x,y,tx,ty in m['repairs']:
+            rows.append('    {MAP_GROUP(%s), MAP_NUM(%s), %d, %d, %d, %d},'%(m['mapId'],m['mapId'],x,y,tx,ty))
+    if not rows:
+        return ('static bool8 ExpectApprovedArtV11(u8 group, u8 num, s16 *x, s16 *y)\n'
+                '{\n    (void)group; (void)num; (void)x; (void)y;\n    return FALSE;\n}\n')
+    return ('// Independent verified map/manifest truth, not parsed from the C implementation.\n'
+        'static const struct { u8 group, num, x, y, toX, toY; } sApprovedArtV11Expected[] =\n{\n'+
+        '\n'.join(rows)+'\n};\n'
+        'static bool8 ExpectApprovedArtV11(u8 group, u8 num, s16 *x, s16 *y)\n'
+        '{\n    unsigned i;\n'
+        '    for (i = 0; i < sizeof(sApprovedArtV11Expected) / sizeof(sApprovedArtV11Expected[0]); i++)\n'
+        '        if (group == sApprovedArtV11Expected[i].group && num == sApprovedArtV11Expected[i].num\n'
+        '            && *x == sApprovedArtV11Expected[i].x && *y == sApprovedArtV11Expected[i].y)\n'
+        '        {\n            *x = sApprovedArtV11Expected[i].toX; *y = sApprovedArtV11Expected[i].toY;\n'
+        '            return TRUE;\n        }\n    return FALSE;\n}\n')
+
+
+def host_map_groups(root,out):
+    """Use authored native IDs in isolated host output, without a prior ROM build."""
+    root=Path(root);out=Path(out)/'constants/map_groups.h'
+    groups=json.loads((root/'data/maps/map_groups.json').read_text())
+    lines=['#ifndef GUARD_CONSTANTS_MAP_GROUPS_H','#define GUARD_CONSTANTS_MAP_GROUPS_H',
+        '// Host-only generated IDs from the actual map registry.']
+    for group,label in enumerate(groups['group_order']):
+        for number,name in enumerate(groups[label]):
+            data=json.loads((root/'data/maps'/name/'map.json').read_text())
+            lines.append('#define %s (%d | (%d << 8))'%(data['id'],number,group))
+    lines+=['#endif','']
+    out.parent.mkdir(parents=True,exist_ok=True);out.write_text('\n'.join(lines))
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--manifest',type=Path,default=ROOT/RECORD)
+    parser.add_argument('--write',action='store_true')
+    parser.add_argument('--derive',action='store_true',help='Derive the repair manifest from final installed real maps')
+    parser.add_argument('--host-truth',type=Path,help='Write ignored host expectations after validating real maps')
+    args=parser.parse_args()
+    try:
+        if args.derive:
+            args.manifest.parent.mkdir(parents=True,exist_ok=True)
+            args.manifest.write_text(json.dumps(derive(ROOT),indent=2)+'\n')
+        record,results=validate(ROOT,args.manifest)
+        generated=c_header(results)
+        if args.write:
+            (ROOT/OUTPUT).parent.mkdir(parents=True,exist_ok=True)
+            (ROOT/OUTPUT).write_text(generated)
+        elif not (ROOT/OUTPUT).exists() or (ROOT/OUTPUT).read_text()!=generated:
+            raise ValueError('Save-v11 C tables are stale; run with --write')
+        if args.host_truth:
+            args.host_truth.parent.mkdir(parents=True,exist_ok=True)
+            args.host_truth.write_text(c_expectations(results))
+            host_map_groups(ROOT,args.host_truth.parent)
+        validation={'passed':True,'baselineNativeCommit':BASELINE,'manifestSha256':digest(args.manifest.read_bytes()),
+            'generatedHeaderSha256':digest(generated.encode()),
+            'maps':[{k:v for k,v in m.items() if k not in ('repairs','symbol')} for m in results],
+            'checks':['fixed baseline/current map hash bindings','dimensions/connections/warps unchanged',
+                'exact newly blocked or newly cut-off origin set','nearest reachable safe destinations',
+                'native C table byte equality'],'runtimeVerified':False}
+        (ROOT/VALIDATION).write_text(json.dumps(validation,indent=2)+'\n')
+        print(json.dumps(validation,indent=2))
+        return 0
+    except (OSError,ValueError,KeyError,subprocess.CalledProcessError) as error:
+        print(json.dumps({'passed':False,'error':str(error)},indent=2));return 1
+
+
+if __name__=='__main__':sys.exit(main())
