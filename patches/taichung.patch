+#!/usr/bin/env python3
+"""Register the approved Theater, retaining the released primary and interfaces.
+
+Defaults to a dry run. Both sides of every district's borrowed border strip must
+resolve to the same pixels and attributes before any registered source is written.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+from compile_theater import ROOT, OUTPUT, MAP, ORIGIN, SIZE, compile_bank, values
+from check_old_core import Files, Bank, resolved_folder
+
+BASE = 'd7053fd115b3744b22a2ba3160b4240f5cc80355'
+NAMES = ('TaichungOldCity', 'TaichungGreenway', 'TaichungXitun')
+PRIMARY = 'gTileset_TaichungOldCorePrimary'
+SECONDARY = 'gTileset_TaichungXitun'
+REPORT = ROOT/'data/taichung/landmarks/theater/installation.json'
+
+
+def prepare():
+    subprocess.run(['git', 'merge-base', '--is-ancestor', BASE, 'HEAD'], cwd=ROOT, check=True)
+    compile_bank(artifacts=None)
+    now, before = Files(ROOT), Files(ROOT, BASE)
+    layouts = now.json('data/layouts/layouts.json')
+    old_layouts = {v['id']: v for v in before.json('data/layouts/layouts.json')['layouts'] if 'id' in v}
+    banks, grids, maps = {}, {}, {}
+    for name in NAMES:
+        data = now.json(f'data/maps/{name}/map.json')
+        assert data == before.json(f'data/maps/{name}/map.json'), f'Changed interface: {name}'
+        layout = next(v for v in layouts['layouts'] if v.get('id') == data['layout'])
+        old = old_layouts[data['layout']]
+        assert layout['primary_tileset'] == PRIMARY, 'Connected maps must share the released primary: camera transitions reload only secondary graphics'
+        assert layout['width'] == old['width'] and layout['height'] == old['height']
+        assert now.read(layout['border_filepath']) == before.read(old['border_filepath'])
+        primary, _ = resolved_folder(now, PRIMARY)
+        secondary, _ = resolved_folder(before, old['secondary_tileset'])
+        old_bank = Bank(before, primary, secondary)
+        if name == 'TaichungXitun':
+            assert layout['secondary_tileset'] in (old['secondary_tileset'], SECONDARY)
+            candidate = values(OUTPUT/'proposal/map.bin')
+            assert now.words(layout['blockdata_filepath']) in (before.words(old['blockdata_filepath']), candidate)
+            bank = Bank(now, primary, str(OUTPUT.relative_to(ROOT)))
+            grid = candidate
+        else:
+            assert layout == old and now.read(layout['blockdata_filepath']) == before.read(old['blockdata_filepath'])
+            bank, grid = Bank(now, primary, secondary), now.words(layout['blockdata_filepath'])
+        for i, word in enumerate(grid + now.words(layout['border_filepath'])):
+            in_art = name == 'TaichungXitun' and i < len(grid) and ORIGIN[0] <= i % layout['width'] < ORIGIN[0]+SIZE[0] and ORIGIN[1] <= i//layout['width'] < ORIGIN[1]+SIZE[1]
+            if not in_art:
+                n = word & 1023
+                assert bank.render(n) == old_bank.render(n) and bank.attr(n) == old_bank.attr(n), f'Changed surrounding scene {name} cell {i}'
+        banks[data['id']], grids[data['id']], maps[data['id']] = bank, grid, (data, layout)
+    borrowed = 0
+    for mid, (data, layout) in maps.items():
+        for c in data['connections']:
+            target_data, target = maps[c['map']]
+            for y in range(target['height']):
+                for x in range(target['width']):
+                    visible = ((c['direction']=='left' and x>=target['width']-7 and -7<=y+c['offset']<layout['height']+7) or
+                               (c['direction']=='right' and x<8 and -7<=y+c['offset']<layout['height']+7))
+                    if visible:
+                        n = grids[c['map']][y*target['width']+x]&1023
+                        assert banks[mid].render(n)==banks[c['map']].render(n) and banks[mid].attr(n)==banks[c['map']].attr(n), f'Borrowed border mismatch: {mid} sees {c["map"]} at {x},{y}, tile {n:#x}'
+                        borrowed += 1
+    assert before.read('data/tilesets/primary/taichung_old_core/tiles.png') == now.read('data/tilesets/primary/taichung_old_core/tiles.png')
+    return layouts, {'schemaVersion':1, 'baselineCommit':BASE, 'primary':PRIMARY, 'secondary':SECONDARY,
+                     'borrowedStripCellsRenderAndAttributeIdentical':borrowed, 'districtBordersAndInterfacesUnchanged':True,
+                     'oldCityAndGreenwayUnchanged':True, 'primaryUnchanged':True,
+                     'mapSha256':hashlib.sha256((OUTPUT/'proposal/map.bin').read_bytes()).hexdigest(),
+                     'runtimeValidation':'separate actual-ROM evidence required'}
+
+
+def install(layouts):
+    folder = str(OUTPUT.relative_to(ROOT))
+    label = 'TaichungXitun'
+    snippets = {
+        'graphics.h':f'const u32 gTilesetTiles_{label}[] = INCBIN_U32("{folder}/tiles.4bpp.lz");\n\nconst u16 gTilesetPalettes_{label}[][16] =\n{{\n'+''.join(f'    INCBIN_U16("{folder}/palettes/{n:02}.gbapal"),\n' for n in range(16))+'};\n',
+        'metatiles.h':f'const u16 gMetatiles_{label}[] = INCBIN_U16("{folder}/metatiles.bin");\nconst u32 gMetatileAttributes_{label}[] = INCBIN_U32("{folder}/metatile_attributes.bin");\n',
+        'headers.h':f'const struct Tileset gTileset_{label} =\n{{\n    .isCompressed = TRUE,\n    .isSecondary = TRUE,\n    .tiles = gTilesetTiles_{label},\n    .palettes = gTilesetPalettes_{label},\n    .metatiles = gMetatiles_{label},\n    .metatileAttributes = gMetatileAttributes_{label},\n    .callback = NULL,\n}};\n',
+    }
+    for name, snippet in snippets.items():
+        path = ROOT/'src/data/tilesets'/name
+        text = path.read_text()
+        if snippet not in text:
+            assert f'_{label}[' not in text and f'_{label} =' not in text, f'Partial/conflicting registration: {name}'
+            path.write_text(text.rstrip()+'\n\n'+snippet)
+    layout = next(v for v in layouts['layouts'] if v.get('id')=='LAYOUT_TAICHUNG_XITUN')
+    layout['secondary_tileset'] = SECONDARY
+    (ROOT/'data/layouts/layouts.json').write_text(json.dumps(layouts,indent=2)+'\n')
+    MAP.write_bytes((OUTPUT/'proposal/map.bin').read_bytes())
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--install', action='store_true')
+    args = parser.parse_args()
+    layouts, report = prepare()
+    if args.install:
+        install(layouts)
+    layout = next(v for v in layouts['layouts'] if v.get('id') == 'LAYOUT_TAICHUNG_XITUN')
+    report['registered'] = layout['secondary_tileset'] == SECONDARY and MAP.read_bytes() == (OUTPUT/'proposal/map.bin').read_bytes()
+    REPORT.write_text(json.dumps(report,indent=2)+'\n')
+    print(json.dumps(report,indent=2))
diff --git a/tools/taichung/landmarks/install_xitun_final.py b/tools/taichung/landmarks/install_xitun_final.py
new file mode 100644
index 0000000..46bd6fe
--- /dev/null
+++ b/tools/taichung/landmarks/install_xitun_final.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Register the approved Fengjia/Maple pair only in the feature checkout.
+
+Preserves the immutable unregistered pack/templates and writes a distinct actual
+secondary bank. Shared declarations/layout/map/registration have one owner.
+"""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+
+ROOT=Path(__file__).resolve().parents[3]
+DATA=ROOT/'data/taichung/landmarks/xitun-final-native'
+SCENE=DATA/'final-scene'
+PRIMARY='data/tilesets/primary/taichung_xitun_private'
+PACK='data/tilesets/secondary/taichung_xitun_final'
+SECONDARY='data/tilesets/secondary/taichung_xitun_landmarks'
+LABELS=('gTileset_TaichungXitunPrivatePrimary','gTileset_TaichungXitunFinal')
+BASE='c1bc28900f0ae46f9a15d74d4089317c66a28b00'
+MAP_SHA='10128a6dac3b9f1584ee6d985c839943a4bb51d0af7be0d6e9b93474f5144001'
+
+
+def sha(raw):return hashlib.sha256(raw).hexdigest()
+
+
+def install():
+    manifest=json.loads((SCENE/'manifest.json').read_text())
+    assert manifest['mapSha256']==MAP_SHA and sha((SCENE/'map.bin').read_bytes())==MAP_SHA
+    source_map='data/layouts/TaichungXitun/map.bin'
+    frozen=subprocess.check_output(['git','show',BASE+':'+source_map],cwd=ROOT)
+    assert sha(frozen)==manifest['sourceMapSha256'] and frozen==(SCENE/'baseline-map.bin').read_bytes()
+    compiled=(SCENE/'map.bin').read_bytes();assert (ROOT/source_map).read_bytes() in (frozen,compiled), 'Unrelated Xitun geometry edits'
+    for path,digest in manifest['sourceFilesSha256'].items():
+        assert sha((ROOT/path).read_bytes())==digest, f'Frozen pack/input changed: {path}'
+    snapshots={}
+    def remember(path):
+        key=path.relative_to(ROOT).as_posix()
+        if key not in snapshots:snapshots[key]=path.read_bytes() if path.exists() else None
+    def write(path,raw):remember(path);path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(raw)
+    snippets={'graphics.h':[],'metatiles.h':[],'headers.h':[]}
+    for secondary,(label,folder) in enumerate(zip(LABELS,(PRIMARY,SECONDARY))):
+        name=label.removeprefix('gTileset_')
+        snippets['graphics.h'].append(f'const u32 gTilesetTiles_{name}[] = INCBIN_U32("{folder}/tiles.4bpp.lz");\n\nconst u16 gTilesetPalettes_{name}[][16] =\n{{\n'+''.join(f'    INCBIN_U16("{folder}/palettes/{n:02}.gbapal"),\n' for n in range(16))+'};\n')
+        snippets['metatiles.h'].append(f'const u16 gMetatiles_{name}[] = INCBIN_U16("{folder}/metatiles.bin");\nconst u32 gMetatileAttributes_{name}[] = INCBIN_U32("{folder}/metatile_attributes.bin");\n')
+        snippets['headers.h'].append(f'const struct Tileset {label} =\n{{\n    .isCompressed = TRUE,\n    .isSecondary = '+('TRUE' if secondary else 'FALSE')+f',\n    .tiles = gTilesetTiles_{name},\n    .palettes = gTilesetPalettes_{name},\n    .metatiles = gMetatiles_{name},\n    .metatileAttributes = gMetatileAttributes_{name},\n    .callback = '+('NULL' if secondary else 'InitTilesetAnim_General')+',\n};\n')
+    prepared={}
+    for filename,parts in snippets.items():
+        p=ROOT/'src/data/tilesets'/filename;text=p.read_text()
+        for part in parts:
+            if part not in text:
+                name=part.split('[]')[0].split()[-1] if filename=='graphics.h' else part.split('=')[0].split()[-1]
+                assert name not in text,f'Conflicting bank declaration: {filename}:{name}'
+                text=text.rstrip()+'\n\n'+part
+        prepared[p]=text.encode()
+    path=ROOT/'data/layouts/layouts.json';layouts=json.loads(path.read_text())
+    layout=next(v for v in layouts['layouts'] if v.get('id')=='LAYOUT_TAICHUNG_XITUN')
+    assert (layout['primary_tileset'],layout['secondary_tileset']) in [('gTileset_TaichungOldCorePrimary','gTileset_TaichungXitun'),LABELS]
+    layout['primary_tileset'],layout['secondary_tileset']=LABELS
+    prepared[path]=(json.dumps(layouts,indent=2)+'\n').encode();prepared[ROOT/source_map]=compiled
+    registration={'schemaVersion':1,'baselineCommit':BASE,'sourceBaselineCommit':'961dccec68eed91fd66bb1ced9f5ebde5ca7b7e8','inputManifest':'data/taichung/landmarks/xitun-final-native/final-scene/manifest.json','primary':LABELS[0],'secondary':LABELS[1],'primaryFolder':PRIMARY,'secondaryFolder':SECONDARY,'mapFile':'data/taichung/landmarks/xitun-final-native/final-scene/map.bin','baselineMapFile':'data/taichung/landmarks/xitun-final-native/final-scene/baseline-map.bin','sourceMapSha256':sha(frozen),'mapSha256':MAP_SHA,'registeredInSource':True,'nativeRuntimeVerified':False,'originalPackAndSceneFilesPreserved':True,'saveMigrationOwner':'Main'}
+    prepared[DATA/'installation.json']=(json.dumps(registration,indent=2)+'\n').encode()
+    # All originals can be restored if registration/checking fails. New unreferenced
+    # directories may remain as diagnostic outputs; no unrelated file is removed.
+    try:
+        for name in ['tiles.png']+[f'palettes/{n:02}.pal' for n in range(16)]:write(ROOT/SECONDARY/name,(ROOT/PACK/name).read_bytes())
+        for name in ('metatiles.bin','metatile_attributes.bin'):write(ROOT/SECONDARY/name,(SCENE/name).read_bytes())
+        for path,raw in prepared.items():write(path,raw)
+        p=ROOT/'tools/taichung/landmarks/check_xitun_final.py';spec=importlib.util.spec_from_file_location('install_xitun_independent_guard',p);guard=importlib.util.module_from_spec(spec);spec.loader.exec_module(guard)
+        report=guard.check(ROOT)
+        if not report['passed']:raise ValueError('Independent Xitun registration failed: '+'; '.join(report['errors']))
+    except BaseException:
+        for name,raw in reversed(list(snapshots.items())):
+            path=ROOT/name
+            if raw is None:path.unlink(missing_ok=True)
+            else:path.write_bytes(raw)
+        raise
+    return {'registeredInSource':True,'primary':LABELS[0],'secondary':LABELS[1],'mapSha256':MAP_SHA,'nativeRuntimeVerified':False}
+
+
+if __name__=='__main__':print(json.dumps(install(),indent=2))
diff --git a/tools/taichung/qa.html b/tools/taichung/qa.html
new file mode 100644
index 0000000..13a900e
--- /dev/null
+++ b/tools/taichung/qa.html
@@ -0,0 +1,253 @@
+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Taichung native map QA</title>
+<style>
+  :root { color-scheme: dark; font: 15px system-ui, sans-serif; background: #172223; color: #e8f0ed; }
+  body { max-width: 950px; margin: 12px auto; padding: 0 20px; }
+  h1 { font-size: 22px; margin: 8px 0; }
+  p { margin: 8px 0; }
+  canvas { width: 480px; max-width: 100%; height: auto; image-rendering: pixelated; background: #000; display: block; margin: 8px 0; }
+  button, input { font: inherit; padding: 8px 12px; margin: 3px; }
+  button { cursor: pointer; }
+  button:disabled { cursor: default; opacity: .5; }
+  input[type=number] { width: 85px; }
+  pre { white-space: pre-wrap; background: #0b1516; padding: 12px; min-height: 24px; }
+  .controls { display: flex; flex-wrap: wrap; gap: 4px; margin: 12px 0; }
+  label { display: inline-block; margin-right: 12px; }
+</style>
+<h1>Taichung native map QA</h1>
+<p>Isolated feature ROM and fresh save. Use the in-game Save menu before reading the saved location.</p>
+<button id="load">Load cartridge</button>
+<label><input id="mute" type="checkbox" checked>mute audio</label>
+<span id="timing">Timing not started.</span>
+<p id="status" role="status">Ready to load.</p>
+<canvas id="screen" width="240" height="160" aria-label="Native Game Boy Advance game screen"></canvas>
+<label>hold ms <input id="hold-ms" type="number" value="300" min="16" max="10000" step="10"></label>
+<label>repeat count <input id="repeat-count" type="number" value="1" min="1" max="50"></label>
+<div class="controls" id="keys">
+  <button data-key="Up" disabled>up</button>
+  <button data-key="Down" disabled>down</button>
+  <button data-key="Left" disabled>left</button>
+  <button data-key="Right" disabled>right</button>
+  <button data-key="A" disabled>a</button>
+  <button data-key="B" disabled>b</button>
+  <button data-key="Start" disabled>start</button>
+  <button data-key="Select" disabled>select</button>
+</div>
+<pre id="last-action" aria-live="polite">No input sent.</pre>
+<button id="read-location" disabled>Read saved location</button>
+<button id="reset" disabled>Reset cartridge (keep save)</button>
+<button id="download-screen" disabled>Download screen</button>
+<button id="download-save" disabled>Download save</button>
+<pre id="location">No saved location read.</pre>
+<script type="module">
+  import createMgba from '/mgba.js';
+
+  const byId = id => document.getElementById(id);
+  const canvas = byId('screen');
+  const originalGetContext = canvas.getContext.bind(canvas);
+  // The bundled runtime calls canvas.getContext('webgl2', attributes) and does
+  // not request preservation. Set it before the first context is created so a
+  // PNG capture can read the displayed frame after the browser has presented it.
+  canvas.getContext = (type, attributes) => originalGetContext(type,
+    ['webgl', 'webgl2', 'experimental-webgl'].includes(type)
+      ? { ...attributes, preserveDrawingBuffer: true }
+      : attributes);
+  const status = message => { byId('status').textContent = message; };
+  const keyButtons = [...document.querySelectorAll('[data-key]')];
+  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+  let emulator;
+  let busy = false;
+  let saveDescription = '';
+
+  function configureTiming() {
+    // Local mGBA declarations link to this API, and the bundled implementation
+    // confirms mode 0 = setTimeout with value in milliseconds:
+    // https://emscripten.org/docs/api_reference/emscripten.h.html#c.emscripten_set_main_loop_timing
+    // Timers can still be throttled in a hidden tab; this avoids depending on RAF.
+    emulator.setMainLoopTiming(0, 16);
+    byId('timing').textContent = `Timing: mode ${emulator.getMainLoopTimingMode()}, value ${emulator.getMainLoopTimingValue()} (0 = timer ms).`;
+  }
+
+  function download(bytes, type, filename) {
+    const url = URL.createObjectURL(new Blob([bytes], { type }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = filename;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 30000);
+  }
+
+  byId('load').addEventListener('click', async () => {
+    byId('load').disabled = true;
+    status('Loading isolated cartridge…');
+    try {
+      if (!crossOriginIsolated || typeof SharedArrayBuffer === 'undefined') {
+        throw new Error('This tab needs COOP/COEP headers and SharedArrayBuffer.');
+      }
+      const response = await fetch('/mapping.gba', { cache: 'no-store' });
+      if (!response.ok) throw new Error(`ROM request failed: ${response.status}`);
+      const rom = new Uint8Array(await response.arrayBuffer());
+      emulator = await createMgba({ canvas });
+      await emulator.FSInit();
+      emulator.setCoreSettings({
+        autoSaveStateEnable: false,
+        restoreAutoSaveStateOnLoad: false,
+        rewindEnable: false,
+        allowOpposingDirections: false,
+      });
+      emulator.addCoreCallbacks({ coreCrashedCallback: () => status('Emulator reported a core crash.') });
+      const requestedToken = new URLSearchParams(location.search).get('qaSave');
+      if (requestedToken !== null && !/^[A-Za-z0-9_-]{1,100}$/.test(requestedToken)) {
+        throw new Error('qaSave must contain 1–100 letters, numbers, hyphens or underscores.');
+      }
+      const token = requestedToken ?? crypto.randomUUID();
+      const romPath = `${emulator.filePaths().gamePath}/mapping-qa-${token}.gba`;
+      const savePath = `${emulator.filePaths().savePath}/mapping-qa-${token}.sav`;
+      const saveExisted = emulator.FS.analyzePath(savePath).exists;
+      saveDescription = requestedToken === null ? `Fresh unique save ${token}.`
+        : saveExisted ? `Reusing named save ${token}; persisted file found.`
+        : `Named save ${token}; no persisted file found, starting fresh.`;
+      emulator.FS.writeFile(romPath, rom);
+      if (!emulator.loadGame(romPath, savePath)) throw new Error('mGBA could not open the cartridge.');
+      emulator.toggleInput(false);
+      configureTiming();
+      emulator.setVolume(byId('mute').checked ? 0 : 0.5);
+      if (!byId('mute').checked) {
+        emulator.resumeAudio();
+        await emulator.SDL2?.audioContext?.resume();
+      }
+      keyButtons.forEach(button => { button.disabled = false; });
+      byId('read-location').disabled = false;
+      for (const id of ['reset', 'download-screen', 'download-save']) byId(id).disabled = false;
+      status(`Running feature cartridge (${rom.length.toLocaleString()} bytes). ${saveDescription}`);
+    } catch (error) {
+      status(`Load failed: ${error.message}`);
+      byId('load').disabled = false;
+    }
+  });
+
+  byId('mute').addEventListener('change', async () => {
+    if (!emulator) return;
+    emulator.setVolume(byId('mute').checked ? 0 : 0.5);
+    if (!byId('mute').checked) {
+      emulator.resumeAudio();
+      await emulator.SDL2?.audioContext?.resume();
+    }
+  });
+
+  for (const button of keyButtons) {
+    button.addEventListener('click', async () => {
+      if (!emulator || busy) return;
+      busy = true;
+      keyButtons.forEach(b => { b.disabled = true; });
+      const key = button.dataset.key;
+      const hold = Math.max(16, Math.min(10000, Number(byId('hold-ms').value) || 300));
+      const repeat = Math.max(1, Math.min(50, Math.floor(Number(byId('repeat-count').value) || 1)));
+      byId('last-action').textContent = `Sending ${key}, ${hold} ms, ${repeat} time(s)…`;
+      try {
+        for (let i = 0; i < repeat; i++) {
+          emulator.buttonPress(key);
+          await wait(hold);
+          emulator.buttonUnpress(key);
+          if (i + 1 < repeat) await wait(100);
+        }
+        byId('last-action').textContent = `Sent ${key}, ${hold} ms, ${repeat} time(s).`;
+      } catch (error) {
+        byId('last-action').textContent = `Input failed: ${error.message}`;
+      } finally {
+        emulator.buttonUnpress(key);
+        busy = false;
+        keyButtons.forEach(b => { b.disabled = false; });
+      }
+    });
+  }
+
+  byId('reset').addEventListener('click', async () => {
+    if (!emulator || busy) return;
+    busy = true;
+    byId('reset').disabled = true;
+    keyButtons.forEach(button => { button.disabled = true; });
+    try {
+      await emulator.FSSync();
+      emulator.quickReload();
+      configureTiming();
+      status(`Cartridge reset. Native save retained; choose Continue to verify it. ${saveDescription}`);
+    } catch (error) {
+      status(`Reset failed: ${error.message}`);
+    } finally {
+      busy = false;
+      byId('reset').disabled = false;
+      keyButtons.forEach(button => { button.disabled = false; });
+    }
+  });
+
+  byId('download-screen').addEventListener('click', async () => {
+    try {
+      const filename = `taichung-map-qa-${Date.now()}.png`;
+      // Capture the actual displayed native-ROM canvas. This runtime's separate
+      // screenshot API returned an all-black file during QA, so do not use it as
+      // evidence. Copy unchanged pixels into a 2D canvas and reject blank frames.
+      const frame = document.createElement('canvas');
+      frame.width = canvas.width;
+      frame.height = canvas.height;
+      const context = frame.getContext('2d', { willReadFrequently: true });
+      context.drawImage(canvas, 0, 0);
+      const pixels = context.getImageData(0, 0, frame.width, frame.height).data;
+      let nonBlackPixels = 0;
+      for (let i = 0; i < pixels.length; i += 4) {
+        if (pixels[i] || pixels[i + 1] || pixels[i + 2]) nonBlackPixels++;
+      }
+      if (!nonBlackPixels) throw new Error('Captured frame is entirely black. Reload this updated QA page, load the cartridge, and retry after the game is visible.');
+      const blob = await new Promise(resolve => frame.toBlob(resolve, 'image/png'));
+      if (!blob) throw new Error('Could not encode the game canvas.');
+      download(blob, 'image/png', filename);
+      byId('last-action').textContent = `Downloaded ${filename}; ${frame.width}×${frame.height}, ${nonBlackPixels} non-black pixels from the native game canvas.`;
+    } catch (error) {
+      byId('last-action').textContent = `Screen download failed: ${error.message}`;
+    }
+  });
+
+  byId('download-save').addEventListener('click', () => {
+    try {
+      const bytes = emulator.getSave();
+      if (!bytes) throw new Error('Save through the game menu first.');
+      const filename = `taichung-map-qa-${Date.now()}.sav`;
+      download(bytes, 'application/octet-stream', filename);
+      byId('last-action').textContent = `Downloaded ${filename} (${bytes.length} bytes).`;
+    } catch (error) {
+      byId('last-action').textContent = `Save download failed: ${error.message}`;
+    }
+  });
+
+  byId('read-location').addEventListener('click', () => {
+    try {
+      const bytes = emulator?.getSave();
+      if (!bytes) throw new Error('No save exists yet. Save through the game menu first.');
+      const data = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+      const sectors = [];
+      for (let offset = 0; offset + 0x1000 <= bytes.length; offset += 0x1000) {
+        if (data.getUint16(offset + 0xFF4, true) === 1 && data.getUint32(offset + 0xFF8, true) === 0x08012025) {
+          sectors.push({ offset, counter: data.getUint32(offset + 0xFFC, true) });
+        }
+      }
+      if (!sectors.length) throw new Error('No valid SaveBlock1 sector found. Finish saving in the game first.');
+      sectors.sort((a, b) => b.counter - a.counter);
+      const { offset, counter } = sectors[0];
+      byId('location').textContent = JSON.stringify({
+        saveCounter: counter,
+        x: data.getInt16(offset, true),
+        y: data.getInt16(offset + 2, true),
+        mapGroup: data.getUint8(offset + 4),
+        mapNumber: data.getUint8(offset + 5),
+        partyCount: data.getUint8(offset + 0x34),
+        saveBytes: bytes.length,
+      }, null, 2);
+    } catch (error) {
+      byId('location').textContent = error.message;
+    }
+  });
+</script>
+</html>
