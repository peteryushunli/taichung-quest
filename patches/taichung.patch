+#!/usr/bin/env python3
+"""Fetch a small, reproducible read-only OSM geography extract for city planning.
+
+Raw third-party data stays in an explicit artifact directory, not native source.
+No game maps, IDs, events, ROMs, or tilesets are changed by this utility.
+"""
+import argparse
+import datetime as dt
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import time
+import urllib.parse
+import urllib.request
+
+
+DEFAULT_BBOX = (24.11, 120.62, 24.20, 120.72)  # south,west,north,east WGS84
+DEFAULT_ENDPOINT = "https://overpass-api.de/api/interpreter"
+
+
+def query_for(bbox):
+    box = ",".join(f"{v:.6f}" for v in bbox)
+    return f'''[out:json][timeout:90];
+(
+  way["highway"~"^(motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link)$"]({box});
+  way["railway"~"^(rail|light_rail|subway|tram)$"]({box});
+  way["waterway"~"^(river|stream|canal)$"]({box});
+  way["landuse"~"^(residential|commercial|retail|industrial|railway)$"]({box});
+  way["leisure"="park"]({box});
+  way["amenity"~"^(school|university|college)$"]({box});
+  node["place"~"^(suburb|neighbourhood|quarter|village)$"]({box});
+);
+out body geom;
+'''
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--output-dir", type=Path, required=True)
+    p.add_argument("--endpoint", default=DEFAULT_ENDPOINT)
+    p.add_argument("--bbox", nargs=4, type=float, default=DEFAULT_BBOX,
+                   metavar=("SOUTH", "WEST", "NORTH", "EAST"))
+    p.add_argument("--timeout", type=int, default=115)
+    p.add_argument("--transport", choices=("urllib", "curl"), default="urllib")
+    args = p.parse_args()
+    south, west, north, east = args.bbox
+    if not (-90 < south < north < 90 and -180 < west < east < 180):
+        p.error("Invalid WGS84 bbox")
+    if (north-south)*(east-west) > .02:
+        p.error("Keep the planning extract bounded; max .02 square degrees")
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    query = query_for(args.bbox)
+    (args.output_dir/"query.overpassql").write_text(query)
+    start = time.monotonic()
+    now = dt.datetime.now(dt.timezone.utc).isoformat()
+    metadata = dict(endpoint=args.endpoint, requestedAtUTC=now, bboxSWNE=args.bbox,
+                    source="OpenStreetMap contributors via read-only Overpass API",
+                    attribution="© OpenStreetMap contributors",
+                    sourceUrl="https://www.openstreetmap.org/copyright",
+                    querySha256=hashlib.sha256(query.encode()).hexdigest())
+    req = urllib.request.Request(args.endpoint,
+        data=urllib.parse.urlencode({"data": query}).encode(),
+        headers={"User-Agent": "TaichungQuest-geography-prototype/1.0 (read-only city planning extract)"})
+    try:
+        if args.transport == "curl":
+            result = subprocess.run(["curl", "--fail-with-body", "--silent", "--show-error",
+                "--connect-timeout", "10", "--max-time", str(args.timeout),
+                "--data-urlencode", "data@"+str(args.output_dir/"query.overpassql"), args.endpoint],
+                capture_output=True, timeout=args.timeout+5)
+            if result.returncode:
+                raise ValueError(result.stderr.decode(errors="replace").strip() or f"curl exit {result.returncode}")
+            raw = result.stdout
+        else:
+            with urllib.request.urlopen(req, timeout=args.timeout) as response:
+                raw = response.read()
+        data = json.loads(raw)
+        if "elements" not in data:
+            raise ValueError("Overpass response lacks elements")
+        if data.get("remark"):
+            raise ValueError("Overpass reported: "+data["remark"])
+        (args.output_dir/"osm-urban-extract.json").write_bytes(raw)
+        metadata.update(status="downloaded", seconds=round(time.monotonic()-start,2),
+                        bytes=len(raw), elements=len(data["elements"]),
+                        rawSha256=hashlib.sha256(raw).hexdigest(),
+                        osmTimestampUTC=data.get("osm3s",{}).get("timestamp_osm_base"))
+    except Exception as exc:
+        metadata.update(status="failed", seconds=round(time.monotonic()-start,2), error=str(exc))
+        (args.output_dir/"fetch-metadata.json").write_text(json.dumps(metadata,indent=2)+"\n")
+        raise SystemExit("Geography fetch failed: "+str(exc))
+    (args.output_dir/"fetch-metadata.json").write_text(json.dumps(metadata,indent=2)+"\n")
+    print(json.dumps({k:metadata[k] for k in ("status","elements","bytes","seconds","osmTimestampUTC")},indent=2))
+
+
+if __name__ == "__main__":
+    main()
