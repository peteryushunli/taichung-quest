+#!/usr/bin/env python3
+"""Compile approved Greenway art against frozen released city interfaces.
+
+Only this feature checkout is written. The installed primary is immutable;
+static graphics are deduplicated against it before allocating secondary slots.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
