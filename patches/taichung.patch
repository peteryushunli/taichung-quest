+#!/usr/bin/env python3
+"""Immutable provenance and fail-closed composition for the existing-map release."""
+import ast
+import importlib.util
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+from unittest.mock import patch
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).resolve().parents[1]
+
+def module(name):
+    spec=importlib.util.spec_from_file_location("test_"+name,ROOT/"tools/taichung"/(name+".py"))
+    result=importlib.util.module_from_spec(spec);spec.loader.exec_module(result);return result
+
+def git(*args):return subprocess.check_output(["git",*args],cwd=ROOT)
+
+def function(text,name):
+    node=next(x for x in ast.parse(text).body if isinstance(x,ast.FunctionDef) and x.name==name)
+    return "\n".join(text.splitlines()[node.lineno-1:node.end_lineno])
+
+release=module("capture_release_guard")
+
+class CaptureRelease(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.read=staticmethod(release.reader(ROOT));cls.record=release.load(cls.read);cls.stored=release.bundle(cls.read,cls.record)
+
+    def test_exact_immutable_scope_and_released_geometry(self):
+        r=self.record;changes=[x.split("\t")for x in git("diff","--name-status",r["baseline"],r["feature"]).decode().splitlines()]
+        self.assertEqual({p for s,p in changes if s=="M"},set(r["edited"]))
+        self.assertEqual({p for s,p in changes if s=="A"},set(r["added"]))
+        self.assertEqual((len(r["edited"]),len(r["added"])),(7,6))
+        for path,item in r["edited"].items():
+            self.assertEqual(self.stored["before/"+path],git("show",r["baseline"]+":"+path))
+            self.assertEqual(release.sha(git("show",r["feature"]+":"+path)),item["after"])
+        for path,expected in {**r["added"],**r["dependencies"]}.items():
+            self.assertEqual(release.sha(git("show",r["feature"]+":"+path)),expected,path)
+        for path in r["dependencies"]:
+            self.assertEqual(git("show",r["baseline"]+":"+path),git("show",r["feature"]+":"+path),path)
+        self.assertTrue(r["geometryFingerprint"].startswith("48fe4ba5"))
+        for path in r["guardAdapters"]:
+            self.assertEqual(self.stored["guard-before/"+path],git("show",r["baseline"]+":"+path))
+
+    def test_exact_old_registrations_and_probes_remain(self):
+        for path in ("data/taichung/gym-interiors/manifest.json","data/taichung/encounter-field-fix/registration.json",
+                     "data/taichung/encounter-save-init/registration.json","data/taichung/capture-gameplay-guard/registration.json",
+                     "tools/taichung/encounter_field_fix_guard.py","tools/taichung/encounter_save_init_guard.py",
+                     "tools/taichung/capture_gameplay_guard.py","tools/taichung/home_start.py"):
+            self.assertEqual(self.read(path),git("show",self.record["baseline"]+":"+path),path)
+        for path in ("tools/taichung/gym_interiors_guard.py","tools/taichung/approved_art_guard.py"):
+            self.assertEqual(function(self.read(path).decode(),"self_test"),function(git("show",self.record["baseline"]+":"+path).decode(),"self_test"))
+
+    def test_composition_keeps_foreign_changes_live(self):
+        before=release.peel(self.read);self.assertEqual(len(before),8)
+        self.assertFalse(any(p.startswith(("data/maps/","data/layouts/","data/tilesets/"))for p in before))
+        read=lambda p:before[p]if p in before else self.read(p)
+        for name in ("encounter_field_fix_guard","encounter_save_init_guard","capture_gameplay_guard"):
+            layer=module(name);under=layer.peel(read);self.assertTrue(under,name)
+            prior=read;read=(lambda a,b:lambda p:a[p]if p in a else b(p))(under,prior)
+        gym=module("gym_interiors_guard");self.assertTrue(gym.check(ROOT)["passed"])
+        foreign="src/battle_main.c";self.assertNotIn(foreign,before)
+        self.assertFalse(gym.check(ROOT,{foreign:self.read(foreign)+b"\nforeign battle mutation"})["passed"])
+        absent=release.hidden(self.read)
+        self.assertNotIn("data/taichung/encounters/foreign.json",absent)
+        self.assertFalse(any("data/taichung/encounters/foreign.json".startswith(p+"/")for p in absent))
+
+    def test_portable_and_missing_partial_layers(self):
+        with patch("subprocess.run",side_effect=AssertionError("No process/Git allowed")),patch("subprocess.check_output",side_effect=AssertionError("No Git allowed")):
+            self.assertTrue(release.check(ROOT)["passed"])
+        old={p:self.stored["before/"+p]for p in self.record["edited"]}
+        old.update({p:None for p in self.record["added"]});old.update({release.REGISTRATION:None,release.BUNDLE:None})
+        self.assertEqual(release.check(ROOT,old),dict(passed=True,active=False))
+        self.assertFalse(release.check(ROOT,{release.REGISTRATION:None})["passed"])
+        self.assertTrue(release.self_test(ROOT)["passed"])
+
+if __name__=="__main__":unittest.main(verbosity=2)
