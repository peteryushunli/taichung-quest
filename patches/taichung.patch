+def tiled_roof(d, P, y0, y1, left, right=79):
+    """Yellow glazed roof between rows y0-y1; `left(y)` is its west edge. Tile lines every 4 px."""
+    for y in range(y0, y1 + 1):
+        x0 = left(y)
+        d.line((x0, y, right, y), fill=P[9])
+        for x in range(x0 + 1, right + 1):
+            if x % 4 == 0:
+                d.point((x, y), fill=P[10])
+        d.point((x0, y), fill=P[11])
