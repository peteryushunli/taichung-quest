+bool8 TaichungBadgeLoadPalettes(void)
+{
+    if (LoadSpritePalette(&sPalettes[0]) == 0xFF)
+        return FALSE;
+    if (LoadSpritePalette(&sPalettes[1]) == 0xFF)
+    {
+        FreeSpritePaletteByTag(BADGE_PALETTE_EARNED);
+        return FALSE;
+    }
+    return TRUE;
+}
