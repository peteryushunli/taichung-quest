+void ResetBgsAndClearDma3BusyFlags(bool8 unused) { (void)unused; }
+void InitBgsFromTemplates(u8 unused, const struct BgTemplate *templates, u8 count) { (void)unused; assert(count == 1 && templates[0].priority == 1); }
+void ChangeBgX(u8 bg, u32 coord, u8 mode) { (void)bg; (void)coord; (void)mode; }
+void ChangeBgY(u8 bg, u32 coord, u8 mode) { (void)bg; (void)coord; (void)mode; }
