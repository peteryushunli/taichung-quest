+#!/usr/bin/env python3
+"""Author one isolated, source-related old-core layout; never write native maps."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+SECTION = "city-v2-r2-c2"
+
+# Deliberately authored control points. The source layer stays separately exported.
+# These are a reviewable simplification, not a measurement or a fitted road survey.
+ROADS = [
+    ("wuquan", "五權路", 3, [[43, 0], [34, 5], [25, 10], [15, 17], [7, 25], [0, 32]]),
+    ("taiwan-1", "臺灣大道一段", 3, [[9, 19], [20, 29], [29, 34], [35, 39], [40, 48], [41, 54]]),
+    ("zhongshan", "中山路", 2, [[4, 25], [11, 31], [17, 38], [18, 47], [27, 52], [40, 55]]),
+    ("jianguo", "建國路", 3, [[13, 63], [25, 58], [40, 55], [50, 57], [58, 56]]),
+    ("shuangshi-1", "雙十路一段", 3, [[54, 0], [54, 13], [54, 30], [49, 38], [41, 43], [40, 48]]),
+    ("minsheng", "民生路", 2, [[0, 36], [8, 43], [13, 51], [20, 63]]),
+]
+LANDMARKS = {
+    "old-taichung-station": {"artRect": [44, 44, 55, 51], "reserveRect": [44, 44, 55, 55],
+                              "entrance": [50, 51], "arrival": [50, 54]},
+    "miyahara": {"artRect": [21, 38, 30, 45], "reserveRect": [21, 38, 30, 49],
+                 "entrance": [26, 45], "arrival": [26, 48]},
+    "taichung-park": {"artRect": [35, 13, 50, 24], "reserveRect": [35, 13, 50, 28],
+                      "entrance": [43, 24], "arrival": [43, 27]},
+}
+APPROACHES = [
+    {"id": "station-apron", "role": "landmark-arrival", "rect": [44, 52, 55, 56]},
+    {"id": "miyahara-apron", "role": "landmark-arrival", "rect": [24, 46, 28, 52]},
+    {"id": "park-apron", "role": "landmark-arrival", "rect": [42, 25, 53, 29]},
+]
+
+
+def inside(p, rect):
+    return rect[0] <= p[0] <= rect[2] and rect[1] <= p[1] <= rect[3]
+
+
+def line_cells(points, width):
+    cells = set()
+    radius = width / 2
+    for a, b in zip(points, points[1:]):
+        length = math.dist(a, b)
+        for step in range(max(1, math.ceil(length * 4)) + 1):
+            t = step / max(1, math.ceil(length * 4))
+            px, py = a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])
+            for y in range(max(0, math.floor(py - radius)), min(63, math.ceil(py + radius)) + 1):
+                for x in range(max(0, math.floor(px - radius)), min(63, math.ceil(px + radius)) + 1):
+                    if math.hypot(x - px, y - py) <= radius:
+                        cells.add((x, y))
+    return cells
+
+
+def rect_cells(rect):
+    return {(x, y) for y in range(rect[1], rect[3] + 1) for x in range(rect[0], rect[2] + 1)}
+
+
+def connected_components(cells):
+    left, sizes = set(cells), []
+    while left:
+        todo = [left.pop()]
+        size = 0
+        while todo:
+            x, y = todo.pop()
+            size += 1
+            for n in ((x-1, y), (x+1, y), (x, y-1), (x, y+1)):
+                if n in left:
+                    left.remove(n)
+                    todo.append(n)
+        sizes.append(size)
+    return sorted(sizes, reverse=True)
+
+
+def source_data(city):
+    names = {r[1] for r in ROADS}
+    result = []
+    for street in city["streets"]:
+        points = street["projectedCenterline"]
+        if street["sourceName"] not in names or not any(125 <= x <= 195 and 125 <= y <= 195 for x, y in points):
+            continue
+        result.append({
+            "id": street["id"], "sourceName": street["sourceName"],
+            "sourceRecordId": street["sourceRecordId"],
+            "sourceGeometryWgs84": street["sourceGeometryWgs84"],
+            "rawProjectedLocal": [[round(x-128, 3), round(y-128, 3)] for x, y in points],
+        })
+    return result
+
+
+def build(city, source_hash):
+    raw = source_data(city)
+    roads = [{"id": "pilot-"+i, "sourceRoadName": name,
+              "sourceStreetRefs": [s["id"] for s in raw if s["sourceName"] == name],
+              "authoredLocalCenterline": pts, "widthTiles": width,
+              "status": "authored simplification and elastic separation; not surveyed alignment"}
+             for i, name, width, pts in ROADS]
+    road_cells = set().union(*(line_cells(r["authoredLocalCenterline"], r["widthTiles"]) for r in roads))
+    landmarks = []
+    for lm in city["landmarks"]:
+        if lm["id"] not in LANDMARKS:
+            continue
+        proposed = LANDMARKS[lm["id"]]
+        raw_local = [round(v-128, 3) for v in lm["rawProjectedPoint"]]
+        center = [(proposed["artRect"][0]+proposed["artRect"][2])/2,
+                  (proposed["artRect"][1]+proposed["artRect"][3])/2]
+        landmarks.append({
+            "id": lm["id"], "name": lm["name"], "zh": lm["zh"],
+            "realWgs84": lm["realWgs84"], "rawProjectedLocal": raw_local,
+            "proposedAuthoredLocal": proposed,
+            "rawPointToProposedArtCenterDeltaTiles": [round(a-b, 3) for a, b in zip(center, raw_local)],
+            "baselineNative": lm["baselineNative"], "baselineNativeChanged": False,
+            "nativeMapRegistered": False, "nativeWarpPaired": False,
+        })
+    protected = set().union(*(rect_cells(lm["proposedAuthoredLocal"]["reserveRect"]) for lm in landmarks))
+    for a in APPROACHES:
+        road_cells |= rect_cells(a["rect"])
+    # Require paths to touch the explicit south arrivals, while reserving facades.
+    for lm in landmarks:
+        art = rect_cells(lm["proposedAuthoredLocal"]["artRect"])
+        assert not (road_cells & art), f"road crosses {lm['id']} art"
+        assert tuple(lm["proposedAuthoredLocal"]["arrival"]) in road_cells
+    for i, a in enumerate(landmarks):
+        for b in landmarks[i+1:]:
+            ar, br = a["proposedAuthoredLocal"]["reserveRect"], b["proposedAuthoredLocal"]["reserveRect"]
+            gap_x, gap_y = max(ar[0]-br[2]-1, br[0]-ar[2]-1, 0), max(ar[1]-br[3]-1, br[1]-ar[3]-1, 0)
+            assert max(gap_x, gap_y) >= 2, f"reserve conflict {a['id']} {b['id']}"
+    # These are authored empty rectangles, not extracted building footprints.
+    occupied = road_cells | protected
+    lots = []
+    catalog = json.loads((ROOT/"data/taichung/prefabs/catalog.json").read_text())
+    building_roles = {"residential-lowrise", "residential-walkup", "commercial-frontage", "civic-service", "neighborhood-service", "market-stall"}
+    for y in range(2, 57, 2):
+        for x in range(2, 57, 2):
+            for width, height in ((12, 8), (10, 6), (8, 8), (8, 6), (5, 8), (5, 6), (5, 5)):
+                rect = [x, y, x+width-1, y+height-1]
+                if rect[2] > 61 or rect[3] > 61 or rect_cells(rect) & occupied:
+                    continue
+                dist = min(math.hypot(px-(x+width/2), py-(y+height/2)) for px, py in road_cells)
+                band = "primaryRetailFrontage" if 25 < y < 54 and dist < 9 else "residentialSideStreet"
+                compatible = [p["id"] for p in catalog["prefabs"] if p["role"] in building_roles and p["width"] <= width and p["height"] <= height]
+                assert compatible, "candidate cannot fit a building module"
+                lots.append({"id": f"pilot-r2c2-lot-{x}-{y}", "sectionId": SECTION,
+                             "localRect": rect, "width": width, "height": height,
+                             "sourceBuildingId": None, "selectedPrefabId": None,
+                             "streetBand": band, "profileRef": SECTION,
+                             "compatibleSizeOnlyPrefabIds": compatible,
+                             "status": "unpainted authored candidate; apply actual prefab masks before use"})
+                occupied |= rect_cells([max(0,rect[0]-1),max(0,rect[1]-1),min(63,rect[2]+1),min(63,rect[3]+1)])
+                break
+    components = connected_components(road_cells)
+    assert len(components) == 1, f"disconnected walking space {components}"
+    return {
+        "schemaVersion": 1, "status": "isolated authored pilot for focused review; not native-registered",
+        "sectionId": SECTION, "width": 64, "height": 64, "worldOrigin": [128, 128],
+        "sourceStreetDraft": {"path": "docs/city-v2-streets.json", "sha256": source_hash},
+        "sourceEvidenceRefs": ["municipal-roads-114", "central-old-street-2026"],
+        "coordinateContract": {
+            "unit": "16x16-pixel metatile", "localOrigin": "northwest, zero-based",
+            "rectangles": "inclusive integer bounds [left,top,right,bottom]",
+            "rawProjectedLocal": "unmodified source projection minus worldOrigin; not a game entrance",
+            "proposedAuthoredLocal": "new pilot-only coordinates; not currentMap43 coordinates",
+            "nativeBaseline": "unchanged; requires versioned map/door/save contract before integration"},
+        "sourceRoads": raw, "authoredRoads": roads,
+        "landmarks": landmarks, "clearApproaches": APPROACHES,
+        "candidateLots": lots,
+        "independentSeamSuggestions": [
+            {"edge": "north", "localPoint": [43,0], "roadName": "五權路", "pairedNeighborPort": None},
+            {"edge": "north", "localPoint": [54,0], "roadName": "雙十路一段", "pairedNeighborPort": None},
+            {"edge": "west", "localPoint": [0,32], "roadName": "五權路", "pairedNeighborPort": None},
+            {"edge": "west", "localPoint": [0,36], "roadName": "民生路", "pairedNeighborPort": None},
+            {"edge": "south", "localPoint": [13,63], "roadName": "建國路", "pairedNeighborPort": None},
+            {"edge": "south", "localPoint": [20,63], "roadName": "民生路", "pairedNeighborPort": None}],
+        "validation": {"connectedWalkingComponents": len(components), "walkingCells": len(road_cells),
+                       "landmarkReserveConflicts": 0, "roadFacadeOverlaps": 0,
+                       "unpaintedCandidateLots": len(lots), "lots12x8": sum(l["width"] == 12 for l in lots),
+                       "allThreeArrivalsReachWalkingNetwork": True,
+                       "nativeBufferCellsWithPadding": (64+15)*(64+14),
+                       "nativeBufferLimit": 10240, "nativeRuntimeTested": False},
+        "limitations": [
+            "The road names and raw geometry come from the municipal road survey; the pilot control points are deliberately authored, locally stretched and simplified.",
+            "This is one section, not a new approval request for the accepted 16-section direction. Neighbor seams remain independent and unpaired.",
+            "Gym facade sizes and dormant doors are reserves. No new native map, warp, ROM, save migration or current baseline anchor has been changed.",
+            "Rail, waterway banks and actual building footprints are missing source layers. No imagined rail/water alignment or parcel-use claim is included.",
+            "Lots are clear against this draft road/facade mask only. Actual native prefab paint, collision and mandatory-clear masks still apply."]}
+
+
+def render(data, output):
+    from PIL import Image, ImageDraw, ImageFont
+    scale, ox1, ox2, oy = 10, 42, 740, 125
+    image = Image.new("RGB", (1430, 940), "#f3f1e8")
+    draw = ImageDraw.Draw(image)
+    font_path = "/System/Library/Fonts/STHeiti Light.ttc"
+    font = ImageFont.truetype(font_path, 19)
+    small = ImageFont.truetype(font_path, 15)
+    title = ImageFont.truetype(font_path, 30)
+    draw.text((42, 24), "R2C2 · Station + Central old-core pilot", font=title, fill="#24323b")
+    draw.text((42, 68), "Source road projection and authored game spacing are separate. This draft changes no native map or entrance.", font=font, fill="#465661")
+    draw.text((ox1, 96), "SOURCE · municipal road geometry + raw pins", font=font, fill="#24323b")
+    draw.text((ox2, 96), "AUTHORED · 64 × 64 tiles + unpainted lots", font=font, fill="#24323b")
+    def pt(point, ox): return (ox+point[0]*scale, oy+point[1]*scale)
+    def box(rect, ox): return (ox+rect[0]*scale, oy+rect[1]*scale, ox+(rect[2]+1)*scale-1, oy+(rect[3]+1)*scale-1)
+    for ox in (ox1, ox2):
+        draw.rectangle((ox,oy,ox+640,oy+640), fill="#e6e9d9", outline="#b1b9a6", width=2)
+        for i in range(8,64,8):
+            draw.line((ox+i*scale,oy,ox+i*scale,oy+640),fill="#d5dacd")
+            draw.line((ox,oy+i*scale,ox+640,oy+i*scale),fill="#d5dacd")
+    # Clip the source panel before pasting so out-of-section geometry never spills.
+    layer = Image.new("RGB", (640,640), "#e6e9d9")
+    ld = ImageDraw.Draw(layer)
+    for road in data["sourceRoads"]:
+        ld.line([(x*scale,y*scale) for x,y in road["rawProjectedLocal"]], fill="#9caaa5", width=2)
+    image.paste(layer,(ox1,oy))
+    draw = ImageDraw.Draw(image)
+    authored_layer = Image.new("RGB", (640,640), "#e6e9d9")
+    ald = ImageDraw.Draw(authored_layer)
+    for i in range(8,64,8):
+        ald.line((i*scale,0,i*scale,640),fill="#d5dacd")
+        ald.line((0,i*scale,640,i*scale),fill="#d5dacd")
+    for road in data["authoredRoads"]:
+        ald.line([(p[0]*scale,p[1]*scale) for p in road["authoredLocalCenterline"]], fill="#b0afa7", width=road["widthTiles"]*scale, joint="curve")
+    image.paste(authored_layer,(ox2,oy))
+    draw = ImageDraw.Draw(image)
+    for approach in data["clearApproaches"]:
+        draw.rectangle(box(approach["rect"],ox2),fill="#d1cdbc")
+    for lot in data["candidateLots"]:
+        fill = "#d8b78e" if lot["streetBand"] == "primaryRetailFrontage" else "#b7c7cb"
+        draw.rectangle(box(lot["localRect"],ox2),fill=fill,outline="#6e858e",width=2)
+    colors={"old-taichung-station":"#b25943","miyahara":"#b37b2e","taichung-park":"#557d4b"}
+    labels={"old-taichung-station":"Station", "miyahara":"Miyahara", "taichung-park":"Park"}
+    for lm in data["landmarks"]:
+        color, label = colors[lm["id"]], labels[lm["id"]]
+        raw = lm["rawProjectedLocal"]
+        rp=pt(raw,ox1)
+        draw.ellipse((rp[0]-5,rp[1]-5,rp[0]+5,rp[1]+5),fill=color)
+        # Offset the crowded source labels without pretending they are entrances.
+        offsets={"old-taichung-station":(8,9),"miyahara":(-76,-20),"taichung-park":(8,-20)}
+        dx,dy=offsets[lm["id"]]
+        draw.text((rp[0]+dx,rp[1]+dy),label,font=small,fill=color)
+        proposed=lm["proposedAuthoredLocal"]
+        draw.rectangle(box(proposed["reserveRect"],ox2),outline=color,width=3)
+        draw.rectangle(box(proposed["artRect"],ox2),fill=color)
+        ar=proposed["artRect"]
+        draw.text((ox2+(ar[0]+0.4)*scale,oy+(ar[1]+1)*scale),label,font=small,fill="#ffffff")
+        ep=pt(proposed["entrance"],ox2)
+        draw.rectangle((ep[0]-4,ep[1]-4,ep[0]+4,ep[1]+4),fill="#ffffff")
+    draw.text((ox1,790), "Station–Miyahara raw pin distance: 4.78 tiles", font=font, fill="#24323b")
+    draw.text((ox2,790), "Facade reserves separated; 3 south arrivals connected", font=font, fill="#24323b")
+    draw.text((42,832), "Blue = residential-side lots · Ochre = main-frontage lots · Empty rectangles are authored candidates, not real footprints.", font=font, fill="#465661")
+    draw.text((42,866), "Primary roads: 五權路 / 臺灣大道一段 / 中山路 / 建國路 / 雙十路一段 / 民生路", font=font, fill="#465661")
+    draw.text((42,900), "Review decision: does this old-core street scale leave enough room for ordinary city blocks around the three gyms?", font=font, fill="#24323b")
+    output.parent.mkdir(parents=True,exist_ok=True)
+    image.save(output)
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--artifact-dir",type=Path,required=True)
+    args=parser.parse_args()
+    source=ROOT/"docs/city-v2-streets.json"
