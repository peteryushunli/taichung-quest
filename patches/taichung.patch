index 0000000..fc3051e
--- /dev/null
+++ b/tools/taichung/check_landmark_collision.py
@@ -0,0 +1,274 @@
+#!/usr/bin/env python3
+"""Apply/check the collision-only landmark object fix against released 6366b9e.
+
+Masks come from pinned artwork alpha, not the proposed collision delta. The
+native city validator independently checks actor-aware routes and all 12 rooms.
+This does not prove runtime door animation or old-save/cache migration.
+
+Registered increments built on top of this layer (the city kit in the private
+primaries, then the Xitun, Nantun and Old City reworks' grown maps) are proven by their own guards;
+this guard reads the tree underneath them, and underneath() hands other guards
+the release maps underneath this layer.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = 'data/taichung/landmark-collision/spec.json'
+DELTA = 'data/taichung/landmark-collision/delta.json'
+sys.path.insert(0, str(ROOT / 'tools/taichung'))
+from validate_city import Validator  # noqa: E402
+from render_maps import tileset_paths  # noqa: E402
+SUPPORT = 'tools/taichung/landmarks/check_old_core.py'
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def words(raw):
+    return list(struct.unpack(f'<{len(raw)//2}H', raw))
+
+
+def binary(values):
+    return struct.pack(f'<{len(values)}H', *values)
+
+
+_FROZEN = {}
+
+
+def frozen(source, ref, path):
+    key = (str(source), ref, str(path))
+    if key not in _FROZEN:  # commits are immutable
+        _FROZEN[key] = subprocess.check_output(['git', 'show', f'{ref}:{path}'], cwd=source)
+    return _FROZEN[key]
+
+
+class Reader(dict):
+    """Validator overrides that read every path through read(path)."""
+    def __init__(self, read):
+        super().__init__()
+        self.read = read
+
+    def get(self, path, default=None):
+        return self.read(path)
+
+    def __bool__(self):
+        return True  # empty as a dict, but it answers every path
+
+
+def increments_removed(source, overrides=None):
+    """The tree with the registered increments above this layer removed (the
+    Old City rework, the latest, then the Xitun and Nantun reworks, then the city kit, each
+    only when the tree holds exactly its registered output), and overrides on top: probes
+    describe that state."""
+    spec = importlib.util.spec_from_file_location('collision_support', source / SUPPORT)
+    support = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(support)
+    files = support.Files(source)
+    files.cache.update(support.oldcity_rework_underneath(files))
+    files.cache.update(support.xitun_rework_underneath(files))
+    files.cache.update(support.nantun_rework_underneath(files))
+    files.cache.update(support.city_kit_underneath(files))
+    files.cache.update(overrides or {})
+    return files
+
+
+def layer(source):
+    spec = json.loads((source / SPEC).read_text())
+    base = spec['baselineCommit']
+    contract = json.loads(frozen(source, base, 'docs/taichung-city-contract.json'))
+    layouts = {x['id']: x for x in json.loads(frozen(source, base, 'data/layouts/layouts.json'))['layouts'] if 'id' in x}
+    landmarks = {x['id']: x for x in contract['landmarks']}
+    assert {x['id'] for x in spec['footprints']} == set(landmarks) | {'fine-arts-sculpture'}, 'Incomplete landmark roster'
+    maps = {}
+    for district in contract['districts']:
+        path = f"data/maps/{district['name']}/map.json" if 'name' in district else None
+        # Native names are registry entries, independent of display labels.
+        if path is None:
+            name = next(name for name in json.loads(frozen(source, base, 'data/maps/map_groups.json'))['gMapGroup_Taichung']
+                        if json.loads(frozen(source, base, f'data/maps/{name}/map.json'))['id'] == district['map'])
+            path = f'data/maps/{name}/map.json'
+        data = json.loads(frozen(source, base, path))
+        layout = layouts[data['layout']]
+        raw = frozen(source, base, layout['blockdata_filepath'])
+        maps[data['id']] = dict(path=layout['blockdata_filepath'], width=layout['width'], before=words(raw), after=words(raw), events=path)
+    coverage, exceptions = {}, {}
+    for item in spec['footprints']:
+        identity, mid = item['id'], item['mapId']
+        ox, oy = item['origin']; width, height = item['size']
+        if 'art' in item:
+            art_raw = (source / item['art']).read_bytes()
+            assert sha(art_raw) == item['artSha256'], f'{identity}: source artwork changed'
+            art = Image.open(source / item['art']).convert('RGBA')
+            assert art.size == (width * 16, height * 16)
+            cells = {(ox+x, oy+y) for y in range(height) for x in range(width)
+                     if art.crop((x*16, y*16, (x+1)*16, (y+1)*16)).getchannel('A').getbbox()}
+        else:
+            cells = {(ox+x, oy+y) for y in range(height) for x in range(width)}
+        parent = landmarks.get(identity, landmarks['fine-arts-museum'] if identity == 'fine-arts-sculpture' else None)
+        assert parent and mid == parent['exteriorMap'], f'{identity}: wrong parent map'
+        allowed = {(parent[k]['x'], parent[k]['y']) for k in ('entrance', 'approach', 'arrival')}
+        coverage[identity] = (mid, cells - allowed)
+        exceptions[identity] = sorted(cells & allowed)
+        m = maps[mid]
+        for x, y in cells - allowed:
+            index = y*m['width']+x
+            value = m['after'][index]
+            if not value & 0xC00:
+                m['after'][index] = value | 0x400
+    return spec, contract, maps, coverage, exceptions
+
+
+def plan(source):
+    spec, contract, maps, coverage, exceptions = layer(source)
+    changes = []
+    geometry = Validator(source, contract, Reader(lambda path: frozen(source, spec['baselineCommit'], path)))
+    for mid, item in maps.items():
+        geometry.maps[mid].cells = item['before']
+    geometry.run()
+    assert not geometry.errors, geometry.errors
+    for mid, m in maps.items():
+        group, number = geometry.map_numbers[mid]
+        for index, (before, after) in enumerate(zip(m['before'], m['after'])):
+            if before == after:
+                continue
+            x, y = index % m['width'], index // m['width']
+            assert not before & 0xC00 and after ^ before == 0x400
+            assert geometry.maps[mid].behavior(x, y) == 0, 'New block unexpectedly uses forced movement/bridge/ledge behavior'
+            changes.append(dict(mapId=mid, nativeMap=[group, number], x=x, y=y,
+                                before=f'0x{before:04X}', after=f'0x{after:04X}',
+                                oldReachable=(mid,x,y) in geometry.distances,
+                                landmark=next(identity for identity, (fm, pts) in coverage.items() if fm == mid and (x,y) in pts)))
+    return spec, contract, maps, coverage, exceptions, changes
+
+
+def underneath(files):
+    """{map path: release bytes} for the maps this layer changes, when files
+    hold exactly its alpha-derived grids; otherwise {}, so a guard reads the
+    real bytes. Guards that freeze those maps at the release check this state
+    underneath; this guard proves the layer itself."""
+    source = Path(files.source)
+    if not (source / SPEC).is_file():
+        return {}
+    maps = layer(source)[2]
+    changed = [m for m in maps.values() if m['before'] != m['after']]
+    if any(files.read(m['path']) != binary(m['after']) for m in changed):
+        return {}
+    return {m['path']: binary(m['before']) for m in changed}
+
+
+def check(source, proposed=False, overrides=None):
+    spec, contract, maps, coverage, exceptions, changes = plan(source)
+    overrides = overrides or {}
+    files = increments_removed(source, overrides)
+    errors = []
+    grids = {}
+    for mid, item in maps.items():
+        raw = overrides.get(item['path'], binary(item['after']) if proposed else files.read(item['path']))
+        grids[mid] = words(raw)
+        if grids[mid] != item['after']:
+            errors.append(f'{mid}: grid differs from exact alpha-derived collision-only change')
+        if files.read(item['events']) != frozen(source, spec['baselineCommit'], item['events']):
+            errors.append(f'{mid}: exterior events changed')
+    for identity, (mid, pts) in coverage.items():
+        width = maps[mid]['width']
+        if any(not grids[mid][y*width+x] & 0xC00 for x,y in pts):
+            errors.append(f'{identity}: landmark illustration is traversable')
+    # The common native collision routine rejects nonzero collision before
+    # elevation checks. Walking and Bike both use CheckForObjectEventCollision.
+    geometry = Validator(source, contract, Reader(files.read))
+    bank_inputs = set()
+    for m in geometry.maps.values():
+        for key in ('primary_tileset', 'secondary_tileset'):
+            paths = tileset_paths(source, m.layout[key])
+            bank_inputs.add(paths['tiles'])
+            bank_inputs.update((paths['metatiles'].parent / name) for name in ('metatiles.bin','metatile_attributes.bin'))
+            bank_inputs.update((paths['palettes'] / f'{n:02}.pal') for n in range(13))
+    for path in sorted(bank_inputs):
+        rel = str(path.relative_to(source))
+        actual, expected = files.read(rel), frozen(source,spec['baselineCommit'],rel)
+        # JASC-PAL is text: Git checkout converts its native CRLF. Compare the
+        # complete lines, including every RGB value, rather than line endings.
+        equal = actual.splitlines() == expected.splitlines() if path.suffix == '.pal' else actual == expected
+        if not equal:
+            errors.append(f'Graphics, attributes or layers changed: {rel}')
+    for mid, grid in grids.items():
+        geometry.maps[mid].cells = grid
+    geometry.run()
+    errors.extend(geometry.errors)
+    old = Validator(source, contract, Reader(lambda path: frozen(source, spec['baselineCommit'], path)))
+    for mid, item in maps.items():
+        old.maps[mid].cells = item['before']
+    old.run()
+    blocked = {(d['mapId'],d['x'],d['y']) for d in changes}
+    stranded = set(old.distances) - blocked - set(geometry.distances)
+    if stranded:
+        errors.append(f'Previously reachable non-object cells stranded: {sorted(stranded)[:10]}')
+    if set(old.open_edges) != set(geometry.open_edges):
+        errors.append('A directed district crossing changed')
+    fallback = contract['landmarks'][next(i for i,l in enumerate(contract['landmarks']) if l['id']=='maple-garden')]['arrival']
+    return dict(result='fail' if errors else 'pass', errors=errors, baselineCommit=spec['baselineCommit'],
+                scope='Source footprint/collision, actor-aware walking graph and native shared collision path; runtime and save migration require separate acceptance.',
+                footprints=[dict(id=identity,mapId=mid,solidObjectCells=len(pts),nativeExceptions=exceptions[identity]) for identity,(mid,pts) in coverage.items()],
+                changedMapWords=len(changes), newlySolidPositions=changes,
+                repairsByNativeMap={','.join(map(str,k)):v for k,v in Counter(tuple(d['nativeMap']) for d in changes).items()},
+                nativeDoorPairs=len(geometry.landmark_results), directedSeamCells=len(geometry.open_edges),
+                unchangedBankFilesCompared=len(bank_inputs),
+                previouslyReachableNonObjectCellsStranded=len(stranded),
+                preservedPublicCells=sum(len(m['before']) for m in maps.values())-len(changes),
+                mainOwnedMigration=dict(required=bool(changes), coordinatesAreActualSavedPositions=True,
+                                        safeExteriorFallback=dict(mapId='MAP_TAICHUNG_XITUN', nativeMap=[43,2],x=fallback['x'],y=fallback['y']),
+                                        cacheRefreshRequired=True, saveCodeChanged=False),
+                runtimeVerified=False)
+
+
+def self_test(source):
+    _, _, maps, _, _, changes = plan(source)
+    changed = changes[0]; mid=changed['mapId']; item=maps[mid]; results={}
+    for label,x,y,mutate in [('reopened-object',changed['x'],changed['y'],lambda w:w&~0xC00),
+                              ('blocked-approach',12,33,lambda w:w|0x400),
+                              ('removed-door',12,32,lambda w:0x3175),
+                              ('public-street-edit',12,35,lambda w:w|0x400)]:
+        grid=item['after'][:];index=y*item['width']+x;grid[index]=mutate(grid[index])
+        results[label]=check(source,proposed=True,overrides={item['path']:binary(grid)})['result']=='fail'
+    assert all(results.values()), results
+    return results
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--source',type=Path,default=ROOT)
+    p.add_argument('--apply',action='store_true')
+    p.add_argument('--self-test',action='store_true')
+    p.add_argument('--output',type=Path)
+    a=p.parse_args();source=a.source.resolve()
+    if a.apply:
+        candidate=check(source,proposed=True)
+        assert candidate['result']=='pass', candidate['errors']
+        _,_,maps,_,_,_=plan(source)
+        for item in maps.values():
+            if item['before']!=item['after']:
+                (source/item['path']).write_bytes(binary(item['after']))
+        (source/DELTA).write_text(json.dumps(candidate,indent=2)+'\n')
+    report=check(source)
+    if a.self_test:
+        report['rejectedCorruptionProbes']=self_test(source)
+    if a.output:
+        a.output.parent.mkdir(parents=True,exist_ok=True)
+        a.output.write_text(json.dumps(report,indent=2)+'\n')
+    print(json.dumps({k:v for k,v in report.items() if k not in ('newlySolidPositions','footprints')},indent=2))
+    return report['result']!='pass'
+
+
+if __name__=='__main__':
+    raise SystemExit(main())
diff --git a/tools/taichung/city_rework/save_v10.py b/tools/taichung/city_rework/save_v10.py
