+#!/usr/bin/env python3
+"""Read-only proof for Greenway, Old City and Old City North on the master plan (city-rework phase 2b).
+
+Greenway grows to 40x109 at world (40,-5) with today's cells moved (0,+37); Old City grows
+to 44x77 at (80,48) with no shift; Old City North is a new 44x53 map at (80,-5) with its own
+secondary. The raised highway's retaining wall and culvert, kerb bollards and waterside railings
+are the kit's pieces (claude/city-kit cb2214e). The registered files must be build_rework.py's
+exact output from BASE (the city-rework tip b00a965), whose grids paint the approved drafts (the fill pass) pixel for
+pixel. Independently of the build:
+  - cells: every built cell holds what its draft class asks for, and renders as the draft
+    shows wherever the draft shows real tiles (kept art, landmarks 13-17, kiosks and stalls);
+    secondary metatiles outside the new landmarks render as in BASE's tilesets. The only
+    differences are the three place-name signposts and the shrubs that close open ground
+    facing a solid cell across a seam between these maps; and every street, water, park,
+    path and lot cell is what plan-cells.txt draws there, but for those and the live signs;
+  - seams: every cell a neighbour draws through a connection renders the same with the
+    neighbour's tilesets as with the map's own;
+  - geometry: validate_city on the tree finds nothing, now that every neighbour is on the
+    plan. Its one allowance is a wall bump: open ground along a neighbour's wall or water,
+    as Greenway's west sidewalk runs along Xitun's and Nantun North's lot backs;
+  - encounters: the contract's habitats are exactly the tall grass, every landmark approach
+    is reachable without entering it, and the parks' tables (Greenway, and Old City for
+    Taichung Park) are rate 12, levels 2-5.
+
+The frozen district guards compare whole files with older baselines, so they check the state
+underneath this increment: underneath() hands them BASE's files for these maps and BASE's
+entries in the shared files, and only when the tree holds exactly the registered build.
+
+  check_oldcity_rework.py               print the report
+  check_oldcity_rework.py --self-test   also prove each corruption probe is caught
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+BASE = "b00a9651c77f7f381c789012e78f07a920ba0686"
+# The approved drafts (artifacts/city-rework/drafts/greenway.png and oldcity.png), as pixels:
+# the fill pass of 2026-11-09, parks and lots as plan-cells.txt draws them, with the raised
+# highway's wall and the kerbs of board v18; Shen Ji's gym one column east and Fine Arts three,
+# out of Nantun North's strip (the user's choice, 2026-11-09).
+APPROVED_DRAFTS = {"greenway": "5fb5831e53a3f314ae8cd44a6cabf1e1dbcf302c090d6705e2ad7565a81aaa6c",
+                   "oldcity": "ddcd2abc0daf425b1efaa119ffb164aa49b199ae1ba7e01355260ed191ca6587"}
+LAYOUTS, GROUPS, ENCOUNTERS = "data/layouts/layouts.json", "data/maps/map_groups.json", "src/data/wild_encounters.json"
+LEVELS, RATE, LAND = (2, 5), 12, 1
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def builder():
+    sys.path.insert(0, str(HERE))
+    import build_rework
+    return build_rework
+
+
+def mine(build, mid):
+    return mid in {build.map_id(n) for n in build.MAPS}
+
+
+def shared_entries(files, record):
+    """This build's entries as the tree's shared files hold them, against the record."""
+    build = builder()
+    layouts = {l["id"]: l for l in files.json(LAYOUTS)["layouts"] if l.get("id") in record["layouts"]}
+    group, name = record["mapGroup"]
+    groups = files.json(ENCOUNTERS)["wild_encounter_groups"]
+    tables = {mid: [e for g in groups for e in g["encounters"] if e["map"] == mid] for mid in record["encounters"]}
+    contract = files.json(build.CONTRACT)
+    districts = {d["map"]: d for d in contract["districts"] if mine(build, d["map"])}
+    landmarks = {l["id"]: l for l in contract["landmarks"] if l["id"] in record["contract"]["landmarks"]}
+    habitats = [h for h in contract["habitatRegions"] if mine(build, h["map"])]
+    blocks = all(files.text(path).count(block) == 1 for path, blocks in record["blocks"].items() for block in blocks)
+    return {"layouts": layouts == record["layouts"],
+            "mapGroup": files.json(GROUPS)[group].count(name) == 1,
+            "encounters": tables == record["encounters"],
+            "districts": districts == record["contract"]["districts"],
+            "landmarks": landmarks == record["contract"]["landmarks"],
+            "habitats": habitats == record["contract"]["habitatRegions"],
+            "blocks": blocks}
+
+
+def registered(files):
+    build = builder()
+    try:
+        record = files.json(build.RECORD)
+    except (OSError, subprocess.CalledProcessError, ValueError):
+        return None
+    if record.get("baseCommit") != BASE:
+        return None
+    try:
+        whole = all(sha(build.checked_in(path, files.read(path))) == digest for path, digest in record["outputs"].items())
+    except (OSError, subprocess.CalledProcessError):
+        return None
+    try:
+        entries = shared_entries(files, record)
+    except KeyError:        # an older build's record
+        return None
+    return record if whole and all(entries.values()) else None
+
+
+def in_base(source, path):
+    return subprocess.run(["git", "cat-file", "-e", f"{BASE}:{path}"], cwd=source,
+                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
+
+
+def underneath(files):
+    """{path: bytes} with exactly the registered build removed, when the tree holds it;
+    otherwise {}, so a guard reads the real bytes."""
+    record = registered(files)
+    if not record:
+        return {}
+    build = builder()
+    base = type(files)(files.source, BASE)
+    out = {}
+    for path in record["outputs"]:
+        if in_base(files.source, path):     # else new with this build (Old City North): nothing frozen reads it
+            out[path] = base.read(path)
+    base_layouts = {l["id"]: l for l in base.json(LAYOUTS)["layouts"] if l.get("id") in record["layouts"]}
+    out[LAYOUTS] = build.dump(build.put_layouts(files.json(LAYOUTS), {i: base_layouts.get(i) for i in record["layouts"]}))
+    groups = files.json(GROUPS)
+    group, name = record["mapGroup"]
+    groups[group] = [m for m in groups[group] if m != name]
+    out[GROUPS] = build.dump(groups)
+    encounters = files.json(ENCOUNTERS)
+    for mid in record["encounters"]:
+        before = [e for g in base.json(ENCOUNTERS)["wild_encounter_groups"] for e in g["encounters"] if e["map"] == mid]
+        encounters = build.put_encounter(encounters, mid, before[0] if before else None)
+    out[ENCOUNTERS] = build.dump(encounters)
+    for path, blocks in record["blocks"].items():
+        text = files.text(path)
+        for block in blocks:
+            text = text.replace(block, "")
+        out[path] = text.encode()
+    contract = base.json(build.CONTRACT)
+    districts = {mid: next((d for d in contract["districts"] if d["map"] == mid), None) for mid in record["contract"]["districts"]}
+    landmarks = {l["id"]: l for l in contract["landmarks"] if l["id"] in record["contract"]["landmarks"]}
+    habitats = [h for h in contract["habitatRegions"] if mine(build, h["map"])]
+    out[build.CONTRACT] = build.dump(build.put_contract(files.json(build.CONTRACT), districts, landmarks, habitats))
+    return out
+
+
+def check(source=ROOT, overrides=None):
+    source = Path(source).resolve()
+    support = load("oldcity_rework_support", source / "tools/taichung/landmarks/check_old_core.py")
+    build = builder()
+    verify = load("oldcity_rework_verify", HERE / "verify_rework.py")
+    now = support.Files(source)
+    now.cache.update(overrides or {})
+    # The playthrough polish's edit to the shared city script is a later layer; read beneath it.
+    now.cache.update(support.polish_scripts_underneath(now))
+    # The registered still-water layer redraws the flat-water fills; the drafts are compared underneath it.
+    now.cache.update(support.still_water_underneath(now))
+    # The registered street-sign layer opens Old City North's Hwy 74 signpost; its own guard proves it.
+    now.cache.update(support.street_signs_underneath(now))
+    tests = support.Checks()
+    state = {}
+
+    def registration():
+        record = now.json(build.RECORD)
+        tests.require(record.get("baseCommit") == BASE, "Record is not on BASE")
+        stale = [p for p, d in record["outputs"].items() if sha(build.checked_in(p, now.read(p))) != d]
+        tests.require(not stale, f"Files differ from the registered build: {stale[:8]}")
+        entries = shared_entries(now, record)
+        tests.require(all(entries.values()), f"Shared-file entries differ from the registered build: {[k for k, v in entries.items() if not v]}")
+        groups = now.json(GROUPS)
+        tests.require(groups["gMapGroup_Taichung"][-1] == "TaichungOldCityNorth",
+                      "Old City North is not appended last to the Taichung map group (existing map numbers must not move)")
+        state["record"] = record
+        return {"wholeFiles": len(record["outputs"]), "sharedFiles": len(build.SHARED)}
+
+    def reproducible():
+        b = build.Builder(BASE).build()
+        stale = [rel for rel, data in b.outputs.items() if now.read(rel) != data]
+        tests.require(not stale, f"Not build_rework.py's output from BASE: {stale[:8]}")
+        state["builder"] = b
+        return {"outputs": len(b.outputs), "seamHedges": b.report["seamHedges"]}
+
+    def underneath_still_water(run):
+        """Run with the tree's still-water definitions (and street-sign maps) read as
+        they were before those layers, so built cells are compared with the drafts
+        underneath them."""
+        layers = {**support.still_water_underneath(support.Files(source)), **support.street_signs_underneath(support.Files(source))}
+        peeled = {(source / path).resolve(): data for path, data in layers.items()}
+        if not peeled:
+            return run()
+        native, original = verify.native, verify.native.words
+
+        def words(path):
+            data = peeled.get(Path(path).resolve())
+            return original(path) if data is None else struct.unpack(f"<{len(data) // 2}H", data)
+        native.words = words
+        try:
+            return run()
+        finally:
+            native.words = original
+
+    def cells():
+        b = state["builder"]
+        report = underneath_still_water(lambda: verify.verify(b))
+        tests.require(report["draftDigests"] == APPROVED_DRAFTS, "The builder's grids no longer paint the approved drafts")
+        tests.require(not any(report["unexplained"].values()), f"Unexplained differences from the drafts: {report['unexplained']}")
+        notes = {}
+        for name, v in report["maps"].items():
+            for d in v["differences"]:
+                kind = "signpost" if "signpost" in d["note"] else "seam hedge" if "seam hedge" in d["note"] else d["note"]
+                notes[kind] = notes.get(kind, 0) + 1
+        tests.require(notes == {"signpost": len(build.PLACE_SIGNS), "seam hedge": b.report["seamHedges"]},
+                      f"Explained differences are not the signposts and seam hedges: {notes}")
+        tests.require(not any(report["planUnexplained"].values()), f"Cells differ from plan-cells.txt: {report['planUnexplained']}")
+        tests.require(report["allStripsRenderTheSame"],
+                      f"Seam cells render differently in a neighbour: {[s for s in report['strips'] if s['renderDifferently']][:3]}")
+        return {"explained": notes, "family": {n: v["cells"].get("family", 0) for n, v in report["maps"].items()},
+                "plan": {n: v["kinds"] for n, v in report["plan"].items()}, "strips": len(report["strips"])}
+
+    def geometry():
+        native = support.load_native(source)
+        city = native.Validator(source, now.json(build.CONTRACT))
+        city.run()
+        tests.require(not city.errors, f"validate_city: {city.errors[:8]}")
+        state["city"] = city
+        return {"cityFindings": len(city.errors), "seamWallBumps": len(getattr(city, "bumps", [])),
+                "reachable": len(getattr(city, "distances", {}))}
+
+    def encounters():
+        city = state["city"]
+        contract = now.json(build.CONTRACT)
+        for name in build.MAPS:
+            m = city.maps[build.map_id(name)]
+            grass = {(x, y) for x in range(m.width) for y in range(m.height)
+                     if m.walkable(x, y) and (m.attribute(m.cell(x, y) & 0x3FF) >> 24) & 7 == LAND}
+            rects = [h["rect"] for h in contract["habitatRegions"] if h["map"] == m.id]
+            habitat = {(x, y) for x0, y0, x1, y1 in rects for x in range(x0, x1 + 1) for y in range(y0, y1 + 1)}
+            tests.require(grass == habitat, f"{name}: tall grass differs from its habitats: extra {sorted(grass - habitat)[:6]}, missing {sorted(habitat - grass)[:6]}")
+            tests.require(all((m.id, x, y) in city.distances for x, y in grass), f"{name}: tall grass not all reachable")
+            m.obstacles.update(grass)
+        spawn = contract["spawn"]
+        quiet = city.flood((spawn["map"], spawn["x"], spawn["y"]), {build.map_id(n) for n in build.MAPS})
+        for l in contract["landmarks"]:
+            if mine(build, l["exteriorMap"]):
+                a = l["approach"]
+                tests.require((l["exteriorMap"], a["x"], a["y"]) in quiet, f"{l['id']}: approach needs the tall grass")
+        for mid in ("MAP_TAICHUNG_GREENWAY", "MAP_TAICHUNG_OLD_CITY"):
+            tables = [e for g in now.json(ENCOUNTERS)["wild_encounter_groups"] for e in g["encounters"] if e["map"] == mid]
+            tests.require(len(tables) == 1 and set(tables[0]) == {"map", "base_label", "land_mons"}, f"{mid} needs exactly one land table")
+            land = tables[0]["land_mons"] if tables else {"mons": [], "encounter_rate": 0}
+            tests.require(land["encounter_rate"] == RATE and len(land["mons"]) == 12
+                          and all(LEVELS[0] <= m["min_level"] <= m["max_level"] <= LEVELS[1] for m in land["mons"]),
+                          f"{mid}'s table is not rate {RATE}, levels {LEVELS[0]}-{LEVELS[1]}")
+        return {"habitats": len([h for h in contract["habitatRegions"] if mine(build, h["map"])])}
+
+    def frozen():
+        delta = underneath(now)
+        tests.require(bool(delta), "underneath() does not recognise the registered build")
+        base = support.Files(source, BASE)
+        for path, data in delta.items():
+            tests.require(in_base(source, path) and data == base.read(path), f"underneath() does not give BASE's bytes for {path}")
+        return {"files": len(delta)}
+
+    tests.section("registration", registration)
+    tests.section("reproducible", reproducible)
+    if "builder" in state:
+        tests.section("cells", cells)
+    tests.section("geometry", geometry)
+    if "city" in state:
+        tests.section("encounters", encounters)
+    tests.section("frozen", frozen)
+    return {"passed": not tests.errors, "errors": tests.errors, "checks": tests.results}
+
+
+def self_test(source):
+    """Each corruption is caught: one map cell, a contract habitat, a header block."""
+    files = lambda: load("oldcity_rework_probe", source / "tools/taichung/landmarks/check_old_core.py").Files(source)
+    build = builder()
+    probes = {}
+    path = "data/layouts/TaichungOldCity/map.bin"
+    raw = bytearray((source / path).read_bytes())
+    raw[0] ^= 1
+    probes["map cell"] = {path: bytes(raw)}
+    contract = json.loads((source / build.CONTRACT).read_text())
+    contract["habitatRegions"] = contract["habitatRegions"][1:]
+    probes["contract habitat"] = {build.CONTRACT: build.dump(contract)}
+    header = "src/data/tilesets/headers.h"
+    text = (source / header).read_text()
+    probes["header block"] = {header: text.replace("gTileset_TaichungOldCityNorth =", "gTileset_TaichungOldCityNorthX =").encode()}
+    out = {}
+    for name, overrides in probes.items():
+        f = files()
+        f.cache.update(overrides)
+        out[name] = {"underneathRefuses": underneath(f) == {}, "registeredRefuses": registered(f) is None}
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    report = check(args.source)
+    if args.self_test:
+        probes = self_test(args.source.resolve())
+        report["selfTest"] = probes
+        report["passed"] = report["passed"] and all(all(v.values()) for v in probes.values())
+    print(json.dumps(report, indent=2))
+    sys.exit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
