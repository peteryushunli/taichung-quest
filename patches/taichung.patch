+void PutWindowTilemap(u8 window) { assert(sWindow && window == 0); }
+void CopyWindowToVram(u8 window, u8 mode) { (void)mode; assert(sWindow && window == 0); }
+u8 *ConvertIntToDecimalStringN(u8 *dest, s32 value, u8 mode, u8 digits) { (void)mode; (void)digits; sprintf((char *)dest, "%d", value); return dest + strlen((char *)dest); }
+u8 *StringAppend(u8 *dest, const u8 *src) { return (u8 *)strcat((char *)dest, (const char *)src); }
+void ResetTasks(void) { memset(gTasks, 0, sizeof(gTasks)); }
+u8 CreateTask(void (*func)(u8), u8 priority) { u8 i; (void)priority; for (i = 0; i < 16; i++) if (!gTasks[i].func) { gTasks[i].func = func; return i; } assert(0); return 0xFF; }
+void DestroyTask(u8 id) { assert(gTasks[id].func); memset(&gTasks[id], 0, sizeof(gTasks[id])); }
+void RunTasks(void) { u8 i; for (i = 0; i < 16; i++) if (gTasks[i].func) gTasks[i].func(i); }
+void PlaySE(u16 song) { assert(song == SE_SELECT); }
+void PlayFanfare(u16 song) { assert(song == MUS_OBTAIN_BADGE); sFanfare = TRUE; sFanfareCount++; }
+bool8 IsFanfareTaskInactive(void) { return !sFanfare; }
+
+static void Tick(u16 held)
+{
+    gMain.newKeys = held & ~gMain.heldKeys;
+    gMain.heldKeys = held;
+    assert(sMain);
+    sMain();
+    if (sVBlank) sVBlank();
+}
+static void SetMask(u16 mask) { sSave.vars[TAICHUNG_GYM_COMPLETION_VAR - 0x4000] = mask; }
+static void NoResources(void)
+{
+    u8 i;
+    assert(!sWindow && !sVBlank && !sPaletteTags[0] && !sPaletteTags[1]);
+    for (i = 0; i < MAX_SPRITES; i++) assert(!gSprites[i].inUse);
+}
+static bool8 Printed(const u8 *text)
+{
+    unsigned i;
+    for (i = 0; i < sPrintCount; i++) if (sPrinted[i] == (const char *)text) return TRUE;
+    return FALSE;
+}
+static void OpenPass(void) { gMain.heldKeys = 0; ShowTaichungCityPass(CB2_ReturnToFieldContinueScriptPlayMapMusic); Tick(0); Tick(0); }
+static void CloseScene(u16 key) { Tick(key); Tick(0); Tick(0); NoResources(); }
+static void RealWin(u16 gym, u16 trainer)
+{
+    assert(TaichungGymPrepareChallenge(gym, trainer));
+    TaichungGymOnTrainerBattleStart(trainer);
+    TaichungGymOnTrainerBattleEnd(trainer, B_OUTCOME_WON);
+    assert(TaichungGymIsComplete(gym));
+}
+
+int main(void)
+{
+    static const u16 trainers[TAICHUNG_GYM_COUNT] = {
+        TRAINER_TAICHUNG_STATION_JUN, TRAINER_TAICHUNG_PARK_LIAN, TRAINER_TAICHUNG_MIYAHARA_PEIQI,
+        TRAINER_TAICHUNG_SCIENCE_YICHENG, TRAINER_TAICHUNG_GREENWAY_XINGAN, TRAINER_TAICHUNG_SHEN_JI_AXIU,
+        TRAINER_TAICHUNG_FINE_ARTS_CAINING, TRAINER_TAICHUNG_FENGJIA_JIAHE, TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING,
+        TRAINER_TAICHUNG_THEATER_LING
+    };
+    u16 mask, gym;
+    unsigned before;
+    for (sChinese = FALSE; sChinese <= TRUE; sChinese++)
+    {
+        // Every old-save mask renders without progress writes, fanfare or award.
+        for (mask = 0; mask < 1024; mask++)
+        {
+            SetMask(mask); before = sWrites;
+            OpenPass();
+            assert(sCreates == 10 && sWrites == before && !sFanfare);
+            for (gym = 0; gym < 10; gym++)
+            {
+                assert(gSprites[gym].inUse);
+                assert(gSprites[gym].template->images->size == 128);
+                assert(gSprites[gym].template->paletteTag == sPaletteTags[(mask & (1 << gym)) ? 0 : 1]);
+            }
+            assert(Printed(TaichungBadgeGetName(0)));
+            assert(TaichungGymGetCompletedMask() == mask);
+            CloseScene(B_BUTTON);
+        }
+        SetMask(1023); OpenPass();
+        Tick(DPAD_LEFT); assert(Printed(TaichungBadgeGetName(4)));
+        Tick(DPAD_DOWN); assert(Printed(TaichungBadgeGetName(9)));
+        Tick(DPAD_RIGHT); assert(Printed(TaichungBadgeGetName(5)));
+        Tick(DPAD_UP); assert(Printed(TaichungBadgeGetName(0)));
+        Tick(DPAD_RIGHT); assert(Printed(TaichungBadgeGetName(1)));
+        Tick(A_BUTTON); Tick(0); Tick(0);
+        NoResources(); assert(sCards && sCardReturn);
+        sCardReturn(); Tick(0); Tick(0);
+        assert(Printed(TaichungBadgeGetName(1))); // Selected slot survives Trainer Card.
+        CloseScene(START_BUTTON);
+
+        for (gym = 0; gym < 10; gym++)
+        {
+            SetMask(0); TaichungGymCancelChallenge();
+            gSpecialVar_0x8004 = gym;
+            TaichungBadge_ScriptPrepareAward(); assert(!gSpecialVar_Result);
+            RealWin(gym, trainers[gym]);
+            TaichungBadge_ScriptPrepareAward(); assert(gSpecialVar_Result);
+            before = sWrites;
+            TaichungBadge_ScriptOpenAward(); Tick(A_BUTTON); Tick(A_BUTTON);
+            assert(sCreates == 1 && gSprites[0].template->images->size == 512);
+            assert(Printed(TaichungBadgeGetName(gym)) && sFanfare);
+            Tick(0); Tick(A_BUTTON); // Fresh press during fanfare is not queued.
+            sFanfare = FALSE;
+            Tick(A_BUTTON); assert(sWindow);
+            Tick(0); CloseScene(A_BUTTON);
+            assert(sWrites == before && TaichungGymGetCompletedMask() == (1 << gym));
+            TaichungBadge_ScriptPrepareAward(); assert(!gSpecialVar_Result);
+            assert(!TaichungGymPrepareChallenge(gym, trainers[gym]));
+            assert(!TaichungGymConsumeNewBadge(gym));
+        }
+    }
+    // Playback cannot consume a pending live reward or open a scene afterward.
+    SetMask(0); RealWin(0, trainers[0]); gSpecialVar_0x8004 = 0;
+    gQuestLogState = QL_STATE_PLAYBACK;
+    TaichungBadge_ScriptPrepareAward(); assert(!gSpecialVar_Result);
+    gQuestLogState = 0; TaichungBadge_ScriptPrepareAward(); assert(!gSpecialVar_Result);
+    SetMask(0); RealWin(0, trainers[0]); sPlayback = QL_PLAYBACK_STATE_RUNNING;
+    TaichungBadge_ScriptPrepareAward(); assert(!gSpecialVar_Result);
+    sPlayback = 0; TaichungBadge_ScriptPrepareAward(); assert(!gSpecialVar_Result);
+
+    sFailSpriteAt = 4; OpenPass(); CloseScene(B_BUTTON); sFailSpriteAt = 0;
+    sPaletteFail = TRUE; OpenPass(); assert(sCreates == 0); CloseScene(B_BUTTON); sPaletteFail = FALSE;
+    sFailPaletteAt = 2; OpenPass(); assert(sCreates == 0 && !sPaletteTags[0] && !sPaletteTags[1]); CloseScene(B_BUTTON); sFailPaletteAt = 0;
+    sWindowFail = TRUE; OpenPass(); NoResources(); sWindowFail = FALSE;
+    SetMask(0); RealWin(1, trainers[1]); gSpecialVar_0x8004 = 1;
+    TaichungBadge_ScriptPrepareAward(); assert(gSpecialVar_Result);
+    sFailSpriteAt = 1; TaichungBadge_ScriptOpenAward(); Tick(0); Tick(0);
+    assert(sCreates == 1 && !gSprites[0].inUse && Printed(TaichungBadgeGetName(1)));
+    sFanfare = FALSE; Tick(0); CloseScene(B_BUTTON); sFailSpriteAt = 0;
+    assert(TaichungGymIsComplete(1));
+    // An invalid or duplicate open returns through the script callback safely.
+    TaichungBadge_ScriptOpenAward(); Tick(0); NoResources();
+    assert(sReturns && sCleanups == 22 && sFanfareCount == 21);
+    assert(TaichungBadgeGetName(10)[0] == '\0' && TaichungBadgeGetLandmark(0xFFFF)[0] == '\0');
+    assert(TaichungBadgeCreateSprite(10, FALSE, FALSE, 0, 0) == MAX_SPRITES);
+    puts("PASS: actual scene/adapter C, bilingual2048old-save grids,10new awards/locale, held input, navigation/card return, replay and resource failure cleanup");
+    return 0;
+}
diff --git a/tests/taichung_characters_test.c b/tests/taichung_characters_test.c
new file mode 100644
index 0000000..34675f0
--- /dev/null
+++ b/tests/taichung_characters_test.c
@@ -0,0 +1,259 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_characters.h"
+#include "constants/maps.h"
+#include "constants/event_objects.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool32 sPendingWarp;
+static unsigned sHeaderReads;
+static unsigned sRememberCalls, sWarpRequests;
+static u8 sRememberedFacing;
+static u8 sExpectedMap;
+static const struct MapHeader *sCurrentHeader;
+static const struct MapLayout sLayout = {13, 16};
+static const struct ObjectEventTemplate sObjects[] = {
+    {1, OBJ_EVENT_GFX_TAICHUNG_JUN, 6, 5}, {2, OBJ_EVENT_GFX_TAICHUNG_AMING, 3, 9}
+};
+static const struct MapEvents sEvents = {2, sObjects};
+static const struct MapHeader sHeader = {&sLayout, &sEvents};
+
+bool32 UseContinueGameWarp(void) { return sPendingWarp; }
+void TaichungSaveRememberObjectCacheRefreshFacing(void)
+{
+    assert(!sPendingWarp);
+    assert(sSave.continueGameWarp.mapGroup == sSave.location.mapGroup);
+    assert(sSave.continueGameWarp.mapNum == sSave.location.mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == sSave.pos.x && sSave.continueGameWarp.y == sSave.pos.y);
+    sRememberedFacing = sSave.playerFacing;
+    sRememberCalls++;
+}
+void SetContinueGameWarpStatus(void)
+{
+    assert(sRememberCalls == 1); // Bridge runs after target fill, before pending status.
+    sPendingWarp = TRUE; sWarpRequests++;
+}
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group, u16 number)
+{
+    assert(group == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(number == sExpectedMap);
+    sHeaderReads++;
+    return sCurrentHeader;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.partyBadgesAndOtherSavedData, 0xA5, sizeof(sSave.partyBadgesAndOtherSavedData));
+    sSave.pos.x = 3; sSave.pos.y = 10;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM);
+    sSave.location.warpId = 1;
+    sSave.location.x = 6; sSave.location.y = 13;
+    sSave.objectEventTemplates[0].localId = 1;
+    sSave.objectEventTemplates[0].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+    gSaveBlock1Ptr = &sSave;
+    sPendingWarp = FALSE;
+    sHeaderReads = sRememberCalls = sWarpRequests = 0;
+    sExpectedMap = MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM); sCurrentHeader = &sHeader;
+    memset(sSave.vars, 0x5A, sizeof(sSave.vars));
+    memset(sSave.rawPartyAndInventory, 0xC3, sizeof(sSave.rawPartyAndInventory));
+    sSave.lastHealLocation = (struct WarpData){43,0,-1,30,66};
+    sSave.playerFacing = 2;
+}
+
+static void ExpectUnchanged(void)
+{
+    struct SaveBlock1 before = sSave;
+    TaichungCharactersRefreshOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+}
+
+static void TestNewNpcSpawnSquare(void)
+{
+    static const u8 maps[] = {
+        MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM), MAP_NUM(MAP_TAICHUNG_GREENWAY_GYM),
+        MAP_NUM(MAP_TAICHUNG_SCIENCE_MUSEUM_GYM), MAP_NUM(MAP_TAICHUNG_FENGJIA_GYM),
+        MAP_NUM(MAP_TAICHUNG_THEATER_GYM)
+    };
+    static const u8 graphics[] = {
+        OBJ_EVENT_GFX_TAICHUNG_AMING, OBJ_EVENT_GFX_TAICHUNG_AYAN,
+        OBJ_EVENT_GFX_TAICHUNG_QIAOQIAO, OBJ_EVENT_GFX_TAICHUNG_MEI,
+        OBJ_EVENT_GFX_TAICHUNG_BOXUN
+    };
+    struct SaveBlock1 before;
+    unsigned i;
+    for (i = 0; i < sizeof(maps); i++)
+    {
+        Reset(); sSave.location.mapNum = maps[i];
+        sSave.pos.x = 3; sSave.pos.y = 9;
+        sSave.objectEventTemplates[1] = sObjects[1];
+        sSave.objectEventTemplates[1].graphicsId = graphics[i];
+        before = sSave;
+        sPendingWarp = TRUE; // Also safe during a pending full-map return.
+        TaichungCharactersAvoidNpcSpawnOverlap(3, 9);
+        assert(sSave.objectEventTemplates[1].x == 4);
+        before.objectEventTemplates[1].x = 4;
+        assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+        assert(sPendingWarp); // Neither player coordinates nor warp touched.
+        before = sSave;
+        TaichungCharactersAvoidNpcSpawnOverlap(3, 9);
+        assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+    }
+    Reset(); sSave.objectEventTemplates[1] = sObjects[1]; before = sSave;
+    TaichungCharactersAvoidNpcSpawnOverlap(3, 10);
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_PARK_GYM); before = sSave;
+    TaichungCharactersAvoidNpcSpawnOverlap(3, 9);
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+    sSave.location.mapGroup = 1; before = sSave;
+    TaichungCharactersAvoidNpcSpawnOverlap(3, 9);
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+    gSaveBlock1Ptr = NULL;
+    TaichungCharactersAvoidNpcSpawnOverlap(3, 9);
+    puts("PASS: all five newly occupied NPC squares retain player position; only the matching NPC shifts to reviewed (4,9), idempotent; pending warp/party/badges and other maps unchanged");
+}
+
+static const u8 sStaffMaps[] = {
+    MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM), MAP_NUM(MAP_TAICHUNG_PARK_GYM),
+    MAP_NUM(MAP_TAICHUNG_SHEN_JI_GYM), MAP_NUM(MAP_TAICHUNG_FINE_ARTS_GYM),
+    MAP_NUM(MAP_TAICHUNG_MAPLE_GARDEN_GYM)
+};
+static const u8 sStaffLocalIds[] = {
+    LOCALID_TAICHUNG_STAFF_MIYAHARA, LOCALID_TAICHUNG_STAFF_PARK,
+    LOCALID_TAICHUNG_STAFF_SHEN_JI, LOCALID_TAICHUNG_STAFF_FINE_ARTS,
+    LOCALID_TAICHUNG_STAFF_MAPLE_GARDEN
+};
+static const u8 sStaffGraphics[] = {
+    OBJ_EVENT_GFX_WOMAN_2, OBJ_EVENT_GFX_MAN, OBJ_EVENT_GFX_LASS,
+    OBJ_EVENT_GFX_WOMAN_1, OBJ_EVENT_GFX_SCIENTIST
+};
+static struct ObjectEventTemplate sStaffObjects[2];
+static const struct MapEvents sStaffEvents = {2, sStaffObjects};
+static const struct MapHeader sStaffHeader = {&sLayout, &sStaffEvents};
+
+static void StaffRoom(unsigned index)
+{
+    Reset(); sSave.location.mapNum = sExpectedMap = sStaffMaps[index];
+    sStaffObjects[0] = sObjects[0];
+    sStaffObjects[1] = (struct ObjectEventTemplate){sStaffLocalIds[index],sStaffGraphics[index],3,9};
+    sCurrentHeader = &sStaffHeader;
+    sSave.objectEventTemplates[0] = sStaffObjects[0];
+    assert(sStaffLocalIds[index] == 2);
+}
+
+static void ExpectStaffRefresh(void)
+{
+    struct SaveBlock1 before = sSave;
+    TaichungCharactersRefreshOnContinue();
+    assert(sPendingWarp && sWarpRequests == 1 && sRememberCalls == 1);
+    assert(sRememberedFacing == before.playerFacing);
+    before.continueGameWarp = sSave.continueGameWarp;
+    assert(memcmp(&before,&sSave,sizeof(sSave)) == 0);
+    before = sSave;
+    TaichungCharactersRefreshOnContinue(); // Pending native return wins on repeated call.
+    assert(memcmp(&before,&sSave,sizeof(sSave)) == 0 && sWarpRequests == 1 && sRememberCalls == 1);
+}
+
+static void TestFiveVanillaStaff(void)
+{
+    struct SaveBlock1 before;
+    unsigned i, direction;
+    for (i = 0; i < sizeof(sStaffMaps); i++)
+    {
+        for (direction = 2; direction <= 3; direction++)
+        {
+            StaffRoom(i); sSave.playerFacing = direction;
+            ExpectStaffRefresh(); // Missing vanilla helper, exact saved position/facing request.
+        }
+        StaffRoom(i); sSave.objectEventTemplates[1] = sStaffObjects[1];
+        sSave.objectEventTemplates[1].graphicsId ^= 1; ExpectStaffRefresh();
+        StaffRoom(i); sSave.objectEventTemplates[1] = sStaffObjects[1];
+        sSave.objectEventTemplates[1].x = 8; ExpectStaffRefresh();
+        StaffRoom(i); sSave.objectEventTemplates[63] = sStaffObjects[1];
+        ExpectUnchanged(); assert(!sPendingWarp); // Full cache search reaches the last slot.
+        StaffRoom(i); sSave.pos.y = 16;
+        ExpectUnchanged(); assert(!sPendingWarp && sRememberCalls == 0);
+        StaffRoom(i); sSave.objectEventTemplates[1] = sStaffObjects[1];
+        ExpectUnchanged(); assert(!sPendingWarp && sRememberCalls == 0);
+        sSave.objectEventTemplates[1].x = 4;
+        ExpectUnchanged(); assert(!sPendingWarp); // Accepted prior overlap fallback does not loop.
+        StaffRoom(i); sStaffObjects[1].localId = 3;
+        ExpectUnchanged(); assert(!sPendingWarp); // Shared sprite alone is insufficient.
+        StaffRoom(i); sStaffObjects[1].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+        ExpectUnchanged(); assert(!sPendingWarp);
+        StaffRoom(i); sPendingWarp = TRUE; sSave.continueGameWarp = (struct WarpData){1,2,3,4,5};
+        ExpectUnchanged(); assert(sHeaderReads == 0 && sRememberCalls == 0);
+        // Model the full reload after an old saved player occupied the new authored square.
+        StaffRoom(i); sSave.pos = (struct Coords16){3,9}; ExpectStaffRefresh();
+        sSave.objectEventTemplates[1] = sStaffObjects[1]; before = sSave;
+        TaichungCharactersAvoidNpcSpawnOverlap(3,9);
+        before.objectEventTemplates[1].x = 4;
+        assert(memcmp(&before,&sSave,sizeof(sSave)) == 0 && sPendingWarp);
+        before = sSave; TaichungCharactersAvoidNpcSpawnOverlap(3,9);
+        assert(memcmp(&before,&sSave,sizeof(sSave)) == 0);
+        sPendingWarp = FALSE; sRememberCalls = sWarpRequests = 0;
+        ExpectUnchanged(); assert(!sPendingWarp && sRememberCalls == 0);
+        StaffRoom(i); sSave.objectEventTemplates[1] = sStaffObjects[1];
+        sSave.objectEventTemplates[1].localId = 3; before = sSave;
+        TaichungCharactersAvoidNpcSpawnOverlap(3,9); assert(memcmp(&before,&sSave,sizeof(sSave)) == 0);
+        StaffRoom(i); sSave.objectEventTemplates[1] = sStaffObjects[1];
+        sSave.objectEventTemplates[1].graphicsId ^= 1; before = sSave;
+        TaichungCharactersAvoidNpcSpawnOverlap(3,9); assert(memcmp(&before,&sSave,sizeof(sSave)) == 0);
+        StaffRoom(i); sSave.objectEventTemplates[1] = sStaffObjects[1]; before = sSave;
+        TaichungCharactersAvoidNpcSpawnOverlap(4,9); assert(memcmp(&before,&sSave,sizeof(sSave)) == 0);
+    }
+    StaffRoom(0); sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    sExpectedMap = sSave.location.mapNum; sStaffObjects[0].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+    ExpectUnchanged(); assert(!sPendingWarp); // Exact map qualification.
+    puts("PASS: five exact vanilla staff identities; missing/stale cache and saved overlap; authored/fallback idempotence; facing bridge call order; protected save bytes, native pending returns and unrelated identities unchanged");
+}
+
+int main(void)
+{
+    struct SaveBlock1 before;
+    TestNewNpcSpawnSquare();
+    TestFiveVanillaStaff();
+    Reset();
+    before = sSave;
+    TaichungCharactersRefreshOnContinue();
+    assert(sPendingWarp && sHeaderReads == 1);
+    assert(sSave.continueGameWarp.mapGroup == sSave.location.mapGroup);
+    assert(sSave.continueGameWarp.mapNum == sSave.location.mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == 3 && sSave.continueGameWarp.y == 10);
+    before.continueGameWarp = sSave.continueGameWarp;
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+
+    Reset();
+    sSave.objectEventTemplates[0] = sObjects[0];
+    TaichungCharactersRefreshOnContinue();
+    assert(sPendingWarp); // Added optional NPC was not in the saved templates.
+
+    Reset();
+    sSave.objectEventTemplates[0] = sObjects[0];
+    sSave.objectEventTemplates[1] = sObjects[1];
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); sPendingWarp = TRUE;
+    sSave.continueGameWarp.mapGroup = 1;
+    ExpectUnchanged(); assert(sHeaderReads == 0);
+
+    Reset(); sSave.location.mapGroup = 1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.location.mapNum = -1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.pos.x = 13;
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); gSaveBlock1Ptr = NULL;
+    TaichungCharactersRefreshOnContinue(); assert(sHeaderReads == 0);
+    puts("PASS: stale character caches refresh at saved position; party/badges preserved; current caches, pending warps, unrelated maps and invalid inputs untouched");
+    return 0;
+}
diff --git a/tests/taichung_exploration_test.c b/tests/taichung_exploration_test.c
new file mode 100644
index 0000000..fd44393
--- /dev/null
+++ b/tests/taichung_exploration_test.c
@@ -0,0 +1,92 @@
+#include "global.h"
+#include "taichung_exploration.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sPreferenceWrites;
+static unsigned sProgressWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Preference reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_EXPLORATION_WILD_VAR || id == TAICHUNG_EXPLORATION_SIGHT_VAR || id == TAICHUNG_GYM_COMPLETION_VAR);
+    if (id == TAICHUNG_GYM_COMPLETION_VAR) ++sProgressWrites;
+    else ++sPreferenceWrites;
+    sVariables[id-0x4000] = value;
+    return TRUE;
+}
+
+int main(void)
+{
+    u16 wild, sight, range;
+    u32 rate;
+    unsigned before;
+    const u32 rates[] = {0,1,3,4,7,16,80,1600,0xFFFFFFFF};
+    unsigned i;
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(sPreferenceWrites == 0); // Old saves default without replay or mutation.
+    assert(!TaichungExplorationSetMode(2,1));
+    assert(!TaichungExplorationSetMode(0,0));
+    assert(!TaichungExplorationSetMode(1,4));
+    assert(sPreferenceWrites == 0);
+    sVariables[0xF8] = 65535;
+    sVariables[0xF9] = 8;
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_NORMAL);
+
+    for (wild = 1; wild <= 3; ++wild)
+    {
+        for (sight = 1; sight <= 3; ++sight)
+        {
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_WILD,wild));
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_SIGHT,sight));
+            before = sPreferenceWrites;
+            assert(TaichungExplorationGetMode(0) == wild && TaichungExplorationGetMode(1) == sight);
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            // Script disabling and re-enabling encounters cannot erase saved Off.
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(TaichungExplorationAllowsTrainerSight() == (sight != TAICHUNG_EXPLORATION_OFF));
+            for (i = 0; i < sizeof(rates)/sizeof(rates[0]); ++i)
+            {
+                rate = rates[i];
+                if (wild == TAICHUNG_EXPLORATION_OFF) rate = 0;
+                else if (wild == TAICHUNG_EXPLORATION_LOW && rate > 0) rate = rate/4 ? rate/4 : 1;
+                assert(TaichungExplorationAdjustAutomaticWildRate(rates[i]) == rate);
+            }
+            for (range = 0; range <= 255; ++range)
+            {
+                u8 expected = sight == TAICHUNG_EXPLORATION_OFF ? 0 : sight == TAICHUNG_EXPLORATION_LOW && range > 1 ? 1 : range;
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected);
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected); // Deterministic, no frame reroll.
+            }
+            assert(sPreferenceWrites == before && sProgressWrites == 0);
+        }
+    }
+
+    // Changing preferences during a real tracked battle never cancels its win.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_OLD_STATION,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungExplorationSetMode(0,TAICHUNG_EXPLORATION_OFF);
+    TaichungExplorationSetMode(1,TAICHUNG_EXPLORATION_OFF);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 1 && sProgressWrites == 1);
+    // Voluntary gym preparation still works with both automatic settings Off.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 2 && sProgressWrites == 2);
+    TaichungGymCancelChallenge();
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_OFF);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_OFF);
+    puts("PASS: nine independent encounter/sight combinations; old-save defaults; quarter-rate/minimum; all sight ranges; temporary reset cannot override Off; voluntary and active gym wins remain valid.");
+    return 0;
+}
diff --git a/tests/taichung_gym_progress_test.c b/tests/taichung_gym_progress_test.c
new file mode 100644
index 0000000..2a95041
--- /dev/null
+++ b/tests/taichung_gym_progress_test.c
@@ -0,0 +1,218 @@
+#include "global.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Progress reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value) { assert(id == TAICHUNG_GYM_COMPLETION_VAR); sVariables[id-0x4000]=value; ++sWrites; return TRUE; }
+static void reset(void) { memset(sVariables,0,sizeof(sVariables)); sWrites=0; TaichungGymOnTrainerBattleStart(TRAINER_NONE); }
+
+static void FinishChallenge(u16 gymId, u8 outcome)
+{
+    // Released trainer fixture: these state tests need no private gym roster.
+    assert(TaichungGymPrepareChallenge(gymId, TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, outcome);
+}
+
+static void TestLossNotice(void)
+{
+    u16 originalVariables[256];
+    u16 earned = (1 << TAICHUNG_GYM_OLD_STATION) | (1 << TAICHUNG_GYM_FINE_ARTS);
+    u8 outcome;
+    reset();
+    sVariables[0xF7] = 1;
+    sVariables[0xF8] = 1;
+    sVariables[0xF9] = 3;
+    sVariables[0xFA] = earned;
+    sVariables[0xFB] = 2;
+    sVariables[0xFC] = 25;
+    sVariables[0xFD] = 3;
+    memcpy(originalVariables, sVariables, sizeof(originalVariables));
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+
+    FinishChallenge(TAICHUNG_GYM_PARK, B_OUTCOME_LOST);
+    assert(TaichungGymGetLastResult() == TAICHUNG_GYM_RESULT_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA));
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_COUNT));
+    assert(!TaichungGymConsumeLossNotice(65535));
+    assert(TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, B_OUTCOME_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+
+    // A duplicate end must neither erase the genuine notice nor recreate a
+    // notice after it was consumed above.
+    FinishChallenge(TAICHUNG_GYM_PARK, B_OUTCOME_LOST);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, B_OUTCOME_LOST);
+    assert(TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK, TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, B_OUTCOME_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK)); // Missing start.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK, TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, B_OUTCOME_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK)); // Wrong start.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK, TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN, B_OUTCOME_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK)); // Wrong end.
+
+    // Preserve the old broad non-win result while distinguishing raw defeat.
+    for (outcome = 0; outcome < 16; outcome++)
+    {
+        if (outcome == B_OUTCOME_WON)
+            continue;
+        FinishChallenge(TAICHUNG_GYM_MIYAHARA, outcome);
+        assert(TaichungGymGetLastResult() == TAICHUNG_GYM_RESULT_LOST);
+        assert(TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA) == (outcome == B_OUTCOME_LOST));
+        assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA));
+    }
+
+    FinishChallenge(TAICHUNG_GYM_PARK, B_OUTCOME_LOST);
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_MIYAHARA, TRAINER_TAICHUNG_STATION_JUN));
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK)); // New valid prep.
+    TaichungGymCancelChallenge();
+    FinishChallenge(TAICHUNG_GYM_PARK, B_OUTCOME_LOST);
+    TaichungGymCancelChallenge();
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+    FinishChallenge(TAICHUNG_GYM_MIYAHARA, B_OUTCOME_LOST);
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA)); // Untracked start.
+
+    FinishChallenge(TAICHUNG_GYM_MIYAHARA, B_OUTCOME_LOST);
+    assert(!TaichungGymPrepareChallenge(TAICHUNG_GYM_COUNT, TRAINER_TAICHUNG_STATION_JUN));
+    assert(TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA)); // Invalid prep is not a new challenge.
+    assert(memcmp(originalVariables, sVariables, sizeof(originalVariables)) == 0 && sWrites == 0);
+
+    // A genuine win keeps every earlier bit, writes only its own bit once,
+    // creates no loss notice, and cannot be turned into a loss by repetition.
+    FinishChallenge(TAICHUNG_GYM_PARK, B_OUTCOME_WON);
+    assert(TaichungGymGetLastResult() == TAICHUNG_GYM_RESULT_WON);
+    assert(TaichungGymGetCompletedMask() == (earned | (1 << TAICHUNG_GYM_PARK)));
+    assert(sWrites == 1 && !TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN, B_OUTCOME_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK) && sWrites == 1);
+    FinishChallenge(TAICHUNG_GYM_MIYAHARA, B_OUTCOME_LOST);
+    assert(TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA));
+    assert(TaichungGymGetCompletedMask() == (earned | (1 << TAICHUNG_GYM_PARK)) && sWrites == 1);
+}
+
+static void TestMiyaharaWithPriorBadges(void)
+{
+    u16 before[256];
+    reset();
+    sVariables[0xF7] = 4;
+    sVariables[0xF8] = 1;
+    sVariables[0xF9] = 1;
+    sVariables[0xFA] = (1 << TAICHUNG_GYM_OLD_STATION) | (1 << TAICHUNG_GYM_PARK);
+    sVariables[0xFB] = 2;
+    sVariables[0xFC] = 4;
+    sVariables[0xFD] = 1;
+    memcpy(before, sVariables, sizeof(before));
+
+    assert(TRAINER_TAICHUNG_MIYAHARA_PEIQI < NUM_TRAINERS);
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_MIYAHARA, TRAINER_TAICHUNG_MIYAHARA_PEIQI));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_MIYAHARA_PEIQI);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_MIYAHARA_PEIQI, B_OUTCOME_LOST);
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_PARK));
+    assert(!TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK, TRAINER_TAICHUNG_PARK_LIAN));
+    assert(TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA));
+    assert(!TaichungGymConsumeLossNotice(TAICHUNG_GYM_MIYAHARA));
+    assert(sWrites == 0 && memcmp(before, sVariables, sizeof(before)) == 0);
+
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_MIYAHARA, TRAINER_TAICHUNG_MIYAHARA_PEIQI));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_MIYAHARA_PEIQI);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_PARK_LIAN, B_OUTCOME_WON);
+    assert(sWrites == 0 && memcmp(before, sVariables, sizeof(before)) == 0);
+
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_MIYAHARA, TRAINER_TAICHUNG_MIYAHARA_PEIQI));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_MIYAHARA_PEIQI);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_MIYAHARA_PEIQI, B_OUTCOME_WON);
+    before[0xFA] |= 1 << TAICHUNG_GYM_MIYAHARA;
+    assert(TaichungGymGetCompletedMask() == 7 && TaichungGymGetCompletedCount() == 3);
+    assert(sWrites == 1 && memcmp(before, sVariables, sizeof(before)) == 0);
+    assert(!TaichungGymPrepareChallenge(TAICHUNG_GYM_MIYAHARA, TRAINER_TAICHUNG_MIYAHARA_PEIQI));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_MIYAHARA_PEIQI, B_OUTCOME_WON);
+    assert(sWrites == 1 && memcmp(before, sVariables, sizeof(before)) == 0);
+}
+
+int main(void)
+{
+    u16 gym;
+    u8 outcome;
+    const char *expected[] = {"old-taichung-station","taichung-park","miyahara","natural-science-museum","calligraphy-greenway","shen-ji-new-village","fine-arts-museum","fengjia-night-market","maple-garden","taichung-theater"};
+    TestLossNotice();
+    TestMiyaharaWithPriorBadges();
+    reset();
+    assert(TaichungGymGetCompletedCount()==0);
+    assert(!TaichungGymIsComplete(10) && !TaichungGymIsComplete(65535));
+    assert(TaichungGymGetLandmarkId(10)==NULL);
+    assert(!TaichungGymPrepareChallenge(10,TRAINER_TAICHUNG_STATION_JUN));
+    assert(!TaichungGymPrepareChallenge(0,TRAINER_NONE));
+    assert(!TaichungGymPrepareChallenge(0,NUM_TRAINERS));
+    assert(sWrites==0);
+
+    // A prepared script or a stale old win alone is not a completed challenge.
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0 && TaichungGymGetCompletedMask()==0);
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0);
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN,B_OUTCOME_WON);
+    assert(sWrites==0);
+
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymCancelChallenge();
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0);
+
+    // Every non-win outcome must preserve completion state and allow a retry.
+    for (outcome=0; outcome<16; ++outcome)
+    {
+        if (outcome==B_OUTCOME_WON) continue;
+        assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,outcome);
+        assert(TaichungGymGetCompletedMask()==0 && sWrites==0);
+    }
+
+    // All ten bits are distinct, in the accepted permanent landmark order.
+    for (gym=0; gym<TAICHUNG_GYM_COUNT; ++gym)
+    {
+        assert(strcmp(TaichungGymGetLandmarkId(gym),expected[gym])==0);
+        assert(TaichungGymPrepareChallenge(gym,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        assert(sWrites==gym);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+        assert(TaichungGymIsComplete(gym));
+        assert(TaichungGymGetCompletedCount()==gym+1);
+        assert(TaichungGymGetLastResult()==TAICHUNG_GYM_RESULT_WON);
+        assert(!TaichungGymPrepareChallenge(gym,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+        assert(sWrites==gym+1);
+    }
+    assert(TaichungGymGetCompletedMask()==0x03FF && sWrites==10);
+    // Volatile battle state can clear while saved mask remains intact.
+    TaichungGymOnTrainerBattleStart(TRAINER_NONE);
+    assert(TaichungGymGetCompletedCount()==10);
+    sVariables[0xFA]=0xFC00; // Reserved high bits must not inflate the ten-state count.
+    assert(TaichungGymGetCompletedCount()==0);
+    puts("PASS: ten independent saved states; real-start/matching-trainer/win guards; consume-once actual-loss notice and stale/duplicate guards; loss/retry/ID boundaries; stable IDs; no writes outside VAR_0x40FA.");
+    return 0;
+}
diff --git a/tests/taichung_gym_staff_geometry_test.py b/tests/taichung_gym_staff_geometry_test.py
new file mode 100644
index 0000000..f5c77d0
--- /dev/null
+++ b/tests/taichung_gym_staff_geometry_test.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Validate the five added staff against real native floor/actor/warp data."""
+from collections import deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+BASE = '2c48f28b998b67413baf058557752723ea121500'
+MANIFEST = 'data/taichung/gym-staff/manifest.json'
+# Merged onto the live city rework, the shared layout and map-group tables carry the
+# city's new maps. Where the staff work left an input at BASE and the city changed
+# it, the tree must hold exactly the city's bytes.
+CITY = 'a2f2afaeaebd0fd5a30c4547bed8a0df5dac00fd'
+CITY_RECORD = 'data/taichung/city-rework/save-v10.json'
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def main():
+    registration = json.loads((ROOT / MANIFEST).read_text())
+    assert registration['baselineCommit'] == BASE
+    spec = importlib.util.spec_from_file_location('staff_native_geometry', ROOT / 'tools/taichung/validate_city.py')
+    native = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(native)
+    layouts = {item['id']: item for item in json.loads((ROOT / 'data/layouts/layouts.json').read_text())['layouts'] if 'id' in item}
+    city = (ROOT / CITY_RECORD).exists()
+    for path, expected in registration['unchangedInputsSha256'].items():
+        raw = (ROOT / path).read_bytes()
+        before = subprocess.check_output(['git', 'show', BASE + ':' + path], cwd=ROOT)
+        assert digest(before) == expected, path
+        if city and raw != before:
+            assert raw == subprocess.check_output(['git', 'show', CITY + ':' + path], cwd=ROOT), path
+            continue
+        assert digest(raw) == expected, path
+        assert raw == before, path
+    for path, expected in registration['sourceFilesSha256'].items():
+        assert digest((ROOT / path).read_bytes()) == expected, path
+    assert len(registration['staff']) == 5
+    for item in registration['staff']:
+        path = item['mapPath']; raw = (ROOT / path).read_bytes()
+        before = subprocess.check_output(['git', 'show', BASE + ':' + path], cwd=ROOT)
+        assert digest(raw) == item['installedMapSha256'] and digest(before) == item['baselineMapSha256']
+        data, old = json.loads(raw), json.loads(before)
+        assert len(data['object_events']) == 2 and len(old['object_events']) == 1
+        assert data['object_events'][0] == old['object_events'][0] and data['object_events'][1] == item['addedObject']
+        stripped = dict(data); stripped['object_events'] = stripped['object_events'][:1]
+        assert stripped == old, 'Only one added object is allowed: ' + path
+        assert data['layout'] == 'LAYOUT_TAICHUNG_LANDMARK_GYM' and data['connections'] is None
+        assert data['warp_events'] == item['unchangedWarpEvents']
+        view = native.Map(ROOT, old, layouts[data['layout']], {})
+        for point in item['qualifiedCells']:
+            x, y = point['x'], point['y']
+            assert view.walkable(x, y) and view.behavior(x, y) == 0 and view.elevation(x, y) == 3
+            assert f'0x{view.cell(x,y):04X}' == point['word'] == '0x3294'
+            blocked = view.obstacles | {(x, y)}
+            visited = {(6,14)}; queue = deque(visited)
+            while queue:
+                a,b = queue.popleft()
+                for c,d in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):
+                    if (c,d) not in visited and (c,d) not in blocked and view.can_step(a,b,view,c,d):
+                        visited.add((c,d)); queue.append((c,d))
+            targets = {(5,14),(6,14),(7,14),(6,6),(x,y+1)}
+            if (x,y) == (4,9): targets.add((3,9))
+            assert targets <= visited, (path, point, targets - visited)
+            assert len(visited) == point['reachableFloorCells']
+        assert not view.walkable(6,5), 'Leader remains an occupied actor, not a public route'
+        assert not view.walkable(0,0), 'The native boundary must stay solid'
+    print('PASS: five exact actor-only room deltas; all ten authored/fallback floor cases, leader/talk approaches and three exit cells reachable; existing helpers/layout/borders/warps unchanged')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/taichung_jun_test.c b/tests/taichung_jun_test.c
new file mode 100644
index 0000000..a6a6bf7
