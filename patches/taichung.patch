@@ -0,0 +1,37 @@
+#include "global.h"
+#include "pokemon.h"
+#include "taichung_team_presets.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+
+#include "data/taichung_team_presets.h"
+
+bool8 TaichungTeamSpeciesAllowed(u16 species)
+{
+    return species >= SPECIES_BULBASAUR && species <= SPECIES_MEWTWO;
+}
+
+const u16 *TaichungTeamGetPresetMoves(u16 species)
+{
+    if (!TaichungTeamSpeciesAllowed(species))
+        return NULL;
+    return sTaichungTeamPresetMoves[species - SPECIES_BULBASAUR];
+}
+
+void TaichungTeamApplyPreset(struct Pokemon *mon)
+{
+    const u16 *moves;
+    u8 slot;
+    u8 ppBonuses = 0;
+
+    if (mon == NULL)
+        return;
+    moves = TaichungTeamGetPresetMoves(GetMonData(mon, MON_DATA_SPECIES, NULL));
+    if (moves == NULL)
+        return;
+
+    // Reset old PP Ups before installing a different moveset.
+    SetMonData(mon, MON_DATA_PP_BONUSES, &ppBonuses);
+    for (slot = 0; slot < MAX_MON_MOVES; slot++)
+        SetMonMoveSlot(mon, moves[slot], slot);
+}
diff --git a/src/taichung_theater_access.c b/src/taichung_theater_access.c
new file mode 100644
index 00000000..e89fb7b7
--- /dev/null
+++ b/src/taichung_theater_access.c
@@ -0,0 +1,39 @@
+#include "global.h"
+#include "fieldmap.h"
+#include "load_save.h"
+#include "overworld.h"
+#include "taichung_save.h"
+#include "taichung_theater_access.h"
+#include "constants/maps.h"
+
+// The room keeps every old position and warp. Its cached seat row must still
+// be replaced on ordinary and quest-log Continue, using the native reload path.
+void TaichungTheaterRefreshOnContinue(void)
+{
+    const struct MapHeader *header;
+    struct WarpData *warp;
+
+    if (gSaveBlock1Ptr == NULL || UseContinueGameWarp()
+        || gSaveBlock1Ptr->playerPartyCount == 0 || gSaveBlock1Ptr->playerPartyCount > PARTY_SIZE
+        || gSaveBlock1Ptr->vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START] != TAICHUNG_SAVE_VERSION
+        || gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_TAICHUNG_THEATER_GYM)
+        || gSaveBlock1Ptr->location.mapNum != MAP_NUM(MAP_TAICHUNG_THEATER_GYM))
+        return;
+    header = Overworld_GetMapHeaderByGroupAndId(MAP_GROUP(MAP_TAICHUNG_THEATER_GYM), MAP_NUM(MAP_TAICHUNG_THEATER_GYM));
+    if (header == NULL || header->mapLayout == NULL || header->mapLayout->map == NULL
+        || gSaveBlock1Ptr->pos.x < 0 || gSaveBlock1Ptr->pos.y < 0
+        || gSaveBlock1Ptr->pos.x >= header->mapLayout->width
+        || gSaveBlock1Ptr->pos.y >= header->mapLayout->height)
+        return;
+    if (header->mapLayout->map[gSaveBlock1Ptr->pos.y * header->mapLayout->width + gSaveBlock1Ptr->pos.x] & 0x0C00)
+        return;
+    // An already pending native door/whiteout/repair owns its destination.
+    // location.x/y are historical warp coordinates; pos is the saved tile.
+    warp = &gSaveBlock1Ptr->continueGameWarp;
+    *warp = gSaveBlock1Ptr->location;
+    warp->warpId = -1;
+    warp->x = gSaveBlock1Ptr->pos.x;
+    warp->y = gSaveBlock1Ptr->pos.y;
+    TaichungSaveRememberObjectCacheRefreshFacing();
+    SetContinueGameWarpStatus();
+}
