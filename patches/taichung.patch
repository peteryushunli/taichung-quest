+"""Compare a retained f7 city generation with a resident-motion-only candidate."""
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+
+p=argparse.ArgumentParser(description=__doc__)
+p.add_argument('baseline',type=Path);p.add_argument('candidate',type=Path);p.add_argument('output',type=Path)
+a=p.parse_args();old=json.loads((a.baseline/'build-report.json').read_text());new=json.loads((a.candidate/'build-report.json').read_text())
+assert old['reachable']==new['reachable'] and old['budget']==new['budget']
+actors=[];previous=[];walk=set();changed=[]
+allowed={'x','y','movement_type','movement_range_x','movement_range_y'}
+for before,after in zip(old['maps'],new['maps']):
+ for key in set(before)|set(after):
+  if key!='people':assert before.get(key)==after.get(key),(before['name'],key)
+ assert len(before['people'])==len(after['people'])
+ x0,y0,_,_=before['worldRect']
+ for y,row in enumerate(after['localWalkable']):
+  walk.update((x0+x,y0+y) for x,v in enumerate(row) if v=='1')
+ for localid,(b,c) in enumerate(zip(before['people'],after['people']),1):
+  previous.append((x0+b['x'],y0+b['y']));actors.append((x0+c['x'],y0+c['y']))
+  if b['script'].startswith('TaichungBoulevard_Ambient_'):
+   assert all(b.get(k)==c.get(k) for k in (set(b)|set(c))-allowed)
+   assert c['movement_type'] in ('MOVEMENT_TYPE_WANDER_AROUND_SLOWER','MOVEMENT_TYPE_WANDER_UP_AND_DOWN','MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT')
+   if b!=c:changed.append(dict(map=after['number'],localId=localid,script=c['script']))
+  else:assert b==c,('Changed existing role',b,c)
+# Generated tiles, primary resources, connections, signs, doors and geometry must be exact.
+for f in a.baseline.rglob('*'):
+ if not f.is_file() or f.name=='build-report.json':continue
+ other=a.candidate/f.relative_to(a.baseline);assert other.is_file()
+ if f.name!='map.json':assert f.read_bytes()==other.read_bytes(),str(f)
+ else:
+  b=json.loads(f.read_text());c=json.loads(other.read_text())
+  for k in (set(b)|set(c))-{'object_events'}:assert b.get(k)==c.get(k),(f,k)
+assert len(changed)==55 and len(actors)==75
+modes=Counter(row['movement'] for row in new['streetMotion'] if row['role']=='ambient')
+assert modes['MOVEMENT_TYPE_WANDER_AROUND_SLOWER']==41 and sum(modes.values())==55
+assert len(new['streetMotion'])==58
+# Same uniform viewport statistic as the first population review; spawn-only, not route coverage.
+def coverage(points):
+ counts=[sum(cx-7<=x<=cx+7 and cy-5<=y<=cy+4 for x,y in points) for cx,cy in walk]
+ return dict(visiblePositions=sum(n>0 for n in counts),walkablePositions=len(walk),percent=100*sum(n>0 for n in counts)/len(walk),maxVisible=max(counts))
+r=dict(passed=True,baselineNative='f7e7d04d',outdoorTotal=75,moving=58,stationary=17,regularResidents=55,residentMovementProfiles=dict(modes),changedAmbientActors=changed,allOldLocalIdsScriptsGraphicsRolesPreserved=True,existingThreeTrainerContractsExact=True,allTerrainArtGeometryDoorsSignsAndConnectionsExact=True,all54SectionsPopulated=True,viewportMetric='15x10 tiles around uniform walkable cells, static spawn coordinates, not travel-route probability',beforeCoverage=coverage(previous),afterCoverage=coverage(actors),fullPossibleEnvelopeCompilerChecks='walkable, own map, no road/crossing, no overlaps, protected event clearance, connected travel network even when all possible envelopes are blocked',nativeRuntimeAcceptance='Separate required receipt; this tool checks source and generation only')
+a.output.write_text(json.dumps(r,indent=2)+'\n');print(json.dumps({k:v for k,v in r.items() if k!='changedAmbientActors'},indent=2))
