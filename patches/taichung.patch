+static u8 GetMCWindowHeight(u8 count)
+{
+    switch (count)
+    {
+    case 0:
+        return 1;
+    case 1:
+        return 2;
+    case 2:
+        return 4;
+    case 3:
+        return 6;
+    case 4:
+        return 7;
+    case 5:
+        return 9;
+    case 6:
+        return 11;
+    case 7:
+        return 13;
+    case 8:
+        return 14;
+    default:
+        return 1;
+    }
+}
