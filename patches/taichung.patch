@@ -0,0 +1,46 @@
+@ A new game wakes here, in the FireRed player's-house bedroom: the settings
+@ screen (language, then encounters) first, then Xiaoyu calls from downstairs.
+TaichungGuestHouse_2F_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, TaichungGuestHouse_2F_OnFrame
+	.byte 0
+
+TaichungGuestHouse_2F_OnFrame::
+	map_script_2 TAICHUNG_LANGUAGE, 0, TaichungGuestHouse_2F_WakeUp
+	.2byte 0
+
+TaichungGuestHouse_2F_WakeUp::
+	lockall
+	turnobject LOCALID_PLAYER, DIR_NORTH
+	@ The web player answers first with the visitor's browser language. The
+	@ settings screen then shows it on its LANGUAGE row, above the two
+	@ encounter rows, so there is no separate language prompt.
+	callnative TaichungOnboarding_ScriptStartupEligible
+	goto_if_eq VAR_RESULT, FALSE, TaichungGuestHouse_2F_Settings
+	callnative TaichungOnboarding_ScriptBeginStartup
+	waitstate
+	closemessage
+TaichungGuestHouse_2F_Settings::
+	callnative TaichungExploration_ScriptOpenStartup
+	waitstate
+	callnative TaichungOnboarding_ScriptLanguageReady
+	callnative TaichungGuestHouse_BufferCallDownstairs
+	msgbox gStringVar4
+	releaseall
+	end
+
+TaichungGuestHouse_2F_Console::
+	callnative TaichungGuestHouse_BufferConsole
+	msgbox gStringVar4, MSGBOX_SIGN
+	end
+
+TaichungGuestHouse_2F_Laptop::
+	callnative TaichungGuestHouse_BufferLaptop
+	msgbox gStringVar4, MSGBOX_SIGN
+	end
+
+TaichungGuestHouse_2F_Poster::
+	callnative TaichungGuestHouse_BufferPoster
+	msgbox gStringVar4, MSGBOX_SIGN
+	end
