+kit=root/'artifacts/boulevard-plan/fill/out/native-city-edges/authoring/kit/sprites'
+scene=Image.open(p/'proposal-native.png').convert('RGBA')
+def stamp(name, x, y):
+    with Image.open(kit/f'{name}.png') as im:
+        scene.alpha_composite(im.convert('RGBA'),((x-44)*16,(y-60)*16))
+stamp('market-produce-cart',58,83)
+stamp('crates-and-pavement-sign',55,80)
+stamp('flower-shrub',67,77)
