+    assert layout['primary_tileset']==manifest['primary']
+    assert layout['secondary_tileset'] in ('gTileset_TaichungOldCore',manifest['secondary'])
+    layout['secondary_tileset']=manifest['secondary'];p.write_text(json.dumps(layouts,indent=2)+'\n')
+    MAP.write_bytes((DATA/'map.bin').read_bytes());manifest['registeredInSource']=True
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--install',action='store_true');args=parser.parse_args()
+    result=compile_scene()
