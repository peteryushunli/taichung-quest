+ROOT = Path(__file__).resolve().parents[3]
+BASE = '16625bd'
+DATA = ROOT/'data/taichung/landmarks/greenway-native'
+OUT = ROOT/'data/tilesets/secondary/taichung_greenway'
+PRIMARY = 'data/tilesets/primary/taichung_old_core'
+CORE = 'data/tilesets/secondary/taichung_old_core'
+MID = 'MAP_TAICHUNG_GREENWAY'
+MAP = ROOT/'data/layouts/TaichungGreenway/map.bin'
+ANIMATED = set(range(416,482)) | set(range(508,512))
+SPECS = [dict(id='science-museum', input='science-museum/candidate-compact/candidate-indexed.png',
+              origin=[19,15], door=[24,20], palette=7, retired=[19,14,29,20]),
+         dict(id='shen-ji', input='shen-ji/candidate/nativecourtyard-layout-v2-indexed.png',
+              origin=[7,39], door=[10,44], palette=9, retired=[8,41,13,44]),
+         dict(id='fine-arts', input='fine-arts/candidate/facade/candidate-indexed.png',
+              origin=[5,57], door=[10,62], palette=7, retired=[5,56,15,62]),
+         dict(id='fine-arts-sculpture', input='fine-arts/candidate/sculpture-shared/candidate-indexed.png',
+              origin=[14,64], door=None, palette=9, role='prop', parent='fine-arts')]
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(pixels):
+    return min((tuple(pixels[(7-y if f&0x800 else y)*8+(7-x if f&0x400 else x)] for y in range(8) for x in range(8)),f)
+               for f in (0,0x400,0x800,0xc00))
+
+
+def words(path, values=None, kind='H'):
+    import struct
+    if values is None:
+        raw=path.read_bytes();return list(struct.unpack(f'<{len(raw)//struct.calcsize(kind)}{kind}',raw))
+    path.write_bytes(struct.pack(f'<{len(values)}{kind}',*values))
+
+
+def compile_scene():
+    revision = subprocess.check_output(['git','rev-parse',BASE],cwd=ROOT,text=True).strip()
+    subprocess.run(['git','merge-base','--is-ancestor',revision,'HEAD'],cwd=ROOT,check=True)
+    before = Files(ROOT,revision)
+    layouts = {v['id']:v for v in before.json('data/layouts/layouts.json')['layouts'] if 'id' in v}
+    scenes={}
+    for name in ('TaichungOldCity','TaichungGreenway','TaichungXitun'):
+        data=before.json(f'data/maps/{name}/map.json');layout=layouts[data['layout']]
+        scenes[data['id']]=dict(data=data,layout=layout,grid=before.words(layout['blockdata_filepath']))
+    own=scenes[MID];width,height=own['layout']['width'],own['layout']['height']
+    original=own['grid'];ground=original.copy()
+    allowed_maps={digest(before.read(own['layout']['blockdata_filepath']))}
+    if (DATA/'manifest.json').exists():
+        allowed_maps.add(json.loads((DATA/'manifest.json').read_text())['mapSha256'])
+    assert digest(MAP.read_bytes()) in allowed_maps, 'Registered Greenway has unrelated changes; review a fresh baseline'
+    for spec in SPECS:
+        if not spec.get('retired'):continue
+        x0,y0,x1,y1=spec['retired']
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):ground[y*width+x]=0x3175
+    needed={v&1023 for v in ground+before.words(own['layout']['border_filepath'])}
+    donated=set()
+    for mid,scene in scenes.items():
+        for c in scene['data']['connections']:
+            target=scenes[c['map']]
+            cells=list(visible_cells(scene['layout'],target['layout'],c['direction'],c['offset']))
+            if mid==MID:
+                needed.update(target['grid'][y*target['layout']['width']+x]&1023 for x,y in cells)
+            if c['map']==MID:
+                donated.update(cells)
+    baseline=Bank(before,PRIMARY,CORE)
+    # These used definitions are already repacked entirely into resident primary
+    # graphics, including Old City's borrowed roof-color definitions.
+    used={n for n in needed if n>=640}
+    assert all((v&1023)<640 for n in needed for v in baseline.entries(n)), 'New baseline needs a secondary-graphics remap'
+    count=max(used)-640+1
+    defs=[[0]*8 for _ in range(count)];attrs=[0]*count
+    for n in used:defs[n-640]=baseline.entries(n);attrs[n-640]=baseline.attr(n)
+    free=iter(n for n in range(719,1024) if n not in needed)
+    primary=baseline.images[0]
+    def graphic(image,n):
+        return tuple(image.getpixel((n%16*8+x,n//16*8+y)) for y in range(8) for x in range(8))
+    lookup={}
+    for n in range(640):
+        if n not in ANIMATED:
+            p,f=canonical(graphic(primary,n));lookup.setdefault(p,(n,f))
+    secondary=[]
+    def pack(pixels):
+        p,f=canonical(pixels)
+        if p not in lookup:
+            assert len(secondary)<376, 'Greenway secondary graphic capacity exceeded'
+            lookup[p]=(640+len(secondary),0);secondary.append(p)
+        n,stored=lookup[p]
+        return n|(f^stored)
