+#!/usr/bin/env python3
+"""Draw and encode the Wanhe and Wenchang temple facades for the Nantun bank.
+
+Procedural pixel art in the accepted landmark family (south-facing facade,
+north-up camera, flat shading, one 15-colour palette in secondary slot 7).
+encode() packs the facades into 8x8 graphics with flip de-duplication and
+2x2 metatiles; cells with transparent sky get General grass underneath.
+
+  python3 tools/taichung/nantun/temple_art.py --preview /tmp/temples.png
+"""
+import argparse
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+PALETTE = [
+    (0, 0, 0),         # 0 transparent
+    (32, 24, 24),      # 1 outline
+    (40, 88, 72),      # 2 roof dark green
+    (72, 136, 104),    # 3 roof green
+    (120, 184, 144),   # 4 roof light green
+    (216, 96, 40),     # 5 ridge orange
+    (240, 192, 64),    # 6 gold
+    (152, 32, 32),     # 7 red dark
+    (216, 56, 48),     # 8 red bright
+    (240, 224, 184),   # 9 cream
+    (200, 176, 136),   # 10 cream shade
+    (96, 96, 104),     # 11 stone dark
+    (168, 168, 176),   # 12 stone light
+    (56, 48, 64),      # 13 lattice dark
+    (112, 64, 40),     # 14 timber brown
+    (248, 248, 240),   # 15 white
+]
+T, OUT, RD, RG, RL, OR, GD, RED, REDB, CR, CRS, STD, STL, LAT, TIM, WH = range(16)
+
+GRASS_BOTTOM = [0x026E, 0x026F, 0x024C, 0x024D]  # General metatile 0x001, palette 0
+
+
+class Canvas:
+    def __init__(self, width, height):
+        self.image = Image.new('P', (width, height), T)
+        flat = [v for c in PALETTE for v in c] + [0] * (768 - 48)
+        self.image.putpalette(flat)
+        self.px = self.image.load()
+        self.w, self.h = width, height
+
+    def put(self, x, y, c):
+        if 0 <= x < self.w and 0 <= y < self.h:
+            self.px[x, y] = c
+
+    def rect(self, x0, y0, x1, y1, c):
+        for y in range(y0, y1 + 1):
+            for x in range(x0, x1 + 1):
+                self.put(x, y, c)
+
+    def hline(self, x0, x1, y, c):
+        self.rect(x0, y, x1, y, c)
+
+    def vline(self, x, y0, y1, c):
+        self.rect(x, y0, x, y1, c)
+
+
+def roof(cv, x_ridge0, x_ridge1, y_ridge, x_eave0, x_eave1, y_eave, tip=6):
+    """Hip-roof slope between a ridge and a wider eave, with swallowtail ends."""
+    for y in range(y_ridge, y_eave + 1):
+        t = (y - y_ridge) / max(1, y_eave - y_ridge)
+        x0 = round(x_ridge0 + (x_eave0 - x_ridge0) * t)
+        x1 = round(x_ridge1 + (x_eave1 - x_ridge1) * t)
+        row = y - y_ridge
+        base = RL if row < 3 else RG
+        cv.hline(x0, x1, y, base)
+        if row % 4 == 3:
+            cv.hline(x0, x1, y, RD)          # tile course line
+        elif row % 4 == 0 and row:
+            cv.hline(x0, x1, y, RL if row < 8 else RG)
+        cv.put(x0, y, OUT)
+        cv.put(x1, y, OUT)
+        cv.put(x0 + 1, y, RD)
+        cv.put(x1 - 1, y, RD)
+        if row % 4 == 1:
+            for x in range(x0 + 4 + (row // 4 % 2) * 4, x1 - 2, 8):
+                cv.put(x, y, RD)              # tile ends
+    # Eave edge: dark course, then the curved swallowtail lift at both ends.
+    cv.hline(x_eave0, x_eave1, y_eave, OUT)
+    cv.hline(x_eave0 + 1, x_eave1 - 1, y_eave - 1, RD)
+    for i in range(tip):
+        cv.put(x_eave0 - i, y_eave - 1 - i, OUT)
+        cv.put(x_eave0 - i + 1, y_eave - 1 - i, OR)
+        cv.put(x_eave0 - i + 2, y_eave - 2 - i, RG)
+        cv.put(x_eave1 + i, y_eave - 1 - i, OUT)
+        cv.put(x_eave1 + i - 1, y_eave - 1 - i, OR)
+        cv.put(x_eave1 + i - 2, y_eave - 2 - i, RG)
+    # Ridge: orange body, gold top, swallowtail tips, central pearl ornament.
+    cv.hline(x_ridge0, x_ridge1, y_ridge, OR)
+    cv.hline(x_ridge0, x_ridge1, y_ridge - 1, GD)
+    cv.hline(x_ridge0 - 1, x_ridge1 + 1, y_ridge + 1, OUT)
+    for i in range(tip):
+        for dx, c in ((0, OUT), (1, OR), (2, GD)):
+            cv.put(x_ridge0 - i + dx - 2, y_ridge - 1 - i, c)
+            cv.put(x_ridge1 + i - dx + 2, y_ridge - 1 - i, c)
+    cx = (x_ridge0 + x_ridge1) // 2
+    for dx in (-1, 0, 1):
+        cv.put(cx + dx, y_ridge - 2, GD)
+        cv.put(cx + dx, y_ridge - 3, OR)
+    cv.put(cx, y_ridge - 4, GD)
+    for dx in (-7, 7):                       # ridge dragons as small curls
+        cv.put(cx + dx, y_ridge - 2, OR)
+        cv.put(cx + dx, y_ridge - 3, GD)
+        cv.put(cx + dx + (1 if dx > 0 else -1), y_ridge - 4, OR)
+
+
+def lantern(cv, x, y):
+    cv.rect(x, y, x + 1, y + 1, GD)
+    cv.rect(x - 2, y + 2, x + 3, y + 7, REDB)
+    cv.rect(x - 1, y + 2, x + 2, y + 2, RED)
+    cv.vline(x - 2, y + 3, y + 6, RED)
+    cv.vline(x + 3, y + 3, y + 6, RED)
+    cv.vline(x, y + 3, y + 6, GD)
+    cv.rect(x, y + 8, x + 1, y + 9, GD)
+
+
+def column(cv, x, y0, y1):
+    cv.rect(x, y0, x + 5, y1, RED)
+    cv.vline(x + 1, y0, y1, REDB)
+    cv.vline(x + 5, y0, y1, OUT)
+    cv.rect(x - 1, y1 - 3, x + 6, y1, STL)
+    cv.hline(x - 1, x + 6, y1, STD)
+
+
+def lattice(cv, x0, y0, x1, y1):
+    cv.rect(x0, y0, x1, y1, LAT)
+    for y in range(y0 + 1, y1, 2):
+        for x in range(x0 + 1, x1, 2):
+            cv.put(x, y, WH if (x + y) % 4 == 0 else STL)
+    cv.rect(x0 - 1, y0 - 1, x1 + 1, y0 - 1, TIM)
+    cv.rect(x0 - 1, y1 + 1, x1 + 1, y1 + 1, TIM)
+    cv.vline(x0 - 1, y0 - 1, y1 + 1, TIM)
+    cv.vline(x1 + 1, y0 - 1, y1 + 1, TIM)
+
+
+def lion(cv, x, y):
+    cv.rect(x, y + 3, x + 6, y + 9, STL)
+    cv.rect(x + 1, y, x + 5, y + 4, STL)
+    cv.rect(x, y + 10, x + 6, y + 11, STD)
+    cv.put(x + 2, y + 2, OUT)
+    cv.put(x + 4, y + 2, OUT)
+    cv.hline(x + 2, x + 4, y + 4, STD)
+    cv.vline(x, y + 3, y + 9, STD)
+    cv.put(x + 1, y, STD)
+    cv.put(x + 5, y, STD)
+
+
+def plaque(cv, x0, x1, y):
+    cv.rect(x0, y, x1, y + 6, GD)
+    cv.rect(x0, y, x1, y, OUT)
+    cv.rect(x0, y + 6, x1, y + 6, OUT)
+    cv.vline(x0, y, y + 6, OUT)
+    cv.vline(x1, y, y + 6, OUT)
+    for x in range(x0 + 3, x1 - 2, 5):
+        cv.rect(x, y + 2, x + 2, y + 4, RED)
+
+
+def facade(width_tiles, height_tiles, tiers, door_col):
+    w, h = width_tiles * 16, height_tiles * 16
+    cv = Canvas(w, h)
+    door_x0 = door_col * 16
+    door_cx = door_x0 + 8
+    wall_top = h - 48          # three rows of wall and base
+    if tiers == 2:
+        # Upper roof: narrower, with its own swallowtail ridge.
+        roof(cv, w // 2 - 46, w // 2 + 45, 7, 10, w - 11, 26, tip=5)
+        # Under-eave band of the upper roof: cream with bracket blocks.
+        cv.rect(12, 27, w - 13, 35, CRS)
+        for x in range(16, w - 16, 8):
+            cv.rect(x, 28, x + 3, 33, RED)
+            cv.rect(x + 1, 29, x + 2, 30, GD)
+        roof(cv, 10, w - 11, 41, 5, w - 6, wall_top - 3, tip=5)
+    else:
+        roof(cv, 12, w - 13, 9, 5, w - 6, wall_top - 3, tip=5)
+    # Rafter band and the red beam with gold studs.
+    cv.rect(0, wall_top - 2, w - 1, wall_top, TIM)
+    cv.hline(0, w - 1, wall_top - 2, OUT)
+    cv.rect(2, wall_top + 1, w - 3, wall_top + 5, RED)
+    cv.hline(2, w - 3, wall_top + 1, REDB)
+    for x in range(6, w - 4, 8):
+        cv.rect(x, wall_top + 2, x + 1, wall_top + 3, GD)
+    # Wall.
+    cv.rect(2, wall_top + 6, w - 3, h - 9, CR)
+    cv.vline(2, wall_top + 6, h - 9, CRS)
+    cv.vline(w - 3, wall_top + 6, h - 9, CRS)
+    cv.vline(1, wall_top - 1, h - 1, OUT)
+    cv.vline(0, wall_top - 1, h - 1, OUT)
+    cv.vline(w - 2, wall_top - 1, h - 1, OUT)
+    cv.vline(w - 1, wall_top - 1, h - 1, OUT)
+    # Base course.
+    cv.rect(2, h - 8, w - 3, h - 1, STL)
+    cv.hline(2, w - 3, h - 8, STD)
+    cv.hline(2, w - 3, h - 1, STD)
+    for x in range(6, w - 3, 12):
+        cv.vline(x, h - 7, h - 2, STD)
+    # Columns: one on each side of the door bay, one at each end.
+    cols = [4, door_x0 - 22, door_x0 + 32, w - 10]
+    for x in cols:
+        column(cv, x, wall_top + 6, h - 8)
+    # Side bay windows.
+    lattice(cv, 14, wall_top + 12, door_x0 - 28, wall_top + 27)
+    lattice(cv, door_x0 + 42, wall_top + 12, w - 15, wall_top + 27)
+    # Door bay: red gate frame around the native animated door cell, plaque above.
+    cv.rect(door_x0 - 5, wall_top + 8, door_x0 + 20, h - 1, RED)
+    cv.rect(door_x0 - 4, wall_top + 9, door_x0 + 19, h - 1, REDB)
+    cv.rect(door_x0 - 2, wall_top + 16, door_x0 + 17, h - 1, RED)
+    cv.rect(door_x0, h - 16, door_x0 + 15, h - 1, TIM)    # replaced by the native door
+    for y in (wall_top + 11, wall_top + 13):
+        for x in range(door_x0 - 3, door_x0 + 19, 4):
+            cv.put(x, y, GD)
+    plaque(cv, door_x0 - 3, door_x0 + 18, wall_top + 7)
+    lion(cv, door_x0 - 16, h - 20)
+    lion(cv, door_x0 + 25, h - 20)
+    # Lanterns under the eave.
+    for x in (door_x0 - 12, door_x0 + 28, 10, w - 11):
+        lantern(cv, x, wall_top - 1)
+    return cv.image
+
+
+def facades():
+    return {
+        'wanhe-temple': dict(image=facade(9, 7, 2, 4), width=9, height=7, door=(4, 6)),
+        'wenchang-temple': dict(image=facade(7, 6, 1, 3), width=7, height=6, door=(3, 5)),
+    }
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7 - y if flags & 0x800 else y) * 8 + (7 - x if flags & 0x400 else x)] for y in range(8) for x in range(8))
+
+
+def encode(compiled, palette_slot=7):
+    """Append the facades to a compiled bank in place; return {id: [[metatile id]]}."""
+    graphics, lookup = compiled['graphics'], {}
+    for i, g in enumerate(graphics):
+        lookup.setdefault(min((flip(g, f), f) for f in (0, 0x400, 0x800, 0xC00))[0], i)
+
+    def pack(pixels):
+        canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+        if canonical not in lookup:
+            lookup[canonical] = len(graphics)
+            graphics.append(canonical)
+        return 640 + lookup[canonical] | flags
+
+    scenes = {}
+    for name, spec in facades().items():
+        image = spec['image']
+        px = image.load()
+        rows = []
+        for ty in range(spec['height']):
+            row = []
+            for tx in range(spec['width']):
+                if (tx, ty) == spec['door']:
+                    row.append(None)      # native animated door cell
+                    continue
+                quads, transparent = [], False
+                for qy in range(2):
+                    for qx in range(2):
+                        pixels = tuple(px[tx * 16 + qx * 8 + x, ty * 16 + qy * 8 + y] for y in range(8) for x in range(8))
+                        transparent |= 0 in pixels
+                        quads.append(pixels)
+                if transparent:
+                    entries = list(GRASS_BOTTOM) + [pack(q) | (palette_slot << 12) for q in quads]
+                else:
+                    entries = [pack(q) | (palette_slot << 12) for q in quads] + [0, 0, 0, 0]
+                compiled['metatiles'].append(entries)
+                compiled['attributes'].append(0)
+                row.append(640 + len(compiled['metatiles']) - 1)
+            rows.append(row)
+        scenes[name] = rows
+    compiled['palettes'][palette_slot] = list(PALETTE)
+    return scenes
+
+
+def preview(path):
+    specs = facades()
+    scale = 4
+    width = sum(s['image'].width for s in specs.values()) * scale + 48
+    height = max(s['image'].height for s in specs.values()) * scale + 32
+    board = Image.new('RGB', (width, height), (110, 190, 140))
+    x = 16
+    for s in specs.values():
+        rgb = s['image'].convert('RGBA')
+        data = rgb.getdata()
+        rgb.putdata([(r, g, b, 0 if (r, g, b) == (0, 0, 0) and s['image'].getpixel((i % s['image'].width, i // s['image'].width)) == 0 else 255) for i, (r, g, b, a) in enumerate(data)])
+        big = rgb.resize((rgb.width * scale, rgb.height * scale), Image.NEAREST)
+        board.paste(big, (x, 16), big)
+        x += big.width + 16
+    board.save(path)
+    return path
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--preview', type=Path, required=True)
+    args = parser.parse_args()
+    print(preview(args.preview))
+    for name, s in facades().items():
+        tiles = set()
+        px = s['image'].load()
+        for ty in range(s['image'].height // 8):
+            for tx in range(s['image'].width // 8):
+                p = tuple(px[tx * 8 + x, ty * 8 + y] for y in range(8) for x in range(8))
+                tiles.add(min(flip(p, f) for f in (0, 0x400, 0x800, 0xC00)))
+        print(name, s['image'].size, 'unique 8x8 graphics after flips:', len(tiles))
