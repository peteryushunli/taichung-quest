+            assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+        }
+        count = newly = 0;
+        for (i = 0; i < COUNT(sGreenwayV5SafeRuns); i++)
+            for (x = sGreenwayV5SafeRuns[i][1]; x <= sGreenwayV5SafeRuns[i][2]; x++)
+            {
