+                world = tuple(position['world']); require(world not in seen, 'Exterior projections overlap')
+                seen[world] = (key, x, y)
+                require(inverse_world(contract, *world) == dict(nativeKey=key, local=[x, y]), 'Exterior projection roundtrip differs'); count += 1
+        for bad in ((-1, 0), (entry['width'], 0), (0, entry['height']), (0.5, 1)):
+            require(project_position(contract, key, *bad) is None, 'Invalid local coordinates are not hidden')
+    require(project_position(contract, '255:255', 0, 0) is None, 'Unknown native map is not hidden')
+    require(inverse_world(contract, 0, 119) is None, 'Blank world canvas is treated as a playable map')
+    markers = contract['markersById']; gym_keys = set(); marker_points = set()
+    for identity, marker in markers.items():
+        require(identity == marker['id'] == marker['gymId'] and marker['name']['en'] and marker['name']['zh'], 'Marker ID/name contract incomplete')
+        require(marker['gymNativeKey'] not in gym_keys and tuple(marker['world']) not in marker_points, 'Gym markers are not bijective')
+        gym_keys.add(marker['gymNativeKey']); marker_points.add(tuple(marker['world']))
+        require(inverse_world(contract, *marker['world']) == dict(nativeKey=marker['exteriorNativeKey'], local=marker['localEntrance']), 'Marker entrance roundtrip differs')
+        room = maps[marker['gymNativeKey']]
+        for local in ((0, 0), (room['width'] - 1, room['height'] - 1)):
+            position = project_position(contract, marker['gymNativeKey'], *local)
+            require(position['indoor'] and position['world'] == marker['world'], 'Indoor room XY leaks into world projection')
+    require(len(markers) == len(gym_keys) == 10, 'Current baseline requires ten landmark/gym markers')
+    for key, room in maps.items():
