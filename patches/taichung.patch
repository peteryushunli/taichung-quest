+#!/usr/bin/env python3
+"""Still, flat water for every Taichung map.
+
+General's water animation cycles wave and current frames through tile slots
+0x1A0-0x1CF of the three private primaries, while the flat water metatile 0x1A9
+(tile 0x157, palette 3) never moves and is a lighter blue. Maps that use both
+show waves next to flat patches, and the cycling reads as jitter.
+
+This layer makes all of it one still colour:
+  * all eight frames of General's water animation become one frame: frame 0
+    with every water colour (palette 4 indices 5, 6, 7 and 12) of the plain
+    water tiles (0x1A0-0x1A3 calm, 0x1AE-0x1C1 current) set to index 4, and
+  * in the three private primaries, every definition quadrant that fills with
+    the flat water tile 0x157 (palette 3) draws the matching quadrant of the calm
+    water field instead (0x1A0-0x1A3, palette 4, as 0x0B7 does), so the flat
+    water metatile 0x1A9 and General's pond-rim pieces (0x1A0-0x1B4,
+    0x222-0x226) show that same colour.
+
+Animation code, tile sheets, palettes, attributes and every map stay as they
+are. This guard proves the tree holds exactly that delta over BASE; frozen
+guards read the bytes underneath it (`underneath`).
+
+  still_water.py             print the report
+  still_water.py --install   write the layer into the tree (from BASE)
+  still_water.py --self-test also prove each corruption probe is caught
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import io
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+BASE = "15338eaceaaf5566830e6472ad5bc1bea0b3ca58"
+FRAMES = tuple(f"data/tilesets/primary/general/anim/water_current_landwatersedge/{i}.png" for i in range(8))
+PRIMARIES = tuple(f"data/tilesets/primary/{name}/metatiles.bin"
+                  for name in ("taichung_old_core", "taichung_greenway_private", "taichung_xitun_private"))
+CALM = 0x0B7
+CALM_WORDS = (0x41A0, 0x41A1, 0x41A2, 0x41A3, 0, 0, 0, 0)
+FLAT_TILE, FLAT_ENTRY = 0x157, 0x3157  # tile 0x157, palette 3, no flips
+FLAT_USERS = (*range(0x1A0, 0x1B5), *range(0x222, 0x227))
+WATER_COLOURS, STILL_COLOUR = {5, 6, 7, 12}, 4
+# Frame-local tiles (frame tile n draws slot 0x1A0 + n): calm 0-3, current 14-33.
+WATER_TILES = tuple(range(0, 4)) + tuple(range(14, 34))
+
+
+def git_show(source, path, revision=BASE):
+    return subprocess.run(["git", "show", f"{revision}:{path}"], cwd=source, check=True, capture_output=True).stdout
+
+
+def pixels(data):
+    image = Image.open(io.BytesIO(data))
+    if image.mode != "P":
+        raise ValueError(f"frame is {image.mode}, not an indexed PNG")
+    return image.mode, image.size, image.getpalette(), list(image.tobytes())
+
+
+def still_pixels(frame0):
+    """Frame 0's pixel indices with the plain water tiles flattened."""
+    mode, (width, height), palette, values = pixels(frame0)
+    values = values[:]
+    for tile in WATER_TILES:
+        tx, ty = tile % (width // 8), tile // (width // 8)
+        for y in range(8):
+            for x in range(8):
+                i = (ty * 8 + y) * width + tx * 8 + x
+                if values[i] in WATER_COLOURS:
+                    values[i] = STILL_COLOUR
+    return mode, (width, height), palette, values
+
+
+def flat_metatiles(data):
+    """The primary's definitions with every 0x157 fill quadrant on the calm field;
+    None unless BASE draws 0x157 exactly as this layer expects (bottom-layer,
+    palette 3, unflipped, only in General's pond family) and 0x0B7 is the field."""
+    words = list(struct.unpack(f"<{len(data) // 2}H", data))
+    if tuple(words[CALM * 8:CALM * 8 + 8]) != CALM_WORDS:
+        return None
+    users = set()
+    for index, word in enumerate(words):
+        if word & 0x3FF != FLAT_TILE:
+            continue
+        metatile, quadrant = divmod(index, 8)
+        if word != FLAT_ENTRY or quadrant > 3:
+            return None
+        users.add(metatile)
+        words[index] = CALM_WORDS[quadrant]
+    if tuple(sorted(users)) != FLAT_USERS:
+        return None
+    return struct.pack(f"<{len(words)}H", *words)
+
+
+def install(source=ROOT):
+    source = Path(source).resolve()
+    frame0 = git_show(source, FRAMES[0])
+    mode, size, palette, values = still_pixels(frame0)
+    image = Image.new(mode, size)
+    image.putpalette(palette)
+    image.putdata(values)
+    for path in FRAMES:
+        image.save(source / path)
+    for path in PRIMARIES:
+        out = flat_metatiles(git_show(source, path))
+        if out is None:
+            raise SystemExit(f"{path}: 0x157 fills or 0x0B7 at BASE are not the expected words")
+        (source / path).write_bytes(out)
+
+
+def same(a, b, path):
+    """Byte equality; JASC palettes are checked out with CRLF, stored with LF."""
+    return a.replace(b"\r\n", b"\n") == b.replace(b"\r\n", b"\n") if path.endswith(".pal") else a == b
+
+
+def _reader(source, overrides):
+    overrides = overrides or {}
+    return lambda path: overrides[path] if path in overrides else (Path(source) / path).read_bytes()
+
+
+def check(source=ROOT, overrides=None, reader=None):
+    source = Path(source).resolve()
+    base_read = reader or _reader(source, None)
+    overrides = overrides or {}
+    read = lambda path: overrides[path] if path in overrides else base_read(path)
+    errors, results = [], {}
+
+    def require(ok, message):
+        if not ok:
+            errors.append(message)
+
+    frame0 = git_show(source, FRAMES[0])
+    want = still_pixels(frame0)
+    base_values = pixels(frame0)[3]
+    flattened = sum(1 for a, b in zip(base_values, want[3]) if a != b)
+    for path in FRAMES:
+        try:
+            got = pixels(read(path))
+        except Exception as error:  # unreadable or missing PNG
+            require(False, f"{path}: {error}")
+            continue
+        require(got[:3] == want[:3], f"{path}: frame mode, size or PNG palette changed")
+        require(got[3] == want[3], f"{path}: frame is not the still frame")
+    for path in PRIMARIES:
+        base = git_show(source, path)
+        require(flat_metatiles(base) is not None, f"{path}: BASE does not hold the expected 0x157 fills and 0x0B7")
+        require(read(path) == flat_metatiles(base), f"{path}: definitions are not BASE with the 0x157 fills on the calm field")
+    # Nothing else of this layer's shape may move: the animation writes and the
+    # remaining primary files stay BASE's bytes.
+    for path in ("src/tileset_anims.c", "src/data/tilesets/headers.h"):
+        require(read(path) == git_show(source, path), f"{path} changed")
+    for path in PRIMARIES:
+        folder = path.rsplit("/", 1)[0]
+        for name in ("tiles.png", "metatile_attributes.bin", *(f"palettes/{p:02}.pal" for p in range(16))):
+            path = f"{folder}/{name}"
+            require(same(read(path), git_show(source, path), path), f"{path} changed")
+    results["frames"] = {"count": len(FRAMES), "pixelsFlattened": flattened, "waterTiles": len(WATER_TILES),
+                         "stillColour": "palette 4 index 4 (#68A0E0)"}
+    results["flatFills"] = {"tile": "0x157 palette 3", "metatiles": len(FLAT_USERS), "draws": "0x1A0-0x1A3 palette 4 (as 0x0B7)",
+                            "primaries": len(PRIMARIES)}
+    return {"passed": not errors, "errors": errors, "base": BASE, "checks": results}
+
+
+def holds_layer(source, read):
+    """True when the layer's own files are exactly this layer's output from BASE.
+    Only those files are read, so a guard may call this after peeling other
+    layers' shared files (headers, scripts) to older revisions."""
+    want = still_pixels(git_show(source, FRAMES[0]))
+    for path in FRAMES:
+        if pixels(read(path)) != want:
+            return False
+    return all(read(path) == flat_metatiles(git_show(source, path)) for path in PRIMARIES)
+
+
+def underneath(files):
+    """{path: BASE bytes} for the layer's files when the tree holds exactly this
+    layer over BASE; otherwise {}, so a guard reads the real bytes."""
+    source = Path(files.source)
+    try:
+        if not holds_layer(source, files.read):
+            return {}
+    except (OSError, ValueError, subprocess.CalledProcessError):
+        return {}
+    return {path: git_show(source, path) for path in FRAMES + PRIMARIES}
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve()
+    good = check(source)
+    probes = {}
+    frame = Image.open(source / FRAMES[3]).copy()
+    frame.putpixel((0, 0), 5)
+    buf = io.BytesIO(); frame.save(buf, format="PNG")
+    probes["wave-pixel"] = {FRAMES[3]: buf.getvalue()}
+    first = git_show(source, FRAMES[1])
+    probes["animated-frame"] = {FRAMES[1]: first}
+    base = git_show(source, PRIMARIES[1])
+    probes["flat-left-alone"] = {PRIMARIES[1]: base}
+    edited = bytearray(flat_metatiles(base))
+    edited[0xB8 * 16] ^= 1
+    probes["other-definition"] = {PRIMARIES[1]: bytes(edited)}
+    partial = bytearray(flat_metatiles(base))
+    partial[0x1A1 * 16:0x1A1 * 16 + 16] = base[0x1A1 * 16:0x1A1 * 16 + 16]
+    probes["rim-left-light"] = {PRIMARIES[0]: bytes(partial)}
+    caught = {name: not check(source, overrides)["passed"] for name, overrides in probes.items()}
+    return {"passed": good["passed"] and all(caught.values()), "tree": good["passed"], "rejectedCorruptionProbes": caught}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--install", action="store_true")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if args.install:
+        install()
+    report = self_test() if args.self_test else check()
+    print(json.dumps(report, indent=2))
+    sys.exit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
