+        open_cells = {(x, y) for y in range(height) for x in range(width) if walkable(x, y)}
+        tests.require(open_cells <= seen, f"Open cells unreachable from Fengjia: {sorted(open_cells - seen)[:6]}")
+        grass = {(x, y) for y in range(height) for x in range(width)
+                 if bank.attr(cell(x, y) & 0x3FF) & 0x1FF == TALL_GRASS and (bank.attr(cell(x, y) & 0x3FF) >> 24) & 7 == LAND}
+        habitats = {(x, y) for h in now.json(install.CONTRACT)["habitatRegions"] if h["map"] == install.MID
+                    for x0, y0, x1, y1 in [h["rect"]] for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)}
+        tests.require(grass and grass == habitats, "Xitun's tall grass is not exactly its contract habitats")
+        # The Maple Garden's registered collision moves with the map.
+        maple = {(r["x"] + dx, r["y"] + dy) for r in now.json(COLLISION_DELTA)["newlySolidPositions"] if r["mapId"] == install.MID}
+        tests.require(len(maple) == 44 and all(cell(x, y) & SOLID_BITS for x, y in maple), "The Maple Garden's registered collision is open")
+        points = next(l for l in now.json(install.CONTRACT)["landmarks"] if l["id"] == "maple-garden")
+        door, approach, arrival = ((points[k]["x"], points[k]["y"]) for k in ("entrance", "approach", "arrival"))
