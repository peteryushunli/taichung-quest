diff --git a/tools/taichung/boulevard_city/north_xitun.py b/tools/taichung/boulevard_city/north_xitun.py
new file mode 100644
index 00000000..c2e46de8
--- /dev/null
+++ b/tools/taichung/boulevard_city/north_xitun.py
@@ -0,0 +1,100 @@
+"""Compile the approved North Xitun infill draft without moving its streets.
+
+Placement authorship: Executive Decisions' November 23 draft and additions,
+retained verbatim under docs/north-xitun/source. Coordinates are world metatiles.
+"""
+import json
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+HERE = Path(__file__).resolve().parent
+PLAN = HERE / "north-xitun.json"
+
+
+def sand_play_image():
+    """The exact 3x4-metatile sand/play detail painted in the approved draft."""
+    image = Image.new("RGBA", (48, 64), "#9b8661")
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((2, 2, 45, 61), fill="#dbc48c")
+    draw.rectangle((3, 3, 44, 5), fill="#eddaab")
+    # The draft's flecks were anchored in its overview crop's pixel coordinates.
+    top = (75 - 60) * 16
+    for y in range(10, 61, 7):
+        for x in range(5 + ((top + y) % 3), 43, 9):
+            draw.rectangle((x, y, x + 1, y), fill="#c7ac7f")
+    draw.rectangle((10, 12, 20, 14), fill="#935f48")
+    draw.rectangle((12, 12, 13, 21), fill="#795948")
+    draw.rectangle((18, 12, 19, 21), fill="#795948")
+    draw.rectangle((13, 19, 18, 20), fill="#d4a05e")
+    return image
+
+
+def install(world, fill, fill_dir, approved_art):
+    plan = json.loads(PLAN.read_text())
+    kit = json.loads((fill_dir / "kit/kit.json").read_text())["sprites"]
+    sand_path = approved_art / "huimin-sand-play.png"
+    sand_play_image().save(sand_path)
+    rectangles = [site["block"] for site in plan["sites"]]
+
+    def contained(rect, x, y, width, height):
+        return rect[0] <= x and rect[1] <= y and x + width <= rect[2] and y + height <= rect[3]
+
+    def intersects(rect, x, y, width, height):
+        return x < rect[2] and y < rect[3] and x + width > rect[0] and y + height > rect[1]
+
+    removed = []
+    for collection, dims in ((world.objects, lambda item: (item["w"], item["h"])),
+                             (fill["placements"], lambda item: item["tiles"])):
+        keep = []
+        for item in collection:
+            width, height = dims(item)
+            matching = [r for r in rectangles if intersects(r, item["x"], item["y"], width, height)]
+            if matching:
+                assert len(matching) == 1 and contained(matching[0], item["x"], item["y"], width, height), item
+                if collection is world.objects:
+                    removed.append(dict(sprite=item["sprite"], x=item["x"], y=item["y"]))
+            else:
+                keep.append(item)
+        collection[:] = keep
+
+    placements = []
+    for site in plan["sites"]:
+        rect = site["block"]
+        # Native ground roles: p is paving; o is walkable park lawn, no wild battle.
+        world.put(rect, site["ground"])
+        for ground in site.get("groundRects", []):
+            assert contained(rect, *ground["rect"][:2],
+                             ground["rect"][2] - ground["rect"][0], ground["rect"][3] - ground["rect"][1])
+            world.put(ground["rect"], ground["ground"])
+        for name, x, y, kind in site["placements"]:
+            path = approved_art / (name + ".png")
+            if not path.is_file():
+                path = fill_dir / "kit/sprites" / (name + ".png")
+            image = Image.open(path).convert("RGBA")
+            width, height = image.width // 16, image.height // 16
+            assert contained(rect, x, y, width, height), (site["id"], name, x, y, width, height)
+            item = dict(sprite=name, x=x, y=y, w=width, h=height, kind=kind)
+            if name == "huimin-sand-play":
+                # Only the little wooden play fixture blocks; sand is walkable.
+                item["solid"] = [(x, y + 1), (x + 1, y + 1)]
+            elif kind == "prop" and "solid" in kit[name]:
+                # Retain the asset library's tested cart/bench/base footprints.
+                item["solid"] = [(x + i, y + j) for i, j in kit[name]["solid"]]
+            elif kind == "plant":
+                if name in ("meadow-tuft", "fern-stone", "flower-shrub"):
+                    item["solid"] = []
+                else:
+                    # Trunks block their base, with canopies drawn over the player.
+                    item["solid"] = [(x + (1 if width == 4 else 0), y + height - 1)]
+            world.objects.append(item)
+            exported = dict(sprite=name, x=x, y=y, tiles=[width, height], kind=kind,
+                            mirrored=False, neighborhood=site["id"])
+            if "solid" in item:
+                exported["solidTiles"] = item["solid"]
+            fill["placements"].append(exported)
+            placements.append(exported)
+    # The builder derives collision afresh, but keep the authoring cache coherent.
+    world._solid = set().union(*(world.solid_cells(item) for item in world.objects))
+    fill["northXitun"] = dict(sites=plan["sites"], placements=placements, removed=removed)
+    return fill["northXitun"]
diff --git a/tools/taichung/boulevard_city/north_xitun_continue.py b/tools/taichung/boulevard_city/north_xitun_continue.py
new file mode 100644
index 00000000..ebeadc4c
--- /dev/null
+++ b/tools/taichung/boulevard_city/north_xitun_continue.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Derive/check exact Continue repairs from immutable pre-infill and current native cells."""
+import argparse
+from collections import deque
+from hashlib import sha256
+import json
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[3]
+DATA = ROOT / 'data/taichung/north-xitun-continue'
+HEADER = ROOT / 'src/data/taichung/north_xitun_continue.h'
+STEPS = ((0,1),(-1,0),(1,0),(0,-1))
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def derive():
+    source=read(DATA/'baseline.json')
+    layouts={r['id']:r for r in read(ROOT/'data/layouts/layouts.json')['layouts'] if r}
+    groups=read(ROOT/'data/maps/map_groups.json')
+    maps=[]
+    for row in source['maps']:
+        old=(DATA/row['baselineFile']).read_bytes()
+        assert sha256(old).hexdigest()==row['baselineSha256']
+        record=read(ROOT/'data/maps'/row['name']/'map.json')
+        layout=layouts[record['layout']]
+        w,h=row['width'],row['height']
+        assert record['id']==row['constant'] and record['layout']==row['layout']
+        assert (layout['width'],layout['height'],layout['blockdata_filepath'])==(w,h,row['path'])
+        new=(ROOT/row['path']).read_bytes()
+        assert len(old)==len(new)==w*h*2
+        words=lambda data:struct.unpack(f'<{w*h}H',data)
+        before,after=words(old),words(new)
+        open_cells=lambda data:{(x,y) for y in range(h) for x in range(w) if not data[y*w+x]&0x400}
+        was,now=open_cells(before),open_cells(after)
+        forbidden={(e['x'],e['y']) for kind in ('object_events','warp_events','bg_events') for e in record[kind]}
+        safe=(was&now)-forbidden
+        # A repaired arrival must allow a subsequent step without entering a warp/NPC.
+        safe={p for p in safe if any((p[0]+dx,p[1]+dy) in now-forbidden for dx,dy in STEPS)}
+        repairs=[]
+        for start in sorted(was-now,key=lambda p:(p[1],p[0])):
+            pending=deque([(start,0)]);seen={start};found=None
+            while pending:
+                point,distance=pending.popleft()
+                if point in safe:
+                    found=point;break
+                for dx,dy in STEPS:
+                    to=point[0]+dx,point[1]+dy
+                    if to in was and to not in seen:
+                        seen.add(to);pending.append((to,distance+1))
+            assert found is not None,(row['name'],start)
+            assert after[found[1]*w+found[0]]>>12==3
+            repairs.append([*start,*found])
+        number=groups['gMapGroup_Taichung'].index(row['name'])
+        maps.append(dict(name=row['name'],constant=row['constant'],nativeKey=f'43:{number}',
+                         width=w,height=h,beforeSha256=sha256(old).hexdigest(),
+                         afterSha256=sha256(new).hexdigest(),repairs=repairs))
+    assert [len(m['repairs']) for m in maps]==[37,33,25,1], 'Repair scope differs from the reviewed 95 cells plus one hotel post'
+    assert maps[3]['nativeKey']=='43:29' and maps[3]['repairs']==[[14,13,14,14]], 'Hotel post repair moved'
+    preserved=read(DATA/'preserved-70-repairs.json')
+    assert len(preserved['maps'])==2
+    for old,current in zip(preserved['maps'],maps[:2]):
+        assert old['nativeKey']==current['nativeKey'] and old['repairs']==current['repairs'], 'An earlier repair target changed'
+    result=dict(schemaVersion=1,saveVersion=12,baselineNativeCommit=source['baselineNativeCommit'],
+                sourceRule='Previously walkable native cell now blocked; same-map nearest stable open cell by BFS on old walkable ground, south/west/east/north tie order; exclude NPCs, warps and signs',
+                maps=maps)
+    header=['// Generated by tools/taichung/boulevard_city/north_xitun_continue.py. Do not edit.',
+            '// Exact pre-infill open -> current blocked cells only. No save-version bump.']
+    for i,m in enumerate(maps):
+        header+=['',f'static const struct NorthXitunRelocation sNorthXitunRepairs{i}[] =','{']
+        header += ['    {'+', '.join(map(str,r))+'},' for r in m['repairs']]
+        header += ['};']
+    header += ['', 'static const struct NorthXitunRepairMap sNorthXitunRepairMaps[] =', '{']
+    for i,m in enumerate(maps):
+        c=m['constant']
+        header.append(f'    {{MAP_GROUP({c}), MAP_NUM({c}), sNorthXitunRepairs{i}, ARRAY_COUNT(sNorthXitunRepairs{i})}},')
+    header += ['};','']
+    return result,'\n'.join(header)
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--write',action='store_true');args=parser.parse_args()
+    result,header=derive();payload=json.dumps(result,indent=2)+'\n'
+    if args.write:
+        HEADER.write_text(header);(DATA/'repairs.json').write_text(payload)
+    else:
+        assert HEADER.read_text()==header,'C repair table differs from native source derivation'
+        assert (DATA/'repairs.json').read_text()==payload,'Repair record differs from native source derivation'
+    print(json.dumps({'passed':True,'exactRepairs':sum(len(m['repairs']) for m in result['maps']),
+                      'maps':[{k:v for k,v in m.items() if k!='repairs'} for m in result['maps']]},indent=2))
