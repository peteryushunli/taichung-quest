+# The registered city-rework save v10 moves saved positions by each district's shift and
+# repairs closed cells. Its own proofs are tools/taichung/city_rework/save_v10.py (the
+# tables equal the maps) and the host save suites; frozen guards read the live v9 save
+# pair underneath it, and only when the tree holds exactly the reviewed v10 pair.
+SAVE_V10_GUARD = "tools/taichung/city_rework/save_v10.py"
+
+
+# The registered playthrough polish (native 0a24efb on 2c48f28) also edits the shared city script:
+# it routes the gym and temple signs through the landmark history. Guards and builders that own
+# other parts of that file read it with exactly that edit removed. The edit is computed from the
+# polish's own commits, never pinned, and accepted only when it round-trips byte for byte.
+POLISH_SCRIPTS = "data/scripts/taichung_city.inc"
+POLISH_BEFORE = "2c48f28b998b67413baf058557752723ea121500"
+POLISH_AFTER = "0a24efb7cb194e6faed14c363c586410a772bbaf"
+POLISH_MARKER = b'.include "data/scripts/taichung_landmark_history.inc"'
+
+
+def _merge_file(ours, base, theirs):
+    """git merge-file's clean three-way result, or None on a conflict."""
+    import tempfile
+    with tempfile.TemporaryDirectory() as tmp:
+        paths = []
+        for name, data in (("ours", ours), ("base", base), ("theirs", theirs)):
+            path = Path(tmp)/name
+            path.write_bytes(data)
+            paths.append(str(path))
+        result = subprocess.run(["git", "merge-file", "-p", *paths], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+    return result.stdout if result.returncode == 0 else None
+
+
+def _polish_pair(source):
+    return (Files(source, POLISH_BEFORE).read(POLISH_SCRIPTS), Files(source, POLISH_AFTER).read(POLISH_SCRIPTS))
+
+
+def polish_scripts_over(source, data):
+    """data (the city script without the polish) with exactly the polish's edit applied."""
+    before, after = _polish_pair(source)
+    over = _merge_file(data, before, after)
+    if over is None or POLISH_MARKER not in over or _merge_file(over, after, before) != data:
+        raise ValueError("The playthrough polish's city-script edit does not apply cleanly")
+    return over
+
+
+def polish_scripts_underneath(files):
+    """{city script: bytes with exactly the polish's edit removed} when the tree holds it, else {}."""
+    try:
+        current = files.read(POLISH_SCRIPTS)
+    except (OSError, subprocess.CalledProcessError):
+        return {}
+    if POLISH_MARKER not in current:
+        return {}
+    before, after = _polish_pair(files.source)
+    under = _merge_file(current, after, before)
+    if under is None or POLISH_MARKER in under or _merge_file(under, before, after) != current:
+        return {}
+    return {POLISH_SCRIPTS: under}
+
