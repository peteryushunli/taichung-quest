+                "exactNewBlocks": len(positions), "oldMapSha256": COLLISION_OLD_MAP_SHA, "newMapSha256": COLLISION_NEW_MAP_SHA}
+    tests.section("registeredAlphaLayer", proof)
+    return {"active": True, "passed": not tests.errors, "errors": tests.errors, "checks": tests.results,
+            "underlay": {COLLISION_MAP: base.read(COLLISION_MAP)} if not tests.errors else {}, "positions": positions,
+            "gymStaff": staff_proof}
