+++ b/data/scripts/taichung_landmark_history.inc
@@ -0,0 +1,81 @@
+@ Called with VAR_0x8004 = landmark gym ID and the leader interaction locked.
+@ The leader tells the landmark's history as the lead-in to the gym's
+@ challenge question, and still tells it after a win. No award writes.
+TaichungHistory_Tell::
+	callnative TaichungHistory_ScriptHasFacts
+	goto_if_eq VAR_RESULT, FALSE, TaichungHistory_TellDone
+	callnative TaichungHistory_ScriptBufferTour
+	msgbox gStringVar4
+TaichungHistory_TellDone::
+	return
+
+@ Shown under the gym's challenge question. Return0 selects Challenge;
+@ Return1 (Leave) or B leaves.
+TaichungHistory_ChallengeMenu::
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_HISTORY, FALSE
+	return
+
+@ Existing non-gym temples tell their history after the sign line, with no
+@ menu. Never query a gym bit or prepare/cancel a battle for these visits.
+TaichungHistory_VisitMenu::
+	goto TaichungHistory_Tell
+
+@ Optional staff: explicit interaction only, no battle/progress/service writes.
+TaichungHistory_StaffMiyahara::
+	lock
+	faceplayer
+	goto_if_questlog TaichungHistory_StaffMiyaharaDone
+	setvar VAR_0x8004, TAICHUNG_GYM_MIYAHARA
+	callnative TaichungHistory_ScriptBufferStaff
+	msgbox gStringVar4
+TaichungHistory_StaffMiyaharaDone::
+	release
+	end
+
+@ Optional staff: explicit interaction only, no battle/progress/service writes.
+TaichungHistory_StaffPark::
+	lock
+	faceplayer
+	goto_if_questlog TaichungHistory_StaffParkDone
+	setvar VAR_0x8004, TAICHUNG_GYM_PARK
+	callnative TaichungHistory_ScriptBufferStaff
+	msgbox gStringVar4
+TaichungHistory_StaffParkDone::
+	release
+	end
+
+@ Optional staff: explicit interaction only, no battle/progress/service writes.
+TaichungHistory_StaffShenJi::
+	lock
+	faceplayer
+	goto_if_questlog TaichungHistory_StaffShenJiDone
+	setvar VAR_0x8004, TAICHUNG_GYM_SHEN_JI
+	callnative TaichungHistory_ScriptBufferStaff
+	msgbox gStringVar4
+TaichungHistory_StaffShenJiDone::
+	release
+	end
+
+@ Optional staff: explicit interaction only, no battle/progress/service writes.
+TaichungHistory_StaffFineArts::
+	lock
+	faceplayer
+	goto_if_questlog TaichungHistory_StaffFineArtsDone
+	setvar VAR_0x8004, TAICHUNG_GYM_FINE_ARTS
+	callnative TaichungHistory_ScriptBufferStaff
+	msgbox gStringVar4
+TaichungHistory_StaffFineArtsDone::
+	release
+	end
+
+@ Optional staff: explicit interaction only, no battle/progress/service writes.
+TaichungHistory_StaffMapleGarden::
+	lock
+	faceplayer
+	goto_if_questlog TaichungHistory_StaffMapleGardenDone
+	setvar VAR_0x8004, TAICHUNG_GYM_MAPLE_GARDEN
