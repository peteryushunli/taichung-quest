+            pair = ("data/tilesets/primary/" + _folder(now, info["primary_tileset"]),
+                    "data/tilesets/secondary/" + _folder(now, info["secondary_tileset"]))
+            new, old = support.Bank(now, *pair), support.Bank(base, *pair)
+            words = now.words(info["blockdata_filepath"]) + now.words(info["border_filepath"])
+            differ = sorted({w & 0x3FF for w in words if new.render(w & 0x3FF) != old.render(w & 0x3FF)})
+            tests.require(not differ, f"{name} renders differently from BASE: {[hex(m) for m in differ[:8]]}")
+            cells += len(words)
+        return {"exteriors": len(EXTERIORS), "cellsRendered": cells}
+
+    tests.section("contract", contract)
+    tests.section("installer", installer)
+    tests.section("identity", identity)
+    tests.section("kitContent", kit_content)
+    tests.section("preserved", preserved)
+    tests.section("clearOfUse", clear_of_use)
+    tests.section("exteriors", exteriors)
+    tests.require(install.BASE == KIT_BASE and install.CONTRACT == KIT_CONTRACT, "Installer base or contract path moved")
+    return {"passed": not tests.errors, "errors": tests.errors, "checks": tests.results}
+
+
+KIT_BASE = "6366b9e5c037647ce4d2a007efa3d3dfbedcdb48"
+KIT_CONTRACT = "data/taichung/city-kit/kit.json"
+
+
+def underneath(files):
+    """{path: BASE bytes} for the nine primary files when the tree holds exactly
+    the registered kit (under the registered still-water layer, which is
+    stripped first and whose other files are returned as they were before it):
+    kit.json at its pinned hash and every primary file at its registered output
+    hash. Otherwise {}, so a guard reads the real bytes.
+    Guards that freeze a whole primary check this state underneath; this guard
+    proves the kit delta itself."""
+    support = load("city_kit_underneath_support", Path(files.source) / "tools/taichung/landmarks/check_old_core.py")
+    peeled = support.still_water_underneath(files)
+    read = lambda path: peeled[path] if path in peeled else files.read(path)
+    try:
+        raw = read(KIT_CONTRACT)
+    except (OSError, subprocess.CalledProcessError):
+        return {}
+    if hashlib.sha256(raw).hexdigest() != CONTRACT_SHA256:
+        return {}
+    outputs = json.loads(raw)["outputs"]
+    if any(hashlib.sha256(read(path)).hexdigest() != digest for path, digest in outputs.items()):
+        return {}
+    base = {path: subprocess.run(["git", "show", f"{KIT_BASE}:{path}"], cwd=files.source, check=True,
+                                 capture_output=True).stdout for path in outputs}
+    # Underneath the kit is also underneath the later still-water layer: its other
+    # files (General's water frames) read as they were before it.
+    return {**{path: data for path, data in peeled.items() if path not in base}, **base}
+
+
+def _folder(files, label):
+    """Tileset folder for a C label, from its tiles INCBIN path."""
+    import re
+    header = re.search(rf"\b{label}\s*=\s*\{{(.*?)\}};", files.text("src/data/tilesets/headers.h"), re.S).group(1)
+    symbol = re.search(r"\.tiles\s*=\s*(\w+)", header).group(1)
+    path = re.search(rf"\b{symbol}\[\]\s*=\s*INCBIN_U32\(\"([^\"]+)\"\)", files.text("src/data/tilesets/graphics.h")).group(1)
+    return path.split("/")[-2]
+
+
+def self_test(source):
+    source = Path(source).resolve()
+    install = load("city_kit_install", HERE / "install_city_kit.py")
