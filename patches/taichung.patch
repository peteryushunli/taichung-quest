+static void CB2_ReturnFromEncounterMenu(void)
+{
+    // The party chooser writes its selection before returning. Preserve it,
+    // and the encounter site, across field/quest-log initialization.
+    sReplacementSlot = gSpecialVar_0x8004;
+    gFieldCallback = FieldCB_ReturnFromEncounterMenu;
+    CB2_ReturnToField();
+}
+
+static void FieldCB_PersistEncounterResult(void)
+{
+    u8 task;
+    LockPlayerFieldControls();
+    Overworld_PlaySpecialMapMusic();
+    FadeInFromBlack();
+    // The live map is restored now. Persist while its fade runs instead of
+    // waiting for the old script to resume after the fade has completed.
+    task = CreateTask(Task_WaitPersistence, 2);
+    gTasks[task].data[1] = TRUE;
+}
