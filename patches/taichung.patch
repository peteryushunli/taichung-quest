+#!/usr/bin/env python3
+"""Link real save/encounter C and compare complete host saves to frozen baseline."""
+from pathlib import Path
+import json
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+BASE = '8d3694bbeb19f67b3595faef8d8bb3c9c66f9893'
+OUT = ROOT / 'build/taichung-tests/encounter-save'
+OUT.mkdir(parents=True, exist_ok=True)
+# Native map IDs come from the actual registry. This host-only header avoids
+# requiring mapjson/ARM tools or modifying the checkout's generated include tree.
+groups = json.loads((ROOT / 'data/maps/map_groups.json').read_text())
+lines = ['#ifndef GUARD_CONSTANTS_MAP_GROUPS_H', '#define GUARD_CONSTANTS_MAP_GROUPS_H']
+for group, name in enumerate(groups['group_order']):
+    for number, folder in enumerate(groups[name]):
+        data = json.loads((ROOT / f'data/maps/{folder}/map.json').read_text())
+        lines.append(f'#define {data["id"]} ({number} | ({group} << 8))')
+lines.append('#endif')
+header = OUT / 'include/constants/map_groups.h'
+header.parent.mkdir(parents=True, exist_ok=True)
+header.write_text('\n'.join(lines) + '\n')
+raw = subprocess.check_output(['git', 'show', BASE + ':src/taichung_save.c'], cwd=ROOT)
+baseline = OUT / 'baseline-save.c'
+baseline.write_bytes(raw)
+table = 'src/data/taichung/approved_art_save_v11.h'
+assert (ROOT / table).read_bytes() == subprocess.check_output(['git', 'show', BASE + ':' + table], cwd=ROOT)
+symbols = re.findall(r'^(?:void|u8|bool8) (TaichungSave\w+)\(', raw.decode(), re.M)
+assert len(symbols) == 6, symbols
+flags = ['cc', '-std=c99', '-O2', '-Wall', '-Wextra', '-Werror',
+         '-I' + str(ROOT / 'tests/save_host'), '-I' + str(OUT / 'include'), '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'src')]
+obj = OUT / 'baseline-save.o'
+subprocess.run(flags + ['-D' + name + '=Baseline' + name for name in symbols]
+               + ['-c', str(baseline), '-o', str(obj)], check=True)
+binary = OUT / 'encounter-save'
+subprocess.run(flags + [str(ROOT / 'src/taichung_save.c'), str(ROOT / 'src/taichung_encounter.c'),
+                       str(ROOT / 'tests/taichung_encounter_save_test.c'), str(obj), '-o', str(binary)], check=True)
+subprocess.run([str(binary)], check=True)
+print('Host map-ID include for unchanged historical tests:', OUT / 'include')
