+    gMain.vblankCounter2++;
+    UpdateTaichungBikeShortcutInput(&input, fresh, held);
+    return input.pressedBButton;
+}
+
+static void CheckContext(void)
+{
+    bool8 *blocked[] = {&sLock, &sScript, &sLink, &sUnion, &sReplay, &sRoad, &sNativeBlocked, &gMain.inBattle, &gPaletteFade.active, &gPlayerAvatar.preventStep, &gObjectEvents[0].frozen};
+    unsigned i;
+    Reset(); assert(TaichungCanToggleBike());
+    for (i = 0; i < sizeof(blocked)/sizeof(blocked[0]); i++)
+    {
+        *blocked[i] = TRUE; assert(!TaichungCanToggleBike()); *blocked[i] = FALSE;
+    }
+    sCity = FALSE; assert(!TaichungCanToggleBike()); sCity = TRUE;
+    sMainField = FALSE; assert(!TaichungCanToggleBike()); sMainField = TRUE;
+    gMapHeader.mapType = MAP_TYPE_INDOOR; assert(!TaichungCanToggleBike());
+    gMapHeader.mapType = MAP_TYPE_TOWN;
+    gMapHeader.bikingAllowed = FALSE; assert(!TaichungCanToggleBike()); gMapHeader.bikingAllowed = TRUE;
+    gObjectEvents[0].active = FALSE; assert(!TaichungCanToggleBike()); gObjectEvents[0].active = TRUE;
+    gPlayerAvatar.objectEventId = OBJECT_EVENTS_COUNT; assert(!TaichungCanToggleBike()); gPlayerAvatar.objectEventId = 0;
+    sTaskCount = NUM_TASKS; assert(!TaichungCanToggleBike()); sTaskCount = 0;
+    gPlayerAvatar.transitionFlags = 1; assert(!TaichungCanToggleBike()); gPlayerAvatar.transitionFlags = 0;
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_SURFING; assert(!TaichungCanToggleBike());
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_UNDERWATER; assert(!TaichungCanToggleBike());
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_ON_FOOT | PLAYER_AVATAR_FLAG_FORCED; assert(!TaichungCanToggleBike());
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_MACH_BIKE; assert(TaichungCanToggleBike());
+    for (i = 0; i < 5; i++) { sTile = 1 << i; assert(!TaichungCanToggleBike()); }
+    sTile = 0;
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_WALK_NORMAL_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_PLAYER_RUN_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_WALK_FASTER_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_TAICHUNG_BIKE_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_JUMP_2_UP; assert(!TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_SLIDE_UP; assert(!TaichungCanToggleBike());
+}
+
+static void CheckFreshAndHeld(void)
+{
+    unsigned i;
+    Reset();
+    assert(!Tick(B_BUTTON, B_BUTTON)); // No neutral field frame yet.
+    assert(!Tick(0, B_BUTTON));
+    assert(!Tick(0, 0));
+    assert(Tick(B_BUTTON, B_BUTTON));
+    for (i = 0; i < 120; i++) assert(!Tick(0, B_BUTTON));
+    assert(!Tick(0, 0));
+    assert(Tick(B_BUTTON, B_BUTTON));
+}
+
+static void CheckModalReturnAndConflicts(void)
+{
+    static const u16 modalKeys[] = {A_BUTTON, START_BUTTON, SELECT_BUTTON};
+    unsigned i;
+    Reset(); assert(!Tick(0, 0));
+    sLock = TRUE; assert(!Tick(B_BUTTON, B_BUTTON));
+    sLock = FALSE; assert(!Tick(0, B_BUTTON)); assert(!Tick(B_BUTTON, B_BUTTON));
+    assert(!Tick(0, 0)); assert(Tick(B_BUTTON, B_BUTTON));
+    assert(!Tick(0, 0));
+    gMain.vblankCounter2 += 60; // Full-screen menu: field collector absent.
+    assert(!Tick(B_BUTTON, B_BUTTON)); assert(!Tick(0, B_BUTTON));
+    assert(!Tick(0, 0)); assert(Tick(B_BUTTON, B_BUTTON));
+    for (i = 0; i < sizeof(modalKeys)/sizeof(modalKeys[0]); i++)
+    {
+        assert(!Tick(0, 0));
+        assert(!Tick(B_BUTTON | modalKeys[i], B_BUTTON | modalKeys[i]));
+        assert(!Tick(0, B_BUTTON));
+        assert(!Tick(0, 0)); assert(Tick(B_BUTTON, B_BUTTON));
+    }
+}
+
+static void CheckStepBuffer(void)
+{
+    unsigned i;
+    Reset(); assert(!Tick(0, 0));
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_WALK_NORMAL_UP;
+    assert(!Tick(B_BUTTON, B_BUTTON | DPAD_UP));
+    assert(!Tick(0, DPAD_UP)); // Quick release still waits for tile center.
+    gPlayerAvatar.tileTransitionState = T_TILE_CENTER;
+    assert(Tick(0, DPAD_UP)); assert(!Tick(0, DPAD_UP));
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    assert(!Tick(B_BUTTON, B_BUTTON));
+    sScript = TRUE; assert(!Tick(0, B_BUTTON));
+    sScript = FALSE; gPlayerAvatar.tileTransitionState = T_TILE_CENTER;
+    assert(!Tick(0, B_BUTTON)); // A new script discards the queued request.
+    assert(!Tick(0, 0));
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    assert(!Tick(B_BUTTON, B_BUTTON));
+    for (i = 0; i < 40; i++) assert(!Tick(0, B_BUTTON));
+    gPlayerAvatar.tileTransitionState = T_TILE_CENTER;
+    assert(!Tick(0, B_BUTTON)); // Bounded lifetime, no delayed surprise.
+}
+
+static void CheckSpeedAndCollisions(void)
+{
+    Reset();
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_MACH_BIKE;
+    BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FASTER);
+    assert(GetPlayerSpeed() == PLAYER_SPEED_FASTER);
+    sCity = FALSE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_CURRENT);
+    sCity = TRUE; sCollision = COLLISION_IMPASSABLE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_COLLIDE);
+    sCollision = COLLISION_OBJECT_EVENT; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_COLLIDE);
+    sCollision = COLLISION_LEDGE_JUMP; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_LEDGE);
+    sCollision = COLLISION_COUNT; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FAST);
+    sCollision = COLLISION_NONE; sStairs = TRUE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FAST);
+    sStairs = FALSE; sRailFacing = FALSE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FACE);
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_ON_FOOT;
+    assert(GetPlayerSpeed() == PLAYER_SPEED_NORMAL);
+}
+
+int main(void)
+{
+    CheckContext(); CheckFreshAndHeld(); CheckModalReturnAndConflicts(); CheckStepBuffer(); CheckSpeedAndCollisions();
+    puts("PASS: actual bike eligibility/latch/speed/collision bodies; fresh/held/modal/stale/conflicting B, bounded midstep queue, native terrain/locks and untouched fallback motion.");
+    return 0;
+}
+'''
+
+source = "\n".join([
+    prefix,
+    enum(field_types, "PLAYER_AVATAR_STATE_NORMAL"), avatar_flags,
+    enum(field_types, "COLLISION_NONE"), enum(field_types, "T_NOT_MOVING"),
+    button_flags, declarations,
+    function(bike, "IsTaichungOutdoorCyclingMap"), function(bike, "TaichungCanToggleBike"),
+    function(field, "UpdateTaichungBikeShortcutInput"),
+    function(bike, "BikeTransition_MoveDirection"), function(bike, "GetPlayerSpeed"), tests,
+])
+with tempfile.TemporaryDirectory(prefix="taichung-bike-host-") as directory:
+    c_file = Path(directory) / "bike.c"
+    executable = Path(directory) / "bike"
+    c_file.write_text(source)
+    subprocess.run([os.environ.get("CC", "cc"), "-std=c99", "-Wall", "-Wextra", "-Werror", "-I", str(ROOT / "include"), str(c_file), "-o", str(executable)], check=True)
+    subprocess.run([str(executable)], check=True)
