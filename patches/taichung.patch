+   ids={target['old'][y*target['layout']['width']+x]&1023 for x,y in cells}
+   fixed[mid]|=ids;fixed[c['map']]|=ids
+   strip_checks.append((mid,c['map'],cells))
+ code_ids=code_meta_ids(src)
+ report={'baseline':BASE,'maps':{},'landmarks':[],'preservedCameraStripCells':0}
+ for mid,sc in scenes.items():
+  if sc['name'] not in changed:continue
+  capacity=compile_scene(sc,fixed[mid],code_ids,capacity_only)
+  if capacity_only:
+   report['maps'][sc['name']]=capacity
+   continue
+  w=sc['layout']['width']
+  for (x,y),o in sc['overlays'].items():
+   ground=sc['bank'].render(o['floor']).convert('RGBA')
+   # PNG alpha0 is exact, including the losslessly reordered palette and split fills.
+   expected=Image.alpha_composite(ground,o['image'].convert('RGBA')).convert('RGB')
+   assert render_new(sc,sc['grid'][y*w+x]&1023).tobytes()==expected.tobytes(),(sc['name'],x,y,'approved art colors changed')
+  # Every unedited cell must keep exact rendered colors, attributes and map word.
+  cache={};w=sc['layout']['width']
