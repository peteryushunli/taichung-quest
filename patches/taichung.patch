+#!/usr/bin/env python3
+"""No street-name signposts on the outdoor city maps.
+
+The city rework put name-only signposts beside four roads: GONGYI RD. and
+LIMING RD. (Nantun North), HUIWEN S. ST. (Wanhe) and Hwy 74 (Old City North).
+The user asked for the street-name signs to go (2026-11-10). This layer
+removes those four sign events and redraws each signpost cell with the ground
+its map's builder draws there when the sign is left out (derived by running
+tools/taichung/nantun/build_rework.py and tools/taichung/rework/build_rework.py
+with the four entries dropped): grass for the three Nantun verges, the
+sidewalk for Hwy 74's. Each cell becomes walkable; nothing else moves.
+
+Landmark, gym, temple and waterway signs stay. The four sign scripts stay in
+the builders' registered script blocks (unreferenced), so those blocks still
+peel exactly. Opening a closed cell needs no save repair: no saved position
+can stand on a signpost.
+
+This guard proves the tree holds exactly that delta over BASE; frozen guards
+read the bytes underneath it (`underneath`).
+
+  street_signs.py             print the report
+  street_signs.py --install   write the layer into the tree (from BASE)
+  street_signs.py --self-test also prove each corruption probe is caught
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+BASE = "d47712aeb9e4baed224abbcbd5dde3931a8949ec"
+SIGN_WORD = 0x3403  # the kit signpost 0x003, solid, elevation 3
+# (map, layout width, x, y, sign script, ground word the builder draws without the sign)
+REMOVED = (
+    ("TaichungNantunNorth", 45, 19, 23, "TaichungCity_Sign_GongyiRd", 0x3001),
+    ("TaichungNantunNorth", 45, 17, 25, "TaichungCity_Sign_LimingRd", 0x3001),
+    ("TaichungNantunWanhe", 85, 62, 19, "TaichungCity_Sign_HuiwenSSt", 0x3001),
+    ("TaichungOldCityNorth", 44, 14, 10, "TaichungCity_Sign_Hwy74", 0x31C1),
+)
+MAPS = tuple(dict.fromkeys(name for name, *_ in REMOVED))
+MAP_JSON = {name: f"data/maps/{name}/map.json" for name in MAPS}
+MAP_BIN = {name: f"data/layouts/{name}/map.bin" for name in MAPS}
+FILES = tuple(MAP_JSON.values()) + tuple(MAP_BIN.values())
+
+
+def git_show(source, path, revision=BASE):
+    return subprocess.run(["git", "show", f"{revision}:{path}"], cwd=source, check=True, capture_output=True).stdout
+
+
+def dump_json(value):
+    return (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode()
+
+
+def words(raw):
+    return list(struct.unpack(f"<{len(raw) // 2}H", raw))
+
+
+def layer(base_read):
+    """{path: bytes} of this layer's files applied to the files base_read gives;
+    raises ValueError unless those hold each removed sign exactly once."""
+    out = {}
+    for name in MAPS:
+        raw = base_read(MAP_JSON[name])
+        data = json.loads(raw)
+        if dump_json(data) != raw:
+            raise ValueError(f"{MAP_JSON[name]} is not in the builders' JSON format")
+        grid = words(base_read(MAP_BIN[name]))
+        for map_name, width, x, y, script, ground in REMOVED:
+            if map_name != name:
+                continue
+            hits = [e for e in data["bg_events"] if e.get("script") == script]
+            if len(hits) != 1 or (hits[0]["type"], hits[0]["x"], hits[0]["y"]) != ("sign", x, y):
+                raise ValueError(f"{name}: {script} is not one sign at ({x},{y})")
+            if grid[y * width + x] != SIGN_WORD:
+                raise ValueError(f"{name}: ({x},{y}) is {grid[y * width + x]:#06x}, not the signpost")
+            data["bg_events"].remove(hits[0])
+            grid[y * width + x] = ground
+        out[MAP_JSON[name]] = dump_json(data)
+        out[MAP_BIN[name]] = struct.pack(f"<{len(grid)}H", *grid)
+    return out
+
+
+def install(source=ROOT):
+    source = Path(source).resolve()
+    for path, raw in layer(lambda path: git_show(source, path)).items():
+        (source / path).write_bytes(raw)
+
+
+def _reader(source, overrides):
+    overrides = overrides or {}
+    return lambda path: overrides[path] if path in overrides else (Path(source) / path).read_bytes()
+
+
+def check(source=ROOT, overrides=None):
+    source = Path(source).resolve()
+    read = _reader(source, overrides)
+    errors, results = [], {}
+
+    def require(ok, message):
+        if not ok:
+            errors.append(message)
+
+    base = lambda path: git_show(source, path)
+    try:
+        want = layer(base)
+    except ValueError as error:
+        return {"passed": False, "errors": [f"BASE: {error}"], "base": BASE, "checks": {}}
+    for path, raw in want.items():
+        try:
+            require(read(path) == raw, f"{path} is not BASE with exactly the street-name signs removed")
+        except OSError as error:
+            require(False, f"{path}: {error}")
+    # Each new cell is open ground that one of its own neighbours already draws, and
+    # no sign event anywhere still runs a removed script.
+    cells = []
+    for name, width, x, y, script, ground in REMOVED:
+        grid = words(want[MAP_BIN[name]])
+        near = [grid[(y + dy) * width + x + dx] for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1))]
+        require(ground & 0xC00 == 0, f"{name} ({x},{y}): {ground:#06x} is not walkable")
+        require(ground in near, f"{name} ({x},{y}): {ground:#06x} matches none of its neighbours {[hex(w) for w in near]}")
+        cells.append({"map": name, "cell": [x, y], "sign": script.removeprefix("TaichungCity_Sign_"),
+                      "was": f"{SIGN_WORD:#06x}", "now": f"{ground:#06x}"})
+    removed = {script for *_, script, _ in REMOVED}
+    kept = 0
+    for path in sorted((source / "data/maps").glob("Taichung*/map.json")):
+        rel = str(path.relative_to(source))
+        data = json.loads(read(rel))
+        signs = [e for e in data.get("bg_events", []) if e.get("type") == "sign"]
+        require(not removed & {e["script"] for e in signs}, f"{rel} still runs a removed street sign")
+        kept += len(signs)
+        before = [e for e in json.loads(base(rel)).get("bg_events", []) if e.get("type") == "sign"]
+        require([e for e in before if e["script"] not in removed] == signs, f"{rel}: other signs changed")
+    results["removed"] = cells
+    results["signsKept"] = kept
+    return {"passed": not errors, "errors": errors, "base": BASE, "checks": results}
+
+
+def underneath(files):
+    """{path: BASE bytes} for the layer's files when the tree holds exactly this
+    layer over BASE; otherwise {}, so a guard reads the real bytes."""
+    source = Path(files.source)
+    try:
+        want = layer(lambda path: git_show(source, path))
+        if any(files.read(path) != raw for path, raw in want.items()):
+            return {}
+    except (OSError, ValueError, subprocess.CalledProcessError):
+        return {}
+    return {path: git_show(source, path) for path in FILES}
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve()
+    good = check(source)
+    base = lambda path: git_show(source, path)
+    want = layer(base)
+    probes = {}
+    probes["sign-left-in-place"] = {MAP_BIN["TaichungNantunNorth"]: base(MAP_BIN["TaichungNantunNorth"])}
+    data = json.loads(want[MAP_JSON["TaichungOldCityNorth"]])
+    data["bg_events"].append({"type": "sign", "x": 14, "y": 10, "elevation": 0,
+                              "player_facing_dir": "BG_EVENT_PLAYER_FACING_ANY", "script": "TaichungCity_Sign_Hwy74"})
+    probes["event-left-in-place"] = {MAP_JSON["TaichungOldCityNorth"]: dump_json(data)}
+    grid = words(want[MAP_BIN["TaichungNantunWanhe"]])
+    grid[19 * 85 + 62] = 0x3175
+    probes["wrong-ground"] = {MAP_BIN["TaichungNantunWanhe"]: struct.pack(f"<{len(grid)}H", *grid)}
+    data = json.loads(want[MAP_JSON["TaichungNantunWanhe"]])
+    data["bg_events"] = [e for e in data["bg_events"] if e["script"] != "TaichungCity_Sign_WanheTemple"]
+    probes["landmark-sign-removed"] = {MAP_JSON["TaichungNantunWanhe"]: dump_json(data)}
+    grid = words(want[MAP_BIN["TaichungOldCityNorth"]])
+    grid[0] ^= 1
+    probes["other-cell"] = {MAP_BIN["TaichungOldCityNorth"]: struct.pack(f"<{len(grid)}H", *grid)}
+    caught = {name: not check(source, overrides)["passed"] for name, overrides in probes.items()}
+    return {"passed": good["passed"] and all(caught.values()), "tree": good["passed"], "rejectedCorruptionProbes": caught}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--install", action="store_true")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if args.install:
+        install()
+    report = self_test() if args.self_test else check()
+    print(json.dumps(report, indent=2))
+    sys.exit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
