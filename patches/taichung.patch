+    view = rules.Map(source, info, layout, {})
+    print("static const u8 sXitunV8Cases[][4] = {")
+    for row in table(files.text(SAVE), "sXitunV8Relocations"):
+        print("    {%d,%d,%d,%d}," % row)
+    print("};\n\nstatic const u8 sXitunV8SafeRuns[][4] = {")
+    for y in range(HEIGHT):
+        x = 0
+        while x < WIDTH:
+            if not view.walkable(x, y):
