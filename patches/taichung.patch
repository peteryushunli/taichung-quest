+static const u8 *const sModeNames[][2] = {
+    {sOffEn, sOffZh}, {sLowEn, sLowZh}, {sNormalEn, sNormalZh}
+};
+static const u8 *const sHelp[][2] = {
+    {sWildHelpEn, sWildHelpZh}, {sSightHelpEn, sSightHelpZh},
+    {sContinueHelpEn, sContinueHelpZh}, {sOptionsHelpEn, sOptionsHelpZh}
+};
+static const u8 sRowY[] = {40, 58, 78, 94};
+static const u16 sPalette[] = {
+    RGB(31, 30, 27), RGB(31, 30, 27), RGB(3, 10, 8), RGB(19, 22, 18),
+    RGB(5, 19, 10), RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27),
+    RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27),
+    RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27), RGB(31, 30, 27)
+};
+static const u8 sTextColors[] = {1, 2, 1};
+static const u8 sSelectedColors[] = {1, 4, 1};
+static const u8 sMutedColors[] = {1, 3, 1};
+static const struct BgTemplate sBgTemplates[] = {
