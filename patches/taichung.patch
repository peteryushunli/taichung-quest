+@ Shared shipped Miyahara flow: voluntary offer, native preparation, actual
+@ matching win + saved-bit guard, one-shot loss notice, and no rematches.
+	.macro taichung_landmark_gym name, gym, trainer
+	.global TaichungGym_EventScript_\name\()Challenge
+TaichungGym_EventScript_\name\()Challenge:
+	lock
+	faceplayer
+	goto_if_questlog TaichungGym_\name\()ReplaySkipped
+	setvar VAR_0x8004, \gym
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_eq VAR_RESULT, TRUE, TaichungGym_\name\()AlreadyComplete
+	callnative TaichungGym_ScriptConsumeLandmarkLossNotice
+	goto_if_ne VAR_RESULT, TRUE, TaichungGym_\name\()Greeting
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_LOSS
+	callnative TaichungGym_ScriptGet\name\()Message
+	msgbox gStringVar4
+
+	.global TaichungGym_\name\()Greeting
+TaichungGym_\name\()Greeting:
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_GREETING
+	callnative TaichungGym_ScriptGet\name\()Message
+	msgbox gStringVar4
+	call TaichungHistory_Tell
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_OFFER
+	callnative TaichungGym_ScriptGet\name\()Message
+	message gStringVar4
+	waitmessage
+	call TaichungHistory_ChallengeMenu
+	goto_if_ne VAR_RESULT, 0, TaichungGym_\name\()Declined
+	setvar VAR_0x8004, \gym
+	setvar VAR_0x8005, \trainer
+	callnative TaichungGym_ScriptPrepareChallenge
+	goto_if_eq VAR_RESULT, FALSE, TaichungGym_\name\()Unavailable
+	goto_if_eq VAR_0x40FB, 2, TaichungGym_\name\()BattleChinese
+	trainerbattle_single \trainer, TaichungGym_Text_\name\()IntroEn, TaichungGym_Text_\name\()DefeatEn, TaichungGym_\name\()AfterBattle
+	goto TaichungGym_\name\()BattleSkipped
+
+	.global TaichungGym_\name\()BattleChinese
+TaichungGym_\name\()BattleChinese:
+	trainerbattle_single \trainer, TaichungGym_Text_\name\()IntroZh, TaichungGym_Text_\name\()DefeatZh, TaichungGym_\name\()AfterBattle
+	goto TaichungGym_\name\()BattleSkipped
+
+	.global TaichungGym_\name\()BattleSkipped
+TaichungGym_\name\()BattleSkipped:
+	callnative TaichungGym_ScriptCancelChallenge
+	goto TaichungGym_\name\()NotRecorded
+
+@ Native quest-log trainer replay can set a fought flag without running an
+@ actual battle. Exit before preparation or trainerbattle is ever reached.
+	.global TaichungGym_\name\()ReplaySkipped
+TaichungGym_\name\()ReplaySkipped:
+	callnative TaichungGym_ScriptCancelChallenge
+	release
+	end
+
+	.global TaichungGym_\name\()AfterBattle
+TaichungGym_\name\()AfterBattle:
+	setvar VAR_0x8004, \gym
+	callnative TaichungGym_ScriptGetResult
+	goto_if_ne VAR_RESULT, TAICHUNG_GYM_RESULT_WON, TaichungGym_\name\()NotRecorded
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_ne VAR_RESULT, TRUE, TaichungGym_\name\()NotRecorded
+	call TaichungBadge_EventScript_TryAward
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_COMPLETE
+	goto TaichungGym_\name\()Message
+
+	.global TaichungGym_\name\()AlreadyComplete
+TaichungGym_\name\()AlreadyComplete:
+	call TaichungHistory_Tell
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE
+	callnative TaichungGym_ScriptGet\name\()Message
+	msgbox gStringVar4
+	release
+	end
+
+	.global TaichungGym_\name\()Declined
+TaichungGym_\name\()Declined:
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_DECLINED
+	goto TaichungGym_\name\()Message
+
+	.global TaichungGym_\name\()Unavailable
+TaichungGym_\name\()Unavailable:
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_UNAVAILABLE
+	goto TaichungGym_\name\()Message
+
+	.global TaichungGym_\name\()NotRecorded
+TaichungGym_\name\()NotRecorded:
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_NOT_RECORDED
+
+	.global TaichungGym_\name\()Message
+TaichungGym_\name\()Message:
+	callnative TaichungGym_ScriptGet\name\()Message
+	msgbox gStringVar4
+	release
+	end
+	.endm
diff --git a/data/scripts/taichung_landmark_history.inc b/data/scripts/taichung_landmark_history.inc
