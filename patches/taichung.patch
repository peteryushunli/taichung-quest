+static bool8 ApplyRelocation(struct WarpData *warp, const struct SavedPositionRelocation *table, u16 count)
+{
+    u16 i;
+    for (i = 0; i < count; i++)
+    {
+        if (warp->x == table[i].x && warp->y == table[i].y)
+        {
+            warp->x = table[i].toX;
+            warp->y = table[i].toY;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void RepairOldCityPosition(struct WarpData *warp, u16 sourceVersion)
+{
+    if (sourceVersion >= 3 || !IsOldCity(warp) || warp->warpId != -1)
+        return;
+    if (ApplyRelocation(warp, sOldCityV3Relocations, sizeof(sOldCityV3Relocations) / sizeof(sOldCityV3Relocations[0])))
+        return;
+    if (sourceVersion < 2)
+        ApplyRelocation(warp, sOldCityV1Relocations, sizeof(sOldCityV1Relocations) / sizeof(sOldCityV1Relocations[0]));
+}
+
+static bool8 IsXitun(const struct WarpData *warp)
+{
+    return warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_XITUN)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_XITUN);
+}
+
+static bool8 IsGreenway(const struct WarpData *warp)
+{
+    return warp->mapGroup == MAP_GROUP(MAP_TAICHUNG_GREENWAY)
+        && warp->mapNum == MAP_NUM(MAP_TAICHUNG_GREENWAY);
+}
+
+static void RepairChangedCityPosition(struct WarpData *warp, u16 sourceVersion)
+{
