@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Native entry/end/heal/whiteout C with modeled engine data; no browser required."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/gym-healing"
+OUT.mkdir(parents=True, exist_ok=True)
+groups = json.loads((ROOT / "data/maps/map_groups.json").read_text())
+lines = []
+for group, name in enumerate(groups["group_order"]):
+    for number, folder in enumerate(groups[name]):
+        m = json.loads((ROOT / f"data/maps/{folder}/map.json").read_text())
+        lines.append(f'#define {m["id"]} ({number} | ({group} << 8))')
+inc = OUT / "include/constants/map_groups.h"; inc.parent.mkdir(parents=True, exist_ok=True)
+inc.write_text("\n".join(lines) + "\n")
+spec = importlib.util.spec_from_file_location("extract", ROOT / "tools/taichung_gameplay/test-save-facing.py")
+extract = importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+def body(path, name): return extract.definition((ROOT / path).read_text(), name)[0]
+(OUT / "native-heal.inc").write_text(body("src/pokemon.c", "CalculatePPWithBonus") + "\n" + body("src/script_pokemon_util.c", "HealPlayerParty") + "\n")
+progress = (ROOT / "src/taichung_gym_progress.c").read_text()
+trainers = re.search(r"sLandmarkTrainers\[.*?=\s*\{(.*?)\};", progress, re.S)[1]
