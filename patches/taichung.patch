+def mix(keys, values):
+    result = dict(zip(keys, values))
+    assert len(result) == len(keys) and abs(sum(result.values())-1) < 1e-8
+    return result
+
+
+def intersects_rect(a, b, rect):
+    # Liang–Barsky clipping, used only to verify source road names within a section.
+    t0, t1 = 0., 1.
+    dx, dy = b[0]-a[0], b[1]-a[1]
+    for p,q in ((-dx,a[0]-rect[0]), (dx,rect[2]-a[0]), (-dy,a[1]-rect[1]), (dy,rect[3]-a[1])):
+        if p == 0:
+            if q < 0: return False
+        elif p < 0:
+            t0 = max(t0,q/p)
+        else:
+            t1 = min(t1,q/p)
+        if t0 > t1: return False
+    return True
+
+
+def road_names(city, section):
+    x,y = section["worldOrigin"]
+    rect = [x,y,x+64,y+64]
+    names=set()
+    for road in city["streets"]:
+        pts=road["projectedCenterline"]
+        if any(intersects_rect(a,b,rect) for a,b in zip(pts,pts[1:])):
+            names.add(road["sourceName"])
+    return names
+
