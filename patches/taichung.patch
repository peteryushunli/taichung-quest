+#include "string_util.h"
+#include "taichung_language.h"
+
+// The guest house where a new game starts (TaichungGuestHouse_1F/2F) and
+// Xiaoyu's line beside its door in Old City. Each script buffers its line in
+// the save's language, then shows gStringVar4, so the protected language
+// table (taichung_language.c) stays as it is.
+
+static const u8 sCallDownstairsEn[] = _("XIAOYU: Good morning!\nCome down when you're ready!");
+static const u8 sCallDownstairsZh[] = _("小雨：早安！\n準備好就下樓吧！");
+static const u8 sConsoleEn[] = _("It's a game console.\nNot now. Taichung is waiting!");
+static const u8 sConsoleZh[] = _("是遊戲機。\n先不玩，臺中在等你！");
+static const u8 sLaptopEn[] = _("Your laptop. Today's plan:\nExplore Taichung, win badges!");
+static const u8 sLaptopZh[] = _("你的筆電。今天計畫：\n探索臺中，贏徽章！");
+static const u8 sPosterEn[] = _("A map of Taichung.\nOld Station is next door!");
+static const u8 sPosterZh[] = _("是臺中地圖。\n舊車站就在旁邊！");
+static const u8 sWelcomeEn[] = _(
+    "Morning! I'm Xiaoyu, your guide.\nWelcome to Taichung!\p"
+    "Red brick and a clock tower.\nThe city has stories to share.\p"
+    "Old streets, green corridors,\nmuseums full of surprises...");
+static const u8 sWelcomeZh[] = _(
+    "早安！我是小雨，你的嚮導。\n歡迎來到臺中！\p"
+    "紅磚、鐘樓，\n藏著城市的老故事。\p"
+    "老街、綠廊、博物館，\n轉個彎就有新發現。");
+static const u8 sSeeYouOutsideEn[] = _("I'll wait for you outside.\nCome out when you're ready!");
+static const u8 sSeeYouOutsideZh[] = _("我在外面等你，\n準備好就出來吧！");
+static const u8 sTvEn[] = _("The weather report is on.\nSunny skies over Taichung!");
+static const u8 sTvZh[] = _("電視在說天氣：\n臺中今天大晴天！");
+static const u8 sGuideEn[] = _(
+    "Welcome back!\p"
+    "Your POKéMON are rested and ready.\nOutside, B hops on your bike.\p"
+    "OLD STATION is just east.\nMIYAHARA is up this street.");
+static const u8 sGuideZh[] = _(
+    "歡迎回來！\p"
+    "寶可夢已恢復精神。\n在戶外按B就能騎車。\p"
+    "舊車站就在東邊，\n宮原沿這條街往北走。");
+
+static void Buffer(const u8 *english, const u8 *chinese)
+{
+    StringCopy(gStringVar4, TaichungText(english, chinese));
+}
+
+void TaichungGuestHouse_BufferCallDownstairs(void) { Buffer(sCallDownstairsEn, sCallDownstairsZh); }
+void TaichungGuestHouse_BufferConsole(void) { Buffer(sConsoleEn, sConsoleZh); }
+void TaichungGuestHouse_BufferLaptop(void) { Buffer(sLaptopEn, sLaptopZh); }
+void TaichungGuestHouse_BufferPoster(void) { Buffer(sPosterEn, sPosterZh); }
+void TaichungGuestHouse_BufferWelcome(void) { Buffer(sWelcomeEn, sWelcomeZh); }
+void TaichungGuestHouse_BufferSeeYouOutside(void) { Buffer(sSeeYouOutsideEn, sSeeYouOutsideZh); }
+void TaichungGuestHouse_BufferTv(void) { Buffer(sTvEn, sTvZh); }
+void TaichungGuestHouse_BufferGuide(void) { Buffer(sGuideEn, sGuideZh); }
