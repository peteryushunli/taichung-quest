+
+    def source_and_facing():
+        require(registration is not None, 'Missing verified registration')
+        require(registration['facingBridgeDependency']['sourceCommit'] == API and registration['facingBridgeDependency']['function'] == API_NAME, 'Facing dependency differs')
+        for path, expected in registration['sourceFilesSha256'].items():
+            require(now.read(path) == staff.read(path) and digest(now.read(path)) == expected, 'Staff source/immutable attestation differs: ' + path)
+        wrapper = function_text(api.text(SAVE), API_NAME)
