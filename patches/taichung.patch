+         use=[.61,.22,.07,.08,.02], age=[.33,.52,.15], height=[.52,.42,.06], roof=[.40,.38,.16,.06],
+         frontage=.68, setback=[0,2], arcade=.40, signage=.49, green=.16, coverage=.59,
+         roads=["學府路","興大路","復興路三段"], refs=["xingda-student-food-streets"], confidence="medium",
