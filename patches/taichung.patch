+    sheet.save(SECONDARY/'tiles.png')
+    write_words(SECONDARY/'metatiles.bin',[e for g in definitions for e in g])
+    write_words(SECONDARY/'metatile_attributes.bin',attrs,'I')
+    for dest,base in [(PRIMARY,GENERAL),(SECONDARY,PEWTER)]:
+        (dest/'palettes').mkdir(exist_ok=True)
+        for n in range(16):
+            raw=(base/f'palettes/{n:02}.pal').read_bytes()
+            if dest==SECONDARY and n in (7,12):
+                colors=[tuple(station.getpalette()[i:i+3]) for i in range(0,48,3)] if n==7 else kit['palettes'][12]
+                raw=('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,c)) for c in colors)+'\r\n').encode()
