+	map_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, TaichungWelcome_OnFrame
+	.byte 0
+
+@ Retired: new games wake in the guest house. A save still in this room moves
+@ on at once and never gets a second partner: without a partner it restarts in
+@ the guest house bedroom (language there if still unset), with one it steps
+@ out of the guest house door.
+TaichungWelcome_OnFrame::
+	map_script_2 VAR_TEMP_0, 0, TaichungWelcome_Redirect
+	.2byte 0
+
+TaichungWelcome_Redirect::
+	setvar VAR_TEMP_0, 1
+	lockall
+	callnative TaichungStarter_ScriptHasPartner
+	goto_if_eq VAR_RESULT, TRUE, Taichung_OpeningAlreadyDone
+	warp MAP_TAICHUNG_GUEST_HOUSE_2F, 6, 6
+	waitstate
+	releaseall
+	end
+
+TaichungWelcome_Guide::
+	msgbox Taichung_Text_Welcome, MSGBOX_NPC
+	end
