+#!/usr/bin/env python3
+"""Read-only proof for the Xitun street layout and its proposed save v8 repairs.
+
+The bank and map are rebuilt from the reviewed v7 commit, the pinned city-v3
+library and the authored layout, and must match the registered bytes. Expected
+repairs and final valid positions are derived here from the frozen and current
+binary maps under the native walking rules, not from the C table or the host
+test; the C table, its version gates and the host test data must then match.
+Greenway draws the Xitun cells it can see with its own bank, so every visible
+cell must render identically in both banks, in both directions.
+The west and north world edges are solid highway. The west one is the shared
+edge kit, byte-identical to tools/taichung/nantun/edge_art.py at its reserved
+slots. Nantun North (on claude/nantun-skeleton) sees Xitun rows 57-63 through
+gTileset_TaichungGreenwayPrivate and its own bank, so those cells hold only
+primary art that renders identically in that primary, or the edge kit. Its
+connection crosses x26-29 at rows 62-63, which stay open pavers.
+The registered Nantun and OldCity buildings increments share files with this
+one. Each proves its own delta on the actual tree, so the scope check compares
+those files underneath them: Nantun's exact delta removed, and OldCity's map
+accepted only as its install contract's exact output.
+Actual Continue, cache refresh and rendering remain runtime gates.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import deque
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+SAVE, HEADER, TEST = "src/taichung_save.c", "include/taichung_save.h", "tests/taichung_save_test.c"
+WIDTH, HEIGHT = 40, 64
+ROW = r"\{\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\s*\}"
+FENGJIA_ARRIVAL = (24, 15)
+DOORS = {(24, 12), (12, 32), (12, 44)}
+# Nantun North's connection (on claude/nantun-skeleton) crosses these cells.
+NANTUN_SEAM = {(x, y) for x in range(26, 30) for y in (62, 63)}
+FIXED_WALKABLE = {(24, 13), (24, 15), (12, 33), (12, 35), (12, 45), (12, 47), (39, 56), (39, 57), (39, 58), (39, 59)} | NANTUN_SEAM
+# Landmark art plus the Theater world block are owned by released landmark work.
+PROTECTED = ({(x, y) for x in range(19, 29) for y in range(6, 13)}
+             | {(x, y) for x in range(10, 20) for y in range(27, 34)}
+             | {(x, y) for x in range(4, 20) for y in range(35, 45)})
+UNCHANGED = ("data/maps/TaichungXitun/map.json", "data/maps/TaichungGreenway/map.json", "data/maps/TaichungOldCity/map.json",
+             "data/layouts/layouts.json", "data/layouts/TaichungGreenway/map.bin", "data/layouts/TaichungOldCity/map.bin",
+             "data/layouts/TaichungXitun/border.bin", "data/maps/map_groups.json", "docs/taichung-city-contract.json")
+# Registered increments that share files with this one.
+NANTUN_GUARD, LAYOUTS = "tools/taichung/nantun/check_nantun.py", "data/layouts/layouts.json"
+OLDCITY_MAP, OLDCITY_INSTALL = "data/layouts/TaichungOldCity/map.bin", "data/taichung/oldcity-buildings/install.json"
+# tools/taichung/nantun/edge_art.py exactly as Nantun carries it (blob 005513db).
+EDGE_KIT_SHA256 = "f776afdb9a69c907f1ca06648c4fd354c10632150acdfa3fb2b53332bd77eefc"
+# Nantun North (40x40) connects below Xitun at offset 0 and sees its bottom 7 rows.
+NANTUN_NORTH_VIEW, NANTUN_BAND_CELLS = {"width": 40, "height": 40}, 280
+NEWLY_INVALID = 353
+REQUIRED_SAVE_LOGIC = (
+    "if (sourceVersion < 4 && IsXitun(warp) && warp->warpId == -1) ApplyRelocation(warp, sXitunV4Relocations,",
+    "if (sourceVersion < 7 && IsXitun(warp) && warp->warpId == -1) ApplyRelocation(warp, sXitunV7Relocations,",
+    "if (sourceVersion < 8 && IsXitun(warp) && warp->warpId == -1) ApplyRelocation(warp, sXitunV8Relocations,",
+    # Every pre-v8 save in a changed district reloads its map, Xitun included.
+    "static bool8 UsesChangedCityBanks(const struct WarpData *warp, u16 sourceVersion) { "
+    "if (sourceVersion >= TAICHUNG_SAVE_VERSION) return FALSE; return IsOldCity(warp) || IsGreenway(warp) || IsXitun(warp); }",
+    "|| version == 6 || version == 7)",
+)
+
+# Independently registered collision-only layer. Historical street/v8 constants
+# above remain unchanged; Main separately binds the final whole-source profile.
+COLLISION_BASE = "6366b9e5c037647ce4d2a007efa3d3dfbedcdb48"
+COLLISION_COMMIT = "88979b5f8ca5daafbce3a1fe128b27c2b15122ff"
+COLLISION_MAP = "data/layouts/TaichungXitun/map.bin"
+COLLISION_PINS = {
+    "data/taichung/landmark-collision/spec.json": "8293bffc490638ff4f0cc2b55b4d50b24fdf1144249ef04ad03ddef3a6a2b7d7",
+    "data/taichung/landmark-collision/delta.json": "c3b574a0af0cb192d83fcfb0aa5ad80f6d3b383eb71ed606d86e70cc1747c452",
+    "tools/taichung/check_landmark_collision.py": "6dd78d01c98d1d266db9f27dba83aab068d363b0f51ce3039072def33104bd90",
+}
+# The tree holds the collision guard's composing revision, which also reads
+# underneath the city kit and the Xitun, Nantun and Old City reworks; its registered
+# bytes stay pinned at the registration commit above.
+COLLISION_CURRENT = {**COLLISION_PINS, "tools/taichung/check_landmark_collision.py": "77ddf754e06aaf74aa69f1746d9338554979b62a9e09b3b983d3162710b32d90"}
+COLLISION_SPEC = "data/taichung/landmark-collision/spec.json"
+COLLISION_OLD_MAP_SHA = "65432cf516b2b3981b5b99d740806c4f433baed23a4ae3c49f8c8275e4831f5d"
+COLLISION_NEW_MAP_SHA = "1925352ab3b91494278cbe920eec61eba33c8b7798bc95e39d05d71452afb898"
+
+
+def registered_collision(source, overrides=None):
+    """Prove the actual layer before returning only its exact map underlay.
+
+    Expected masks use immutable registration and current override-aware PNG
+    bytes, never delta rows or C repair data. No save or bank bytes are hidden.
+    """
+    source = Path(source).resolve()
+    staff_guard = load('xitun_collision_staff_guard', ROOT / 'tools/taichung/check_gym_staff.py')
+    overrides = staff_guard.current_overrides(source, overrides)
+    edits = overrides or {}
+    if not (source / COLLISION_SPEC).is_file() and COLLISION_SPEC not in edits:
+        return {"active": False, "passed": True, "errors": [], "underlay": {}, "positions": set()}
+    support = load("xitun_collision_support", source / "tools/taichung/landmarks/check_old_core.py")
+    now, base, registration = support.Files(source), support.Files(source, COLLISION_BASE), support.Files(source, COLLISION_COMMIT)
+    now.cache.update(edits)
+    # The overrides carry the city's peeled layers; the staff proof reads only its own files from them.
+    staff_proof = staff_guard.nested_check(source, overrides)
+    tests = support.Checks(); expected = {}; positions = set()
+
+    def proof():
+        tests.require(not staff_proof['active'] or staff_proof['passed'], 'Registered staff/cache source failed its independent proof')
+        tests.errors.extend('gym staff: ' + error for error in staff_proof['errors'])
+        for path, expected_sha in COLLISION_PINS.items():
+            tests.require(support.digest(registration.read(path)) == expected_sha, "Immutable collision registration differs: " + path)
+            tests.require(support.digest(now.read(path)) == COLLISION_CURRENT[path], "Collision registration changed: " + path)
+        spec = registration.json(COLLISION_SPEC)
+        tests.require(spec["baselineCommit"] == COLLISION_BASE, "Collision baseline is not released6366")
+        for path in ("docs/taichung-city-contract.json", "data/layouts/layouts.json", "data/maps/map_groups.json",
+                     "src/data/tilesets/graphics.h", "src/data/tilesets/headers.h", "src/data/tilesets/metatiles.h", "src/graphics.c"):
+            tests.require(now.read(path) == base.read(path), "Collision changed an unrelated interface/bank binding: " + path)
+        contract = base.json("docs/taichung-city-contract.json")
+        landmarks = {item["id"]: item for item in contract["landmarks"]}
+        tests.require({item["id"] for item in spec["footprints"]} == set(landmarks) | {"fine-arts-sculpture"}, "Collision roster is incomplete")
+        layouts = {item["id"]: item for item in base.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+        maps = {}
+        for name in base.json("data/maps/map_groups.json")["gMapGroup_Taichung"]:
+            path = f"data/maps/{name}/map.json"; data = base.json(path)
+            exact_map = now.read(path) == base.read(path)
+            if path in staff_guard.MAP_PATHS and staff_proof['active']:
+                exact_map = staff_guard.matches_map(data, now.json(path), name, staff_proof)
+            tests.require(exact_map, "Collision changed actors/warps/map metadata: " + path)
+            if data["id"] not in {district["map"] for district in contract["districts"]}:
+                continue
+            layout = layouts[data["layout"]]; grid = base.words(layout["blockdata_filepath"])
+            maps[data["id"]] = (layout, grid, grid[:])
+            tests.require(now.read(layout["border_filepath"]) == base.read(layout["border_filepath"]), "Collision changed border bytes")
+        for item in spec["footprints"]:
+            mid = item["mapId"]; ox, oy = item["origin"]; width, height = item["size"]
+            if "art" in item:
+                tests.require(support.digest(now.read(item["art"])) == item["artSha256"], "Pinned collision alpha artwork changed: " + item["id"])
+                art = now.image(item["art"]).convert("RGBA")
+                tests.require(art.size == (width * 16, height * 16), "Collision art size changed")
+                cells = {(ox+x, oy+y) for y in range(height) for x in range(width)
+                         if art.crop((x*16, y*16, (x+1)*16, (y+1)*16)).getchannel("A").getbbox()}
+            else:
+                cells = {(ox+x, oy+y) for y in range(height) for x in range(width)}
+            parent = landmarks[item["id"] if item["id"] != "fine-arts-sculpture" else "fine-arts-museum"]
+            tests.require(parent["exteriorMap"] == mid, "Collision object moved to another map")
+            cells -= {(parent[key]["x"], parent[key]["y"]) for key in ("entrance", "approach", "arrival")}
+            layout, before, after = maps[mid]
+            for x, y in cells:
+                index = y * layout["width"] + x
+                if not after[index] & 0xC00:
+                    after[index] |= 0x400
+        derived = []
+        for mid, (layout, before, after) in maps.items():
+            path = layout["blockdata_filepath"]; raw = struct.pack(f"<{len(after)}H", *after)
+            expected[path] = raw
+            tests.require(now.read(path) == raw, "Actual collision grid differs from exact alpha-derived layer: " + mid)
+            for index, (a, b) in enumerate(zip(before, after)):
+                if a == b: continue
+                x, y = index % layout["width"], index // layout["width"]
+                tests.require(mid == "MAP_TAICHUNG_XITUN" and b == a | 0x400 and not a & 0xC00, "Collision changed more than Xitun collision bits")
+                positions.add((x, y)); derived.append((x, y, f"0x{a:04X}", f"0x{b:04X}"))
+        tests.require(len(positions) == len(derived) == 44, "Collision increment is not exactly44 cells")
+        delta = registration.json("data/taichung/landmark-collision/delta.json")
+        tests.require(sorted(derived) == sorted((r["x"],r["y"],r["before"],r["after"]) for r in delta["newlySolidPositions"]), "Alpha-derived words differ from registered delta")
+        tests.require(support.digest(base.read(COLLISION_MAP)) == COLLISION_OLD_MAP_SHA, "Historical v8 map changed")
+        tests.require(support.digest(now.read(COLLISION_MAP)) == COLLISION_NEW_MAP_SHA, "Current collision map SHA differs")
