+import sys
+from lib2 import *
+import art_station as A
+import art_market as M
+import art_miya as Y
+import art_park as P
+import art_nmfa as N
+import art_theater as T
+ROOMS={}
+def room(fn): ROOMS[fn.__name__]=fn; return fn
+B=BUILDING
+def C(sec,word): return (B,'gTileset_'+sec if not sec.startswith('gTileset_') else sec,word)
+RC=None
+def img_of(c): return metatile(c[0],c[1],c[2]&0x3FF,RC)
+def slices(img,name,solid_=True):
+    """cut an RGBA/RGB image into 16x16 custom cells: returns rows of cells"""
+    rows=[]
+    for ty in range(img.height//16):
