+#!/usr/bin/env bash
+set -euo pipefail
+source_root="$(cd "$(dirname "$0")/.." && pwd)"
+test_output="$(mktemp -d "${TMPDIR:-/tmp}/taichung-onboarding-tests.XXXXXX")"
+trap 'rm -rf "$test_output"' EXIT
+cc -std=c99 -Wall -Wextra -Werror -I"$source_root/include" \
+  "$source_root/src/taichung_onboarding_protocol.c" \
+  "$source_root/tests/test_taichung_onboarding_protocol.c" -o "$test_output/protocol"
+"$test_output/protocol"
+if [[ ! -f "$source_root/include/constants/map_groups.h" ]]; then
+  printf 'Generate the native map headers with the ordinary ROM build before running adapter checks.\n' >&2
+  exit 1
+fi
+cc -std=c99 -Wall -Wextra -Werror -Wno-pointer-to-int-cast \
+  -I"$source_root/tests/onboarding_host" -I"$source_root/include" \
+  "$source_root/src/taichung_onboarding_protocol.c" \
+  "$source_root/src/taichung_onboarding.c" \
+  "$source_root/src/taichung_onboarding_text.c" \
+  "$source_root/src/taichung_exploration.c" \
+  "$source_root/tests/test_taichung_onboarding.c" -o "$test_output/adapter"
+"$test_output/adapter"
