+                normalizedCellCenter=[(world[0] + .5) / bounds['width'], (world[1] + .5) / bounds['height']])
+
+
+def inverse_world(contract, x, y):
+    """Return the one covering exterior and local tile, or None for blank canvas."""
+    if not in_bounds(x, y, contract['world']['width'], contract['world']['height']): return None
+    found = []
+    for key, entry in contract['mapsByNativeKey'].items():
+        if entry['kind'] != 'exterior': continue
