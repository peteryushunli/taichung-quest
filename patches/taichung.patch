+#!/usr/bin/env python3
+"""Check which neighbour the engine picks at every walkable outdoor edge cell.
+
+GetIncomingConnection (src/fieldmap.c) returns the first connection listed for the
+direction whose range holds the player's coordinate along that side, as decided by
+IsCoordInIncomingConnectingMap. This guard models that exactly, reading the bound from
+the engine source, and requires every walkable edge cell of every connected Taichung
+exterior to resolve to the neighbour that actually lies across the edge, at an in-bounds
+cell. It also lists the cells the original inclusive bound (`coord <= srcMax`) sends to
+the wrong map, which the city rework's two-neighbour sides reach.
+
+  python3 tools/taichung/check_connection_boundaries.py
+  python3 tools/taichung/check_connection_boundaries.py --self-test
+"""
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+FIELDMAP = "src/fieldmap.c"
+BOUNDS = {"coord < srcMax": "exclusive", "coord <= srcMax": "inclusive"}
+# Along-side coordinate, side length and the neighbour cell, per direction the player leaves by.
+SIDES = {
+    "left": lambda m, x, y: x == 0,
+    "right": lambda m, x, y: x == m.width - 1,
+    "up": lambda m, x, y: y == 0,
+    "down": lambda m, x, y: y == m.height - 1,
+}
+
+
+def load_validator(source):
+    spec = importlib.util.spec_from_file_location("connection_boundaries_validate_city", source / "tools/taichung/validate_city.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def engine_bound(text):
+    """The bound IsCoordInIncomingConnectingMap uses, read from the engine source."""
+    body = re.search(r"static bool8 IsCoordInIncomingConnectingMap\(s32 coord, s32 srcMax, s32 destMax, s32 offset\)\s*\{(.*?)\n\}", text, re.S)
+    if body is None:
+        raise SystemExit("IsCoordInIncomingConnectingMap not found in " + FIELDMAP)
+    found = [kind for snippet, kind in BOUNDS.items() if f"offset2 <= coord && {snippet})" in body.group(1)]
+    if len(found) != 1:
+        raise SystemExit("IsCoordInIncomingConnectingMap's bound is not one this guard models")
+    return found[0]
+
+
+def incoming(coord, src_max, dest_max, offset, bound):
+    """IsCoordInIncomingConnectingMap."""
+    if dest_max + offset < src_max:
+        src_max = dest_max + offset
+    low = max(offset, 0)
+    return low <= coord < src_max if bound == "exclusive" else low <= coord <= src_max
+
+
+def load_maps(source, overrides):
+    rules = load_validator(source)
+    read = lambda path: overrides.get(path)
+    layouts = {x["id"]: x for x in json.loads(overrides.get("data/layouts/layouts.json") or (source / "data/layouts/layouts.json").read_bytes())["layouts"] if "id" in x}
+    maps, cache = {}, {}
+    for folder in sorted((source / "data/maps").glob("Taichung*/map.json")):
+        rel = str(folder.relative_to(source))
+        data = json.loads(overrides.get(rel) or folder.read_bytes())
+        if data.get("connections"):
+            maps[data["id"]] = rules.Map(source, data, layouts[data["layout"]], cache, read)
+    return maps
+
+
+def resolve(maps, bound):
+    """Every walkable edge cell: the neighbour the engine picks against the one across the edge."""
+    checked, wrong = 0, []
+    for mid, view in maps.items():
+        for direction, on_side in SIDES.items():
+            listed = [c for c in view.data["connections"] if c["direction"] == direction]
+            if not listed:
+                continue
+            along_x = direction in ("up", "down")
+            for y in range(view.height):
+                for x in range(view.width):
+                    if not on_side(view, x, y) or not view.ground(x, y):
+                        continue
+                    coord, src = (x, view.width) if along_x else (y, view.height)
+                    def size(c):
+                        other = maps.get(c["map"])
+                        return None if other is None else (other.width if along_x else other.height)
+                    across = [c for c in listed if size(c) is not None and c["offset"] <= coord < c["offset"] + size(c)]
+                    picked = next((c for c in listed if size(c) is not None and incoming(coord, src, size(c), c["offset"], bound)), None)
+                    checked += 1
+                    expected = across[0]["map"] if len(across) == 1 else None
+                    got = picked["map"] if picked else None
+                    lands = picked is not None and 0 <= coord - picked["offset"] < size(picked)
+                    if got != expected or (picked is not None and not lands):
+                        wrong.append({"map": mid, "cell": [x, y], "leaving": direction,
+                                      "engineGoesTo": got, "acrossTheEdge": expected, "landsInBounds": lands})
+    return checked, wrong
+
+
+def check(source=ROOT, overrides=None):
+    source, overrides = Path(source).resolve(), overrides or {}
+    bound = engine_bound((overrides.get(FIELDMAP) or (source / FIELDMAP).read_bytes()).decode())
+    maps = load_maps(source, overrides)
+    checked, wrong = resolve(maps, bound)
+    _, inclusive = resolve(maps, "inclusive")
+    return {"passed": not wrong, "engineBound": bound, "connectedExteriors": len(maps), "walkableEdgeCells": checked,
+            "misrouted": wrong, "misroutedUnderInclusiveBound": inclusive}
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve()
+    text = (source / FIELDMAP).read_text()
+    inclusive = text.replace("offset2 <= coord && coord < srcMax)", "offset2 <= coord && coord <= srcMax)", 1)
+    probes = {"inclusiveBoundRejected": not check(source, {FIELDMAP: inclusive.encode()})["passed"]}
+    # The exclusive bound is order-independent: reversing every map's connection list still passes.
+    reversed_maps = {}
+    for folder in sorted((source / "data/maps").glob("Taichung*/map.json")):
+        data = json.loads(folder.read_text())
+        if data.get("connections"):
+            data["connections"] = data["connections"][::-1]
+            reversed_maps[str(folder.relative_to(source))] = json.dumps(data).encode()
+    probes["reversedConnectionOrderPasses"] = check(source, reversed_maps)["passed"]
+    return probes
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    report = check(args.source)
+    if args.self_test:
+        report["probes"] = self_test(args.source)
+        report["passed"] = report["passed"] and all(report["probes"].values())
+    print(json.dumps(report, indent=2))
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
