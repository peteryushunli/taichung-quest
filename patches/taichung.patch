diff --git a/data/maps/TaichungOldCity/scripts.inc b/data/maps/TaichungOldCity/scripts.inc
new file mode 100644
index 00000000..32b134ef
--- /dev/null
+++ b/data/maps/TaichungOldCity/scripts.inc
@@ -0,0 +1,41 @@
+TaichungOldCity_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, Taichung_OnFrame
+	.byte 0
+
+@ The new-game-only C field gate starts this before ordinary input handling.
+@ It does not run for existing saves or while quest-log recap is playing.
+TaichungOldCity_OnboardingStart::
+	lockall
+	turnobject LOCALID_TAICHUNG_STATION_GUIDE, DIR_WEST
+	turnobject LOCALID_PLAYER, DIR_EAST
+	callnative TaichungOnboarding_ScriptIsRelease
+	goto_if_eq VAR_RESULT, TRUE, TaichungOldCity_OnboardingRelease
+	callnative TaichungOnboarding_ScriptCanOfferTour
+	goto_if_ne VAR_RESULT, TRUE, TaichungOldCity_OnboardingTopic
+	callnative TaichungOnboarding_ScriptBufferTopic
+	message gStringVar4
+	waitmessage
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_TOUR, FALSE
+	goto_if_ne VAR_RESULT, 0, TaichungOldCity_OnboardingSkip
+	callnative TaichungOnboarding_ScriptAdvance
+@ Each tip is ordinary native dialogue: the box stays open between tips and
+@ A/B advances as everywhere else. No browser card or emulator pause.
+TaichungOldCity_OnboardingTopic::
+	callnative TaichungOnboarding_ScriptBufferTopic
+	msgbox gStringVar4
+	callnative TaichungOnboarding_ScriptAdvance
+	goto_if_eq VAR_RESULT, FALSE, TaichungOldCity_OnboardingTopic
+TaichungOldCity_OnboardingRelease::
+	callnative TaichungOnboarding_ScriptBufferRelease
+	msgbox gStringVar4
+	callnative TaichungOnboarding_ScriptFinish
+	releaseall
+	end
+
+TaichungOldCity_OnboardingSkip::
+	closemessage
+	callnative TaichungOnboarding_ScriptSkipTour
+	releaseall
+	end
