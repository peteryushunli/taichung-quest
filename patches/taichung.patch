+#!/usr/bin/env python3
+"""Prepare private Xitun graphics/foreground templates without installing them.
+
+Frozen e9 definitions keep their IDs and appearance. The approved Fengjia and
+Maple indexed rasters are packed exactly, with no redraw or map geometry edits.
+New lower layers/attributes are explicitly unassigned templates for Root's later
+terrain/portal work. Only three new output directories are written.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+from check_old_core import Files, Bank, resolved_folder
+from analyze_theater_cohort import visible_cells, bounds
+
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
+OLD_PRIMARY = "data/tilesets/primary/taichung_old_core"
+OLD_SECONDARY = "data/tilesets/secondary/taichung_xitun"
+PRIMARY = "data/tilesets/primary/taichung_xitun_private"
+SECONDARY = "data/tilesets/secondary/taichung_xitun_final"
+DATA = "data/taichung/landmarks/xitun-final-native"
+XITUN = "MAP_TAICHUNG_XITUN"
+NAMES = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+SPECS = (
+    {"id": "fengjia-night-market", "input": "fengjia/candidate-maxcoverage/candidate-indexed.png", "palette": 9},
+    {"id": "maple-garden", "input": "maple-garden/candidate-160x112/candidate-indexed.png", "palette": 8},
+)
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(pixels):
+    return min((tuple(pixels[(7-y if f & 0x800 else y)*8+(7-x if f & 0x400 else x)]
+                      for y in range(8) for x in range(8)), f) for f in (0, 0x400, 0x800, 0xC00))
+
+
+def graphic(image, index):
+    sx, sy = index % (image.width//8)*8, index // (image.width//8)*8
+    return tuple(image.getpixel((sx+x, sy+y)) for y in range(8) for x in range(8))
+
+
+def palette_bytes(colors):
+    return ("JASC-PAL\r\n0100\r\n16\r\n"+"".join(" ".join(map(str, color))+"\r\n" for color in colors)).encode()
+
+
+def palette_colors(raw):
+    result = [tuple(map(int, row.split())) for row in raw.decode().splitlines()[3:] if row.strip()]
+    assert len(result) == 16
+    return result
+
+
+def packed_words(values, kind="H"):
+    return struct.pack("<"+str(len(values))+kind, *values)
+
+
+def render_digest(bank, ids):
+    return digest(b"".join(packed_words([n])+packed_words([bank.attr(n)], "I")+
+                          bytes(v for rgb in bank.render(n) for v in rgb) for n in ids))
+
+
+class Pack:
+    def __init__(self, bank, reserved, animated):
+        self.primary = bank.images[0].copy()
+        self.free = sorted(set(range(640))-reserved)
+        self.lookup, self.primary_allocated, self.secondary = {}, [], []
+        for n in sorted(reserved-animated):
+            pixels, flags = canonical(bank.graphic(n))
+            self.lookup.setdefault(pixels, (n, flags))
+
+    def add(self, pixels):
+        pixels, flags = canonical(pixels)
+        if pixels not in self.lookup:
+            if len(self.primary_allocated) < len(self.free):
+                n = self.free[len(self.primary_allocated)]
+                self.primary_allocated.append(n)
+                for y in range(8):
+                    for x in range(8):
+                        self.primary.putpixel((n%16*8+x, n//16*8+y), pixels[y*8+x])
+            else:
+                assert len(self.secondary) < 376, "Static secondary graphics would touch door scratch"
+                n = 640+len(self.secondary)
+                self.secondary.append(pixels)
+            self.lookup[pixels] = (n, 0)
+        n, stored_flags = self.lookup[pixels]
+        assert n < 1016
+        return n | (flags ^ stored_flags)
+
+
+def compile_pack(output_root=ROOT, verify_rebuild=True):
+    output_root = output_root.resolve()
+    frozen = Files(ROOT, BASE)
+    audit = frozen.json("data/taichung/landmarks/old-core-bank-audit.json")
+    reserved = set(audit["primaryConservativeRawHoleOption"]["requiredRawGraphicIds"])
+    animated = set(audit["generalAnimation"]["fixedGraphicIds"])
+    reserved |= animated
+    closure = audit["primaryConservativeRawHoleOption"]["generalMetatileIdsToKeepCompatible"]
+    assert len(reserved) == 228 and len(animated) == 70
+    before = Bank(frozen, OLD_PRIMARY, OLD_SECONDARY)
+    assert len(before.attrs[1]) == 239
+    pack = Pack(before, reserved, animated)
+    source_primary_refs = {e & 1023 for n in range(640, 879) for e in before.entries(n) if e & 1023 < 640}
+    assert source_primary_refs <= reserved, "Legacy definitions depend on a primary hole; extend protection first"
+    old_refs = sorted({e & 1023 for n in range(640, 879) for e in before.entries(n) if e & 1023 >= 640})
+    relocation = {n: pack.add(before.graphic(n)) for n in old_refs}
+    after_old_primary_count = len(pack.primary_allocated)
+    assert len(old_refs) == 337 and after_old_primary_count == 336 and not pack.secondary
+    # Exact legacy appearance can coexist with the new palettes by keeping the
+    # old8/9 colors in unused10/11. General's protected closure needs neither.
+    palette_aliases = {8: 10, 9: 11}
+    assert not ({10, 11} & {e >> 12 for n in range(640, 879) for e in before.entries(n)})
+    assert not ({8, 9} & {e >> 12 for n in closure for e in before.entries(n)})
+    definitions = []
+    for n in range(640, 879):
+        group = []
+        for entry in before.entries(n):
+            palette = palette_aliases.get(entry >> 12, entry >> 12)
+            mapped = relocation[entry & 1023] if entry & 1023 >= 640 else entry & 1023
+            group.append(palette << 12 | ((entry & 0xC00) ^ (mapped & 0xC00)) | (mapped & 1023))
+        definitions.append(group)
+    attributes = before.attrs[1].copy()
+    palettes = {n: palette_colors(frozen.read(f"{OLD_SECONDARY}/palettes/{n:02}.pal")) for n in range(16)}
+    palettes[10], palettes[11] = palettes[8].copy(), palettes[9].copy()
+    landmarks, art_inputs, art_hashes = [], {}, {}
+    source_pattern_sum, source_pattern_union = 0, set()
+    for spec in SPECS:
+        relative = "data/taichung/landmarks/"+spec["input"]
+        path = ROOT / relative
+        raw = path.read_bytes()
+        art = Image.open(path)
+        assert art.mode == "P" and art.info.get("transparency") == 0 and art.getextrema()[1] < 16
+        assert art.width % 16 == art.height % 16 == 0
+        assert set(art.convert("RGBA").getchannel("A").get_flattened_data()) == {0, 255}
+        art_inputs[spec["id"]] = art.copy()
+        art_hashes[relative] = digest(raw)
+        pal = [tuple(art.getpalette()[n:n+3]) for n in range(0, 48, 3)]
+        palettes[spec["palette"]] = pal
+        pattern_set = {canonical(graphic(art, n))[0] for n in range(art.width*art.height//64)}
+        source_pattern_sum += len(pattern_set)
+        source_pattern_union |= pattern_set
+        cells, rows = [], []
+        primary_at_start, secondary_at_start = len(pack.primary_allocated), len(pack.secondary)
+        for my in range(art.height//16):
+            row = ""
+            for mx in range(art.width//16):
+                ink = sum(bool(art.getpixel((mx*16+x, my*16+y))) for y in range(16) for x in range(16))
+                row += "1" if ink else "0"
+                if not ink:
+                    continue
+                fg = []
+                for dy in range(2):
+                    for dx in range(2):
+                        pixels = tuple(art.getpixel((mx*16+dx*8+x, my*16+dy*8+y)) for y in range(8) for x in range(8))
+                        fg.append(pack.add(pixels) | spec["palette"] << 12)
+                n = 640+len(definitions)
+                assert n < 1024
+                # No ground or terrain inference is made from the park raster.
+                # Root must compose lower layers and assign real attributes.
+                definitions.append([0]*4+fg)
+                attributes.append(0)
+                cells.append({"local": [mx, my], "metatileId": n, "foreground": fg, "opaquePixels": ink})
+            rows.append(row)
+        landmarks.append({"id": spec["id"], "input": relative, "inputSha256": digest(raw),
+                          "sizePixels": list(art.size), "palette": spec["palette"],
+                          "sourceFlipCanonicalGraphics": len(pattern_set), "occupancyRows": rows,
+                          "occupiedCells": len(cells), "localMetatileIds": {str(x["local"][0])+","+str(x["local"][1]): x["metatileId"] for x in cells},
+                          "cells": cells, "newPrimaryGraphics": len(pack.primary_allocated)-primary_at_start,
+                          "newSecondaryGraphics": len(pack.secondary)-secondary_at_start,
+                          "mapOrigin": None, "collisionAssigned": False, "groundLayersAssigned": False,
+                          "templateAttributesAreZeroNotGameplayApproval": True})
+    assert len(definitions) <= 384
+    paths = [output_root / PRIMARY, output_root / SECONDARY, output_root / DATA]
+    for path in paths:
+        path.mkdir(parents=True, exist_ok=True)
+    primary_out, secondary_out, data_out = paths
+    pack.primary.save(primary_out / "tiles.png")
+    for name in ("metatiles.bin", "metatile_attributes.bin"):
+        (primary_out / name).write_bytes(frozen.read(f"{OLD_PRIMARY}/{name}"))
+    (secondary_out / "metatiles.bin").write_bytes(packed_words([entry for group in definitions for entry in group]))
+    (secondary_out / "metatile_attributes.bin").write_bytes(packed_words(attributes, "I"))
+    loaded = max(16, (len(pack.secondary)+15)//16*16)
+    assert loaded <= 384
+    sheet = Image.new("P", (128, loaded//16*8))
+    sheet.putpalette(before.images[0].getpalette())
+    for n, pixels in enumerate(pack.secondary):
+        for y in range(8):
+            for x in range(8):
+                sheet.putpixel((n%16*8+x, n//16*8+y), pixels[y*8+x])
+    sheet.save(secondary_out / "tiles.png")
+    for out, source in ((primary_out, OLD_PRIMARY), (secondary_out, OLD_SECONDARY)):
+        (out / "palettes").mkdir(exist_ok=True)
+        for n in range(16):
