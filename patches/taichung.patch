diff --git a/include/tile_stream.h b/include/tile_stream.h
new file mode 100644
index 00000000..d41811c5
--- /dev/null
+++ b/include/tile_stream.h
@@ -0,0 +1,107 @@
+#ifndef GUARD_TILE_STREAM_H
+#define GUARD_TILE_STREAM_H
+
+#include "global.h"
+
+// Streamed tilesets (tile limit probe).
+//
+// An ordinary map copies its two tilesets into VRAM once: 640 + 384 tiles,
+// 7 + 6 palettes. A map whose secondary tileset sets streamBanks instead
+// loads a tile or a palette when the camera first draws a metatile that
+// uses it, and gives the slot back once nothing in the 32x32 tilemap
+// buffers refers to it. What a map may hold is then bounded by the tile
+// number format (65,536 tiles, 64 palettes), and what must fit in VRAM is
+// only what the 16x16 metatile draw window shows at one time.
+
+// Probe instrumentation. Everything guarded by TILE_STREAM_PROBE can be
+// removed without changing what the game draws: it only counts and times.
+#define TILE_STREAM_PROBE   1
+
+#define TILE_STREAM_FRAME_FIELD (1 << 0) // the overworld ran this frame
+#define TILE_STREAM_FRAME_SLICE (1 << 1) // a row or column was drawn for a step
+#define TILE_STREAM_FRAME_WHOLE (1 << 2) // the whole view was drawn
+#define TILE_STREAM_FRAME_SEAM  (1 << 3) // the player crossed a map connection
+#define TILE_STREAM_FRAME_WAITED (1 << 4) // cells left over from an earlier step were drawn
+
+struct TileStreamLateFrame
+{
+    u32 frameCycles;   // the whole main-loop pass, the screen-refresh interrupt included
+    u32 drawCycles;    // of which inside TileStream_DrawMetatile
+    u16 flags;
+    u16 cells;         // map cells drawn in the pass
+};
+
+// Counters the QA harness reads straight out of EWRAM. Times are CPU cycles
+// (a frame is 280,896), measured with timer 2 to the nearest 64.
+struct TileStreamStats
+{
+    /*0x00*/ u32 magic;           // 'TSTR' while a streamed map is loaded, else 0
+    /*0x04*/ u16 residentTiles;   // tile slots in use by the draw window now
+    /*0x06*/ u16 peakTiles;       // most slots ever in use at once since the map loaded
+    /*0x08*/ u16 dynamicSlots;    // slots the cache may hand out
+    /*0x0a*/ u16 overflowTiles;   // tiles drawn blank because no slot was free
+    /*0x0c*/ u16 residentPals;
+    /*0x0e*/ u16 peakPals;
+    /*0x10*/ u16 overflowPals;    // palettes that could not be given a slot
+    /*0x12*/ u16 resets;          // times the cache was emptied and the view redrawn
+    /*0x14*/ u32 tileLoads;       // 8x8 tiles copied into VRAM
+    /*0x18*/ u32 palLoads;
+    /*0x1c*/ u32 lastSlice;       // the row or column drawn for the latest one-tile step
+    /*0x20*/ u32 maxSlice;
+    /*0x24*/ u32 sliceSum;
+    /*0x28*/ u32 sliceCount;
+    /*0x2c*/ u32 lastWhole;       // the latest redraw of the whole view
+    /*0x30*/ u32 mainLoops;
+    /*0x34*/ u32 vblanks;
+    /*0x38*/ u32 lateFrames;      // main-loop passes that ran past a screen refresh
+    /*0x3c*/ u32 fieldFrames;     // overworld passes with no whole-view redraw and no seam
+    /*0x40*/ u32 fieldFrameSum;
+    /*0x44*/ u32 maxPlainFrame;   // longest such pass that drew no step
+    /*0x48*/ u32 maxSliceFrame;   // longest such pass that drew a step
+    /*0x4c*/ u32 metatileSum;     // time inside TileStream_DrawMetatile
+    /*0x50*/ u32 metatilesDrawn;
+    /*0x54*/ u32 pendingMax;      // most map cells ever left to draw on a later frame
+    /*0x58*/ u16 frameFlags;
+    /*0x5a*/ u16 lateIndex;
+    /*0x5c*/ struct TileStreamLateFrame late[8]; // the most recent late passes
+    /*0xbc*/ u32 loadCells;       // cells whose drawing copied at least one tile or palette
+    /*0xc0*/ u32 loadCellSum;     // time drawing those cells
+    /*0xc4*/ u32 maxCell;         // longest single cell
+    /*0xc8*/ u32 frameLoads;      // tile and palette loads so far, as of the start of the pass
+    /*0xcc*/ u32 cellsUnchanged;  // cells that already showed the metatile asked for
+};
+
+void TileStream_ClockStart(void);
+u32 TileStream_Clock(void);
+#define TILE_STREAM_ELAPSED(start) (((TileStream_Clock() - (start)) & 0xFFFF) * 64) // cycles since a TileStream_Clock() reading
+void TileStream_FrameBegin(void);
+void TileStream_FrameEnd(void);
+#define TileStream_Mark(flag) (gTileStreamStats.frameFlags |= (flag))
+
+extern struct TileStreamStats gTileStreamStats;
+
+bool32 TileStream_IsLayoutStreamed(const struct MapLayout *layout);
+bool32 TileStream_IsActive(void);
+
+// Called where a map's tilesets would be copied to VRAM. Returns TRUE if the
+// layout is streamed, in which case nothing else needs copying.
+bool32 TileStream_Begin(const struct MapLayout *layout);
+void TileStream_End(void);
+void TileStream_ForgetAllocation(void);   // the heap was reinitialised
+void TileStream_Free(void);
+
+// Crossing a map connection. Returns TRUE if either side is streamed, in
+// which case tiles and palettes have been dealt with here.
+bool32 TileStream_OnCameraTransition(const struct MapLayout *oldLayout, const struct MapLayout *newLayout);
+bool32 TileStream_TakeRedrawRequest(void);
+
+// Drawing. Neither schedules the tilemap copy to VRAM; the caller does.
+void TileStream_DrawMetatile(const struct MapLayout *layout, u32 metatileId, u32 offset);
+void TileStream_DrawEntries(u32 layerType, const u16 *entries, u32 offset);
+// Cells left to draw on a later frame (field_camera.c decides which may wait).
+void TileStream_DeferCell(u32 offset, s32 x, s32 y);
+bool32 TileStream_DrawDeferred(u32 max);
+void TileStream_DropDeferred(void);
+void TileStream_ReloadPalettes(void);
+
+#endif // GUARD_TILE_STREAM_H
