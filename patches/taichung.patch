+    # Source geometry only: install the proposed grid/attributes into a temporary
+    # Validator instance, never into the registered source map.
+    geometry = load_native(root).Validator(root, frozen.json("docs/taichung-city-contract.json"))
+    scene = geometry.maps[MID]
