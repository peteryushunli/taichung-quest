+#!/usr/bin/env python3
+"""Run the frozen Story qualification and all unchanged prior source/host suites.
+
+Writes ignored host-test logs only. No native ROM, UI, network or runtime source
+mutation. Old capture host sources are byte-exact to the current Story tree.
+"""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/compact-story-guards"
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("compact_story_qualification", ROOT / "tools/taichung/compact_story_guard.py")
+story = importlib.util.module_from_spec(spec); spec.loader.exec_module(story)
+story.verified(story.reader(ROOT))
+env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
+env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+checks = {}
+
+
+def run(name, command, source=ROOT):
+    result = subprocess.run(command, cwd=source, env=env, capture_output=True, text=True)
+    (OUT / (name + ".log")).write_text(result.stdout + result.stderr)
+    checks[name] = dict(passed=result.returncode == 0, exitCode=result.returncode)
+    if result.returncode:
+        raise RuntimeError(name + " failed:\n" + (result.stdout + result.stderr)[-6000:])
+    print("PASS: " + name, flush=True)
+
+
+try:
+    run("story-source-corruptions", [sys.executable, "-B", "tools/taichung/compact_story_guard.py", "--self-test"])
+    run("story-provenance-composition", [sys.executable, "-B", "tests/test_compact_story_guard.py"])
+    run("current-story-c-scripts-corruptions", ["bash", "tools/taichung_gameplay/test-optional-story.sh"])
+    run("unchanged-previous-guards", [sys.executable, "-B", "tools/taichung/compact_story_guard.py", "--previous-guards"])
+    with story.qualified_mirror(ROOT) as view:
+        run("unchanged-capture-host-regressions", [sys.executable, "-B", "tools/taichung_gameplay/test-capture-release.py"], view)
+finally:
+    (OUT / "receipt.json").write_text(json.dumps(dict(passed=len(checks) == 5 and all(r["passed"] for r in checks.values()),
+        baseline=story.BASE, feature=story.FEATURE, checks=checks, runtimeAcceptanceClaimed=False), indent=2) + "\n")
