+    assert(TaichungSaveUsesStationCheckpoint());
+    printf("PASS: OldCity v8 cache-only refresh for v1-v7 with all231 building-side positions kept and a combined pre-v8 OldCity+Greenway+Xitun refresh; Xitun streets v8 exact353 repairs for v1-v7 chained after v4/v7, all1367 final valid Xitun positions, pre-v8 refresh of all three outdoor districts and native pending/door priority; cb-only Xitun v7 exact29 repairs for v1-v6, older62 Xitun union and age gates, all1572 v7 positions, v6 Xitun-only refresh; every prior OldCity/Theater/e9/CMP regression and table, established onboarding stage/bag/team/preferences/checkpoint protection, v10/v11 exits and Park transient lifetime; Maple v9 covers all44 independent map-diff origins, source versions1..8, the v9 age gate and pending/native-door priority. Separate961 OldCity layout excluded. "
+           "City rework v10, every released cell (");
+    for (i = 0; i < V10_DISTRICTS; i++)
+        printf("%s%s %ux%u shift(%d,%d) %u repairs %u cases", i ? ", " : "", sV10[i].name, sV10[i].width, sV10[i].height,
+               sV10[i].dx, sV10[i].dy, sV10[i].repairs, sV10Cases[i]);
+    printf("): v9 reload once or repair a pending target, native IDs -3/0/1/2 byte-identical, v1-v8 chained through every historical table then v10 and approved art v11, unversioned prototypes, other map groups untouched, current/future byte-exact; Maple v8 chain on all44 ends on (12,35)'s v10 tile; %u room/welcome/temple cases unchanged; historical age gates and expectations retained, then composed with independently validated v11 truth.\n", sV10RoomCases);
+    return 0;
+}
diff --git a/tests/taichung_save_v11_test.c b/tests/taichung_save_v11_test.c
new file mode 100644
index 0000000..131a7b7
--- /dev/null
+++ b/tests/taichung_save_v11_test.c
@@ -0,0 +1,217 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_save.h"
+#include "constants/maps.h"
+
+struct V11TruthMap
+{
+    u8 group, num, width, height;
+    const u8 (*repairs)[4];
+    u16 count;
+};
+struct V11LegacyChain { u8 group, num, x, y, toX, toY, firstVersion, sameWorldTile; };
+#include "approved-art-v11-truth.inc"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool8 sPending;
+static unsigned sWrites, sWarpRequests, sCancels, sCases;
+
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_SAVE_VERSION_VAR);
+    sSave.vars[id - VARS_START] = value;
+    sWrites++;
+    return TRUE;
+}
+bool32 UseContinueGameWarp(void) { return sPending; }
+void SetContinueGameWarpStatus(void) { sPending = TRUE; sWarpRequests++; }
+void TaichungGymCancelChallenge(void) { sCancels++; }
+
+static void Saved(u16 version, u8 group, u8 num, s16 x, s16 y, u8 facing)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    sSave.playerPartyCount = 3;
+    sSave.vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START] = version;
+    sSave.vars[0xFC] = 133; // A freely selected team, not an original starter.
+    sSave.vars[0xFB] = 2;
+    sSave.location = (struct WarpData){group, num, 2, 4, 7};
+    sSave.pos.x = x; sSave.pos.y = y;
+    sSave.continueGameWarp = (struct WarpData){42, 7, 1, 19, 21};
+    sSave.lastHealLocation = (struct WarpData){43, 8, -1, 17, 19};
+    memset(sSave.objectEvents, 0, sizeof(sSave.objectEvents));
+    sSave.objectEvents[0].active = TRUE;
+    sSave.objectEvents[0].isPlayer = TRUE;
+    sSave.objectEvents[0].facingDirection = facing;
+    sPending = FALSE;
+    sWrites = sWarpRequests = sCancels = 0;
+}
+
+static bool8 Expected(const struct V11TruthMap *map, s16 *x, s16 *y)
+{
+    unsigned i;
+    for (i = 0; i < map->count; i++)
+        if (*x == map->repairs[i][0] && *y == map->repairs[i][1])
+        {
+            *x = map->repairs[i][2]; *y = map->repairs[i][3];
+            return TRUE;
+        }
+    return FALSE;
+}
+
+static void Protected(const struct SaveBlock1 *before)
+{
+    struct SaveBlock1 expected = *before;
+    // The current version (v12 added only gym-room arrivals; see taichung_save_v12_test.c).
+    expected.vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START] = TAICHUNG_SAVE_VERSION;
+    expected.continueGameWarp = sSave.continueGameWarp; // Checked separately.
+    assert(sWrites == 1 && sCancels == 1);
+    // Includes all nonversion variables, language, six party/bag-sized protected
+    // byte ranges, badges, checkpoint, object cache, map ID and actual saved pos.
+    assert(memcmp(&expected, &sSave, sizeof(expected)) == 0);
+}
+
+static void ArrivalFacing(u8 expected)
+{
+    u8 actual;
+    // Exercise the real one-shot handoff using its native post-warp inputs.
+    // Avatar rendering itself is covered by the existing native engine suite.
+    sSave.location = sSave.continueGameWarp;
+    sSave.pos.x = sSave.continueGameWarp.x;
+    sSave.pos.y = sSave.continueGameWarp.y;
+    actual = TaichungSaveConsumeContinueFacing();
+    if (actual != expected)
+        fprintf(stderr, "v11 facing case %u map %d,%d target(%d,%d): expected %u got %u\n",
+                sCases, sSave.location.mapGroup, sSave.location.mapNum, sSave.pos.x, sSave.pos.y, expected, actual);
+    assert(actual == expected);
+    assert(TaichungSaveConsumeContinueFacing() == DIR_NONE);
+}
+
+static void EveryV10Cell(void)
+{
+    unsigned m, x, y, dir;
+    for (m = 0; m < sizeof(sV11TruthMaps) / sizeof(sV11TruthMaps[0]); m++)
+    {
+        const struct V11TruthMap *map = &sV11TruthMaps[m];
+        for (y = 0; y < map->height; y++)
+            for (x = 0; x < map->width; x++)
+                for (dir = DIR_SOUTH; dir <= DIR_EAST; dir++)
+                {
+                    struct SaveBlock1 before;
+                    s16 tx = x, ty = y;
+                    bool8 repaired = Expected(map, &tx, &ty);
+                    Saved(10, map->group, map->num, x, y, dir);
+                    before = sSave;
+                    TaichungSaveUpgradeOnContinue();
+                    assert(sPending && sWarpRequests == 1);
+                    assert(sSave.continueGameWarp.mapGroup == map->group);
+                    assert(sSave.continueGameWarp.mapNum == map->num);
+                    assert(sSave.continueGameWarp.warpId == -1);
+                    assert(sSave.continueGameWarp.x == tx && sSave.continueGameWarp.y == ty);
+                    Protected(&before);
+                    ArrivalFacing(repaired ? DIR_NONE : dir);
+                    sCases++;
+                }
+    }
+}
+
+static void PendingTargets(void)
+{
+    unsigned m, i;
+    for (m = 0; m < sizeof(sV11TruthMaps) / sizeof(sV11TruthMaps[0]); m++)
+    {
+        const struct V11TruthMap *map = &sV11TruthMaps[m];
+        for (i = 0; i <= map->count; i++)
+        {
+            struct SaveBlock1 before;
+            struct WarpData expected;
+            s16 x = i < map->count ? map->repairs[i][0] : -1;
+            s16 y = i < map->count ? map->repairs[i][1] : -1;
+            Saved(10, map->group, 3, 3, 9, DIR_NORTH);
+            sPending = TRUE;
+            sSave.continueGameWarp = (struct WarpData){map->group, map->num, -1, x, y};
+            expected = sSave.continueGameWarp;
+            Expected(map, &expected.x, &expected.y);
+            before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(sPending && sWarpRequests == 0);
+            assert(memcmp(&expected, &sSave.continueGameWarp, sizeof(expected)) == 0);
+            Protected(&before); ArrivalFacing(DIR_NONE); sCases++;
+
+            // Even a newly blocked explicit x/y does not override a native door.
+            Saved(10, map->group, 3, 3, 9, DIR_WEST);
+            sPending = TRUE;
+            sSave.continueGameWarp = (struct WarpData){map->group, map->num, 0, x, y};
+            expected = sSave.continueGameWarp; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(sPending && sWarpRequests == 0);
+            assert(memcmp(&expected, &sSave.continueGameWarp, sizeof(expected)) == 0);
+            Protected(&before); ArrivalFacing(DIR_NONE); sCases++;
+        }
+    }
+}
+
+static void LegacyChains(void)
+{
+    unsigned i, version;
+    for (i = 0; i != V11_LEGACY_CHAIN_COUNT; i++)
+    {
+        const struct V11LegacyChain *chain = &sV11LegacyChains[i];
+        for (version = chain->firstVersion; version <= 9; version++)
+        {
+            struct SaveBlock1 before;
+            Saved(version, chain->group, chain->num, chain->x, chain->y, DIR_NORTH);
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(sPending && sWarpRequests == 1);
+            assert(sSave.continueGameWarp.x == chain->toX && sSave.continueGameWarp.y == chain->toY);
+            Protected(&before); ArrivalFacing(chain->sameWorldTile ? DIR_NORTH : DIR_NONE); sCases++;
+        }
+    }
+}
+
+static void NoUnrelatedChanges(void)
+{
+    unsigned m, version;
+    // The gym rooms 3 (Old Station) and 16 (Wanhe Temple) reload at v12, tested there.
+    const u8 unaffected[] = {MAP_NUM(MAP_TAICHUNG_XITUN), 13, 17};
+    for (m = 0; m < sizeof(unaffected); m++)
+    {
+        struct SaveBlock1 before;
+        Saved(10, 43, unaffected[m], 12, 35, DIR_NORTH);
+        before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0);
+        Protected(&before); assert(TaichungSaveConsumeContinueFacing() == DIR_NONE); sCases++;
+    }
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+        for (m = 0; m < sizeof(sV11TruthMaps) / sizeof(sV11TruthMaps[0]); m++)
+        {
+            struct SaveBlock1 before;
+            Saved(version, sV11TruthMaps[m].group, sV11TruthMaps[m].num, 12, 35, DIR_WEST);
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(!sPending && sWarpRequests == 0 && sWrites == 0 && sCancels == 1);
+            assert(memcmp(&before, &sSave, sizeof(before)) == 0);
+            assert(TaichungSaveConsumeContinueFacing() == DIR_NONE); sCases++;
+        }
+    {
+        struct SaveBlock1 before;
+        Saved(10, 43, 0, 12, 35, DIR_NORTH); sSave.playerPartyCount = 0;
+        before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0 && sWrites == 0);
+        assert(memcmp(&before, &sSave, sizeof(before)) == 0); sCases++;
+        Saved(0, 0, 0, 1, 1, DIR_NORTH); sSave.vars[0xFC] = sSave.vars[0xFD] = 0;
+        before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0 && sWrites == 0);
+        assert(memcmp(&before, &sSave, sizeof(before)) == 0); sCases++;
+    }
+}
+
+int main(void)
+{
+    assert(TAICHUNG_SAVE_VERSION >= 11);
+    assert(sizeof(sV11TruthMaps) / sizeof(sV11TruthMaps[0]) == 5);
+    EveryV10Cell(); PendingTargets(); LegacyChains(); NoUnrelatedChanges();
+    printf("PASS: %u compiled native save-v11 cases; all five changed-bank maps, every cell/facing, exact-cell repairs, pending door/explicit priority, historical v10-before-v11 chains, protected save bytes, unchanged/current/future saves\n", sCases);
+    return 0;
+}
diff --git a/tests/taichung_save_v12_test.c b/tests/taichung_save_v12_test.c
new file mode 100644
index 0000000..a20d66a
--- /dev/null
+++ b/tests/taichung_save_v12_test.c
@@ -0,0 +1,166 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_save.h"
+#include "constants/maps.h"
+
+// Save v12: every gym moved into its own room (and Muqing's gym into Wanhe Temple),
+// so a save inside one of these eleven rooms reloads it on the middle exit mat.
+static const u16 sRooms[] = {
+    MAP_TAICHUNG_OLD_STATION_GYM, MAP_TAICHUNG_PARK_GYM, MAP_TAICHUNG_MIYAHARA_GYM,
+    MAP_TAICHUNG_SCIENCE_MUSEUM_GYM, MAP_TAICHUNG_GREENWAY_GYM, MAP_TAICHUNG_SHEN_JI_GYM,
+    MAP_TAICHUNG_FINE_ARTS_GYM, MAP_TAICHUNG_FENGJIA_GYM, MAP_TAICHUNG_THEATER_GYM,
+    MAP_TAICHUNG_WANHE_TEMPLE_HALL, MAP_TAICHUNG_MAPLE_GARDEN_GYM,
+};
+// Rooms and districts the gym move leaves alone.
+static const u16 sOthers[] = {
+    MAP_TAICHUNG_STATION_WELCOME, MAP_TAICHUNG_WENCHANG_TEMPLE_HALL, MAP_TAICHUNG_GUEST_HOUSE_1F,
+    MAP_TAICHUNG_GUEST_HOUSE_2F, MAP_TAICHUNG_OLD_CITY_NORTH,
+};
+#define COUNT(a) (sizeof(a) / sizeof((a)[0]))
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool8 sPending;
+static unsigned sWrites, sWarpRequests, sCancels, sCases;
+
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_SAVE_VERSION_VAR);
+    sSave.vars[id - VARS_START] = value;
+    sWrites++;
+    return TRUE;
+}
+bool32 UseContinueGameWarp(void) { return sPending; }
+void SetContinueGameWarpStatus(void) { sPending = TRUE; sWarpRequests++; }
+void TaichungGymCancelChallenge(void) { sCancels++; }
+
+static void Saved(u16 version, u16 map, s16 x, s16 y, u8 facing)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    sSave.playerPartyCount = 3;
+    sSave.vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START] = version;
+    sSave.vars[0xFC] = 133;
+    sSave.vars[0xFB] = 2;
+    sSave.location = (struct WarpData){MAP_GROUP(map), MAP_NUM(map), 2, 4, 7};
+    sSave.pos.x = x; sSave.pos.y = y;
+    sSave.continueGameWarp = (struct WarpData){42, 7, 1, 19, 21};
+    sSave.lastHealLocation = (struct WarpData){43, 8, -1, 17, 19};
+    memset(sSave.objectEvents, 0, sizeof(sSave.objectEvents));
+    sSave.objectEvents[0].active = TRUE;
+    sSave.objectEvents[0].isPlayer = TRUE;
+    sSave.objectEvents[0].facingDirection = facing;
+    sPending = FALSE;
+    sWrites = sWarpRequests = sCancels = 0;
+}
+
+// Only the version and the continue warp may change; party, bag, flags, map ID,
+// saved position and object cache stay byte for byte.
+static void Protected(const struct SaveBlock1 *before)
+{
+    struct SaveBlock1 expected = *before;
+    expected.vars[TAICHUNG_SAVE_VERSION_VAR - VARS_START] = TAICHUNG_SAVE_VERSION;
+    expected.continueGameWarp = sSave.continueGameWarp;
+    assert(sWrites == 1 && sCancels == 1);
+    assert(memcmp(&expected, &sSave, sizeof(expected)) == 0);
+}
+
+static void OnTheMat(u16 map)
+{
+    assert(sSave.continueGameWarp.mapGroup == MAP_GROUP(map) && sSave.continueGameWarp.mapNum == MAP_NUM(map));
+    assert(sSave.continueGameWarp.warpId == 1 && sSave.continueGameWarp.x == -1 && sSave.continueGameWarp.y == -1);
+    // Arriving through warp 1 uses the native door arrival, not the stale saved facing.
+    assert(TaichungSaveConsumeContinueFacing() == DIR_NONE);
+}
+
+static void SavedInsideARoom(void)
+{
+    static const s16 spots[][2] = {{3, 9}, {6, 5}, {12, 35}, {0, 0}};
+    unsigned r, version, s, dir;
+    for (r = 0; r < COUNT(sRooms); r++)
+        for (version = 1; version < 12; version++)
+            for (s = 0; s < COUNT(spots); s++)
+                for (dir = DIR_SOUTH; dir <= DIR_EAST; dir++)
+                {
+                    struct SaveBlock1 before;
+                    Saved(version, sRooms[r], spots[s][0], spots[s][1], dir);
+                    before = sSave; TaichungSaveUpgradeOnContinue();
+                    assert(sPending && sWarpRequests == 1);
+                    OnTheMat(sRooms[r]); Protected(&before); sCases++;
+                }
+}
+
+static void PendingReturns(void)
+{
+    unsigned r, version;
+    s8 door;
+    for (r = 0; r < COUNT(sRooms); r++)
+        for (version = 8; version < 12; version++)
+        {
+            struct SaveBlock1 before;
+            // An explicit pending target inside a room is stale: it lands on the mat.
+            Saved(version, MAP_TAICHUNG_OLD_CITY, 30, 66, DIR_NORTH);
+            sPending = TRUE;
+            sSave.continueGameWarp = (struct WarpData){MAP_GROUP(sRooms[r]), MAP_NUM(sRooms[r]), -1, 6, 5};
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(sPending && sWarpRequests == 0);
+            OnTheMat(sRooms[r]); Protected(&before); sCases++;
+            // A native door/return keeps its own arrival.
+            for (door = 0; door < 3; door++)
+            {
+                struct WarpData kept;
+                Saved(version, MAP_TAICHUNG_OLD_CITY, 30, 66, DIR_NORTH);
+                sPending = TRUE;
+                sSave.continueGameWarp = (struct WarpData){MAP_GROUP(sRooms[r]), MAP_NUM(sRooms[r]), door, -1, -1};
+                kept = sSave.continueGameWarp; before = sSave;
+                TaichungSaveUpgradeOnContinue();
+                assert(sPending && sWarpRequests == 0);
+                assert(memcmp(&kept, &sSave.continueGameWarp, sizeof(kept)) == 0);
+                Protected(&before); sCases++;
+            }
+        }
+}
+
+static void Untouched(void)
+{
+    unsigned r, version;
+    // Other rooms and a v11 save in the open city only take the version.
+    for (r = 0; r < COUNT(sOthers); r++)
+    {
+        struct SaveBlock1 before;
+        Saved(11, sOthers[r], 3, 9, DIR_WEST);
+        before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0);
+        Protected(&before); assert(TaichungSaveConsumeContinueFacing() == DIR_NONE); sCases++;
+    }
+    // Current and future saves inside a room are never touched.
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+        for (r = 0; r < COUNT(sRooms); r++)
+        {
+            struct SaveBlock1 before;
+            Saved(version, sRooms[r], 3, 9, DIR_WEST);
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(!sPending && sWarpRequests == 0 && sWrites == 0 && sCancels == 1);
+            assert(memcmp(&before, &sSave, sizeof(before)) == 0);
+            assert(TaichungSaveConsumeContinueFacing() == DIR_NONE); sCases++;
+        }
+    // No party: a fresh or untouched FireRed save is left alone.
+    {
+        struct SaveBlock1 before;
+        Saved(11, MAP_TAICHUNG_THEATER_GYM, 3, 9, DIR_WEST); sSave.playerPartyCount = 0;
+        before = sSave; TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0 && sWrites == 0);
+        assert(memcmp(&before, &sSave, sizeof(before)) == 0); sCases++;
+    }
+}
+
+int main(void)
+{
+    assert(TAICHUNG_SAVE_VERSION == 12);
+    SavedInsideARoom(); PendingReturns(); Untouched();
+    printf("PASS: %u compiled native save-v12 cases; all eleven gym rooms from v1-v11 reload on the exit mat (warp 1) "
+           "with no stale facing, pending explicit targets repaired, native door returns kept, other rooms/city only versioned, "
+           "current/future/no-party saves untouched, protected save bytes\n", sCases);
+    return 0;
+}
diff --git a/tests/taichung_starter_test.c b/tests/taichung_starter_test.c
new file mode 100644
index 0000000..8eecfaf
--- /dev/null
+++ b/tests/taichung_starter_test.c
@@ -0,0 +1,212 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "pokemon.h"
+#include "taichung_starter.h"
+#include "taichung_team.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+
+static struct SaveBlock1 sSave;
+static struct SaveBlock2 sSave2;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct SaveBlock2 *gSaveBlock2Ptr = &sSave2;
+struct Main gMain;
+struct Pokemon gPlayerParty[6];
+u8 gPlayerPartyCount;
+u16 gSpecialVar_0x8004, gSpecialVar_Result;
+
+static unsigned sCreates, sHistoricalReads;
+static bool8 sFailCreation;
+static u16 sReplaySpecies;
+
+// The party operation has its own production-module tests. This stand-in only
+// exposes whether this helper calls it before/after committing the marker.
+bool8 TaichungTeamSetSlot(u8 slot, u16 species)
+{
+    assert(slot == 0);
+    assert(gPlayerPartyCount == 0);
+    assert(sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] == 0);
+    sCreates++;
+    if (sFailCreation)
+        return FALSE;
+    gPlayerParty[0].species = species;
+    gPlayerPartyCount = 1;
+    return TRUE;
+}
+
+// Mimic the engine's harmful historical read. Every tested path must avoid it.
+u16 VarGet(u16 id)
+{
+    assert(id == TAICHUNG_STARTER_SPECIES_VAR);
+    sHistoricalReads++;
+    sSave.vars[id - VARS_START] = sReplaySpecies;
+    return sReplaySpecies;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    memset(&sSave2, 0xB3, sizeof(sSave2));
+    memset(gPlayerParty, 0, sizeof(gPlayerParty));
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = 0;
+    gSaveBlock1Ptr = &sSave;
+    gSaveBlock2Ptr = &sSave2;
+    gPlayerPartyCount = 0;
+    gMain.inBattle = FALSE;
+    sCreates = sHistoricalReads = 0;
+    sFailCreation = FALSE;
+    sReplaySpecies = 0;
+    gSpecialVar_0x8004 = 0;
+    gSpecialVar_Result = 0xCAFE;
+}
+
+static void AssertOnlyMarkerChanged(const struct SaveBlock1 *before, u16 marker,
+                                  const struct SaveBlock2 *before2)
+{
+    struct SaveBlock1 expected = *before;
+    expected.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = marker;
+    assert(memcmp(&sSave, &expected, sizeof(sSave)) == 0);
+    assert(memcmp(&sSave2, before2, sizeof(sSave2)) == 0);
+    assert(sHistoricalReads == 0);
+}
+
+static void TestAllChoicesAndDuplicate(void)
+{
+    static const u16 choices[] = {SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU};
+    unsigned i;
+    for (i = 0; i < sizeof(choices) / sizeof(choices[0]); i++)
+    {
+        struct SaveBlock1 before;
+        struct SaveBlock2 before2;
+        struct Pokemon granted;
+        Reset();
+        before = sSave;
+        before2 = sSave2;
+        assert(!TaichungStarterHasPartner());
+        assert(TaichungStarterTryGrant(choices[i]) == TAICHUNG_STARTER_RESULT_GRANTED);
+        assert(sCreates == 1 && gPlayerPartyCount == 1);
+        assert(gPlayerParty[0].species == choices[i]);
+        assert(TaichungStarterHasPartner());
+        AssertOnlyMarkerChanged(&before, choices[i], &before2);
+        granted = gPlayerParty[0];
+        assert(TaichungStarterTryGrant(choices[(i + 1) % 4]) == TAICHUNG_STARTER_RESULT_ALREADY);
+        assert(sCreates == 1 && gPlayerPartyCount == 1);
+        assert(memcmp(&granted, &gPlayerParty[0], sizeof(granted)) == 0);
+        AssertOnlyMarkerChanged(&before, choices[i], &before2);
+    }
+}
+
+static void TestInvalidAndFailedCreation(void)
+{
+    static const u16 invalid[] = {0, 2, 3, 5, 6, 8, 26, 150, 151, 0xFFFF};
+    unsigned i;
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    Reset();
+    before = sSave;
+    before2 = sSave2;
+    for (i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++)
+        assert(TaichungStarterTryGrant(invalid[i]) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+
+    sFailCreation = TRUE;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 1 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+    sFailCreation = FALSE;
+    assert(TaichungStarterTryGrant(SPECIES_SQUIRTLE) == TAICHUNG_STARTER_RESULT_GRANTED);
+    assert(sCreates == 2 && gPlayerPartyCount == 1);
+    AssertOnlyMarkerChanged(&before, SPECIES_SQUIRTLE, &before2);
+}
+
+static void TestExistingPartyAndRawMarker(void)
+{
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    struct Pokemon beforeParty[6];
+    Reset();
+    gPlayerParty[0].species = SPECIES_SNORLAX;
+    gPlayerPartyCount = 1;
+    before = sSave;
+    before2 = sSave2;
+    memcpy(beforeParty, gPlayerParty, sizeof(beforeParty));
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_BULBASAUR) == TAICHUNG_STARTER_RESULT_ALREADY);
+    assert(sCreates == 0);
+    assert(memcmp(beforeParty, gPlayerParty, sizeof(beforeParty)) == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2); // Do not infer a legacy marker.
+
+    Reset();
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = SPECIES_PIKACHU;
+    sReplaySpecies = 0;
+    before = sSave;
+    before2 = sSave2;
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_ALREADY);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, SPECIES_PIKACHU, &before2);
+
+    Reset();
+    sReplaySpecies = SPECIES_PIKACHU; // Historical marker must not suppress a new grant.
+    before = sSave;
+    before2 = sSave2;
+    assert(!TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_BULBASAUR) == TAICHUNG_STARTER_RESULT_GRANTED);
+    AssertOnlyMarkerChanged(&before, SPECIES_BULBASAUR, &before2);
+
+    Reset();
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = 0xFFFF;
+    before = sSave;
+    before2 = sSave2;
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_PIKACHU) == TAICHUNG_STARTER_RESULT_ALREADY);
+    AssertOnlyMarkerChanged(&before, 0xFFFF, &before2);
+}
+
+static void TestUnavailableContextAndWrappers(void)
+{
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    Reset();
+    before = sSave;
+    before2 = sSave2;
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    gSaveBlock1Ptr = &sSave;
+    gSaveBlock2Ptr = NULL;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    gSaveBlock2Ptr = &sSave2;
+    gMain.inBattle = TRUE;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+
+    gMain.inBattle = FALSE;
+    TaichungStarter_ScriptHasPartner();
+    assert(gSpecialVar_Result == FALSE);
+    gSpecialVar_0x8004 = SPECIES_PIKACHU;
+    TaichungStarter_ScriptGrant();
+    assert(gSpecialVar_Result == TAICHUNG_STARTER_RESULT_GRANTED);
+    assert(gSpecialVar_0x8004 == SPECIES_PIKACHU);
+    gSpecialVar_0x8004 = SPECIES_SQUIRTLE;
+    TaichungStarter_ScriptGrant();
+    assert(gSpecialVar_Result == TAICHUNG_STARTER_RESULT_ALREADY);
+    TaichungStarter_ScriptHasPartner();
+    assert(gSpecialVar_Result == TRUE);
+    assert(gPlayerPartyCount == 1 && gPlayerParty[0].species == SPECIES_PIKACHU && sCreates == 1);
+    AssertOnlyMarkerChanged(&before, SPECIES_PIKACHU, &before2);
+}
+
+int main(void)
+{
+    TestAllChoicesAndDuplicate();
+    TestInvalidAndFailedCreation();
+    TestExistingPartyAndRawMarker();
+    TestUnavailableContextAndWrappers();
+    puts("PASS: four one-time starter grants; duplicate/existing-party/raw-marker guards; failure/context checks; protected fields retained.");
+    return 0;
+}
diff --git a/tests/taichung_team_test.c b/tests/taichung_team_test.c
new file mode 100644
index 0000000..8c8f1c6
--- /dev/null
+++ b/tests/taichung_team_test.c
@@ -0,0 +1,484 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "main.h"
+#include "pokemon.h"
+#include "pokedex.h"
+#include "taichung_team.h"
+#include "taichung_team_presets.h"
+#include "constants/items.h"
+#include "constants/maps.h"
+#include "constants/moves.h"
+#include "constants/trainers.h"
+
+static struct SaveBlock1 sSave, sProtectedSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct Main gMain;
+struct Pokemon gPlayerParty[PARTY_SIZE];
+u8 gPlayerPartyCount;
+
+// Different growth tables catch a level field write or a fixed EXP shortcut.
+const struct SpeciesInfo gSpeciesInfo[NUM_SPECIES] = {
+    [SPECIES_CHARIZARD] = {1},
+    [SPECIES_MEWTWO] = {1}
+};
+const u32 gExperienceTables[2][MAX_LEVEL + 1] = {
+    {[5] = 125, [50] = 125000, [80] = 512000},
+    {[5] = 156, [50] = 156250, [80] = 640000}
+};
+
+static unsigned sCreates, sRecalculations, sPresets, sHeals, sDexWrites, sPPRestores;
+static bool8 sSeen[151], sCaught[151];
+
+u32 GetMonData(struct Pokemon *mon, s32 field, ...)
+{
+    assert(mon != NULL);
+    switch (field)
+    {
+    case MON_DATA_MOVE1: case MON_DATA_MOVE2: case MON_DATA_MOVE3: case MON_DATA_MOVE4:
+        return mon->moves[field - MON_DATA_MOVE1];
+    case MON_DATA_SPECIES: return mon->species;
+    case MON_DATA_HELD_ITEM: return mon->heldItem;
+    case MON_DATA_MAIL: return mon->mail;
+    case MON_DATA_IS_EGG: return mon->isEgg;
+    case MON_DATA_LEVEL: return mon->level;
+    case MON_DATA_EXP: return mon->exp;
+    case MON_DATA_HP: return mon->hp;
+    case MON_DATA_MAX_HP: return mon->maxHp;
+    case MON_DATA_STATUS: return mon->status;
+    default: assert(!"Unexpected engine read"); return 0;
+    }
+}
+
+void SetMonData(struct Pokemon *mon, s32 field, const void *value)
+{
+    assert(mon != NULL && value != NULL);
+    switch (field)
+    {
+    case MON_DATA_EXP: memcpy(&mon->exp, value, sizeof(mon->exp)); break;
+    case MON_DATA_HELD_ITEM: memcpy(&mon->heldItem, value, sizeof(mon->heldItem)); break;
+    case MON_DATA_MAIL: memcpy(&mon->mail, value, sizeof(mon->mail)); break;
+    case MON_DATA_HP: memcpy(&mon->hp, value, sizeof(mon->hp)); break;
+    case MON_DATA_STATUS: memcpy(&mon->status, value, sizeof(mon->status)); break;
+    default: assert(!"Unexpected engine write");
+    }
+}
+
+u8 CalculatePlayerPartyCount(void)
+{
+    gPlayerPartyCount = 0;
+    while (gPlayerPartyCount < PARTY_SIZE && gPlayerParty[gPlayerPartyCount].species != SPECIES_NONE)
+        gPlayerPartyCount++;
+    return gPlayerPartyCount;
+}
+
+void CalculateMonStats(struct Pokemon *mon)
+{
+    u16 oldMax = mon->maxHp;
+    assert(mon->exp == gExperienceTables[gSpeciesInfo[mon->species].growthRate][50]);
+    sRecalculations++;
+    mon->level = 50;
+    mon->maxHp = 150;
+    // Model FireRed's documented max-HP delta, including downward underflow.
+    // Production preparation must restore a valid HP after calling the engine.
+    mon->hp = (u16)(mon->hp + mon->maxHp - oldMax);
+}
+
+void CreateMon(struct Pokemon *mon, u16 species, u8 level, u8 fixedIV,
+               u8 hasFixedPersonality, u32 fixedPersonality, u8 otIdType,
+               u32 fixedOtId)
+{
+    (void)hasFixedPersonality;
+    (void)fixedPersonality;
+    (void)fixedOtId;
+    assert(otIdType == OT_ID_PLAYER_ID);
+    sCreates++;
+    memset(mon, 0, sizeof(*mon));
+    mon->species = species;
+    mon->level = level;
+    mon->exp = gExperienceTables[gSpeciesInfo[species].growthRate][level];
+    mon->hp = mon->maxHp = 150;
+    mon->mail = MAIL_NONE;
+    mon->identity.personality = 0x12345600 + sCreates;
+    mon->identity.otId = 0x54657374;
+    memset(mon->identity.ivs, fixedIV, sizeof(mon->identity.ivs));
+}
+
+bool8 TaichungTeamSpeciesAllowed(u16 species)
+{
+    return species >= SPECIES_BULBASAUR && species <= SPECIES_MEWTWO;
+}
+
+const u16 *TaichungTeamGetPresetMoves(u16 species)
+{
+    static const u16 moves[MAX_MON_MOVES] = {10, 20, 30, 0};
+    return TaichungTeamSpeciesAllowed(species) ? moves : NULL;
+}
+
+void TaichungTeamApplyPreset(struct Pokemon *mon)
+{
+    static const u16 moves[MAX_MON_MOVES] = {10, 20, 30, 0};
+    static const u8 pp[MAX_MON_MOVES] = {35, 15, 10, 0};
+    sPresets++;
+    memcpy(mon->moves, moves, sizeof(moves));
+    memcpy(mon->pp, pp, sizeof(pp));
+}
+
+void MonRestorePP(struct Pokemon *mon)
+{
+    unsigned i;
+    sPPRestores++;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        // Native base PP for the deliberately authored test set. Production
+        // MonRestorePP also honors PP Ups; trainer creation starts with none.
+        switch (mon->moves[i])
+        {
+        case MOVE_QUICK_ATTACK: mon->pp[i] = 30; break;
+        case MOVE_THUNDER_WAVE: mon->pp[i] = 20; break;
+        case MOVE_DOUBLE_TEAM: mon->pp[i] = 15; break;
+        case MOVE_LIGHT_SCREEN: mon->pp[i] = 30; break;
+        default: assert(!"Unexpected authored test move");
+        }
+    }
+}
+
+bool8 GetSetPokedexFlag(u16 species, u8 action)
+{
+    assert(species >= 1 && species <= 150);
+    assert(action == FLAG_SET_SEEN || action == FLAG_SET_CAUGHT);
+    sDexWrites++;
+    if (action == FLAG_SET_SEEN)
+        sSeen[species] = TRUE;
+    else
+        sCaught[species] = TRUE;
+    return TRUE;
+}
+
+void HealPlayerParty(void)
+{
+    unsigned i;
+    sHeals++;
+    for (i = 0; i < gPlayerPartyCount; i++)
+    {
+        gPlayerParty[i].hp = gPlayerParty[i].maxHp;
+        gPlayerParty[i].status = 0;
+        memset(gPlayerParty[i].pp, 10, sizeof(gPlayerParty[i].pp));
+    }
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.x = 30;
+    sSave.location.y = 66;
+    sSave.vars[0x40F7 - VARS_START] = 1;
+    sSave.vars[0x40F8 - VARS_START] = 1;
+    sSave.vars[0x40F9 - VARS_START] = 3;
+    sSave.vars[0x40FA - VARS_START] = 0x155;
+    sSave.vars[0x40FB - VARS_START] = 2;
+    sSave.vars[0x40FC - VARS_START] = SPECIES_PIKACHU;
+    sSave.vars[0x40FD - VARS_START] = 3;
+    sProtectedSave = sSave;
+    gSaveBlock1Ptr = &sSave;
+    memset(gPlayerParty, 0, sizeof(gPlayerParty));
+    memset(&gMain, 0, sizeof(gMain));
+    memset(sSeen, 0, sizeof(sSeen));
+    memset(sCaught, 0, sizeof(sCaught));
+    gPlayerPartyCount = 0;
+    sCreates = sRecalculations = sPresets = sHeals = sDexWrites = sPPRestores = 0;
+}
+
+static void AssertProtectedSave(void)
+{
+    // Includes every variable, in particular 40F7–40FD, and field position.
+    assert(memcmp(&sSave, &sProtectedSave, sizeof(sSave)) == 0);
+}
+
+static struct Pokemon OldPartner(u16 species, u8 level)
+{
+    struct Pokemon mon;
+    memset(&mon, 0x6C, sizeof(mon));
+    mon.species = species;
+    mon.level = level;
+    mon.exp = gExperienceTables[gSpeciesInfo[species].growthRate][level];
+    mon.hp = 1;
+    mon.maxHp = level == 80 ? 300 : 20;
+    mon.status = 0x40;
+    mon.heldItem = ITEM_ORAN_BERRY;
+    mon.mail = 3;
+    mon.isEgg = FALSE;
+    return mon;
+}
+
+static void TestInvalidChoices(void)
+{
+    struct Pokemon original[PARTY_SIZE];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_PIKACHU, 5);
+    memcpy(original, gPlayerParty, sizeof(original));
+    assert(!TaichungTeamSetSlot(2, SPECIES_CHARIZARD)); // Cannot make a gap.
+    assert(!TaichungTeamSetSlot(PARTY_SIZE, SPECIES_CHARIZARD));
+    assert(!TaichungTeamSetSlot(255, SPECIES_CHARIZARD));
+    assert(!TaichungTeamSetSlot(0, SPECIES_NONE));
+    assert(!TaichungTeamSetSlot(0, SPECIES_MEW));
+    assert(!TaichungTeamSetSlot(0, SPECIES_TREECKO));
+    gMain.inBattle = TRUE;
+    assert(!TaichungTeamSetSlot(0, SPECIES_CHARIZARD));
+    assert(!TaichungTeamSetSlot(1, SPECIES_CHARIZARD));
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(gPlayerPartyCount == 1);
+    assert(sCreates == 0 && sPresets == 0 && sDexWrites == 0);
+    AssertProtectedSave();
+}
+
+static void TestSixSlotsAndReplacement(void)
+{
+    static const u16 choices[PARTY_SIZE] = {
+        SPECIES_BULBASAUR, SPECIES_CHARIZARD, SPECIES_PIKACHU,
+        SPECIES_ALAKAZAM, SPECIES_GYARADOS, SPECIES_DRAGONITE
+    };
+    struct Pokemon original[PARTY_SIZE];
+    unsigned i;
+    Reset();
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        memcpy(original, gPlayerParty, sizeof(original));
+        assert(TaichungTeamSetSlot((u8)i, choices[i]));
+        assert(gPlayerPartyCount == i + 1);
+        assert(memcmp(gPlayerParty, original, i * sizeof(struct Pokemon)) == 0);
+        assert(gPlayerParty[i].species == choices[i]);
+        assert(gPlayerParty[i].level == 50);
+        assert(gPlayerParty[i].hp == gPlayerParty[i].maxHp);
+        assert(gPlayerParty[i].heldItem == ITEM_NONE && gPlayerParty[i].mail == MAIL_NONE);
+        assert(gPlayerParty[i].moves[0] == 10 && gPlayerParty[i].pp[0] == 35);
+        assert(sSeen[choices[i]] && sCaught[choices[i]]);
+    }
+    memcpy(original, gPlayerParty, sizeof(original));
+    assert(!TaichungTeamSetSlot(PARTY_SIZE, SPECIES_MEWTWO));
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    gPlayerParty[2].heldItem = ITEM_ORANGE_MAIL;
+    gPlayerParty[2].mail = 4;
+    memcpy(original, gPlayerParty, sizeof(original));
+    assert(TaichungTeamSetSlot(2, SPECIES_MEWTWO));
+    assert(gPlayerPartyCount == PARTY_SIZE);
+    assert(gPlayerParty[2].species == SPECIES_MEWTWO && gPlayerParty[2].level == 50);
+    assert(gPlayerParty[2].heldItem == ITEM_ORANGE_MAIL && gPlayerParty[2].mail == 4);
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (i != 2)
+            assert(memcmp(&gPlayerParty[i], &original[i], sizeof(original[i])) == 0);
+    assert(sCreates == 7 && sPresets == 7 && sDexWrites == 14);
+    AssertProtectedSave();
+}
+
+static void TestPrepareExistingMon(void)
+{
+    struct Pokemon mon, original;
+    Reset();
+    mon = OldPartner(SPECIES_CHARIZARD, 80);
+    original = mon;
+    TaichungTeamPrepareMon(&mon);
+    assert(mon.exp == gExperienceTables[1][50] && mon.level == 50);
+    assert(mon.hp == 150 && mon.hp == mon.maxHp && mon.status == 0);
+    assert(mon.heldItem == original.heldItem && mon.mail == original.mail && mon.species == original.species);
+    assert(memcmp(&mon.identity, &original.identity, sizeof(mon.identity)) == 0);
+    assert(mon.moves[0] == 10 && mon.pp[0] == 35);
+    assert(sCreates == 0 && sRecalculations == 1 && sPresets == 1);
+    mon = OldPartner(SPECIES_MEW, 80);
+    original = mon;
+    TaichungTeamPrepareMon(&mon);
+    assert(memcmp(&mon, &original, sizeof(mon)) == 0);
+    mon = OldPartner(SPECIES_BULBASAUR, 5);
+    mon.isEgg = TRUE;
+    original = mon;
+    TaichungTeamPrepareMon(&mon);
+    assert(memcmp(&mon, &original, sizeof(mon)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1);
+    AssertProtectedSave();
+}
+
+static void TestPrepareParty(void)
+{
+    struct MonIdentity original[2];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_BULBASAUR, 5);
+    gPlayerParty[1] = OldPartner(SPECIES_CHARIZARD, 80);
+    original[0] = gPlayerParty[0].identity;
+    original[1] = gPlayerParty[1].identity;
+    TaichungTeamPrepareParty();
+    assert(gPlayerPartyCount == 2);
+    assert(sRecalculations == 2 && sPresets == 2 && sHeals == 1);
+    assert(gPlayerParty[0].exp == gExperienceTables[0][50]);
+    assert(gPlayerParty[1].exp == gExperienceTables[1][50]);
+    assert(gPlayerParty[0].hp == gPlayerParty[0].maxHp && gPlayerParty[1].hp == gPlayerParty[1].maxHp);
+    assert(gPlayerParty[0].status == 0 && gPlayerParty[1].status == 0);
+    assert(memcmp(&gPlayerParty[0].identity, &original[0], sizeof(original[0])) == 0);
+    assert(memcmp(&gPlayerParty[1].identity, &original[1], sizeof(original[1])) == 0);
+    assert(gPlayerParty[0].heldItem == ITEM_ORAN_BERRY && gPlayerParty[1].mail == 3);
+    AssertProtectedSave();
+}
+
+static void TestPrepareSixPartners(void)
+{
+    static const u16 species[PARTY_SIZE] = {
+        SPECIES_BULBASAUR, SPECIES_CHARIZARD, SPECIES_PIKACHU,
+        SPECIES_ALAKAZAM, SPECIES_GYARADOS, SPECIES_MEWTWO
+    };
+    struct Pokemon before[PARTY_SIZE];
+    unsigned slot, move;
+    Reset();
+    for (slot = 0; slot < PARTY_SIZE; slot++)
+    {
+        gPlayerParty[slot] = OldPartner(species[slot], slot & 1 ? 80 : 5);
+        gPlayerParty[slot].identity.personality += slot;
+        gPlayerParty[slot].hp = slot & 1 ? 1 : 0;
+        gPlayerParty[slot].mail = slot;
+        memset(gPlayerParty[slot].pp, 0, MAX_MON_MOVES);
+    }
+    memcpy(before, gPlayerParty, sizeof(before));
+    TaichungTeamPrepareParty();
+    assert(gPlayerPartyCount == PARTY_SIZE);
+    assert(sRecalculations == PARTY_SIZE && sPresets == PARTY_SIZE && sHeals == 1);
+    assert(sCreates == 0 && sDexWrites == 0);
+    for (slot = 0; slot < PARTY_SIZE; slot++)
+    {
+        struct Pokemon *mon = &gPlayerParty[slot];
+        assert(mon->species == species[slot] && mon->level == 50);
+        assert(mon->exp == gExperienceTables[gSpeciesInfo[species[slot]].growthRate][50]);
+        assert(mon->hp == mon->maxHp && mon->status == 0);
+        for (move = 0; move < MAX_MON_MOVES; move++) assert(mon->pp[move] == 10);
+        assert(memcmp(&mon->identity, &before[slot].identity, sizeof(mon->identity)) == 0);
+        assert(mon->heldItem == before[slot].heldItem && mon->mail == before[slot].mail);
+    }
+    AssertProtectedSave();
+}
+
+static void TestPrepareTrainerMoves(void)
+{
+    // Pikachu can use all four, and this set deliberately differs from the
+    // shared preset stand-in. No PP, level or identity is inherited by chance.
+    static const u16 authoredMoves[MAX_MON_MOVES] = {
+        MOVE_QUICK_ATTACK, MOVE_THUNDER_WAVE, MOVE_DOUBLE_TEAM, MOVE_LIGHT_SCREEN
+    };
+    static const u8 authoredPP[MAX_MON_MOVES] = {30, 20, 15, 30};
+    static const u16 presetMoves[MAX_MON_MOVES] = {10, 20, 30, 0};
+    static const u8 presetPP[MAX_MON_MOVES] = {35, 15, 10, 0};
+    u8 flags;
+    for (flags = 0; flags <= (F_TRAINER_PARTY_CUSTOM_MOVESET | F_TRAINER_PARTY_HELD_ITEM); flags++)
+    {
+        struct Pokemon mon, original;
+        Reset();
+        mon = OldPartner(SPECIES_PIKACHU, 80);
+        memset(mon.identity.ivs, 31, sizeof(mon.identity.ivs));
+        memset(mon.identity.evs, 0, sizeof(mon.identity.evs));
+        mon.heldItem = ITEM_ORANGE_MAIL;
+        memcpy(mon.moves, authoredMoves, sizeof(authoredMoves));
+        memset(mon.pp, 0, sizeof(mon.pp));
+        original = mon;
+
+        TaichungTeamPrepareTrainerMon(&mon, flags);
+        assert(mon.exp == gExperienceTables[0][50] && mon.level == 50);
+        assert(mon.hp == 150 && mon.hp == mon.maxHp && mon.status == 0);
+        assert(memcmp(&mon.identity, &original.identity, sizeof(mon.identity)) == 0);
+        assert(mon.heldItem == ITEM_ORANGE_MAIL && mon.mail == original.mail && mon.species == original.species);
+        assert(sCreates == 0 && sRecalculations == 1 && sHeals == 0 && sDexWrites == 0);
+        if (flags & F_TRAINER_PARTY_CUSTOM_MOVESET)
+        {
+            assert(memcmp(mon.moves, authoredMoves, sizeof(authoredMoves)) == 0);
+            assert(memcmp(mon.pp, authoredPP, sizeof(authoredPP)) == 0);
+            assert(sPresets == 0 && sPPRestores == 1);
+        }
+        else
+        {
+            assert(memcmp(mon.moves, presetMoves, sizeof(presetMoves)) == 0);
+            assert(memcmp(mon.pp, presetPP, sizeof(presetPP)) == 0);
+            assert(sPresets == 1 && sPPRestores == 0);
+        }
+        AssertProtectedSave();
+    }
+}
+
+static void TestEnsureLevelPreservesExplorationDamage(void)
+{
+    struct Pokemon original[PARTY_SIZE];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_PIKACHU, 50);
+    memcpy(gPlayerParty[0].moves, TaichungTeamGetPresetMoves(SPECIES_PIKACHU), sizeof(gPlayerParty[0].moves));
+    gPlayerParty[1] = OldPartner(SPECIES_BULBASAUR, 5);
+    memcpy(original, gPlayerParty, sizeof(original));
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(sRecalculations == 0 && sPresets == 0 && sHeals == 0);
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungTeamNoGrindActive());
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    gSaveBlock1Ptr = &sSave;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(&gPlayerParty[0], &original[0], sizeof(original[0])) == 0);
+    assert(gPlayerParty[1].level == 50 && gPlayerParty[1].hp == gPlayerParty[1].maxHp);
+    assert(gPlayerParty[1].exp == gExperienceTables[0][50]);
+    assert(memcmp(&gPlayerParty[1].identity, &original[1].identity, sizeof(original[1].identity)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1 && sHeals == 0);
+    memcpy(original, gPlayerParty, sizeof(original));
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1 && sHeals == 0);
+    AssertProtectedSave();
+}
+
+static void TestPresetRefreshWithoutHealing(void)
+{
+    struct Pokemon before, refreshed;
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_VENUSAUR, 50);
+    before = gPlayerParty[0];
+    gMain.inBattle = TRUE;
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    gMain.inBattle = FALSE;
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    TaichungTeamSyncPresetMoves();
+    assert(sPresets == 1 && sHeals == 0 && sRecalculations == 0);
+    refreshed = gPlayerParty[0];
+    assert(refreshed.hp == before.hp && refreshed.status == before.status);
+    assert(refreshed.exp == before.exp && refreshed.heldItem == before.heldItem && refreshed.mail == before.mail);
+    assert(memcmp(&refreshed.identity, &before.identity, sizeof(before.identity)) == 0);
+    gPlayerParty[0].pp[0] = 1;
+    TaichungTeamSyncPresetMoves();
+    TaichungTeamEnsurePartyLevel();
+    assert(gPlayerParty[0].pp[0] == 1 && sPresets == 1);
+    gPlayerParty[0] = OldPartner(SPECIES_BULBASAUR, 50);
+    gPlayerParty[0].isEgg = TRUE;
+    before = gPlayerParty[0];
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    gPlayerParty[0] = OldPartner(SPECIES_MEW, 50);
+    before = gPlayerParty[0];
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    assert(sPresets == 1);
+    AssertProtectedSave();
+}
+
+int main(void)
+{
+    TestPresetRefreshWithoutHealing();
+    TestInvalidChoices();
+    TestSixSlotsAndReplacement();
+    TestPrepareExistingMon();
+    TestPrepareParty();
+    TestPrepareSixPartners();
+    TestPrepareTrainerMoves();
+    TestEnsureLevelPreservesExplorationDamage();
+    puts("PASS: native team slot/capacity/battle guards, evolved choices, six-partner preparation, held mail, EXP-derived level 50, identity retention, high-level HP recovery, authored trainer moves/full PP versus default presets, eggs/roster bounds, city-only upgrade, no exploration refill and protected save fields.");
+    return 0;
+}
