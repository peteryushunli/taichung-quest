+        sizes = {"LAYOUT_TAICHUNG_GREENWAY": (self.gw.w, self.gw.h), "LAYOUT_TAICHUNG_OLD_CITY": (self.oc.w, self.oc.h - self.oc.split)}
+        for layout in layouts["layouts"]:
+            if layout.get("id") in sizes:
+                layout["width"], layout["height"] = sizes[layout["id"]]
+        layouts["layouts"].append({"id": "LAYOUT_TAICHUNG_OLD_CITY_NORTH", "name": "TaichungOldCityNorth_Layout",
+                                   "width": self.oc.w, "height": self.oc.split, "border_width": 2, "border_height": 2,
+                                   "primary_tileset": "gTileset_TaichungOldCorePrimary",
+                                   "secondary_tileset": "gTileset_TaichungOldCityNorth",
+                                   "border_filepath": "data/layouts/TaichungOldCityNorth/border.bin",
+                                   "blockdata_filepath": "data/layouts/TaichungOldCityNorth/map.bin"})
+        self.put_json("data/layouts/layouts.json", layouts)
+        groups = self.base_json("data/maps/map_groups.json")
+        groups["gMapGroup_Taichung"].append("TaichungOldCityNorth")
+        self.put_json("data/maps/map_groups.json", groups)
+        # Park tall grass, in the Greenway and Taichung Park alike: rate 12, levels 2-5.
+        park = {"encounter_rate": 12, "mons": [{"min_level": lo, "max_level": hi, "species": f"SPECIES_{s}"}
+                                               for (lo, hi), s in zip(GREENWAY_LEVELS, ("PIDGEY", "RATTATA") * 6)]}
+        encounters = self.base_json("src/data/wild_encounters.json")
+        old_city = next(e for g in encounters["wild_encounter_groups"] for e in g["encounters"] if e["map"] == "MAP_TAICHUNG_OLD_CITY")
+        encounters = put_encounter(encounters, "MAP_TAICHUNG_OLD_CITY", {**old_city, "land_mons": copy.deepcopy(park)})
+        encounters = put_encounter(encounters, "MAP_TAICHUNG_GREENWAY", {"map": "MAP_TAICHUNG_GREENWAY", "base_label": "sTaichungGreenway",
+                                                                         "land_mons": copy.deepcopy(park)})
+        self.put_json("src/data/wild_encounters.json", encounters)
+        self.scripts()
+        self.tileset_declarations()
+        self.contract(maps)
+        self.save_moves(maps)
+        self.record()
+
+    def save_moves(self, maps):
+        """For save v9 (Main's): each map's shift, the events that moved beyond it, and every cell
+        a player can stand on today that this build blocks, each with the nearest cell to put them
+        on: open, not tall grass, no object event on it, and reachable from the map's first door
+        (Manhattan distance, then row, then column)."""
+        shifts = {"TaichungGreenway": (self.gw.shift[0], self.gw.shift[1]), "TaichungOldCity": (0, 0)}
+        out = {"note": "For save v9. Coordinates are map-local. 'blocked': cells open in today's map whose shifted cell "
+                       "this build blocks or cuts off, each with the nearest reachable open cell that is not tall grass "
+                       "('to', new map). 'movedBeyondShift': events whose new cell is not today's plus the shift.",
+               "maps": {}}
+        layouts = {l["id"]: l for l in self.base_json("data/layouts/layouts.json")["layouts"] if "id" in l}
+        for name, (dx, dy) in shifts.items():
+            spec = MAPS[name]
+            old_w, old_h = layouts[spec[2]]["width"], layouts[spec[2]]["height"]
+            old = struct.unpack(f"<{old_w * old_h}H", (self.base / f"data/layouts/{name}/map.bin").read_bytes())
+            g = self.gw if name == "TaichungGreenway" else self.oc
+            w, h = g.w, (g.h if name == "TaichungGreenway" else g.h - g.split)
+            new = self.words[name]
+            m, before = maps[name], self.base_json(f"data/maps/{name}/map.json")
+            taken = {(o["x"], o["y"]) for o in m["object_events"]}
+            door = m["warp_events"][0]
+            start, seen = (door["x"], door["y"] + 1), set()
+            todo = [start]
+            while todo:
+                x, y = todo.pop()
+                if (x, y) in seen or not (0 <= x < w and 0 <= y < h) or new[y * w + x] & 0xC00:
+                    continue
+                seen.add((x, y))
+                todo += [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
+            spots = sorted((x, y) for x, y in seen if new[y * w + x] & 0x3FF != TALL and (x, y) not in taken)
+            blocked = []
+            for y in range(old_h):
+                for x in range(old_w):
+                    if old[y * old_w + x] & 0xC00:
+                        continue
+                    nx, ny = x + dx, y + dy
+                    if 0 <= nx < w and 0 <= ny < h and (nx, ny) in seen:
+                        continue
+                    tx, ty = min(spots, key=lambda c: (abs(c[0] - nx) + abs(c[1] - ny), c[1], c[0]))
+                    blocked.append({"old": [x, y], "to": [tx, ty]})
+            moved = []
+            for kind in ("warp_events", "bg_events", "object_events"):
+                for a, b in zip(before[kind], m[kind]):
+                    shifted = [a["x"] + dx, a["y"] + dy]
+                    if [b["x"], b["y"]] != shifted:
+                        moved.append({"event": kind[:-7], "what": a.get("dest_map") or a.get("script"),
+                                      "old": [a["x"], a["y"]], "shifted": shifted, "now": [b["x"], b["y"]]})
+            out["maps"][spec[3]] = {"oldSize": [old_w, old_h], "newSize": [w, h], "shift": [dx, dy],
+                                    "movedBeyondShift": moved, "blocked": blocked}
+        out["maps"][MAPS["TaichungOldCityNorth"][3]] = {"new": True, "size": [self.oc.w, self.oc.split]}
+        self.outputs[SAVE_MOVES] = dump(out)
+
+    def habitat_rects(self, name):
+        width = self.oc.w if name != "TaichungGreenway" else self.gw.w
+        words = self.words[name]
+        left = {(n % width, n // width) for n, w in enumerate(words) if w & 0x3FF == TALL}
+        rects = []
+        for n in range(len(words)):
+            x, y = n % width, n // width
+            if (x, y) not in left:
+                continue
+            x1, y1 = x, y
+            while (x1 + 1, y) in left:
+                x1 += 1
+            while all((c, y1 + 1) in left for c in range(x, x1 + 1)):
+                y1 += 1
+            rects.append([x, y, x1, y1])
+            left -= {(c, r) for c in range(x, x1 + 1) for r in range(y, y1 + 1)}
+        return rects
+
+    def contract(self, maps):
+        """These maps' districts, landmarks and tall-grass habitats in the city contract: the
+        built sizes, origins and connections; each landmark moved with its door, its sign where
+        the map now has it; habitats exactly the built tall grass."""
+        base = self.base_json(CONTRACT)
+        frames = {"TaichungGreenway": (self.gw.ox, self.gw.oy, self.gw.w, self.gw.h),
+                  "TaichungOldCityNorth": (self.oc.ox, self.oc.oy, self.oc.w, self.oc.split),
+                  "TaichungOldCity": (self.oc.ox, self.oc.oy + self.oc.split, self.oc.w, self.oc.h - self.oc.split)}
+        districts = {}
+        for name, (ox, oy, w, h) in frames.items():
+            mid = map_id(name)
+            entry = next((d for d in base["districts"] if d["map"] == mid), {"map": mid, "name": name, "layout": MAPS[name][2]})
+            districts[mid] = dict(entry, width=w, height=h, worldOrigin=[ox, oy], connections=maps[name]["connections"])
+        landmarks = {}
+        for l in base["landmarks"]:
+            name = next((n for n in frames if map_id(n) == l["exteriorMap"]), None)
+            if not name:
+                continue
+            before = self.base_json(f"data/maps/{name}/map.json")
+            old, new = (m["warp_events"][l["entrance"]["warpId"]] for m in (before, maps[name]))
+            assert (old["x"], old["y"]) == (l["entrance"]["x"], l["entrance"]["y"]), l["id"]
+            dx, dy = new["x"] - old["x"], new["y"] - old["y"]
+            script = next(b["script"] for b in before["bg_events"] if (b["x"], b["y"]) == (l["sign"]["x"], l["sign"]["y"]))
+            sign = next(b for b in maps[name]["bg_events"] if b["script"] == script)
+            out = copy.deepcopy(l)
+            out["entrance"].update(x=new["x"], y=new["y"])
+            x0, y0, x1, y1 = l["footprint"]
+            out["footprint"] = [x0 + dx, y0 + dy, x1 + dx, y1 + dy]
+            for key in ("approach", "arrival"):
+                out[key].update(x=l[key]["x"] + dx, y=l[key]["y"] + dy)
+            out["sign"].update(x=sign["x"], y=sign["y"])
+            landmarks[l["id"]] = out
+        habitats = []
+        for name in frames:
+            rects = self.habitat_rects(name)
+            habitats += [{"id": f"{HABITATS[name]}-{n:03}", "map": map_id(name), "rect": r, "terrain": "tall-grass"}
+                         for n, r in enumerate(rects, 1)]
+        assert [h["map"] for h in base["habitatRegions"][:3]] == [map_id("TaichungOldCity")] * 2 + [map_id("TaichungGreenway")]
+        self.entries = {"districts": districts, "landmarks": landmarks, "habitatRegions": habitats}
+        self.outputs[CONTRACT] = dump(put_contract(base, districts, landmarks, habitats))
+
+    def record(self):
+        """What this build registers: every whole file it writes by digest, and its own
+        entries in the shared files, so guards can read the state underneath it."""
+        whole = {rel: hashlib.sha256(checked_in(rel, data)).hexdigest() for rel, data in sorted(self.outputs.items()) if rel not in SHARED}
+        layouts = {l["id"]: l for l in json.loads(self.outputs["data/layouts/layouts.json"])["layouts"]
+                   if l.get("id") in (MAPS[n][2] for n in MAPS)}
+        tables = json.loads(self.outputs["src/data/wild_encounters.json"])["wild_encounter_groups"]
+        encounters = {mid: [e for g in tables for e in g["encounters"] if e["map"] == mid]
+                      for mid in ("MAP_TAICHUNG_GREENWAY", "MAP_TAICHUNG_OLD_CITY")}
+        record = {"baseCommit": git("rev-parse", self.ref, text=True).strip(), "outputs": whole,
+                  "layouts": layouts, "mapGroup": ["gMapGroup_Taichung", "TaichungOldCityNorth"],
+                  "encounters": encounters, "edges": self.edges(),
+                  "blocks": self.blocks, "contract": {"districts": self.entries["districts"],
+                                                     "landmarks": self.entries["landmarks"],
+                                                     "habitatRegions": self.entries["habitatRegions"]}}
+        self.outputs[RECORD] = dump(record)
+
+    def edges(self):
+        """The highway's and the streets' edge cells, per map in its own cells: the retaining
+        wall, the culvert arch, kerbs (bollards), waterside railings and their inner corners."""
+        out = {}
+        for name in MAPS:
+            g, (r0, r1) = self.rows(name)
+            cells = lambda pick: [[x, y - r0] for y in range(r0, r1) for x in range(g.w) if pick(x, y)]
+            out[MAPS[name][3]] = {"wall": cells(lambda x, y: g.c[y][x] == "wall"),
+                                  "culvert": cells(lambda x, y: g.c[y][x] == "culvert"),
+                                  "kerb": cells(lambda x, y: (x, y) in g.kerbs),
+                                  "railing": cells(lambda x, y: (x, y) in g.railings),
+                                  "railCorner": cells(lambda x, y: (x, y) in g.rail_corners)}
+        return out
+
+    def scripts(self):
+        rel = "data/scripts/taichung_city.inc"
+        text = self.base_text(rel)
+        include = '\t.include "data/maps/TaichungOldCity/scripts.inc"\n'
+        assert text.count(include) == 1 and text.endswith("\n") and not text.endswith("\n\n")
+        text = text.replace(include, include + OCN_INCLUDE)
+        block = "\n@ City rework landmarks and place names (phase 2b).\n" + "\n".join(
+            f"TaichungCity_Sign_{label}::\n\tmsgbox TaichungCity_Text_{label}, MSGBOX_SIGN\n\tend\n\n"
+            f"TaichungCity_Text_{label}::\n\t.string \"{lines[0]}\\n\"\n\t.string \"{lines[1]}$\"\n"
+            for label, lines in [*LANDMARK_SIGNS.values(), *((label, lines) for label, _, lines in PLACE_SIGNS)])
+        self.blocks = {rel: [OCN_INCLUDE, block]}
+        self.outputs[rel] = (text + block).encode()
+
+    def tileset_declarations(self):
+        folder = OCN_DIR
+        edits = {
+            "src/data/tilesets/graphics.h": ('const u32 gTilesetTiles_TaichungXitun[]',
+                f'const u32 gTilesetTiles_TaichungOldCityNorth[] = INCBIN_U32("{folder}/tiles.4bpp.lz");\n'
+                "const u16 gTilesetPalettes_TaichungOldCityNorth[][16] =\n{\n"
+                + "".join(f'    INCBIN_U16("{folder}/palettes/{p:02}.gbapal"),\n' for p in range(16)) + "};\n\n"),
+            "src/data/tilesets/metatiles.h": ('const u16 gMetatiles_TaichungXitun[]',
+                f'const u16 gMetatiles_TaichungOldCityNorth[] = INCBIN_U16("{folder}/metatiles.bin");\n'
+                f'const u32 gMetatileAttributes_TaichungOldCityNorth[] = INCBIN_U32("{folder}/metatile_attributes.bin");\n\n'),
+            "src/data/tilesets/headers.h": ("const struct Tileset gTileset_TaichungXitun =",
+                "const struct Tileset gTileset_TaichungOldCityNorth =\n{\n    .isCompressed = TRUE,\n    .isSecondary = TRUE,\n"
+                "    .tiles = gTilesetTiles_TaichungOldCityNorth,\n    .palettes = gTilesetPalettes_TaichungOldCityNorth,\n"
+                "    .metatiles = gMetatiles_TaichungOldCityNorth,\n    .metatileAttributes = gMetatileAttributes_TaichungOldCityNorth,\n"
+                "    .callback = NULL,\n};\n\n"),
+        }
+        for rel, (anchor, block) in edits.items():
+            text = self.base_text(rel)
+            assert text.count(anchor) == 1, (rel, anchor)
+            self.blocks[rel] = [block]
+            self.outputs[rel] = text.replace(anchor, block + anchor).encode()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--base", default=BASE)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    b = Builder(args.base).build()
+    changed = []
+    spec = importlib.util.spec_from_file_location("oldcity_build_support", ROOT / "tools/taichung/landmarks/check_old_core.py")
+    support = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(support)
+    for rel, data in sorted(b.outputs.items()):
+        path = ROOT / rel
+        # The registered playthrough polish edits the shared city script after this build: keep it.
+        if rel == support.POLISH_SCRIPTS and path.exists() and support.POLISH_MARKER in path.read_bytes():
+            data = support.polish_scripts_over(ROOT, data)
+        if not path.exists() or path.read_bytes() != data:
+            changed.append(rel)
+            if not args.check:
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_bytes(data)
+    print(json.dumps(b.report, indent=1))
+    print(("differs: " if args.check else "wrote: ") + (", ".join(changed) or "nothing"))
+    if args.check and changed:
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
