+    dr.text((margin,62),'16 × 64×64 sections · projected GPS positions · authored infill proposals · native maps unchanged',font=f,fill='#50605a')
+    colors={'mixed-residential-retail':'#ede9e2','student-market-streets':'#f5e6c9','modern-commercial-green-space':'#e1eae7',
