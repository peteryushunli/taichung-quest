+#!/usr/bin/env python3
+"""Build a sourced street/section planning layer; never registers native maps.
+
+Input: official Taichung R0002 survey Shapefile, the existing official tourism
+landmark point catalog, and official township boundaries. Optional R0004 polygons
+are carried as transport context, without guessing whether unnamed ones are rail.
+
+Requires pyshp and pyproj; preview additionally requires Pillow. Outputs deliberately
+separate WGS84 source geometry, projected sizing points and future game entrances.
+"""
+import argparse
+from collections import Counter, defaultdict
+import datetime as dt
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+
+import shapefile
+from pyproj import CRS, Transformer
+
+WORLD = 256
+SECTION = 64
+BBOX = (24.11, 120.62, 24.20, 120.72)  # S,W,N,E
+SPINE_NAMES = re.compile(r"臺灣大道|台灣大道|文心路|公益路|五權西路|五權路|向上路|向上北路|中清路|崇德路|復興路|建國路|西屯路|河南路|黎明路|忠明路|忠明南路|英才路|逢甲路|福星路|福星北路|文華路|惠來路|惠中路|市政北七路|市政路|雙十路|公園路|中山路|民權路|中興街|美村路|館前路|民生路")
+GYMS = {
+    1:("taichung-theater",16,10), 2:("calligraphy-greenway",14,10),
+    3:("old-taichung-station",12,8), 4:("taichung-park",16,12),
+    5:("fengjia-night-market",14,10), 7:("natural-science-museum",14,10),
+    11:("miyahara",10,8), 12:("shen-ji-new-village",12,8),
+    13:("fine-arts-museum",14,10), 14:("maple-garden",18,14),
+}
+DISTRICT_EN = {"西屯區":"Xitun", "南屯區":"Nantun", "北屯區":"Beitun", "北區":"North", "南區":"South",
+               "東區":"East", "西區":"West", "中區":"Central", "太平區":"Taiping", "大里區":"Dali", "烏日區":"Wuri"}
+
+
+def dump(path, value, compact=False):
+    path.parent.mkdir(parents=True,exist_ok=True)
+    path.write_text(json.dumps(value,ensure_ascii=False,indent=None if compact else 2,
+                               separators=(",",":") if compact else None)+"\n")
+
+
+def project(lon,lat,bbox=BBOX):
+    s,w,n,e=bbox
+    return ((lon-w)/(e-w)*WORLD,(n-lat)/(n-s)*WORLD)
+
+
+def unproject(x,y,bbox=BBOX):
+    s,w,n,e=bbox
+    return (w+x/WORLD*(e-w),n-y/WORLD*(n-s))
+
+
+def point_in_ring(p,ring):
+    x,y=p; inside=False
+    for a,b in zip(ring,ring[1:]+ring[:1]):
+        if (a[1]>y)!=(b[1]>y) and x < (b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0]: inside=not inside
+    return inside
+
+
+def town_at(lon,lat,towns):
+    for feature in towns:
+        geom=feature['geometry']; polys=geom['coordinates'] if geom['type']=='MultiPolygon' else [geom['coordinates']]
+        for poly in polys:
+            if point_in_ring((lon,lat),poly[0]) and not any(point_in_ring((lon,lat),hole) for hole in poly[1:]):
+                return feature['properties']['town']
+    return None
+
+
+def clip_segment(a,b,box=(0,0,WORLD,WORLD)):
+    """Liang-Barsky line clip; outside points are clipped, never clamped to edges."""
+    x0,y0=a; dx,dy=b[0]-x0,b[1]-y0; lo,hi=0.,1.
+    for p,q in ((-dx,x0-box[0]),(dx,box[2]-x0),(-dy,y0-box[1]),(dy,box[3]-y0)):
+        if abs(p)<1e-12:
+            if q<0:return None
+        else:
+            r=q/p
+            if p<0:lo=max(lo,r)
+            else:hi=min(hi,r)
+            if lo>hi:return None
+    return ([x0+lo*dx,y0+lo*dy],[x0+hi*dx,y0+hi*dy])
+
+
+def clip_polyline(points):
+    parts=[]; chain=[]
+    for a,b in zip(points,points[1:]):
+        clipped=clip_segment(a,b)
+        if clipped is None:
+            if len(chain)>1:parts.append(chain)
+            chain=[];continue
+        u,v=clipped
+        if chain and math.dist(chain[-1],u)<1e-7:chain.append(v)
+        else:
+            if len(chain)>1:parts.append(chain)
+            chain=[u,v]
+    if len(chain)>1:parts.append(chain)
+    return parts
+
+
+def simplify(points,tolerance=.35):
+    if len(points)<3:return points
+    a,b=points[0],points[-1];dx,dy=b[0]-a[0],b[1]-a[1];den=dx*dx+dy*dy
+    def distance(p):
+        if not den:return math.dist(p,a)
+        t=max(0,min(1,((p[0]-a[0])*dx+(p[1]-a[1])*dy)/den))
+        return math.dist(p,(a[0]+t*dx,a[1]+t*dy))
+    ds=[distance(p) for p in points[1:-1]];greatest=max(ds)
+    if greatest<=tolerance:return [a,b]
+    at=1+ds.index(greatest)
+    return simplify(points[:at+1],tolerance)[:-1]+simplify(points[at:],tolerance)
+
+
+def lattice_line(a,b):
+    """4-connected digital line for a future native walking skeleton."""
+    x,y=(min(255,max(0,int(v))) for v in a);tx,ty=(min(255,max(0,int(v))) for v in b)
+    nx,ny=abs(tx-x),abs(ty-y);sx=1 if tx>x else -1;sy=1 if ty>y else -1
+    ix=iy=0; result=[(x,y)]
+    while ix<nx or iy<ny:
+        if ix<nx and (iy>=ny or (ix+.5)*ny <= (iy+.5)*nx): x+=sx;ix+=1
+        else:y+=sy;iy+=1
+        result.append((x,y))
+    return result
+
+
+def raster_polyline(points):
+    cells=[]
+    for a,b in zip(points,points[1:]):
+        segment=lattice_line(a,b)
+        cells.extend(segment if not cells else segment[1:])
+    return cells
+
+
+def section_id(x,y):
+    c=min(3,max(0,int(x//64)));r=min(3,max(0,int(y//64)))
+    return f"city-v2-r{r}-c{c}"
+
+
+def reserve_landmarks(points,current_contract):
+    baseline={l['id']:l for l in current_contract['landmarks']}; result=[]
+    for p in points:
+        if p['n'] not in GYMS:continue
+        key,width,height=GYMS[p['n']];lon,lat=p['coordinates'];x,y=project(lon,lat)
+        # This envelope is a source-point-centered sizing study, not an entrance.
+        left,top=x-width/2,y-height/2
+        result.append(dict(id=key,number=p['n'],name=p['name'],zh=p['zh'],realWgs84=[lon,lat],
+            rawProjectedPoint=[round(x,3),round(y,3)],provisionalSection=section_id(x,y),
+            proposedArtDimensions=[width,height],reserveEnvelope=[round(left,3),round(top,3),round(left+width,3),round(top+height+4,3)],
+            reserveIncludesSouthApronTiles=4,reserveStatus="sizing-only; local elastic placement TBD",
+            authoredGameEntrance=None,
+            baselineNative=dict(exteriorMap=baseline[key]['exteriorMap'],entrance=baseline[key]['entrance'],arrival=baseline[key]['arrival'],gymMap=baseline[key]['gymMap'])))
+    conflicts=[]
+    for i,a in enumerate(result):
+        for b in result[i+1:]:
+            ar,br=a['reserveEnvelope'],b['reserveEnvelope'];gap=2
+            if ar[0]<br[2]+gap and ar[2]+gap>br[0] and ar[1]<br[3]+gap and ar[3]+gap>br[1]:
+                conflicts.append(dict(landmarks=[a['id'],b['id']],rawPointDistanceTiles=round(math.dist(a['rawProjectedPoint'],b['rawProjectedPoint']),2),
+                    reason="Art/apron envelopes overlap or lack 2-tile clearance in uniform projection",
+                    resolution="TBD: locally stretch/reposition the game cluster; preserve the real source points and native baseline until versioned placement contract"))
+    return result,conflicts
+
+
+def read_roads(shp_path,bbox):
+    reader=shapefile.Reader(str(shp_path),encoding='utf-8')
+    crs=CRS.from_wkt(shp_path.with_suffix('.prj').read_text())
+    to_wgs=Transformer.from_crs(crs,'EPSG:4326',always_xy=True)
+    to_src=Transformer.from_crs('EPSG:4326',crs,always_xy=True)
+    s,w,n,e=bbox;corners=[to_src.transform(lon,lat) for lon in (w,e) for lat in (s,n)]
+    source_bbox=[min(x for x,y in corners),min(y for x,y in corners),max(x for x,y in corners),max(y for x,y in corners)]
+    roads=[];coverage=Counter(); all_geometry=[]
+    for sr in reader.iterShapeRecords(bbox=source_bbox):
+        d=sr.record.as_dict();shape=sr.shape
+        lons,lats=to_wgs.transform(*zip(*shape.points));world=[project(lon,lat,bbox) for lon,lat in zip(lons,lats)]
+        parts=list(shape.parts)+[len(world)]
+        for pi,(a,b) in enumerate(zip(parts,parts[1:])):
+            for ci,line in enumerate(clip_polyline(world[a:b])):
+                if sum(math.dist(u,v) for u,v in zip(line,line[1:]))<.12: continue
+                name=d.get('R2B') or '';width=float(d.get('R2J') or 0); road_type=d.get('R2S') or ''
+                is_alley=bool(d.get('R2D') or d.get('R2E') or re.search('巷|弄',name))
+                preferred=bool(SPINE_NAMES.search(name)) and not is_alley
+                is_unnamed=name in ('','無名路')
+                selected=(width>=30 and not is_unnamed) or preferred or road_type=='自行車專用道'
+                coverage['surveyPolylinePartsIntersectingBounds']+=1
+                coverage['selectedBackboneSegments']+=selected
+                all_geometry.append(dict(id=int(d['ID']),name=name,widthMeters=width,roadType=road_type,geometry=line,selected=selected))
+                if not selected:continue
+                source_points=[[round(v,7) for v in unproject(x,y,bbox)] for x,y in line]
+                simple=simplify(line)
+                role='primary-avenue' if width>=30 else 'named-local-spine'
+                if road_type=='自行車專用道':role='cycle-corridor'
+                freeways=bool(re.search('國道|高速|快速|台74|臺74|台７４',name))
+                elevated='高架' in road_type
+                player_port=not(freeways or elevated)
+                roads.append(dict(id=f"municipal-r0002-{int(d['ID'])}-p{pi}-{ci}",sourceRecordId=int(d['ID']),
+                    sourceLayer='R0002',sourceName=name,sourceDistrict=d.get('R2C') or None,
+                    sourceWidthMeters=width,sourceRoadType=road_type,sourceUpdateYear=d.get('R2L'),
+                    sourceAlley=d.get('R2D') or None,sourceSubAlley=d.get('R2E') or None,
+                    sourceLaneCounts=dict(left=d.get('R2G'),right=d.get('R2H')),sourceDirection=d.get('R2F'),
+                    sourceGeometryWgs84=source_points,
+                    projectedCenterline=[[round(x,3),round(y,3)] for x,y in simple],
+                    role=role,preferredSpine=preferred,proposedCorridorWidthTiles=4 if width>=30 else 3,
+                    eligiblePlayerSeamCandidate=player_port,
+                    gradeReviewRequired=elevated or freeways,
+                    authoredGameCenterline=None))
+    coverage['uniqueSurveyRecordsIntersectingBounds']=len({r['id'] for r in all_geometry})
+    label='EPSG:3826' if crs.equals(CRS.from_epsg(3826),ignore_axis_order=True) else crs.name
+    return roads,all_geometry,dict(coverage),label
+
+
+def read_transport_polygons(path,bbox):
+    if path is None:return []
+    reader=shapefile.Reader(str(path),encoding='utf-8')
+    transform=Transformer.from_crs(CRS.from_wkt(path.with_suffix('.prj').read_text()),'EPSG:4326',always_xy=True)
+    result=[]
+    for sr in reader.iterShapeRecords():
+        d=sr.record.as_dict();lons,lats=transform.transform(*zip(*sr.shape.points));points=[project(lon,lat,bbox) for lon,lat in zip(lons,lats)]
+        if not any(-1<=x<=257 and -1<=y<=257 for x,y in points):continue
+        name=d.get('R4B') or None
+        result.append(dict(id=f"municipal-r0004-{d['ID']}",sourceLayer='R0004',sourceRecordId=d['ID'],sourceName=name,
+             role='surveyed-cycle-corridor' if name and '自行車' in name else 'unclassified-transport-structure',
+             geometryWgs84=[[round(v,7) for v in unproject(x,y,bbox)] for x,y in points],
+             projectedOutline=[[round(x,3),round(y,3)] for x,y in points],
+             notAssumedRail=True,notAssumedWalkable=True))
+    return result
+
+
+def build_ports(roads):
+    ports={}
+    for road in roads:
+        line=road['projectedCenterline']
+        for a,b in zip(line,line[1:]):
+            for axis in (0,1):
+                delta=b[axis]-a[axis]
+                if abs(delta)<1e-9:continue
+                for seam in (64,128,192):
+                    t=(seam-a[axis])/delta
+                    if not (0<=t<1):continue
+                    other=a[1-axis]+t*(b[1-axis]-a[1-axis])
+                    if not (0<=other<256):continue
+                    lane=int(other)%64; center=min(61,max(2,lane)); band=int(other)//64
+                    if axis==0:
+                        c=seam//64;r=band;frm=f"city-v2-r{r}-c{c-1}";to=f"city-v2-r{r}-c{c}";direction='right';p=[63,center];q=[0,center]
+                    else:
+                        r=seam//64;c=band;frm=f"city-v2-r{r-1}-c{c}";to=f"city-v2-r{r}-c{c}";direction='down';p=[center,63];q=[center,0]
+                    key=(axis,seam,band,center)
+                    if key not in ports:
+                        ports[key]=dict(id=f"seam-{'x' if axis==0 else 'y'}{seam}-band{band}-at{center}",
+                            fromSection=frm,toSection=to,direction=direction,fromLocalCenter=p,toLocalCenter=q,
+                            reciprocalDirection='left' if direction=='right' else 'up',nativeConnectionOffset=0,
+                            projectedCrossing=[round(seam if axis==0 else other,3),round(other if axis==0 else seam,3)],
+                            cornerAdjustmentTiles=center-lane,sourceRoadIds=[],sourceNames=[],
+                            eligiblePlayerConnector=False,status='candidate; port widths/grade/collision and competing crossings require mapping integration')
+                    port=ports[key];port['sourceRoadIds'].append(road['id'])
+                    if road['sourceName'] not in port['sourceNames']:port['sourceNames'].append(road['sourceName'])
+                    port['eligiblePlayerConnector'] |= road['eligiblePlayerSeamCandidate']
+    return sorted(ports.values(),key=lambda p:p['id'])
+
+
+def sections_and_lots(roads,all_roads,gyms,towns):
+    occupied=set();road_counts=Counter();names=defaultdict(Counter)
+    for road in all_roads:
+        mid=road['geometry'][len(road['geometry'])//2];road_counts[section_id(*mid)]+=1
+    for road in roads:
+        line=road['projectedCenterline'];rad=math.ceil(road['proposedCorridorWidthTiles']/2)
+        for x,y in raster_polyline(line):
+            names[section_id(x,y)][road['sourceName']]+=1
+            for dx in range(-rad,rad+1):
+                for dy in range(-rad,rad+1):
+                    if 0<=x+dx<256 and 0<=y+dy<256:occupied.add((x+dx,y+dy))
+    for gym in gyms:
+        l,t,r,b=gym['reserveEnvelope']
+        for y in range(max(0,math.floor(t-2)),min(256,math.ceil(b+2))):
+            for x in range(max(0,math.floor(l-2)),min(256,math.ceil(r+2))):occupied.add((x,y))
+    sections=[];lots=[]
+    for row in range(4):
+        for col in range(4):
+            key=f"city-v2-r{row}-c{col}";x,y=col*64,row*64;lon,lat=unproject(x+32,y+32);town=town_at(lon,lat,towns)
+            local_gyms=[g['id'] for g in gyms if g['provisionalSection']==key]
+            kind='mixed-residential-retail'
+            if 'fengjia-night-market' in local_gyms:kind='student-market-streets'
+            elif any(g in local_gyms for g in ['taichung-theater','maple-garden']):kind='modern-commercial-green-space'
+            elif any(g in local_gyms for g in ['old-taichung-station','miyahara','taichung-park']):kind='old-city-mixed-use'
+            elif local_gyms:kind='cultural-mixed-use-green-space'
+            elif road_counts[key]<300:kind='lower-density-urban-edge'
+            recipe=dict(id=kind,status='authored game fill proposal, not surveyed land-use zoning',
+                        roles=['ordinary-building-frontage','retail-frontage','residential-frontage','small-green-space','street-props'])
+            section=dict(id=key,gridRow=row,gridCol=col,worldOrigin=[x,y],width=64,height=64,
+                sourceBoundsWgs84=[list(unproject(x,y+64)),list(unproject(x+64,y))],
+                sourceDistrictAtCenter=town,proposedName=f"{DISTRICT_EN.get(town,town or 'Urban')} {row+1}-{col+1}",
+                nativeMapId=None,nativeMapRegistration=False,landmarkGymIds=local_gyms,
+                sourceSurveySegmentCount=road_counts[key],topSourceRoads=[n for n,_ in names[key].most_common(5)],fillRecipe=recipe,
+                bufferCellsWithNativePadding=(64+15)*(64+14),nativeBufferLimit=0x2800)
+            sections.append(section)
+            # Optional empty plotting parcels, selected deterministically around the
+            # coarse corridor/reserve mask. These are NOT cadastral buildings.
+            for ly in range(3,55,9):
+                for lx in range(3,52,13):
+                    # Wider facade modules get first choice; small parcels remain
+                    # useful where a corridor leaves only eight clear columns.
+                    width=0
+                    for candidate_width in (12,8):
+                        parcel=[(x+xx,y+yy) for yy in range(ly,ly+8) for xx in range(lx,lx+candidate_width)]
+                        if not any(cell in occupied for cell in parcel):width=candidate_width;break
+                    if not width:continue
+                    lots.append(dict(id=f"{key}-lot-{lx}-{ly}",section=key,worldRect=[x+lx,y+ly,x+lx+width-1,y+ly+7],
+                        localOrigin=[lx,ly],width=width,height=8,
+                        role='ordinary-neighborhood-infill',context=kind,
+                        status='unpainted authored candidate; not a real building footprint',
+                        sourceBuildingId=None,selectedPrefabId=None,
+                        constraints=['Must apply prefab paint/solid/mandatory-clear masks','Do not occupy source road reservations or gym envelopes','Recheck after elastic street/gym placement']))
+    return sections,lots,occupied
+
+
+def render_preview(output,data,all_roads):
+    from PIL import Image,ImageDraw,ImageFont
+    scale=6;margin=52;top=110;side=256*scale;legend=500
+    im=Image.new('RGB',(side+2*margin+legend,side+top+margin),'#faf9f4');dr=ImageDraw.Draw(im)
+    font_path=next((str(p) for p in (Path('/System/Library/Fonts/STHeiti Light.ttc'),Path('/System/Library/Fonts/Supplemental/Songti.ttc')) if p.exists()),None)
