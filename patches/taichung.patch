+}
+
+static u32 PreparationPartyHash(void)
+{
+    const u8 *bytes = (const u8 *)gPlayerParty;
+    u32 hash = 2166136261u;
+    u16 i;
+    for (i = 0; i < sizeof(gPlayerParty); i++)
+        hash = (hash ^ bytes[i]) * 16777619u;
+    return hash;
+}
