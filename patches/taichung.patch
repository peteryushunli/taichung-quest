+#!/usr/bin/env python3
+"""Check the native Old City encounter table against reachable authored grass."""
+from collections import Counter
+import json
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'tools/taichung'))
+from validate_city import Validator
+
+contract = json.loads((ROOT / 'docs/taichung-city-contract.json').read_text())
+city = Validator(ROOT, contract)
+city.run()
+assert not city.errors, city.errors
+old_city = city.maps['MAP_TAICHUNG_OLD_CITY']
+regions = [h for h in contract['habitatRegions'] if h['map'] == old_city.id]
+# Parent approved recording this existing authored lawn without a geometry or
+# mapping-contract rewrite. build_city.py places it beside the park lake.
+if not any(h['id'] == 'park-lawns-east' for h in regions):
+    regions.append({'id':'park-lawns-east', 'map':old_city.id,
+                    'rect':[35,14,36,22], 'terrain':'tall-grass'})
+reserved = set()
+for habitat in regions:
+    assert habitat['terrain'] == 'tall-grass'
+    x0, y0, x1, y1 = habitat['rect']
+    reserved.update((x,y) for x in range(x0,x1+1) for y in range(y0,y1+1))
+# The native encounter attribute occupies bits 24–26; LAND = 1.
+actual = {(x,y) for x in range(old_city.width) for y in range(old_city.height)
+          if old_city.walkable(x,y) and ((old_city.attribute(old_city.cell(x,y) & 0x3FF) >> 24) & 7) == 1}
+assert actual == reserved, f'Unexpected/missing grass cells: extra={actual-reserved}, missing={reserved-actual}'
+spawn = contract['spawn']
+assert all((old_city.id,x,y) in city.distances for x,y in actual)
+# The table must not make a wild battle mandatory for any landmark approach.
+old_city.obstacles.update(actual)
+quiet_paths = city.flood((spawn['map'],spawn['x'],spawn['y']),city.district_ids)
+for landmark in contract['landmarks']:
+    approach = landmark['approach']
+    assert (landmark['exteriorMap'],approach['x'],approach['y']) in quiet_paths, f"Grass blocks required approach to {landmark['id']}"
+
+wild = json.loads((ROOT / 'src/data/wild_encounters.json').read_text())
+group = next(g for g in wild['wild_encounter_groups'] if g['label']=='gWildMonHeaders')
+entries = [e for e in group['encounters'] if e.get('map') == old_city.id]
+assert len(entries) == 1, 'Old City needs exactly one native table'
+entry = entries[0]
+assert set(entry) == {'map','base_label','land_mons'}, 'No unapproved water/fishing/rock encounter table'
+land = entry['land_mons']
+weights = next(f['encounter_rates'] for f in group['fields'] if f['type']=='land_mons')
+assert len(land['mons']) == len(weights) == 12 and sum(weights) == 100
+assert 0 < land['encounter_rate'] <= 100
+species_header = (ROOT / 'include/constants/species.h').read_text()
+shares = Counter()
+for weight, mon in zip(weights,land['mons']):
+    assert 1 <= mon['min_level'] <= mon['max_level'] <= 100
+    assert re.search(r'^#define\s+'+re.escape(mon['species'])+r'\s+',species_header,re.M), mon['species']
+    shares[mon['species']] += weight
+print('PASS: Old City table uses',len(actual),'reachable authored grass cells in',', '.join(h['id'] for h in regions))
+print('PASS: every landmark approach remains reachable without entering this encounter grass.')
+print('Provisional native rate:',land['encounter_rate'],'weighted species shares:',dict(shares))
