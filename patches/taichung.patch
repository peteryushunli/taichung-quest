+    draw.text((10, 24), 'Attached homes west; main-avenue shop rows; fixed landmarks/park/routes.', fill='#365a4b')
+    draw.text((10, 40), 'Actual source base + native prefab overlay; Main owns final bank/map install.', fill='#365a4b')
+    draw.text((10, HEIGHT * 16 + 62), 'Station 30,66 -> Miyahara 20,53 -> Park 32,31; both west crossings clear.', fill='#365a4b')
