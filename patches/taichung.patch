index 0000000..dee005e
--- /dev/null
+++ b/tools/taichung_gameplay/audit-badge-scenes.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Verify approved native tile offsets/palettes and restricted award call sites."""
+from pathlib import Path
+import hashlib
+import json
+import re
+import struct
+import zlib
+
+root = Path(__file__).resolve().parents[2]
+assets = root / "graphics/taichung/badges"
+manifest = json.loads((assets / "assets.json").read_text())
+assert manifest["status"] == "user-approved complete review-v3 set"
+assert [b["gymIndex"] for b in manifest["badges"]] == list(range(10))
+assert [b["completionBit"] for b in manifest["badges"]] == list(range(10))
+assert [b["displayNumber"] for b in manifest["badges"]] == list(range(1, 11))
+for name, expected in manifest["sha256"].items():
+    assert hashlib.sha256((assets / name).read_bytes()).hexdigest() == expected, name
+
+
+def indexed_png(path):
+    data = path.read_bytes()
+    assert data[:8] == b"\x89PNG\r\n\x1a\n"
+    pos, compressed, palette, transparency = 8, b"", b"", b""
+    while pos < len(data):
+        length = int.from_bytes(data[pos:pos + 4], "big")
+        kind, payload = data[pos + 4:pos + 8], data[pos + 8:pos + 8 + length]
+        if kind == b"IHDR":
+            width, height, depth, mode, compression, filtering, interlace = struct.unpack(">IIBBBBB", payload)
+            assert mode == 3 and depth in (1, 2, 4, 8) and compression == filtering == interlace == 0
+        elif kind == b"PLTE":
+            palette = payload
+        elif kind == b"tRNS":
+            transparency = payload
+        elif kind == b"IDAT":
+            compressed += payload
+        pos += length + 12
+    assert transparency and transparency[0] == 0 and all(a == 255 for a in transparency[1:])
+    raw = zlib.decompress(compressed)
+    stride = (width * depth + 7) // 8
+    previous, rows = bytearray(stride), []
+    for y in range(height):
+        f = raw[y * (stride + 1)]
+        row = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
+        for x in range(stride):
+            left, above, upper_left = row[x - 1] if x else 0, previous[x], previous[x - 1] if x else 0
+            if f == 0:
+                predictor = 0
+            elif f == 1:
+                predictor = left
+            elif f == 2:
+                predictor = above
+            elif f == 3:
+                predictor = (left + above) // 2
+            else:
+                assert f == 4
+                estimate = left + above - upper_left
+                predictor = min((left, above, upper_left), key=lambda n: abs(estimate - n))
+            row[x] = (row[x] + predictor) & 255
+        rows.append([(row[x * depth // 8] >> (8 - depth - x * depth % 8)) & ((1 << depth) - 1) for x in range(width)])
+        previous = row
+    return width, height, palette, rows
+
+
+palette_bytes = (assets / "earned.gbapal.bin").read_bytes()
+assert len(palette_bytes) == 32
+native_names = (root / "src/taichung_badges.c").read_text()
+for size, filename, png_key in ((16, "collection.4bpp.bin", "collectionPng"), (32, "award.4bpp.bin", "awardPng")):
+    tiles = (assets / filename).read_bytes()
+    per_icon = size * size // 2
+    assert len(tiles) == per_icon * 10
+    for badge in manifest["badges"]:
+        w, h, palette, pixels = indexed_png(assets / badge[png_key])
+        assert w == h == size
+        rgb555 = b"".join(((palette[i * 3] >> 3) | ((palette[i * 3 + 1] >> 3) << 5) | ((palette[i * 3 + 2] >> 3) << 10)).to_bytes(2, "little") for i in range(16))
+        assert rgb555 == palette_bytes
+        for y in range(size):
+            for x in range(size):
+                offset = badge["gymIndex"] * per_icon + ((y // 8) * (size // 8) + x // 8) * 32 + (y % 8) * 4 + (x % 8) // 2
+                index = (tiles[offset] >> ((x % 2) * 4)) & 15
+                assert index == pixels[y][x], (filename, badge["gymIndex"], x, y)
+        for text in badge["name"].values():
+            assert f'_("{text}")' in native_names
+
+controllers = {
+    "taichung_gyms.inc": "TaichungGym_StationAfterBattle::\n",
+    "taichung_park_gym.inc": "TaichungGym_ParkAfterBattle::\n",
+    "taichung_miyahara_gym.inc": "TaichungGym_MiyaharaAfterBattle::\n",
+    "taichung_landmark_gym.inc": "TaichungGym_\\name\\()AfterBattle:\n",
+}
+for filename, label in controllers.items():
+    script = (root / "data/scripts" / filename).read_text()
+    assert script.count("call TaichungBadge_EventScript_TryAward") == 1
+    body = script.split(label, 1)[1].split("\n\n", 1)[0]
+    ordered = [body.index(needle) for needle in (
+        "callnative TaichungGym_ScriptGetResult", "TAICHUNG_GYM_RESULT_WON",
+        "callnative TaichungGym_ScriptIsComplete", "goto_if_ne VAR_RESULT, TRUE",
+        "call TaichungBadge_EventScript_TryAward", "TAICHUNG_GYM_MESSAGE_COMPLETE")]
+    assert ordered == sorted(ordered), filename
+    assert script.index("goto_if_questlog") < script.index("callnative TaichungGym_ScriptPrepareChallenge")
+station = (root / "data/scripts/taichung_gyms.inc").read_text()
+shared = station.split("TaichungBadge_EventScript_TryAward::\n", 1)[1]
+assert shared.index("TaichungBadge_ScriptPrepareAward") < shared.index("goto_if_ne VAR_RESULT, TRUE") < shared.index("TaichungBadge_ScriptOpenAward") < shared.index("waitstate")
+for script in (root / "data").rglob("*.inc"):
+    if script.name not in controllers:
+        assert not re.search(r'(?:call|callnative) TaichungBadge_', script.read_text()), script
+assert "QL_IS_PLAYBACK_STATE" in native_names and "TaichungGymConsumeNewBadge" in native_names
+assert not re.search(r'\b(?:VarSet|AddMoney|RemoveMoney|CreateMon|SetMonData)\s*\(', native_names)
+renderer = (root / "src/taichung_city_pass.c").read_text()
+assert not re.search(r'\b(?:VarSet|AddMoney|RemoveMoney|CreateMon|SetMonData|TaichungGymConsumeNewBadge)\s*\(', renderer)
+print("PASS:20 approved PNG/payload roundtrips, palette/hashes/bit numbering/names,4 after-win-only guarded script paths, no scene/collection progress or money writers")
