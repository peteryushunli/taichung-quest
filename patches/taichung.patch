+static void UpdateTaichungBikeShortcutInput(struct FieldInput *input, u16 newKeys, u16 heldKeys)
+{
+    bool8 continuous = gMain.vblankCounter2 - sBikeShortcutInputFrame == 1;
+    bool8 available = TaichungCanToggleBike();
+    sBikeShortcutInputFrame = gMain.vblankCounter2;
+
+    if (!continuous || !available)
+    {
+        sBikeShortcutArmed = FALSE;
+        sBikeShortcutPending = FALSE;
+        if (available && !(heldKeys & B_BUTTON))
+            sBikeShortcutArmed = TRUE;
+        return;
+    }
+    // A keeps interaction priority. Start/Select keep their native actions.
+    if ((newKeys | heldKeys) & (A_BUTTON | START_BUTTON | SELECT_BUTTON))
+    {
+        sBikeShortcutArmed = FALSE;
+        sBikeShortcutPending = FALSE;
+        return;
+    }
+    if (!(heldKeys & B_BUTTON))
+        sBikeShortcutArmed = TRUE;
+    else if ((newKeys & B_BUTTON) && sBikeShortcutArmed)
+    {
+        sBikeShortcutArmed = FALSE;
+        sBikeShortcutPending = TRUE;
+        sBikeShortcutPendingAge = 0;
+    }
+    if (sBikeShortcutPending)
+    {
+        if (gPlayerAvatar.tileTransitionState != T_TILE_TRANSITION)
+        {
+            input->pressedBButton = TRUE;
+            sBikeShortcutPending = FALSE;
+        }
+        else if (++sBikeShortcutPendingAge >= 32)
