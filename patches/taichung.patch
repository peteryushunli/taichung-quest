+typedef char NavigationSizeCheck[sizeof(struct TaichungNavigationBridge) == TAICHUNG_NAVIGATION_BRIDGE_SIZE ? 1 : -1];
+typedef char NavigationSequenceCheck[offsetof(struct TaichungNavigationBridge, sequence) == 0x10 ? 1 : -1];
+typedef char NavigationPositionCheck[offsetof(struct TaichungNavigationBridge, localX) == 0x1C ? 1 : -1];
+typedef char NavigationContextCheck[offsetof(struct TaichungNavigationBridge, contextFlags) == 0x28 ? 1 : -1];
+
+EWRAM_DATA volatile struct TaichungNavigationBridge gTaichungNavigationBridge = {0};
+
+static bool8 SavePointerValid(void)
+{
+    u32 address = (u32)gSaveBlock1Ptr;
+
+    return address >= EWRAM_START
+        && address <= EWRAM_END - sizeof(*gSaveBlock1Ptr)
+        && (address & 3) == 0;
+}
+
+static u16 GetHiddenContext(bool8 gameCallbacksRan, bool8 field)
+{
+    u16 context = 0;
+    u8 printer;
+
+    if (!gameCallbacksRan)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_CALLBACKS_SKIPPED;
+    if (!field)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_NOT_FIELD;
+    if (gMain.inBattle)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_BATTLE;
+    if (gPaletteFade.active || gFieldCallback || gFieldCallback2)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_TRANSITION;
+    if (ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_SCRIPT;
+    if (!IsFieldMessageBoxHidden())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE;
+    for (printer = 0; printer < NUM_TEXT_PRINTERS; printer++)
+    {
+        if (IsTextPrinterActive(printer))
+            context |= TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE;
+    }
+    if (gReceivedRemoteLinkPlayers || IsUpdateLinkStateCBActive())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_LINK;
+    if (QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_REPLAY;
+    if (!SavePointerValid())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE;
+    return context;
+}
+
+static void ReadFieldPosition(struct TaichungNavigationBridge *snapshot)
+{
+    const struct MapLayout *layout = gMapHeader.mapLayout;
+    const struct ObjectEvent *player;
+    s16 x, y;
+    u8 facing;
+
+    if (gSaveBlock1Ptr->location.mapGroup < 0 || gSaveBlock1Ptr->location.mapNum < 0
+        || layout == NULL || layout->width <= 0 || layout->height <= 0
+        || layout->width > 0x7FFF || layout->height > 0x7FFF)
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP;
+        return;
+    }
+    if (gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT)
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR;
+        return;
+    }
+    player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    // CONTROLLABLE is cleared during ordinary walking/cycling and can stay
+    // clear after stopping. A live player retains its concrete locomotion flag.
+    if (!player->active || !player->isPlayer
+        || !(gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_ON_FOOT | PLAYER_AVATAR_FLAG_MACH_BIKE
+                                   | PLAYER_AVATAR_FLAG_ACRO_BIKE | PLAYER_AVATAR_FLAG_SURFING
+                                   | PLAYER_AVATAR_FLAG_UNDERWATER)))
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR;
+        return;
+    }
+
+    PlayerGetDestCoords(&x, &y);
+    x -= MAP_OFFSET;
+    y -= MAP_OFFSET;
+    facing = GetPlayerFacingDirection();
+    // Connection/warp boundary frames can temporarily lie outside the new map.
+    if (x < 0 || y < 0 || x >= layout->width || y >= layout->height
+        || facing < DIR_SOUTH || facing > DIR_EAST)
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION;
+        return;
+    }
+    if (IsMapTypeOutdoors(gMapHeader.mapType))
+        snapshot->flags |= TAICHUNG_NAVIGATION_OUTDOOR;
+    else if (gMapHeader.mapType == MAP_TYPE_INDOOR || gMapHeader.mapType == MAP_TYPE_UNDERGROUND
+             || gMapHeader.mapType == MAP_TYPE_SECRET_BASE)
+        snapshot->flags |= TAICHUNG_NAVIGATION_INDOOR;
+    else
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP;
+        return;
+    }
+    snapshot->localX = x;
+    snapshot->localY = y;
+    snapshot->mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    snapshot->mapNum = gSaveBlock1Ptr->location.mapNum;
+    snapshot->facing = facing;
+    snapshot->mapType = gMapHeader.mapType;
+    snapshot->mapWidth = layout->width;
+    snapshot->mapHeight = layout->height;
+    snapshot->flags |= TAICHUNG_NAVIGATION_POSITION_VALID;
+    if (TestPlayerAvatarFlags(PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE))
+        snapshot->flags |= TAICHUNG_NAVIGATION_CYCLING;
+    if (TaichungCanToggleBike())
+        snapshot->flags |= TAICHUNG_NAVIGATION_CAN_TOGGLE_BIKE;
+}
+
+void TaichungNavigationBridge_Tick(bool8 gameCallbacksRan)
+{
+    volatile struct TaichungNavigationBridge *packet = &gTaichungNavigationBridge;
+    struct TaichungNavigationBridge snapshot = {0};
+    bool8 field = Overworld_IsMainFieldCallback();
+    u32 sequence = 1;
+    u32 frame = 1;
+
+    if (packet->magicA == TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A
+        && packet->magicB == TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B
+        && packet->version == TAICHUNG_NAVIGATION_BRIDGE_VERSION
+        && packet->size == TAICHUNG_NAVIGATION_BRIDGE_SIZE
+        && packet->selfGbaAddress == (u32)packet)
+    {
+        sequence = (packet->sequence & ~1u) + 1;
+        frame = packet->frameCounter + 1;
+        if (frame == 0)
+            frame = 1;
+    }
+    snapshot.flags = field ? TAICHUNG_NAVIGATION_FIELD : 0;
+    snapshot.localX = -1;
+    snapshot.localY = -1;
+    snapshot.mapGroup = 0xFF;
+    snapshot.mapNum = 0xFF;
+    snapshot.contextFlags = GetHiddenContext(gameCallbacksRan, field);
+    if (field && !(snapshot.contextFlags & TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE))
+        snapshot.flags |= TAICHUNG_NAVIGATION_READY;
+    if (snapshot.contextFlags == 0)
+        ReadFieldPosition(&snapshot);
+
+    // Every shared write is volatile and sequenced between odd/even markers.
+    // The browser must reread sequence after copying and reject a changed value.
+    packet->sequence = sequence;
+    packet->magicA = TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A;
+    packet->magicB = TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B;
+    packet->version = TAICHUNG_NAVIGATION_BRIDGE_VERSION;
+    packet->size = TAICHUNG_NAVIGATION_BRIDGE_SIZE;
+    packet->selfGbaAddress = (u32)packet;
+    packet->frameCounter = frame;
+    packet->flags = snapshot.flags;
+    packet->localX = snapshot.localX;
+    packet->localY = snapshot.localY;
+    packet->mapGroup = snapshot.mapGroup;
+    packet->mapNum = snapshot.mapNum;
+    packet->facing = snapshot.facing;
+    packet->mapType = snapshot.mapType;
+    packet->mapWidth = snapshot.mapWidth;
+    packet->mapHeight = snapshot.mapHeight;
+    packet->contextFlags = snapshot.contextFlags;
+    packet->reserved16 = 0;
+    packet->reserved32 = 0;
+    sequence++;
+    packet->sequence = sequence == 0 ? 2 : sequence;
+}
diff --git a/src/taichung_onboarding.c b/src/taichung_onboarding.c
new file mode 100644
index 0000000..c9b0138
--- /dev/null
+++ b/src/taichung_onboarding.c
@@ -0,0 +1,277 @@
+#include "global.h"
+#include "event_data.h"
+#include "field_message_box.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "quest_log.h"
+#include "script.h"
+#include "string_util.h"
+#include "taichung_language.h"
+#include "taichung_onboarding.h"
+#include "taichung_starter.h"
+#include "constants/maps.h"
+
+EWRAM_DATA volatile struct TaichungOnboardingBridge gTaichungOnboardingBridge = {0};
+static EWRAM_DATA u16 sWaitFrames = 0;
+static EWRAM_DATA u8 sWaitKind = 0;
+static EWRAM_DATA bool8 sReleased = FALSE;
+static EWRAM_DATA bool8 sFieldReady = FALSE;
+static EWRAM_DATA bool8 sHintShown = FALSE;
+
+// Story's reviewed bilingual text is supplied in taichung_onboarding_text.c.
+
+static u8 SavedPhase(void)
+{
+    return TaichungOnboardingStage_Phase(gSaveBlock1Ptr->vars[TAICHUNG_ONBOARDING_STAGE_VAR - VARS_START]);
+}
+
+static bool8 IsMap(u8 group, u8 num)
+{
+    return gSaveBlock1Ptr->location.mapGroup == group && gSaveBlock1Ptr->location.mapNum == num;
+}
+
+static bool8 IsWelcome(void)
+{
+    return IsMap(MAP_GROUP(MAP_TAICHUNG_STATION_WELCOME), MAP_NUM(MAP_TAICHUNG_STATION_WELCOME));
+}
+
+static bool8 IsOutdoor(void)
+{
+    return IsMap(MAP_GROUP(MAP_TAICHUNG_OLD_CITY), MAP_NUM(MAP_TAICHUNG_OLD_CITY));
+}
+
+static void Publish(u8 phase, u8 flags)
+{
+    TaichungOnboardingPacket_Context(&gTaichungOnboardingBridge, phase, flags);
+}
+
+static void SetStage(u8 phase)
+{
+    VarSet(TAICHUNG_ONBOARDING_STAGE_VAR, TAICHUNG_ONBOARDING_STAGE_BASE + phase);
+}
+
+void TaichungOnboarding_InitNewGame(void)
+{
+    // Opt in only here. Existing SRAM has no recognized marker and remains
+    // exempt from this tutorial, including all presentation/demo cartridges.
+    SetStage(TAICHUNG_ONBOARDING_LANGUAGE);
+    sWaitKind = 0;
+    sWaitFrames = 0;
+    sReleased = FALSE;
+    sFieldReady = FALSE;
+    sHintShown = FALSE;
+    TaichungOnboardingPacket_Init(&gTaichungOnboardingBridge, (u32)&gTaichungOnboardingBridge);
+}
+
+void TaichungOnboarding_ScriptStartupEligible(void)
+{
+    gSpecialVar_Result = IsWelcome() && SavedPhase() == TAICHUNG_ONBOARDING_LANGUAGE
+        && gSaveBlock1Ptr->vars[TAICHUNG_LANGUAGE_VAR - VARS_START] == 0;
+}
+
+void TaichungOnboarding_ScriptBeginStartup(void)
+{
+    sFieldReady = TRUE; // This call is reachable only after initialized map scripts.
+    sWaitKind = TAICHUNG_ONBOARDING_LANGUAGE;
+    sWaitFrames = 0;
+    sReleased = FALSE;
+    sHintShown = FALSE;
+    Publish(TAICHUNG_ONBOARDING_LANGUAGE, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND);
+}
+
+void TaichungOnboarding_ScriptLanguageReady(void)
+{
+    if (SavedPhase() == TAICHUNG_ONBOARDING_LANGUAGE)
+        SetStage(TAICHUNG_ONBOARDING_WELCOME);
+    Publish(TAICHUNG_ONBOARDING_WELCOME, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+}
+
+void TaichungOnboarding_ScriptWelcome(void)
+{
+    if (SavedPhase() != 0 && SavedPhase() < TAICHUNG_ONBOARDING_OUTDOOR)
+        Publish(TAICHUNG_ONBOARDING_WELCOME, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+}
+
+void TaichungOnboarding_ScriptPartner(void)
+{
+    if (SavedPhase() != 0 && SavedPhase() < TAICHUNG_ONBOARDING_OUTDOOR)
+    {
+        SetStage(TAICHUNG_ONBOARDING_PARTNER);
+        Publish(TAICHUNG_ONBOARDING_PARTNER, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+    }
+}
+
+void TaichungOnboarding_ScriptGranted(void)
+{
+    if (TaichungStarterHasPartner() && SavedPhase() != 0 && SavedPhase() < TAICHUNG_ONBOARDING_OUTDOOR)
+    {
+        SetStage(TAICHUNG_ONBOARDING_OUTDOOR);
+        Publish(TAICHUNG_ONBOARDING_OUTDOOR, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+    }
+}
+
+extern const u8 TaichungOldCity_OnboardingStart[];
+
+bool8 TaichungOnboarding_TryRunOutdoorScript(void)
+{
+    u8 phase = SavedPhase();
+    // The normal field-input path calls this before trainer/step handling.
+    // Return immediately for every existing/finished save and throughout recap
+    // playback. No temp var, saved coordinate, preference or old script changes.
+    if (!IsOutdoor() || phase < TAICHUNG_ONBOARDING_OUTDOOR
+        || phase > TAICHUNG_ONBOARDING_COMPLETE || !TaichungStarterHasPartner()
+        || QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+        return FALSE;
+    ScriptContext_SetupScript(TaichungOldCity_OnboardingStart);
+    return TRUE;
+}
+
+void TaichungOnboarding_ScriptBufferTopic(void)
+{
+    u8 phase = SavedPhase();
+    if (phase < TAICHUNG_ONBOARDING_OUTDOOR || phase > TAICHUNG_ONBOARDING_LANDMARKS)
+        return;
+    Publish(phase, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+    StringCopy(gStringVar4, TaichungText(gTaichungOnboardingTopics[phase - TAICHUNG_ONBOARDING_OUTDOOR][0],
+                                      gTaichungOnboardingTopics[phase - TAICHUNG_ONBOARDING_OUTDOOR][1]));
+}
+
+void TaichungOnboarding_ScriptWaitCard(void)
+{
+    sWaitKind = SavedPhase();
+    sWaitFrames = 0;
+    sReleased = FALSE;
+    Publish(sWaitKind, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND);
+}
+
+void TaichungOnboarding_ScriptAdvance(void)
+{
+    u16 stage = gSaveBlock1Ptr->vars[TAICHUNG_ONBOARDING_STAGE_VAR - VARS_START];
+    VarSet(TAICHUNG_ONBOARDING_STAGE_VAR, TaichungOnboardingStage_Advance(stage));
+    gSpecialVar_Result = SavedPhase() == TAICHUNG_ONBOARDING_COMPLETE;
+}
+
+void TaichungOnboarding_ScriptIsRelease(void)
+{
+    gSpecialVar_Result = SavedPhase() == TAICHUNG_ONBOARDING_COMPLETE;
+}
+
+void TaichungOnboarding_ScriptBufferRelease(void)
+{
+    Publish(TAICHUNG_ONBOARDING_COMPLETE, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+    StringCopy(gStringVar4, TaichungText(gTaichungOnboardingRelease[0], gTaichungOnboardingRelease[1]));
+}
+
+void TaichungOnboarding_ScriptFinish(void)
+{
+    // A distinct done marker means an interrupted farewell resumes only that
+    // farewell. Commit completion only after the final native message closes.
+    if (SavedPhase() != TAICHUNG_ONBOARDING_COMPLETE)
+        return;
+    VarSet(TAICHUNG_ONBOARDING_STAGE_VAR, TAICHUNG_ONBOARDING_DONE_STAGE);
+    Publish(TAICHUNG_ONBOARDING_COMPLETE, TAICHUNG_ONBOARDING_READY);
+}
+
+static bool8 CanRunGate(bool8 callbacksRan)
+{
+    return callbacksRan && Overworld_IsMainFieldCallback() && !gMain.inBattle
+        && ArePlayerFieldControlsLocked() && !ScriptContext_IsEnabled()
+        && !gPaletteFade.active && !QL_IS_PLAYBACK_STATE
+        && QL_GetPlaybackState() != QL_PLAYBACK_STATE_RUNNING;
+}
+
+static void Resume(u8 nextPhase, u16 result)
+{
+    sWaitKind = 0;
+    Publish(nextPhase, TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+    gSpecialVar_Result = result;
+    ScriptContext_Enable();
+}
+
+void TaichungOnboarding_Tick(bool8 callbacksRan)
+{
+    volatile struct TaichungOnboardingBridge *p = &gTaichungOnboardingBridge;
+    struct TaichungOnboardingRequest request;
+    u8 command;
+    bool8 edge;
+
+    if (p->magicA != TAICHUNG_ONBOARDING_MAGIC_A || p->magicB != TAICHUNG_ONBOARDING_MAGIC_B
+        || p->version != TAICHUNG_ONBOARDING_VERSION || p->size != TAICHUNG_ONBOARDING_SIZE
+        || p->selfGbaAddress != (u32)p)
+        TaichungOnboardingPacket_Init(p, (u32)p);
+    TaichungOnboardingPacket_Begin(p);
+    if (Overworld_IsMainFieldCallback())
+        sFieldReady = TRUE;
+    if (!sFieldReady || gSaveBlock1Ptr == NULL)
+    {
+        TaichungOnboardingPacket_End(p);
+        return;
+    }
+    p->activeLanguage = gSaveBlock1Ptr->vars[TAICHUNG_LANGUAGE_VAR - VARS_START];
+    p->mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    p->mapNum = gSaveBlock1Ptr->location.mapNum;
+    p->x = gSaveBlock1Ptr->pos.x;
+    p->y = gSaveBlock1Ptr->pos.y;
+    TaichungOnboardingPacket_End(p);
+
+    if (!sWaitKind)
+    {
+        // Settle late requests after a phase closed without executing them.
+        TaichungOnboardingPacket_Request(p, &request);
+        return;
+    }
+    if (!CanRunGate(callbacksRan))
+        return;
+    if (sWaitKind == TAICHUNG_ONBOARDING_LANGUAGE && (!IsWelcome() || SavedPhase() != TAICHUNG_ONBOARDING_LANGUAGE))
+        return;
+    if (sWaitKind != TAICHUNG_ONBOARDING_LANGUAGE && (!IsOutdoor() || sWaitKind != SavedPhase()))
+        return;
+    if (sWaitKind == TAICHUNG_ONBOARDING_LANGUAGE && sHintShown)
+    {
+        u8 flags = TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND;
+        if (!IsFieldMessageBoxHidden())
+            flags |= TAICHUNG_ONBOARDING_NATIVE_TEXT;
+        if (p->flags != flags)
+            Publish(TAICHUNG_ONBOARDING_LANGUAGE, flags);
+    }
+    command = TaichungOnboardingPacket_Request(p, &request);
+    if (command == TAICHUNG_ONBOARDING_APPLY_LANGUAGE)
+    {
+        if (VarSet(TAICHUNG_LANGUAGE_VAR, request.language))
+        {
+            TaichungOnboardingPacket_Begin(p);
+            p->activeLanguage = request.language;
+            TaichungOnboardingPacket_End(p);
+            Resume(TAICHUNG_ONBOARDING_WELCOME, TRUE);
+            TaichungOnboardingPacket_Ack(p, request.sequence, TAICHUNG_ONBOARDING_RESULT_APPLIED);
+        }
+        return;
+    }
+    if (command == TAICHUNG_ONBOARDING_ACK_CARD)
+    {
+        Resume(sWaitKind, TRUE);
+        TaichungOnboardingPacket_Ack(p, request.sequence, TAICHUNG_ONBOARDING_RESULT_APPLIED);
+        return;
+    }
+
+    if (sWaitFrames < 0xFFFF)
+        sWaitFrames++;
+    if (!(gMain.heldKeys & (A_BUTTON | B_BUTTON)))
+        sReleased = TRUE;
+    edge = sReleased && sWaitFrames > 2 && (gMain.newKeys & (A_BUTTON | B_BUTTON));
+    if (sWaitKind == TAICHUNG_ONBOARDING_LANGUAGE)
+    {
+        if (!sHintShown && sWaitFrames >= 300 && IsFieldMessageBoxHidden())
+        {
+            ShowFieldMessage(gTaichungOnboardingLanguageHint);
+            sHintShown = TRUE;
+            Publish(TAICHUNG_ONBOARDING_LANGUAGE, TAICHUNG_ONBOARDING_READY
+                | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND | TAICHUNG_ONBOARDING_NATIVE_TEXT);
+        }
+        if (edge)
+            Resume(TAICHUNG_ONBOARDING_FALLBACK, FALSE);
+    }
+    else if (edge)
+        Resume(sWaitKind, TRUE);
+}
diff --git a/src/taichung_onboarding_protocol.c b/src/taichung_onboarding_protocol.c
new file mode 100644
index 0000000..527764b
--- /dev/null
+++ b/src/taichung_onboarding_protocol.c
@@ -0,0 +1,137 @@
+#include <stddef.h>
+#include "taichung_onboarding.h"
+
+typedef char PacketSizeCheck[sizeof(struct TaichungOnboardingBridge) == 48 ? 1 : -1];
+typedef char RequestOffsetCheck[offsetof(struct TaichungOnboardingBridge, requestSequence) == 28 ? 1 : -1];
+typedef char ContextOffsetCheck[offsetof(struct TaichungOnboardingBridge, requestedContext) == 36 ? 1 : -1];
+typedef char PositionOffsetCheck[offsetof(struct TaichungOnboardingBridge, x) == 44 ? 1 : -1];
+
+static u32 Increment(u32 value)
+{
+    value++;
+    return value == 0 ? 1 : value;
+}
+
+void TaichungOnboardingPacket_Begin(volatile struct TaichungOnboardingBridge *p)
+{
+    p->frameCounter++; // The prior publication is always even.
+}
+
+void TaichungOnboardingPacket_End(volatile struct TaichungOnboardingBridge *p)
+{
+    p->frameCounter++;
+    if (p->frameCounter == 0)
+        p->frameCounter = 2;
+}
+
+void TaichungOnboardingPacket_Init(volatile struct TaichungOnboardingBridge *p, u32 address)
+{
+    p->magicA = 0;
+    p->magicB = 0;
+    p->version = TAICHUNG_ONBOARDING_VERSION;
+    p->size = TAICHUNG_ONBOARDING_SIZE;
+    p->selfGbaAddress = address;
+    p->frameCounter = 1;
+    p->contextSequence = 1;
+    p->phase = 0;
+    p->flags = 0;
+    p->activeLanguage = 0;
+    p->result = 0;
+    p->requestSequence = 0;
+    p->ackSequence = 0;
+    p->requestedContext = 0;
+    p->command = 0;
+    p->requestedLanguage = 0;
+    p->mapGroup = 0;
+    p->mapNum = 0;
+    p->x = 0;
+    p->y = 0;
+    p->magicB = TAICHUNG_ONBOARDING_MAGIC_B;
+    p->magicA = TAICHUNG_ONBOARDING_MAGIC_A;
+    TaichungOnboardingPacket_End(p);
+}
+
+void TaichungOnboardingPacket_Context(volatile struct TaichungOnboardingBridge *p, u8 phase, u8 flags)
+{
+    // Zero is never an actionable context. Invalidate before changing the
+    // phase/flags, then publish a fresh context after the entire boundary.
+    u32 next = Increment(p->contextSequence);
+    TaichungOnboardingPacket_Begin(p);
+    p->contextSequence = 0;
+    p->flags = 0;
+    p->phase = phase;
+    p->flags = flags;
+    p->contextSequence = next;
+    TaichungOnboardingPacket_End(p);
+}
+
+void TaichungOnboardingPacket_Ack(volatile struct TaichungOnboardingBridge *p, u32 sequence, u8 result)
+{
+    TaichungOnboardingPacket_Begin(p);
+    p->result = result;
+    p->ackSequence = sequence;
+    TaichungOnboardingPacket_End(p);
+}
+
+u8 TaichungOnboardingPacket_Request(volatile struct TaichungOnboardingBridge *p, struct TaichungOnboardingRequest *request)
+{
+    u32 sequence = p->requestSequence;
+    u32 context = p->requestedContext;
+    u8 command = p->command;
+    u8 requested = p->requestedLanguage;
+
+    if (sequence == 0 || sequence == p->ackSequence)
+        return 0;
+    if (sequence != p->requestSequence || context != p->requestedContext
+        || command != p->command || requested != p->requestedLanguage)
+        return 0;
+    if (context == 0 || context != p->contextSequence)
+    {
+        TaichungOnboardingPacket_Ack(p, sequence, TAICHUNG_ONBOARDING_RESULT_STALE);
+        return 0;
+    }
+    if ((p->flags & (TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND))
+        != (TAICHUNG_ONBOARDING_READY | TAICHUNG_ONBOARDING_ACCEPTS_COMMAND))
+    {
+        TaichungOnboardingPacket_Ack(p, sequence, TAICHUNG_ONBOARDING_RESULT_NOT_READY);
+        return 0;
+    }
+    if (command == TAICHUNG_ONBOARDING_APPLY_LANGUAGE
+        && p->phase == TAICHUNG_ONBOARDING_LANGUAGE && (requested == 1 || requested == 2))
+    {
+        request->sequence = sequence;
+        request->language = requested;
+        return command;
+    }
+    if (command == TAICHUNG_ONBOARDING_ACK_CARD && requested == 0
+        && p->phase >= TAICHUNG_ONBOARDING_OUTDOOR && p->phase <= TAICHUNG_ONBOARDING_LANDMARKS)
+    {
+        // Startup may accept language while its fallback hint prints; tutorial
+        // cards must wait until the native text/menu has relinquished input.
+        if (p->flags & TAICHUNG_ONBOARDING_NATIVE_TEXT)
+        {
+            TaichungOnboardingPacket_Ack(p, sequence, TAICHUNG_ONBOARDING_RESULT_NOT_READY);
+            return 0;
+        }
+        request->sequence = sequence;
+        request->language = 0;
+        return command;
+    }
+    TaichungOnboardingPacket_Ack(p, sequence, TAICHUNG_ONBOARDING_RESULT_INVALID);
+    return 0;
+}
+
+u8 TaichungOnboardingStage_Phase(u16 stage)
+{
+    if (stage <= TAICHUNG_ONBOARDING_STAGE_BASE || stage > TAICHUNG_ONBOARDING_STAGE_BASE + TAICHUNG_ONBOARDING_COMPLETE)
+        return TAICHUNG_ONBOARDING_INACTIVE;
+    return stage - TAICHUNG_ONBOARDING_STAGE_BASE;
+}
+
+u16 TaichungOnboardingStage_Advance(u16 stage)
+{
+    u8 phase = TaichungOnboardingStage_Phase(stage);
+    if (phase >= TAICHUNG_ONBOARDING_OUTDOOR && phase < TAICHUNG_ONBOARDING_COMPLETE)
+        return stage + 1;
+    return stage;
+}
