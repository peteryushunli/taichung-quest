+#!/usr/bin/env python3
+"""Fill the approved64x64 old-core lots; preserve all authored reservations."""
+import argparse
+from collections import Counter,deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image,ImageDraw
+
+from color_compile import compile_colorways,color_grid,native_tile_images,save_native
+from library import ROOT,WALK,require
+from neighborhood_pilot import player_reference
+
+
+def geometry_helpers():
+    spec=importlib.util.spec_from_file_location('taichung_geography_pilot',ROOT/'tools/taichung/geography/profile_pilot.py')
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    return module
+
+
+def cells(rect):
+    return {(x,y) for y in range(rect[1],rect[3]+1) for x in range(rect[0],rect[2]+1)}
+
+
+def context_for(prefab,band):
+    preferences=['shopping','market','mixed-use','neighborhood-centre','transport-plaza'] if band=='primaryRetailFrontage' else ['residential','mixed-use','residential-corner','neighborhood-centre','shopping','park-edge']
+    return next((c for c in preferences if c in prefab['allowedContext']),prefab['allowedContext'][0])
+
+
+def fill_layout(compiled,layout,profile):
+    width,height=layout['width'],layout['height'];require((width,height)==(64,64),'Only approved64x64 pilot supported by this helper')
+    geo=geometry_helpers();roads=set().union(*(geo.line_cells(r['authoredLocalCenterline'],r['widthTiles']) for r in layout['authoredRoads']))
+    approaches=set().union(*(cells(a['rect']) for a in layout['clearApproaches']))
+    gym_reserves=set().union(*(cells(l['proposedAuthoredLocal']['reserveRect']) for l in layout['landmarks']))
+    gym_art=set().union(*(cells(l['proposedAuthoredLocal']['artRect']) for l in layout['landmarks']))
+    require(not roads&gym_art,'Authored road crosses gym art envelope')
+    protected=roads|approaches;base=[0x3001]*(width*height)
+    for x,y in roads:base[y*width+x]=0x316e
+    for x,y in approaches:base[y*width+x]=0x3175
+    # Gym art stays explicitly reserved. Solid normal tiles prevent a fake shortcut
+    # through a future façade; no decorative door or active warp is invented.
+    for x,y in gym_art:base[y*width+x]=0x056e
+    lib=compiled['library'];placements=[];lot_records=[];role_counts={};variant_counts=Counter()
+    for lot in layout['candidateLots']:
+        band=lot['streetBand'];targets=profile['streetBands'][band];weights=targets['prefabRoleWeights'];counts=role_counts.setdefault(band,Counter())
+        compatible=[lib.prefabs[i] for i in lot['compatibleSizeOnlyPrefabIds'] if lib.prefabs[i]['role'] in weights]
+        require(bool(compatible),f'No role-compatible module for{lot["id"]}')
+        n=sum(counts.values())+1;roles=sorted({p['role'] for p in compatible})
+        role=max(roles,key=lambda r:(weights.get(r,0)*n-counts[r],r))
+        options=[p for p in compatible if p['role']==role]
+        if role=='residential-walkup':
+            # Taller bays form a rhythm when envelopes allow, not random heights.
+            choice='building-walkup-tall' if lot['height']>=8 and counts[role]%2==0 else 'building-walkup-low'
+            options.sort(key=lambda p:(p['id']==choice,p['width']*p['bodyHeight']),reverse=True)
+        else:options.sort(key=lambda p:(p['width']*p['bodyHeight'],p['width']),reverse=True)
+        p=options[0];x0,y0,x1,y1=lot['localRect'];x=x0+(lot['width']-p['width'])//2;y=y1-p['height']+1
+        family='source'
+        if p['id'] in compiled['recipe']['eligiblePrefabs']:
+            if x0>=44:family='slate'
+            elif x0>=28:family='teal'
+            else:family='terracotta'
+            if band=='primaryRetailFrontage' and lot['id']=='pilot-r2c2-lot-18-32':family='mustard'
+            if band=='residentialSideStreet' and lot['id']=='pilot-r2c2-lot-2-12':family='source'
+        placement=dict(id=lot['id']+'-building',prefab=p['id'],x=x,y=y,context=context_for(p,band),colorway=family)
+        require(cells([x,y,x+p['width']-1,y+p['height']-1])<=cells(lot['localRect']),'Building patch overflows authored lot')
+        require(not cells(lot['localRect'])&gym_reserves,'Lot overlaps gym reservation')
+        if band=='primaryRetailFrontage':
+            for xx,yy in cells(lot['localRect']):base[yy*width+xx]=0x3175
+        placements.append(placement);counts[role]+=1;variant_counts[family]+=1
+        lot_records.append(dict(lotId=lot['id'],localRect=lot['localRect'],streetBand=band,
+            selectedPrefabId=p['id'],placement=[x,y],colorway=family,role=role,
+            authoredAgeStyle='contemporary' if family=='teal' and role=='residential-walkup' else 'olderMasonry' if family=='terracotta' else 'midEraMixedUse',
+            status='authored game use/age treatment; not a surveyed parcel classification',decorations=[]))
+    # Start with all main buildings, then add only decorations wholly within
+    # their own lot and accepted by the same collision/apron preflight.
+    def compose(items):
+        bare=[{k:v for k,v in p.items() if k!='colorway'} for p in items]
+        return lib.compose(width,height,bare,base=base,protected_paths=protected)
+    composed=compose(placements)
+    for lot,record in zip(layout['candidateLots'],lot_records):
+        desired=['prop-sign-board','prop-flower-bed'] if lot['streetBand']=='primaryRetailFrontage' else ['prop-shrub']
+        for identity in desired:
+            p=lib.prefabs[identity];x0,y0,x1,y1=lot['localRect'];placed=False
+            for y in range(y0,y1-p['height']+2):
+                for x in range(x0,x1-p['width']+2):
+                    candidate=dict(id=lot['id']+'-'+identity,prefab=identity,x=x,y=y,
+                        context='street' if identity=='prop-sign-board' else 'residential',colorway='source')
+                    if candidate['context'] not in p['allowedContext']:candidate['context']=p['allowedContext'][0]
+                    try:new_composition=compose(placements+[candidate])
+                    except ValueError:continue
+                    placements.append(candidate);composed=new_composition;record['decorations'].append(dict(prefab=identity,placement=[x,y]));placed=True;break
+                if placed:break
+    words=color_grid(compiled,composed,placements)
+    for p in placements:
+        prefab=lib.prefabs[p['prefab']];lot_id=p['id'].split('-building')[0] if '-building' in p['id'] else next(r['lotId'] for r in lot_records if p['id'].startswith(r['lotId']+'-'))
+        lot=next(l for l in layout['candidateLots'] if l['id']==lot_id)
+        footprint=cells([p['x'],p['y'],p['x']+prefab['width']-1,p['y']+prefab['height']-1])
+        require(footprint<=cells(lot['localRect']),'Decorative patch or apron overflows lot')
+        require(not footprint&gym_reserves,'Decorative patch enters gym reserve')
+    def attr(word):
+        t=word&1023;return lib.attr(t) if t<640 else compiled['attributes'][t-640]
+    def walk(x,y):
+        if not(0<=x<width and 0<=y<height):return False
+        w=words[y*width+x];return not w&0xc00 and w>>12==3 and attr(w)&0x1ff in WALK
+    arrivals=[tuple(l['proposedAuthoredLocal']['arrival']) for l in layout['landmarks']];spawn=arrivals[0];seen={spawn};queue=deque([spawn])
+    while queue:
+        x,y=queue.popleft()
+        for n in ((x+1,y),(x-1,y),(x,y+1),(x,y-1)):
+            if n not in seen and walk(*n):seen.add(n);queue.append(n)
+    for arrival in arrivals:require(arrival in seen,f'Unreachable landmark south arrival:{arrival}')
+    require(protected<=seen,'Road or landmark approach disconnected after fill')
+    for e in composed['entrances']:
+        require(e['status']=='dormant-reservation' and tuple(e['southApproach']) in seen,'Unreachable/active ordinary-building entrance')
+    for port in layout['independentSeamSuggestions']:require(tuple(port['localPoint']) in seen,'Road egress disconnected')
+    require(all((w&0xfc00)==(old&0xfc00) for w,old in zip(words,composed['words'])),'Color pass changed collision/elevation')
+    require(not any(attr(w)&0x1ff in range(0x60,0x70) for w in words),'Unregistered fill contains warp behavior')
+    report=dict(result='pass',status='source-composed64x64 pilot; no registered map/warp changes',sectionId=layout['sectionId'],
+        dimensions=[width,height],filledLots=len(lot_records),ordinaryBuildings=len(lot_records),decorativeModules=len(placements)-len(lot_records),
+        reachableCells=len(seen),protectedRoadAndApproachCells=len(protected),landmarkSouthArrivals=arrivals,
+        ordinaryDormantEntranceApproaches=len(composed['entrances']),roadEgresses=len(layout['independentSeamSuggestions']),
+        decorativeOverflows=0,roadOrGymReserveCollisions=0,roofColorCounts=dict(variant_counts),roleCounts={k:dict(v) for k,v in role_counts.items()},
+        sourceLayoutSha256=hashlib.sha256(json.dumps(layout,sort_keys=True).encode()).hexdigest(),
+        profileId=profile['id'],nativeBankBudget=compiled['budget'])
+    return words,placements,lot_records,report,roads,approaches
+
+
+def write_fill(output):
+    layout_path=ROOT/'data/taichung/neighborhoods/pilot-r2c2-layout.json';profile_path=ROOT/'data/taichung/neighborhoods/pilot-profile.json'
+    layout=json.loads(layout_path.read_text());profile=json.loads(profile_path.read_text())['section'];compiled=compile_colorways()
+    words,placements,lots,report,roads,approaches=fill_layout(compiled,layout,profile)
+    output=Path(output);output.mkdir(parents=True,exist_ok=True);w,h=layout['width'],layout['height'];tiles=native_tile_images(compiled,{v&1023 for v in words})
+    image=Image.new('RGB',(w*16,h*16))
+    for i,word in enumerate(words):image.paste(tiles[word&1023],(i%w*16,i//w*16))
+    sprite=player_reference(ROOT)
+    if sprite:
+        x,y=report['landmarkSouthArrivals'][0];image.paste(sprite,(x*16,y*16-16),sprite)
+    image.save(output/'filled-block-native.png')
+    board=Image.new('RGB',(1024,1120),'#e9efeb');board.paste(image,(0,64));draw=ImageDraw.Draw(board)
+    draw.text((12,10),'R2C2 OLD CORE /24 AUTHORED LOTS FILLED / SOURCE-NATIVE COLOR STUDY',fill='#19392f')
+    draw.text((12,28),'Warm older residential runs; taller slate/teal bays; closer retail/market frontage. Gym art remains reserved.',fill='#365a4b')
+    draw.text((12,46),'Municipal road source + approved authored streets. Building use/age assignments are game design, not a parcel survey.',fill='#365a4b')
+    for landmark in layout['landmarks']:
+        r=landmark['proposedAuthoredLocal']['artRect'];box=(r[0]*16,r[1]*16+64,(r[2]+1)*16-1,(r[3]+1)*16+63)
+        draw.rectangle(box,outline='#ab642b',width=2);draw.text((box[0]+4,box[1]+5),landmark['name'],fill='#6b452b');draw.text((box[0]+4,box[1]+20),'GYM ART RESERVE',fill='#6b452b')
+    draw.text((12,1090),'All3 landmark south arrivals, roads and dormant front approaches remain reachable. No native ROM registration yet.',fill='#365a4b')
+    board.save(output/'filled-block-overview.png')
+    (output/'filled-map.bin').write_bytes(struct.pack(f'<{len(words)}H',*words))
+    (output/'placements.json').write_text(json.dumps(dict(schemaVersion=1,sectionId=layout['sectionId'],placements=placements,lots=lots),indent=2)+'\n')
+    (output/'validation.json').write_text(json.dumps(report,indent=2)+'\n')
+    save_native(compiled,output/'native-color-bank')
+    print(json.dumps({k:v for k,v in report.items() if k not in ('nativeBankBudget','roleCounts')},indent=2));print(output/'filled-block-overview.png')
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--output',type=Path,required=True);args=parser.parse_args();write_fill(args.output)
