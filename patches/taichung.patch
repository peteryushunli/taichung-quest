@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Run the release-cleanup qualification, then the full Story guard runner in its view.
+
+The Story runner in turn replays every older source guard and the capture host
+regressions. Writes ignored host-test logs only; no ROM, UI or runtime claim.
+"""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/release-cleanup-guards"
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("release_cleanup_qualification", ROOT / "tools/taichung/release_cleanup_guard.py")
+cleanup = importlib.util.module_from_spec(spec); spec.loader.exec_module(cleanup)
+env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
+env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+checks = {}
+
+
+def run(name, command, source=ROOT):
+    result = subprocess.run(command, cwd=source, env=env, capture_output=True, text=True)
+    (OUT / (name + ".log")).write_text(result.stdout + result.stderr)
+    checks[name] = dict(passed=result.returncode == 0, exitCode=result.returncode)
+    if result.returncode:
+        raise RuntimeError(name + " failed:\n" + (result.stdout + result.stderr)[-6000:])
+    print("PASS: " + name, flush=True)
+
+
+try:
+    run("cleanup-source-corruptions", [sys.executable, "-B", "tools/taichung/release_cleanup_guard.py", "--self-test"])
+    with cleanup.qualified_mirror(ROOT) as view:
+        run("story-and-all-previous-guards", [sys.executable, "-B", "tools/taichung_gameplay/test-compact-story-guards.py"], view)
+finally:
+    (OUT / "receipt.json").write_text(json.dumps(dict(passed=len(checks) == 2 and all(r["passed"] for r in checks.values()),
+        base=cleanup.BASE, checks=checks, runtimeAcceptanceClaimed=False), indent=2) + "\n")
diff --git a/tools/taichung_gameplay/test-save-facing.py b/tools/taichung_gameplay/test-save-facing.py
