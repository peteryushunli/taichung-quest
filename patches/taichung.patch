+#!/usr/bin/env python3
+"""Qualify the frozen all20 Story source before running unchanged older guards.
+
+Only seven exact Story-edited inputs may yield native586 baseline bytes. Every
+added input and dependency is proved first. No runtime, map, Save or old guard is
+written or re-registered. --previous-guards runs fixed historical source suites
+in a qualified temporary view, never a build or arbitrary command.
+"""
+from __future__ import annotations
+import argparse
+import contextlib
+import hashlib
+from io import BytesIO
+import json
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+LAYER = "data/taichung/compact-story-guard"
+REGISTRATION = LAYER + "/registration.json"
+BUNDLE = LAYER + "/baseline.zip"
+REGISTRATION_SHA256 = "f3863c84f60caa2c1bff56fb8f4e052c1f2e66dab44998cbc01113affed7146b"
+BASE = "586b8a84089b338b6c3971cc90604daa57fadb76"
+FEATURE = "1855002b7413d34f6cd30e6648fe541d75c0e24f"
+GEOMETRY = "48fe4ba5208d0a2b1285c1b6aa6f776377ef003d5501e5ae837ca45c6127e92a"
+CHARMAP = "charmap.txt"
+GLYPHS = "src/data/taichung_glyphs.h"
+MANIFEST = "data/taichung/optional-story/manifest.json"
+INTRODUCED_INPUTS = (
+    'data/scripts/taichung_optional_story.inc',
+    'data/scripts/taichung_optional_story_bindings.inc',
+    'data/taichung/optional-story/botanical-garden.json',
+    'data/taichung/optional-story/calligraphy-greenway.json',
+    'data/taichung/optional-story/confucius-temple.json',
+    'data/taichung/optional-story/cultural-heritage-park.json',
+    'data/taichung/optional-story/fengjia-night-market.json',
+    'data/taichung/optional-story/fengle-sculpture-park.json',
+    'data/taichung/optional-story/fine-arts-museum.json',
+    'data/taichung/optional-story/manifest.json',
