+# The registered Nantun rework grows North and Wanhe to the master plan and moves
+# their events, contract points and connections with them. Its own guard proves
+# that delta; frozen guards read Nantun's files and shared-file entries from the
+# rework's base, and only when the tree holds exactly the rework's registered output.
+NANTUN_REWORK_GUARD = "tools/taichung/nantun/check_nantun.py"
+
+
+def nantun_rework_underneath(files):
+    path = Path(files.source)/NANTUN_REWORK_GUARD
+    if not path.exists():
+        return {}
+    spec = importlib.util.spec_from_file_location("registered_nantun_rework_guard", path)
+    guard = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(guard)
+    return guard.rework_underneath(files)
