+int main(void){struct Mon before[6];u8 level,i;count=1;sSpecies=82;
+for(level=5;level<=80;level+=25){gPlayerParty[0].species=82;gPlayerParty[0].level=level;gPlayerParty[0].hp=0;for(i=0;i<4;i++){gPlayerParty[0].moves[i]=31+i;gPlayerParty[0].pp[i]=i;}memcpy(before,gPlayerParty,sizeof(before));
+assert(KeepingCurrentPartner()&&ChoiceLevel()==level);for(i=0;i<4;i++)assert(ChoiceMove(i)==31+i);assert(!memcmp(before,gPlayerParty,sizeof(before)));}
+sSpecies=6;assert(!KeepingCurrentPartner()&&ChoiceLevel()==65);for(i=0;i<4;i++)assert(ChoiceMove(i)==preset[i]);sSpecies=82;sSlot=1;assert(!KeepingCurrentPartner()&&ChoiceLevel()==65);
+puts("PASS: saved fainted/legacy partner preview uses actual level/moves without mutation; new/append choices use the captured level and preset. Same-slot UI no longer promises a heal/replacement.");}
+''')
