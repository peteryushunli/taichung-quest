+static void TestOldCityV8Migration(void)
+{
+    struct SaveBlock1 before;
+    unsigned version, i, x, count, map, pending;
+    static const u8 positions[][2] = {{30,66},{24,23},{12,47}};
+    for (version = 1; version <= 7; version++)
+    {
+        // The building swap keeps collision, so every neighbouring position reloads on its own tile.
+        count = 0;
+        for (i = 0; i < COUNT(sOldCityV8BuildingNeighbours); i++)
+            for (x = sOldCityV8BuildingNeighbours[i][1]; x <= sOldCityV8BuildingNeighbours[i][2]; x++)
+            {
+                Versioned(version); InOldCity(x,sOldCityV8BuildingNeighbours[i][0]); before = sSave;
+                TaichungSaveUpgradeOnContinue(); AssertWarp(x,sOldCityV8BuildingNeighbours[i][0]);
+                assert(sWarpRequests == 1); AssertSamePartyAndVars(&before); count++;
+            }
+        assert(count == 231);
+        // A pending native return already reloads the map and has no v8 repair, only its v10 cell.
+        Versioned(version); InOldCity(12,47); sHasContinueWarp = TRUE;
+        sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1;
+        sSave.continueGameWarp.x = 12; sSave.continueGameWarp.y = 47; before = sSave;
+        TaichungSaveUpgradeOnContinue(); assert(sHasContinueWarp && sWarpRequests == 0);
+        AssertPendingV10(&before.continueGameWarp);
+        AssertSamePartyAndVars(&before);
+    }
+    // v7 refreshes OldCity (buildings) and Xitun (streets); every interior and other district stays put.
+    for (map = 0; map < 3; map++)
+    {
+        bool8 expected = TRUE; // v8 reloads OldCity (buildings), Xitun (streets) and Greenway (Nantun seam pavers).
+        Versioned(7); InOldCity(positions[map][0],positions[map][1]); sSave.location.mapNum = map; before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(sHasContinueWarp == expected && sWarpRequests == (unsigned)expected);
+        if (!expected)
+            assert(memcmp(&sSave.continueGameWarp,&before.continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+        else
+            AssertDistrictWarp(map,before.pos.x,before.pos.y); // Same tile, moved only by v10.
+        AssertSamePartyAndVars(&before);
+    }
+    for (map = 3; map <= 14; map++)
+    {
+        Versioned(7); if (map < 14) { InOldCity(6,9); sSave.location.mapNum = map; } before = sSave;
+        TaichungSaveUpgradeOnContinue(); AssertRoomKept(&before);
+        AssertSamePartyAndVars(&before);
+    }
+    // A v7 Xitun save now reloads for the streets; TestXitunV8Migration covers its repairs.
+    Versioned(7); InXitun(19,8); before = sSave; TaichungSaveUpgradeOnContinue();
+    AssertXitunAfter(7,19,8); assert(sWarpRequests == 1); AssertSamePartyAndVars(&before);
+    // Current and future saves keep every byte, with or without a pending return.
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+        for (pending = 0; pending < 2; pending++)
+        {
+            Versioned(version); InOldCity(12,47); sHasContinueWarp = pending;
+            sSave.continueGameWarp = sSave.location; sSave.continueGameWarp.warpId = -1;
+            sSave.continueGameWarp.x = 12; sSave.continueGameWarp.y = 47; before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            assert(memcmp(&sSave,&before,sizeof(sSave)) == 0);
+            assert(sWarpRequests == 0 && sVariableWrites == 0 && sChallengeCancels == 1 && sHasContinueWarp == pending);
+        }
+    Versioned(7); InOldCity(12,47); TaichungSaveUpgradeOnContinue();
+    assert(sWarpRequests == 1 && sVariableWrites == 1 && sChallengeCancels == 1);
+    sHasContinueWarp = FALSE; before = sSave; TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave,&before,sizeof(sSave)) == 0 && !sHasContinueWarp);
+    assert(sWarpRequests == 1 && sVariableWrites == 1 && sChallengeCancels == 2);
+}
