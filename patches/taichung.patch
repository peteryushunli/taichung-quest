+    # Stable ID, room suffix, region, door, arrival, English, Traditional Chinese, source facade.
+    ("old-taichung-station", "OldStation", "OLD_CITY", (32, 64), (30, 66), "Old Taichung Station", "舊臺中車站", "museum"),
+    ("taichung-park", "Park", "OLD_CITY", (32, 30), (32, 34), "Taichung Park", "臺中公園", "house"),
+    ("miyahara", "Miyahara", "OLD_CITY", (20, 52), (20, 55), "Miyahara", "宮原眼科", "house"),
+    ("natural-science-museum", "ScienceMuseum", "GREENWAY", (24, 20), (24, 23), "Science Museum", "國立自然科學博物館", "museum"),
+    ("calligraphy-greenway", "Greenway", "GREENWAY", (22, 36), (22, 39), "Calligraphy Greenway", "草悟道／市民廣場", "gym"),
+    ("shen-ji-new-village", "ShenJi", "GREENWAY", (10, 44), (10, 47), "Shen Ji New Village", "審計新村", "house"),
+    ("fine-arts-museum", "FineArts", "GREENWAY", (10, 62), (10, 65), "Fine Arts Museum", "國立臺灣美術館", "museum"),
+    ("fengjia-night-market", "Fengjia", "XITUN", (24, 12), (24, 15), "Fengjia Night Market", "逢甲夜市", "gym"),
+    ("maple-garden", "MapleGarden", "XITUN", (12, 32), (12, 35), "Maple Garden", "秋紅谷", "house"),
+    ("taichung-theater", "Theater", "XITUN", (12, 44), (12, 47), "National Taichung Theater", "臺中國家歌劇院", "museum"),
