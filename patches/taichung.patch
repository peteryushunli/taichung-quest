+    entries=[e for group in compiled['metatiles'] for e in group]
+    (out/'metatiles.bin').write_bytes(struct.pack(f'<{len(entries)}H',*entries))
+    (out/'metatile_attributes.bin').write_bytes(struct.pack(f"<{len(compiled['attributes'])}I",*compiled['attributes']))
+    palette=compiled['palettes'][12]
+    (out/'12.pal').write_text('JASC-PAL\n0100\n16\n'+'\n'.join(' '.join(map(str,c)) for c in palette)+'\n')
+    (out/'12.gbapal').write_bytes(struct.pack('<16H',*(r//8|(g//8)<<5|(b//8)<<10 for r,g,b in palette)))
+    png=Image.new('P',(128,((len(pixels)+15)//16)*8));flat=[v for color in palette for v in color]+[0]*(768-48);png.putpalette(flat)
+    for n,row in enumerate(pixels):
+        for y in range(8):
+            for x in range(8):png.putpixel((n%16*8+x,n//16*8+y),row[y*8+x])
+    png.save(out/'tiles.png')
+    metadata=dict(schemaVersion=1,status='native-encoded source integration fixture; not registered in ROM',**compiled['budget'])
+    (out/'compile-manifest.json').write_text(json.dumps(metadata,indent=2)+'\n')
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--output',type=Path,required=True);args=parser.parse_args()
+    result=compile_colorways();save_native(result,args.output);print(json.dumps(result['budget'],indent=2))
