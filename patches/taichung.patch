+ assert(sSave.continueGameWarp.mapGroup==43 && sSave.continueGameWarp.warpId==-1);
+ assert(sSave.continueGameWarp.x==sSave.pos.x && sSave.continueGameWarp.y==sSave.pos.y);
+ sRemembered=sSave.facing;sRememberCalls++;
+}
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group,u16 number)
+{ assert(group==43 && number==sMap);sHeaderCalls++;return &sHeader; }
+bool8 TryGetObjectEventIdByLocalIdAndMap(u8 id,u8 map,u8 group,u8 *out)
+{
+ unsigned i;
+ for(i=0;i<OBJECT_EVENTS_COUNT;i++)if(gObjectEvents[i].active && gObjectEvents[i].localId==id && gObjectEvents[i].mapNum==map && gObjectEvents[i].mapGroup==group){*out=i;return FALSE;}
+ return TRUE;
+}
+u8 GetCollisionAtCoords(struct ObjectEvent *object,s16 x,s16 y,u32 dir)
+{
+ (void)dir;
+ if(sCollisionCalls++ < sRejectFirst)return COLLISION_OBJECT_EVENT;
+ assert(x>=object->initialCoords.x-object->rangeX && x<=object->initialCoords.x+object->rangeX);
+ assert(y>=object->initialCoords.y-object->rangeY && y<=object->initialCoords.y+object->rangeY);
+ if(sBlocked==2 || (sBlocked==1 && (x>object->initialCoords.x || y>object->initialCoords.y)))return COLLISION_OBJECT_EVENT;
+ return COLLISION_NONE;
+}
+void MoveObjectEventToMapCoords(struct ObjectEvent *object,s16 x,s16 y)
+{object->currentCoords=(struct Coords16){x,y};object->previousCoords=object->currentCoords;sMoved++;}
+void RemoveObjectEventByLocalIdAndMap(u8 id,u8 map,u8 group)
+{u8 n;assert(!TryGetObjectEventIdByLocalIdAndMap(id,map,group,&n));assert(sTemplates[id-1].flagId==0);gObjectEvents[n].active=FALSE;sRemoved++;}
+
+static void Reset(const struct AmbientActor *a)
+{
+ struct ObjectEventTemplate *t;
+ struct ObjectEvent *object;
+ memset(&sSave,0,sizeof(sSave));memset(sTemplates,0,sizeof(sTemplates));memset(gObjectEvents,0,sizeof(gObjectEvents));
+ memset(sSave.protectedPartyHpPpInventoryBadgesCaptures,0xA5,sizeof(sSave.protectedPartyHpPpInventoryBadgesCaptures));
+ gSaveBlock1Ptr=&sSave;sPending=FALSE;sRememberCalls=sWarpCalls=sHeaderCalls=sMoved=sRemoved=sBlocked=0;
+ sRejectFirst=sCollisionCalls=0;
+ sMap=a->mapNum;sSave.location=(struct WarpData){43,sMap,1,2,3};sSave.continueGameWarp=(struct WarpData){1,2,3,4,5};sSave.pos=(struct Coords16){a->x,a->y};sSave.facing=4;
+ t=&sTemplates[a->localId-1];t->localId=a->localId;t->graphicsId=a->graphicsId;t->kind=OBJ_KIND_NORMAL;t->x=a->x;t->y=a->y;t->objUnion.normal.elevation=3;t->objUnion.normal.movementType=a->movementType;t->objUnion.normal.movementRangeX=a->rangeX;t->objUnion.normal.movementRangeY=a->rangeY;t->script=sScript;
+ sSave.objectEventTemplates[a->localId-1]=*t;
+ sEvents=(struct MapEvents){.objectEventCount=a->localId,.objectEvents=sTemplates};sHeader=(struct MapHeader){.mapLayout=&sLayout,.events=&sEvents};
+ object=&gObjectEvents[1];object->active=TRUE;object->localId=a->localId;object->mapNum=sMap;object->mapGroup=43;object->graphicsId=a->graphicsId;object->movementType=a->movementType;object->rangeX=a->rangeX?a->rangeX:1;object->rangeY=a->rangeY?a->rangeY:1;object->initialCoords=(struct Coords16){a->x+MAP_OFFSET,a->y+MAP_OFFSET};object->currentCoords=object->previousCoords=object->initialCoords;
+}
+static void Unchanged(void)
+{struct SaveBlock1 before=sSave;TaichungAmbientRefreshOnContinue();assert(!memcmp(&sSave,&before,sizeof(sSave)));assert(!sWarpCalls && !sRememberCalls);}
+static void Refreshed(void)
+{
+ struct SaveBlock1 before=sSave;
+ TaichungAmbientRefreshOnContinue();assert(sPending && sWarpCalls==1 && sRememberCalls==1 && sRemembered==before.facing);
+ before.continueGameWarp=sSave.continueGameWarp;assert(!memcmp(&sSave,&before,sizeof(sSave)));
+ before=sSave;TaichungAmbientRefreshOnContinue();assert(!memcmp(&sSave,&before,sizeof(sSave)) && sWarpCalls==1);
+}
+int main(void)
+{
+ unsigned i,mode;struct SaveBlock1 before;struct ObjectEvent object;
+ assert(NELEMS(sAmbientActors)>=55);
+ for(i=0;i<NELEMS(sAmbientActors);i++){
+  const struct AmbientActor *a=&sAmbientActors[i];
+  Reset(a);Unchanged();
+  Reset(a);memset(&sSave.objectEventTemplates[a->localId-1],0,sizeof(struct ObjectEventTemplate));Refreshed();
+  Reset(a);sSave.objectEventTemplates[a->localId-1].graphicsId^=1;Refreshed();
+  Reset(a);sSave.objectEventTemplates[a->localId-1].objUnion.normal.movementType=MOVEMENT_TYPE_FACE_DOWN;Refreshed();
+  Reset(a);sSave.objectEventTemplates[a->localId-1].objUnion.normal.movementRangeX^=1;Refreshed();
+  Reset(a);sSave.objectEventTemplates[a->localId-1].script=sScript+1;Refreshed();
+  Reset(a);sSave.objectEventTemplates[a->localId-1].x++;Refreshed();
+  Reset(a);gObjectEvents[1].currentCoords.x++;Unchanged();
+  // Already migrated caches keep current roaming positions; old75 WALK
+  // caches migrate even when script/identity still match the same ROM.
+  Reset(a);sSave.objectEventTemplates[a->localId-1].objUnion.normal.movementType=MOVEMENT_TYPE_WALK_LEFT_AND_RIGHT;
+  sSave.objectEventTemplates[a->localId-1].objUnion.normal.movementRangeX=1;
+  sSave.objectEventTemplates[a->localId-1].objUnion.normal.movementRangeY=0;
+  if (a->movementType!=MOVEMENT_TYPE_WALK_LEFT_AND_RIGHT || a->rangeX!=1 || a->rangeY!=0)Refreshed();
+
+  Reset(a);sPending=TRUE;Unchanged();assert(!sHeaderCalls);
+  Reset(a);sSave.location.mapGroup=1;Unchanged();assert(!sHeaderCalls);
+  Reset(a);sSave.pos.x=-1;Unchanged();
+  Reset(a);sSave.pos.x=80;Unchanged();
+  Reset(a);sTemplates[a->localId-1].graphicsId^=1;Unchanged();
+  Reset(a);sTemplates[a->localId-1].x++;Unchanged();
+  Reset(a);sTemplates[a->localId-1].flagId=12;Unchanged();
+  Reset(a);sTemplates[a->localId-1].objUnion.normal.trainerType=TRAINER_TYPE_NORMAL;Unchanged();
+  for(mode=0;mode<3;mode++){
+   Reset(a);sBlocked=mode;before=sSave;object=gObjectEvents[1];
+   TaichungAmbientAvoidPlayerOverlap(a->x,a->y);
+   assert(!memcmp(&before,&sSave,sizeof(sSave)));
+   assert(!memcmp(&object.initialCoords,&gObjectEvents[1].initialCoords,sizeof(struct Coords16)));
+   assert(object.rangeX==gObjectEvents[1].rangeX && object.rangeY==gObjectEvents[1].rangeY && object.movementType==gObjectEvents[1].movementType);
+   if(mode<2){assert(sMoved==1 && !sRemoved && gObjectEvents[1].active);assert(gObjectEvents[1].currentCoords.x!=a->x+7 || gObjectEvents[1].currentCoords.y!=a->y+7);}
+   else assert(!sMoved && sRemoved==1 && !gObjectEvents[1].active);
+   TaichungAmbientAvoidPlayerOverlap(a->x,a->y);assert(sMoved+sRemoved==1);
+  }
+  // Exercise every ordered reviewed fallback, including after all earlier
+  // choices are occupied. None may recenter the authored roaming bounds.
+  for(mode=0;mode<a->overlapCount;mode++){
+   const struct Coords16 *offset=&sAmbientOverlapOffsets[a->overlapStart+mode];
+   Reset(a);sRejectFirst=mode;before=sSave;object=gObjectEvents[1];
+   TaichungAmbientAvoidPlayerOverlap(a->x,a->y);
+   assert(sMoved==1 && !sRemoved && sCollisionCalls==mode+1);
+   assert(gObjectEvents[1].currentCoords.x==a->x+MAP_OFFSET+offset->x && gObjectEvents[1].currentCoords.y==a->y+MAP_OFFSET+offset->y);
+   assert(!memcmp(&before,&sSave,sizeof(sSave)) && !memcmp(&object.initialCoords,&gObjectEvents[1].initialCoords,sizeof(struct Coords16)));
+  }
+  Reset(a);before=sSave;object=gObjectEvents[1];TaichungAmbientAvoidPlayerOverlap(a->x+1,a->y);assert(!memcmp(&before,&sSave,sizeof(sSave)) && !memcmp(&object,&gObjectEvents[1],sizeof(object)));
+ }
+ gSaveBlock1Ptr=NULL;TaichungAmbientRefreshOnContinue();TaichungAmbientAvoidPlayerOverlap(0,0);
+ printf("PASS: %lu exact actors; old missing/stale cache, movement migration, current and roaming caches, pending return/facing priority, unrelated identities and invalid positions; NPC-only bounded overlap/blocked fallback/idempotence; every protected saved byte retained\n",(unsigned long)NELEMS(sAmbientActors));return 0;
+}
diff --git a/tests/taichung_badge_rewards_test.c b/tests/taichung_badge_rewards_test.c
new file mode 100644
index 00000000..3f694fbe
--- /dev/null
+++ b/tests/taichung_badge_rewards_test.c
@@ -0,0 +1,199 @@
+#include "global.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWrites;
+static bool8 sWriteFails;
+static bool8 sWriteIgnored;
+static const u16 sTrainers[TAICHUNG_GYM_COUNT] = {
+    TRAINER_TAICHUNG_STATION_JUN, TRAINER_TAICHUNG_PARK_LIAN,
+    TRAINER_TAICHUNG_MIYAHARA_PEIQI, TRAINER_TAICHUNG_SCIENCE_YICHENG,
+    TRAINER_TAICHUNG_GREENWAY_XINGAN, TRAINER_TAICHUNG_CONFUCIUS_WENYI,
+    TRAINER_TAICHUNG_FINE_ARTS_CAINING, TRAINER_TAICHUNG_FENGJIA_JIAHE,
+    TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING, TRAINER_TAICHUNG_THEATER_LING
+};
+
+u16 VarGet(u16 id)
+{
+    (void)id;
+    assert(0 && "Badge collection must read real saved progress, not quest replay");
+    return 0;
+}
+
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_GYM_COMPLETION_VAR);
+    if (sWriteFails)
+        return FALSE;
+    if (!sWriteIgnored)
+    {
+        sSave.vars[id - 0x4000] = value;
+        sWrites++;
+    }
+    return TRUE;
+}
+
+static void Reset(u16 mask)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    gSaveBlock1Ptr = &sSave;
+    sSave.vars[0xF7] = 9;
+    sSave.vars[0xF8] = 1;
+    sSave.vars[0xF9] = 3;
+    sSave.vars[0xFA] = mask;
+    sSave.vars[0xFB] = 2;
+    sSave.vars[0xFC] = 4;
+    sSave.vars[0xFD] = 1;
+    sWrites = 0;
+    sWriteFails = FALSE;
+    sWriteIgnored = FALSE;
+    TaichungGymCancelChallenge();
+}
+
+static void Start(u16 gym)
+{
+    assert(TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+    assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+    TaichungGymOnTrainerBattleStart(sTrainers[gym]);
+    assert(TaichungGymIsBadgeChallenge(sTrainers[gym]));
+    assert(!TaichungGymIsBadgeChallenge(TRAINER_YOUNGSTER_BEN));
+}
+
+static void TestAllPriorMasks(void)
+{
+    u16 gym, mask;
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        for (mask = 0; mask <= TAICHUNG_GYM_ALL_MASK; mask++)
+        {
+            u16 expected[256];
+            Reset(mask);
+            memcpy(expected, sSave.vars, sizeof(expected));
+            // Saved legitimate wins render in the collection, without replaying
+            // an award or making a write, including all old-save combinations.
+            assert(TaichungGymGetCompletedMask() == mask);
+            assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+            if (mask & (1 << gym))
+            {
+                assert(!TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+                TaichungGymOnTrainerBattleStart(sTrainers[gym]);
+                assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+                TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+                assert(!TaichungGymConsumeNewBadge(gym));
+                assert(sWrites == 0 && !memcmp(expected, sSave.vars, sizeof(expected)));
+                continue;
+            }
+            Start(gym);
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+            assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+            expected[0xFA] |= 1 << gym;
+            assert(sWrites == 1 && !memcmp(expected, sSave.vars, sizeof(expected)));
+            assert(!TaichungGymConsumeNewBadge((gym + 1) % TAICHUNG_GYM_COUNT));
+            assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_COUNT));
+            assert(!TaichungGymConsumeNewBadge(0xFFFF));
+            // Repeated end notifications cannot manufacture another award, or
+            // erase the still-unconsumed presentation of the real first win.
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+            assert(TaichungGymConsumeNewBadge(gym));
+            assert(!TaichungGymConsumeNewBadge(gym));
+            assert(!TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+            assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 1);
+        }
+    }
+}
+
+static void TestNonWinsAndMissingEvents(void)
+{
+    u16 gym;
+    u8 outcome;
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        for (outcome = 0; outcome < 16; outcome++)
+        {
+            if (outcome == B_OUTCOME_WON)
+                continue;
+            Reset(0);
+            Start(gym);
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], outcome);
+            assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+        }
+        Reset(0);
+        assert(TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        Start(gym);
+        TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN, B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        assert(TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+        TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+        assert(!TaichungGymIsBadgeChallenge(TRAINER_YOUNGSTER_BEN));
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        Start(gym);
+        TaichungGymCancelChallenge(); // Decline/skipped battle/replay/Continue reset.
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        TaichungGymOnTrainerBattleStart(sTrainers[gym]); // Unprepared ordinary battle.
+        assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+    }
+}
+
+static void TestFailedWriteAndVolatileReset(void)
+{
+    Reset(0);
+    Start(TAICHUNG_GYM_PARK);
+    sWriteFails = TRUE;
+    TaichungGymOnTrainerBattleEnd(sTrainers[TAICHUNG_GYM_PARK], B_OUTCOME_WON);
+    assert(TaichungGymGetLastResult() != TAICHUNG_GYM_RESULT_WON);
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK) && sWrites == 0);
+
+    Reset(0);
+    Start(TAICHUNG_GYM_PARK);
+    sWriteIgnored = TRUE;
+    TaichungGymOnTrainerBattleEnd(sTrainers[TAICHUNG_GYM_PARK], B_OUTCOME_WON);
+    assert(TaichungGymGetLastResult() != TAICHUNG_GYM_RESULT_WON);
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK) && sWrites == 0);
+
+    Reset(0);
+    Start(TAICHUNG_GYM_PARK);
+    TaichungGymOnTrainerBattleEnd(sTrainers[TAICHUNG_GYM_PARK], B_OUTCOME_WON);
+    TaichungGymCancelChallenge(); // New/Continue cannot re-award an old win.
+    assert(TaichungGymIsComplete(TAICHUNG_GYM_PARK));
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK));
+    assert(sWrites == 1);
+
+    Reset(0);
+    // Preparing an unrelated trainer is not an explicit registered gym battle,
+    // even if a caller pairs it with a valid gym ID.
+    assert(!TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK, TRAINER_YOUNGSTER_BEN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    assert(!TaichungGymIsBadgeChallenge(TRAINER_YOUNGSTER_BEN));
+    TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN, B_OUTCOME_WON);
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK));
+}
+
+int main(void)
+{
+    TestAllPriorMasks();
+    TestNonWinsAndMissingEvents();
+    TestFailedWriteAndVolatileReset();
+    puts("PASS: all ten registered gym battles/all1024 masks; new-win consume-once badge events; old-save collection/no popup; nonwins/missing/wrong/cancel/replay-reset guards; registered-only cashless query; failed writes; protected variables.");
+    return 0;
+}
