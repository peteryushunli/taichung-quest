+
+bool8 TaichungCanToggleBike(void)
+{
+    struct ObjectEvent *player;
+    s16 x, y;
+    u8 behavior;
+    u8 movement;
+
+    if (!IsTaichungOutdoorCyclingMap() || !Overworld_IsMainFieldCallback()
+     || ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled()
+     || gMain.inBattle || gPaletteFade.active || IsUpdateLinkStateCBActive()
+     || InUnionRoom() || QL_IS_PLAYBACK_STATE || gPlayerAvatar.preventStep
+     || gPlayerAvatar.transitionFlags != 0
+     || (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_FORCED | PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER))
+     || !(gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_ON_FOOT | PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE))
+     || gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT
+     || GetTaskCount() >= NUM_TASKS
+     || FlagGet(FLAG_SYS_ON_CYCLING_ROAD))
+        return FALSE;
+
+    player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    if (!player->active || player->frozen)
+        return FALSE;
+
+    // A press during an ordinary one-tile step can wait for its tile center.
+    // Never interrupt a ledge jump, slide, spin or scripted special movement.
+    if (gPlayerAvatar.tileTransitionState == T_TILE_TRANSITION)
+    {
+        movement = ObjectEventGetHeldMovementActionId(player);
+        if (!((movement >= MOVEMENT_ACTION_WALK_SLOWER_DOWN && movement <= MOVEMENT_ACTION_WALK_NORMAL_RIGHT)
+           || (movement >= MOVEMENT_ACTION_WALK_FAST_DOWN && movement <= MOVEMENT_ACTION_WALK_FAST_RIGHT)
+           || (movement >= MOVEMENT_ACTION_RIDE_WATER_CURRENT_DOWN && movement <= MOVEMENT_ACTION_WALK_FASTER_RIGHT)
+           || (movement >= MOVEMENT_ACTION_PLAYER_RUN_DOWN && movement <= MOVEMENT_ACTION_PLAYER_RUN_RIGHT_SLOW)
+           || (movement >= MOVEMENT_ACTION_TAICHUNG_BIKE_DOWN && movement <= MOVEMENT_ACTION_TAICHUNG_BIKE_RIGHT)))
+            return FALSE;
+    }
+
+    PlayerGetDestCoords(&x, &y);
+    behavior = MapGridGetMetatileBehaviorAt(x, y);
+    // These are the same cycling-road/rail/native terrain checks used by the
+    // registered Bike item. Rejected shortcuts stay silent; the menu remains.
+    if (MetatileBehavior_IsForcedMovementTile(behavior)
+     || MetatileBehavior_IsVerticalRail(behavior)
+     || MetatileBehavior_IsHorizontalRail(behavior)
+     || MetatileBehavior_IsIsolatedVerticalRail(behavior)
+     || MetatileBehavior_IsIsolatedHorizontalRail(behavior)
+     || IsBikingDisallowedByPlayer())
+        return FALSE;
+    return TRUE;
+}
