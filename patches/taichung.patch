+        declarations = ("src/data/tilesets/graphics.h", "src/data/tilesets/metatiles.h", "src/graphics.c")
+        current_c, baseline_c = "\n".join(now.text(p) for p in declarations), "\n".join(before.text(p) for p in declarations)
