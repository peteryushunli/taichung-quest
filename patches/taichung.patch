+                      "currentlyUnreferencedTheaterDefinitionCount": 160 - len(active_theater),
+                      "reuseUnreferencedDefinitionsRequiresExplicitContract": True},
+        "sceneUsageCurrent": own, "sceneUsageAfterAnalyticalFuturePlaceholderClearance": post_clear,
+        "palettes": {"theaterPalette7MustRemainExact": True, "primary0to6MustRemainExact": True,
