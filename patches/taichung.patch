diff --git a/data/taichung/story-ambient-npcs/dialogue.json b/data/taichung/story-ambient-npcs/dialogue.json
new file mode 100644
index 00000000..d2ada4c5
--- /dev/null
+++ b/data/taichung/story-ambient-npcs/dialogue.json
@@ -0,0 +1,146 @@
+{
+  "schemaVersion": 1,
+  "status": "incidental dialogue handoff; map placement separate",
+  "scope": "Ten one-page English/Traditional Chinese comments. Original fictional everyday voices; no historical or visitor-service claims, new landmarks, quests, hints, battles or captures.",
+  "scriptInclude": "data/scripts/taichung_ambient_npcs.inc",
+  "entries": [
+    {
+      "name": "HuiminWalker",
+      "script": "TaichungBoulevard_Ambient_HuiminWalker",
+      "buffer": "TaichungAmbient_BufferHuiminWalker",
+      "en": [
+        "One more block, then a break."
+      ],
+      "zh-TW": [
+        "再走一個街口，",
+        "就找地方歇歇腳。"
+      ]
+    },
+    {
+      "name": "CivicResident",
+      "script": "TaichungBoulevard_Ambient_CivicResident",
+      "buffer": "TaichungAmbient_BufferCivicResident",
+      "en": [
+        "I like seeing familiar faces",
+        "on my way home."
+      ],
+      "zh-TW": [
+        "回家路上遇到熟面孔，",
+        "總會多聊兩句。"
+      ]
+    },
+    {
+      "name": "SakuraShopper",
+      "script": "TaichungBoulevard_Ambient_SakuraShopper",
+      "buffer": "TaichungAmbient_BufferSakuraShopper",
+      "en": [
+        "I left home empty-handed.",
+        "That may change on the way."
+      ],
+      "zh-TW": [
+        "兩手空空出門，",
+        "回家時就不一定了。"
+      ]
+    },
+    {
+      "name": "XitunNeighbor",
+      "script": "TaichungBoulevard_Ambient_XitunNeighbor",
+      "buffer": "TaichungAmbient_BufferXitunNeighbor",
+      "en": [
+        "Taking the long way home?",
+        "Me too. There's no hurry."
+      ],
+      "zh-TW": [
+        "你也繞遠路回家嗎？",
+        "我今天不趕時間。"
+      ]
+    },
+    {
+      "name": "WestDistrictShopper",
+      "script": "TaichungBoulevard_Ambient_WestDistrictShopper",
+      "buffer": "TaichungAmbient_BufferWestDistrictShopper",
+      "en": [
+        "I came for one thing.",
+        "I always find something else."
+      ],
+      "zh-TW": [
+        "原本只想挑一樣，",
+        "結果又看上別的了！"
+      ]
+    },
+    {
+      "name": "NorthNeighbor",
+      "script": "TaichungBoulevard_Ambient_NorthNeighbor",
+      "buffer": "TaichungAmbient_BufferNorthNeighbor",
+      "en": [
+        "Waiting for a friend.",
+        "They said they'd be here."
+      ],
+      "zh-TW": [
+        "我在等朋友，",
+        "他說馬上就到了。"
+      ]
+    },
+    {
+      "name": "BeitunStroller",
+      "script": "TaichungBoulevard_Ambient_BeitunStroller",
+      "buffer": "TaichungAmbient_BufferBeitunStroller",
+      "en": [
+        "I keep finding streets",
+        "I haven't walked before."
+      ],
+      "zh-TW": [
+        "這條街我還沒走過，",
+        "今天正好來看看。"
+      ]
+    },
+    {
+      "name": "NantunResident",
+      "script": "TaichungBoulevard_Ambient_NantunResident",
+      "buffer": "TaichungAmbient_BufferNantunResident",
+      "en": [
+        "Nothing on my list today.",
+        "Just out for a walk."
+      ],
+      "zh-TW": [
+        "今天沒有待辦清單，",
+        "只是出門走走。"
+      ]
+    },
+    {
+      "name": "ParkVisitor",
+      "script": "TaichungBoulevard_Ambient_ParkVisitor",
+      "buffer": "TaichungAmbient_BufferParkVisitor",
+      "en": [
+        "I found a shady bench.",
+        "I could stay here all day."
+      ],
+      "zh-TW": [
+        "剛找到一張有樹蔭的長椅，",
+        "我能在這待上一整天。"
+      ]
+    },
+    {
+      "name": "OldCityWalker",
+      "script": "TaichungBoulevard_Ambient_OldCityWalker",
+      "buffer": "TaichungAmbient_BufferOldCityWalker",
+      "en": [
+        "I haven't had lunch yet.",
+        "Time to find something good."
+      ],
+      "zh-TW": [
+        "午飯還沒吃，",
+        "先找點好吃的。"
+      ]
+    }
+  ],
+  "anchorsOwner": "Maps",
+  "anchorsReference": "artifacts/qa/2026-11-24-boulevard-npcs/candidate-anchors.json",
+  "existingGuideTrainerBehavior": "untouched",
+  "newGlyphs": [],
+  "glyphRequest": "None: all ambient comments use released glyphs after the registered-glyph shopping-copy correction.",
+  "lineChecks": {
+    "maxNativePixels": 193,
+    "lineBudget": 198
+  }
+}
