+static unsigned sV10Cases[V10_DISTRICTS], sV10RoomCases;
+
+static void AssertRoomUnchanged(unsigned version, unsigned map, s16 x, s16 y)
+{
+    struct SaveBlock1 before;
+    Versioned(version); InDistrict(map,x,y); before = sSave;
+    TaichungSaveUpgradeOnContinue(); AssertRoomKept(&before);
+    AssertSamePartyAndVars(&before);
+    Versioned(version); InDistrict(map,6,9); PendingTarget(map,x,y); before = sSave;
+    TaichungSaveUpgradeOnContinue(); AssertPendingKept(&before);
+    AssertSamePartyAndVars(&before); sV10RoomCases += 2;
+}
