+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool32 sPendingWarp;
+static unsigned sHeaderReads;
+static const struct MapLayout sLayout = {13, 15};
+static const struct ObjectEventTemplate sObjects[] = {
+    {1, OBJ_EVENT_GFX_TAICHUNG_PEIQI}
+};
+static const struct MapEvents sEvents = {1, sObjects};
+static const struct MapHeader sHeader = {&sLayout, &sEvents};
+
+bool32 UseContinueGameWarp(void) { return sPendingWarp; }
+void SetContinueGameWarpStatus(void) { sPendingWarp = TRUE; }
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group, u16 number)
+{
+    assert(group == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(number == MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM));
+    sHeaderReads++;
+    return &sHeader;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.partyBadgesAndOtherSavedData, 0xA5, sizeof(sSave.partyBadgesAndOtherSavedData));
+    sSave.pos.x = 3; sSave.pos.y = 10;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM);
+    sSave.location.warpId = 1;
+    sSave.location.x = 6; sSave.location.y = 13;
+    sSave.objectEventTemplates[0].localId = 1;
+    sSave.objectEventTemplates[0].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+    gSaveBlock1Ptr = &sSave;
+    sPendingWarp = FALSE;
+    sHeaderReads = 0;
+}
+
+static void ExpectUnchanged(void)
+{
+    struct SaveBlock1 before = sSave;
+    TaichungPeiqiRefreshOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+}
+
+int main(void)
+{
+    struct SaveBlock1 before;
+    Reset();
+    before = sSave;
+    TaichungPeiqiRefreshOnContinue();
+    assert(sPendingWarp && sHeaderReads == 1);
+    assert(sSave.continueGameWarp.mapGroup == sSave.location.mapGroup);
+    assert(sSave.continueGameWarp.mapNum == sSave.location.mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == 3 && sSave.continueGameWarp.y == 10);
+    before.continueGameWarp = sSave.continueGameWarp;
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+
+    Reset();
+    sSave.objectEventTemplates[0].localId = 0;
+    TaichungPeiqiRefreshOnContinue();
+    assert(sPendingWarp); // Missing Miyahara host cache also reloads safely.
+
+    Reset();
+    sSave.objectEventTemplates[0] = sObjects[0];
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); sPendingWarp = TRUE;
+    sSave.continueGameWarp.mapGroup = 1;
+    ExpectUnchanged(); assert(sHeaderReads == 0);
+
+    Reset(); sSave.location.mapGroup = 1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.location.mapNum = -1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.pos.x = 13;
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); gSaveBlock1Ptr = NULL;
+    TaichungPeiqiRefreshOnContinue(); assert(sHeaderReads == 0);
+    puts("PASS: stale Peiqi cache refresh at saved position; party/badges preserved; current caches, pending warps, unrelated maps and invalid inputs untouched");
+    return 0;
+}
diff --git a/tests/taichung_player_text_test.c b/tests/taichung_player_text_test.c
new file mode 100644
index 0000000..132569e
--- /dev/null
+++ b/tests/taichung_player_text_test.c
@@ -0,0 +1,78 @@
+#include "global.h"
+#include "strings.h"
+#include "taichung_language.h"
+#include "taichung_player_text.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static bool8 sChinese;
+const u8 *TaichungText(const u8 *en, const u8 *zh) { return sChinese ? zh : en; }
+const u8 gText_MenuPlayer[] = "{PLAYER}";
+const u8 gText_OakForbidsUseOfItemHere[] = "old-forbidden";
+const u8 gText_PlayerUsedVar2[] = "old-item";
+const u8 gText_UsedVar2WildLured[] = "old-lure";
+const u8 gText_UsedVar2WildRepelled[] = "old-repel";
+const u8 gText_OakThisIsListOfPokemon[] = "old-party";
+const u8 gText_SPc[] = "{PLAYER}'s PC";
+const u8 gString_BattleRecords_PlayersBattleResults[] = "{PLAYER}'s BATTLE RESULTS";
+const u8 gText_PlayerScurriedToCenter[] = "old-center";
+const u8 gText_PlayerScurriedBackHome[] = "old-home";
+const u8 gText_PlayerSavedTheGame[] = "{PLAYER} saved the game.";
+
+int main(void)
+{
+    static const struct { const u8 *original; u16 id; } cases[] = {
+        {gText_MenuPlayer, TAICHUNG_PLAYER_YOU},
+        {gText_OakForbidsUseOfItemHere, TAICHUNG_PLAYER_ITEM_FORBIDDEN},
+        {gText_PlayerUsedVar2, TAICHUNG_PLAYER_FIELD_ITEM},
+        {gText_UsedVar2WildLured, TAICHUNG_PLAYER_WILD_LURED},
+        {gText_UsedVar2WildRepelled, TAICHUNG_PLAYER_WILD_REPELLED},
+        {gText_OakThisIsListOfPokemon, TAICHUNG_PLAYER_PARTY_HELP},
+        {gText_SPc, TAICHUNG_PLAYER_YOUR_PC},
+        {gString_BattleRecords_PlayersBattleResults, TAICHUNG_PLAYER_YOUR_RECORDS},
+        {gText_PlayerScurriedToCenter, TAICHUNG_PLAYER_TO_CENTER},
+        {gText_PlayerScurriedBackHome, TAICHUNG_PLAYER_TO_HOME},
+        {gText_PlayerSavedTheGame, TAICHUNG_PLAYER_SAVED_GAME}
+    };
+    u8 unknown[] = "{PLAYER}'s PC";
+    u8 identity[] = "Walker";
+    u16 id, i;
+
+    for (sChinese = FALSE; sChinese <= TRUE; sChinese++)
+    {
+        for (id = 0; id < TAICHUNG_PLAYER_TEXT_COUNT; id++)
+        {
+            const char *text = (const char *)TaichungPlayerTextGet(id);
+            assert(text != NULL && text[0] != '\0');
+            assert(strstr(text, "{PLAYER}") == NULL);
+            assert(strstr(text, "{B_PLAYER_NAME}") == NULL);
+            assert(strstr(text, "Walker") == NULL);
+            assert(strstr(text, "you's") == NULL && strstr(text, "YOU's") == NULL);
+            assert(strstr(text, "You is") == NULL && strstr(text, "You has") == NULL);
+        }
+        for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+            assert(TaichungPlayerFieldText(cases[i].original) == TaichungPlayerTextGet(cases[i].id));
+        // Identical contents at an unrelated address are not a replacement target.
+        assert(TaichungPlayerFieldText(unknown) == unknown);
+        assert(TaichungPlayerFieldText(identity) == identity);
+        assert(TaichungPlayerFieldText(NULL) == NULL);
+        assert(TaichungPlayerTextGet(TAICHUNG_PLAYER_TEXT_COUNT)[0] == '\0');
+        assert(TaichungPlayerTextGet(0xFFFF)[0] == '\0');
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_GOT_MONEY), "{B_BUFF1}") != NULL);
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_USED_ITEM), "{B_LAST_ITEM}") != NULL);
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_FIELD_ITEM), "{STR_VAR_2}") != NULL);
+        assert(strstr((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_TRAINER_WIN), "{B_TRAINER1_NAME}") != NULL);
+    }
+    sChinese = FALSE;
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_WHITEOUT), "You have no POKéMON\nleft to battle!p") == 0);
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOUR_PC), "YOUR PC") == 0);
+    assert(strcmp((const char *)TaichungPlayerFieldText(gText_PlayerSavedTheGame), "You saved the game.") == 0);
+    sChinese = TRUE;
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOU), "你") == 0);
+    assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOUR_PC), "你的電腦") == 0);
+    assert(strcmp((const char *)TaichungPlayerFieldText(gText_PlayerSavedTheGame), "你儲存了遊戲。") == 0);
+    assert(strcmp((const char *)identity, "Walker") == 0);
+    puts("PASS: complete bilingual second-person templates, field pointer routing and untouched identity fallbacks");
+    return 0;
+}
