+    expected = budget["sourceSha256"][str(MAP.relative_to(ROOT))]
+    for path in (MAP, OUTPUT / "proposal/baseline-map.bin"):
+        if path.exists() and sha(path.read_bytes()) == expected:
+            return path.read_bytes()
+    raise ValueError("Xitun source changed; review a new baseline instead of silently replacing it")
+
+
+def colors(path):
+    result = [tuple(map(int, line.split())) for line in path.read_text().splitlines()[3:] if line.strip()]
+    if len(result) != 16:
+        raise ValueError(f"Expected 16 colors: {path}")
+    return result
+
+
+def render_metatiles(secondary):
