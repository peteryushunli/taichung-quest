+                     "remainingPrimaryHoles": len(free) - len(allocated), "requiredSecondaryGraphicsAfterRelocation": 0,
+                     "futureStaticSecondaryCapacity": 376, "doorScratchGlobalIdsInclusive": [1016, 1023],
+                     "oldToNewGraphicEntries": {str(k): v for k, v in sorted(relocation.items())}},
+        "metatiles": {"preservedGeneralClosureCount": len(preserved), "preservedCurrentSecondaryDefinitionCount": len(current.attrs[1]),
+                      "allPreservedMetatileRgbAndAttributesEqual": True, "mapWordsOrIdsChangedBySimulation": False,
+                      "sourcePewterReservationInclusive": [640, 718], "theaterReservationInclusive": [719, 878],
+                      "unusedSecondaryDefinitionSlotsAfter878": 1024 - 879,
+                      "privatePrimaryDefinitionIdsOutsideProtectedGeneralClosure": len(set(range(640)) - set(preserved)),
+                      "primaryDefinitionAllocationNeedsSeparateIdContract": True,
