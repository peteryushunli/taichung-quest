+                '{\n    (void)group; (void)num; (void)x; (void)y;\n    return FALSE;\n}\n')
+    return ('// Independent verified map/manifest truth, not parsed from the C implementation.\n'
+        'static const struct { u8 group, num, x, y, toX, toY; } sApprovedArtV11Expected[] =\n{\n'+
