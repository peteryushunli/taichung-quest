+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+install = load("xitun_rework_install", HERE / "install_xitun.py")
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def spans(values):
+    """'6, 11, 15-37' for [6, 11, 15, 16, ..., 37]."""
+    runs = []
+    for v in values:
+        if runs and v == runs[-1][1] + 1:
+            runs[-1][1] = v
+        else:
+            runs.append([v, v])
+    return ", ".join(str(a) if a == b else f"{a}-{b}" for a, b in runs)
+
+
+def base_entries(base):
+    """Xitun's BASE entries in the three shared files."""
+    contract = base.json(install.CONTRACT)
+    district = next(d for d in contract["districts"] if d["map"] == install.MID)
+    landmarks = {l["id"]: l for l in contract["landmarks"] if l["exteriorMap"] == install.MID}
+    habitats = [h for h in contract.get("habitatRegions", []) if h["map"] == install.MID]
+    layout = next(l for l in base.json(install.LAYOUTS)["layouts"] if l.get("id") == install.LAYOUT_ID)
+    return layout, (district, landmarks, habitats)
+
+
+def built_entries(files, base):
+    """True when Xitun's entries in the tree's shared files are the installer's."""
+    layouts = {l["id"]: l for l in files.json(install.LAYOUTS)["layouts"] if l.get("id")}
+    contract = files.json(install.CONTRACT)
+    district, landmarks, habitats = install.contract_entries(base.json(install.CONTRACT))
+    tables = [e for g in files.json(install.ENCOUNTERS)["wild_encounter_groups"] for e in g["encounters"] if e["map"] == install.MID]
+    return (layouts.get(install.LAYOUT_ID) == install.layout_entry(base.json(install.LAYOUTS))
+            and next((d for d in contract["districts"] if d["map"] == install.MID), None) == district
+            and {l["id"]: l for l in contract["landmarks"] if l["exteriorMap"] == install.MID} == landmarks
+            and [h for h in contract.get("habitatRegions", []) if h["map"] == install.MID] == habitats
+            and tables == [install.ENCOUNTER])
+
+
+def registered(files):
+    try:
+        record = files.json(RECORD)
+    except (OSError, subprocess.CalledProcessError, ValueError):
+        return False
+    return (record.get("baseCommit") == BASE
+            and all(sha(files.read(path)) == digest for path, digest in record["outputs"].items()))
+
+
+def underneath(files):
+    """{path: bytes} with exactly the registered Xitun rework removed, when the
+    tree holds it; otherwise {}, so a guard reads the real bytes."""
+    if not registered(files):
+        return {}
+    base = type(files)(files.source, BASE)
+    if not built_entries(files, base):
+        return {}
+    layout, contract = base_entries(base)
+    return {
+        install.MAP: base.read(install.MAP),
+        install.MAP_JSON: base.read(install.MAP_JSON),
+        install.LAYOUTS: install.dump(install.put_layout(files.json(install.LAYOUTS), layout)),
+        install.CONTRACT: install.dump(install.put_contract(files.json(install.CONTRACT), *contract)),
+        install.ENCOUNTERS: install.dump(install.put_encounter(files.json(install.ENCOUNTERS), None)),
+    }
+
+
+def check(source=ROOT, overrides=None):
+    source = Path(source).resolve()
+    support = load("xitun_rework_support", source / "tools/taichung/landmarks/check_old_core.py")
+    now, base = support.Files(source), support.Files(source, BASE)
+    # The registered Old City rework adds Greenway's and Old City North's entries to the
+    # shared files; its own guard proves them, so this one reads the tree underneath it.
+    now.cache.update(support.oldcity_rework_underneath(now))
+    now.cache.update(overrides or {})
+    tests = support.Checks()
+    width, height = install.SIZE
+    dx, dy = install.SHIFT
+    layout = next(l for l in now.json(install.LAYOUTS)["layouts"] if l.get("id") == install.LAYOUT_ID)
+    words = now.words(install.MAP)
+    today = base.words(install.MAP)
+    today_w, today_h = width - dx, height - dy
+    kit = {k: int(v, 16) for k, v in now.json(KIT)["metatiles"].items()}
+    highway = {v for k, v in kit.items() if k.startswith("hw-")}
+    data, base_data = now.json(install.MAP_JSON), base.json(install.MAP_JSON)
+    primary, _ = support.resolved_folder(now, layout["primary_tileset"])
+    secondary, _ = support.resolved_folder(now, layout["secondary_tileset"])
+    bank = support.Bank(now, primary, secondary)
+
+    def cell(x, y):
+        return words[y * width + x]
+
+    def walkable(x, y):
+        return 0 <= x < width and 0 <= y < height and not cell(x, y) & SOLID_BITS
+
+    def installer():
+        outputs = install.build(base.read, now.read)
+        stale = [path for path, raw in outputs.items() if now.read(path) != raw]
+        tests.require(not stale, f"Not install_xitun.py's output from BASE: {stale}")
+        tests.require(now.json(RECORD) == install.record(outputs, base.read(install.MAP), now.read(FILL)),
+                      "install.json is not the installer's record")
+        tests.require(install.BASE == BASE, "Installer BASE moved")
+        tests.require(registered(now) and underneath(now), "underneath() does not recognise the registered rework")
+        return {"outputs": len(outputs), "mapSha256": sha(now.read(install.MAP))}
+
+    def geometry():
+        base_layout, _ = base_entries(base)
+        tests.require((layout["width"], layout["height"]) == (width, height) and len(words) == width * height,
+                      f"Xitun is not {width}x{height}")
+        tests.require({k: v for k, v in layout.items() if k not in ("width", "height")}
+                      == {k: v for k, v in base_layout.items() if k not in ("width", "height")}, "Xitun's tilesets or border moved")
+        tests.require(now.read(layout["border_filepath"]) == base.read(base_layout["border_filepath"]), "Xitun's border changed")
+        band = {(x, y) for y in range(height) for x in range(width) if x < 6 or y < 6}
+        tests.require(all(cell(x, y) & 0x3FF in highway and cell(x, y) & SOLID_BITS for x, y in band),
+                      "The highway band holds something other than solid kit highway")
+        plan = now.json(FILL)["rows"]
+        tests.require(len(plan) == height and all(len(row) == width for row in plan), f"fill.json is not {width}x{height}")
+        moved_art = [p for p in PROTECTED if cell(p[0] + dx, p[1] + dy) != today[p[1] * today_w + p[0]]]
+        tests.require(not moved_art, f"Landmark art changed at today's {sorted(moved_art)[:6]}")
+        tests.require({(x - dx, y - dy) for y in range(height) for x in range(width) if plan[y][x] == "L"} == PROTECTED,
