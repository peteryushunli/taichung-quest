+#!/usr/bin/env python3
+"""Inspect native saved gameplay preferences in a QA-exported FireRed SRAM file.
+
+Checks the two relevant SaveBlock1 sector checksums/counter. This is not a full
+14-sector save validator; native Continue remains the end-to-end acceptance.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('save', type=Path)
+parser.add_argument('--expect-wild', choices=['off','low','normal'])
+parser.add_argument('--expect-sight', choices=['off','low','normal'])
+parser.add_argument('--expect-gyms', type=int, choices=range(11))
+args = parser.parse_args()
+raw = args.save.read_bytes()
+if len(raw) not in (0x20000,0x20010):
+    raise SystemExit('Expected a native SRAM save, not an emulator snapshot.')
+flash = raw[:0x20000] # mGBA may append a 16-byte RTC trailer.
+sectors = {}
+for offset in range(0,len(flash),0x1000):
+    sector_id, stored_checksum, signature, counter = struct.unpack_from('<HHII',raw,offset+0xFF4)
+    if sector_id not in (1,2) or signature != 0x08012025:
+        continue
+    payload = raw[offset:offset+0xF80]
+    total = sum(struct.unpack('<992I',payload)) & 0xFFFFFFFF
+    checksum = ((total >> 16)+total) & 0xFFFF
+    if checksum == stored_checksum:
+        sectors.setdefault(counter,{})[sector_id] = payload
+complete = [counter for counter,parts in sectors.items() if 1 in parts and 2 in parts]
+if not complete:
+    raise SystemExit('No checksum-valid matching SaveBlock1 sector pair; finish a native Save first.')
+counter = max(complete)
+block = sectors[counter][1]+sectors[counter][2]
+variables = {name:struct.unpack_from('<H',block,0x1000+(number-0x4000)*2)[0]
+             for name,number in [('version',0x40F7),('wild',0x40F8),('sight',0x40F9),('gyms',0x40FA),('language',0x40FB),('starter',0x40FC),('tea',0x40FD)]}
+mode = lambda value: {1:'off',2:'low',3:'normal'}.get(value,'normal')
+count = bin(variables['gyms'] & 0x3FF).count('1')
+result = {'bytes':len(raw),'rtcTrailerBytes':len(raw)-len(flash),'sha256':hashlib.sha256(raw).hexdigest(),'saveCounter':counter,
+          'checkedSectors':[1,2], 'position':{'x':struct.unpack_from('<h',block,0)[0],'y':struct.unpack_from('<h',block,2)[0],'mapGroup':block[4],'mapNumber':block[5]},
+          'partyCount':block[0x34], 'rawVariables':variables,
+          'wildMode':mode(variables['wild']),'sightMode':mode(variables['sight']),'completedGyms':count}
+print(json.dumps(result,indent=2))
+if args.expect_wild and result['wildMode'] != args.expect_wild:
+    raise SystemExit('Unexpected saved wild setting')
+if args.expect_sight and result['sightMode'] != args.expect_sight:
+    raise SystemExit('Unexpected saved sight setting')
+if args.expect_gyms is not None and count != args.expect_gyms:
+    raise SystemExit('Unexpected saved completed-gym count')
diff --git a/tools/taichung_gameplay/inspect-team-save.py b/tools/taichung_gameplay/inspect-team-save.py
