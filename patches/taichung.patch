+#!/usr/bin/env python3
+"""Export checked baseline native-map -> minimap geometry; no native mutations."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+CONTRACT = 'data/taichung/minimap-contract.json'
+
+
+def require(condition, message):
+    if not condition: raise ValueError(message)
+
+
+def read(path):
+    return json.loads(path.read_text())
+
+
+def canonical(value):
