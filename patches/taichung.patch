+{
+  "schemaVersion": 1,
+  "retrievedDateLocal": "2026-11-07 Asia/Taipei",
+  "purpose": "Qualitative support and explicit limitations for authored game character profiles. These sources are not a parcel survey.",
+  "sources": [
+    {
+      "id": "municipal-roads-114",
+      "publisher": "Taichung City Government",
+      "title": "臺中市各類道路圖（最新114年成果）",
+      "url": "https://data.gov.tw/en/datasets/177459",
+      "dataPeriod": "2025 / ROC114 survey edition; source portal updated 2026-06-04",
+      "verificationLevel": "downloaded primary source; raw archive hashes and source geometry retained in docs/city-v2-streets.json",
+      "supports": "Real road names and geometry, source survey district fields, and the existing 16-section sizing grid.",
+      "limitations": "Road width and survey segment counts do not establish building use, age, height, population density or zoning. District-at-center does not make a section an administrative district."
+    },
+    {
+      "id": "central-old-street-2026",
+      "publisher": "Taichung Urban Development Bureau",
+      "title": "115年度臺中市老舊街區活化整修補助計畫，並自公告日起生效。",
+      "url": "https://www.ud.taichung.gov.tw/28928/28931/28937/3231245",
+      "publishedDate": "2026-03-12",
+      "verificationLevel": "primary page body read",
+      "supports": "The city funds restoration of qualifying older commercial street houses in and around Central District, including streets such as Zhongshan, Minquan and Taiwan Boulevard. Eligibility requires a legal building at least 30 years old that is open for business.",
+      "limitations": "A programme eligibility boundary and list of priority streets are not a measurement of how many buildings are old, commercial or preserved. No exact parcel age or share is inferred."
+    },
+    {
+      "id": "fengjia-business-district-2025",
+      "publisher": "Xitun District Office",
+      "title": "逢甲商圈",
+      "url": "https://www.xitun.taichung.gov.tw/831932/831997/1513668/1514200",
+      "publishedDate": "2025-03-11",
+      "updatedDate": "2025-04-11",
+      "verificationLevel": "primary page body read",
+      "supports": "A university-related shopping district formed around Xitun, Fengjia, Fuxing and Wenhua roads, with inexpensive goods and food.",
+      "limitations": "This describes a shopping area, not every lot in its 64x64 section. It provides no age, height or residential-share statistics."
+    },
+    {
+      "id": "greenway-cultural-corridor",
+      "publisher": "Taichung Tourism and Travel Bureau",
+      "title": "草悟道",
+      "url": "https://travel.taichung.gov.tw/zh-tw/Attractions/Intro/786/",
+      "publishedDate": null,
+      "verificationLevel": "primary tourism page indexed text read",
+      "supports": "The greenway links the Science Museum, civic and cultural spaces, dining and the Fine Arts Museum. Its activity and open-space intensity varies along the corridor.",
+      "limitations": "A cultural walking corridor does not describe all surrounding residential blocks or quantify their age, height or tree coverage."
+    },
+    {
+      "id": "municipal-business-corridors",
+      "publisher": "Taichung Tourism and Travel Bureau",
+      "title": "商圈巡禮",
+      "url": "https://taichung.travel/zh-tw/shop/business",
+      "publishedDate": null,
+      "verificationLevel": "primary tourism page indexed text read",
+      "supports": "Gongyi Road is described as a dining corridor; Yizhong as student-oriented shopping and food streets; Jiguang near the old station as established food and shopping streets.",
+      "limitations": "Retail descriptions inform selected frontages, not legal land use, whole-section uniformity, exact density or building age."
+    },
+    {
+      "id": "seventh-commercial-cluster-2025",
+      "publisher": "Taichung City Government / Transportation Bureau",
+      "title": "新光三越復業首日 交通大致順暢 市府多管齊下維持秩序",
+      "url": "https://www.taichung.gov.tw/8868/8872/9962/3104993",
+      "publishedDate": "2025-09-28",
+      "verificationLevel": "primary page body read",
+      "supports": "The seventh-redevelopment shopping district is linked on foot to department stores, the National Taichung Theater and nearby municipal parks including Maple Garden.",
+      "limitations": "A traffic-management report supports the cluster of commerce, culture and parks. Its contemporary visual treatment and tower share remain authored; it does not supply a building-age inventory."
+    },
+    {
+      "id": "fourteenth-redevelopment-boundary-2020",
+      "publisher": "Taichung City Government / Land Administration Bureau",
+      "title": "中市14期市地重劃區土地分配完成 1/17起公告30天",
+      "url": "https://www.taichung.gov.tw/8868/8872/9962/1453777/",
+      "publishedDate": null,
+      "dataPeriod": "2020 land-allocation announcement",
+      "verificationLevel": "primary search-index excerpt read; direct page fetch timed out",
+      "supports": "The redevelopment extends from Changping East Seventh Road toward the Shuinan/Zhongqing area, between Dalian Road and Huanzhong Road, across parts of Beitun and Xitun.",
+      "limitations": "The scheme is only part of the northern grid. Land redistribution is not proof that all construction is complete or contemporary. No exact redevelopment polygon is included in these profiles."
+    },
+    {
+      "id": "thirteenth-redevelopment-completion-2026",
+      "publisher": "Taichung City Government / Land Administration Bureau",
+      "title": "第13期大慶市地重劃區完工謝土 中市府：打造南區、南屯區交通轉運樞紐",
+      "url": "https://www.taichung.gov.tw/8868/8872/9962/3200714",
+      "publishedDate": "2026-01-28",
+      "verificationLevel": "primary page and indexed body text read",
+      "supports": "The Daqing redevelopment covers parts of South and Nantun districts. The public works programme reorganizes land and transport links while retaining cultural assets.",
+      "limitations": "Completion of redevelopment works does not mean every housing parcel is built. The exact scheme boundary is not overlaid, so transfer into southern sections is a broad proxy."
+    },
+    {
+      "id": "nantun-historical-core",
+      "publisher": "Nantun District Office",
+      "title": "歷史沿革",
+      "url": "https://www.nantun.taichung.gov.tw/982147/982148/982150/982151/1069507",
+      "publishedDate": null,
+      "verificationLevel": "primary indexed body text read",
+      "supports": "Nantun developed from the Litoudian trading settlement, associated with agricultural-tool makers and older shops.",
+      "limitations": "Settlement history does not date current buildings or make all of Nantun an old town. Mixed older pockets are a cautious visual interpretation around a much broader modern city."
+    },
+    {
+      "id": "xingda-student-food-streets",
+      "publisher": "South District Office",
+      "title": "興大商圈",
+      "url": "https://www.south.taichung.gov.tw/831936/2412251/2829165/2829254",
+      "publishedDate": "2022-07-18",
+      "updatedDate": "2024-06-25",
+      "verificationLevel": "primary page body read",
+      "supports": "The student food district is on Xuefu Road in front of National Chung Hsing University, with food businesses in adjoining alleys and a nearby riverfront walk.",
+      "limitations": "It does not establish surrounding building ages, exact residential shares or a usable river geometry. No waterway is drawn from this text."
+    },
+    {
+      "id": "east-industrial-history",
+      "publisher": "East District Office",
+      "title": "臺中市東區歷史沿革概述",
+      "url": "https://www.east.taichung.gov.tw/1339530/post",
+      "publishedDate": null,
+      "verificationLevel": "primary indexed body text read",
+      "supports": "East District's twentieth-century planning and development included sugar-industry land and metalworking communities.",
+      "limitations": "Historical industry is not a present-day factory inventory. The grid straddles East and Taiping, so workshop use is a low-confidence authored accent rather than assigned zoning."
+    },
+    {
+      "id": "north-historical-housing-age-proxy",
+      "publisher": "Ministry of the Interior real-estate information platform",
+      "title": "北區中德段社會住宅可行性報告：總結報告書",
+      "url": "https://pip.moi.gov.tw/Upload/File/SocialHousing/Report/%E5%8C%97%E5%8D%80%E4%B8%AD%E5%BE%B7%E6%AE%B5.pdf",
+      "publishedDate": null,
+      "dataPeriod": "historical study citing the MOI platform on 2021-08-12; not a 2026 estimate",
+      "verificationLevel": "primary PDF search-index excerpt only; direct document request rejected by the source server",
+      "supports": "The indexed historical study describes North District's average housing age as 31 years against 29 citywide.",
+      "limitations": "Not independently re-read in the full PDF, not a current statistic, not a section mean and not a parcel age. Retained as a low-confidence historical lead only.",
+      "usedForNumericalWeightCalibration": false
+    }
+  ],
+  "inferencePolicy": [
+    "Broad source character can inform an authored visual archetype, but all use, age/style, height, color, frontage, density and green-space weights are designer targets.",
+    "No current building-age, cadastral zoning, building-height, building-footprint or population-density layer was obtained for the 16 sections.",
+    "Road-width and road-segment counts must not be used to infer exact building age, legal use or population density.",
+    "The raw municipal source remains the location reference. Proposed game entrances and locally stretched roads are separate authored geometry."
+  ]
+}
