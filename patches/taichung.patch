+        assert not (road_cells & art), f"road crosses {lm['id']} art"
+        assert tuple(lm["proposedAuthoredLocal"]["arrival"]) in road_cells
+    for i, a in enumerate(landmarks):
+        for b in landmarks[i+1:]:
+            ar, br = a["proposedAuthoredLocal"]["reserveRect"], b["proposedAuthoredLocal"]["reserveRect"]
+            gap_x, gap_y = max(ar[0]-br[2]-1, br[0]-ar[2]-1, 0), max(ar[1]-br[3]-1, br[1]-ar[3]-1, 0)
+            assert max(gap_x, gap_y) >= 2, f"reserve conflict {a['id']} {b['id']}"
+    # These are authored empty rectangles, not extracted building footprints.
+    occupied = road_cells | protected
+    lots = []
+    catalog = json.loads((ROOT/"data/taichung/prefabs/catalog.json").read_text())
+    building_roles = {"residential-lowrise", "residential-walkup", "commercial-frontage", "civic-service", "neighborhood-service", "market-stall"}
+    for y in range(2, 57, 2):
+        for x in range(2, 57, 2):
+            for width, height in ((12, 8), (10, 6), (8, 8), (8, 6), (5, 8), (5, 6), (5, 5)):
+                rect = [x, y, x+width-1, y+height-1]
+                if rect[2] > 61 or rect[3] > 61 or rect_cells(rect) & occupied:
+                    continue
+                dist = min(math.hypot(px-(x+width/2), py-(y+height/2)) for px, py in road_cells)
+                band = "primaryRetailFrontage" if 25 < y < 54 and dist < 9 else "residentialSideStreet"
+                compatible = [p["id"] for p in catalog["prefabs"] if p["role"] in building_roles and p["width"] <= width and p["height"] <= height]
+                assert compatible, "candidate cannot fit a building module"
+                lots.append({"id": f"pilot-r2c2-lot-{x}-{y}", "sectionId": SECTION,
+                             "localRect": rect, "width": width, "height": height,
+                             "sourceBuildingId": None, "selectedPrefabId": None,
+                             "streetBand": band, "profileRef": SECTION,
+                             "compatibleSizeOnlyPrefabIds": compatible,
+                             "status": "unpainted authored candidate; apply actual prefab masks before use"})
+                occupied |= rect_cells([max(0,rect[0]-1),max(0,rect[1]-1),min(63,rect[2]+1),min(63,rect[3]+1)])
+                break
+    components = connected_components(road_cells)
+    assert len(components) == 1, f"disconnected walking space {components}"
+    return {
+        "schemaVersion": 1, "status": "isolated authored pilot for focused review; not native-registered",
+        "sectionId": SECTION, "width": 64, "height": 64, "worldOrigin": [128, 128],
+        "sourceStreetDraft": {"path": "docs/city-v2-streets.json", "sha256": source_hash},
+        "sourceEvidenceRefs": ["municipal-roads-114", "central-old-street-2026"],
+        "coordinateContract": {
+            "unit": "16x16-pixel metatile", "localOrigin": "northwest, zero-based",
+            "rectangles": "inclusive integer bounds [left,top,right,bottom]",
+            "rawProjectedLocal": "unmodified source projection minus worldOrigin; not a game entrance",
+            "proposedAuthoredLocal": "new pilot-only coordinates; not currentMap43 coordinates",
+            "nativeBaseline": "unchanged; requires versioned map/door/save contract before integration"},
+        "sourceRoads": raw, "authoredRoads": roads,
+        "landmarks": landmarks, "clearApproaches": APPROACHES,
+        "candidateLots": lots,
+        "independentSeamSuggestions": [
+            {"edge": "north", "localPoint": [43,0], "roadName": "五權路", "pairedNeighborPort": None},
+            {"edge": "north", "localPoint": [54,0], "roadName": "雙十路一段", "pairedNeighborPort": None},
+            {"edge": "west", "localPoint": [0,32], "roadName": "五權路", "pairedNeighborPort": None},
+            {"edge": "west", "localPoint": [0,36], "roadName": "民生路", "pairedNeighborPort": None},
+            {"edge": "south", "localPoint": [13,63], "roadName": "建國路", "pairedNeighborPort": None},
+            {"edge": "south", "localPoint": [20,63], "roadName": "民生路", "pairedNeighborPort": None}],
