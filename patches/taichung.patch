index 00000000..6b031277
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/qa/serve.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Serve the tile limit probe's QA page, one ROM, the mGBA runtime and an optional save on loopback."""
+import argparse
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from urllib.parse import urlsplit
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--rom', type=Path, required=True)
+parser.add_argument('--runtime', type=Path, required=True, help='directory with mgba.js and mgba.wasm')
+parser.add_argument('--save', type=Path)
+parser.add_argument('--port', type=int, default=8831)
+args = parser.parse_args()
+here = Path(__file__).parent
+routes = {
+    '/': (here / 'page.html', 'text/html; charset=utf-8'),
+    '/mgba.js': (args.runtime / 'mgba.js', 'text/javascript; charset=utf-8'),
+    '/mgba.wasm': (args.runtime / 'mgba.wasm', 'application/wasm'),
+    '/rom.gba': (args.rom, 'application/octet-stream'),
+}
+if args.save: routes['/start.sav'] = (args.save, 'application/octet-stream')
+for path, _ in routes.values():
+    if not path.is_file(): parser.error(f'Missing input: {path}')
+
+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, *a): pass
+    def do_GET(self):
+        route = routes.get(urlsplit(self.path).path)
+        if route is None: self.send_error(404); return
+        data = route[0].read_bytes()
+        self.send_response(200)
+        for k, v in (('Content-Type', route[1]), ('Content-Length', str(len(data))), ('Cross-Origin-Opener-Policy', 'same-origin'),
+                     ('Cross-Origin-Embedder-Policy', 'require-corp'), ('Cross-Origin-Resource-Policy', 'same-origin'), ('Cache-Control', 'no-store')):
+            self.send_header(k, v)
+        self.end_headers(); self.wfile.write(data)
+
+print(f'http://127.0.0.1:{args.port}/', flush=True)
+ThreadingHTTPServer(('127.0.0.1', args.port), Handler).serve_forever()
diff --git a/tools/taichung/tile_limit_probe/qa/sweep.mjs b/tools/taichung/tile_limit_probe/qa/sweep.mjs
new file mode 100644
index 00000000..eae13a0a
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/qa/sweep.mjs
@@ -0,0 +1,238 @@
+// Exercise the streamed maps with the same mGBA runtime as the web player.
+import assert from 'node:assert/strict';
+import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { open, flushRecording } from './cdp.mjs';
+
+const [outDir, nav, stats, battleBuffer, battleExec, mode] = process.argv.slice(2);
+const report = JSON.parse(readFileSync(new URL('../probe-report.json', import.meta.url)));
+const qa = await open({ url: 'http://127.0.0.1:8831/', outDir });
+const maps = Object.entries(report.maps);
+const results = [];
+const position = s => [s.map, s.x, s.y];
+const directions = [['Right', 1, 0], ['Left', -1, 0], ['Down', 0, 1], ['Up', 0, -1]];
+const oldCity = 0;
+const bike = 1 << 5;
+const canToggleBike = 1 << 6;
+const battle = 1 << 2;
+const dialogue = 1 << 5;
+
+async function waitFor(check, label, ms = 12000) {
+  const end = Date.now() + ms;
+  let state;
+  do {
+    state = await qa.state();
+    if (check(state)) return state;
+    await qa.sleep(60);
+  } while (Date.now() < end);
+  await qa.shot('timeout');
+  throw new Error(label + ' timed out at ' + JSON.stringify({ position: position(state), context: state.context }));
+}
+
+async function boot() {
+  for (let i = 0; i < 60; i++) {
+    if ((await qa.state()).field) return;
+    await qa.press(i % 5 === 4 ? 'Start' : 'A', 75, 330);
+  }
+  throw new Error('The fixture did not reach the field');
+}
+
+async function mark(label, validateTiles = true) {
+  await qa.sleep(420);
+  const state = await waitFor(s => s.field, label);
+  assert.equal(state.stream.overflowTiles, 0, label);
+  assert.equal(state.stream.overflowPals, 0, label);
+  await qa.shot(label);
+  const record = { label, ...state };
+  results.push(record);
+  writeFileSync(join(outDir, 'route.json'), JSON.stringify(results, null, 2));
+  if (validateTiles) {
+    assert(state.stream.active, label);
+    appendFileSync(join(outDir, 'frames.jsonl'), JSON.stringify({
+      tag: 'v:settled', v: state.timing.vblanks, ...state,
+      tiles: state.stream.residentTiles, pals: state.stream.residentPals,
+      overflowTiles: state.stream.overflowTiles, overflowPals: state.stream.overflowPals,
+      late: state.timing.lateFrames, file: '../' + label + '.png',
+    }) + '\n');
+  } else {
+    assert(!state.stream.active, 'Ordinary maps should use the regular renderer');
+  }
+  console.log(label, position(state).join(' '), 'tiles', state.stream.residentTiles,
+              'palettes', state.stream.residentPals);
+  return state;
+}
+
+async function moveAxis(positive, negative, delta) {
+  if (!delta) return;
+  const moved = await qa.walk(delta > 0 ? positive : negative, Math.abs(delta));
+  assert.equal(moved.moved, Math.abs(delta), 'Could not walk ' + positive + '/' + negative);
+}
+
+async function enter(name) {
+  const m = report.maps[name];
+  const s = await waitFor(v => v.field && v.map === oldCity, 'Old City');
+  await moveAxis('Down', 'Up', m.old_city[1] - 2 - s.y);
+  const atQuay = await qa.state();
+  await moveAxis('Right', 'Left', m.old_city[0] - atQuay.x);
+  await qa.walk('Down', 2);
+  await waitFor(v => v.field && v.map === m.number, 'enter ' + name);
+  await qa.sleep(3600); // Let the map name disappear before comparing pixels.
+}
+
+function walkable(m, x, y, allowExit) {
+  if (m.solid[y]?.[x] !== '0') return false;
+  if (m.host?.[0] === x && m.host[1] === y) return false;
+  return allowExit || m.way_back?.[0] !== x || m.way_back[1] !== y;
+}
+
+function route(start, target, allowExit = false) {
+  const queue = [start];
+  const links = new Map([[start.join(','), null]]);
+  for (const node of queue) {
+    const [name, x, y] = node;
+    if (node.join(',') === target.join(',')) {
+      const path = [];
+      for (let step = links.get(node.join(',')); step; step = links.get(step.from.join(','))) {
+        path.push(step.direction);
+      }
+      const moves = [];
+      for (const direction of path.reverse()) {
+        if (moves.at(-1)?.[0] === direction) moves.at(-1)[1]++;
+        else moves.push([direction, 1]);
+      }
+      return moves;
+    }
+    const m = report.maps[name];
+    for (const [direction, dx, dy] of directions) {
+      let nx = x + dx, ny = y + dy, destination = name;
+      if (nx < 0) {
+        destination = m.rightOf;
+        if (!destination) continue;
+        nx = report.maps[destination].size[0] - 1;
+      } else if (nx >= m.size[0]) {
+        destination = m.leftOf;
+        if (!destination) continue;
+        nx = 0;
+      }
+      const next = [destination, nx, ny];
+      const key = next.join(',');
+      const isExit = allowExit && key === target.join(',');
+      if (links.has(key) || !walkable(report.maps[destination], nx, ny, isExit)) continue;
+      links.set(key, { from: node, direction });
+      queue.push(next);
+    }
+  }
+  throw new Error('No route from ' + start + ' to ' + target);
+}
+
+async function go(name, x, y, allowExit = false) {
+  const s = await waitFor(v => v.field, 'movement');
+  const current = maps.find(([, info]) => info.number === s.map)?.[0];
+  assert(current, 'Expected to start in a probe map');
+  const sequence = route([current, s.x, s.y], [name, x, y], allowExit);
+  const moved = await qa.evaluate('qa.run(' + JSON.stringify(sequence) + ', 1800)');
+  assert.deepEqual(moved, sequence.map(([, n]) => n), 'Interrupted route to ' + [name, x, y]);
+  if (allowExit) {
+    await waitFor(v => v.field && v.map === oldCity, 'return to Old City');
+  } else {
+    await waitFor(v => v.field && v.map === report.maps[name].number && v.x === x && v.y === y,
+                  'arrive at ' + [name, x, y]);
+  }
+}
+
+async function hotspot(name, key, label) {
+  const target = report.maps[name][key][0];
+  await go(name, target.x, target.y);
+  return mark(label);
+}
+
+async function setBike(active) {
+  for (let i = 0; i < 3; i++) {
+    const s = await waitFor(v => v.field && (v.flags & canToggleBike), 'bike input available');
+    if (Boolean(s.flags & bike) === active) return;
+    await qa.press('B', 100, 1050);
+  }
+  const s = await qa.state();
+  assert.equal(Boolean(s.flags & bike), active, 'Bike state changed after the shortcut');
+}
+
+async function saveAndContinue() {
+  const s = await qa.state();
+  await qa.press('Start', 90, 490);
+  for (let i = 0; i < 5; i++) await qa.press('Down', 70, 90);
+  await qa.press('A', 100, 600);
+  await qa.shot('save-prompt');
+  for (let i = 0; i < 8 && !(await qa.state()).field; i++) await qa.press('A', 90, 650);
+  await waitFor(v => v.field, 'save');
+  await qa.evaluate('qa.reset()');
+  await boot();
+  const continued = await mark('saved-and-continued');
+  assert.deepEqual(position(continued), position(s), 'Continue restored the saved streamed position');
+}
+
+async function talkAndBattle() {
+  const [x, y] = report.maps.A.host;
+  await go('A', x, y + 1);
+  for (let i = 0; i < 3 && (await qa.state()).facing !== 2; i++) await qa.press('Up', 130, 500);
+  await waitFor(s => s.field && s.facing === 2, 'facing the host');
+  await qa.press('A', 90, 780);
+  await waitFor(s => s.context & dialogue, 'host dialogue');
+  await qa.shot('host-dialogue');
+  for (let i = 0; i < 8 && !((await qa.state()).context & battle); i++) {
+    await qa.press('A', 75, 720);
+  }
+  await waitFor(s => s.context & battle, 'host battle');
+  for (let i = 0; i < 24 && !await qa.evaluate('qa.battleActionReady()'); i++) {
+    await qa.press('B', 55, 400); // Dismiss the introductory battle text.
+  }
+  await qa.shot('battle');
+  assert(await qa.evaluate('qa.battleActionReady()'), 'Wild battle reached the action menu');
+  // The first wild-battle action menu starts on Fight.
+  await qa.press('Down', 85, 180);
+  await qa.press('Right', 85, 180);
+  for (let i = 0; i < 6 && !(await qa.state()).field; i++) await qa.press('A', 90, 630);
+  await mark('back-from-battle');
+}
+
+async function sweep() {
+  await hotspot('A', 'hardestForTiles', 'dadun-dense-art');
+
+  await setBike(true);
+  const beforeSeams = await qa.state();
+  await qa.evaluate("qa.recordStart('v:bike-seams')");
+  for (const [name, x, y] of [['B', 7, 23], ['A', 35, 23], ['B', 7, 23]]) {
+    await go(name, x, y);
+  }
+  await qa.evaluate('qa.recordStop()');
+  const recording = await flushRecording(qa, outDir);
+  const afterSeams = await mark('bike-across-seams');
+  console.log('Seam stress:', recording, 'recorded frames,',
+              afterSeams.timing.lateFrames - beforeSeams.timing.lateFrames, 'late frames');
+  await hotspot('B', 'hardestForPalettes', 'dadun-palette-peak');
+  await saveAndContinue();
+  await setBike(false);
+  await go('A', ...report.maps.A.way_back, true);
+
+  await enter('C');
+  await hotspot('C', 'hardestForTiles', 'old-city-dense-art');
+  await go('C', ...report.maps.C.way_back, true);
+
+  await enter('D');
+  await hotspot('D', 'hardestForPalettes', 'central-park-palette-peak');
+  await go('D', ...report.maps.D.way_back, true);
+  await mark('legacy-old-city-after-streaming', false);
+}
+
+try {
+  await qa.load({
+    nav: Number(nav), stats: Number(stats), battleBuffer: Number(battleBuffer), battleExec: Number(battleExec),
+  }, true);
+  await boot();
+  await mark('legacy-old-city', false);
+  await enter('A');
+  await mark('dadun-first-entry');
+  if (mode === '--battle') await talkAndBattle();
+  else await sweep();
+} finally {
+  qa.close();
+}
diff --git a/tools/taichung/tile_limit_probe/qa/verify_frames.py b/tools/taichung/tile_limit_probe/qa/verify_frames.py
new file mode 100644
index 00000000..98beb73d
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/qa/verify_frames.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Compare captured game frames with the block fill's own preview of the same ground.
+
+For every frame taken on a probe map, the 240x160 picture the game showed is laid over
+the preview render of the region (made by the fill's preview engine from the same
+placements, independently of build_probe.py) at the player's position, and compared
+pixel by pixel in the GBA's 15-bit colour. The player, the host and any window are
+masked out. Also recounts, from the generated map data, how many distinct tiles and
+palettes the engine's 16x16 metatile draw window holds at that position, to set
+beside what the game's own counters reported.
+
+  python3 verify_frames.py <frames dir with a log json> <reference-region.png> [log name]
+"""
+import json, os, struct, sys
+from PIL import Image, ImageChops
+
+HERE = os.path.dirname(os.path.abspath(__file__)); ROOT = os.path.abspath(os.path.join(HERE, '../../../..'))
+frames_dir, reference_path = sys.argv[1], sys.argv[2]
+log_name = sys.argv[3] if len(sys.argv) > 3 else 'run.json'
+report = json.load(open(os.path.join(HERE, '..', 'probe-report.json')))
+SPLIT = report['events']['split']; HOST = report['events']['host']; DOOR = report['events']['door']
+MAPS = {21: ('A', 0), 22: ('B', SPLIT)}       # map number in group 43 -> (name, first region column)
+reference = Image.open(reference_path).convert('RGB')
+
+def q(im): return im.point(lambda v: v >> 3)
+
+# ---- the generated data, for the recount
+def u16(path): d = open(path, 'rb').read(); return struct.unpack('<%dH' % (len(d) // 2), d)
+T = os.path.join(ROOT, 'data/tilesets/secondary/taichung_tile_probe')
+primary = u16(os.path.join(ROOT, 'data/tilesets/primary/taichung_approved_old_city_north/metatiles.bin'))
+tables = {n: (u16(os.path.join(T, f'metatiles_{n}.bin')), open(os.path.join(T, f'banks_{n}.bin'), 'rb').read()) for n in 'ab'}
+grids = {}
+for n in 'AB':
+    size = report['maps']['TaichungTileProbe' + n]['size']
+    grids[n] = (size, u16(os.path.join(ROOT, f'data/layouts/TaichungTileProbe{n}/map.bin')))
+border = u16(os.path.join(ROOT, 'data/layouts/TaichungTileProbeA/border.bin'))
+def block_at(name, x, y):
+    """Map grid block the engine sees at local (x, y) of this map, connection strips and border included."""
+    (w, h), g = grids[name]
+    if 0 <= x < w and 0 <= y < h: return g[y * w + x]
+    other = 'B' if name == 'A' else 'A'; (ow, oh), og = grids[other]
+    ox = x - w if name == 'A' else x + ow
+    if 0 <= y < oh and 0 <= ox < ow and (0 <= x - w < 8 if name == 'A' else -7 <= x < 0): return og[y * ow + ox]
+    return border[((x - 7 + 16) % 2) + ((y - 7 + 16) % 2) * 2]
+def window_need(name, px, py):
+    tiles, pals = set(), set()
+    metatiles, banks = tables[name.lower()]
+    for y in range(py - 7, py + 9):
+        for x in range(px - 7, px + 9):
+            b = block_at(name, x, y); m = (b & 0x3FF) | ((b & 0x800) >> 1)
+            for i in range(8):
+                if m < 640: raw, bank = primary[m * 8 + i], 0
+                else: raw, bank = metatiles[(m - 640) * 8 + i], banks[(m - 640) * 8 + i]
+                t = ((bank & 0x3F) << 10) | (raw & 0x3FF)
+                if t: tiles.add(t); pals.add((raw >> 12) | ((bank >> 6) << 4))
+    pinned = {t for t in tiles if 508 <= t < 512}
+    return len(tiles - pinned), len(pals)
+
+rows = []
+for entry in json.load(open(os.path.join(frames_dir, log_name))):
+    if entry.get('skip') or entry.get('door'): continue    # door frames: the camera moves and the screen fades while the player walks in
+    s = entry['state'] if entry['state'].get('field') else dict(entry.get('at') or {}, stream=entry['state'].get('stream'))
+    if s.get('group') != 43 or s.get('map') not in MAPS or not entry['state'].get('stream', {}).get('active'): continue
+    name, x0 = MAPS[s['map']]
+    rx, ry = s['x'] + x0, s['y']
+    frame = Image.open(os.path.join(frames_dir, entry['name'] + '.png')).convert('RGB')
+    left, top = (rx - 7) * 16, (ry - 5) * 16 + 8
+    expect = Image.new('RGB', (240, 160), (255, 0, 255)); expect.paste(reference, (-left, -top))
+    inside = Image.new('L', (240, 160), 0); inside.paste(255, (-left, -top, reference.width - left, reference.height - top))
+    mask = inside.copy()
+    def hide(cx, cy):       # a person standing on region cell (cx, cy): 16 wide, 32 tall, a little slack
+        sx, sy = (cx - rx + 7) * 16, (cy - ry + 5) * 16 - 8
+        mask.paste(0, (sx - 2, sy - 20, sx + 18, sy + 18))
+    hide(rx, ry); hide(*HOST)
+    dx, dy = (DOOR[0] - rx + 7) * 16, (DOOR[1] - ry + 5) * 16 - 8      # the FireRed door stands in for the shop's own
+    mask.paste(0, (dx, dy, dx + 16, dy + 16))
+    if entry.get('window'): mask.paste(0, tuple(entry['window']))
+    diff = ImageChops.difference(q(frame), q(expect)).convert('L').point(lambda v: 255 if v else 0)
+    bad = ImageChops.multiply(diff, mask)
+    compared = sum(1 for v in mask.tobytes() if v); wrong = sum(1 for v in bad.tobytes() if v)
+    tiles, pals = window_need(name, s['x'], s['y'])
+    rows.append({'frame': entry['name'], 'map': 'TaichungTileProbe' + name, 'x': s['x'], 'y': s['y'], 'pixelsCompared': compared, 'pixelsDifferent': wrong,
+                 'match': round(1 - wrong / max(1, compared), 5), 'windowTilesRecount': tiles, 'windowTilesGame': s['stream']['residentTiles'],
+                 'windowPalettesRecount': pals, 'windowPalettesGame': s['stream']['residentPals'], 'freshlyDrawn': bool(entry.get('exact'))})
+    if wrong:
+        out = Image.merge('RGB', (bad, bad.point(lambda v: 0), bad.point(lambda v: 0)))
+        Image.blend(frame, out, 0.6).save(os.path.join(frames_dir, entry['name'] + '.diff.png'))
+import glob
+for stale in glob.glob(os.path.join(frames_dir, '*.diff.png')):
+    if os.path.basename(stale)[:-9] not in {r['frame'] for r in rows if r['pixelsDifferent']}: os.remove(stale)
+json.dump(rows, open(os.path.join(frames_dir, 'verify.json'), 'w'), indent=1)
+exact = [r for r in rows if r['freshlyDrawn']]
+print(len(rows), 'frames compared;', sum(r['pixelsDifferent'] for r in rows), 'pixels differ of', sum(r['pixelsCompared'] for r in rows))
+print('freshly drawn views where the game holds exactly the recounted tiles and palettes:', sum(1 for r in exact if r['windowTilesRecount'] == r['windowTilesGame'] and r['windowPalettesRecount'] == r['windowPalettesGame']), 'of', len(exact))
+for r in rows: print(r['frame'].ljust(26), r['map'][-1], str((r['x'], r['y'])).ljust(9), f"match {r['match']:.4f} ({r['pixelsDifferent']} of {r['pixelsCompared']} differ)", f"tiles {r['windowTilesGame']}/{r['windowTilesRecount']}", f"palettes {r['windowPalettesGame']}/{r['windowPalettesRecount']}")
diff --git a/tools/taichung/tile_limit_probe/qa/verify_stress.py b/tools/taichung/tile_limit_probe/qa/verify_stress.py
new file mode 100644
index 00000000..0c8c2a93
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/qa/verify_stress.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Check every recorded frame of a stress run against what a correct engine would show.
+
+stress.mjs records each frame the game draws while the player moves, with the position the game
+reported at that moment. expected/<map>.png (written by build_probe.py from the generated map data
+alone) is what the three map layers should show. For each frame this finds the camera offset at
+which the frame equals that picture, pixel for pixel in the GBA's 15-bit colour, outside:
+  the player (and one tile around, for the bike and grass effects), the host, animated flower cells.
+Moving captures may show the camera on the map just left or carry both axes
+of an unfinished step. A capture with two exact horizontal bands is reported
+separately, since it does not prove that an entire frame was drawn correctly.
+
+  python3 verify_stress.py <stress dir>      reads frames.jsonl + frames/, writes verify-stress.json
+"""
+import json, os, sys
+import numpy as np
+from PIL import Image
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+out_dir = sys.argv[1]
+report = json.load(open(os.path.join(HERE, '..', 'probe-report.json')))
+M = report['margin'] * 16
+maps = {}
+for name, info in report['maps'].items():
+    im = np.asarray(Image.open(os.path.join(HERE, '..', 'expected', name + '.png')).convert('RGB')) >> 3
+    maps[info['number']] = (name, info, im)
+def neighbours(info):
+    out = []
+    for key, sign in (('leftOf', 1), ('rightOf', -1)):
+        other = info.get(key)
+        if other: out.append((report['maps'][other], info['size'][0] if sign == 1 else -report['maps'][other]['size'][0]))
+    return out
+
+def mask_for(info, left, top):
+    """True where the frame should equal the picture. left/top: screen origin in map pixels."""
+    keep = np.ones((160, 240), bool)
+    def hide(x0, y0, x1, y1):
+        keep[max(0, y0):max(0, y1), max(0, x0):max(0, x1)] = False
+    hide(96, 40, 144, 96)                                           # the player, at the centre
+    def person(cx, cy): hide(cx * 16 - left - 2, cy * 16 - top - 20, cx * 16 - left + 18, cy * 16 - top + 18)
+    def cell(cx, cy): hide(cx * 16 - left, cy * 16 - top, cx * 16 - left + 16, cy * 16 - top + 16)
+    if 'host' in info: person(*info['host'])
+    for cx, cy in info['flowerCells']: cell(cx, cy)
+    for other, dx in neighbours(info):
+        if 'host' in other: person(other['host'][0] + dx, other['host'][1])
+        for cx, cy in other['flowerCells']: cell(cx + dx, cy)
+    return keep
+
+def compare(frame, name_info_im, x, y, ox, oy):
+    name, info, im = name_info_im
+    left, top = (x - 7) * 16 + ox, (y - 5) * 16 + 8 + oy
+    a, b = top + M, left + M
+    if a < 0 or b < 0 or a + 160 > im.shape[0] or b + 240 > im.shape[1]: return None
+    diff = (frame != im[a:a + 160, b:b + 240]).any(axis=2) & mask_for(info, left, top)
+    return int(diff.sum()), diff
+
+OFFSETS = [(0, 0)] + [(d, 0) for k in range(1, 25) for d in (k, -k)] + [(0, d) for k in range(1, 25) for d in (k, -k)]
+OFFSETS_2D = np.arange(-24, 25)
+SAMPLE_Y, SAMPLE_X = np.mgrid[4:160:9, 4:240:11].reshape(2, -1)
+OUTSIDE_PLAYER = (SAMPLE_X < 96) | (SAMPLE_X >= 144) | (SAMPLE_Y < 40) | (SAMPLE_Y >= 96)
+SAMPLE_X, SAMPLE_Y = SAMPLE_X[OUTSIDE_PLAYER], SAMPLE_Y[OUTSIDE_PLAYER]
+
+def compare_movement(frame, entry, x, y):
+    """Search both axes and either side of a seam, then compare at full resolution."""
+    candidates = [(entry, x)]
+    candidates.extend((maps[other['number']], x - shift) for other, shift in neighbours(entry[1]))
+    matches = []
+    for ref, local_x in candidates:
+        im = ref[2]
+        left, top = (local_x - 7) * 16 + M, (y - 5) * 16 + 8 + M
+        dx = OFFSETS_2D[(left + OFFSETS_2D >= 0) & (left + OFFSETS_2D + 240 <= im.shape[1])]
+        dy = OFFSETS_2D[(top + OFFSETS_2D >= 0) & (top + OFFSETS_2D + 160 <= im.shape[0])]
+        if not len(dx) or not len(dy):
+            continue
+        colors = im[top + dy[:, None, None] + SAMPLE_Y, left + dx[None, :, None] + SAMPLE_X]
+        scores = (colors != frame[SAMPLE_Y, SAMPLE_X]).any(axis=3).sum(axis=2)
+        ranked = np.argsort(scores, axis=None)[:16]
+        for iy, ix in zip(*np.unravel_index(ranked, scores.shape)):
+            ox, oy = int(dx[ix]), int(dy[iy])
+            error, mask = compare(frame, ref, local_x, y, ox, oy)
+            matches.append((error, (ox, oy), mask, ref[0]))
+    return matches
+
+def has_two_exact_bands(matches):
+    rows = [mask.sum(axis=1) for _, _, mask, _ in matches]
+    for first in rows:
+        prefix = np.r_[0, np.cumsum(first)]
+        for second in rows:
+            suffix = np.r_[np.cumsum(second[::-1])[::-1], 0]
+            if np.any((prefix + suffix)[1:-1] == 0):
+                return True
+    return False
+
+rows = []; wrong = []; last = (0, 0)
+frames_path = os.path.join(out_dir, 'frames.jsonl')
+os.makedirs(os.path.join(out_dir, 'wrong'), exist_ok=True)
+for line in open(frames_path):
+    f = json.loads(line)
+    row = {'tag': f['tag'], 'v': f['v'], 'map': f['map'], 'x': f['x'], 'y': f['y'], 'late': f['late'], 'overflowTiles': f['overflowTiles'], 'overflowPals': f['overflowPals'], 'tiles': f['tiles'], 'pals': f['pals']}
+    if not f['tag'].startswith('v:') or not f['field'] or f['group'] != report['mapGroup'] or f['map'] not in maps:
+        row['status'] = 'not compared'; rows.append(row); continue
+    frame = np.asarray(Image.open(os.path.join(out_dir, 'frames', f['file'])).convert('RGB')) >> 3
+    best = None
+    # the camera can also lag a whole step behind the reported position, on this map or the one just left
+    for cand in [last] + OFFSETS:
+        r = compare(frame, maps[f['map']], f['x'], f['y'], *cand)
+        if r is None: continue
+        if best is None or r[0] < best[0]: best = (r[0], cand, r[1], maps[f['map']][0])
+        if r[0] == 0: break
+    if best is None: row['status'] = 'not compared'; rows.append(row); continue
+    mixed = False
+    if best[0] and f['tag'] != 'v:settled':
+        candidates = [best] + compare_movement(frame, maps[f['map']], f['x'], f['y'])
+        best = min(candidates, key=lambda r: r[0])
+        mixed = best[0] != 0 and has_two_exact_bands(candidates)
+    last = best[1]
+    row['status'] = 'exact' if best[0] == 0 else ('mixed' if mixed else 'wrong')
+    row['offset'] = list(best[1]); row['referenceMap'] = best[3]; row['pixelsWrong'] = best[0]
+    if row['status'] == 'wrong':
+        ys, xs = np.nonzero(best[2]); row['box'] = [int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1]
+        wrong.append(row)
+        if len(wrong) <= 60:
+            shot = Image.open(os.path.join(out_dir, 'frames', f['file'])).convert('RGB')
+            mark = Image.fromarray((best[2] * 255).astype(np.uint8))
+            Image.composite(Image.new('RGB', shot.size, (255, 0, 255)), shot, mark).save(os.path.join(out_dir, 'wrong', f['file']))
+    rows.append(row)
+
+by_tag = {}
+for r in rows:
+    t = by_tag.setdefault(r['tag'], {'frames': 0, 'compared': 0, 'exact': 0, 'mixed': 0, 'wrong': 0, 'mostPixelsWrong': 0, 'peakTiles': 0, 'peakPalettes': 0})
+    t['frames'] += 1; t['peakTiles'] = max(t['peakTiles'], r['tiles']); t['peakPalettes'] = max(t['peakPalettes'], r['pals'])
+    if r['status'] != 'not compared':
+        t['compared'] += 1; t[r['status']] += 1; t['mostPixelsWrong'] = max(t['mostPixelsWrong'], r.get('pixelsWrong', 0))
+for tag, t in by_tag.items():
+    if tag == 'v:settled':
+        continue
+    seg = [r for r in rows if r['tag'] == tag]
+    t['lateFrames'] = seg[-1]['late'] - seg[0]['late']; t['vblanks'] = seg[-1]['v'] - seg[0]['v'] + 1; t['framesMissedByRecorder'] = t['vblanks'] - t['frames']
+    t['tileOverflows'] = seg[-1]['overflowTiles'] - seg[0]['overflowTiles'] if seg[-1]['overflowTiles'] >= seg[0]['overflowTiles'] else seg[-1]['overflowTiles']
+    t['paletteOverflows'] = seg[-1]['overflowPals'] - seg[0]['overflowPals'] if seg[-1]['overflowPals'] >= seg[0]['overflowPals'] else seg[-1]['overflowPals']
+total = {k: sum(t[k] for t in by_tag.values()) for k in ('frames', 'compared', 'exact', 'mixed', 'wrong')}
+json.dump({'total': total, 'segments': by_tag, 'wrongFrames': wrong[:400]}, open(os.path.join(out_dir, 'verify-stress.json'), 'w'), indent=1)
+print(total)
+for tag, t in by_tag.items(): print(tag.ljust(34), t)
+if 'v:settled' in by_tag and by_tag['v:settled']['wrong']:
+    raise SystemExit('A settled view differed from the generated map.')
