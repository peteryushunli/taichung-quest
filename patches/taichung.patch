+def main(install=False,capacity_only=False):
+ src=Frozen();layouts,scenes=load_scenes(src)
+ rows=[l for l in src.read('data/taichung/city-rework/plan-cells.txt').decode().splitlines() if len(l)==129]
+ assert len(rows)==181
+ changed={spec[1] for spec in SPECS};byname={s['name']:s for s in scenes.values()}
+ for spec in SPECS:stage(byname[spec[1]],rows,spec)
