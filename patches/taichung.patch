+
+static void Task_WaitPersistence(u8 task)
+{
+    if (gTasks[task].data[0] == 0)
+    {
+        // Publish one pending-save frame before entering synchronous flash
+        // programming. Browser runtimes can accelerate this locked save-only
+        // window; native saving and the durable ACK fence remain unchanged.
+        if (gTasks[task].data[2]++ == 0)
+            return;
+        // Match normal native Save preflight. Travel may have cleared the old
+        // camera cache, and Continue overlays the saved view at this location.
+        SaveMapView();
+        SaveQuestLogData();
+        if (TrySavingData(SAVE_NORMAL) != SAVE_STATUS_OK)
+            TaichungEncounterStorageFailed();
+        else
+            TaichungEncounterBridgeSaved();
+        gTasks[task].data[0] = 1;
+        return;
+    }
+    if (TaichungEncounterBridgeFailed())
+        TaichungEncounterStorageFailed();
+    if (TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_ERROR)
+    {
+        if (gTasks[task].data[1] && !FieldFadeTransitionBackgroundEffectIsFinished())
+            return;
+        DestroyTask(task);
+        ResumeEncounterResult();
+        return;
+    }
+    if (TaichungEncounterGetPhase() != TAICHUNG_ENCOUNTER_PHASE_DONE)
+    {
+        if (!TaichungEncounterBridgeAcked())
+            return;
+        if (!TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), TaichungEncounterGetUnlockMask()))
+            return;
+    }
+    if (TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_ARMED)
+    {
+        const struct TaichungEncounterSite *site = TaichungEncounterGetSite(TaichungEncounterGetCurrentSite());
+        u8 move;
+        DestroyTask(task);
+        ZeroEnemyPartyMons();
+        CreateMon(&gEnemyParty[0], site->species, site->level, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+        for (move = 0; move < 4; move++)
+            SetMonMoveSlot(&gEnemyParty[0], site->moves[move], move);
+        StartScriptedWildBattle();
+    }
+    else
+    {
+        if (gTasks[task].data[1] && !FieldFadeTransitionBackgroundEffectIsFinished())
+            return;
+        DestroyTask(task);
+        ResumeEncounterResult();
+    }
+}
+
+void TaichungEncounter_ScriptBegin(void)
+{
+    u8 slot;
+    bool8 healthy = FALSE;
+    gSpecialVar_Result = FALSE;
+    for (slot = 0; slot < CalculatePlayerPartyCount(); slot++)
+        if (!GetMonData(&gPlayerParty[slot], MON_DATA_IS_EGG) && GetMonData(&gPlayerParty[slot], MON_DATA_HP))
+            healthy = TRUE;
+    if (!healthy)
+        StringCopy(gStringVar4, TaichungText(sNoTeamEn, sNoTeamZh));
+    else if (gMain.inBattle || QL_IS_PLAYBACK_STATE || FuncIsActiveTask(Task_WaitPersistence)
+          || !TaichungEncounterBegin(gSpecialVar_0x8007))
+        StringCopy(gStringVar4, TaichungText(sUnavailableEn, sUnavailableZh));
+    else
+    {
+        gSpecialVar_Result = TRUE;
+    }
+}
+
+void TaichungEncounter_ScriptSaveBegin(void)
+{
+    if (TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN)
+        CreateTask(Task_WaitPersistence, 2);
+}
+
+void TaichungEncounterFinishFieldBattle(void)
+{
+    TaichungEncounterOnBattleEnd(GetMonData(&gEnemyParty[0], MON_DATA_SPECIES), gBattleOutcome);
+    if (gBattleOutcome == B_OUTCOME_LOST)
+        HealPlayerParty();
+}
+
+void TaichungEncounter_ScriptResult(void)
+{
+    const u8 *text;
+    gSpecialVar_0x8007 = TaichungEncounterGetCurrentSite();
+    BufferTarget();
+    switch (TaichungEncounterGetResult())
+    {
+    case TAICHUNG_ENCOUNTER_RESULT_CAUGHT: text = TaichungText(sCaughtEn, sCaughtZh); break;
+    case TAICHUNG_ENCOUNTER_RESULT_KO: text = TaichungText(sKoEn, sKoZh); break;
+    case TAICHUNG_ENCOUNTER_RESULT_RAN: text = TaichungText(sRanEn, sRanZh); break;
+    case TAICHUNG_ENCOUNTER_RESULT_LOST: text = TaichungText(sLostEn, sLostZh); break;
+    case TAICHUNG_ENCOUNTER_RESULT_EXHAUSTED: text = TaichungText(sExhaustedEn, sExhaustedZh); break;
+    case TAICHUNG_ENCOUNTER_RESULT_STORAGE_ERROR: text = TaichungText(sStorageEn, sStorageZh); break;
+    default: text = TaichungText(sInterruptedEn, sInterruptedZh); break;
+    }
+    StringExpandPlaceholders(gStringVar4, text);
+    gSpecialVar_Result = TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_DONE
+        && TaichungEncounterGetResult() == TAICHUNG_ENCOUNTER_RESULT_CAUGHT;
+}
+
+static const struct TaichungEncounterSite *CaughtSite(void)
+{
+    u8 site = TaichungEncounterGetCurrentSite();
+    if (site >= TAICHUNG_ENCOUNTER_COUNT || TaichungEncounterGetPhase() != TAICHUNG_ENCOUNTER_PHASE_DONE
+     || TaichungEncounterGetResult() != TAICHUNG_ENCOUNTER_RESULT_CAUGHT
+     || !(TaichungEncounterGetUnlockMask() & (1 << site)))
+        return NULL;
+    return TaichungEncounterGetSite(site);
+}
+
+void TaichungEncounter_ScriptAddCaught(void)
+{
+    const struct TaichungEncounterSite *site = CaughtSite();
+    u8 count = CalculatePlayerPartyCount();
+    u8 slot;
+
+    gSpecialVar_Result = FALSE;
+    if (site != NULL)
+    {
+        BufferTarget();
+        for (slot = 0; slot < count; slot++)
+        {
+            if (GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES) == site->species)
+            {
+                TaichungTeamEnsurePartyLevel();
+                StringExpandPlaceholders(gStringVar4, TaichungText(sAlreadyInPartyEn, sAlreadyInPartyZh));
+                return;
+            }
+        }
+        if (count == PARTY_SIZE)
+        {
+            StringCopy(gStringVar4, TaichungText(sPartyFullEn, sPartyFullZh));
+            gSpecialVar_Result = TRUE;
+            return;
+        }
+        if (TaichungTeamSetSlot(count, site->species))
+        {
+            StringExpandPlaceholders(gStringVar4, TaichungText(sJoinedEn, sJoinedZh));
+            return;
+        }
+    }
+    StringCopy(gStringVar4, TaichungText(sUseTeamEn, sUseTeamZh));
+}
