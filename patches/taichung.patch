@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Compile actual save migration C and test it against independently validated map truth."""
+from pathlib import Path
+import importlib.util
+import json
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).resolve().parents[2]
+OUT=ROOT/'build/taichung-tests/approved-art-v11'
+V9='2c48f28b998b67413baf058557752723ea121500'
+
+
+def main():
+    spec=importlib.util.spec_from_file_location('approved_art_save_truth',ROOT/'tools/taichung_gameplay/generate-approved-art-save.py')
+    gen=importlib.util.module_from_spec(spec);spec.loader.exec_module(gen)
+    _,maps=gen.validate(ROOT)
+    if (ROOT/gen.OUTPUT).read_text()!=gen.c_header(maps):
+        raise ValueError('Native save-v11 header is stale')
+    groups=json.loads((ROOT/'data/maps/map_groups.json').read_text())
+    ids={name:(g,n) for g,group in enumerate(groups['group_order']) for n,name in enumerate(groups[group])}
+    OUT.mkdir(parents=True,exist_ok=True)
+    gen.host_map_groups(ROOT,OUT)
+    lines=['// Independent manifest/map truth, never parsed from native C tables.']
+    for m in maps:
+        if not m['repairs']:continue
+        symbol='sTruth'+m['name']
+        lines+=['static const u8 '+symbol+'[][4] = {']
+        lines+=['    {%d, %d, %d, %d},'%tuple(row) for row in m['repairs']]
+        lines+=['};']
+    lines+=['static const struct V11TruthMap sV11TruthMaps[] = {']
+    for m in maps:
+        group,num=ids[m['name']]
+        pointer='sTruth'+m['name'] if m['repairs'] else 'NULL'
+        lines+=['    {%d, %d, %d, %d, %s, %d},'%(group,num,m['width'],m['height'],pointer,len(m['repairs']))]
+    lines+=['};']
+    # Derive real pre-v10 positions which pass through a v10 shift/repair and
+    # then hit a new landmark repair. Verify the source cell against released v9.
+    v10=json.loads((ROOT/'data/taichung/city-rework/save-v10.json').read_text())['maps']
+    historical={m['map']:m for m in v10};chains=[]
+    archive=subprocess.check_output(['git','-C',str(ROOT),'archive',V9,
+        'data','src/data','docs/taichung-city-contract.json'])
+    with tempfile.TemporaryDirectory(prefix='approved-art-save-v9-') as tmp:
+        old=Path(tmp);subprocess.run(['tar','-x','-C',str(old)],input=archive,check=True)
+        rules=gen.module(ROOT/'tools/taichung/validate_city.py')
+        old9,_=gen.validator(old,rules)
+        for m in maps:
+            if m['name'] not in historical or m['mapId'] not in old9.maps:continue
+            old_map=old9.maps[m['mapId']];v=historical[m['name']]
+            keyed={(r[0],r[1]) for r in v['repairs']}
+            group,num=ids[m['name']]
+            for x,y,tx,ty in m['repairs']:
+                candidates=[(sx,sy) for sx,sy,vx,vy in v['repairs'] if (vx,vy)==(x,y)]
+                src=(x-v['shift'][0],y-v['shift'][1])
+                if src not in keyed:candidates.append(src)
+                for sx,sy in candidates:
+                    if old_map.ground(sx,sy):
+                        first=1 if 'Nantun' in m['name'] else 8
+                        same=int((tx,ty)==(sx+v['shift'][0],sy+v['shift'][1]))
+                        chains.append((group,num,sx,sy,tx,ty,first,same));break
+    lines+=['#define V11_LEGACY_CHAIN_COUNT '+str(len(chains)),
+        'static const struct V11LegacyChain sV11LegacyChains[] = {']
+    lines+=['    {%d, %d, %d, %d, %d, %d, %d, %d},'%tuple(row) for row in chains] or ['    {0, 0, 0, 0, 0, 0, 0, 0},']
+    lines+=['};','']
+    (OUT/'approved-art-v11-truth.inc').write_text('\n'.join(lines))
+    binary=OUT/'save-v11'
+    command=['cc','-std=c99','-Wall','-Wextra','-Werror',
+        '-I'+str(ROOT/'tests/save_host'),'-I'+str(ROOT/'include'),'-I'+str(OUT),
+        str(ROOT/'src/taichung_save.c'),str(ROOT/'tests/taichung_save_v11_test.c'),'-o',str(binary)]
+    subprocess.run(command,check=True)
+    result=subprocess.run([str(binary)],capture_output=True,text=True)
+    if result.returncode:
+        sys.stderr.write(result.stdout+result.stderr)
+        raise subprocess.CalledProcessError(result.returncode,[str(binary)])
+    print(result.stdout.strip())
+    print('Independent real-map historical chains:',len(chains))
+    (OUT/'result.json').write_text(json.dumps({'passed':True,'maps':len(maps),'historicalChains':len(chains),
+        'stdout':result.stdout.strip(),'nativeEmulatorVerified':False},indent=2)+'\n')
+
+
+if __name__=='__main__':main()
