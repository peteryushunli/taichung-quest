+#!/usr/bin/env python3
+"""Emit explicit curated presets; no automatic move ranking or family templates."""
+import argparse
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--check', action='store_true')
+    args = parser.parse_args()
+    ids = {name: int(value) for name, value in re.findall(
+        r'^#define SPECIES_(\w+) (\d+)$',
+        (ROOT / 'include/constants/species.h').read_text(), re.M)}
+    rows, profiles = [], []
+    for line in (ROOT / 'data/taichung/team-presets/curated.tsv').read_text().splitlines():
+        name, moves, note = line.split('\t')
+        slots = moves.split()
+        assert len(slots) == 4 and note, f'Invalid authored profile: {name}'
+        profiles.append({'species': name, 'id': ids[name], 'moves': slots, 'design': note})
+        rows.append(f'    [SPECIES_{name} - 1] = {{' + ', '.join('MOVE_' + move for move in slots) + '},')
+    assert len(profiles) == 150 and {row['id'] for row in profiles} == set(range(1, 151))
+    header = ('// Curated Gen III ready-to-battle sets, including late natural learnset moves.\n'
+              '// Design: data/taichung/team-presets/curated.tsv; provenance is validated from native data.\n'
+              'static const u16 sTaichungTeamPresetMoves[SPECIES_MEWTWO][MAX_MON_MOVES] =\n{\n'
+              + '\n'.join(rows) + '\n};\n')
+    profiles_json = {
+        'schemaVersion': 1, 'battleLevel': 50,
+        'policy': 'Hand-curated FireRed natural level-up (any level), inherited pre-evolution, TM/HM and ordinary tutor moves; no grinding required. No egg/event/later-generation or IV/friendship-dependent moves.',
+        'species': profiles,
+    }
+    outputs = {
+        'src/data/taichung_team_presets.h': header,
+        'data/taichung/team-presets/profiles.json': json.dumps(profiles_json, indent=2) + '\n',
+    }
+    for name, content in outputs.items():
+        path = ROOT / name
+        if args.check:
+            assert path.read_text() == content, f'Generated presets differ: {name}'
+        else:
+            path.write_text(content)
+    print('PASS: 150 explicit species profiles ' + ('match' if args.check else 'generated'))
+
+
+if __name__ == '__main__':
+    main()
