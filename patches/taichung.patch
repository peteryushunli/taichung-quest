+def encode(source, output, review):
+    rgba = Image.open(source).convert("RGBA")
+    station = Image.open(STATION)
+    if station.mode != "P" or station.info.get("transparency") != 0 or station.getextrema()[1] > 15:
+        raise ValueError("Station palette source must remain indexed 4bpp with transparent index0")
+    palette = [tuple(station.getpalette()[i:i+3]) for i in range(0, 48, 3)]
+    mask = rgba.getchannel("A").point(lambda a: 255 if a >= 224 else 0)
+    crop_box = mask.getbbox()
