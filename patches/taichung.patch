+static void CB2_InitExplorationMenu(void)
+{
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    if (!InitWindows(sWindowTemplates))
+    {
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    DeactivateAllTextPrinters();
+    LoadPalette(sPalette, 0, sizeof(sPalette));
+    DrawExplorationMenu();
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_BG0_ON);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    CreateTask(Task_ExplorationMenuInput, 0);
+    SetVBlankCallback(VBlankCB_ExplorationMenu);
+    SetMainCallback2(CB2_ExplorationMenu);
+}
+
+static void CB2_ExplorationMenu(void)
+{
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void CB2_ReopenExplorationMenu(void)
+{
+    ShowTaichungExplorationMenu(sReturnCallback, FALSE);
+}
+
+static void Task_ExplorationMenuInput(u8 taskId)
+{
+    u8 rows = sStartup ? 3 : 4;
+    u8 setting;
+    u8 choice;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] != 0)
+    {
+        choice = gTasks[taskId].data[0];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeAllWindowBuffers();
+        if (choice == 2)
+        {
+            gMain.savedCallback = CB2_ReopenExplorationMenu;
+            SetMainCallback2(CB2_OptionsMenuFromStartMenu);
+        }
+        else
+            SetMainCallback2(sReturnCallback);
+        return;
+    }
+    if (JOY_NEW(B_BUTTON) || (JOY_NEW(A_BUTTON) && sCursor >= 2))
+    {
+        for (setting = 0; setting < TAICHUNG_EXPLORATION_SETTING_COUNT; setting++)
+            TaichungExplorationSetMode(setting, sModes[setting]);
+        gTasks[taskId].data[0] = JOY_NEW(A_BUTTON) && sCursor == 3 ? 2 : 1;
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+    }
+    else if (JOY_NEW(DPAD_UP))
+        sCursor = (sCursor + rows - 1) % rows;
+    else if (JOY_NEW(DPAD_DOWN))
+        sCursor = (sCursor + 1) % rows;
+    else if (sCursor < TAICHUNG_EXPLORATION_SETTING_COUNT)
+    {
+        if (JOY_NEW(DPAD_LEFT))
+            sModes[sCursor] = sModes[sCursor] == TAICHUNG_EXPLORATION_OFF ? TAICHUNG_EXPLORATION_NORMAL : sModes[sCursor] - 1;
+        else if (JOY_NEW(DPAD_RIGHT | A_BUTTON))
+            sModes[sCursor] = sModes[sCursor] == TAICHUNG_EXPLORATION_NORMAL ? TAICHUNG_EXPLORATION_OFF : sModes[sCursor] + 1;
+        else
+            return;
+    }
+    else
+        return;
+    PlaySE(SE_SELECT);
+    if (gTasks[taskId].data[0] == 0)
+        DrawExplorationMenu();
+}
