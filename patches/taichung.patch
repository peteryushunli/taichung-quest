+def stage(sc,rows,spec):
+ ident,name,oldorg,oldsize,origin,floor,script,newsign=spec
+ bank=sc['bank'];w=sc['layout']['width'];grid=sc['grid'];old=sc['old']
+ event=next(b for b in sc['data']['bg_events'] if b.get('script')=='TaichungCity_Sign_'+script)
+ signold=(event['x'],event['y']);signword=old[signold[1]*w+signold[0]]
+ if floor is None:
+  portal=next(b for b in sc['data']['warp_events'] if oldorg[0]<=b['x']<oldorg[0]+oldsize[0] and oldorg[1]<=b['y']<oldorg[1]+oldsize[1])
+  floor=old[(portal['y']+1)*w+portal['x']]&1023
+ image=Image.open(DATA/'art'/f'{ident}.png');mask=mask_for(ident,image)
+ portals={(b['x'],b['y']) for b in sc['data']['warp_events']}
+ floorword=0x3000|floor
+ # Erase only the old landmark rectangle; no surrounding blockout pass is run.
+ for y in range(oldorg[1],oldorg[1]+oldsize[1]):
+  for x in range(oldorg[0],oldorg[0]+oldsize[0]):
+   if (x,y) not in portals:grid[y*w+x]=floorword;sc['allowed'].add((x,y))
+ if ident=='fengle-sculpture-park':
+  # Use the city's own paving/grass behind the exact bridge/lake/sculpture art.
+  for y in range(origin[1]+5,origin[1]+9):
+   for x in range(origin[0],origin[0]+11):grid[y*w+x]=0x31C1
+ if newsign:
+  grid[signold[1]*w+signold[0]]=floorword;sc['allowed'].add(signold)
+  event['x'],event['y']=newsign
+ newpt=(event['x'],event['y'])
+ if not newsign and bank.attr(signword&1023)&0x1FF==0x84:
+  sc['signs'][newpt]=signword
+ else:
+  # Several old "sign" events examined an architectural tile. Never move that
+  # window/door fragment into a forecourt; use a real wooden signpost instead.
+  sc['signs'][newpt]=0x3403
+  sc['signInfo'][newpt]={'floor':grid[newpt[1]*w+newpt[0]]&1023}
+ sw,sh=image.width//16,image.height//16
+ for cy in range(sh):
+  for cx in range(sw):
+   x,y=origin[0]+cx,origin[1]+cy
+   assert 0<=x<w and 0<=y<sc['layout']['height'],ident
+   cell=image.crop((cx*16,cy*16,cx*16+16,cy*16+16))
+   if not any(cell.tobytes()) or (x,y) in portals:continue
+   worldx=x+sc['origin'][0];worldy=y+sc['origin'][1]
+   cls=rows[worldy][worldx]
+   assert cls not in 'SHW~b' and cls!='s',f'{ident}: artwork overlaps preserved street/water {x},{y} class{cls}'
+   block=mask.crop((cx*16,cy*16,cx*16+16,cy*16+16))
+   solid=sum(v!=0 for v in block.tobytes())>=8
+   cellfloor=0x1C1 if ident=='fengle-sculpture-park' and cy>=5 else floor
+   sc['overlays'][x,y]=dict(image=cell,palette=tuple(image.getpalette()[:48]),floor=cellfloor,solid=solid,id=ident)
+   grid[y*w+x]=floorword|(0x400 if solid else 0);sc['allowed'].add((x,y))
+ sc['art'].append(dict(id=ident,origin=origin,size=[sw,sh],oldOrigin=oldorg,oldSize=oldsize,
+      signOld=list(signold),sign=list(newpt),artSha256=digest((DATA/'art'/f'{ident}.png').read_bytes())))
