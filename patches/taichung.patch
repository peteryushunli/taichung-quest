+
+const u8 *TaichungGymGetBattleLossText(u16 trainerId, u8 outcome)
+{
+    const u8 *text;
+    u16 gymId = TaichungGymGetBattleLossGym(trainerId, outcome);
+    if (gymId >= TAICHUNG_GYM_COUNT)
