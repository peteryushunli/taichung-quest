+static void VBlankCB_TeamMenu(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+static void CB2_InitTeamMenu(void)
+{
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    ResetPaletteFade();
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    if (!InitWindows(sWindowTemplates))
+    {
+        FreeAllWindowBuffers();
+        SetMainCallback2(sReturnCallback);
+        return;
+    }
+    DeactivateAllTextPrinters();
+    LoadPalette(sPalette, 0, sizeof(sPalette));
+    DrawTeamMenu();
+    ShowBg(0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_BG0_ON);
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    CreateTask(Task_TeamMenuInput, 0);
+    SetVBlankCallback(VBlankCB_TeamMenu);
+    SetMainCallback2(CB2_TeamMenu);
+}
+
+static void CB2_TeamMenu(void)
+{
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void ChangeSpecies(s16 delta)
+{
+    sSpecies = (sSpecies - 1 + TEAM_ROSTER_COUNT + delta) % TEAM_ROSTER_COUNT + 1;
+}
+
+static void Task_TeamMenuInput(u8 taskId)
+{
+    u8 rows;
+    u8 choice;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] != 0)
+    {
+        choice = gTasks[taskId].data[0];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeAllWindowBuffers();
+        if (choice == 2)
+            InitPartyMenu(PARTY_MENU_TYPE_FIELD, PARTY_LAYOUT_SINGLE, PARTY_ACTION_CHOOSE_MON, FALSE, PARTY_MSG_CHOOSE_MON, Task_HandleChooseMonInput, CB2_ReopenTeamMenu);
+        else
+            SetMainCallback2(sReturnCallback);
+        return;
+    }
+    if (sScreen == TEAM_SCREEN_SLOTS)
+    {
+        rows = CalculatePlayerPartyCount();
+        if (rows < PARTY_SIZE)
+            rows++;
+        if (JOY_NEW(B_BUTTON | START_BUTTON))
+            gTasks[taskId].data[0] = 1;
+        else if (JOY_NEW(SELECT_BUTTON) && CalculatePlayerPartyCount() != 0)
+            gTasks[taskId].data[0] = 2;
+        else if (JOY_NEW(DPAD_UP))
+            sSlot = (sSlot + rows - 1) % rows;
+        else if (JOY_NEW(DPAD_DOWN))
+            sSlot = (sSlot + 1) % rows;
+        else if (JOY_NEW(A_BUTTON))
+        {
+            sSpecies = sSlot < CalculatePlayerPartyCount() ? GetMonData(&gPlayerParty[sSlot], MON_DATA_SPECIES) : 1;
+            if (!TaichungTeamSpeciesAllowed(sSpecies))
+                sSpecies = 1;
+            sScreen = TEAM_SCREEN_SPECIES;
+        }
+        else
+            return;
+    }
+    else if (sScreen == TEAM_SCREEN_SPECIES)
+    {
+        if (JOY_NEW(B_BUTTON))
+            sScreen = TEAM_SCREEN_SLOTS;
+        else if (JOY_NEW(DPAD_UP))
+            ChangeSpecies(-1);
+        else if (JOY_NEW(DPAD_DOWN))
+            ChangeSpecies(1);
+        else if (JOY_NEW(DPAD_LEFT))
+            ChangeSpecies(-SPECIES_PER_PAGE);
+        else if (JOY_NEW(DPAD_RIGHT))
+            ChangeSpecies(SPECIES_PER_PAGE);
+        else if (JOY_NEW(L_BUTTON))
+            ChangeSpecies(-40);
+        else if (JOY_NEW(R_BUTTON))
+            ChangeSpecies(40);
+        else if (JOY_NEW(A_BUTTON))
+            sScreen = TEAM_SCREEN_CONFIRM;
+        else
+            return;
+    }
+    else
+    {
+        if (JOY_NEW(B_BUTTON))
+            sScreen = TEAM_SCREEN_SPECIES;
+        else if (JOY_NEW(A_BUTTON))
+        {
+            TaichungTeamSetSlot(sSlot, sSpecies);
+            sScreen = TEAM_SCREEN_SLOTS;
+        }
+        else
+            return;
+    }
+    PlaySE(SE_SELECT);
+    if (gTasks[taskId].data[0] != 0)
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+    else
+        DrawTeamMenu();
+}
