+def function(source, name):
+    match = re.search(r"^(?:static )?(?:bool8|void|s16) " + re.escape(name) + r"\([^;]*?\)\n\{", source, re.M)
+    if not match:
+        raise SystemExit(f"Missing production function: {name}")
+    start = match.start()
+    cursor = source.index("{", match.start())
+    depth = 1
+    cursor += 1
+    while depth:
+        depth += (source[cursor] == "{") - (source[cursor] == "}")
+        cursor += 1
+    return source[start:cursor]
+
+
+def enum(source, member):
+    pos = source.index(member)
+    start = source.rfind("enum", 0, pos)
+    return source[start:source.index("};", pos) + 2]
