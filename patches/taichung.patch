+#!/usr/bin/env python3
+"""Check actual global-rules C, native New Game reset and menu timing binding."""
+import importlib.util,subprocess
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[2];OUT=ROOT/'build/taichung-tests/encounter-rules';OUT.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('extract',ROOT/'tools/taichung_gameplay/test-save-facing.py');extract=importlib.util.module_from_spec(spec);spec.loader.exec_module(extract)
+source=(ROOT/'src/taichung_save.c').read_text();definition=extract.definition(source,'TaichungSaveInitNewGame')[0]
+(OUT/'new-game-test.c').write_text('''#include "global.h"
+#include "taichung_save.h"
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+static struct SaveBlock1 saved; struct SaveBlock1 *gSaveBlock1Ptr=&saved;
+static struct { u8 direction; } sContinueFacing;
+static unsigned canceled,reset,init,checkpoint;
+static void TaichungGymCancelChallenge(void){canceled++;}
+static void TaichungEncounterResetSession(void){reset++;}
+static void InitCityEncounterSaveState(void){init++;}
+void TaichungSaveSetStationCheckpoint(void){checkpoint++;}
+static void VarSet(u16 id,u16 value){assert(id==TAICHUNG_SAVE_VERSION_VAR&&value==TAICHUNG_SAVE_VERSION);}
+'''+definition+'''
+int main(void){unsigned i;memset(&saved,0xA5,sizeof(saved));sContinueFacing.direction=4;
+TaichungSaveInitNewGame();assert(!sContinueFacing.direction&&canceled==1&&reset==1&&init==1&&checkpoint==1);
+for(i=0;i<sizeof(saved.flags);i++)assert(saved.flags[i]==(i==FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN/8?(0xA5&~(1<<(FLAG_TAICHUNG_ENCOUNTER_RULES_SEEN%8))):0xA5));
+puts("PASS: actual New Game function clears only the global rules bit, retaining native reset/checkpoint dispatch.");}
+''')
+subprocess.run(['cc','-std=c99','-Wall','-Wextra','-Werror','-I'+str(ROOT/'tests/save_host'),'-I'+str(ROOT/'include'),str(OUT/'new-game-test.c'),'-o',str(OUT/'new-game')],check=True)
+subprocess.run([str(OUT/'new-game')],check=True)
+menu=extract.definition((ROOT/'src/script_menu.c').read_text(),'DrawVerticalMultichoiceMenu')[0]
+assert menu.index('CreateMCMenuInputHandlerTask(ignoreBpress, count, windowId, mcId);')<menu.index('if (mcId == MULTICHOICE_TAICHUNG_ENCOUNTER)\n            TaichungEncounterOfferMenuShown();')<menu.index('ScheduleBgCopyTilemapToVram(0);')
+script=(ROOT/'data/scripts/taichung_encounters.inc').read_text();offer=script.split('TaichungEncounter_Offer::')[1].split('TaichungEncounter_HandleChoice::')[0]
+assert offer.index('waitmessage')<offer.index('multichoice')
+subprocess.run(['python3',str(ROOT/'tools/taichung_gameplay/test-encounter-return.py')],check=True)
+print('PASS: menu marks only after all rules advance to real choices; Later/Prepare/second-site/legacy attempt/saved-state/new-game cases pass in both languages without a reading save.')
