+  "schemaVersion": 1,
+  "landmarkId": "taichung-park",
+  "version": "study-v1",
+  "status": "User-approved source art frozen; one unmerged Station-palette native candidate prepared",
+  "toolMode": "built-in image_gen",
+  "intent": "generate from official architecture and approved rendering-style references",
+  "calls": 1,
+  "generatedDateUTC": "2026-11-07",
