+        'data','src/data','docs/taichung-city-contract.json'])
+    results=[]
+    with tempfile.TemporaryDirectory(prefix='approved-art-save-v10-') as tmp:
+        before=Path(tmp)
+        # Input is a local fixed-commit git archive. System tar also works with
+        # the project's macOS Python3.9, before tarfile's filter API was added.
+        subprocess.run(['tar','-x','-C',str(before)],input=archive,check=True)
+        old,old_reached=validator(before,rules)
+        if current.district_ids!=old.district_ids:
+            raise ValueError('This art migration must not add or remove districts')
+        if (root/'data/maps/map_groups.json').read_bytes()!=(before/'data/maps/map_groups.json').read_bytes():
+            raise ValueError('Existing map IDs changed')
+        for entry in sorted(entries,key=lambda x:x['mapId']):
+            mid=entry['mapId'];a,b=old.maps[mid],current.maps[mid]
+            if (a.width,a.height)!=(b.width,b.height) or (b.width,b.height)!=(entry['width'],entry['height']):
+                raise ValueError(f'{mid}: geography/dimensions changed')
+            if max(b.width,b.height)>255:
+                raise ValueError(f'{mid}: saved relocation coordinates exceed u8')
+            old_sha=digest((before/a.layout['blockdata_filepath']).read_bytes())
+            new_sha=digest((root/b.layout['blockdata_filepath']).read_bytes())
+            if entry.get('oldMapSha256')!=old_sha or entry.get('newMapSha256')!=new_sha:
+                raise ValueError(f'{mid}: map hash binding differs from the actual maps')
+            binding=integration['maps'][MAPS[mid]]
+            if (binding['mapId'],binding['oldMapSha256'],binding['newMapSha256'])!=(mid,old_sha,new_sha):
+                raise ValueError(f'{mid}: map hashes do not match the integration report')
+            if a.data.get('connections')!=b.data.get('connections'):
+                raise ValueError(f'{mid}: connections changed')
+            if a.data.get('warp_events')!=b.data.get('warp_events'):
+                raise ValueError(f'{mid}: native doors/returns changed')
+            native_warps={(w['x'],w['y']) for w in b.data.get('warp_events',[])}
+            safe={(x,y) for map_id,x,y in current_reached if map_id==mid
+                  and (x,y) not in native_warps and b.behavior(x,y)!=0x02}
+            if not safe:raise ValueError(f'{mid}: no reachable safe repair target')
+            expected=set();blocked=set();cutoff=set()
+            for y in range(a.height):
+                for x in range(a.width):
+                    if not a.ground(x,y):continue
+                    if not b.ground(x,y):
+                        expected.add((x,y));blocked.add((x,y))
+                    elif (mid,x,y) in old_reached and (mid,x,y) not in current_reached:
+                        expected.add((x,y));cutoff.add((x,y))
