+                plannedDimensions=[welcome['layout']['width'], welcome['layout']['height']], **anchor))
+    # Connections retain actual native offset semantics (destination local
+    # transverse coordinate = source local coordinate - connection.offset).
+    seams = []
+    for district in city['districts']:
+        src = exterior_by_id[district['map']]
+        for connection in registered[src['mapId']]['data']['connections']:
+            dst = exterior_by_id[connection['map']]; direction = connection['direction']; offset = connection['offset']
+            require(direction in ('left', 'right', 'up', 'down'), 'Unsupported baseline seam direction')
+            horizontal = direction in ('left', 'right'); extent = src['height'] if horizontal else src['width']; target_extent = dst['height'] if horizontal else dst['width']
+            samples = []
+            for transverse in range(extent):
+                target = transverse - offset
+                if not 0 <= target < target_extent: continue
+                a = [0 if direction == 'left' else src['width'] - 1, transverse] if horizontal else [transverse, 0 if direction == 'up' else src['height'] - 1]
+                b = [dst['width'] - 1 if direction == 'left' else 0, target] if horizontal else [target, dst['height'] - 1 if direction == 'up' else 0]
+                aw = [src['worldOrigin'][i] + a[i] for i in (0, 1)]; bw = [dst['worldOrigin'][i] + b[i] for i in (0, 1)]
+                expected_delta = {'left': [-1, 0], 'right': [1, 0], 'up': [0, -1], 'down': [0, 1]}[direction]
+                require([bw[i] - aw[i] for i in (0, 1)] == expected_delta, 'Native seam offset is misaligned in world space')
+                samples.append(dict(fromLocal=a, toLocal=b, fromWorld=aw, toWorld=bw))
+            require(samples, 'Native connection has no overlap')
+            reciprocal = [c for c in registered[dst['mapId']]['data']['connections'] if c['map'] == src['mapId']]
+            require(len(reciprocal) == 1 and reciprocal[0]['offset'] == -offset, 'Seam lacks reciprocal native offset')
+            seams.append(dict(fromNativeKey=src['nativeKey'], toNativeKey=dst['nativeKey'], direction=direction, nativeOffset=offset,
+                coordinateRule='target transverse local = source transverse local - nativeOffset',
+                overlappingEdgeTiles=len(samples), first=samples[0], last=samples[-1]))
+    fieldmap_path = source / 'include/fieldmap.h'; fieldmap_raw = fieldmap_path.read_bytes()
+    loaded_hashes[fieldmap_path] = hashlib.sha256(fieldmap_raw).hexdigest(); used_paths.append(fieldmap_path)
+    contract = dict(schemaVersion=1, contractId='taichung-current-native-minimap',
+        status='source-registered baseline geometry; Main must bind to the exact built ROM',
+        coordinateSystem=dict(units='metatiles', metatilePixels=16, origin='zero-based unbuffered map-local tile', x='right', y='down', northUp=True,
+            nativeLocalSource='gSaveBlock1Ptr->pos; object-event virtual coordinates require subtracting MAP_OFFSET before use',
+            virtualMapOffset=int(re.search(r'^#define MAP_OFFSET\s+(\d+)', fieldmap_raw.decode(), re.M).group(1)),
+            rectConvention='[minX,minY,maxXExclusive,maxYExclusive]', markerAnchor='exterior entrance tile; display at tile center'),
+        world=dict(width=max_x, height=max_y, bounds=[0, 0, max_x, max_y], coordinateSpace='compressed playable baseline, not geographic GPS'),
+        policy=dict(unknownNativeKey='hide', outOfBoundsLocal='hide; do not clamp', uncoveredWorldCanvas='no location',
+            indoor='parent exterior entrance anchor; never project indoor room tiles',
+            requireFreshNativeContext=True, requireCompatibleBuiltRom=True,
+            suspendedContexts=['title', 'startup', 'menu', 'dialogue', 'battle', 'loading', 'transition'],
+            buildBindingOwner='Main; source fingerprint alone is not proof of loaded-ROM compatibility'),
+        gymIdNamespace='stable landmark string ID; numeric progression/save bits are owned by Gameplay, not inferred here',
+        mapsByNativeKey=maps, nativeKeysByMapId={entry['mapId']: key for key, entry in maps.items()},
+        markersById=markers, seams=seams, plannedMaps=planned)
+    geometry = {key: contract[key] for key in ('schemaVersion', 'coordinateSystem', 'world', 'mapsByNativeKey', 'markersById', 'seams')}
+    contract['geometryFingerprintSha256'] = hashlib.sha256(canonical(geometry)).hexdigest()
+    for path in dict.fromkeys(used_paths):
+        require(hashlib.sha256(path.read_bytes()).hexdigest() == loaded_hashes[path], f'Source changed during export; rerun after registration settles: {path}')
+    contract['sourceSha256'] = {str(p.relative_to(source)): loaded_hashes[p] for p in dict.fromkeys(used_paths)}
+    contract['validation'] = validate_contract(contract)
+    return contract
+
+
+def validate_contract(contract):
+    require(contract['schemaVersion'] == 1, 'Unsupported minimap contract schema')
+    maps = contract['mapsByNativeKey']; reverse = contract['nativeKeysByMapId']; require(len(maps) == len(reverse), 'Native ID lookup is not bijective')
+    for key, entry in maps.items():
