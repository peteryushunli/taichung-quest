+    ResetField(); sScript = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_SCRIPT, TRUE);
+    ResetField(); sMessage = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE, TRUE);
+    ResetField(); sPrinter = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE, TRUE);
+    ResetField(); sLink = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_LINK, TRUE);
+    ResetField(); gReceivedRemoteLinkPlayers = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_LINK, TRUE);
+    ResetField(); sReplay = TRUE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_REPLAY, TRUE);
+    ResetField(); sPlayback = QL_PLAYBACK_STATE_RUNNING; Hidden(TAICHUNG_NAVIGATION_CONTEXT_REPLAY, TRUE);
+    ResetField(); gSaveBlock1Ptr = NULL; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE, TRUE);
+    ResetField(); gPlayerAvatar.objectEventId = OBJECT_EVENTS_COUNT; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR, TRUE);
+    ResetField(); gObjectEvents[0].active = FALSE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR, TRUE);
+    ResetField(); gObjectEvents[0].isPlayer = FALSE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR, TRUE);
+    ResetField(); gPlayerAvatar.flags = 0; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR, TRUE);
+    ResetField(); gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_CONTROLLABLE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR, TRUE);
+    ResetField(); gMapHeader.mapLayout = NULL; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP, TRUE);
+    ResetField(); sLayout.width = 0; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP, TRUE);
+    ResetField(); sSave.location.mapGroup = -1; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP, TRUE);
+    ResetField(); gMapHeader.mapType = MAP_TYPE_NONE; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP, TRUE);
+    ResetField(); gObjectEvents[0].currentCoords.x = 6; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION, TRUE);
+    ResetField(); gObjectEvents[0].currentCoords.y = 79; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION, TRUE);
+    ResetField(); gObjectEvents[0].facingDirection = 0; Hidden(TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION, TRUE);
+    ResetField(); gTaichungNavigationBridge.sequence = 0xFFFFFFFEu; gTaichungNavigationBridge.frameCounter = 0xFFFFFFFFu;
+    TaichungNavigationBridge_Tick(TRUE);
+    assert(gTaichungNavigationBridge.sequence == 2 && gTaichungNavigationBridge.frameCounter == 1);
+    gTaichungNavigationBridge.magicA = 0; gTaichungNavigationBridge.reserved16 = 99; gTaichungNavigationBridge.reserved32 = 999;
+    TaichungNavigationBridge_Tick(TRUE);
+    assert(gTaichungNavigationBridge.sequence == 2 && gTaichungNavigationBridge.frameCounter == 1);
+    assert(gTaichungNavigationBridge.reserved16 == 0 && gTaichungNavigationBridge.reserved32 == 0);
+    assert(memcmp(&sSave, &before, sizeof before) == 0);
+    puts("PASS: real navigation publisher layout, coordinates, ordinary movement and stop with CONTROLLABLE clear, indoor/outdoor, cycling/readiness, hidden contexts, null/invalid state, stationary freshness, reserved fields and nonzero wrap.");
+    return 0;
+}
+"""
+
+with tempfile.TemporaryDirectory(prefix="taichung-navigation-") as directory:
+    temporary = Path(directory)
+    (temporary / "global.h").write_text(GLOBAL)
+    for name in ("bike", "field_message_box", "field_player_avatar", "fieldmap", "link", "main", "overworld", "palette", "quest_log", "script", "text"):
+        (temporary / f"{name}.h").write_text('#include "global.h"\n')
+    (temporary / "test.c").write_text(TEST)
+    subprocess.run([
+        shutil.which("cc") or "cc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-Wno-pointer-to-int-cast",
+        "-I" + str(temporary), "-I" + str(ROOT / "include"),
+        str(ROOT / "src/taichung_navigation_bridge.c"), str(temporary / "test.c"),
+        "-o", str(temporary / "test"),
+    ], check=True)
+    subprocess.run([str(temporary / "test")], check=True)
