diff --git a/data/taichung/landmarks/fine-arts/encode_candidate.py b/data/taichung/landmarks/fine-arts/encode_candidate.py
new file mode 100644
index 0000000..1197f4a
--- /dev/null
+++ b/data/taichung/landmarks/fine-arts/encode_candidate.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Format-convert the approved museum/ground sculpture; no creative redraw/install."""
+import argparse
+from collections import deque
+import hashlib
+import json
+import math
+from pathlib import Path
+import shutil
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ART = PROJECT / 'artifacts/worktrees/c291d4842985/landmark-art'
+SOURCE = ART / 'fine-arts-study-v1.png'
+SCIENCE_PALETTE = GAME / 'data/taichung/landmarks/science-museum/candidate/07.pal'
+SOURCE_PORTAL = (822, 648, 944, 743)
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, h=False, v=False):
+    return tuple(pixels[(7-y if v else y)*8 + (7-x if h else x)] for y in range(8) for x in range(8))
+
+
+def components(rgba, threshold=128):
+    width, height = rgba.size
+    remaining = bytearray(rgba.getchannel('A').point(lambda a:255 if a >= threshold else 0).tobytes())
+    groups = []
+    for i in range(len(remaining)):
+        if not remaining[i]: continue
+        remaining[i] = 0; queue = deque([i]); group = []
+        while queue:
+            at = queue.popleft(); group.append(at); x, y = at % width, at // width
+            for n, allowed in ((at-1,x>0),(at+1,x+1<width),(at-width,y>0),(at+width,y+1<height)):
+                if allowed and remaining[n]: remaining[n] = 0; queue.append(n)
+        groups.append(group)
+    groups.sort(key=len, reverse=True)
+    if len(groups) != 2: raise ValueError(f'Expected exactly2 measured alpha components, got{len(groups)}')
+    result = []
+    for group in groups:
+        bbox = (min(i%width for i in group), min(i//width for i in group), max(i%width for i in group)+1, max(i//width for i in group)+1)
