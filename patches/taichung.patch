+#!/usr/bin/env python3
+"""Execute the native options input path and check its added text geometry."""
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/gym-healing-menu"
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("extract", ROOT / "tools/taichung_gameplay/test-save-facing.py")
+extract = importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+source = (ROOT / "src/taichung_exploration_menu.c").read_text()
+state = source[source.index("static EWRAM_DATA"):source.index("static void CB2_InitExplorationMenu(void);")]
+rows = re.search(r"enum\s*\{.*?\};\n#define ROW_FIRST_SETTING ROW_WILD", source, re.S)[0]
+prefix = r'''
+#include "global.h"
+#define GUARD_GLOBAL_H
+#include "taichung_exploration.h"
+#include "taichung_language.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+typedef void (*MainCallback)(void);
+struct { MainCallback savedCallback; } gMain;
+struct { u16 data[16]; } gTasks[1];
+struct { bool8 active; } gPaletteFade;
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static u16 sKeys;
+static MainCallback sCallback;
+static unsigned sDraws;
+enum { A_BUTTON=1, B_BUTTON=2, DPAD_UP=4, DPAD_DOWN=8, DPAD_LEFT=16, DPAD_RIGHT=32 };
+#define JOY_NEW(key) (sKeys & (key))
+#define VARS_START 0x4000
+#define PALETTES_ALL 0
+#define RGB_BLACK 0
+#define SE_SELECT 0
+bool8 VarSet(u16 id, u16 value) { sSave.vars[id-VARS_START] = value; return TRUE; }
+u16 VarGet(u16 id) { (void)id; assert(0); return 0; }
+bool8 TaichungIsChinese(void) { return sSave.vars[TAICHUNG_LANGUAGE_VAR-VARS_START] == TAICHUNG_LANGUAGE_ZH; }
+static void CB2_InitExplorationMenu(void) {}
+static void CB2_ReopenExplorationMenu(void) {}
+static void CB2_OptionsMenuFromStartMenu(void) {}
+static void ReturnToGame(void) {}
+static void SetMainCallback2(MainCallback callback) { sCallback = callback; }
+static void DrawExplorationMenu(void) { sDraws++; }
+static void DestroyTask(u8 task) { (void)task; }
+static void SetVBlankCallback(MainCallback callback) { (void)callback; }
+static void FreeAllWindowBuffers(void) {}
+static void PlaySE(u16 song) { (void)song; }
+static void BeginNormalPaletteFade(u32 mask, u8 delay, u8 from, u8 to, u16 color) { (void)mask; (void)delay; (void)from; (void)to; (void)color; }
+'''
+main = r'''
+static void Key(u16 keys) { sKeys = keys; Task_ExplorationMenuInput(0); }
+int main(void) {
+    unsigned raw, startup, i;
+    const u16 values[] = {0,1,2,65535};
+    for (raw=0; raw<4; raw++) for (startup=0; startup<2; startup++) {
+        memset(&sSave,0,sizeof(sSave)); memset(gTasks,0,sizeof(gTasks));
+        sSave.vars[TAICHUNG_GYM_HEAL_VAR-VARS_START] = values[raw];
+        ShowTaichungExplorationMenu(ReturnToGame, startup);
+        assert(sCursor == ROW_CONTINUE && sGymHealing == (values[raw]!=2));
+        assert(sSave.vars[TAICHUNG_GYM_HEAL_VAR-VARS_START] == values[raw]);
+        Key(DPAD_UP); assert(sCursor == ROW_HEAL);
+        Key(DPAD_RIGHT); assert(sGymHealing == (values[raw]==2));
+        Key(DPAD_LEFT); Key(A_BUTTON); assert(sGymHealing == (values[raw]==2));
+        assert(sSave.vars[TAICHUNG_GYM_HEAL_VAR-VARS_START] == values[raw]);
+        Key(DPAD_DOWN); Key(A_BUTTON);
+        assert(sSave.vars[TAICHUNG_GYM_HEAL_VAR-VARS_START] == (values[raw]==2 ? 1 : 2));
+        Key(0); assert(sCallback == ReturnToGame);
+        memset(gTasks,0,sizeof(gTasks)); ShowTaichungExplorationMenu(ReturnToGame,startup);
+        assert(sGymHealing == (values[raw]==2));
+        // Language, both independent encounter rows and the extra native menu
+        // remain reachable without indexing a nonexistent third mode.
+        for(i=0;i<20;i++) { Key(DPAD_UP); Key(DPAD_RIGHT); }
+        Key(B_BUTTON); Key(0); assert(sCallback == ReturnToGame);
+    }
+    puts("PASS: native pregame/OPTION input, default On for unset/invalid old saves, saved Off, A/left/right/B persistence and row navigation");
+    return 0;
+}
+'''
+bodies = "\n".join(extract.definition(source, name)[0] for name in ("CurrentLanguage", "ShowTaichungExplorationMenu", "Task_ExplorationMenuInput"))
+(OUT / "menu.c").write_text(prefix + state + rows + "\n" + bodies + main)
+subprocess.run(["cc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-I"+str(ROOT/"tests/host"), "-I"+str(ROOT/"include"), str(ROOT/"src/taichung_exploration.c"), str(OUT/"menu.c"), "-o", str(OUT/"menu")], check=True)
+subprocess.run([str(OUT/"menu")], check=True)
+charmap = (ROOT / "charmap.txt").read_text()
+for name in ("sHealZh", "sOnZh", "sHealHelpZh"):
+    literal = json.loads(re.search(r"static const u8 " + name + r"\[\] = _\((.*?)\);", source)[1])
+    for char in set(literal)-{"\n"}:
+        assert re.search(r"^'" + re.escape(char) + r"'\s*=", charmap, re.M), char
+ys = [int(x) for x in re.search(r"sRowY\[\] = \{(.*?)\}", source)[1].split(",")]
+assert all(b-a >= 13 for a,b in zip(ys,ys[1:])) and ys[-1]+13 <= 118
+assert 118+26 <= 147 and 147+13 <= 160
+print("PASS: new Chinese glyphs mapped; six 13px native text rows and two-line help fit the 240x160 screen")
