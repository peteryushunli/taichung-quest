@@ -0,0 +1,314 @@
+#!/usr/bin/env python3
+"""Carry neighbour art that Nantun's connection strips borrow, so both banks draw it alike.
+
+fieldmap.c copies a strip of every connected map (7 rows or columns, 8 columns
+for an east neighbour) into the viewer's map buffer and draws it with the
+viewer's tilesets. Where a neighbour's metatile would draw differently under a
+Nantun bank, that bank carries a copy at the same ID: entries verbatim where the
+palette entries it needs already match or are free, otherwise its tiles
+re-encoded into free palette entries. Free means unused by any metatile the bank
+must keep: every metatile of the shared bank (so kit prefabs stay placeable), or
+only what the map draws for a derived single-map bank.
+
+carry_shared() works on the shared bank before the maps are painted and moves
+temple metatiles out of carried IDs. derive_bank() copies the finished shared
+bank for one map and overwrites IDs that map never draws. strip_mismatches() is
+the same comparison check_old_core's connectionPreviewStrips gate makes.
+"""
+import copy
+import json
+from pathlib import Path
+import re
+import struct
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+SECONDARY_PALETTES = range(7, 13)
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7 - y if flags & 0x800 else y) * 8 + (7 - x if flags & 0x400 else x)] for y in range(8) for x in range(8))
+
+
+def read_palette(path):
+    return [tuple(map(int, line.split())) for line in path.read_text().splitlines()[3:] if line.strip()]
+
+
+def folder_of(label):
+    """A tileset's source folder, resolved from its metatiles INCBIN as the guards do."""
+    headers = (ROOT / 'src/data/tilesets/headers.h').read_text()
+    header = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", headers, re.S).group(1)
+    symbol = re.search(r"\.metatiles\s*=\s*(\w+)", header).group(1)
+    declaration = re.search(rf"\b{symbol}\s*\[.*?INCBIN_\w+\(\"([^\"]+)\"\)", (ROOT / 'src/data/tilesets/metatiles.h').read_text(), re.S)
+    return ROOT / Path(declaration.group(1)).parent
+
+
+class Bank:
+    """Metatiles, attributes, indexed graphics and palettes of one tileset half."""
+    def __init__(self, metatiles, attributes, graphics, palettes):
+        self.metatiles, self.attributes, self.graphics, self.palettes = metatiles, attributes, graphics, palettes
+
+    @classmethod
+    def load(cls, label, palette_range):
+        folder = folder_of(label)
+        raw = (folder / 'metatiles.bin').read_bytes()
+        words = struct.unpack(f'<{len(raw) // 2}H', raw)
+        attrs = (folder / 'metatile_attributes.bin').read_bytes()
+        image = Image.open(folder / 'tiles.png')
+        px, across = image.load(), image.width // 8
+        graphics = [tuple(px[i % across * 8 + x, i // across * 8 + y] for y in range(8) for x in range(8))
+                    for i in range(across * (image.height // 8))]
+        return cls([list(words[i:i + 8]) for i in range(0, len(words), 8)], list(struct.unpack(f'<{len(attrs) // 4}I', attrs)),
+                   graphics, {n: read_palette(folder / f'palettes/{n:02}.pal') for n in palette_range})
+
+    @classmethod
+    def of_compiled(cls, compiled):
+        return cls(compiled['metatiles'], compiled['attributes'], compiled['graphics'],
+                   {n: compiled['palettes'][n] for n in SECONDARY_PALETTES})
+
+
+def render(primary, secondary, n):
+    """(pixel colours, attribute) of metatile n as check_old_core's Bank draws it, or None if undefined."""
+    bank, i = (primary, n) if n < 640 else (secondary, n - 640)
+    if i >= len(bank.metatiles):
+        return None
+    out = [None] * 256
+    for layer in (0, 1):
+        for q in range(4):
+            entry = bank.metatiles[i][layer * 4 + q]
+            g, p = entry & 0x3FF, entry >> 12
+            source, gi = (primary, g) if g < 640 else (secondary, g - 640)
+            if gi >= len(source.graphics) or p > 12:
+                return None
+            tile, palette = flip(source.graphics[gi], entry & 0xC00), (primary if p < 7 else secondary).palettes[p]
+            for y in range(8):
+                for x in range(8):
+                    v = tile[y * 8 + x]
+                    if layer == 0 or v:
+                        out[(q // 2 * 8 + y) * 16 + q % 2 * 8 + x] = palette[v]
+    return tuple(out), bank.attributes[i]
+
+
+def map_index():
+    """{MAP_ID: map folder name} for every Taichung map."""
+    return {json.loads(p.read_text())['id']: p.parent.name for p in (ROOT / 'data/maps').glob('Taichung*/map.json')}
+
+
+def layout(name):
+    layouts = {l['id']: l for l in json.loads((ROOT / 'data/layouts/layouts.json').read_text())['layouts'] if 'id' in l}
+    return layouts[json.loads((ROOT / f'data/maps/{name}/map.json').read_text())['layout']]
+
+
+def file_words(lay):
+    raw = (ROOT / lay['blockdata_filepath']).read_bytes()
+    return list(struct.unpack(f'<{len(raw) // 2}H', raw))
+
+
+def strip(view_w, view_h, target_w, target_h, direction, offset):
+    """Target cells fieldmap.c copies into the viewer's buffer for one connection."""
+    for y in range(target_h):
+        for x in range(target_w):
+            if ((direction == 'left' and x >= target_w - 7 and -7 <= y + offset < view_h + 7) or
+                    (direction == 'right' and x < 8 and -7 <= y + offset < view_h + 7) or
+                    (direction == 'up' and y >= target_h - 7 and -7 <= x + offset < view_w + 8) or
+                    (direction == 'down' and y < 7 and -7 <= x + offset < view_w + 8)):
+                yield x, y
+
+
+def palette_use(primary, secondary, ids):
+    """{palette: indices} the given metatiles need from palettes 7-12 (index 0 only where a bottom layer shows it)."""
+    used = {p: set() for p in SECONDARY_PALETTES}
+    for n in ids:
+        bank, i = (primary, n) if n < 640 else (secondary, n - 640)
+        if i >= len(bank.metatiles):
+            continue
+        for k, entry in enumerate(bank.metatiles[i]):
+            g, p = entry & 0x3FF, entry >> 12
+            if p not in used:
+                continue
+            source, gi = (primary, g) if g < 640 else (secondary, g - 640)
+            if gi < len(source.graphics):
+                used[p] |= {v for v in source.graphics[gi] if v or k < 4}
+    return used
+
+
+class Carrier:
+    """Writes neighbour metatiles into a bank at their own IDs, keeping protected palette entries."""
+    def __init__(self, bank, primary, used):
+        self.bank, self.primary, self.used = bank, primary, used
+        self.lookup = {}
+        for i, g in enumerate(bank.graphics):
+            self.lookup.setdefault(min(flip(g, f) for f in (0, 0x400, 0x800, 0xC00)), i)
+        self.report = dict(verbatimPalettes=set(), reencodedTiles=0, graphicsAdded=0)
+
+    def pack(self, pixels):
+        canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+        if canonical not in self.lookup:
+            self.lookup[canonical] = len(self.bank.graphics)
+            self.bank.graphics.append(canonical)
+            self.report['graphicsAdded'] += 1
+        return 640 + self.lookup[canonical], flags
+
+    def fits(self, palette, colours):
+        """Index map placing {source index: colour} in one bank palette, or None."""
+        mapping, taken, target = {}, set(), self.bank.palettes[palette]
+        for v, colour in sorted(colours.items()):
+            if v == 0:
+                if target[0] != colour:
+                    return None      # a shown index 0 must stay index 0
+                mapping[0] = 0
+                continue
+            same = [j for j in range(1, 16) if target[j] == colour and (j in self.used[palette] or j in taken)]
+            free = [j for j in range(1, 16) if j not in self.used[palette] and j not in taken]
+            if same:
+                mapping[v] = same[0]
+            elif free:
+                mapping[v] = free[0]
+                taken.add(free[0])
+            else:
+                return None
+        return mapping
+
+    def entry(self, source_primary, source, word, layer):
+        g, p, flags = word & 0x3FF, word >> 12, word & 0xC00
+        holder, gi = (source_primary, g) if g < 640 else (source, g - 640)
+        pixels = holder.graphics[gi]
+        if p < 7:
+            assert g < 640, 'secondary graphics drawn with a primary palette are not carried'
+            return word
+        palette = source.palettes[p]
+        colours = {v: palette[v] for v in set(pixels) if v or layer == 0}
+        verbatim = all(self.bank.palettes[p][v] == c or (v and v not in self.used[p]) for v, c in colours.items())
+        if verbatim:
+            for v, c in colours.items():
+                self.bank.palettes[p][v] = c
+                self.used[p].add(v)
+            self.report['verbatimPalettes'].add(p)
+            if g < 640:
+                return word
+            new, packed = self.pack(pixels)
+            return new | (flags ^ packed) | (p << 12)
+        for q in sorted(SECONDARY_PALETTES, key=lambda q: sum(v not in self.used[q] for v in range(1, 16)) * -1):
+            mapping = self.fits(q, colours)
+            if mapping is None:
+                continue
+            for v, j in mapping.items():
+                self.bank.palettes[q][j] = palette[v]
+                self.used[q].add(j)
+            new, packed = self.pack(tuple(mapping[v] if v in mapping else 0 for v in pixels))
+            self.report['reencodedTiles'] += 1
+            return new | (flags ^ packed) | (q << 12)
+        raise AssertionError(f'no palette has room for {len(colours)} colours of a carried tile')
+
+    def carry(self, n, source_primary, source):
+        entries = [self.entry(source_primary, source, w, k // 4) for k, w in enumerate(source.metatiles[n - 640])]
+        i = n - 640
+        while len(self.bank.metatiles) <= i:
+            self.bank.metatiles.append([0] * 8)
+            self.bank.attributes.append(0)
+        self.bank.metatiles[i], self.bank.attributes[i] = entries, source.attributes[i]
+
+
+def neighbours(spec, banks):
+    """(connection, target name, target layout, primary Bank, secondary Bank) for each connection not drawn with a Nantun bank."""
+    index = map_index()
+    for c in spec['connections']:
+        name = index[c['map']]
+        lay = layout(name)
+        if lay['secondary_tileset'] in banks:
+            continue
+        yield c, name, lay, Bank.load(lay['primary_tileset'], range(7)), Bank.load(lay['secondary_tileset'], SECONDARY_PALETTES)
+
+
+def borrowed(spec, primary, bank, banks):
+    """{metatile: (source primary, source bank)} the map's foreign strips would draw wrongly with this bank."""
+    out = {}
+    for c, name, lay, source_primary, source in neighbours(spec, banks):
+        words = file_words(lay)
+        for x, y in strip(spec['width'], spec['height'], lay['width'], lay['height'], c['direction'], c['offset']):
+            n = words[y * lay['width'] + x] & 0x3FF
+            if n >= 640 and render(primary, bank, n) != render(source_primary, source, n):
+                assert lay['primary_tileset'] == spec['tilesets']['primary'], f"{name} ({x},{y}): carrying across different primaries is not supported"
+                out.setdefault(n, (source_primary, source))
+    return out
+
+
+def carry_shared(compiled, specs, banks):
+    """Carry what the shared bank's maps borrow; move temple metatiles off carried IDs. Returns a report."""
+    primary = Bank.load(specs[0]['tilesets']['primary'], range(7))
+    bank = Bank.of_compiled(compiled)
+    wanted = {}
+    for spec in specs:
+        wanted.update(borrowed(spec, primary, bank, banks))
+    temples = {n for rows in compiled['temples'].values() for row in rows for n in row if n is not None}
+    moved = {}
+    for n in sorted(wanted):
+        i = n - 640
+        if i < len(bank.metatiles) and any(bank.metatiles[i]):
+            assert n in temples, f'{n:#x} holds kit art; carrying it would need a kit remap'
+            moved[n] = 640 + len(bank.metatiles)
+            bank.metatiles.append(list(bank.metatiles[i]))
+            bank.attributes.append(bank.attributes[i])
+    for rows in compiled['temples'].values():
+        for row in rows:
+            row[:] = [moved.get(n, n) for n in row]
+    used = palette_use(primary, bank, [640 + i for i in range(len(bank.metatiles)) if 640 + i not in wanted])
+    carrier = Carrier(bank, primary, used)
+    for n in sorted(wanted):
+        carrier.carry(n, *wanted[n])
+    return dict(carried=[f'{n:#05x}' for n in sorted(wanted)], templeMetatilesMoved={f'{a:#05x}': f'{b:#05x}' for a, b in moved.items()},
+                verbatimPalettes=sorted(carrier.report['verbatimPalettes']), reencodedTiles=carrier.report['reencodedTiles'],
+                graphicsAdded=carrier.report['graphicsAdded'])
+
+
+def derive_bank(compiled, spec, grids, specs, banks):
+    """A copy of the shared bank for one map, carrying what that map borrows over IDs and palettes it never draws."""
+    derived = {k: copy.deepcopy(compiled[k]) for k in ('graphics', 'metatiles', 'attributes', 'palettes', 'budget')}
+    primary = Bank.load(spec['tilesets']['primary'], range(7))
+    bank = Bank.of_compiled(derived)
+    wanted = borrowed(spec, primary, bank, banks)
+    by_key = {'MAP_TAICHUNG_' + s['key']: s for s in specs}
+    drawn = {w & 0x3FF for w in grids[spec['name']].cells}
+    for c in spec['connections']:
+        other = by_key.get(c['map'])
+        if other:
+            g = grids[other['name']]
+            drawn |= {g.cells[y * g.width + x] & 0x3FF for x, y in strip(spec['width'], spec['height'], g.width, g.height, c['direction'], c['offset'])}
+    for c, name, lay, source_primary, source in neighbours(spec, banks):
+        words = file_words(lay)
+        drawn |= {words[y * lay['width'] + x] & 0x3FF for x, y in strip(spec['width'], spec['height'], lay['width'], lay['height'], c['direction'], c['offset'])} - set(wanted)
+    clash = sorted(set(wanted) & drawn)
+    assert not clash, f"{spec['name']}: carried IDs are also drawn from Nantun art: {[hex(n) for n in clash]}"
+    carrier = Carrier(bank, primary, palette_use(primary, bank, drawn))
+    for n in sorted(wanted):
+        carrier.carry(n, *wanted[n])
+    derived['budget'] = dict(derived['budget'], secondaryGraphicsTotal=len(derived['graphics']), secondaryMetatiles=len(derived['metatiles']))
+    return derived, dict(carried=[f'{n:#05x}' for n in sorted(wanted)], verbatimPalettes=sorted(carrier.report['verbatimPalettes']),
+                         reencodedTiles=carrier.report['reencodedTiles'], graphicsAdded=carrier.report['graphicsAdded'])
+
+
+def strip_mismatches(spec, grids, specs, bank_for):
+    """Connection-strip cells the map would draw differently from their owner, as check_old_core compares them."""
+    by_key = {'MAP_TAICHUNG_' + s['key']: s for s in specs}
+    index = map_index()
+    primary = Bank.load(spec['tilesets']['primary'], range(7))
+    mine = bank_for(spec['tilesets']['secondary'])
+    errors = []
+    for c in spec['connections']:
+        other = by_key.get(c['map'])
+        if other:
+            g = grids[other['name']]
+            width, height, words = g.width, g.height, g.cells
+            theirs, their_primary = bank_for(other['tilesets']['secondary']), Bank.load(other['tilesets']['primary'], range(7))
+        else:
+            lay = layout(index[c['map']])
+            width, height, words = lay['width'], lay['height'], file_words(lay)
+            theirs, their_primary = bank_for(lay['secondary_tileset']), Bank.load(lay['primary_tileset'], range(7))
+        seen = set()
+        for x, y in strip(spec['width'], spec['height'], width, height, c['direction'], c['offset']):
+            n = words[y * width + x] & 0x3FF
+            if n not in seen and render(primary, mine, n) != render(their_primary, theirs, n):
+                errors.append(f"{spec['name']} draws {c['map']} ({x},{y}) metatile {n:#05x} differently")
+            seen.add(n)
+    return errors
