@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Check all actual ambient buffers and their one-page, non-consuming routes."""
+from pathlib import Path
+import contextlib, importlib.util, io, json, re, subprocess, tempfile
+ROOT=Path(__file__).resolve().parents[2]
+manifest=json.loads((ROOT/'data/taichung/story-ambient-npcs/dialogue.json').read_text())
+rows=manifest['entries'];assert len(rows)==10 and len({row['script'] for row in rows})==10
+spec=importlib.util.spec_from_file_location('routes',ROOT/'tools/taichung_gameplay/test-gym-dialogue.py');route=importlib.util.module_from_spec(spec)
+with contextlib.redirect_stdout(io.StringIO()):spec.loader.exec_module(route)
+text=(ROOT/'data/scripts/taichung_ambient_npcs.inc').read_text()
+body=re.search(r'\.macro taichung_ambient_npc name\n(.*?)\n\t.endm',text,re.S)[1]
+names=re.findall(r'^\ttaichung_ambient_npc (\w+)$',text,re.M)
+assert names==[row['name'] for row in rows]
+for row in rows:
+ program=route.parse([body.replace(r'\name\()',row['name']).replace(r'\name',row['name'])])
+ for replay in (False,True):
+  label=row['script'];index=0;locked=False;calls=[];pages=0
+  for _ in range(16):
+   instruction=program[label][index];index+=1;op,_,arg=instruction.partition(' ')
+   if op=='lock':locked=True
+   elif op=='faceplayer':assert locked
+   elif op=='goto_if_questlog':
+    if replay:label,index=arg,0
+   elif op=='callnative':assert arg==row['buffer'] and locked and not replay;calls.append(arg)
+   elif op=='msgbox':assert arg=='gStringVar4' and calls==[row['buffer']] and locked;pages+=1
+   elif op=='goto':label,index=arg,0
+   elif op=='release':locked=False
+   elif op=='end':assert not locked and pages==(0 if replay else 1);break
+   else:raise AssertionError(('unexpected state/menu/battle/capture effect',instruction))
+  else:raise AssertionError('script loop')
+with tempfile.TemporaryDirectory(prefix='ambient-text-') as td:
+ p=Path(td)
+ declarations='\n'.join('void '+row['buffer']+'(void);' for row in rows)
+ pointers=','.join(row['buffer'] for row in rows)
+ driver='''#include "global.h"
+#include <string.h>
+#include <stdio.h>
+u8 gStringVar4[1024]; static int chinese;
+u8 *StringCopy(u8 *d,const u8 *s) { return (u8*)strcpy((char*)d,(const char*)s); }
+const u8 *TaichungText(const u8 *e,const u8 *z) { return chinese?z:e; }
+'''+declarations+'\nint main(void) { unsigned i; void (*buffers[])(void)={'+pointers+'''};
+for(chinese=0;chinese<2;chinese++) for(i=0;i<10;i++) { buffers[i](); fwrite(gStringVar4,strlen((char*)gStringVar4)+1,1,stdout); }
+return 0; }
+'''
+ (p/'driver.c').write_text(driver)
+ subprocess.run(['cc','-std=c99','-Wall','-Wextra','-Werror','-I'+str(ROOT/'tests/gym_host'),'-I'+str(ROOT/'include'),str(ROOT/'src/taichung_ambient_npcs.c'),str(p/'driver.c'),'-o',str(p/'test')],check=True)
+ outputs=subprocess.check_output([str(p/'test')]).split(b'\0');assert outputs.pop()==b''
+ expected=['\n'.join(row[locale]).encode() for locale in ('en','zh-TW') for row in rows]
+ assert outputs==expected
+print('PASS:20 actual C EN/TW buffers match content;10 actual ASM routes give one page, unlock movement, no menu/battle/capture/saved writes; quest-log replay exits without speech')
