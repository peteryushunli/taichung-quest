diff --git a/tools/taichung/tile_limit_probe/extract_region.py b/tools/taichung/tile_limit_probe/extract_region.py
new file mode 100644
index 00000000..f4bd7a7b
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/extract_region.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Cut regions out of the Boulevard Plan block fill for the tile limit probe.
+
+Reads a pinned copy of the fill's fill-raw.json (the design as first drawn: every
+building, landmark, prop, plant and tree, and the ground letters) and the fill's
+preview engine (which ground tile each letter gets), and writes what
+build_probe.py needs into this directory, so the native branch does not depend
+on the artifacts folder afterwards:
+
+  regions.json       per region: ground metatile per cell, walkable flags, placements
+  ground_extra.png   16x16 art of ground cells that are not in the probe's primary tileset
+  art/<sprite>.png   the saved sprites the regions use
+
+The regions are the places the whole-world count (world_need.py) found hardest:
+
+  dadun        City Hall to the Dadun canal: most tiles in one map, 14 palettes on screen
+  oldcity      Old City around tile 323,161: the most tiles on one screen anywhere
+  centralpark  Central Park around tile 136,26: the most palettes on one screen (17, four more than the hardware has)
+
+Run once (already done; the outputs are committed):
+  python3 extract_region.py --fill /path/to/artifacts/boulevard-plan/fill --snapshot /path/to/fill-raw-snapshot.json
+"""
+import argparse, hashlib, json, os, shutil, sys
+from PIL import Image
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REGIONS = {                              # world tiles, ends exclusive
+    'dadun': (128, 104, 216, 164),
+    'oldcity': (298, 136, 346, 186),
+    'centralpark': (108, 8, 156, 56),
+}
+PRIMARY_METATILES = 640
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--fill', required=True)
+parser.add_argument('--snapshot', required=True)
+args = parser.parse_args()
+os.environ['FILL_RAW'] = '1'             # the preview engine builds the design as first drawn
+sys.path.insert(0, os.path.join(args.fill, 'src'))
+import engine as E
+import beitun
+
+snapshot = json.load(open(args.snapshot))
+world = beitun.build()
+overridden = 0                           # the snapshot's letters win over whatever the engine's sources say today
+for g in snapshot['grids'].values():
+    ax, ay = g['area'][:2]
+    for j, row in enumerate(g['rows']):
+        for i, ch in enumerate(row):
+            if world.g[ay + j][ax + i] != ch: world.g[ay + j][ax + i] = ch; overridden += 1
+marks = world.markings()
+
+class Ref:
+    """Stands in for a ground tile image: remembers which metatile of which sheet it is, and any flips."""
+    def __init__(self, n, sheet, ops=()): self.n, self.sheet, self.ops = n, sheet, tuple(ops)
+    def transpose(self, op): return Ref(self.n, self.sheet, self.ops + (op,))
+    def image(self):
+        im = real_tile(self.n, self.sheet)
+        for op in self.ops: im = im.transpose(op)
+        return im
+real_tile = E.tile
+E.tile = lambda n, sheet='north': Ref(n, sheet)
+
+extra = {}            # (sheet, id) -> index
+regions = {}; used = {}
+os.makedirs(os.path.join(HERE, 'art'), exist_ok=True)
+for name, (x0, y0, x1, y1) in REGIONS.items():
+    ground, walk = [], []
+    for y in range(y0, y1):
+        grow, wrow = [], ''
+        for x in range(x0, x1):
+            ref = world.ground_tile(x, y, marks)
+            if ref is None: ref = Ref(E.GRASS, 'north')
+            if ref.sheet == 'north' and ref.n < PRIMARY_METATILES and not ref.ops: grow.append(ref.n)
+            else:
+                key = (ref.sheet, ref.n, tuple(int(op) for op in ref.ops))
+                if key not in extra: extra[key] = (len(extra), ref.image())
+                grow.append(-1 - extra[key][0])
+            ch = world.at(x, y)
+            wrow += '1' if (ch in E.ROAD or ch in E.WALK) else '0'
+        ground.append(grow); walk.append(wrow)
+    objects = []
+    for p in snapshot['placements']:
+        w, h = p['tiles']
+        if p['x'] + w <= x0 or p['x'] >= x1 or p['y'] + h <= y0 or p['y'] >= y1: continue
+        o = {'sprite': p['sprite'], 'mirrored': bool(p.get('mirrored')), 'kind': p['kind'], 'x': p['x'] - x0, 'y': p['y'] - y0, 'w': w, 'h': h}
+        if p['kind'] == 'plant': o['solid'] = [[sx - p['x'], sy - p['y']] for sx, sy in p.get('solidTiles', [])]
+        objects.append(o)
+        if p['sprite'] != 'tree' and p['sprite'] not in used:
+            src = os.path.join(args.fill, 'kit', 'sprites', p['sprite'] + '.png')
+            shutil.copyfile(src, os.path.join(HERE, 'art', p['sprite'] + '.png'))
+            used[p['sprite']] = hashlib.sha256(open(src, 'rb').read()).hexdigest()
+    regions[name] = {'rect': [x0, y0, x1, y1], 'ground': ground, 'walk': walk, 'objects': objects}
+    print(name, len(objects), 'placements')
+E.tile = real_tile
+for stale in os.listdir(os.path.join(HERE, 'art')):
+    if stale[:-4] not in used: os.remove(os.path.join(HERE, 'art', stale))
+
+atlas = Image.new('RGBA', (16 * max(1, len(extra)), 16), (0, 0, 0, 0))
+for i, im in extra.values(): atlas.paste(im, (i * 16, 0))
+atlas.save(os.path.join(HERE, 'ground_extra.png'))
+
+json.dump({
+    'what': 'Boulevard Plan block fill as first drawn (fill-raw.json, %s), three regions' % snapshot.get('variant', ''),
+    'snapshotSha256': hashlib.sha256(open(args.snapshot, 'rb').read()).hexdigest(),
+    'groundLettersTakenFromSnapshot': overridden,
+    'primary': 'gTileset_TaichungApprovedOldCityNorthPrimary (ground cells >= 0 are its metatile ids)',
+    'groundExtra': [{'sheet': s, 'metatile': n, 'flips': list(ops)} for (s, n, ops), (i, im) in sorted(extra.items(), key=lambda kv: kv[1][0])],
+    'tree': list(E.TREE), 'flower': E.FLOWER,
+    'regions': regions, 'sprites': used,
+}, open(os.path.join(HERE, 'regions.json'), 'w'), indent=1)
+print(len(used), 'sprites,', len(extra), 'kinds of extra ground; letters overridden from the snapshot:', overridden)
