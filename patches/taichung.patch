+def new_secondary_budget(redrawn, bank, carried):
+    """A map that gets a new secondary: slots its redrawn landmarks and any carried sets take.
+    `carried` maps a label to (tiles, metatile definitions)."""
+    pieces = [(n, p) for n, p in sorted(redrawn.items()) if landmark_redraw.LANDMARKS[n][1] == bank]
+    tiles = set().union(*(p.secondary_tiles for _, p in pieces))
+    definitions = sum(p.stats["newMetatiles"] for _, p in pieces)
+    used_tiles = len(tiles) + sum(t for t, _ in carried.values())
+    used_definitions = definitions + sum(d for _, d in carried.values())
+    return {"secondary": "new, 384 slots", "doorScratch": "0x3F8-0x3FF (8)", "palettes": "OldCore 7-12 to start",
+            "landmarks": {str(n): {"tiles": p.stats["newSecondaryTiles"], "definitions": p.stats["newMetatiles"]} for n, p in pieces},
+            "landmarkTilesShared": len(tiles), "landmarkDefinitions": definitions,
+            "carried": {k: {"tiles": t, "definitions": d} for k, (t, d) in carried.items()},
+            "freeTiles": 376 - used_tiles, "freeDefinitions": 384 - used_definitions}
