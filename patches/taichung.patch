+    print(json.dumps({key:manifest[key] for key in ("baselineCommit", "primary", "secondary", "secondaryGraphics", "loadedSecondaryGraphics", "secondaryMetatiles", "changedMapWords", "newlyBlockedCellCount", "registeredInSource", "graphicsBudget", "sourceProof")}, indent=2))
