@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Register only the compiled CMP pair and scene in this feature checkout."""
+import json
+from pathlib import Path
+import subprocess
+
+ROOT=Path(__file__).resolve().parents[3]
+DATA=ROOT/'data/taichung/landmarks/cmp-native'
+BASE='38c617288cb4a5220c75e914d916054b1530d9f9'
+
+
+def install():
+    manifest=json.loads((DATA/'manifest.json').read_text())
+    assert manifest['baselineCommit']==BASE
+    snippets={'graphics.h':[],'metatiles.h':[],'headers.h':[]}
+    for secondary,(label,folder) in enumerate(((manifest['primary'],manifest['primaryFolder']),(manifest['secondary'],manifest['secondaryFolder']))):
+        name=label.removeprefix('gTileset_')
+        snippets['graphics.h'].append(f'const u32 gTilesetTiles_{name}[] = INCBIN_U32("{folder}/tiles.4bpp.lz");\n\nconst u16 gTilesetPalettes_{name}[][16] =\n{{\n'+''.join(f'    INCBIN_U16("{folder}/palettes/{n:02}.gbapal"),\n' for n in range(16))+'};\n')
+        snippets['metatiles.h'].append(f'const u16 gMetatiles_{name}[] = INCBIN_U16("{folder}/metatiles.bin");\nconst u32 gMetatileAttributes_{name}[] = INCBIN_U32("{folder}/metatile_attributes.bin");\n')
+        snippets['headers.h'].append(f'const struct Tileset {label} =\n{{\n    .isCompressed = TRUE,\n    .isSecondary = '+('TRUE' if secondary else 'FALSE')+f',\n    .tiles = gTilesetTiles_{name},\n    .palettes = gTilesetPalettes_{name},\n    .metatiles = gMetatiles_{name},\n    .metatileAttributes = gMetatileAttributes_{name},\n    .callback = '+('NULL' if secondary else 'InitTilesetAnim_General')+',\n};\n')
+    path=ROOT/'data/layouts/layouts.json';layouts=json.loads(path.read_text())
+    layout=next(v for v in layouts['layouts'] if v.get('id')=='LAYOUT_TAICHUNG_GREENWAY')
+    assert (layout['primary_tileset'],layout['secondary_tileset']) in [('gTileset_TaichungOldCorePrimary','gTileset_TaichungGreenway'),(manifest['primary'],manifest['secondary'])]
+    map_path=ROOT/layout['blockdata_filepath'];before=subprocess.check_output(['git','show',BASE+':'+layout['blockdata_filepath']],cwd=ROOT)
+    compiled=(ROOT/manifest['mapFile']).read_bytes()
+    assert map_path.read_bytes() in (before,compiled), 'Greenway has unrelated source edits'
+    # Validate every registration target before writing any shared source file.
+    for filename,parts in snippets.items():
+        text=(ROOT/'src/data/tilesets'/filename).read_text()
+        for part in parts:
+            name=part.split('[]')[0].split()[-1] if filename=='graphics.h' else part.split('=')[0].split()[-1]
+            if part not in text:assert name not in text, f'Existing conflicting declaration: {filename}:{name}'
+    for filename,parts in snippets.items():
+        path=ROOT/'src/data/tilesets'/filename;text=path.read_text()
+        for part in parts:
+            if part not in text:text=text.rstrip()+'\n\n'+part
+        path.write_text(text)
+    layout['primary_tileset']=manifest['primary'];layout['secondary_tileset']=manifest['secondary']
+    (ROOT/'data/layouts/layouts.json').write_text(json.dumps(layouts,indent=2)+'\n')
+    map_path.write_bytes(compiled)
+    manifest['registeredInSource']=True;manifest['nativeRuntimeVerified']=False
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+    return {'registered':True,'primary':manifest['primary'],'secondary':manifest['secondary'],'mapFile':layout['blockdata_filepath']}
+
+
+if __name__=='__main__':print(json.dumps(install(),indent=2))
diff --git a/tools/taichung/landmarks/install_theater.py b/tools/taichung/landmarks/install_theater.py
