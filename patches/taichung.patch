+    parser.add_argument('--output', type=Path, default=HERE/'candidate')
+    parser.add_argument('--review', type=Path, default=ARTIFACT/'landmark-art/theater-native-candidate-v1.png')
+    parser.add_argument('--alpha-threshold', type=int, default=224)
+    parser.add_argument('--pixel-step', type=int, default=2)
+    args=parser.parse_args()
+    result=encode(args.source,args.output,args.review,args.alpha_threshold,args.pixel_step)
