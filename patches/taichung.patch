+            for field in ('metatiles', 'metatileAttributes'):
+                symbol = re.search(r'\.' + field + r'\s*=\s*(\w+)', header[1])[1]
+                declaration = re.search(r'\b' + symbol + r'\s*\[.*?=\s*(.*?);', declarations, re.S)
+                path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration[1])[1]
+                require(now.read(path) == before.read(path), 'Room metatiles/attributes changed: ' + path)
+                paths[field] = now.read(path)
+            values = struct.unpack('<' + 'I' * (len(paths['metatileAttributes']) // 4), paths['metatileAttributes'])
+            require(len(paths['metatiles']) == len(values) * 16, 'Room native bank lengths disagree')
+            return values
+
+        cases = []
+        for item in registration['staff']:
+            data = before.json(item['mapPath']); layout = layouts[data['layout']]
+            original = next(row for row in before.json('data/layouts/layouts.json')['layouts'] if row.get('id') == data['layout'])
+            require(same_json(layout, original), 'Staff room layout changed')
+            view = native.Map.__new__(native.Map)
+            view.data, view.layout, view.id = data, layout, data['id']
+            view.width, view.height = layout['width'], layout['height']
+            view.cells = struct.unpack('<' + 'H' * (len(now.read(layout['blockdata_filepath'])) // 2), now.read(layout['blockdata_filepath']))
+            view.attributes = [attributes(layout[key]) for key in ('primary_tileset', 'secondary_tileset')]
+            view.actors = {(obj['x'], obj['y']) for obj in data['object_events']}
+            view.signs = {(obj['x'], obj['y']) for obj in data['bg_events']}
+            view.obstacles = view.actors | view.signs
+            require(same_json(item['authored'], [3, 9]) and same_json(item['overlapFallback'], [4, 9]), 'Staff positions differ')
+            for x, y in ((3, 9), (4, 9)):
+                require(view.walkable(x, y) and view.cell(x, y) == 0x3294 and view.behavior(x, y) == 0 and view.elevation(x, y) == 3, 'Staff/fallback is not ordinary elevation3 ground')
+                blocked = view.obstacles | {(x, y)}
+                visited, queue = {(6, 14)}, deque([(6, 14)])
+                while queue:
+                    a, b = queue.popleft()
+                    for c, d in ((a - 1, b), (a + 1, b), (a, b - 1), (a, b + 1)):
+                        if (c, d) not in visited and (c, d) not in blocked and view.can_step(a, b, view, c, d):
+                            visited.add((c, d)); queue.append((c, d))
+                targets = {(5, 14), (6, 14), (7, 14), (6, 6), (x, y + 1)}
+                if x == 4:
+                    targets.add((3, 9))
+                require(targets <= visited and len(visited) == 130, 'Staff strands an exit/leader/talk/player position')
+                cases.append(dict(map=item['mapId'], staff=[x, y], reachableFloorCells=len(visited)))
+        return dict(nativeCases=cases)
+
+    for label, function in (('registrationAndExactMapDelta', registered_maps), ('sourceAndFacingHandoff', source_and_facing), ('authoredAndFallbackGeometry', geometry)):
+        try:
+            result['checks'][label] = dict(passed=True, **function())
+        except (ValueError, KeyError, IndexError, TypeError, FileNotFoundError, AssertionError, AttributeError, struct.error) as error:
+            result['checks'][label] = dict(passed=False)
+            result['errors'].append(label + ': ' + str(error))
+    result['passed'] = not result['errors']
+    result['scriptDependencies'] = script_dependencies(now)
+    return result
+
+
+def nested_check(source=ROOT, overrides=None):
+    """check() for a guard that peels other registered layers: only its overrides of the files
+    this increment owns reach the proof; every other input is the actual tree's."""
+    return check(source, {path: data for path, data in (overrides or {}).items() if path in OWNED})
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ROOT)
+    parser.add_argument('--revision')
+    parser.add_argument('--final-xitun', action='store_true', help='Verify current staff first, then run unchanged FinalXitun against only its five proved map underlays')
+    args = parser.parse_args()
+    if args.final_xitun and args.revision is not None:
+        parser.error('--final-xitun checks the actual current tree, not a historical revision')
+    report = check_final_xitun(args.source) if args.final_xitun else check(args.source, revision=args.revision)
+    print(json.dumps({key:value for key,value in report.items() if key != 'maps'}, indent=2))
+    raise SystemExit(0 if report['passed'] else 1)
diff --git a/tools/taichung/check_landmark_collision.py b/tools/taichung/check_landmark_collision.py
