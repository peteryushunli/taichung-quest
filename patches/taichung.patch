+def oldcity_buildings_underneath(files):
+    """Overrides that remove exactly the registered OldCity buildings delta from shared files."""
+    if not (files.source/OLDCITY_BUILDINGS).exists():
+        return {}
+    buildings = files.json(OLDCITY_BUILDINGS)
+    base = Files(files.source, buildings["baseCommit"])
+    raw, old = bytearray(files.read(OLDCITY_MAP)), base.read(OLDCITY_MAP)
+    for x0, y0, x1, y1 in files.json(OLDCITY_PLACEMENTS)["blocks"]:
+        for y in range(y0, y1+1):
+            raw[2*(y*40+x0):2*(y*40+x1+1)] = old[2*(y*40+x0):2*(y*40+x1+1)]
+    # The proof pins the bank files to the install contract, so their base bytes are
+    # exactly the state underneath the increment.
+    out = {path: base.read(path) for path in buildings["outputs"] if path != OLDCITY_MAP}
+    out[OLDCITY_MAP] = bytes(raw)
+    return out
+
+
+def oldcity_buildings_proof(files, checks, manifest_path=DEFAULT_MANIFEST):
+    """Prove the registered OldCity buildings increment from bytes, never from its installer."""
+    # Additive increment: the compiled bank is its exact prefix and the compiled grid
+    # its input. Only generic apartment cells change, outside Greenway's view, and each
+    # keeps its collision and elevation.
+    buildings, manifest = files.json(OLDCITY_BUILDINGS), files.json(manifest_path)
+    bank = Bank(files, manifest["primaryFolder"], manifest["secondaryFolder"])
+    base = Files(files.source, buildings["baseCommit"])
+    before = Bank(base, manifest["primaryFolder"], manifest["secondaryFolder"])
+    strip = oldcity_strip(files)
+    compiled_count = len(before.attrs[1])
+    checks.require(compiled_count == manifest["secondaryMetatiles"] and base.read(OLDCITY_MAP) == files.read(manifest["mapFile"]),
+                   "OldCity buildings increment is not built on the compiled bank and grid")
+    first, last = buildings["metatiles"]["appended"]
+    checks.require((first, last-first+1) == (640+compiled_count, buildings["metatiles"]["used"]), "OldCity buildings metatiles are not appended to the compiled bank")
+    for path, expected in buildings["outputs"].items():
+        checks.require(digest(files.read(path)) == expected, f"OldCity buildings output differs from its install contract: {path}")
+    for n in list(range(640)) + list(range(640, 640+compiled_count)):
+        checks.require(bank.render(n) == before.render(n) and bank.attr(n) == before.attr(n), f"OldCity buildings changed an existing definition: {n:#x}")
+    compiled, installed = files.words(manifest["mapFile"]), files.words(OLDCITY_MAP)
+    bad = oldcity_building_edit_errors(compiled, installed, strip)
+    checks.require(not bad, f"Invalid OldCity buildings edits: {bad[:4]}")
+    changed = {i for i, (a, b) in enumerate(zip(compiled, installed)) if a != b}
+    checks.require(len(changed) == buildings["changedCells"], "OldCity buildings changed-cell count differs from its contract")
+    checks.require(all((installed[i] & 1023) < 640 or first <= (installed[i] & 1023) <= last for i in changed), "OldCity buildings use a metatile outside the appended range")
+    return {"registered": True, "baseCommit": buildings["baseCommit"], "appendedMetatiles": [first, last], "loadedSecondaryGraphics": buildings["graphics"]["loadedSheet"],
+            "existingDefinitionsCompared": 640+compiled_count, "changedCells": len(changed), "greenwayDrawnCellsKept": len(strip)}
+
+
+def resolved_folder(files, label):
+    header = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", files.text("src/data/tilesets/headers.h"), re.S)
+    if not header:
+        raise ValueError(f"Unregistered C tileset {label}")
+    symbol = re.search(r"\.metatiles\s*=\s*(\w+)", header.group(1)).group(1)
+    declaration = re.search(rf"\b{symbol}\s*\[.*?=\s*(.*?);", files.text("src/data/tilesets/metatiles.h"), re.S)
+    path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1)).group(1)
+    return str(Path(path).parent), header.group(1)
+
+
+def script_lines(text):
+    return [re.sub(r"\s+", " ", line.split("@", 1)[0].strip()) for line in text.splitlines() if line.split("@", 1)[0].strip()]
+
+
+def script_block(text, label):
+    match = re.search(rf"^{re.escape(label)}::\s*\n(.*?)(?=^\w+::|\Z)", text, re.S | re.M)
+    if not match:
+        raise ValueError(f"Missing script block {label}")
+    return script_lines(match.group(1))
+
