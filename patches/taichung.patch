+class TilePool:
+    """Assign virtual graphics IDs, reusing mirrored 8×8 patterns."""
+
+    def __init__(self, palettes):
+        self.palettes = [{color: index + 1 for index, color in enumerate(palette)}
+                         for palette in palettes]
+        self.patterns = {}
+        self.indexed = {}
+        self.raw = bytearray()
+
+    def entry(self, colors, palette):
+        if not any(color is not None for color in colors):
+            return None
+        key = (tuple(colors), palette)
+        if key not in self.indexed:
+            index = self.palettes[palette]
+            mapped = [0 if color is None else index[color] for color in colors]
+            pattern, flipped = min(flips(mapped))
+            if pattern not in self.patterns:
+                self.patterns[pattern] = PRIMARY_TILES + len(self.patterns)
+                self.raw.extend(pattern[i] | pattern[i + 1] << 4 for i in range(0, 64, 2))
+            self.indexed[key] = (self.patterns[pattern], flipped, palette + PRIMARY_PALETTES)
+        return self.indexed[key]
