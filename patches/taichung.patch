+#!/usr/bin/env python3
+"""Join geographic lot proposals to prefab roles and dimensions, without painting maps.
+
+This checks the handoff between the independent geography and streetscape streams.
+It does not infer surveyed building footprints or validate final native traversal.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def read(path):
+    raw = path.read_bytes()
+    return json.loads(raw), hashlib.sha256(raw).hexdigest()
+
+
+def plan(draft, catalog, bindings):
+    for label, value in (('geography',draft),('catalog',catalog),('bindings',bindings)):
+        if value.get('schemaVersion') != 1:
+            raise ValueError('Unsupported ' + label + ' schema version')
+    sections = {s['id']: s for s in draft['sections']}
+    implemented = [p for p in catalog['prefabs'] if p.get('words')]
+    lots, usage = [], Counter()
+    undersized = Counter()
+    for lot in draft['unpaintedLotCandidates']:
+        section = sections[lot['section']]
+        recipe = section['fillRecipe']
+        if recipe['id'] not in bindings['recipeContexts']:
+            raise ValueError('Unmapped geography context: ' + recipe['id'])
+        contexts = bindings['recipeContexts'][recipe['id']]
+        categories = set()
+        for role in recipe['roles']:
+            if role not in bindings['roleCategories']:
+                raise ValueError('Unmapped geography role: ' + role)
+            categories.update(bindings['roleCategories'][role])
+        eligible, too_large = [], []
+        for prefab in implemented:
+            matches = [c for c in contexts if c in prefab['allowedContext']]
+            if prefab['role'] not in categories or not matches:
+                continue
+            if prefab['width'] > lot['width'] or prefab['height'] > lot['height']:
+                too_large.append(prefab['id'])
+                undersized[prefab['id']] += 1
+                continue
+            eligible.append(dict(prefabId=prefab['id'], role=prefab['role'],
+                                 placementContext=matches[0],
+                                 sizeIncludingApron=[prefab['width'],prefab['height']],
+                                 nativeTilesetRequirement=prefab['requires'],
+                                 artStatus=prefab['artStatus']))
+            usage[prefab['id']] += 1
+        buildings = [p for p in eligible if p['prefabId'].startswith('building-')]
+        if not buildings:
+            raise ValueError('No compatible building including its apron for lot ' + lot['id'])
+        lots.append(dict(lotId=lot['id'], section=lot['section'],
+                         localOrigin=lot['localOrigin'], lotSize=[lot['width'],lot['height']],
+                         recipe=recipe['id'], eligibleModules=eligible,
+                         contextCompatibleButTooLarge=too_large,
+                         selectedPrefabId=None, nativeMapId=None,
+                         status='unpainted module options; masks and authored geometry still require composition'))
+    return dict(schemaVersion=1,
+                status='cross-stream compatibility plan; no native maps or placements changed',
+                statistics=dict(sections=len(sections), lots=len(lots),
+                                implementedModules=len(implemented),
+                                modulesWithAtLeastOneCompatibleLot=len(usage),
+                                compatibleLotCountsByModule=dict(sorted(usage.items())),
+                                undersizedLotCountsByModule=dict(sorted(undersized.items()))),
+                lots=lots, missingSourceLayers=draft['missingLayers'],
+                unresolvedLandmarkReserveConflicts=draft['landmarkReserveConflicts'],
+                integrationConstraints=bindings['constraints'])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--draft',type=Path,default=ROOT/'docs/city-v2-streets.json')
+    parser.add_argument('--catalog',type=Path,default=ROOT/'data/taichung/prefabs/catalog.json')
+    parser.add_argument('--bindings',type=Path,default=ROOT/'data/taichung/prefabs/geography-bindings.json')
+    parser.add_argument('--output',type=Path,required=True)
+    args = parser.parse_args()
+    draft, dh = read(args.draft)
+    catalog, ch = read(args.catalog)
+    bindings, bh = read(args.bindings)
+    result = plan(draft,catalog,bindings)
+    result['inputSha256'] = dict(geographyDraft=dh,prefabCatalog=ch,geographyBindings=bh)
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
+    print(json.dumps({'result':'pass',**result['statistics']},indent=2))
+
+
+if __name__ == '__main__':
+    main()
