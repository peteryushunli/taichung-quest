+            for p in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
+                if p not in connected and current.inside(*p) and current.can_step(x,y,current,*p):
+                    connected.add(p); queue.append(p)
+        tests.require(current_valid <= connected, "Current collision layer strands ordinary positions")
+        tests.require((12,35) in current_valid & connected and current.behavior(12,35) == 0 and (12,35) not in DOORS,
+                      "V9 fallback is not ordinary, actor-free connected ground")
+        save, previous = now.text(SAVE), baseline.text(SAVE)
+        rows = table(save,"sXitunV9Relocations")
+        tests.require(len(rows) == 44 and sorted(rows) == sorted((x,y,12,35) for x,y in collision["positions"]),
+                      "V9 rows/fallback differ from actual collision delta")
+        pattern = r"static const struct SavedPositionRelocation\s+(\w+)\[\]\s*=\s*(\{.*?\};)"
+        old_tables, new_tables = dict(re.findall(pattern,previous,re.S)), dict(re.findall(pattern,save,re.S))
+        tests.require(all(new_tables.get(name) == body for name,body in old_tables.items()), "A historical relocation table changed")
+        tests.require(save[:save.index("static u16 SavedVar")] == previous[:previous.index("static u16 SavedVar")], "Continue-facing storage/size changed")
+        for name in ("SavedVar", "TaichungSaveInitNewGame", "RememberCacheRefreshFacing", "TaichungSaveConsumeContinueFacing", "ReloadCityBanksOnContinue", "ApplyRelocation"):
+            tests.require(function_body(save,name) == function_body(previous,name), "Protected native hook changed: " + name)
+        tests.require(actual.read("src/overworld.c") == baseline.read("src/overworld.c"), "Runtime facing/Continue hooks changed")
+        staff_header = staff_guard.header_underneath(actual.read(HEADER), collision.get('gymStaff', {}))
+        tests.require(staff_header == baseline.read(HEADER).replace(b"TAICHUNG_SAVE_VERSION 8",b"TAICHUNG_SAVE_VERSION 9",1), "V9 header changed beyond version")
+        chain = compact(function_body(save,"RepairChangedCityPosition"))
+        addition = "if (sourceVersion < 9 && IsXitun(warp) && warp->warpId == -1) ApplyRelocation(warp, sXitunV9Relocations, sizeof(sXitunV9Relocations) / sizeof(sXitunV9Relocations[0]));"
+        tests.require(chain.count(addition) == 1 and chain.replace(addition, "").split() == compact(function_body(previous,"RepairChangedCityPosition")).split(),
+                      "V9 repair changed/reordered historical gates or lacks native warp priority")
+        tests.require(chain.find("sXitunV8Relocations") < chain.find("sXitunV9Relocations"), "V9 repair does not run last")
+        upgrade = function_body(save,"TaichungSaveUpgradeOnContinue")
+        tests.require(upgrade.replace(" || version == 8", "", 1) == function_body(previous,"TaichungSaveUpgradeOnContinue"),
+                      "Current/future exits, explicit known8, prototype, checkpoint or transient hooks changed")
+        # Also cover older helpers and non-relocation constants: only the new
+        # table, last repair, cache cohort and explicit known8 may change code.
+        normalized = compact(staff_guard.save_underneath(actual.read(SAVE), collision.get('gymStaff', {})).decode())
+        declaration = "static const struct SavedPositionRelocation sXitunV9Relocations[] = " + new_tables["sXitunV9Relocations"]
+        normalized = normalized.replace(compact(declaration), "", 1).replace(addition, "", 1)
+        normalized = normalized.replace(compact(function_body(save,"UsesChangedCityBanks")),
+                                        compact(function_body(previous,"UsesChangedCityBanks")),1)
+        normalized = normalized.replace(" || version == 8)", ")", 1)
+        tests.require(compact(normalized) == compact(previous), "Native save code changed outside the reviewed v9 additions")
+        tests.require("assert(kept == 1367 - 44);" in now.text(TEST), "Current host retention count is missing")
+        return {"registered": True, "baselineCommit": COLLISION_BASE, "registrationCommit": COLLISION_COMMIT,
+                "historicalV8MapSha256": COLLISION_OLD_MAP_SHA, "currentMapSha256": COLLISION_NEW_MAP_SHA,
+                "alphaObjects": 13, "currentV9RepairRows":len(rows), "currentRetainedPositions":len(current_valid),
+                "historicalV8SafePositions":len(before_valid), "oldTablesByteExact":True, "protectedNativeHooksRetained":True,
+                "runtimeMigrationProof":False}
+
+    for name, function in (("inputsAndScope", inputs_and_scope), ("bank", bank), ("map", map_layout), ("seams", seams),
+                           ("edges", edges), ("geometry", geometry), ("repairTable", repair_table), ("versionGates", version_gates),
+                           ("hostTestData", host_test_data), ("registeredLandmarkCollisionIncrement", collision_increment)):
+        tests.section(name, function)
+    return {"passed": not tests.errors, "checks": tests.results, "errors": tests.errors, "runtimeMigrationProof": False}
