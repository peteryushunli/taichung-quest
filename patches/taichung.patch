+#!/usr/bin/env python3
+"""Check the Theater proposal against source art, scene geometry and GBA formats.
+
+This performs source checks only. It does not install the proposal or claim that
+door animations, player layering, or bicycle movement have run in an emulator.
+"""
+from collections import deque
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+from PIL import Image, ImageChops
+
+from compile_theater import (
+    ROOT, OUTPUT, INPUT, PRIMARY, SECONDARY, MAP, BORDER, ORIGIN, SIZE,
+    OLD_FOOTPRINT, WIDTH, HEIGHT, DOOR, DOOR_WORD, APPROACH, ARRIVAL, PAVING,
+    values, sha, colors, inside, compile_bank, render_metatiles, render_scene,
+)
+
+
+def same_image(first, second, label):
+    assert first.size == second.size and ImageChops.difference(first.convert("RGB"), second.convert("RGB")).getbbox() is None, label
+
+
+def reachable(words, start, target):
+    seen, queue = {start}, deque([start])
+    while queue:
+        x, y = queue.popleft()
+        if (x, y) == target:
+            return True
+        for point in ((x-1, y), (x+1, y), (x, y-1), (x, y+1)):
+            nx, ny = point
+            if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT) or point in seen:
+                continue
+            word = words[ny*WIDTH+nx]
+            if not word & 0xC00 and word >> 12 == 3:
+                seen.add(point)
+                queue.append(point)
+    return False
+
+
+def main():
+    manifest = json.loads((OUTPUT / "compile-manifest.json").read_text())
+    proposal = values(OUTPUT / "proposal/map.bin")
+    baseline = values(OUTPUT / "proposal/baseline-map.bin")
+    assert len(proposal) == len(baseline) == WIDTH*HEIGHT
+    assert sha((OUTPUT / "proposal/baseline-map.bin").read_bytes()) == manifest["proposal"]["baselineSha256"]
+    assert sha((OUTPUT / "proposal/map.bin").read_bytes()) == manifest["proposal"]["mapSha256"]
+    for relative, digest in manifest["sourceSha256"].items():
+        current = (ROOT / relative).read_bytes()
+        if relative == str(MAP.relative_to(ROOT)):
+            assert sha(current) in {digest, manifest["proposal"]["mapSha256"]}, "Registered Xitun has unrelated changes; review a new baseline"
+        else:
+            assert sha(current) == digest, f"Source changed: {relative}"
+    assert (OUTPUT / "proposal/border.bin").read_bytes() == BORDER.read_bytes()
+    # Original palette text is retained byte for byte, not merely rounded to a
+    # similar RGB value. Primary palettes and graphics are covered by hashes.
+    for n in range(16):
+        source = INPUT.parent / "07.pal" if n == 7 else SECONDARY / f"palettes/{n:02}.pal"
+        assert (OUTPUT / f"palettes/{n:02}.pal").read_bytes() == source.read_bytes()
+        native = values(OUTPUT / f"palettes/{n:02}.gbapal")
+        assert native == [r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors(source)]
+    art = Image.open(INPUT)
+    native = Image.open(OUTPUT / "tiles.png")
+    physical_count = native.width*native.height//64
+    entries = values(OUTPUT / "metatiles.bin")
+    attrs = values(OUTPUT / "metatile_attributes.bin", "I")
+    assert native.mode == "P" and native.width == 128 and native.getextrema()[1] <= 15
+    assert physical_count == manifest["graphics"]["loadedIncludingSheetPadding"] <= 384
+    assert len(entries) == len(attrs)*8 and len(attrs) <= 384
+    assert all((word & 1023) < 640+physical_count and word >> 12 < 13 for word in entries)
+    assert all((word & 1023) < 640+len(attrs) for word in proposal)
+    raw = (OUTPUT / "tiles.4bpp").read_bytes()
+    decoded = [value for byte in raw for value in (byte & 15, byte >> 4)]
+    expected = [native.getpixel((n%16*8+x, n//16*8+y))
+                for n in range(physical_count) for y in range(8) for x in range(8)]
+    assert decoded == expected and len(raw) == physical_count*32
+    spec = importlib.util.spec_from_file_location("source_render", ROOT / "tools/taichung/render_maps.py")
+    renderer = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(renderer)
+    original_tiles = renderer.render_metatiles(ROOT, "General", "PewterCity")
+    packed_tiles = render_metatiles(OUTPUT)
+    source_attrs = values(SECONDARY / "metatile_attributes.bin", "I")
+    preserved = manifest["preservedSourceMetatiles"]
+    for tile in preserved:
+        same_image(original_tiles[tile], packed_tiles[tile], f"Preserved source render {tile:#x}")
+        assert attrs[tile-640] == source_attrs[tile-640]
+    for tile in set(range(640, 640+len(source_attrs))) - set(preserved):
+        assert entries[(tile-640)*8:(tile-640)*8+8] == [0]*8 and attrs[tile-640] == 0
+    # Verify every appended metatile against the approved raster independently
+    # of the map overlay, including the cell later replaced by General's door.
+    first = manifest["metatiles"]["firstTheaterId"]
+    opaque_palette = colors(OUTPUT / "palettes/07.pal")
+    for y in range(SIZE[1]):
+        for x in range(SIZE[0]):
+            reference = original_tiles[PAVING & 1023].copy()
+            for dy in range(16):
+                for dx in range(16):
+                    index = art.getpixel((x*16+dx, y*16+dy))
+                    if index:
+                        reference.putpixel((dx, dy), opaque_palette[index])
+            tile = first+y*SIZE[0]+x
+            same_image(reference, packed_tiles[tile], f"Raster round-trip {x},{y}")
+            assert attrs[tile-640] == (0x20000000 if y == SIZE[1]-1 else 0)
+    envelope = (ORIGIN[0], ORIGIN[1], ORIGIN[0]+SIZE[0]-1, ORIGIN[1]+SIZE[1]-1)
+    outside, transparent, painted = 0, 0, 0
+    for n, (old, new) in enumerate(zip(baseline, proposal)):
+        gx, gy = n%WIDTH, n//WIDTH
+        if not inside(gx, gy, envelope):
+            assert old == new, f"Outside envelope changed: {gx},{gy}"
+            outside += 1
+            continue
+        x, y = gx-ORIGIN[0], gy-ORIGIN[1]
+        occupied = any(art.getpixel((x*16+dx, y*16+dy)) for dy in range(16) for dx in range(16))
+        ground = PAVING if inside(gx, gy, OLD_FOOTPRINT) else old
+        if (gx, gy) == DOOR:
+            assert new == DOOR_WORD
+        elif occupied:
+            assert new == (first+y*SIZE[0]+x) | 0x400
+            assert new & 0xC00 == 0x400 and new >> 12 == 0
+            painted += 1
+        else:
+            assert new == ground, f"Transparent source was not retained at {gx},{gy}"
+            # An erased facade cell cannot remain an invisible solid.
+            if inside(gx, gy, OLD_FOOTPRINT):
+                assert new & 0xC00 == 0
+            transparent += 1
+    assert proposal[DOOR[1]*WIDTH+DOOR[0]] == DOOR_WORD
+    primary_attrs = values(PRIMARY / "metatile_attributes.bin", "I")
+    assert primary_attrs[DOOR_WORD & 1023] & 0x1FF == 0x69
+    for point in (APPROACH, ARRIVAL):
+        n = point[1]*WIDTH+point[0]
+        assert proposal[n] == baseline[n] and not proposal[n] & 0xC00 and proposal[n] >> 12 == 3
+    for y in (35, 36, 37):
+        for x in range(3, 30):
+            n = y*WIDTH+x
+            assert proposal[n] == baseline[n] and not proposal[n] & 0xC00, f"Maple street blocked: {x},{y}"
+    targets = [APPROACH, (12, 37), (12, 33), (20, 40)]
+    assert all(reachable(proposal, ARRIVAL, target) for target in targets), "Plaza/Maple approach path disconnected"
+    exterior = json.loads((ROOT / "data/maps/TaichungXitun/map.json").read_text())
+    warp = exterior["warp_events"][2]
+    assert (warp["x"], warp["y"], warp["elevation"]) == (*DOOR, 0)
+    assert (warp["dest_map"], warp["dest_warp_id"]) == ("MAP_TAICHUNG_THEATER_GYM", "1")
+    interior = json.loads((ROOT / "data/maps/TaichungTheater_Gym/map.json").read_text())
+    assert len(interior["warp_events"]) == 3
+    assert all((warp["dest_map"], warp["dest_warp_id"]) == ("MAP_TAICHUNG_XITUN", "2") for warp in interior["warp_events"])
+    scene = render_scene(OUTPUT, proposal)
+    for n, word in enumerate(baseline):
+        if not inside(n%WIDTH, n//WIDTH, envelope):
+            crop = scene.crop((n%WIDTH*16, n//WIDTH*16, n%WIDTH*16+16, n//WIDTH*16+16))
+            same_image(crop, original_tiles[word & 1023], f"Outside scene render changed at {n%WIDTH},{n//WIDTH}")
+    with tempfile.TemporaryDirectory(prefix="taichung-theater-") as folder:
+        temporary = Path(folder)
+        repeated = temporary / "bank"
+        again, _ = compile_bank(repeated, artifacts=None)
+        assert again == manifest
+        generated = sorted(path.relative_to(repeated) for path in repeated.rglob("*") if path.is_file())
+        assert all((OUTPUT / relative).read_bytes() == (repeated / relative).read_bytes() for relative in generated)
+        # Exercise the actual repository converter, not only our Python codec.
+        converter = ROOT / "tools/gbagfx/gbagfx"
+        subprocess.run([str(converter), str(OUTPUT / "tiles.png"), str(temporary / "tiles.4bpp")], check=True, capture_output=True)
+        assert (temporary / "tiles.4bpp").read_bytes() == raw
+        subprocess.run([str(converter), str(OUTPUT / "palettes/07.pal"), str(temporary / "07.gbapal")], check=True, capture_output=True)
+        assert (temporary / "07.gbapal").read_bytes() == (OUTPUT / "palettes/07.gbapal").read_bytes()
+    layouts = json.loads((ROOT / 'data/layouts/layouts.json').read_text())['layouts']
+    installed = next(v for v in layouts if v.get('id') == 'LAYOUT_TAICHUNG_XITUN')
+    registered = installed['secondary_tileset'] == 'gTileset_TaichungXitun' and MAP.read_bytes() == (OUTPUT / 'proposal/map.bin').read_bytes()
+    report = {
+        "result": "pass", "scope": "source/format/proposed-map checks; runtime validation pending",
+        "registeredInSource": registered, "loadedRomVerifiedByThisTool": False,
+        "sourceFilesHashed": len(manifest["sourceSha256"]),
+        "sourceMetatilesRenderIdentical": len(preserved),
+        "rasterMetatilesRoundtripped": SIZE[0]*SIZE[1], "rasterPixelsChecked": SIZE[0]*SIZE[1]*256,
+        "mapCellsOutsideEnvelopeWordAndRenderIdentical": outside,
+        "transparentEnvelopeCellsPreserveGround": transparent,
+        "solidPaintedCellsExcludingDoor": painted,
+        "mapleStreetCellsIdenticalAndWalkable": 3*27,
+        "fixedGeneralDoorBehavior": "0x69 MB_WARP_DOOR at12,44",
+        "arrivalToApproachAndMapleGroundPathsReachable": [list(target) for target in targets],
+        "unchangedExteriorWarpAndInteriorReturnCount": 3,
+        "graphics": manifest["graphics"], "metatileDefinitionCount": len(attrs),
+        "reproducibleOutputFilesCompared": len(generated), "4bppPixelsRoundtripped": len(decoded),
+        "gbagfx4bppAndPaletteMatch": True, "paletteFilesExcept7PreservedByteForByte": 15,
+        "currentRegisteredMapState": "baseline" if MAP.read_bytes() == (OUTPUT / "proposal/baseline-map.bin").read_bytes() else "proposal",
+        "artworkException": "existing General animated door intentionally replaces candidate local8,9",
+        "remainingRuntimeChecks": manifest["qa"]["runtimeChecksRemaining"],
+    }
+    (OUTPUT / "validation.json").write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
