new file mode 100644
index 00000000..f388ecf5
--- /dev/null
+++ b/tools/taichung/release_cleanup_guard.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""Qualify the 2026-11-19 release cleanup above the Story layer.
+
+The cleanup edits six exact inputs: fresh-game encounter defaults and the 中文
+label, the shorter Xiaoyu greeting, the one-page starter prompt (English and its
+protected Chinese row), the shorter outdoor tips and the settings doc. Each is
+hash-bound here. The older Story/capture/gym/home/art guards then run unchanged
+in a view where only those six inputs carry their pinned prior bytes and this
+layer's own files are hidden. Nothing older is re-pinned or made permissive.
+"""
+from __future__ import annotations
+import argparse
+import contextlib
+import hashlib
+from io import BytesIO
+import json
+from pathlib import Path
+import re
+import shutil
+import sys
+import tempfile
+import zipfile
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+LAYER = "data/taichung/release-cleanup-guard"
+REGISTRATION = LAYER + "/registration.json"
+BUNDLE = LAYER + "/baseline.zip"
+REGISTRATION_SHA256 = "9b24213cd1172086657ea2c265636dbb8e4c9367a33216a3fb5e4882b76dcb3c"
+BASE = "0aa0dbe533ba266e1ce2e73905ae1c8b3fb34737"
+LAYER_FILES = (
+    REGISTRATION,
+    BUNDLE,
+    "docs/release-cleanup-source-guard.md",
+    "tools/taichung/release_cleanup_guard.py",
+    "tools/taichung_gameplay/test-release-cleanup-guards.py",
+)
+EDITED = (
+    "data/maps/PalletTown/text.inc",
+    "docs/taichung-exploration.md",
+    "src/taichung_exploration_menu.c",
+    "src/taichung_guest_house.c",
+    "src/taichung_language.c",
+    "src/taichung_onboarding_text.c",
+)
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def reader(source=ROOT, overrides=None):
+    overrides = overrides or {}
+    def read(path):
+        if path in overrides:
+            if overrides[path] is None:
+                raise FileNotFoundError(path)
+            return overrides[path]
+        return (Path(source) / path).read_bytes()
+    return read
+
+
+def load(read):
+    raw = read(REGISTRATION)
+    require(sha(raw) == REGISTRATION_SHA256, "Release cleanup registration changed")
+    record = json.loads(raw)
+    require(record["base"] == BASE, "Release cleanup base changed")
+    require(tuple(sorted(record["edited"])) == EDITED, "Release cleanup input inventory changed")
+    return record
+
+
+def bundle(read, record):
+    raw = read(BUNDLE)
+    require(sha(raw) == record["baselineBundleSha256"], "Release cleanup baseline bundle changed")
+    with zipfile.ZipFile(BytesIO(raw)) as archive:
+        names = sorted(archive.namelist())
+        require(names == sorted("before/" + path for path in EDITED), "Release cleanup bundle inventory changed")
+        return {name[len("before/"):]: archive.read(name) for name in names}
+
+
+def literal(source, name):
+    """Return the concatenated C string literal assigned to `name`."""
+    match = re.search(r"\b" + re.escape(name) + r"\[\]\s*=\s*_\(((?:\s*\"(?:[^\"\\]|\\.)*\")+)\s*\);", source)
+    require(match, "Missing text: " + name)
+    return "".join(re.findall(r"\"((?:[^\"\\]|\\.)*)\"", match.group(1)))
+
+
+def pages(text):
+    return text.count("\\p") + 1
+
+
+def semantics(read):
+    menu = read("src/taichung_exploration_menu.c").decode()
+    startup = menu.split("if (startup)", 1)
+    require(len(startup) == 2, "Fresh-game encounter default block missing")
+    block = startup[1].split("}", 1)[0]
+    for row, var in (("WILD", "TAICHUNG_EXPLORATION_WILD_VAR"), ("SIGHT", "TAICHUNG_EXPLORATION_SIGHT_VAR")):
+        require(var + " - VARS_START] == TAICHUNG_EXPLORATION_UNSET" in block,
+                row + " default must apply only while the preference is unset")
+        require("sModes[TAICHUNG_EXPLORATION_" + row + "] = TAICHUNG_EXPLORATION_OFF;" in block,
+                row + " encounters must start Off on a fresh game")
+    require(literal(menu, "sChinese") == "中文", "Chinese language row must read 中文")
+
+    house = read("src/taichung_guest_house.c").decode()
+    for name in ("sWelcomeEn", "sWelcomeZh"):
+        require(pages(literal(house, name)) == 3, name + " must stay three pages")
+    require("Welcome to Taichung!" in literal(house, "sWelcomeEn"), "Greeting must welcome the player to Taichung")
+
+    pallet = read("data/maps/PalletTown/text.inc").decode()
+    starter = re.search(r"Taichung_Text_ChooseStarter::\n\t\.string \"([^\"]*)\"", pallet)
+    require(starter and "\\p" not in starter.group(1), "Starter prompt must stay one page")
+    language = read("src/taichung_language.c").decode()
+    require(pages(literal(language, "sZh_Taichung_Text_ChooseStarter")) == 1, "Chinese starter prompt must stay one page")
+
+    tips = read("src/taichung_onboarding_text.c").decode()
+    for name, count in (("sIntroEn", 1), ("sIntroZh", 1), ("sBikeEn", 2), ("sBikeZh", 2), ("sMapEn", 2),
+                        ("sMapZh", 2), ("sTeamEn", 1), ("sTeamZh", 1), ("sLandmarksEn", 1),
+                        ("sLandmarksZh", 1), ("sReleaseEn", 1), ("sReleaseZh", 1)):
+        require(pages(literal(tips, name)) == count, name + " page count changed")
+    require("nearest gym" in literal(tips, "sLandmarksEn") and "最近的道館" in literal(tips, "sLandmarksZh"),
+            "Gym tip must point to the nearest gym")
+    new_copy = (literal(house, "sWelcomeEn") + literal(house, "sWelcomeZh") + starter.group(1)
+                + literal(language, "sZh_Taichung_Text_ChooseStarter") + literal(tips, "sLandmarksEn")
+                + literal(tips, "sLandmarksZh"))
+    require(not re.search(r"\b(10|ten)\b|十", new_copy, re.I), "New opening copy must not hard-code a gym count")
+    return dict(encountersStartOff=True, chineseLabel="中文", greetingPages=3, starterPages=1,
+                tipPages=8, noGymCount=True)
+
+
+def verified(read):
+    record = load(read)
+    for path, row in record["edited"].items():
+        require(sha(read(path)) == row["after"], "Release cleanup edited input changed: " + path)
+    before = bundle(read, record)
+    for path, raw in before.items():
+        require(sha(raw) == record["edited"][path]["before"], "Release cleanup prior input differs: " + path)
+    detail = semantics(read)
+    return dict(passed=True, base=BASE, edited=len(before), checks=detail, runtimeAcceptanceClaimed=False), before
+
+
+def check(source=ROOT, overrides=None):
+    try:
+        return verified(reader(source, overrides))[0]
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        return dict(passed=False, errors=[str(error)])
+
+
+@contextlib.contextmanager
+def qualified_mirror(source=ROOT):
+    """Copy the tree with only the six pinned prior inputs and without this layer."""
+    source = Path(source).resolve()
+    _, before = verified(reader(source))
+    with tempfile.TemporaryDirectory(prefix="taichung-release-cleanup-qualified-") as folder:
+        target = Path(folder).resolve()
+        def ignored(folder, names):
+            return {"build"} if Path(folder) == source and "build" in names else set()
+        shutil.copytree(source, target, dirs_exist_ok=True, ignore=ignored)
+        for name in LAYER_FILES:
+            (target / name).unlink()
+        (target / LAYER).rmdir()
+        for name, raw in before.items():
+            (target / name).write_bytes(raw)
+        yield target
+
+
+def self_test(source=ROOT):
+    read = reader(source); good = check(source); require(good["passed"], str(good))
+    record = load(read); probes = {}
+    def rejected(name, edits):
+        require(all(raw != read(path) for path, raw in edits.items()), "No-op cleanup probe: " + name)
+        probes[name] = not check(source, edits)["passed"]
+    for path in (REGISTRATION, BUNDLE, *record["edited"]):
+        rejected("changed:" + path, {path: read(path) + b"\nforeign-mutation"})
+    for path in (REGISTRATION, BUNDLE, *record["edited"]):
+        rejected("missing:" + path, {path: None})
+    require(all(probes.values()), "Cleanup corruptions accepted: " + ", ".join(n for n, ok in probes.items() if not ok))
+    return dict(passed=True, current=good, rejectedCorruptionProbes=probes)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    try:
+        report = self_test(args.source) if args.self_test else check(args.source)
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        report = dict(passed=False, errors=[str(error)])
+    print(json.dumps(report, indent=2, ensure_ascii=False)); sys.exit(0 if report["passed"] else 1)
