+#include "taichung_language.h"
+
+typedef char BadgeBridgeSize[sizeof(struct TaichungBadgeBridge) == TAICHUNG_BADGE_BRIDGE_SIZE ? 1 : -1];
+typedef char BadgeBridgeMaskOffset[offsetof(struct TaichungBadgeBridge, completedMask) == 0x18 ? 1 : -1];
+EWRAM_DATA volatile struct TaichungBadgeBridge gTaichungBadgeBridge = {0};
+
+void TaichungBadgeBridge_Tick(bool8 gameCallbacksRan)
+{
+    volatile struct TaichungBadgeBridge *p = &gTaichungBadgeBridge;
+    u8 selected = TAICHUNG_GYM_NONE;
+    u8 scene = TaichungCityPassGetScene(&selected);
+    u32 publication = (p->publication + 1) | 1;
+    p->publication = publication;
+    p->magicA = TAICHUNG_BADGE_BRIDGE_MAGIC_A;
+    p->magicB = TAICHUNG_BADGE_BRIDGE_MAGIC_B;
+    p->version = TAICHUNG_BADGE_BRIDGE_VERSION;
+    p->size = TAICHUNG_BADGE_BRIDGE_SIZE;
+    p->selfGbaAddress = (u32)p;
+    if (gameCallbacksRan)
+        p->frameCounter++;
+    p->completedMask = scene == TAICHUNG_BADGE_SCENE_NONE ? 0 : TaichungGymGetCompletedMask();
+    p->scene = scene;
+    p->selectedGym = selected;
+    p->flags = scene != TAICHUNG_BADGE_SCENE_NONE && gameCallbacksRan
+        && !gPaletteFade.active && !gMain.inBattle
+        && !QL_IS_PLAYBACK_STATE && QL_GetPlaybackState() != QL_PLAYBACK_STATE_RUNNING
+        ? TAICHUNG_BADGE_VISIBLE : 0;
+    p->language = scene == TAICHUNG_BADGE_SCENE_NONE ? 0 : (TaichungIsChinese() ? 2 : 1);
+    p->reserved = 0;
+    p->publication = publication + 1;
+    if (!p->publication)
+        p->publication = 2;
+}
