+#!/usr/bin/env python3
+"""V4 full-block composition over authored blank land; preserve fixed geography."""
+import argparse
+from collections import Counter, deque
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image, ImageDraw
+
+from color_compile import compile_colorways, color_grid, native_tile_images, save_native
+from library import ROOT, WALK, require
+from neighborhood_fill import cells, geometry_helpers
+from neighborhood_frontage import bay_widths, make_frontage
+from neighborhood_pilot import player_reference
+
+
+def fixed_geometry(layout):
+    geo = geometry_helpers()
+    roads = set().union(*(geo.line_cells(r['authoredLocalCenterline'], r['widthTiles']) for r in layout['authoredRoads']))
+    approaches = set().union(*(cells(a['rect']) for a in layout['clearApproaches']))
+    gym_reserves = set().union(*(cells(l['proposedAuthoredLocal']['reserveRect']) for l in layout['landmarks']))
+    gym_art = set().union(*(cells(l['proposedAuthoredLocal']['artRect']) for l in layout['landmarks']))
+    return roads, approaches, gym_reserves, gym_art
+
+
+def neighbors(point):
+    x, y = point
+    return ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1))
+
+
+def runs(xs):
+    result = []
+    for x in sorted(xs):
+        if result and x == result[-1][-1] + 1: result[-1].append(x)
+        else: result.append([x])
+    return result
+
+
+def unit_family(x, y, index):
+    # Coherent small groups, following the accepted old-core direction rather
+    # than random rainbow assignment or any inferred surveyed roof colors.
+    if x >= 52: return 'slate'
+    if 28 <= x < 52 and y < 42: return 'teal' if index // 3 % 3 else 'slate'
+    if x < 14 and 8 <= y <= 16: return 'source'
+    if 14 <= x < 28 and 30 <= y < 40: return 'mustard'
+    return 'terracotta' if index // 3 % 4 else 'slate'
+
+
+def plan_blocks(layout):
+    width, height = layout['width'], layout['height']; require((width, height) == (64, 64), 'Expected approved 64x64 pilot')
+    roads, approaches, reserves, art = fixed_geometry(layout)
+    invariant = roads | approaches | reserves
+    eligible = {(x, y) for y in range(height) for x in range(width)} - invariant
+    # One-tile public alleys link successive deep building rows. They stop at
+    # real reserved geometry; existing main roads connect the separated pieces.
+    public = {(x, y) for x, y in eligible if y % 8 == 7 or x in (7, 23, 39, 55, 63)}
+    clear = public | roads | approaches; solid = set(); aprons = set(); units = []; row_records = []
+
+    def available(x, front, h):
+        body = {(x, y) for y in range(front - h + 1, front)}
+        return body <= eligible and not body & (clear | solid) and (x, front) not in solid and (x, front) not in reserves
+
+    def place_run(x0, x1, front, h, tier, stepped=False):
+        nonlocal solid, clear, aprons
+        widths = bay_widths(x1 - x0 + 1); x = x0; row_id = f'authored-city-row-{len(row_records) + 1:03d}'
+        row_units = []
+        for n, w in enumerate(widths):
+            local_h = 6 if stepped and h == 8 and n % 3 == 1 else h
+            y = front - local_h + 1
+            body = cells([x, y, x + w - 1, front - 1]); apron = cells([x, front, x + w - 1, front])
+            require(body <= eligible and not body & (solid | clear), 'Block overlaps protected geometry or existing roof')
+            require(not apron & (solid | reserves), 'Block apron enters solid/reserved geometry')
+            # A whole attached run shares its south access line. Its end meets
+            # a protected lane/road, preserving access while later roofs fill.
+            role = 'shop' if front >= 23 or x < 5 and front >= 15 else 'residential'
+            identity = f'block-bay-{role}-{w}x{local_h}'
+            unit = dict(id=f'{row_id}-bay-{n + 1}', prefab=identity, x=x, y=y, width=w, height=local_h,
+                        role=role, colorway=unit_family(x, y, len(units)), context='shopping' if role == 'shop' else 'residential',
+                        rowId=row_id, tier=tier)
+            units.append(unit); row_units.append(unit['id']); solid |= body; aprons |= apron; clear |= apron; x += w
+        row_records.append(dict(id=row_id, rect=[x0, front - h + 1, x1, front], units=row_units,
+                                basis='authored-continuous-building-run; no real parcel footprint claim', tier=tier))
+
+    # The primary composition consists of joined deep rows, not separate lot
+    # props. Variations step back only upper rooflines; the front remains full.
+    for front in range(7, height, 8):
+        for h in (8, 6, 5, 4):
+            for line in runs(x for x in range(width) if available(x, front, h)):
+                if len(line) < 4: continue
+                apron = {(x, front) for x in line}
+                if not any(p in clear or any(n in clear for n in neighbors(p)) for p in apron): continue
+                place_run(line[0], line[-1], front, h, 'main-block', stepped=(h == 8))
+    # Fill road-edge wedges and remaining substantial blank land. Each new run
+    # must attach its full-width access line to the protected walking network.
+    # Its apron then becomes protected before any subsequent run can be placed.
+    for _ in range(3):
+        candidates = []
+        for front in range(3, height):
+            for h in (8, 6, 5, 4):
+                if front - h + 1 < 0: continue
+                for line in runs(x for x in range(width) if available(x, front, h)):
+                    if len(line) < 4: continue
+                    apron = {(x, front) for x in line}
+                    if not any(p in clear or any(n in clear for n in neighbors(p)) for p in apron): continue
+                    candidates.append(((h - 1) * len(line), h, len(line), -front, line[0], line[-1], front))
+        placed = False
+        for _, h, _, _, x0, x1, front in sorted(candidates, reverse=True):
+            if all(available(x, front, h) for x in range(x0, x1 + 1)):
+                place_run(x0, x1, front, h, 'road-edge-infill'); placed = True
+        if not placed: break
+    # Group adjoining roofs into actual authored built masses. The rectangular
+    # runs are explicit composition geometry; original 24 lots remain records.
+    components = []; unseen = set(solid)
+    while unseen:
+        start = min(unseen); group = {start}; queue = deque([start]); unseen.remove(start)
+        while queue:
+            for n in neighbors(queue.popleft()):
+                if n in unseen: unseen.remove(n); group.add(n); queue.append(n)
+        components.append(group)
+    return dict(units=units, rows=row_records, solid=solid, aprons=aprons, public=public,
+                clear=clear, eligible=eligible, invariant=invariant, roads=roads, approaches=approaches,
+                reserves=reserves, art=art, components=components)
+
+
+def block_prefab(unit, template):
+    width, height, role = unit['width'], unit['height'], unit['role']
+    p = make_frontage(width, 5 if height == 4 else height, role, template)
+    if height == 4:
+        # Compact flat/parapet source bay: remove one roof-body row, retaining
+        # the native top trim, complete glazing/eave row and dormant base.
+        del p['words'][1]; p.update(height=4, bodyHeight=3)
+        p['masks'] = dict(paint=['1' * width] * 3 + ['0' * width],
+                          solid=['1' * width] * 3 + ['0' * width],
+                          mandatoryClear=['0' * width] * 3 + ['1' * width])
+        for e in p['entrances']: e['position'][1] = 2; e['southApproach'][1] = 3
+    p['id'] = unit['prefab']; p['name'] = f'Attached city {role} bay {width}x{height}'
+    p['notes'] = 'Full-block source-native reuse; native north/south facade convention, not surveyed Taiwan parcel/height/art.'
+    return p
+
+
+def compile_blocks(output, layout, variant_metatile_start=None):
+    output = Path(output); output.mkdir(parents=True, exist_ok=True); plan = plan_blocks(layout)
+    catalog = json.loads((ROOT / 'data/taichung/prefabs/catalog.json').read_text()); template = catalog['prefabs'][0]
+    definitions = {}
+    for u in plan['units']: definitions[u['prefab']] = u
+    prefabs = [block_prefab(u, template) for _, u in sorted(definitions.items())]; catalog['prefabs'].extend(prefabs)
+    recipe = json.loads((ROOT / 'data/taichung/prefabs/colorways.json').read_text()); recipe['eligiblePrefabs'].extend(p['id'] for p in prefabs)
+    (output / 'block-catalog.json').write_text(json.dumps(catalog, indent=2) + '\n')
+    path = output / 'block-colorways.json'; path.write_text(json.dumps(recipe, indent=2) + '\n')
+    return compile_colorways(catalog=catalog, colorways=path, variant_metatile_start=variant_metatile_start), plan
+
+
+def compose_blocks(compiled, layout, plan):
+    base = [0x3001] * 4096
+    # Blank authored lawn becomes ordinary city hardscape. All reserved park/
+    # landmark cells retain their exact earlier source words.
+    for x, y in plan['eligible']: base[y * 64 + x] = 0x31c1 if x < 28 and y < 24 else 0x316e
+    for x, y in plan['roads']: base[y * 64 + x] = 0x316e
+    for x, y in plan['approaches']: base[y * 64 + x] = 0x3175
+    for x, y in plan['art']: base[y * 64 + x] = 0x056e
+    bare = [{k: u[k] for k in ('id', 'prefab', 'x', 'y', 'context')} for u in plan['units']]
+    composed = compiled['library'].compose(64, 64, bare, base=base, protected_paths=plan['clear'])
+    words = color_grid(compiled, composed, plan['units']); lib = compiled['library']
+    def walk(point):
+        x, y = point
+        if not (0 <= x < 64 and 0 <= y < 64): return False
+        w = words[y * 64 + x]; t = w & 1023; attr = lib.attr(t) if t < 640 else compiled['attributes'][t - 640]
+        return not w & 0xc00 and w >> 12 == 3 and attr & 0x1ff in WALK
+    arrivals = [tuple(l['proposedAuthoredLocal']['arrival']) for l in layout['landmarks']]
+    require(walk(arrivals[0]), 'Arrival blocked'); reached = {arrivals[0]}; queue = deque(reached)
+    while queue:
+        for n in neighbors(queue.popleft()):
+            if n not in reached and walk(n): reached.add(n); queue.append(n)
+    require(plan['clear'] <= reached, 'Disconnected public alley/apron/road')
+    for a in arrivals: require(a in reached, 'Gym arrival disconnected')
+    for p in layout['independentSeamSuggestions']: require(tuple(p['localPoint']) in reached, 'Road exit disconnected')
+    for e in composed['entrances']: require(e['status'] == 'dormant-reservation' and tuple(e['southApproach']) in reached, 'Dormant doorway approach disconnected')
+    require(all((a & 0xfc00) == (b & 0xfc00) for a, b in zip(words, composed['words'])), 'Roof color changes collision/elevation')
+    require(all(words[y * 64 + x] & 0xc00 for x, y in plan['solid']), 'Authored roof footprint is not fully blocked')
+    for row in plan['rows']:
+        x0, _, x1, y1 = row['rect']; require(all(words[(y1 - 1) * 64 + x] & 0xc00 for x in range(x0, x1 + 1)), 'Gap in attached streetfront')
+    eligible_count = len(plan['eligible']); apron_count = len(plan['aprons'] & plan['eligible'])
+    report = dict(result='pass', status='V4 full-block authored composition; native source art; unregistered',
+        dimensions=[64, 64], fixedInvariantCells=len(plan['invariant']), eligibleUnreservedCells=eligible_count,
+        buildingSolidCells=len(plan['solid']), solidShareOfAllUnreservedLand=round(len(plan['solid']) / eligible_count, 4),
+        clearApronCellsWithinUnreservedLand=apron_count,
+        solidShareAfterExplicitAprons=round(len(plan['solid']) / (eligible_count - apron_count), 4),
+        oneTilePublicAlleyCells=len(plan['public']), attachedBuildingBays=len(plan['units']),
+        authoredContinuousRows=len(plan['rows']), connectedBuiltMasses=len(plan['components']),
+        largestBuiltMassCells=max(map(len, plan['components'])), streetfrontGapCells=0,
+        protectedRoadAndApproachCells=len(plan['roads'] | plan['approaches']), reachableCells=len(reached),
+        landmarkSouthArrivals=arrivals, roadEgresses=len(layout['independentSeamSuggestions']),
+        dormantEntranceApproaches=len(composed['entrances']), geometryOrRoofOverflows=0,
+        originalLotRecordsRetained=len(layout['candidateLots']), originalLotsAreNotFootprintLimits=True,
+        sourceLayoutCanonicalJsonSha256=hashlib.sha256(json.dumps(layout, sort_keys=True).encode()).hexdigest(),
+        roles=dict(Counter(u['role'] for u in plan['units'])), colors=dict(Counter(u['colorway'] for u in plan['units'])),
+        nativeBankBudget=compiled['budget'], notice='All new block runs are authored game geometry over previously blank unreserved land; no actual parcel/footprint claims.')
+    return dict(words=words, entrances=composed['entrances'], report=report)
+
+
+def write_blocks(output):
+    output = Path(output); layout = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json').read_text())
+    compiled, plan = compile_blocks(output, layout); result = compose_blocks(compiled, layout, plan)
+    tiles = native_tile_images(compiled, {w & 1023 for w in result['words']}); image = Image.new('RGB', (1024, 1024))
+    for i, w in enumerate(result['words']): image.paste(tiles[w & 1023], (i % 64 * 16, i // 64 * 16))
+    player = player_reference(ROOT)
+    if player:
+        x, y = result['report']['landmarkSouthArrivals'][0]; image.paste(player, (x * 16, y * 16 - 16), player)
+    image.save(output / 'filled-block-native.png')
+    board = Image.new('RGB', (1024, 1120), '#e9efeb'); board.paste(image, (0, 64)); draw = ImageDraw.Draw(board)
+    draw.text((12, 10), 'R2C2 V4 / CONTINUOUS CITY BLOCKS / DEEP ATTACHED ROWS + NARROW PUBLIC ALLEYS', fill='#19392f')
+    draw.text((12, 28), 'Previously blank authored land becomes building blocks; narrow bays, stepped roofs, homes and shops.', fill='#365a4b')
+    draw.text((12, 46), 'All new blocks are game design, not surveyed parcels. Reused native FireRed art; Taiwan skins and gym art pending.', fill='#365a4b')
+    for l in layout['landmarks']:
+        r = l['proposedAuthoredLocal']['artRect']; box = (r[0] * 16, r[1] * 16 + 64, (r[2] + 1) * 16 - 1, (r[3] + 1) * 16 + 63)
+        draw.rectangle(box, outline='#ab642b', width=2); draw.text((box[0] + 4, box[1] + 5), l['name'], fill='#6b452b')
+        draw.text((box[0] + 4, box[1] + 20), 'GYM ART RESERVE', fill='#6b452b')
+    draw.text((12, 1090), 'All fixed roads, gym envelopes and arrival paths preserved. Clear public alleys/aprons connect every dormant doorway.', fill='#365a4b')
+    board.save(output / 'filled-block-overview.png')
+    (output / 'filled-map.bin').write_bytes(struct.pack('<4096H', *result['words']))
+    groups = []
+    for i, group in enumerate(plan['components']):
+        members = [r for r in plan['rows'] if any((x, r['rect'][3] - 1) in group for x in range(r['rect'][0], r['rect'][2] + 1))]
+        groups.append(dict(id=f'authored-built-mass-{i + 1:03d}', solidCells=len(group),
+            bbox=[min(x for x, y in group), min(y for x, y in group), max(x for x, y in group), max(y for x, y in group)],
+            rectangularRunIds=[r['id'] for r in members]))
+    manifest = dict(schemaVersion=1, notice=result['report']['notice'], sourceGeometryUnchanged=True,
+        originalLotRecords=layout['candidateLots'], authoredBuildingRuns=plan['rows'], authoredBuiltMasses=groups,
+        placements=plan['units'], oneTilePublicAlleyCells=sorted(plan['public']), clearApronCells=sorted(plan['aprons']))
+    (output / 'block-plan.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    (output / 'validation.json').write_text(json.dumps(result['report'], indent=2) + '\n')
+    save_native(compiled, output / 'native-color-bank')
+    print(json.dumps({k: v for k, v in result['report'].items() if k != 'nativeBankBudget'}, indent=2))
+    print(output / 'filled-block-overview.png')
+    return compiled, plan, result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--output', type=Path, required=True)
+    write_blocks(parser.parse_args().output)
