+static void AssertAfterCmp(s16 x, s16 y)
+{
+    unsigned i;
+    for (i = 0; i < COUNT(sGreenwayV6Cases); i++)
+        if (x == sGreenwayV6Cases[i][0] && y == sGreenwayV6Cases[i][1])
+        {
+            AssertGreenwayWarp(sGreenwayV6Cases[i][2],sGreenwayV6Cases[i][3]);
+            return;
+        }
+    AssertGreenwayWarp(x,y);
+}
