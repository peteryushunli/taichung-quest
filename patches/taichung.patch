+def secondary_budget(source, layout_id, g, keep=None):
+    """Secondary tile slots: used today, still needed once the draft is built, and so free for new art.
+    Needed = tiles of the live metatiles the draft keeps as art, plus `keep` (label -> metatile IDs).
+    The last 8 slots (0x3F8-0x3FF) are never free: field_door.c copies door animations there."""
+    layout = next(l for l in json.loads((source / "data/layouts/layouts.json").read_text())["layouts"] if l.get("id") == layout_id)
+    data = [w & 0x3FF for w in native.words(source / layout["blockdata_filepath"])]
+    live = {(n % layout["width"], n // layout["width"]): m for n, m in enumerate(data)}
+    paths = native.tileset_paths(source, layout["secondary_tileset"])
+    defs = native.words(paths["metatiles"])
+    image = Image.open(paths["tiles"])
+    count = (image.width // 8) * (image.height // 8)
+
+    def tiles_of(ids):
+        out = set()
+        for m in ids:
+            if m >= 640:
+                out |= {w & 0x3FF for w in defs[(m - 640) * 8:(m - 640) * 8 + 8] if w & 0x3FF >= 640}
+        return out
+
+    groups = {"kept landmark art": {live[o] for o in g.art.values()}}
+    groups.update({k: v(live) for k, v in (keep or {}).items()})
+    needed = tiles_of(set().union(*groups.values())) - set(range(1016, 1024))
+    referenced = tiles_of(range(640, 640 + len(defs) // 8))
+    drawn = tiles_of(set(live.values()))
+    return {
+        "secondary": layout["secondary_tileset"], "capacity": 1024 - 640, "doorScratch": "0x3F8-0x3FF (8)",
+        "sheetTiles": count, "referencedOnlyByUnusedDefinitions": len(referenced - drawn),
+        "freedByRebuild": len(drawn - needed), "neededAfterRebuild": len(needed), "freeAfterRebuild": 1016 - 640 - len(needed),
+        "onlyNeededBy": {k: len(tiles_of(v) - tiles_of(set().union(*(w for kk, w in groups.items() if kk != k)))) for k, v in groups.items()},
+    }
