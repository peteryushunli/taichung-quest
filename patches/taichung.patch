index 0000000..c1b9121
--- /dev/null
+++ b/data/taichung/landmarks/xitun-final-native/prepare_fengjia_scene.py
@@ -0,0 +1,295 @@
+#!/usr/bin/env python3
+"""Prepare a Fengjia-only native scene proposal, with no registered writes.
+
+The packed banks stay immutable. A separate secondary variant receives native
+ground/layer composition for Fengjia only; Maple templates remain untouched.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import struct
+import sys
+import tempfile
+
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+PROJECT = ROOT.parents[1]
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(ROOT / "tools/taichung/landmarks"))
+from check_old_core import Files, Bank, resolved_folder, load_native
+from analyze_theater_cohort import visible_cells, bounds
+
+BASE = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
+CITY = "c1bc28900f0ae46f9a15d74d4089317c66a28b00"
+PRIMARY = "data/tilesets/primary/taichung_xitun_private"
+PACKED = "data/tilesets/secondary/taichung_xitun_final"
+DATA = "data/taichung/landmarks/xitun-final-native"
+VARIANT = DATA+"/fengjia-only-bank"
+ARTIFACT_REL = "artifacts/worktrees/c291d4842985/landmark-art"
+ARTIFACT = PROJECT / ARTIFACT_REL
+MID = "MAP_TAICHUNG_XITUN"
+ORIGIN, RETIRED, DOOR = (19, 7), (19, 6, 29, 12), (24, 12)
+PAVING, DOOR_WORD = 0x3175, 0x043D
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def words(raw, kind="H"):
+    return list(struct.unpack("<"+str(len(raw)//struct.calcsize(kind))+kind, raw))
+
+
+def binary(values, kind="H"):
+    return struct.pack("<"+str(len(values))+kind, *values)
+
+
+def make_map(native, data, layout, cells, border, attributes):
+    m = native.Map.__new__(native.Map)
+    m.data, m.layout, m.id = data, layout, data["id"]
+    m.width, m.height = layout["width"], layout["height"]
+    m.cells, m.border, m.attributes = cells, border, attributes
+    m.actors = {(o["x"], o["y"]) for o in data.get("object_events", [])}
+    m.signs = {(o["x"], o["y"]) for o in data.get("bg_events", []) if o.get("type") == "sign"}
+    m.obstacles = m.actors | m.signs
+    return m
+
+
+def render_crop(bank, grid, width, box):
+    x0, y0, x1, y1 = box
+    image = Image.new("RGB", ((x1-x0)*16, (y1-y0)*16))
+    for y in range(y0, y1):
+        for x in range(x0, x1):
+            tile = Image.new("RGB", (16, 16))
+            tile.putdata(bank.render(grid[y*width+x] & 1023))
+            image.paste(tile, ((x-x0)*16, (y-y0)*16))
+    return image
+
+
+def prepare_scene(output=HERE, preview_output=ARTIFACT, verify_rebuild=True):
+    source_pack = json.loads((HERE / "pack-plan.json").read_text())
+    for path, expected in source_pack["outputFilesSha256"].items():
+        assert digest((ROOT / path).read_bytes()) == expected, "Frozen pack changed: "+path
+    pack_hash_before = digest((HERE / "pack-plan.json").read_bytes())
+    frozen, city = Files(ROOT, BASE), Files(ROOT, CITY)
+    layouts = {l["id"]: l for l in city.json("data/layouts/layouts.json")["layouts"] if "id" in l}
+    own_data = city.json("data/maps/TaichungXitun/map.json")
+    own_layout = layouts[own_data["layout"]]
+    source_map_path = own_layout["blockdata_filepath"]
+    source_raw = frozen.read(source_map_path)
+    assert city.read(source_map_path) == source_raw
+    original = words(source_raw)
+    width, height = own_layout["width"], own_layout["height"]
+    assert (width, height) == (40, 64)
+    primary, _ = resolved_folder(city, own_layout["primary_tileset"])
+    secondary, _ = resolved_folder(city, own_layout["secondary_tileset"])
+    old_bank = Bank(city, primary, secondary)
+    packed_bank = Bank(Files(ROOT), PRIMARY, PACKED)
+    landmark = next(item for item in source_pack["landmarks"] if item["id"] == "fengjia-night-market")
+    assert landmark["sizePixels"] == [160, 96] and landmark["occupiedCells"] == 46
+    art = Image.open(ROOT / landmark["input"])
+    assert digest((ROOT / landmark["input"]).read_bytes()) == landmark["inputSha256"]
+    definitions, attributes = list(packed_bank.defs[1]), list(packed_bank.attrs[1])
+    ground = original.copy()
+    x0, y0, x1, y1 = RETIRED
+    for y in range(y0, y1+1):
+        for x in range(x0, x1+1):
+            ground[y*width+x] = PAVING
+    proposal = ground.copy()
+    composed, overridden = [], None
+    for cell in landmark["cells"]:
+        lx, ly = cell["local"]
+        x, y = ORIGIN[0]+lx, ORIGIN[1]+ly
+        n, ground_id = cell["metatileId"], ground[y*width+x] & 1023
+        assert 879 <= n <= 924 and ground_id in (1, 0x175)
+        lower = old_bank.entries(ground_id)
+        assert lower[4:] == [0]*4
+        offset = (n-640)*8
+        assert definitions[offset:offset+4] == [0]*4
+        definitions[offset:offset+4] = lower[:4]
+        attributes[n-640] = 0x20000000 if ly == 5 else 0
+        proposal[y*width+x] = n | 0x400
+        composed.append({"local": [lx, ly], "global": [x, y], "metatileId": n,
+                         "groundMetatileId": ground_id, "attribute": attributes[n-640],
+                         "layerType": 1 if ly == 5 else 0, "collision": 1, "elevation": 0})
+        if (x, y) == DOOR:
+            overridden = {"local": [lx, ly], "global": [x, y], "unusedArtMetatileId": n,
+                          "sourcePanelPixelCount": 256, "sourcePanelOpaquePixels": 256,
+                          "sourcePanelIndices": sorted(set(art.crop((lx*16, ly*16, lx*16+16, ly*16+16)).get_flattened_data()))}
+    assert original[DOOR[1]*width+DOOR[0]] == DOOR_WORD
+    assert overridden and overridden["local"] == [5, 5]
+    proposal[DOOR[1]*width+DOOR[0]] = DOOR_WORD
+    variant = output / "fengjia-only-bank"
+    variant.mkdir(parents=True, exist_ok=True)
+    for name in ("tiles.png",):
+        shutil.copyfile(ROOT / PACKED / name, variant / name)
+    (variant / "palettes").mkdir(exist_ok=True)
+    for path in (ROOT / PACKED / "palettes").glob("*.pal"):
+        shutil.copyfile(path, variant / "palettes" / path.name)
+    (variant / "metatiles.bin").write_bytes(binary(definitions))
+    (variant / "metatile_attributes.bin").write_bytes(binary(attributes, "I"))
+    map_path = output / "fengjia-map.bin"
+    map_path.write_bytes(binary(proposal))
+    actual = Bank(Files(ROOT), PRIMARY, str(variant))
+    assert actual.defs[1][:239*8] == packed_bank.defs[1][:239*8]
+    assert actual.attrs[1][:239] == packed_bank.attrs[1][:239]
+    assert actual.defs[1][(925-640)*8:] == packed_bank.defs[1][(925-640)*8:]
+    assert actual.attrs[1][925-640:] == packed_bank.attrs[1][925-640:]
+    assert all(actual.render(n) == old_bank.render(n) and actual.attr(n) == old_bank.attr(n) for n in range(640, 879))
+    assert actual.entries(0x03D) == old_bank.entries(0x03D) and actual.attr(0x03D) == 0x20000069
+    # Run the existing city validator over frozen c1 interfaces, replacing only
+    # Xitun's grid/attributes with this unregistered proposal. All gyms are real
+    # frozen native source rooms, including their actors and three return warps.
+    native = load_native(ROOT)
+    assert (ROOT / "tools/taichung/validate_city.py").read_bytes() == city.read("tools/taichung/validate_city.py")
+    contract = city.json("docs/taichung-city-contract.json")
+    geometry = native.Validator.__new__(native.Validator)
+    geometry.source, geometry.contract, geometry.errors = ROOT, contract, []
+    geometry.maps, geometry.tilesets = {}, {}
+    geometry.district_ids = {d["map"] for d in contract["districts"]}
+    groups = city.json("data/maps/map_groups.json")
+    wanted = geometry.district_ids | {l["gymMap"] for l in contract["landmarks"]}
+    maps_by_id = {}
+    for group in groups["group_order"]:
+        for name in groups[group]:
+            # All Taichung maps are named together; unrelated ROM maps need not
+            # be materialized merely to perform these native geometry checks.
+            if not name.startswith("Taichung"):
+                continue
+            data = city.json(f"data/maps/{name}/map.json")
+            maps_by_id[data["id"]] = data
+    banks = {}
+    for mid in wanted:
+        data = maps_by_id[mid]
+        layout = layouts[data["layout"]]
+        p, _ = resolved_folder(city, layout["primary_tileset"])
+        s, _ = resolved_folder(city, layout["secondary_tileset"])
+        key = p, s
+        if key not in banks:
+            banks[key] = Bank(city, p, s)
+        bank = actual if mid == MID else banks[key]
+        cells = proposal if mid == MID else city.words(layout["blockdata_filepath"])
+        geometry.maps[mid] = make_map(native, data, layout, cells, city.words(layout["border_filepath"]), bank.attrs)
+    assert set(geometry.maps) == wanted
+    geometry.run()
+    assert not geometry.errors, geometry.errors
+    source_geometry = make_map(native, own_data, own_layout, original, city.words(own_layout["border_filepath"]), old_bank.attrs)
+    proposed_geometry = geometry.maps[MID]
+    delta, newly_blocked, newly_walkable = [], [], []
+    for i, (old_word, new_word) in enumerate(zip(original, proposal)):
+        x, y = i%width, i//width
+        if old_word == new_word:
+            assert old_bank.render(old_word & 1023) == actual.render(new_word & 1023)
+            assert old_bank.attr(old_word & 1023) == actual.attr(new_word & 1023)
+            continue
+        assert x0 <= x <= x1 and y0 <= y <= y1
+        was_walkable, now_walkable = source_geometry.walkable(x, y), proposed_geometry.walkable(x, y)
+        if was_walkable and not now_walkable:
+            newly_blocked.append([x, y])
+        if now_walkable and not was_walkable:
+            newly_walkable.append([x, y])
+        delta.append({"x": x, "y": y, "oldWord": old_word, "newWord": new_word,
+                      "oldMetatileId": old_word & 1023, "newMetatileId": new_word & 1023,
+                      "oldCollision": old_word >> 10 & 3, "newCollision": new_word >> 10 & 3,
+                      "oldElevation": old_word >> 12, "newElevation": new_word >> 12,
+                      "oldAttribute": old_bank.attr(old_word & 1023), "newAttribute": actual.attr(new_word & 1023),
+                      "oldBehavior": source_geometry.behavior(x, y), "newBehavior": proposed_geometry.behavior(x, y),
+                      "oldActorSignAwareWalkable": was_walkable, "newActorSignAwareWalkable": now_walkable})
+    for x, y in source_geometry.actors | source_geometry.signs | {(w["x"], w["y"]) for w in own_data["warp_events"]}:
+        assert proposal[y*width+x] == original[y*width+x]
+    strip_records, strip_count = [], 0
+    exterior_banks = {}
+    for mid in geometry.district_ids:
+        m = geometry.maps[mid]
+        p, _ = resolved_folder(city, m.layout["primary_tileset"])
+        s, _ = resolved_folder(city, m.layout["secondary_tileset"])
+        exterior_banks[mid] = actual if mid == MID else banks[p, s]
+    for mid in geometry.district_ids:
+        m = geometry.maps[mid]
+        for c in m.data["connections"]:
+            donor = geometry.maps[c["map"]]
+            points = list(visible_cells(m.layout, donor.layout, c["direction"], c["offset"]))
+            for x, y in points:
+                n = donor.cell(x, y) & 1023
+                assert exterior_banks[mid].entries(n) == exterior_banks[donor.id].entries(n)
+                assert exterior_banks[mid].attr(n) == exterior_banks[donor.id].attr(n)
+                assert exterior_banks[mid].render(n) == exterior_banks[donor.id].render(n)
+                if donor.id == MID:
+                    assert proposal[y*width+x] == original[y*width+x]
+            strip_count += len(points)
+            strip_records.append({"viewer": mid, "donor": donor.id, "cells": len(points),
+                                  "donorBoundsInclusive": bounds(points), "mapWordsEntriesRgbAttributesEqual": True})
+    assert strip_count == 1530
+    preview_output.mkdir(parents=True, exist_ok=True)
+    scene_box, door_box = (17, 4, 31, 17), (22, 10, 27, 15)
+    render_crop(actual, proposal, width, scene_box).resize((896, 832), Image.Resampling.NEAREST).save(preview_output / "fengjia-only-source.png")
+    render_crop(actual, proposal, width, door_box).resize((320, 320), Image.Resampling.NEAREST).save(preview_output / "fengjia-native-door-source.png")
+    routes = []
+    for l in contract["landmarks"]:
+        routes.append({"id": l["id"], "approach": l["approach"], "arrival": l["arrival"],
+                       "approachSteps": geometry.distances[(l["exteriorMap"], l["approach"]["x"], l["approach"]["y"])],
+                       "arrivalSteps": geometry.distances[(l["exteriorMap"], l["arrival"]["x"], l["arrival"]["y"])],
+                       "threeInteriorReturnsValidated": True})
+    report = {
+        "schemaVersion": 1, "landmarkId": "fengjia-night-market",
+        "status": "Fengjia-only source scene proposal; not installed or runtime verified",
+        "geometryBaselineCommit": BASE, "connectedCitySnapshotIncludingCmp": CITY,
+        "primaryFolder": PRIMARY, "secondaryVariantFolder": VARIANT, "mapFile": DATA+"/fengjia-map.bin",
+        "sourceMapFile": source_map_path, "sourceMapSha256": digest(source_raw), "mapSha256": digest(map_path.read_bytes()),
+        "sourcePackPlanSha256": pack_hash_before, "origin": list(ORIGIN), "sizeMetatiles": [10, 6],
+        "retiredInclusive": list(RETIRED), "retiredGroundWord": PAVING,
+        "artCells": composed, "occupiedArtCells": len(composed), "activeArtCellsAfterNativeDoorOverride": len(composed)-1,
+        "groundComposition": "General grass/paving lower quarters from frozen Xitun; this retired envelope resolves entirely to paving373",
+        "allOccupiedCellsCollision1": True, "bottomRowLayerType": 1, "bottomRowAttribute": 0x20000000,
+        "door": {"global": list(DOOR), "word": DOOR_WORD, "behavior": 0x69, "attribute": actual.attr(0x03D),
+                 "approach": [24, 13], "arrival": [24, 15], "overriddenRasterCell": overridden,
+                 "adaptation": "One opaque dark raster cell is replaced by the existing General animated gym door. Every other occupied lane cell remains solid; this is not a through-market lane.",
+                 "sourceNativeDoorGraphicsAndBehaviorExact": True, "nativeGameplayApprovalOrRuntimeClaim": False},
+        "delta": {"changedCells": len(delta), "cells": delta, "newlyBlockedCount": len(newly_blocked),
+                  "newlyBlocked": newly_blocked, "newlyWalkableCount": len(newly_walkable), "newlyWalkable": newly_walkable,
+                  "allChangesInsideRetiredRectangle": True, "everyUnchangedWordRgbAndAttributeExact": True},
+        "proof": {"all239LegacyDefinitionRendersAndAttributesExact": True,
+                  "mapleTemplateDefsAndAttributesUntouched": True, "maplePathsOrCollisionAuthored": False,
+                  "allOtherXitunMapWordsUnchanged": True, "allWarpsSignsActorsAndHabitatsValidated": True,
+                  "currentNativeValidatorErrors": geometry.errors, "all10LandmarkRoutesAnd30InteriorReturnsPass": True,
+                  "landmarkRoutes": routes, "openSeamCrossings": len(geometry.open_edges),
+                  "reachableExteriorCells": len(geometry.distances), "connectedStripWordsChecked": strip_count,
+                  "connectionProof": sorted(strip_records, key=lambda x: (x["viewer"], x["donor"]))},
+        "preview": {"sceneRelativeToProject": ARTIFACT_REL+"/fengjia-only-source.png", "sceneCropExclusive": list(scene_box),
+                    "doorRelativeToProject": ARTIFACT_REL+"/fengjia-native-door-source.png", "doorCropExclusive": list(door_box),
+                    "scale": 4, "method": "Actual proposed map words plus saved native banks; nearest4x RGB rendering, no actor/UI/VRAM simulation"},
+        "sourceInputsSha256": {path: digest(raw) for path, raw in sorted(city.cache.items())},
+        "originalPackedBankFilesUnchanged": True, "registeredSourceOrCOrUiWritten": False,
+        "nativeReady": False, "mapInstalled": False, "runtimeVerified": False,
+    }
+    assert digest((HERE / "pack-plan.json").read_bytes()) == pack_hash_before
+    assert all(digest((ROOT / path).read_bytes()) == expected for path, expected in source_pack["outputFilesSha256"].items())
+    report["outputSha256"] = {str(p.relative_to(output)): digest(p.read_bytes()) for p in sorted(variant.rglob("*")) if p.is_file()}
+    report["outputSha256"]["fengjia-map.bin"] = digest(map_path.read_bytes())
+    report["previewSha256"] = {name: digest((preview_output / name).read_bytes()) for name in ("fengjia-only-source.png", "fengjia-native-door-source.png")}
+    (output / "fengjia-placement.json").write_text(json.dumps(report, indent=2)+"\n")
+    if verify_rebuild:
+        with tempfile.TemporaryDirectory(prefix="fengjia-scene-") as folder:
+            temp = Path(folder)
+            again = prepare_scene(temp / "data", temp / "preview", verify_rebuild=False)
+            assert again == report
+            for path in report["outputSha256"]:
+                assert (temp / "data" / path).read_bytes() == (output / path).read_bytes()
+            for name in report["previewSha256"]:
+                assert (temp / "preview" / name).read_bytes() == (preview_output / name).read_bytes()
+        report["proof"]["deterministicRebuildPass"] = True
+        (output / "fengjia-placement.json").write_text(json.dumps(report, indent=2)+"\n")
+    return report
+
+
+if __name__ == "__main__":
+    result = prepare_scene()
+    print(json.dumps({"map": result["mapFile"], "secondary": result["secondaryVariantFolder"],
+                      "changedCells": result["delta"]["changedCells"], "newlyBlocked": result["delta"]["newlyBlockedCount"],
+                      "newlyWalkable": result["delta"]["newlyWalkableCount"], "routesPass": result["proof"]["all10LandmarkRoutesAnd30InteriorReturnsPass"],
+                      "preview": result["preview"], "deterministic": result["proof"].get("deterministicRebuildPass")}, indent=2))
diff --git a/data/taichung/minimap-contract.json b/data/taichung/minimap-contract.json
new file mode 100644
index 0000000..f030706
--- /dev/null
+++ b/data/taichung/minimap-contract.json
@@ -0,0 +1,958 @@
+{
+  "schemaVersion": 1,
+  "contractId": "taichung-current-native-minimap",
+  "status": "source-registered baseline geometry; Main must bind to the exact built ROM",
+  "coordinateSystem": {
+    "units": "metatiles",
+    "metatilePixels": 16,
+    "origin": "zero-based unbuffered map-local tile",
+    "x": "right",
+    "y": "down",
+    "northUp": true,
+    "nativeLocalSource": "gSaveBlock1Ptr->pos; object-event virtual coordinates require subtracting MAP_OFFSET before use",
