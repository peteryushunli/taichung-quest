diff --git a/include/taichung_language_bridge.h b/include/taichung_language_bridge.h
new file mode 100644
index 0000000..8124fe6
--- /dev/null
+++ b/include/taichung_language_bridge.h
@@ -0,0 +1,52 @@
+#ifndef GUARD_TAICHUNG_LANGUAGE_BRIDGE_H
+#define GUARD_TAICHUNG_LANGUAGE_BRIDGE_H
+
+#include "gba/types.h"
+
+// Little-endian bytes "TCLANG01". This packet is volatile EWRAM, never SRAM.
+#define TAICHUNG_LANGUAGE_BRIDGE_MAGIC_A 0x414C4354
+#define TAICHUNG_LANGUAGE_BRIDGE_MAGIC_B 0x3130474E
+#define TAICHUNG_LANGUAGE_BRIDGE_VERSION 1
+#define TAICHUNG_LANGUAGE_BRIDGE_SIZE 32
+
+#define TAICHUNG_LANGUAGE_BRIDGE_READY 1
+#define TAICHUNG_LANGUAGE_BRIDGE_SAFE_FIELD 2
+
+#define TAICHUNG_LANGUAGE_BRIDGE_NONE 0
+#define TAICHUNG_LANGUAGE_BRIDGE_APPLIED 1
+#define TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON 2
+#define TAICHUNG_LANGUAGE_BRIDGE_UNSET 3
+#define TAICHUNG_LANGUAGE_BRIDGE_INVALID 4
+
+struct TaichungLanguageBridge
+{
+    /* 0x00 */ u32 magicA;
+    /* 0x04 */ u32 magicB;
+    /* 0x08 */ u16 version;
+    /* 0x0A */ u16 size;
+    /* 0x0C */ u32 selfGbaAddress;
+    /* 0x10 */ u32 frameCounter;
+    /* 0x14 */ u8 activeLanguage; // 0 unset, 1 English, 2 Traditional Chinese
+    /* 0x15 */ u8 requestedLanguage; // Browser owns this byte and requestSequence only.
+    /* 0x16 */ u8 flags;
+    /* 0x17 */ u8 result;
+    /* 0x18 */ u32 requestSequence;
+    /* 0x1C */ u32 ackSequence;
+};
+
+extern volatile struct TaichungLanguageBridge gTaichungLanguageBridge;
+
+void TaichungLanguageBridge_Tick(bool8 gameCallbacksRan);
+void TaichungLanguageBridge_OnNativeChoice(u16 language);
+
+// Shared by the native adapter and host protocol checks. The writer must return
+// success only after committing the language variable. An acknowledgement is
+// published last, so it never promises a change that has not happened yet.
+typedef bool8 (*TaichungLanguageBridgeWriter)(u8 language);
+void TaichungLanguageBridge_UpdatePacket(volatile struct TaichungLanguageBridge *packet,
+                                       u32 selfGbaAddress, u8 nativeLanguage,
+                                       bool8 variablesReady, bool8 safeField,
+                                       TaichungLanguageBridgeWriter writer);
+void TaichungLanguageBridge_PublishNativeChoice(volatile struct TaichungLanguageBridge *packet, u16 language);
+
+#endif
diff --git a/include/taichung_navigation_bridge.h b/include/taichung_navigation_bridge.h
new file mode 100644
index 0000000..b3a9a3c
--- /dev/null
+++ b/include/taichung_navigation_bridge.h
@@ -0,0 +1,61 @@
+#ifndef GUARD_TAICHUNG_NAVIGATION_BRIDGE_H
+#define GUARD_TAICHUNG_NAVIGATION_BRIDGE_H
+
+#include "gba/types.h"
+
+// Little-endian bytes "TCNAV001". Native publishes; the browser only reads.
+#define TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A 0x414E4354
+#define TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B 0x31303056
+#define TAICHUNG_NAVIGATION_BRIDGE_VERSION 1
+#define TAICHUNG_NAVIGATION_BRIDGE_SIZE 48
+
+#define TAICHUNG_NAVIGATION_READY          (1 << 0)
+#define TAICHUNG_NAVIGATION_FIELD          (1 << 1)
+#define TAICHUNG_NAVIGATION_POSITION_VALID (1 << 2)
+#define TAICHUNG_NAVIGATION_OUTDOOR        (1 << 3)
+#define TAICHUNG_NAVIGATION_INDOOR         (1 << 4)
+#define TAICHUNG_NAVIGATION_CYCLING         (1 << 5)
+#define TAICHUNG_NAVIGATION_CAN_TOGGLE_BIKE (1 << 6)
+
+#define TAICHUNG_NAVIGATION_CONTEXT_CALLBACKS_SKIPPED (1 << 0)
+#define TAICHUNG_NAVIGATION_CONTEXT_NOT_FIELD         (1 << 1)
+#define TAICHUNG_NAVIGATION_CONTEXT_BATTLE            (1 << 2)
+#define TAICHUNG_NAVIGATION_CONTEXT_TRANSITION        (1 << 3)
+#define TAICHUNG_NAVIGATION_CONTEXT_SCRIPT            (1 << 4)
+#define TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE          (1 << 5)
+#define TAICHUNG_NAVIGATION_CONTEXT_LINK              (1 << 6)
+#define TAICHUNG_NAVIGATION_CONTEXT_REPLAY            (1 << 7)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE      (1 << 8)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR    (1 << 9)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION  (1 << 10)
+#define TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP       (1 << 11)
+
+struct TaichungNavigationBridge
+{
+    /* 0x00 */ u32 magicA;
+    /* 0x04 */ u32 magicB;
+    /* 0x08 */ u16 version;
+    /* 0x0A */ u16 size;
+    /* 0x0C */ u32 selfGbaAddress;
+    /* 0x10 */ u32 sequence;     // Odd during publication; stable, nonzero even afterward.
+    /* 0x14 */ u32 frameCounter; // Advances every Tick, including hidden contexts.
+    /* 0x18 */ u32 flags;
+    /* 0x1C */ s16 localX;       // Zero-based destination metatile; -1 when invalid.
+    /* 0x1E */ s16 localY;
+    /* 0x20 */ u8 mapGroup;      // Native saved map IDs; 0xFF when invalid.
+    /* 0x21 */ u8 mapNum;
+    /* 0x22 */ u8 facing;        // 0 unknown; 1 south, 2 north, 3 west, 4 east.
+    /* 0x23 */ u8 mapType;       // Native MAP_TYPE_*; 0 when invalid.
+    /* 0x24 */ u16 mapWidth;     // Local layout dimensions in 16-pixel metatiles.
+    /* 0x26 */ u16 mapHeight;
+    /* 0x28 */ u16 contextFlags; // Nonzero: hide/suspend the live minimap.
+    /* 0x2A */ u16 reserved16;
+    /* 0x2C */ u32 reserved32;
+};
+
+extern volatile struct TaichungNavigationBridge gTaichungNavigationBridge;
+
+// Call once per main loop after game callbacks, next to the language Tick.
+void TaichungNavigationBridge_Tick(bool8 gameCallbacksRan);
+
+#endif
