+u16 VarGet(u16 id) { (void)id; assert(0); return 0; }
+bool8 VarSet(u16 id, u16 value) { sSave.vars[id - 0x4000] = value; return TRUE; }
+
+int main(void)
+{
+    volatile struct TaichungEncounterBridge *p = &gTaichungEncounterBridge;
+    u32 begin;
+    const u16 site = TAICHUNG_ENCOUNTER_THE_LIN;
+    const struct TaichungEncounterSite *profile = TaichungEncounterGetSite(site);
+    const u32 mask = 1u << site;
+    assert(TaichungEncounterInitSaveState());
+    TaichungEncounterBridge_Tick(FALSE);
+    assert(p->magicA == TAICHUNG_ENCOUNTER_BRIDGE_MAGIC_A && p->magicB == TAICHUNG_ENCOUNTER_BRIDGE_MAGIC_B);
+    assert(p->version == 2 && p->size == 72 && p->publication && !(p->publication & 1));
+    assert(!p->frameCounter && !p->saveStatus && !TaichungEncounterBridgeAcked());
+    sSave2.playerTrainerId[0] = 0x12; sSave2.playerTrainerId[1] = 0x34;
+    sSave2.playerTrainerId[2] = 0x56; sSave2.playerTrainerId[3] = 0x78;
+    assert(TaichungEncounterBegin(site)); begin = TaichungEncounterGetSequence();
+    TaichungEncounterBridge_Tick(TRUE);
+    assert(p->trainerId == 0x78563412 && p->attempts == mask && !p->unlocks && p->site == site && p->species == profile->species);
+    assert(p->phase == TAICHUNG_ENCOUNTER_PHASE_SAVE_BEGIN && !p->saveStatus && p->balls == 3);
+    assert(!TaichungEncounterBridgeAcked());
+    // Native save success alone is not a browser acknowledgement.
+    gSaveCounter = 19; TaichungEncounterBridgeSaved(); TaichungEncounterBridge_Tick(TRUE);
+    assert(p->saveCounter == 19 && p->saveStatus == TAICHUNG_ENCOUNTER_SAVE_FLASH_OK);
+    assert(!TaichungEncounterBridgeAcked());
+    p->ackStatus = TAICHUNG_ENCOUNTER_ACK_DURABLE;
+    p->ackAttempts = mask; p->ackUnlocks = 0; p->ackSaveCounter = 19;
+    assert(!TaichungEncounterBridgeAcked()); // Commit sequence must be written last.
+    p->ackSequence = begin + 1; assert(!TaichungEncounterBridgeAcked());
+    p->ackSequence = begin; p->ackSaveCounter = 18; assert(!TaichungEncounterBridgeAcked());
+    p->ackSaveCounter = 19; p->ackAttempts = 0; assert(!TaichungEncounterBridgeAcked());
+    p->ackAttempts = mask; p->ackUnlocks = mask; assert(!TaichungEncounterBridgeAcked());
+    p->ackUnlocks = 0; assert(TaichungEncounterBridgeAcked());
+    assert(TaichungEncounterAcknowledge(begin, mask, 0));
+    assert(TaichungEncounterOnBattleStart(profile->species, profile->level));
+    assert(TaichungEncounterTakeBall() && TaichungEncounterRecordCapture(profile->species));
+    assert(TaichungEncounterOnBattleEnd(profile->species, B_OUTCOME_CAUGHT));
+    TaichungEncounterBridge_Tick(TRUE);
+    assert(!TaichungEncounterBridgeAcked() && !p->saveStatus); // Begin ACK cannot commit result.
+    gSaveCounter = 20; TaichungEncounterBridgeSaved(); TaichungEncounterBridge_Tick(TRUE);
+    assert(p->phase == TAICHUNG_ENCOUNTER_PHASE_SAVE_RESULT && p->unlocks == mask && p->ackSequence == 0);
+    p->ackSequence = p->requestSequence; p->ackStatus = TAICHUNG_ENCOUNTER_ACK_FAILED;
+    assert(TaichungEncounterBridgeFailed() && !TaichungEncounterBridgeAcked());
+    p->ackStatus = TAICHUNG_ENCOUNTER_ACK_DURABLE; p->ackSaveCounter = 20;
+    assert(!TaichungEncounterBridgeAcked());
+    p->ackUnlocks = mask; assert(TaichungEncounterBridgeAcked());
+    assert(TaichungEncounterAcknowledge(p->requestSequence, mask, mask));
+    TaichungEncounterBridge_Tick(TRUE);
+    assert(p->phase == TAICHUNG_ENCOUNTER_PHASE_DONE && !(p->publication & 1));
+    TaichungEncounterResetSession(); assert(!TaichungEncounterBegin(site));
+    gSaveBlock2Ptr = NULL; TaichungEncounterBridge_Tick(TRUE); assert(p->trainerId == 0);
+    puts("PASS: 72-byte bridge and highest site across begin and result saves, with stale and incomplete ACK rejection");
+}
