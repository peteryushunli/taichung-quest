+#!/usr/bin/env python3
+"""Current actual-C release checks and exact prepatch startup regression."""
+import argparse
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).resolve().parents[2]
+OUT=ROOT/"build/taichung-tests/capture-release"
+OUT.mkdir(parents=True,exist_ok=True)
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--previous-guard-tests",action="store_true")
+args=parser.parse_args()
+spec=importlib.util.spec_from_file_location("current_capture_release",ROOT/"tools/taichung/capture_release_guard.py")
+release=importlib.util.module_from_spec(spec);spec.loader.exec_module(release)
+read=release.reader(ROOT);release.verified(read)
+env=dict(os.environ,PYTHONDONTWRITEBYTECODE="1")
+env["PATH"]=str(Path(sys.executable).parent)+os.pathsep+env.get("PATH","")
+
+def run(name,command):
+    result=subprocess.run(command,cwd=ROOT,env=env,capture_output=True,text=True)
+    (OUT/(name+".log")).write_text(result.stdout+result.stderr)
+    if result.returncode:raise RuntimeError(name+" failed:\n"+(result.stdout+result.stderr)[-6000:])
+    print("PASS: "+name,flush=True)
+
+if args.previous_guard_tests:
+    before=release.peel(read);absent=release.hidden(read)
+    for name in ("encounter_field_fix_guard","encounter_save_init_guard","capture_gameplay_guard"):
+        inputs=before
+        if name=="capture_gameplay_guard":
+            spec=importlib.util.spec_from_file_location("prior_field_fix",ROOT/"tools/taichung/encounter_field_fix_guard.py")
+            field=importlib.util.module_from_spec(spec);spec.loader.exec_module(field)
+            capture_read=lambda p:before[p]if p in before else read(p)
+            inputs={**before,**field.peel(capture_read)}
+        with release.mirror(ROOT,inputs,absent) as view:
+            run("prior-"+name,[sys.executable,"-B",str(view/"tools/taichung"/(name+".py")),"--source",str(view),"--self-test"])
+    sys.exit(0)
+
+run("current-save",[sys.executable,"-B","tools/taichung_gameplay/test-encounter-save.py"])
+include=ROOT/"build/taichung-tests/encounter-save/include"
+env["CPATH"]=str(include)+(os.pathsep+env["CPATH"]if env.get("CPATH")else"")
+for name,command in (
+    ("locked-menu",[sys.executable,"-B","tools/taichung_gameplay/test-locked-menu.py","--prove-regression"]),
+    ("bindings",[sys.executable,"-B","tools/taichung_gameplay/test-existing-encounter-bindings.py","--self-test"]),
+    ("field",["bash","tools/taichung_gameplay/test-encounter-field.sh"]),
+    ("team",["bash","tools/taichung_gameplay/test-team.sh"]),
+    ("facing",[sys.executable,"-B","tools/taichung_gameplay/test-save-facing.py","--prove-regression"]),
+):run(name,command)
+
+# Compile the exact reviewed pre-startup-policy SaveC against the new tests and
+# same real Gameplay initializer. Only the new expected startup case must fail.
+record=release.load(read);stored=release.bundle(read,record)
+prior=OUT/"save-before-startup.c";prior.write_bytes(stored["before/"+release.SAVE])
+binary=OUT/"startup-before"
+flags=["cc","-std=c99","-O2","-Wall","-Wextra","-Werror",
+       "-I"+str(ROOT/"tests/save_host"),"-I"+str(include),"-I"+str(ROOT/"include"),"-I"+str(ROOT/"src")]
+subprocess.run(flags+[str(prior),str(ROOT/"src/taichung_encounter.c"),str(ROOT/"tests/taichung_encounter_save_test.c"),
+                     str(ROOT/"build/taichung-tests/encounter-save/baseline-save.o"),"-o",str(binary)],check=True,env=env)
+broken=subprocess.run([str(binary)],capture_output=True,env=env)
+assert broken.returncode!=0 and b"sEncounterWrites == attemptedWrites"in broken.stderr
+(OUT/"startup-before.stderr").write_bytes(broken.stderr)
+print("PASS: exact Main21633 SaveC fails only the required new startup initialization expectation",flush=True)
