+            elif args=='TaichungStory_ScriptHasLeaderPackage':
+                assert caller in LEADER_HISTORY;select(LEADER_HISTORY[caller]);variables['VAR_RESULT']=1
+            elif args=='TaichungStory_ScriptHasGarden':variables['VAR_RESULT']=int(variables['VAR_0x8006']==3)
+            elif args in ('TaichungStory_ScriptBufferSign','TaichungStory_ScriptBufferAbout','TaichungStory_ScriptBufferStaff','TaichungStory_ScriptBufferGarden','TaichungStory_ScriptBufferStaffCredit'):
+                pending={'TaichungStory_ScriptBufferSign':'sign','TaichungStory_ScriptBufferAbout':'about','TaichungStory_ScriptBufferStaff':'staff','TaichungStory_ScriptBufferGarden':'garden','TaichungStory_ScriptBufferStaffCredit':'credit'}[args]
+                if pending!='sign':assert any(e.startswith('menu:') for e in events),'long text before optional choice'
+                assert variables['VAR_0x8006']==expected,(entry,'wrong text selection')
+            elif args=='TaichungStory_ScriptRestoreQuestion':
+                assert caller==LEADERS[entry][0] and variables['VAR_0x8006']==expected
+                assert variables['VAR_0x8005']==value('TAICHUNG_GYM_MESSAGE_OFFER')
+                pending='offer';events.append('restore-question')
+            elif args=='TaichungGym_ScriptIsComplete':variables['VAR_RESULT']=int(complete)
+            elif args=='TaichungHistory_ScriptHasFacts':variables['VAR_RESULT']=int(caller!=8)
+            elif args=='TaichungHistory_ScriptBufferTour':pending='legacy-history'
+            elif re.fullmatch(r'TaichungGym_ScriptConsume\w+LossNotice',args):variables['VAR_RESULT']=0
+            elif re.fullmatch(r'TaichungGym_ScriptGet\w+Message',args):pending='offer' if variables.get('VAR_0x8005')==value('TAICHUNG_GYM_MESSAGE_OFFER') else None
+            elif args=='TaichungGym_ScriptPrepareChallenge':
+                assert chosen_challenge and not complete and not replay
+                assert caller==LEADERS[entry][0],('wrong native gym ID',entry,caller)
+                events.append('prepare');variables['VAR_RESULT']=int(available)
+            elif args=='TaichungGym_ScriptCancelChallenge':events.append('cancel')
+            elif args=='TaichungEncounter_ScriptOffer':
+                assert chosen_encounter and not replay and role=='site',('unexpected encounter entry',entry)
+                assert caller==variables['VAR_0x8007']==SITES[expected],('wrong capture wrapper/site',entry,caller)
+                events.append('encounter:'+str(caller));return finish()
+            else:raise AssertionError(args)
+        elif op=='trainerbattle_single':events.append('battle');return finish()
+        else:raise AssertionError(instruction)
+    raise AssertionError(('nonterminating route',entry,events))
+
+
+NAMESPACES=((0,0,0),(0xEC01,0,0),(0xEC01,3,2),(0xEC01,0x3FFF,0x3FFF),(0xEC01,0x8001,0x4002),(0xDEAD,0x8002,0x4001),(0,3,2))
+count=0
+for entry,(gym,history) in LEADERS.items():
