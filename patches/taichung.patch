+    {MAP_GROUP(MAP_TAICHUNG_NANTUN_NORTH), MAP_NUM(MAP_TAICHUNG_NANTUN_NORTH), 5, 0, sNantunNorthV10Relocations, sizeof(sNantunNorthV10Relocations) / sizeof(sNantunNorthV10Relocations[0])},
