+"""Export Wenyi's native assets from preserved imagegen sources.
+
+Only alpha/fit/index/palette/tile formatting is performed. Runtime registration,
+map bindings, source artwork and saved state are not modified.
+"""
+from pathlib import Path
+from PIL import Image
+import argparse
+import json
+import struct
+
+PROJECT = Path(__file__).resolve().parents[2]
+ROOT = PROJECT / 'graphics/taichung/characters/wenyi'
+VERSION = 'v1'
+SOURCE_VERSION = 'v1'
+PLAYER_FIELD_PALETTE = [0,0,0,24,16,32,64,48,64,40,48,88,64,72,112,88,88,104,88,144,184,144,184,224,248,232,208,248,192,144,208,144,112,248,96,88,184,64,64,128,48,56,120,136,152,248,240,224]
+
+
+def index_image(rgba, palette_override=None):
+    rgb = rgba.convert('RGB')
+    alpha = list(rgba.getchannel('A').get_flattened_data())
+    pixels = [p for p,a in zip(rgb.get_flattened_data(),alpha) if a >= 128]
+    sample = Image.new('RGB',(len(pixels),1))
+    sample.putdata(pixels)
+    if palette_override is None:
+        colors = sample.quantize(colors=15,method=Image.Quantize.MEDIANCUT,dither=Image.Dither.NONE)
+    else:
+        colors = Image.new('P',(1,1))
+        colors.putpalette(palette_override[3:48])
+    opaque = rgb.quantize(palette=colors,dither=Image.Dither.NONE)
+    palette = [0, 0, 0] + colors.getpalette()[:45]
+    palette = [(v >> 3) << 3 for v in palette]
+    out = Image.new('P', rgba.size, 0)
+    out.putpalette(palette)
+    out.putdata([i + 1 if a >= 128 else 0 for i, a in zip(opaque.get_flattened_data(), rgba.getchannel('A').get_flattened_data())])
+    out.info['transparency'] = 0
+    return out
+
+
+def pack_tiles(image):
+    raw = bytearray()
+    for ty in range(0, image.height, 8):
+        for tx in range(0, image.width, 8):
+            for y in range(8):
+                for x in range(0, 8, 2):
+                    raw.append(image.getpixel((tx+x, ty+y)) | image.getpixel((tx+x+1, ty+y)) << 4)
+    return bytes(raw)
+
+
+def save_native(image, stem, frames=1, frame_size=(16,32), vertical=False):
+    image.save(ROOT / (stem+'.png'), bits=4, transparency=0)
+    palette = image.getpalette()[:48]
+    (ROOT / (stem+'.pal')).write_bytes(('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,palette[i:i+3])) for i in range(0,48,3))+'\r\n').encode())
+    (ROOT / (stem+'.gbapal')).write_bytes(b''.join(struct.pack('<H', (palette[i]>>3)|((palette[i+1]>>3)<<5)|((palette[i+2]>>3)<<10)) for i in range(0,48,3)))
+    if frames == 1:
+        raw = pack_tiles(image)
+    else:
+        fw,fh=frame_size
+        raw = b''.join(pack_tiles(image.crop((0,i*fh,fw,(i+1)*fh) if vertical else (i*fw,0,(i+1)*fw,fh))) for i in range(frames))
+    (ROOT / (stem+'.4bpp')).write_bytes(raw)
+    image.convert('RGBA').resize((image.width*6,image.height*6),Image.Resampling.NEAREST).save(ROOT / (stem+'-preview-6x.png'))
+    return {'path':str((ROOT/(stem+'.png')).relative_to(PROJECT)), 'version':VERSION, 'paletteSource':'opaque pixels only', 'size':list(image.size), 'mode':image.mode, 'paletteEntries':16, 'usedIndices':len(image.getcolors()), 'transparentIndex':0, 'alphaValues':[0,255], 'tileBytes':len(raw), 'gbaPaletteBytes':32, 'frames':frames, 'status':'format-checked; visual review candidate; no emulator integration yet'}
+
+
+def battle():
+    source = Image.open(ROOT/'source/battle-generated-v1.png').convert('RGBA')
+    box = source.getchannel('A').point(lambda x:255 if x>=128 else 0).getbbox()
+    crop = source.crop(box)
+    ratio = min(58/crop.width,60/crop.height)
+    scaled = crop.resize((round(crop.width*ratio),round(crop.height*ratio)),Image.Resampling.NEAREST)
+    canvas = Image.new('RGBA',(64,64),(0,0,0,0))
+    canvas.paste(scaled,((64-scaled.width)//2,62-scaled.height))
+    return save_native(index_image(canvas),'battle-'+VERSION)
+
+
+def overworld():
+    source = Image.open(ROOT/'source/overworld-generated-v1.png').convert('RGBA')
+    cells = []
+    boxes = []
+    for row in range(3):
+        for col in range(3):
+            cell=source.crop((round(col*source.width/3),round(row*source.height/3),round((col+1)*source.width/3),round((row+1)*source.height/3)))
+            box=cell.getchannel('A').point(lambda x:255 if x>=128 else 0).getbbox()
+            if box is None: raise ValueError('Missing overworld frame')
+            cells.append(cell.crop(box));boxes.append(box)
+    ratio=min(14/max(c.width for c in cells),28/max(c.height for c in cells))
+    frame_count=9 if ROOT.name.startswith('player-classic') else 10
+    strip=Image.new('RGBA',(16*frame_count,32),(0,0,0,0))
+    # Native standard animation: south,north,west,south A/B,north A/B,west A/B.
+    order=[0,3,6,1,2,4,5,7,8]+([0] if frame_count==10 else [])
+    for i,index in enumerate(order):
+        frame=cells[index].resize((max(1,round(cells[index].width*ratio)),max(1,round(cells[index].height*ratio))),Image.Resampling.NEAREST)
+        strip.paste(frame,(16*i+(16-frame.width)//2,30-frame.height))
+    result=save_native(index_image(strip,palette_override=[0,0,0,32,24,40,64,40,48,96,64,64,136,96,104,248,200,144,208,152,112,248,240,208,192,176,144,184,72,72,136,48,56,248,200,88,40,64,72,56,96,104,24,40,48,72,48,56]),'overworld-'+VERSION,frames=frame_count)
+    result['sourceGrid']='rows south/north/west; columns idle/step A/step B'
+    result['nativeFrameOrder']=order
+    result['eastFacing']='native horizontal flip of west frames'
+    result['nativeReference']='red_normal.png: 144x32, nine walking frames' if frame_count==9 else 'woman_1.png: 160x32 indexed; sAnimTable_Standard uses frames 0..8'
+    indexed=Image.open(ROOT/('overworld-'+VERSION+'.png')).convert('RGBA')
+    animation=[]
+    for step in range(4):
+        canvas=Image.new('RGBA',(80,32),(246,238,220,255))
+        for col,sequence in enumerate([[3,0,4,0],[5,1,6,1],[7,2,8,2],[7,2,8,2]]):
+            k=sequence[step]
+            frame=indexed.crop((k*16,0,(k+1)*16,32))
+            if col==3: frame=frame.transpose(Image.Transpose.FLIP_LEFT_RIGHT)
+            canvas.alpha_composite(frame,(col*20+2,0))
+        animation.append(canvas.resize((640,256),Image.Resampling.NEAREST).convert('RGB'))
+    animation[0].save(ROOT/('overworld-walk-preview-'+VERSION+'.gif'),save_all=True,append_images=animation[1:],duration=180,loop=0)
+    return result
+
+
+if __name__ == "__main__":
+    report = {"battle.v1": battle(), "overworld.v1": overworld()}
+    (ROOT / "asset-validation.json").write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
