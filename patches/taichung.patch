+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+install = load("xitun_rework_install", HERE / "install_xitun.py")
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def spans(values):
+    """'6, 11, 15-37' for [6, 11, 15, 16, ..., 37]."""
+    runs = []
+    for v in values:
+        if runs and v == runs[-1][1] + 1:
+            runs[-1][1] = v
+        else:
+            runs.append([v, v])
+    return ", ".join(str(a) if a == b else f"{a}-{b}" for a, b in runs)
+
+
+def base_entries(base):
+    """Xitun's BASE entries in the three shared files."""
+    contract = base.json(install.CONTRACT)
+    district = next(d for d in contract["districts"] if d["map"] == install.MID)
+    landmarks = {l["id"]: l for l in contract["landmarks"] if l["exteriorMap"] == install.MID}
+    habitats = [h for h in contract.get("habitatRegions", []) if h["map"] == install.MID]
+    layout = next(l for l in base.json(install.LAYOUTS)["layouts"] if l.get("id") == install.LAYOUT_ID)
+    return layout, (district, landmarks, habitats)
+
+
+def built_entries(files, base):
+    """True when Xitun's entries in the tree's shared files are the installer's."""
+    layouts = {l["id"]: l for l in files.json(install.LAYOUTS)["layouts"] if l.get("id")}
+    contract = files.json(install.CONTRACT)
+    district, landmarks, habitats = install.contract_entries(base.json(install.CONTRACT))
+    tables = [e for g in files.json(install.ENCOUNTERS)["wild_encounter_groups"] for e in g["encounters"] if e["map"] == install.MID]
+    return (layouts.get(install.LAYOUT_ID) == install.layout_entry(base.json(install.LAYOUTS))
+            and next((d for d in contract["districts"] if d["map"] == install.MID), None) == district
+            and {l["id"]: l for l in contract["landmarks"] if l["exteriorMap"] == install.MID} == landmarks
+            and [h for h in contract.get("habitatRegions", []) if h["map"] == install.MID] == habitats
+            and tables == [install.ENCOUNTER])
+
+
+def registered(files):
+    try:
+        record = files.json(RECORD)
+    except (OSError, subprocess.CalledProcessError, ValueError):
+        return False
+    return (record.get("baseCommit") == BASE
+            and all(sha(files.read(path)) == digest for path, digest in record["outputs"].items()))
+
+
+def underneath(files):
+    """{path: bytes} with exactly the registered Xitun rework removed, when the
+    tree holds it; otherwise {}, so a guard reads the real bytes."""
+    if not registered(files):
+        return {}
+    base = type(files)(files.source, BASE)
+    if not built_entries(files, base):
+        return {}
+    layout, contract = base_entries(base)
+    return {
+        install.MAP: base.read(install.MAP),
+        install.MAP_JSON: base.read(install.MAP_JSON),
+        install.LAYOUTS: install.dump(install.put_layout(files.json(install.LAYOUTS), layout)),
+        install.CONTRACT: install.dump(install.put_contract(files.json(install.CONTRACT), *contract)),
+        install.ENCOUNTERS: install.dump(install.put_encounter(files.json(install.ENCOUNTERS), None)),
+    }
+
+
+def check(source=ROOT, overrides=None):
+    source = Path(source).resolve()
+    support = load("xitun_rework_support", source / "tools/taichung/landmarks/check_old_core.py")
+    now, base = support.Files(source), support.Files(source, BASE)
+    # The registered Old City rework adds Greenway's and Old City North's entries to the
+    # shared files; its own guard proves them, so this one reads the tree underneath it.
+    now.cache.update(support.oldcity_rework_underneath(now))
+    now.cache.update(overrides or {})
+    tests = support.Checks()
+    width, height = install.SIZE
+    dx, dy = install.SHIFT
+    layout = next(l for l in now.json(install.LAYOUTS)["layouts"] if l.get("id") == install.LAYOUT_ID)
+    words = now.words(install.MAP)
+    today = base.words(install.MAP)
+    today_w, today_h = width - dx, height - dy
+    kit = {k: int(v, 16) for k, v in now.json(KIT)["metatiles"].items()}
+    highway = {v for k, v in kit.items() if k.startswith("hw-")}
+    data, base_data = now.json(install.MAP_JSON), base.json(install.MAP_JSON)
+    primary, _ = support.resolved_folder(now, layout["primary_tileset"])
+    secondary, _ = support.resolved_folder(now, layout["secondary_tileset"])
+    bank = support.Bank(now, primary, secondary)
+
+    def cell(x, y):
+        return words[y * width + x]
+
+    def walkable(x, y):
+        return 0 <= x < width and 0 <= y < height and not cell(x, y) & SOLID_BITS
+
+    def installer():
+        outputs = install.build(base.read, now.read)
+        stale = [path for path, raw in outputs.items() if now.read(path) != raw]
+        tests.require(not stale, f"Not install_xitun.py's output from BASE: {stale}")
+        tests.require(now.json(RECORD) == install.record(outputs, base.read(install.MAP), now.read(FILL)),
+                      "install.json is not the installer's record")
+        tests.require(install.BASE == BASE, "Installer BASE moved")
+        tests.require(registered(now) and underneath(now), "underneath() does not recognise the registered rework")
+        return {"outputs": len(outputs), "mapSha256": sha(now.read(install.MAP))}
+
+    def geometry():
+        base_layout, _ = base_entries(base)
+        tests.require((layout["width"], layout["height"]) == (width, height) and len(words) == width * height,
+                      f"Xitun is not {width}x{height}")
+        tests.require({k: v for k, v in layout.items() if k not in ("width", "height")}
+                      == {k: v for k, v in base_layout.items() if k not in ("width", "height")}, "Xitun's tilesets or border moved")
+        tests.require(now.read(layout["border_filepath"]) == base.read(base_layout["border_filepath"]), "Xitun's border changed")
+        band = {(x, y) for y in range(height) for x in range(width) if x < 6 or y < 6}
+        tests.require(all(cell(x, y) & 0x3FF in highway and cell(x, y) & SOLID_BITS for x, y in band),
+                      "The highway band holds something other than solid kit highway")
+        plan = now.json(FILL)["rows"]
+        tests.require(len(plan) == height and all(len(row) == width for row in plan), f"fill.json is not {width}x{height}")
+        moved_art = [p for p in PROTECTED if cell(p[0] + dx, p[1] + dy) != today[p[1] * today_w + p[0]]]
+        tests.require(not moved_art, f"Landmark art changed at today's {sorted(moved_art)[:6]}")
+        tests.require({(x - dx, y - dy) for y in range(height) for x in range(width) if plan[y][x] == "L"} == PROTECTED,
+                      "The plan's landmark cells moved")
+        signs = {(e["x"], e["y"]) for e in data["bg_events"] if e["type"] == "sign"}
+        street_ids = {v for k, v in kit.items() if k.startswith("st-")} | {SIDEWALK}
+        tests.require(all((plan[y][x] == "H") == ((x, y) in band) for y in range(height) for x in range(width)),
+                      "The plan's highway is not the band")
+        def wall_piece(x, y):
+            return "wall-w-top" if x == 1 else "wall-w-bank" if x == 2 and y >= 3 else "wall-n-upper" if y == 1 else "wall-n-lower"
+        wall = {(x, y) for y in range(height) for x in range(width)
+                if (x - dx in (1, 2) and y - dy >= 1) or (y - dy in (1, 2) and x - dx >= 1)}
+        tests.require({(x, y) for y in range(height) for x in range(width) if plan[y][x] == "W"} == wall,
+                      "The plan's wall is not columns 1-2 and rows 1-2")
+        tests.require(all(cell(x, y) & 0x3FF == kit[wall_piece(x - dx, y - dy)] and cell(x, y) & SOLID_BITS for x, y in wall),
+                      "The wall is not the kit's solid wall pieces")
+        wrong = []
+        for y in range(6, height):
+            for x in range(6, width):
+                c, word = plan[y][x], cell(x, y)
+                if (x, y) in signs:
+                    ok = word == SIGNPOST and c in "L.g"
+                elif c == "W":
+                    ok = True
+                elif (x - dx, y - dy) in KERBS:
+                    ok = c == "s" and plan[y][x + 1] == "S" and word == 0x3000 | kit["st-bollards-e"]
+                elif c in "Ss":
+                    ok = word & 0x3FF in street_ids and not word & SOLID_BITS
+                elif c == "L":
+                    ok = True
+                elif c == "B":
+                    ok = word & 0x3FF in BUILDING_IDS and word & SOLID_BITS
+                elif c in "Tt":
+                    tops = [(x - ox, y - oy) for ox, oy in TREE if plan[y - oy][x - ox] == "T"]
+                    ok = len(tops) == 1 and word == TREE[(x - tops[0][0], y - tops[0][1])]
+                else:
+                    ok = word in FILL_WORDS.get(c, ())
+                if not ok:
+                    wrong.append((x - dx, y - dy))
+        tests.require(not wrong, f"Cells break their plan class at world {wrong[:6]}")
+        for event in base_data["warp_events"]:
+            x, y = event["x"] + dx, event["y"] + dy
+            tests.require(cell(x, y) == today[event["y"] * today_w + event["x"]], f"Door cell ({x},{y}) changed")
+        for warp in base_data["warp_events"]:
+            x, y = warp["x"] + dx, warp["y"] + dy
+            tests.require(bank.attr(cell(x, y) & 0x3FF) & 0x1FF == DOOR_BEHAVIOUR, f"Door ({x},{y}) lost its door behaviour")
+            tests.require(walkable(x, y + 1), f"Door ({x},{y}) has no open approach")
+        start = (24 + dx, 15 + dy)
+        seen, todo = {start}, [start]
+        while todo:
+            x, y = todo.pop()
+            for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+                if n not in seen and walkable(*n):
+                    seen.add(n)
+                    todo.append(n)
+        open_cells = {(x, y) for y in range(height) for x in range(width) if walkable(x, y)}
+        tests.require(open_cells <= seen, f"Open cells unreachable from Fengjia: {sorted(open_cells - seen)[:6]}")
+        grass = {(x, y) for y in range(height) for x in range(width)
+                 if bank.attr(cell(x, y) & 0x3FF) & 0x1FF == TALL_GRASS and (bank.attr(cell(x, y) & 0x3FF) >> 24) & 7 == LAND}
+        habitats = {(x, y) for h in now.json(install.CONTRACT)["habitatRegions"] if h["map"] == install.MID
+                    for x0, y0, x1, y1 in [h["rect"]] for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)}
+        tests.require(grass and grass == habitats, "Xitun's tall grass is not exactly its contract habitats")
+        # The Maple Garden's registered collision moves with the map.
+        maple = {(r["x"] + dx, r["y"] + dy) for r in now.json(COLLISION_DELTA)["newlySolidPositions"] if r["mapId"] == install.MID}
+        tests.require(len(maple) == 44 and all(cell(x, y) & SOLID_BITS for x, y in maple), "The Maple Garden's registered collision is open")
+        points = next(l for l in now.json(install.CONTRACT)["landmarks"] if l["id"] == "maple-garden")
+        door, approach, arrival = ((points[k]["x"], points[k]["y"]) for k in ("entrance", "approach", "arrival"))
+        tests.require(not {door, approach, arrival} & maple and walkable(*approach) and walkable(*arrival),
+                      "The Maple Garden's approach or arrival is closed")
+        mouth = (MAPLE_PATH_MOUTH[0] + dx, MAPLE_PATH_MOUTH[1] + dy)
+        steps, todo = {mouth: 0}, [mouth]
+        while todo and approach not in steps:
+            x, y = todo.pop(0)
+            for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+                if n not in steps and walkable(*n) and (plan[n[1]][n[0]] == "p" or n == approach):
+                    steps[n] = steps[(x, y)] + 1
+                    todo.append(n)
+        tests.require(approach in steps, "The park path from X26 does not reach the Maple Garden's door")
+        changed = sum(cell(x, y) != today[(y - dy) * today_w + x - dx] for y in range(dy, height) for x in range(dx, width))
+        limit = int(re.search(r"#define MAX_MAP_DATA_SIZE\s+(\w+)", now.text("include/fieldmap.h")).group(1), 0)
+        tests.require((width + 15) * (height + 14) <= limit, "Padded map exceeds MAX_MAP_DATA_SIZE")
+        return {"changedCellsInsideToday": changed, "open": len(open_cells), "tallGrass": len(grass),
+                "mapleSolidCells": len(maple), "mapleDoorApproachArrival": [list(door), list(approach), list(arrival)],
+                "mapleParkPathSteps": steps.get(approach)}
+
+    def seams():
+        draft = install.draft_xitun
+        bad = draft.strips(words, source)
+        for name, cells in bad.items():
+            tests.require(not cells, f"{name} would draw {len(cells)} strip cells differently, e.g. {cells[:3]}")
+        east = [y - dy for y in range(height) if walkable(width - 1, y)]
+        south = [x - dx for x in range(width) if walkable(x, height - 1)]
+        tests.require(east == EAST_OPEN, f"East edge open rows moved: {east}")
+        tests.require(south == SOUTH_OPEN, f"South edge open columns moved: {south}")
+        tests.require(not any(walkable(0, y) for y in range(height)) and not any(walkable(x, 0) for x in range(width)),
+                      "The highway edges are open")
+        return {"eastOpenRows": spans(EAST_OPEN), "southOpenColumns": spans(SOUTH_OPEN)}
+
+    def events():
+        def moved(event):
+            x, y = SIGN_MOVES.get((event["x"], event["y"]), (event["x"], event["y"])) if event.get("type") == "sign" else (event["x"], event["y"])
+            return {**event, "x": x + dx, "y": y + dy}
+
+        for key in install.EVENTS:
+            tests.require(data[key] == [moved(e) for e in base_data[key]], f"{key} are not today's, moved by {install.SHIFT}")
+        tests.require({k: v for k, v in data.items() if k not in install.EVENTS + ("connections",)}
+                      == {k: v for k, v in base_data.items() if k not in install.EVENTS + ("connections",)}, "Map header changed")
+        wanted = {mid: (direction, install.offset(name, direction)) for mid, (name, direction) in install.NEIGHBOURS.items()}
+        got = {c["map"]: (c["direction"], c["offset"]) for c in data["connections"]}
+        tests.require(got == wanted, f"Connections are not the master plan's: {got}")
+        # A neighbour is done once it has the plan's size and the reciprocal offset.
+        layouts = {l["id"]: l for l in now.json(install.LAYOUTS)["layouts"] if l.get("id")}
+        pending = []
+        for mid, (direction, value) in wanted.items():
+            name = next(n for n in now.json("data/maps/map_groups.json")["gMapGroup_Taichung"]
+                        if now.json(f"data/maps/{n}/map.json")["id"] == mid)
+            other = now.json(f"data/maps/{name}/map.json")
+            x0, y0, x1, y1 = install.PLAN[install.NEIGHBOURS[mid][0]]
+            size = layouts[other["layout"]]["width"], layouts[other["layout"]]["height"]
+            if size != (x1 - x0, y1 - y0) or not any(c["map"] == install.MID and c["offset"] == -value
+                                                     for c in other["connections"] or []):
+                pending.append(mid)
+        return {"warps": len(data["warp_events"]), "signs": len(data["bg_events"]), "objects": len(data["object_events"]),
+                "shift": list(install.SHIFT), "offsets": {k: v[1] for k, v in wanted.items()}, "neighboursPending": pending}
+
+    def contract():
+        district, landmarks, habitats = install.contract_entries(base.json(install.CONTRACT))
+        mine = now.json(install.CONTRACT)
+        tests.require(next(d for d in mine["districts"] if d["map"] == install.MID) == district,
+                      "Contract district is not Xitun's plan size, origin and connections")
+        tests.require({l["id"]: l for l in mine["landmarks"] if l["exteriorMap"] == install.MID} == landmarks,
+                      "Contract landmark points did not move with the map")
+        tests.require([h for h in mine["habitatRegions"] if h["map"] == install.MID] == habitats,
+                      "Contract habitats are not the Maple Garden park's")
+        signs = {(e["x"], e["y"]) for e in data["bg_events"] if e["type"] == "sign"}
+        for l in landmarks.values():
+            warp = data["warp_events"][l["entrance"]["warpId"]]
+            tests.require((warp["x"], warp["y"]) == (l["entrance"]["x"], l["entrance"]["y"]), f"{l['id']}: door and warp disagree")
+            tests.require((l["sign"]["x"], l["sign"]["y"]) in signs, f"{l['id']}: contract sign is not a map sign")
+        return {"landmarks": len(landmarks), "habitats": len(habitats)}
+
+    def encounters():
+        groups = now.json(install.ENCOUNTERS)["wild_encounter_groups"]
+        tables = [(g, i, e) for g in groups for i, e in enumerate(g["encounters"]) if e["map"] == install.MID]
+        tests.require(len(tables) == 1, f"Xitun has {len(tables)} encounter tables")
+        group, at, table = tables[0]
+        land = table["land_mons"]
+        tests.require(set(table) == {"map", "base_label", "land_mons"} and land["encounter_rate"] == 12 and len(land["mons"]) == 12,
+                      "Xitun's table is not one land table at rate 12 with 12 slots")
+        tests.require(all(LEVELS[0] <= m["min_level"] <= m["max_level"] <= LEVELS[1] for m in land["mons"]),
+                      f"Xitun's levels leave {LEVELS[0]}-{LEVELS[1]}")
+        tests.require(at > 0 and group["encounters"][at - 1]["map"] == install.ENCOUNTER_AFTER, "Xitun's table is not after Old City's")
+        return {"rate": land["encounter_rate"], "levels": f"{min(m['min_level'] for m in land['mons'])}-{max(m['max_level'] for m in land['mons'])}"}
+
+    tests.section("installer", installer)
+    tests.section("geometry", geometry)
+    tests.section("seams", seams)
+    tests.section("events", events)
+    tests.section("contract", contract)
+    tests.section("encounters", encounters)
+    return {"passed": not tests.errors, "errors": tests.errors, "checks": tests.results}
+
+
+def self_test(source):
+    source = Path(source).resolve()
+    read = lambda path: (source / path).read_bytes()
+    width = install.SIZE[0]
+    kit = {k: int(v, 16) for k, v in json.loads(read(KIT))["metatiles"].items()}
+
+    def map_with(x, y, word):
+        raw = bytearray(read(install.MAP))
+        struct.pack_into("<H", raw, 2 * (y * width + x), word)
+        return {install.MAP: bytes(raw)}
+
+    def json_with(path, edit):
+        value = json.loads(read(path))
+        edit(value)
+        return {path: install.dump(value)}
+
+    def level_six(value):
+        table = next(e for g in value["wild_encounter_groups"] for e in g["encounters"] if e["map"] == install.MID)
+        table["land_mons"]["mons"][-1]["max_level"] = 6
+
+    def door_not_moved(value):
+        next(l for l in value["landmarks"] if l["exteriorMap"] == install.MID)["entrance"]["x"] -= install.SHIFT[0]
+
+    def maple_sign_back(value):
+        sign = next(e for e in value["bg_events"] if (e["x"], e["y"]) == (24 + install.SHIFT[0], 33 + install.SHIFT[1]))
