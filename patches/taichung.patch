+static EWRAM_DATA bool8 sAward = FALSE;
+static EWRAM_DATA u8 sSelected = 0;
+static EWRAM_DATA u8 sBadgeSprites[TAICHUNG_GYM_COUNT] = {};
+
+static void CB2_InitCityPass(void);
+static void CB2_CityPass(void);
+static void CB2_ReopenCityPass(void);
+static void Task_CityPassInput(u8 taskId);
+
+static const u8 sTitleEn[] = _("CITY PASS");
+static const u8 sTitleZh[] = _("臺中城市護照");
+static const u8 sAwardTitleEn[] = _("LANDMARK BADGE");
+static const u8 sAwardTitleZh[] = _("地標徽章");
+static const u8 sEarnedEn[] = _("EARNED");
+static const u8 sEarnedZh[] = _("已獲得");
+static const u8 sLockedEn[] = _("NOT YET");
+static const u8 sLockedZh[] = _("未獲得");
+static const u8 sAwardTextEn[] = _("You earned the");
+static const u8 sAwardTextZh[] = _("獲得了");
+static const u8 sFooterEn[] = _("D-pad: badges  A: card  B: back");
+static const u8 sFooterZh[] = _("方向鍵選擇  A卡片  B返回");
+static const u8 sAdvance[] = _("A");
+static const u8 sCursor[] = _(">");
+static const u8 sMissingIcon[] = _("?");
+static const u8 sTotal[] = _("/10");
+static const u8 sGymsEn[] = _("GYMS");
+static const u8 sGymsZh[] = _("道館");
+
