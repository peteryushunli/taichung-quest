+                                 residential=t["useMix"]["residential"],retail_food=t["useMix"]["retailFood"],older_style=t["ageStyleMix"]["olderMasonry"],contemporary_style=t["ageStyleMix"]["contemporary"],high_rise=t["heightMix"]["highRise"],built_coverage_target=t["builtCoverageTarget"],green_target=t["greenSpaceFraction"],main_road_frontages=" / ".join(s["streetBands"]["primaryRetailFrontage"]["sourceRoadNames"]),evidence_refs=";".join(s["sourceEvidenceRefs"])))
