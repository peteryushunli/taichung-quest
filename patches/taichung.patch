+                "reproduceCommand":sys.executable+" -B tools/taichung/geography/profile_character.py --artifact-dir /Users/peter/devday_hackathon/artifacts/worktrees/c291d4842985/neighborhoods",
+                "nativeSourceMutations":False,"existingCityStreetDraftMutations":False,
+                "pilotStatus":"Frozen after independent user approval; the background builder only reads it."}
+    (DATA/"provenance.json").write_text(json.dumps(provenance,ensure_ascii=False,indent=2)+"\n")
+    (args.artifact_dir/"profiles-validation.json").write_text(json.dumps(report,indent=2)+"\n")
+    write_table(data,args.artifact_dir)
+    render(data,args.artifact_dir/"neighborhood-character-overview.png")
+    print(json.dumps(report))
+
+
+if __name__=="__main__":
+    main()
