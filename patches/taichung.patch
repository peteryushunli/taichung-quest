+        gText_QuestLog_UsedEscapeRope,
+        gText_QuestLog_DepartedFromLocationToNextDestination,
+        gText_QuestLog_ObtainedItemInLocation,
+        gText_QuestLog_SavedGameAtLocation,
+        gText_QuestLog_MultiBattleWithPeopleResultedInOutcome,
+        gText_QuestLog_PlayerBattledChampionRival,
+        gText_QuestLog_PlayerSentOutMon1RivalSentOutMon2,
+        gText_QuestLog_DefeatedWildMon,
+        gText_QuestLog_CaughtWildMon,
+        gText_QuestLog_DefeatedWildMonAndCaughtWildMon,
+        gText_QuestLog_DefeatedWildMonsAndCaughtWildMon,
+        gText_QuestLog_SoldNumOfItem,
+    };
+    static const u8 *const otherText[] = {
+        gText_QuestLog_SingleBattleWithPersonResultedInOutcome,
+        gText_QuestLog_DoubleBattleWithPersonResultedInOutcome,
+        gText_QuestLog_TradedMon1ForPersonsMon2,
+        gText_QuestLog_TradedMon1ForTrainersMon2,
+        gText_QuestLog_TookOnTrainersMonWithMonAndWon,
+        gText_QuestLog_PlayerSentOutMon1RivalSentOutMon2 + 1
+    };
+    u8 identity[] = "WALKER";
+    u8 rival[] = "BLUE";
+    u8 partner[] = "ALICE";
+    u8 opponent[] = "WALKER"; // Same spelling never makes another player local.
+    u8 storedState[4096], beforeState[4096]; // trainerID, OT, party and log sentinels
+    u8 copiedSaved[256];
+    u16 i;
+    for (i = 0; i < sizeof(storedState); i++)
+        storedState[i] = (i * 31 + 7) & 0xFF;
+    memcpy(beforeState, storedState, sizeof(storedState));
+    memcpy(copiedSaved, gText_QuestLog_SavedGameAtLocation, sizeof(gText_QuestLog_SavedGameAtLocation));
+
+    for (sChinese = FALSE; sChinese <= TRUE; sChinese++)
+    {
+        for (i = 0; i < ARRAY_COUNT(targets); i++)
+        {
+            const u8 *resolved = TaichungQuestLogPlayerText(targets[i]);
+            const char *text = (const char *)resolved;
+            assert(resolved != targets[i] && text[0] != '\0');
+            assert(strstr(text, "{PLAYER}") == NULL && strstr(text, "WALKER") == NULL);
+            assert(strstr(text, "you's") == NULL && strstr(text, "YOU's") == NULL);
+            assert(strstr(text, "You is") == NULL && strstr(text, "You has") == NULL);
+            assert(sChinese ? strstr(text, "你") != NULL : (strstr(text, "You") != NULL || strstr(text, "you") != NULL));
+        }
+        for (i = 0; i < ARRAY_COUNT(otherText); i++)
+            assert(TaichungQuestLogPlayerText(otherText[i]) == otherText[i]);
+        assert(TaichungQuestLogPlayerText(NULL) == NULL);
+        assert(TaichungQuestLogPlayerText(identity) == identity);
+        assert(TaichungQuestLogPlayerText(rival) == rival);
+        assert(TaichungQuestLogPlayerText(partner) == partner);
+        assert(TaichungQuestLogPlayerText(opponent) == opponent);
+        assert(TaichungQuestLogPlayerText(copiedSaved) == copiedSaved);
+        assert(TaichungQuestLogPlayerText(storedState) == storedState);
+        assert(memcmp(storedState, beforeState, sizeof(storedState)) == 0);
+        assert(strcmp((const char *)identity, "WALKER") == 0);
+        assert(strcmp((const char *)rival, "BLUE") == 0);
+        assert(strcmp((const char *)partner, "ALICE") == 0);
+        assert(strcmp((const char *)opponent, "WALKER") == 0);
+        assert(strcmp((const char *)TaichungPlayerTextGet(TAICHUNG_PLAYER_YOU), sChinese ? "你" : "YOU") == 0);
+    }
+    sChinese = FALSE;
+    assert(strcmp((const char *)TaichungQuestLogPlayerText(gText_QuestLog_SavedGameAtLocation), "You saved the game here:\n{STR_VAR_1}.") == 0);
+    assert(strstr((const char *)TaichungQuestLogPlayerText(gText_QuestLog_GaveMonHeldItemFromPC), "your PC") != NULL);
+    sChinese = TRUE;
+    assert(strcmp((const char *)TaichungQuestLogPlayerText(gText_QuestLog_SavedGameAtLocation), "你在這裡儲存了遊戲：\n{STR_VAR_1}。") == 0);
+    puts("PASS: real21-context bilingual resolver, exact pointer routing, unchanged participant/name/storage buffers and actual local YOU getter");
+    return 0;
+}
diff --git a/tests/taichung_save_facing_test.c b/tests/taichung_save_facing_test.c
new file mode 100644
index 0000000..aa9c03e
--- /dev/null
+++ b/tests/taichung_save_facing_test.c
@@ -0,0 +1,496 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_save.h"
+#include "metatile_behavior.h"
+#include "constants/maps.h"
+#include "constants/map_types.h"
+#include "constants/metatile_behaviors.h"
+#include "constants/event_object_movement.h"
+#include "constants/trainer_types.h"
+#include "constants/flags.h"
+
+#define MAP_OFFSET 7
+struct SaveBlock2 { u8 playerGender; };
+struct Sprite { u8 unused; };
+static struct SaveBlock1 sSave;
+static struct SaveBlock2 sSave2;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct SaveBlock2 *gSaveBlock2Ptr = &sSave2;
+struct ObjectEvent gObjectEvents[OBJECT_EVENTS_COUNT];
+struct PlayerAvatar gPlayerAvatar;
+struct MapHeader gMapHeader;
+struct WarpData gLastUsedWarp;
+struct Sprite gSprites[1];
+s16 gTotalCameraPixelOffsetX, gTotalCameraPixelOffsetY;
+static bool8 sPending;
+static unsigned sWarpRequests, sCases;
+static u8 sBehavior;
+static const struct MapLayout sLayout = {.width = 40, .height = 72};
+static const struct MapLayout *const gMapLayouts[] = {&sLayout};
+static struct WarpEvent sDoor = {.x = 6, .y = 14}; // One case moves it under a refresh target.
+static const struct MapEvents sEvents = {.warpCount = 1, .warps = &sDoor};
+static const struct MapHeader sHeader = {.mapLayout = &sLayout, .mapLayoutId = 1, .events = &sEvents, .mapType = MAP_TYPE_TOWN};
+
+// Only data/graphics/script services are host boundaries. Facing is produced
+// by unmodified native direction, avatar, ObjectEventTurn and getter functions.
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group, u16 num) { (void)group; (void)num; return &sHeader; }
+bool8 FlagGet(u16 flag) { (void)flag; return FALSE; }
+bool8 Overworld_IsBikingAllowed(void) { return TRUE; }
+u8 MapGridGetMetatileBehaviorAt(s16 x, s16 y) { (void)x; (void)y; return sBehavior; }
+void ClearLinkPlayerObjectEvents(void) {}
+void CreateReflectionEffectSprites(void) {}
+u8 GetPlayerAvatarGraphicsIdByStateIdAndGender(u8 state, u8 gender) { (void)state; (void)gender; return 0; }
+u8 CreateWarpArrowSprite(void) { return 0; }
+void StartSpriteAnim(struct Sprite *sprite, u8 anim) { (void)sprite; (void)anim; }
+void SeekSpriteAnim(struct Sprite *sprite, u8 frame) { (void)sprite; (void)frame; }
+u8 GetFaceDirectionAnimNum(u8 direction) { return direction; }
+void SetPlayerAvatarTransitionFlags(u16 flags) { gPlayerAvatar.transitionFlags |= flags; }
+void TaichungCharactersAvoidNpcSpawnOverlap(s16 x, s16 y) { (void)x; (void)y; }
+void TrySpawnObjectEvents(s16 x, s16 y) { (void)x; (void)y; }
+void TryRunOnWarpIntoMapScript(void) {}
+u8 SpawnSpecialObjectEvent(struct ObjectEventTemplate *template)
+{
+    struct ObjectEvent *object = &gObjectEvents[0];
+    object->active = TRUE;
+    object->localId = template->localId;
+    object->movementType = template->objUnion.normal.movementType;
+    object->currentCoords.x = template->x + MAP_OFFSET;
+    object->currentCoords.y = template->y + MAP_OFFSET;
+    return 0; // Allocation only: does not set either direction field.
+}
+bool8 VarSet(u16 id, u16 value) { sSave.vars[id - VARS_START] = value; return TRUE; }
+void SetContinueGameWarpStatus(void) { sPending = TRUE; sWarpRequests++; }
+bool32 UseContinueGameWarp(void) { return sPending; }
+void TaichungGymCancelChallenge(void) {}
+
+#include "native-engine.inc"
+#include "collision-v9-origins.inc"
+#include "save-v10.inc"
+#include "save-v11-expect.inc"
+
+static const struct V10District *FindV10(u8 mapNum)
+{
+    unsigned i;
+    for (i = 0; i < sizeof(sV10Districts) / sizeof(sV10Districts[0]); i++)
+        if (sV10Districts[i].mapNum == mapNum) return &sV10Districts[i];
+    return NULL;
+}
+
+// Where v10 puts a released explicit position; TRUE when the rework closed it and it was repaired.
+static bool8 ExpectV10(u8 mapNum, s16 *x, s16 *y)
+{
+    const struct V10District *d = FindV10(mapNum);
+    unsigned i;
+    assert(d);
+    for (i = 0; i < d->count; i++)
+        if (*x == d->repairs[i][0] && *y == d->repairs[i][1])
+        {
+            *x = d->repairs[i][2]; *y = d->repairs[i][3];
+            return TRUE;
+        }
+    *x += d->dx; *y += d->dy;
+    return FALSE;
+}
+
+// Historical geometry stays frozen; compose the independently verified v11 layer
+// afterwards. A final return to the same world tile keeps its original facing.
+static bool8 ExpectLatest(u8 mapNum, s16 *x, s16 *y)
+{
+    const struct V10District *d = FindV10(mapNum);
+    s16 sameX = *x + d->dx, sameY = *y + d->dy;
+    ExpectV10(mapNum, x, y);
+    ExpectApprovedArtV11(MAP_GROUP(MAP_TAICHUNG_OLD_CITY), mapNum, x, y);
+    return *x != sameX || *y != sameY;
+}
+
+static void Saved(u16 version, u8 mapNum, s16 x, s16 y, u8 direction)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(gObjectEvents, 0, sizeof(gObjectEvents));
+    memset(&gPlayerAvatar, 0, sizeof(gPlayerAvatar));
+    sSave.playerPartyCount = 1;
+    memset(sSave.preservedPartyAndBag, 0xA5, sizeof(sSave.preservedPartyAndBag));
+    sSave.vars[0xF7] = version;
+    sSave.vars[0xF6] = 0xA109;
+    sSave.vars[0xF8] = 1;
+    sSave.vars[0xF9] = 2;
+    sSave.vars[0xFA] = 0x7F;
+    sSave.vars[0xFB] = 2;
+    sSave.vars[0xFC] = 25;
+    sSave.location = (struct WarpData){MAP_GROUP(MAP_TAICHUNG_OLD_CITY), mapNum, -1, 7, 8};
+    sSave.pos = (struct Coords16){x, y};
+    sSave.mapLayoutId = 1;
+    // A different-facing NPC in slot0 catches assumptions about player index.
+    sSave.objectEvents[0].active = TRUE;
+    sSave.objectEvents[0].facingDirection = DIR_EAST;
+    sSave.objectEvents[5].active = TRUE;
+    sSave.objectEvents[5].isPlayer = TRUE;
+    sSave.objectEvents[5].facingDirection = direction;
+    sPending = FALSE;
+    sWarpRequests = 0;
+    sBehavior = MB_NORMAL;
+    ResetInitialPlayerAvatarState();
+}
+
+static void LoadContinueMap(void)
+{
+    assert(sPending);
+    sPending = FALSE;
+    SetWarpDestinationToContinueGameWarp();
+    WarpIntoMap();
+    InitObjectEventsLocal();
+}
+
+static void CacheOnlyCases(void)
+{
+    static const s16 positions[][2] = {{30,66}, {17,40}, {12,47}};
+    const u8 directions[] = {DIR_NORTH, DIR_WEST};
+    unsigned map, dir;
+    for (map = 0; map < 3; map++)
+        for (dir = 0; dir < sizeof(directions); dir++)
+        {
+            struct SaveBlock1 before;
+            s16 x = positions[map][0], y = positions[map][1];
+            Saved(7, map, x, y, directions[dir]);
+            before = sSave;
+            TaichungSaveUpgradeOnContinue();
+            // v10 only shifts these cells: the same world tile in the reworked district's coordinates.
+            assert(!ExpectLatest(map, &x, &y));
+            assert(sSave.vars[0xF7] == TAICHUNG_SAVE_VERSION && sWarpRequests == 1);
+            assert(sSave.continueGameWarp.x == x && sSave.continueGameWarp.y == y);
+            LoadContinueMap();
+            if (GetPlayerFacingDirection() != directions[dir])
+                fprintf(stderr, "cache-only native facing: expected %u, got %u\n", directions[dir], GetPlayerFacingDirection());
+            assert(GetPlayerFacingDirection() == directions[dir]);
+            assert(gObjectEvents[gPlayerAvatar.objectEventId].movementDirection == directions[dir]);
+            assert(sSave.pos.x == x && sSave.pos.y == y);
+            assert(memcmp(sSave.objectEvents, before.objectEvents, sizeof(sSave.objectEvents)) == 0);
+            assert(memcmp(sSave.preservedPartyAndBag, before.preservedPartyAndBag, sizeof(sSave.preservedPartyAndBag)) == 0);
+            before.vars[0xF7] = TAICHUNG_SAVE_VERSION;
+            assert(memcmp(sSave.vars, before.vars, sizeof(sSave.vars)) == 0);
+            // Consumption must not affect a later ordinary map load.
+            InitObjectEventsLocal();
+            assert(GetPlayerFacingDirection() == DIR_SOUTH);
+            sCases++;
+        }
+    // A same-position refresh is not a door arrival, even on a door metatile, nor is a pure v10 shift.
+    Saved(7, 0, 30, 66, DIR_NORTH);
+    sBehavior = MB_CAVE_DOOR;
+    TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+    assert(GetPlayerFacingDirection() == DIR_NORTH);
+    sCases++;
+    {
+        s16 x = 12, y = 35;
+        assert(!ExpectLatest(2, &x, &y));
+        Saved(9, 2, 12, 35, DIR_NORTH);
+        sBehavior = MB_CAVE_DOOR;
+        TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+        assert(sSave.pos.x == x && sSave.pos.y == y && GetPlayerFacingDirection() == DIR_NORTH);
+        sCases++;
+    }
+}
+
+static void NativeWarpAndRepairPriority(void)
+{
+    struct WarpData pending;
+    s16 xitunX, xitunY, oldCityX, oldCityY;
+    Saved(7, 0, 30, 66, DIR_WEST);
+    pending = (struct WarpData){MAP_GROUP(MAP_TAICHUNG_OLD_CITY), 1, 0, -1, -1};
+    sSave.continueGameWarp = pending; sPending = TRUE;
+    sBehavior = MB_CAVE_DOOR;
+    TaichungSaveUpgradeOnContinue();
+    assert(sWarpRequests == 0 && memcmp(&pending, &sSave.continueGameWarp, sizeof(pending)) == 0);
+    LoadContinueMap();
+    assert(sSave.pos.x == 6 && sSave.pos.y == 14 && GetPlayerFacingDirection() == DIR_SOUTH);
+    sCases++;
+    // An existing same-target return still owns native arrival direction.
+    Saved(7, 0, 30, 66, DIR_NORTH);
+    sSave.continueGameWarp = (struct WarpData){43, 0, -1, 30, 66}; sPending = TRUE;
+    TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+    assert(sWarpRequests == 0 && GetPlayerFacingDirection() == DIR_SOUTH);
+    sCases++;
+    // Actual current relocation tables run before deciding whether to preserve; v10 follows them.
+    xitunX = 31; xitunY = 32; ExpectLatest(2, &xitunX, &xitunY);
+    oldCityX = 7; oldCityY = 2; ExpectLatest(0, &oldCityX, &oldCityY);
+    Saved(7, 2, 31, 30, DIR_WEST);
+    TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+    assert(sSave.pos.x == xitunX && sSave.pos.y == xitunY && GetPlayerFacingDirection() == DIR_SOUTH);
+    sCases++;
+    Saved(2, 0, 2, 2, DIR_NORTH);
+    TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+    assert(sSave.pos.x == oldCityX && sSave.pos.y == oldCityY && GetPlayerFacingDirection() == DIR_SOUTH);
+    sCases++;
+    Saved(7, 0, 30, 66, DIR_NORTH);
+    sSave.continueGameWarp = (struct WarpData){43, 2, -1, 31, 30}; sPending = TRUE;
+    TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+    assert(sSave.pos.x == xitunX && sSave.pos.y == xitunY && GetPlayerFacingDirection() == DIR_SOUTH);
+    sCases++;
+}
+
+static void InvalidAndStaleHandoffs(void)
+{
+    unsigned invalid;
+    s16 x, y;
+    for (invalid = 0; invalid < 3; invalid++)
+    {
+        Saved(7, 0, 30, 66, DIR_NORTH);
+        if (invalid == 0) sSave.objectEvents[5].active = FALSE;
+        if (invalid == 1) sSave.objectEvents[5].facingDirection = DIR_NONE;
+        if (invalid == 2) { sSave.objectEvents[6] = sSave.objectEvents[5]; }
+        TaichungSaveUpgradeOnContinue(); LoadContinueMap();
+        assert(GetPlayerFacingDirection() == DIR_SOUTH);
+        sCases++;
+    }
+    Saved(7, 0, 30, 66, DIR_NORTH); TaichungSaveUpgradeOnContinue();
+    sSave.continueGameWarp.x = 31; // A later native position warp supersedes it.
+    LoadContinueMap(); assert(GetPlayerFacingDirection() == DIR_SOUTH); sCases++;
+    Saved(7, 0, 30, 66, DIR_NORTH); TaichungSaveUpgradeOnContinue();
+    sSave.continueGameWarp.mapNum = 1; // Same coordinates, different map also wins.
+    LoadContinueMap(); assert(GetPlayerFacingDirection() == DIR_SOUTH); sCases++;
+    x = 6; y = 14; assert(!ExpectLatest(1, &x, &y)); // A pure shift, so the handoff is armed there.
+    Saved(7, 1, 6, 14, DIR_NORTH); TaichungSaveUpgradeOnContinue();
+    assert(sSave.continueGameWarp.x == x && sSave.continueGameWarp.y == y);
+    sSave.continueGameWarp.warpId = 0; // A native door at even the same (shifted) position wins.
+    sDoor.x = x; sDoor.y = y;
+    sBehavior = MB_CAVE_DOOR;
+    LoadContinueMap(); assert(sSave.pos.x == sDoor.x && sSave.pos.y == sDoor.y);
+    assert(GetPlayerFacingDirection() == DIR_SOUTH); sCases++;
+    sDoor.x = 6; sDoor.y = 14;
+    Saved(7, 0, 30, 66, DIR_NORTH); TaichungSaveUpgradeOnContinue();
+    TaichungSaveUpgradeOnContinue(); // Current-version early exit clears stale state.
+    LoadContinueMap(); assert(GetPlayerFacingDirection() == DIR_SOUTH); sCases++;
+    Saved(7, 0, 30, 66, DIR_NORTH); TaichungSaveUpgradeOnContinue();
+    TaichungSaveInitNewGame();
+    LoadContinueMap(); assert(GetPlayerFacingDirection() == DIR_SOUTH); sCases++;
+}
+
+static void AssertMigratedProtected(const struct SaveBlock1 *before)
+{
+    unsigned i;
+    assert(sSave.vars[0xF7] == TAICHUNG_SAVE_VERSION && sSave.playerPartyCount == before->playerPartyCount);
+    for (i = 0; i < 256; i++)
+        if (i != 0xF7) assert(sSave.vars[i] == before->vars[i]);
+    assert(memcmp(sSave.preservedPartyAndBag, before->preservedPartyAndBag, sizeof(sSave.preservedPartyAndBag)) == 0);
+    assert(memcmp(&sSave.lastHealLocation, &before->lastHealLocation, sizeof(sSave.lastHealLocation)) == 0);
+    assert(memcmp(sSave.objectEvents, before->objectEvents, sizeof(sSave.objectEvents)) == 0);
+}
+
+static void V9CollisionEngineCases(void)
+{
+    struct SaveBlock1 before;
+    unsigned i, version, pending, dir;
+    static const u8 historical[][2] = {{16,29}, {16,30}, {18,32}};
+    // Old City North(18) now refreshes at v11; the gym rooms 3 and 16 reload at v12.
+    static const u8 rooms[] = {13,17};
+    static const u8 districts[] = {0,1,14,15};
+    const u8 directions[] = {DIR_NORTH, DIR_WEST};
+    s16 fallbackX = 12, fallbackY = 35;
+    // The validated fallback only shifts at v10, so a v8 save already there keeps its facing.
+    assert(!ExpectLatest(2, &fallbackX, &fallbackY));
+    for (dir = 0; dir < sizeof(directions); dir++)
+    {
+        Saved(8, 2, 12, 35, directions[dir]); before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(sWarpRequests == 1);
+        LoadContinueMap();
+        assert(sSave.pos.x == fallbackX && sSave.pos.y == fallbackY && GetPlayerFacingDirection() == directions[dir]);
+        AssertMigratedProtected(&before); sCases++;
+    }
+    assert(sizeof(sCollisionV9Origins) == 44 * 2);
+    for (i = 0; i < 44; i++)
+        for (pending = 0; pending < 2; pending++)
+        {
+            Saved(8, pending ? 3 : 2, sCollisionV9Origins[i][0], sCollisionV9Origins[i][1], DIR_NORTH);
+            if (pending)
+            {
+                sPending = TRUE;
+                sSave.continueGameWarp = (struct WarpData){43, 2, -1, sCollisionV9Origins[i][0], sCollisionV9Origins[i][1]};
+            }
+            before = sSave; TaichungSaveUpgradeOnContinue();
+            assert(sWarpRequests == (pending ? 0u : 1u));
+            LoadContinueMap();
+            assert(sSave.location.mapGroup == 43 && sSave.location.mapNum == 2);
+            assert(sSave.pos.x == fallbackX && sSave.pos.y == fallbackY && GetPlayerFacingDirection() == DIR_SOUTH);
+            AssertMigratedProtected(&before); sCases++;
+        }
+    for (version = 1; version <= 6; version++)
+        for (i = 0; i < sizeof(historical) / sizeof(historical[0]); i++)
+            for (pending = 0; pending < 2; pending++)
+            {
+                Saved(version, pending ? 3 : 2, historical[i][0], historical[i][1], DIR_WEST);
+                if (pending)
+                {
+                    sPending = TRUE;
+                    sSave.continueGameWarp = (struct WarpData){43, 2, -1, historical[i][0], historical[i][1]};
+                }
+                before = sSave; TaichungSaveUpgradeOnContinue();
+                assert(sWarpRequests == (pending ? 0u : 1u));
+                LoadContinueMap();
+                assert(sSave.pos.x == fallbackX && sSave.pos.y == fallbackY && GetPlayerFacingDirection() == DIR_SOUTH);
+                AssertMigratedProtected(&before); sCases++;
+            }
+    for (i = 0; i < sizeof(rooms); i++)
+    {
+        Saved(8, rooms[i], 12, 35, DIR_NORTH); before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0 && TaichungSaveConsumeContinueFacing() == DIR_NONE);
+        AssertMigratedProtected(&before); sCases++;
+    }
+    // The other outdoor districts reload at v10: facing survives a pure shift, not a repair.
+    for (i = 0; i < sizeof(districts); i++)
+    {
+        s16 x = 12, y = 35;
+        bool8 repaired = ExpectLatest(districts[i], &x, &y);
+        Saved(8, districts[i], 12, 35, DIR_NORTH); before = sSave;
+        TaichungSaveUpgradeOnContinue(); assert(sWarpRequests == 1);
+        LoadContinueMap();
+        assert(sSave.pos.x == x && sSave.pos.y == y && GetPlayerFacingDirection() == (repaired ? DIR_SOUTH : DIR_NORTH));
+        AssertMigratedProtected(&before); sCases++;
+    }
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION + 1; version++)
+    {
+        Saved(version, 2, 12, 35, DIR_WEST); before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(!sPending && sWarpRequests == 0 && TaichungSaveConsumeContinueFacing() == DIR_NONE);
+        assert(memcmp(&sSave,&before,sizeof(sSave)) == 0); sCases++;
+    }
+}
+
+// Every released cell of the five reworked districts, saved at any older version: the native engine
+// keeps the saved facing exactly when the player lands on the same world tile (a pure v10 shift), and a
+// repaired cell or a pending return takes the native arrival. At v9 the landing cell is the record's.
+static unsigned sV10Kept, sV10Repaired, sV10Cells[5];
+
+static void V10FacingCases(void)
+{
+    static const u8 directions[] = {DIR_NORTH, DIR_WEST, DIR_EAST};
+    struct SaveBlock1 before;
+    unsigned d, version, x, y;
+    assert(sizeof(sV10Districts) / sizeof(sV10Districts[0]) == 5 && FindV10(18) == NULL);
+    for (d = 0; d < 5; d++)
+    {
+        const struct V10District *district = &sV10Districts[d];
+        for (y = 0; y < district->height; y++)
+            for (x = 0; x < district->width; x++)
+            {
+                s16 ex = x, ey = y;
+                bool8 repaired = ExpectLatest(district->mapNum, &ex, &ey);
+                for (version = 1; version <= 9; version++)
+                {
+                    u8 direction = directions[(x + y + version) % 3];
+                    bool8 sameTile;
+                    Saved(version, district->mapNum, x, y, direction); before = sSave;
+                    TaichungSaveUpgradeOnContinue(); assert(sWarpRequests == 1);
+                    LoadContinueMap();
+                    sameTile = sSave.pos.x == (s16)(x + district->dx) && sSave.pos.y == (s16)(y + district->dy);
+                    assert(GetPlayerFacingDirection() == (sameTile ? direction : DIR_SOUTH));
+                    assert(gObjectEvents[gPlayerAvatar.objectEventId].movementDirection == GetPlayerFacingDirection());
+                    if (version == 9)
+                    {
+                        assert(sSave.pos.x == ex && sSave.pos.y == ey && sameTile == !repaired);
+                        if (repaired) sV10Repaired++; else sV10Kept++;
+                    }
+                    AssertMigratedProtected(&before); sCases++;
+                }
+                // A v9 pending explicit target from a room lands on the same cell with a native arrival.
+                Saved(9, 3, 6, 9, DIR_NORTH); sPending = TRUE;
+                sSave.continueGameWarp = (struct WarpData){43, district->mapNum, -1, x, y}; before = sSave;
+                TaichungSaveUpgradeOnContinue(); assert(sWarpRequests == 0);
+                LoadContinueMap();
+                assert(sSave.pos.x == ex && sSave.pos.y == ey && GetPlayerFacingDirection() == DIR_SOUTH);
+                AssertMigratedProtected(&before); sCases++;
+                sV10Cells[d]++;
+            }
+        assert(sV10Cells[d] == (unsigned)district->width * district->height);
+    }
+}
+
+static void ObjectCacheRefreshFacingCases(void)
+{
+    const u8 rooms[] = {
+        MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM), MAP_NUM(MAP_TAICHUNG_PARK_GYM),
+        MAP_NUM(MAP_TAICHUNG_MIYAHARA_GYM), MAP_NUM(MAP_TAICHUNG_SCIENCE_MUSEUM_GYM),
+        MAP_NUM(MAP_TAICHUNG_GREENWAY_GYM), MAP_NUM(MAP_TAICHUNG_SHEN_JI_GYM),
+        MAP_NUM(MAP_TAICHUNG_FINE_ARTS_GYM), MAP_NUM(MAP_TAICHUNG_FENGJIA_GYM),
+        MAP_NUM(MAP_TAICHUNG_MAPLE_GARDEN_GYM), MAP_NUM(MAP_TAICHUNG_THEATER_GYM)
+    };
+    const u8 directions[] = {DIR_SOUTH, DIR_NORTH, DIR_WEST, DIR_EAST};
+    unsigned room, direction, invalid, version;
+    // A current save takes the same-version early exit, then the staff refresh. Older saves in
+    // these rooms reload onto the exit mat at v12 instead (taichung_save_v12_test.c).
+    for (version = TAICHUNG_SAVE_VERSION; version <= TAICHUNG_SAVE_VERSION; version++)
+    for (room = 0; room < sizeof(rooms); room++)
+        for (direction = 0; direction < sizeof(directions); direction++)
+        {
+            struct SaveBlock1 before;
+            Saved(version, rooms[room], 3, 9, directions[direction]);
+            TaichungSaveUpgradeOnContinue(); // Clears any old handoff; never a warp in a room.
+            assert(!sPending && sWarpRequests == 0);
+            before = sSave;
+            sSave.continueGameWarp = sSave.location;
+            sSave.continueGameWarp.warpId = -1;
+            sSave.continueGameWarp.x = sSave.pos.x;
+            sSave.continueGameWarp.y = sSave.pos.y;
+            TaichungSaveRememberObjectCacheRefreshFacing();
+            assert(!sPending && sWarpRequests == 0); // The bridge never creates a warp.
+            before.continueGameWarp = sSave.continueGameWarp;
+            assert(!memcmp(&before, &sSave, sizeof(before)));
+            SetContinueGameWarpStatus();
+            LoadContinueMap();
+            assert(GetPlayerFacingDirection() == directions[direction]);
+            assert(sSave.pos.x == 3 && sSave.pos.y == 9);
+            AssertMigratedProtected(&before);
+            InitObjectEventsLocal();
+            assert(GetPlayerFacingDirection() == DIR_SOUTH); // One shot.
+            sCases++;
+        }
+
+    for (invalid = 0; invalid < 8; invalid++)
+    {
+        struct SaveBlock1 before;
+        Saved(TAICHUNG_SAVE_VERSION, rooms[0], 3, 9, DIR_NORTH);
+        TaichungSaveUpgradeOnContinue();
+        sSave.continueGameWarp = sSave.location;
+        sSave.continueGameWarp.warpId = -1;
+        sSave.continueGameWarp.x = 3;
+        sSave.continueGameWarp.y = 9;
+        if (invalid == 0) sPending = TRUE;
+        if (invalid == 1) sSave.continueGameWarp.warpId = 0;
+        if (invalid == 2) sSave.continueGameWarp.mapGroup++;
+        if (invalid == 3) sSave.continueGameWarp.mapNum++;
+        if (invalid == 4) sSave.continueGameWarp.x++;
+        if (invalid == 5) sSave.objectEvents[5].active = FALSE;
+        if (invalid == 6) sSave.objectEvents[5].facingDirection = DIR_NONE;
+        if (invalid == 7) sSave.objectEvents[6] = sSave.objectEvents[5];
+        before = sSave;
+        TaichungSaveRememberObjectCacheRefreshFacing();
+        assert(TaichungSaveConsumeContinueFacing() == DIR_NONE);
+        assert(!memcmp(&before, &sSave, sizeof(before)) && sWarpRequests == 0);
+        sCases++;
+    }
+    gSaveBlock1Ptr = NULL;
+    TaichungSaveRememberObjectCacheRefreshFacing();
+    gSaveBlock1Ptr = &sSave;
+    assert(TaichungSaveConsumeContinueFacing() == DIR_NONE);
+    sCases++;
+}
+
+int main(void)
+{
+    unsigned i;
+    assert(sizeof(struct ObjectEvent) == 0x24);
+    CacheOnlyCases();
+    NativeWarpAndRepairPriority();
+    InvalidAndStaleHandoffs();
+    V9CollisionEngineCases();
+    V10FacingCases();
+    ObjectCacheRefreshFacingCases();
+    printf("PASS: %u compiled native warp/avatar cases; existing20 facing regressions, v8 Up/Left cache refresh, all44 v9 origins and pending targets, three historical chains, protected save state and unaffected/current versions, all10 gym cache facings from current saves and invalid/pending guards; "
+           "v10 facing on every released cell from v1-v9 (", sCases);
+    for (i = 0; i < 5; i++)
+        printf("%s%s %u", i ? ", " : "", sV10Districts[i].name, sV10Cells[i]);
+    printf("): kept on the %u pure-shift cells, native South on the %u repaired cells and every pending return\n", sV10Kept, sV10Repaired);
+    return 0;
+}
diff --git a/tests/taichung_save_test.c b/tests/taichung_save_test.c
