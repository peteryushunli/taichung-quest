+def world(images, plan_png, origin, s=6):
+    """Both drafts laid on the plan render, whose top-left cell is world `origin`."""
+    base = Image.open(plan_png).convert("RGB")
+    base = base.resize((base.width * s // TILE, base.height * s // TILE), Image.Resampling.BOX)
+    base = Image.blend(base, Image.new("RGB", base.size, "#ffffff"), 0.35)
+    canvas = Image.new("RGB", (base.width + 340, base.height + 60), "#f4f5f2")
+    canvas.paste(base, (0, 60))
+    d = ImageDraw.Draw(canvas)
+    for g, img in images:
+        small = img.resize((img.width * s // TILE, img.height * s // TILE), Image.Resampling.BOX)
+        x, y = (g.ox - origin[0]) * s, 60 + (g.oy - origin[1]) * s
+        canvas.paste(small, (x, y))
+        d.rectangle((x, y, x + small.width - 1, y + small.height - 1), outline="#1e1e1e", width=2)
+    d.text((10, 10), "Old City and Greenway drafts laid on the master-plan render", font=font(18), fill="#1e1e1e")
+    d.text((10, 34), "Outside the two boxes: plan.png (Xitun, Nantun North, Wanhe as the plan draws them, faded).", font=font(13), fill="#444444")
+    lx = base.width + 16
+    gw, oc = (g for g, _ in images)
+    for i, line in enumerate([f"Greenway ({gw.ox},{gw.oy})-({gw.ox + gw.w},{gw.oy + gw.h}), {gw.w}x{gw.h}",
+                              f"Old City ({oc.ox},{oc.oy})-({oc.ox + oc.w},{oc.oy + oc.h}), {oc.w}x{oc.h}",
+                              "Highway rows -5..0, wall rows 1-2", "East river x120-123", "South river rows 121-124",
+                              "Green River x96-97, x104-105"]):
+        d.text((lx, 80 + i * 22), line, font=font(13), fill="#1e1e1e")
+    return canvas
