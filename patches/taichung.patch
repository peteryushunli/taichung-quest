+Only this feature checkout is written. The installed primary is immutable;
+static graphics are deduplicated against it before allocating secondary slots.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+from check_old_core import Files, Bank, resolved_folder
+from analyze_theater_cohort import visible_cells
