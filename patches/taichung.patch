+#!/usr/bin/env python3
+"""Describe registered OldCity terrain versus exact Git 21c08cb source data.
+
+Writes only old-core-native/delta.json. It never reads a worktree baseline map,
+builds a ROM, mutates a save, changes startup scripts, or installs a proposed map.
+"""
+import argparse
+from collections import deque
+from datetime import datetime, timezone
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "21c08cb"
+OUTPUT = ROOT / "data/taichung/landmarks/old-core-native/delta.json"
+CITY = "MAP_TAICHUNG_OLD_CITY"
+WALK_RULE_PATH = ROOT / "tools/taichung/validate_city.py"
+WALK_RULE_BYTES = WALK_RULE_PATH.read_bytes()
+spec = importlib.util.spec_from_file_location("city_delta_walk_rules", WALK_RULE_PATH)
+rules = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(rules)
+if WALK_RULE_PATH.read_bytes() != WALK_RULE_BYTES:
+    raise ValueError("City validator changed while loading; recompute")
+WALK = rules.WALK_BEHAVIORS
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def git_show(revision, path, missing=False):
+    process = subprocess.run(["git", "show", f"{revision}:{path}"], cwd=ROOT, capture_output=True)
+    if process.returncode:
+        if missing:
+            return None
+        raise ValueError(f"Cannot read exact Git source {revision}:{path}: {process.stderr.decode().strip()}")
+    return process.stdout
+
+
+class Source:
+    def __init__(self, revision=None):
+        self.revision, self.raw = revision, {}
+
+    def read(self, path):
+        path = str(path)
+        if path not in self.raw:
+            self.raw[path] = git_show(self.revision, path) if self.revision else (ROOT / path).read_bytes()
+        return self.raw[path]
+
+    def text(self, path):
+        return self.read(path).decode()
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        size = struct.calcsize(kind)
+        if len(raw) % size:
+            raise ValueError(f"Malformed native data at {path}")
+        return list(struct.unpack(f"<{len(raw)//size}{kind}", raw))
+
+    def tileset(self, label):
+        headers = self.text("src/data/tilesets/headers.h")
+        block = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", headers, re.S)
+        if not block:
+            raise ValueError(f"Unknown registered tileset {label} in {self.revision or 'current source'}")
+        declarations = self.text("src/data/tilesets/metatiles.h")
+        graphics = self.text("src/data/tilesets/graphics.h") + self.text("src/graphics.c")
+        paths = {}
+        for field in ("metatiles", "metatileAttributes", "tiles", "palettes"):
+            symbol = re.search(rf"\.{field}\s*=\s*(\w+)", block.group(1))
+            source = graphics if field in ("tiles", "palettes") else declarations
+            declaration = re.search(rf"\b{re.escape(symbol.group(1))}\s*\[.*?=\s*(.*?);", source, re.S) if symbol else None
+            path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1)) if declaration else None
+            if not path:
+                raise ValueError(f"Cannot resolve {label}.{field}")
+            paths[field] = path.group(1)
+        definitions = self.words(paths["metatiles"])
+        attributes = self.words(paths["metatileAttributes"], "I")
+        if len(definitions) != len(attributes)*8:
+            raise ValueError(f"Definition/attribute length mismatch: {label}")
+        # Consume the registered source artwork as provenance and ROM-freshness
+        # evidence. Generated .4bpp/.gbapal files are not a Git baseline source.
+        folder = Path(paths["tiles"]).parent
+        self.read(folder / "tiles.png")
+        palette_folder = Path(paths["palettes"]).parent
+        for n in range(16):
+            self.read(palette_folder / f"{n:02}.pal")
+        return {"label": label, "paths": paths, "definitions": definitions, "attributes": attributes}
+
+
+class CityMap:
+    def __init__(self, source, name="TaichungOldCity"):
+        self.source = source
+        self.data = source.json(f"data/maps/{name}/map.json")
+        self.layout = next(item for item in source.json("data/layouts/layouts.json")["layouts"]
+                           if item.get("id") == self.data["layout"])
+        self.width, self.height = self.layout["width"], self.layout["height"]
+        self.words = source.words(self.layout["blockdata_filepath"])
+        self.border = source.words(self.layout["border_filepath"])
+        if len(self.words) != self.width*self.height:
+            raise ValueError("Registered map length does not match registered dimensions")
+        self.banks = [source.tileset(self.layout[field]) for field in ("primary_tileset", "secondary_tileset")]
+        self.actors = {(obj["x"], obj["y"]) for obj in self.data.get("object_events", [])}
+        self.signs = {(obj["x"], obj["y"]) for obj in self.data.get("bg_events", []) if obj.get("type") == "sign"}
+        self.obstacles = self.actors | self.signs
+        # Apply the validator's real Map methods to the in-memory snapshot.
+        # Baseline bytes still come solely from Git; no snapshot files are made.
+        self.native = rules.Map.__new__(rules.Map)
+        self.native.data, self.native.layout, self.native.id = self.data, self.layout, self.data["id"]
+        self.native.width, self.native.height = self.width, self.height
+        self.native.cells, self.native.border = self.words, self.border
+        self.native.attributes = [bank["attributes"] for bank in self.banks]
+        self.native.actors, self.native.signs, self.native.obstacles = self.actors, self.signs, self.obstacles
+
+    def inspect(self, x, y):
+        if not (0 <= x < self.width and 0 <= y < self.height):
+            return None
+        word = self.words[y*self.width+x]
+        tile = word & 1023
+        bank, index = (self.banks[0], tile) if tile < 640 else (self.banks[1], tile-640)
+        attribute = bank["attributes"][index] if index < len(bank["attributes"]) else None
+        definition = bank["definitions"][index*8:index*8+8] if attribute is not None else None
+        behavior = attribute & 0x1FF if attribute is not None else None
+        collision = (word >> 10) & 3
+        ground = self.native.ground(x, y)
+        actor, sign = (x, y) in self.actors, (x, y) in self.signs
+        reasons = []
+        if attribute is None:
+            reasons.append("undefined-metatile")
+        if collision:
+            reasons.append("collision")
+        if behavior not in WALK:
+            reasons.append("unsupported-ordinary-walk-behavior")
+        if actor:
+            reasons.append("authored-actor-cell")
+        if sign:
+            reasons.append("authored-sign-cell")
+        return {"word": word, "wordHex": f"0x{word:04X}", "metatile": tile, "metatileHex": f"0x{tile:03X}",
+                "collision": collision, "elevation": word >> 12, "attribute": attribute, "behavior": behavior,
+                "ordinaryWalkingGround": ground, "actor": actor, "sign": sign,
+                "actorSignAwareWalkable": self.native.walkable(x, y),
+                "invalidReasons": reasons, "graphicReferences": definition}
+
+
+def component(city, anchor):
+    start = city.inspect(*anchor)
+    if start is None or not start["actorSignAwareWalkable"]:
+        return {}
+    distances, queue = {anchor: 0}, deque([anchor])
+    while queue:
+        x, y = queue.popleft()
+        current = city.inspect(x, y)
+        for point in ((x-1, y), (x+1, y), (x, y-1), (x, y+1)):
+            target = city.inspect(*point)
+            if point in distances or target is None or not target["actorSignAwareWalkable"]:
+                continue
+            if not city.native.can_step(x, y, city.native, *point):
+                continue
+            distances[point] = distances[(x, y)]+1
+            queue.append(point)
+    return distances
+
+
+def group_numbers(source):
+    groups = source.json("data/maps/map_groups.json")
+    return {name: [group, index] for group, key in enumerate(groups["group_order"])
+            for index, name in enumerate(groups[key])}
+
+
+def taichung_map_files(source, numbers):
+    return {source.json(f"data/maps/{name}/map.json")["id"]: name for name in numbers if name.startswith("Taichung")}
+
+
+def proof_landmarks(old, new, old_contract, new_contract, old_numbers, new_numbers):
+    old_files, new_files = taichung_map_files(old.source, old_numbers), taichung_map_files(new.source, new_numbers)
+    proofs = []
+    for landmark in old_contract["landmarks"]:
+        if landmark["exteriorMap"] != CITY:
+            continue
+        current = next(item for item in new_contract["landmarks"] if item["id"] == landmark["id"])
+        entrance, approach, arrival = landmark["entrance"], landmark["approach"], landmark["arrival"]
+        index = entrance["warpId"]
+        old_room = old.source.json(f"data/maps/{old_files[landmark['gymMap']]}/map.json")
