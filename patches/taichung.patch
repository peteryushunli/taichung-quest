diff --git a/tools/taichung/tile_limit_probe/build_probe.py b/tools/taichung/tile_limit_probe/build_probe.py
new file mode 100644
index 00000000..38d8bf0b
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/build_probe.py
@@ -0,0 +1,447 @@
+#!/usr/bin/env python3
+"""Build the tile limit probe: one streamed tile pool and four maps on it.
+
+Input is regions.json, ground_extra.png and art/ (written by extract_region.py):
+three pieces of the Boulevard Plan block fill as first drawn, installed with no
+design swapped. They are the places the whole-world count found hardest.
+
+  TaichungTileProbeA   dadun, columns 0-39     City Hall and the blocks east of it
+  TaichungTileProbeB   dadun, columns 40-87    the Jingming gate blocks and the canal
+  TaichungTileProbeC   oldcity                 the most tiles on one screen anywhere
+  TaichungTileProbeD   centralpark             the most palettes on one screen (more than the hardware has)
+
+All four share one pool of tiles and palettes; each has its own metatile table.
+A and B are connected, and metatiles either can see across their seam get the
+same number in both tables.
+
+Ground cells that the probe's primary tileset already has are placed by their
+metatile number. Everything else (the art, verges, highway and lake edges) is
+cut into 8x8 tiles here.
+
+Besides the game data this writes, for the QA harness:
+  probe-report.json     counts per map, events, the hardest places to stand
+  expected/<map>.png    what a correct engine shows, drawn from the generated data alone
+
+Run from the repository root:  python3 tools/taichung/tile_limit_probe/build_probe.py
+"""
+import io, json, os, struct, sys
+from PIL import Image
+
+from packing import assign_palettes, c24, cells8, flips, shared_art_palettes
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))
+PRIMARY_DIR = os.path.join(ROOT, 'data/tilesets/primary/taichung_approved_old_city_north')
+TILESET_DIR = os.path.join(ROOT, 'data/tilesets/secondary/taichung_tile_probe')
+
+NUM_TILES_IN_PRIMARY = 640
+NUM_METATILES_IN_PRIMARY = 640
+NUM_METATILES_TOTAL = 2048
+NUM_PALS_IN_PRIMARY = 7
+MAX_PALETTES = 64            # six palette bits per metatile tile entry
+MAX_TILES = 0x10000          # sixteen tile bits
+LAYER_NORMAL, LAYER_COVERED = 0, 1
+SEAM = 8                     # columns either side of a seam whose metatiles both tables number alike
+ELEVATION = 3
+COLLISION = 0x0400
+DOOR_METATILE = 0x03D        # METATILE_General_Door, which the primary tileset still carries
+FLOWER_TILES = range(508, 512)
+TILE_SLOTS = 1024 - 1 - len(FLOWER_TILES) - 8
+PALETTE_SLOTS = 13
+MAP_GROUP, FIRST_MAP = 43, 21   # gMapGroup_Taichung; the probe maps are appended after the live game's
+
+# name, region, first column, end column, and where things stand in region tiles (checked below)
+MAPS = [
+    dict(name='A', region='dadun', x0=0, x1=40, arrival=(20, 24), host=(21, 23), way_back=(18, 57), door=(23, 22), old_city=(18, 72)),
+    dict(name='B', region='dadun', x0=40, x1=88),
+    dict(name='C', region='oldcity', x0=0, x1=48, arrival=(20, 24), host=(21, 23), way_back=(14, 3), old_city=(20, 72)),
+    dict(name='D', region='centralpark', x0=0, x1=48, arrival=(12, 20), host=(13, 19), way_back=(1, 20), old_city=(22, 72)),
+]
+SEAMS = [('A', 'B')]         # left map, right map
+
+RG = json.load(open(os.path.join(HERE, 'regions.json')))
+
+# ---------------------------------------------------------------- art in, by colour
+sprites = {}
+for name in sorted(RG['sprites']):
+    im = Image.open(os.path.join(HERE, 'art', name + '.png')).convert('RGBA')
+    sprites[name] = (im, cells8(im))
+extra_cells = cells8(Image.open(os.path.join(HERE, 'ground_extra.png')).convert('RGBA'))
+
+palettes, where, extra_cells = assign_palettes(sprites, extra_cells)
+num_palettes = NUM_PALS_IN_PRIMARY + len(palettes)
+assert num_palettes <= MAX_PALETTES, num_palettes
+def pal_of(key): return NUM_PALS_IN_PRIMARY + where[key]
+
+# ---------------------------------------------------------------- tiles
+pool, pool_data = {}, []
+def entry_for(tile, pal):
+    """(tile number, flip bits, palette number) for an 8x8 tile of colours, or None if it is empty."""
+    if all(c is None for c in tile): return None
+    index = {c: i + 1 for i, c in enumerate(palettes[pal - NUM_PALS_IN_PRIMARY])}
+    t = [0 if c is None else index[c] for c in tile]
+    best, flip = min(flips(t))
+    if best not in pool:
+        pool[best] = len(pool_data); pool_data.append(best)
+    return (NUM_TILES_IN_PRIMARY + pool[best], flip, pal)
+
+# ---------------------------------------------------------------- primary ground
+pm = open(os.path.join(PRIMARY_DIR, 'metatiles.bin'), 'rb').read()
+primary_metatiles = struct.unpack('<%dH' % (len(pm) // 2), pm)
+pa = open(os.path.join(PRIMARY_DIR, 'metatile_attributes.bin'), 'rb').read()
+primary_attributes = struct.unpack('<%dI' % (len(pa) // 4), pa)
+def primary_entries(g, first=0, count=8):
+    return [None if raw & 0x3FF == 0 else (raw & 0x3FF, (raw >> 10) & 3, raw >> 12) for raw in primary_metatiles[g * 8 + first:g * 8 + first + count]]
+
+# ---------------------------------------------------------------- lay each region out
+def lay_out(region, doors):
+    R = RG['regions'][region]
+    W, H = len(R['ground'][0]), len(R['ground'])
+    ground = [row[:] for row in R['ground']]
+    solid = [[R['walk'][y][x] != '1' for x in range(W)] for y in range(H)]
+    art = {}     # (x, y) -> four top-layer entries
+    for o in sorted(R['objects'], key=lambda o: (o['y'] + o['h'], o['x'])):
+        if o['sprite'] == 'tree':
+            for i, n in enumerate(RG['tree']):
+                x, y = o['x'] + i % 2, o['y'] + i // 2
+                if 0 <= x < W and 0 <= y < H:
+                    ground[y][x] = n; solid[y][x] = True; art.pop((x, y), None)
+            continue
+        im, cells = sprites[o['sprite']]
+        pal = pal_of(('sprite', o['sprite']))
+        alpha = im.split()[3]
+        if o['mirrored']: alpha = alpha.transpose(Image.FLIP_LEFT_RIGHT)
+        if o['kind'] in ('building', 'landmark'):
+            bx0, by0, bx1, by1 = alpha.getbbox()
+            blocked = {(i, j) for j in range((by0 + 4) // 16, (by1 + 15) // 16) for i in range((bx0 + 4) // 16, (bx1 - 4 + 15) // 16)}
+        elif o['kind'] == 'plant':
+            blocked = {tuple(c) for c in o.get('solid', [])}
+        else:
+            blocked = set()
+            for j in range(o['h']):
+                for i in range(o['w']):
+                    box = alpha.crop((i * 16, j * 16, i * 16 + 16, j * 16 + 16))
+                    if sum(1 for v in box.tobytes() if v) >= 77: blocked.add((i, j))
+        for j in range(o['h']):
+            for i in range(o['w']):
+                x, y = o['x'] + i, o['y'] + j
+                if not (0 <= x < W and 0 <= y < H): continue
+                quad = []
+                for dy in (0, 1):
+                    for dx in (0, 1):
+                        if o['mirrored']:
+                            t = cells[(o['w'] * 2 - 1 - (i * 2 + dx), j * 2 + dy)]
+                            t = [v for r in range(8) for v in reversed(t[r * 8:r * 8 + 8])]
+                        else:
+                            t = cells[(i * 2 + dx, j * 2 + dy)]
+                        quad.append(entry_for(t, pal))
+                if any(quad):
+                    # A later sprite replaces an earlier one tile by tile, not cell by cell.
+                    under = art.get((x, y), [None] * 4)
+                    art[(x, y)] = [q if q else u for q, u in zip(quad, under)]
+                if (i, j) in blocked: solid[y][x] = True
+    for dx, dy in doors:
+        ground[dy][dx] = DOOR_METATILE; solid[dy][dx] = True; art.pop((dx, dy), None)
+
+    def key(x, y):
+        """None if the cell is a plain primary metatile, else (eight entries, layer type)."""
+        g = ground[y][x]
+        if g >= 0:
+            if (x, y) not in art: return None
+            bottom = primary_entries(g, 0, 4)
+        else:
+            k = -1 - g
+            bottom = [entry_for(extra_cells[(k * 2 + dx, dy)], pal_of(('extra', k * 2 + dx, dy))) for dy in (0, 1) for dx in (0, 1)]
+        if (x, y) in art: return (tuple(bottom + art[(x, y)]), LAYER_COVERED)
+        return (tuple(bottom + [None] * 4), LAYER_NORMAL)
+    return dict(W=W, H=H, ground=ground, solid=solid, keys=[[key(x, y) for x in range(W)] for y in range(H)])
+
+layouts = {}
+for region in RG['regions']:
+    layouts[region] = lay_out(region, [m['door'] for m in MAPS if m['region'] == region and 'door' in m])
+
+def unique(L, cells):
+    out = []; seen = set()
+    for x, y in cells:
+        k = L['keys'][y][x]
+        if k is not None and k not in seen: seen.add(k); out.append(k)
+    return out
+by_name = {m['name']: m for m in MAPS}
+tables = {}
+for m in MAPS:
+    L = layouts[m['region']]
+    shared = []
+    for a, b in SEAMS:
+        if m['name'] in (a, b):
+            split = by_name[b]['x0']
+            shared += unique(L, ((x, y) for y in range(L['H']) for x in range(split - SEAM, split + SEAM)))
+    own = [k for k in unique(L, ((x, y) for y in range(L['H']) for x in range(m['x0'], m['x1']))) if k not in set(shared)]
+    tables[m['name']] = shared + own
+    m['shared'] = len(shared)
+    assert NUM_METATILES_IN_PRIMARY + len(tables[m['name']]) <= NUM_METATILES_TOTAL, (m['name'], len(tables[m['name']]))
+assert NUM_TILES_IN_PRIMARY + len(pool_data) <= MAX_TILES
+
+# ---------------------------------------------------------------- write the tileset
+outputs = {}
+def write(path, data):
+    outputs[path] = data
+    return path
+tile_bytes = bytearray()
+for t in pool_data:
+    for i in range(0, 64, 2): tile_bytes.append(t[i] | (t[i + 1] << 4))
+write(os.path.join(TILESET_DIR, 'tiles.bin'), bytes(tile_bytes))
+pal_words = [0] * (16 * NUM_PALS_IN_PRIMARY)          # the first seven are the primary's and never read from here
+for p in palettes: pal_words += [0] + p + [0] * (15 - len(p))
+write(os.path.join(TILESET_DIR, 'palettes.bin'), struct.pack('<%dH' % len(pal_words), *pal_words))
+for name, table in tables.items():
+    raw, banks, attrs = [], bytearray(), []
+    for entries, layer in table:
+        for e in entries:
+            if e is None: raw.append(0); banks.append(0); continue
+            tile, flip, pal = e
+            raw.append((tile & 0x3FF) | (flip << 10) | ((pal & 0xF) << 12))
+            banks.append((tile >> 10) | ((pal >> 4) << 6))
+        attrs.append(layer << 29)
+    n = name.lower()
+    write(os.path.join(TILESET_DIR, f'metatiles_{n}.bin'), struct.pack('<%dH' % len(raw), *raw))
+    write(os.path.join(TILESET_DIR, f'banks_{n}.bin'), bytes(banks) + b'\0' * (-len(banks) % 4))
+    write(os.path.join(TILESET_DIR, f'metatile_attributes_{n}.bin'), struct.pack('<%dI' % len(attrs), *attrs))
+
+# ---------------------------------------------------------------- C sources that follow the map list
+def emit(path, text):
+    write(os.path.join(ROOT, path), text.encode('utf-8'))
+emit('src/data/tilesets/taichung_tile_probe_metatiles.h', '// Written by tools/taichung/tile_limit_probe/build_probe.py\n' + ''.join(f'''
+const u16 gMetatiles_TaichungTileProbe{n}[] = INCBIN_U16("data/tilesets/secondary/taichung_tile_probe/metatiles_{n.lower()}.bin");
+const u32 gMetatileAttributes_TaichungTileProbe{n}[] = INCBIN_U32("data/tilesets/secondary/taichung_tile_probe/metatile_attributes_{n.lower()}.bin");
+const u8 gMetatileBanks_TaichungTileProbe{n}[] = INCBIN_U8("data/tilesets/secondary/taichung_tile_probe/banks_{n.lower()}.bin");
+''' for n in tables))
+emit('src/data/tilesets/taichung_tile_probe_headers.h', '// Written by tools/taichung/tile_limit_probe/build_probe.py\n' + ''.join(f'''
+const struct Tileset gTileset_TaichungTileProbe{n} =
+{{
+    .isCompressed = FALSE,
+    .isSecondary = TRUE,
+    .tiles = gTilesetTiles_TaichungTileProbe,
+    .palettes = (const u16 (*)[16])gTilesetPalettes_TaichungTileProbe,
+    .metatiles = gMetatiles_TaichungTileProbe{n},
+    .metatileAttributes = gMetatileAttributes_TaichungTileProbe{n},
+    .callback = NULL,
+    .streamBanks = gMetatileBanks_TaichungTileProbe{n},
+    .streamNumTiles = {len(pool_data)},
+    .streamNumMetatiles = {len(t)},
+    .streamNumPalettes = {num_palettes},
+}};
+''' for n, t in tables.items()))
+# ---------------------------------------------------------------- the map grids
+def grid_bits(metatile, blocked):
+    return (metatile & 0x3FF) | ((metatile & 0x400) << 1) | (COLLISION if blocked else ELEVATION << 12)
+for m in MAPS:
+    L = layouts[m['region']]; index = {k: NUM_METATILES_IN_PRIMARY + i for i, k in enumerate(tables[m['name']])}
+    m['w'], m['h'] = m['x1'] - m['x0'], L['H']
+    m['cells'] = [[(L['ground'][y][x] if L['keys'][y][x] is None else index[L['keys'][y][x]]) for x in range(m['x0'], m['x1'])] for y in range(L['H'])]
+    m['solid'] = [[L['solid'][y][x] for x in range(m['x0'], m['x1'])] for y in range(L['H'])]
+    blocks = [grid_bits(m['cells'][y][x], m['solid'][y][x]) for y in range(m['h']) for x in range(m['w'])]
+    d = os.path.join(ROOT, 'data/layouts', 'TaichungTileProbe' + m['name'])
+    write(os.path.join(d, 'map.bin'), struct.pack('<%dH' % len(blocks), *blocks))
+    write(os.path.join(d, 'border.bin'), struct.pack('<4H', *RG['tree']))
+left_of = {b: a for a, b in SEAMS}; right_of = {a: b for a, b in SEAMS}
+
+def metatile_entries(name, metatile):
+    """Eight (tile, flip, palette) or None, and the layer type, as the engine reads them from this map's tables."""
+    if metatile < NUM_METATILES_IN_PRIMARY: return primary_entries(metatile), (primary_attributes[metatile] >> 29) & 3
+    entries, layer = tables[name][metatile - NUM_METATILES_IN_PRIMARY] if metatile - NUM_METATILES_IN_PRIMARY < len(tables[name]) else tables[name][0]
+    return list(entries), layer
+def metatile_at(m, x, y):
+    """The metatile the engine sees at local (x, y) of a map: its own cell, a connection strip, or the border."""
+    if 0 <= x < m['w'] and 0 <= y < m['h']: return m['cells'][y][x]
+    other = by_name.get(right_of.get(m['name']) if x >= m['w'] else left_of.get(m['name']))
+    if other is not None and 0 <= y < other['h']:
+        ox = x - m['w'] if x >= m['w'] else x + other['w']
+        if 0 <= ox < other['w'] and (ox <= 7 if x >= m['w'] else ox >= other['w'] - 7): return other['cells'][y][ox]
+    return RG['tree'][((x - 7) % 2) + ((y - 7) % 2) * 2]
+
+# ---------------------------------------------------------------- what a correct engine shows, and the hardest places
+tiles_4bpp = os.path.join(PRIMARY_DIR, 'tiles.4bpp')      # made from tiles.png by the game build
+primary_tiles = open(tiles_4bpp, 'rb').read() if os.path.exists(tiles_4bpp) else None
+def palette_colours(pal):
+    if pal < NUM_PALS_IN_PRIMARY:
+        d = open(os.path.join(PRIMARY_DIR, 'palettes', '%02d.gbapal' % pal), 'rb').read()
+        return [c24(v) for v in struct.unpack('<16H', d)]
+    return [(0, 0, 0)] + [c24(c) for c in palettes[pal - NUM_PALS_IN_PRIMARY]] + [(0, 0, 0)] * 15
+tile_images = {}
+def tile_image(tile, flip, pal):
+    k = (tile, flip, pal)
+    if k not in tile_images:
+        if tile < NUM_TILES_IN_PRIMARY:
+            raw = primary_tiles[tile * 32:tile * 32 + 32]; idx = [(raw[i // 2] >> (4 * (i % 2))) & 15 for i in range(64)]
+        else: idx = list(pool_data[tile - NUM_TILES_IN_PRIMARY])
+        cols = palette_colours(pal)
+        im = Image.new('RGBA', (8, 8)); im.putdata([(0, 0, 0, 0) if v == 0 else cols[v] + (255,) for v in idx])
+        if flip & 1: im = im.transpose(Image.FLIP_LEFT_RIGHT)
+        if flip & 2: im = im.transpose(Image.FLIP_TOP_BOTTOM)
+        tile_images[k] = im
+    return tile_images[k]
+MARGIN = 9
+report = {'source': RG['what'], 'tilePool': len(pool_data), 'palettes': {'primary': NUM_PALS_IN_PRIMARY, 'streamed': len(palettes)}, 'designs': len(sprites),
+          'paletteGroups': [list(names) for names, _ in shared_art_palettes],
+          'drawBudget': {'tiles': TILE_SLOTS, 'palettes': PALETTE_SLOTS, 'windowBound': [17, 17]},
+          'mapGroup': MAP_GROUP, 'margin': MARGIN, 'maps': {}}
+for number, m in enumerate(MAPS):
+    name = m['name']
+    if primary_tiles is not None:
+        im = Image.new('RGBA', ((m['w'] + 2 * MARGIN) * 16, (m['h'] + 2 * MARGIN) * 16), (0, 0, 0, 255))
+        for y in range(-MARGIN, m['h'] + MARGIN):
+            for x in range(-MARGIN, m['w'] + MARGIN):
+                entries, layer = metatile_entries(name, metatile_at(m, x, y))
+                for i, e in enumerate(entries):          # bottom four first, top four over them, whatever the layer type
+                    if e: t = tile_image(*e); im.paste(t, ((x + MARGIN) * 16 + (i % 2) * 8, (y + MARGIN) * 16 + ((i % 4) // 2) * 8), t)
+        png = io.BytesIO()
+        im.convert('RGB').save(png, format='PNG')
+        write(os.path.join(HERE, 'expected', name + '.png'), png.getvalue())
+    # tiles and palettes the draw window holds with the player on each cell that can be stood on
+    cell_need = {}
+    def need_at(px, py, size=16):
+        tiles, pals = set(), set()
+        for y in range(py - 7, py - 7 + size):
+            for x in range(px - 7, px - 7 + size):
+                mt = metatile_at(m, x, y)
+                if mt not in cell_need:
+                    es = [e for e in metatile_entries(name, mt)[0] if e]
+                    cell_need[mt] = ({e[0] for e in es if e[0] not in FLOWER_TILES}, {e[2] for e in es})
+                t, p = cell_need[mt]; tiles |= t; pals |= p
+        return len(tiles), len(pals)
+    spots = []; bound = {}
+    for y in range(m['h']):
+        for x in range(m['w']):
+            if m['solid'][y][x]: continue
+            if 8 <= x < m['w'] - 9 and 8 <= y < m['h'] - 9: spots.append((need_at(x, y), x, y))
+            # the engine redraws one row or column per step, so one stale row and column can still be held:
+            # the 17 x 17 window is an upper bound for any way of walking to this cell
+            bound[(x, y)] = need_at(x - 1, y - 1, 17)
+    def top(rank, count=4, apart=10):
+        out = []
+        for (t, p), x, y in sorted(spots, key=rank):
+            if all(abs(x - o['x']) >= apart or abs(y - o['y']) >= apart for o in out): out.append({'x': x, 'y': y, 'tiles': t, 'palettes': p})
+            if len(out) == count: break
+        return out
+    used_tiles, used_pals, used_metatiles = set(), set(), set()
+    flowers = []
+    for y in range(m['h']):
+        for x in range(m['w']):
+            mt = m['cells'][y][x]; used_metatiles.add(mt)
+            es = [e for e in metatile_entries(name, mt)[0] if e]
+            used_tiles |= {e[0] for e in es}; used_pals |= {e[2] for e in es}
+            if any(e[0] in FLOWER_TILES for e in es): flowers.append([x, y])
+    rect = RG['regions'][m['region']]['rect']
+    info = {'number': FIRST_MAP + number, 'region': m['region'], 'worldRect': [rect[0] + m['x0'], rect[1], rect[0] + m['x1'], rect[3]],
+            'size': [m['w'], m['h']], 'distinctTiles': len(used_tiles), 'distinctTilesFromPrimary': sum(1 for t in used_tiles if t < NUM_TILES_IN_PRIMARY),
+            'distinctMetatiles': len(used_metatiles), 'metatileTable': len(tables[name]), 'highestMetatile': max(used_metatiles), 'palettes': len(used_pals),
+            'sharedSeamMetatiles': m['shared'], 'rightOf': left_of.get(name), 'leftOf': right_of.get(name),
+            'solid': [''.join('1' if v else '0' for v in row) for row in m['solid']], 'flowerCells': flowers,
+            'hardestForTiles': top(lambda s: (-s[0][0], s[1], s[2])), 'hardestForPalettes': top(lambda s: (-s[0][1], -s[0][0], s[1], s[2])),
+            'mostPalettesAnyStandableCell': max(s[0][1] for s in spots), 'mostTilesAnyStandableCell': max(s[0][0] for s in spots),
+            'standableCellsOver13Palettes': sum(1 for s in spots if s[0][1] > 13),
+            'boundTilesWorst': max(v[0] for v in bound.values()), 'boundPalettesWorst': max(v[1] for v in bound.values()),
+            'boundPalettes': [''.join('#' if m['solid'][y][x] else chr(ord('a') + min(25, bound[(x, y)][1])) for x in range(m['w'])) for y in range(m['h'])]}
+    for k in ('arrival', 'host', 'way_back', 'door', 'old_city'):
+        if k in m:
+            cell = (m[k][0] - m['x0'], m[k][1]) if k != 'old_city' else m[k]
+            info[k] = list(cell)
+            if k in ('arrival', 'host', 'way_back'): assert not m['solid'][cell[1]][cell[0]], (name, k, cell)
+            if k == 'door': assert not m['solid'][cell[1] + 1][cell[0]], 'the door needs a walkable cell below it'
+    report['maps'][name] = info
+    for (x, y), (tiles, pals) in bound.items():
+        if tiles > TILE_SLOTS or pals > PALETTE_SLOTS:
+            raise SystemExit(f'Map {name} at ({x}, {y}) needs {tiles}/{TILE_SLOTS} tiles '
+                             f'and {pals}/{PALETTE_SLOTS} palettes. No files written.')
+
+# ---------------------------------------------------------------- maps, layouts, scripts
+def map_json(m):
+    name = m['name']; objects, coords, warps, connections = [], [], [], []
+    if 'host' in m:
+        objects.append({'type': 'object', 'graphics_id': 'OBJ_EVENT_GFX_WOMAN_1', 'x': m['host'][0] - m['x0'], 'y': m['host'][1], 'elevation': ELEVATION, 'movement_type': 'MOVEMENT_TYPE_FACE_DOWN',
+                        'movement_range_x': 0, 'movement_range_y': 0, 'trainer_type': 'TRAINER_TYPE_NONE', 'trainer_sight_or_berry_tree_id': '0', 'script': 'TaichungTileProbe_Host', 'flag': '0'})
+    if 'way_back' in m:
+        coords.append({'type': 'trigger', 'x': m['way_back'][0] - m['x0'], 'y': m['way_back'][1], 'elevation': ELEVATION, 'var': 'VAR_TEMP_1', 'var_value': '0', 'script': f'TaichungTileProbe_BackToOldCity{name}'})
+    if 'door' in m:
+        warps.append({'x': m['door'][0] - m['x0'], 'y': m['door'][1], 'elevation': 0, 'dest_map': 'MAP_TAICHUNG_GUEST_HOUSE_1F', 'dest_warp_id': '1'})
+    if name in right_of: connections.append({'map': 'MAP_TAICHUNG_TILE_PROBE_' + right_of[name], 'offset': 0, 'direction': 'right'})
+    if name in left_of: connections.append({'map': 'MAP_TAICHUNG_TILE_PROBE_' + left_of[name], 'offset': 0, 'direction': 'left'})
+    return {
+        'id': 'MAP_TAICHUNG_TILE_PROBE_' + name, 'name': 'TaichungTileProbe' + name, 'layout': 'LAYOUT_TAICHUNG_TILE_PROBE_' + name,
+        'music': 'MUS_VERMILLION', 'region_map_section': 'MAPSEC_TAICHUNG_XITUN', 'requires_flash': False, 'weather': 'WEATHER_SUNNY',
+        'map_type': 'MAP_TYPE_CITY', 'allow_cycling': True, 'allow_escaping': False, 'allow_running': True, 'show_map_name': True,
+        'floor_number': 0, 'battle_scene': 'MAP_BATTLE_SCENE_NORMAL', 'connections': connections or None,
+        'object_events': objects, 'warp_events': warps, 'coord_events': coords, 'bg_events': []}
+def rewrite_json(path, change):
+    p = os.path.join(ROOT, path); data = json.load(open(p)); change(data)
+    write(p, (json.dumps(data, indent=2) + '\n').encode('utf-8'))
+for m in MAPS:
+    d = os.path.join(ROOT, 'data/maps', 'TaichungTileProbe' + m['name'])
+    write(os.path.join(d, 'map.json'), (json.dumps(map_json(m), indent=2) + '\n').encode('utf-8'))
+def set_layouts(data):
+    data['layouts'] = [l for l in data['layouts'] if not (l and 'TILE_PROBE' in l.get('id', ''))]
+    for m in MAPS:
+        n = m['name']
+        data['layouts'].append({'id': f'LAYOUT_TAICHUNG_TILE_PROBE_{n}', 'name': f'TaichungTileProbe{n}_Layout', 'width': m['w'], 'height': m['h'], 'border_width': 2, 'border_height': 2,
+                                'primary_tileset': 'gTileset_TaichungTileProbePrimary', 'secondary_tileset': f'gTileset_TaichungTileProbe{n}',
+                                'border_filepath': f'data/layouts/TaichungTileProbe{n}/border.bin', 'blockdata_filepath': f'data/layouts/TaichungTileProbe{n}/map.bin'})
+rewrite_json('data/layouts/layouts.json', set_layouts)
+def set_group(data):
+    data['gMapGroup_Taichung'] = [n for n in data['gMapGroup_Taichung'] if not n.startswith('TaichungTileProbe')] + ['TaichungTileProbe' + m['name'] for m in MAPS]
+rewrite_json('data/maps/map_groups.json', set_group)
+def set_triggers(data):
+    data['coord_events'] = [c for c in data['coord_events'] if not c['script'].startswith('TaichungTileProbe')]
+    for m in MAPS:
+        if 'old_city' in m:
+            data['coord_events'].append({'type': 'trigger', 'x': m['old_city'][0], 'y': m['old_city'][1], 'elevation': 3, 'var': 'VAR_TEMP_1', 'var_value': '0', 'script': f"TaichungTileProbe_Enter{m['name']}"})
+rewrite_json('data/maps/TaichungOldCity/map.json', set_triggers)
+script = '''@ Written by tools/taichung/tile_limit_probe/build_probe.py
+''' + ''.join(f"TaichungTileProbe{m['name']}_MapScripts::\n" for m in MAPS) + '''	.byte 0
+
+@ A text box with a choice, then a wild battle and the way back from it.
+TaichungTileProbe_Host::
+	lock
+	faceplayer
+	msgbox TaichungTileProbe_Text_Host, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, TaichungTileProbe_HostDone
+	setwildbattle SPECIES_PIDGEY, 3
+	dowildbattle
+TaichungTileProbe_HostDone::
+	release
+	end
+
+TaichungTileProbe_Text_Host::
+	.string "This block holds more tiles than\\n"
+	.string "the game could load at once.\\p"
+	.string "Shall I call a wild POKéMON over?$"
+'''
+for m in MAPS:
+    if 'old_city' not in m: continue
+    script += f'''
+TaichungTileProbe_Enter{m['name']}::
+	lockall
+	warp MAP_TAICHUNG_TILE_PROBE_{m['name']}, {m['arrival'][0] - m['x0']}, {m['arrival'][1]}
+	waitstate
+	releaseall
+	end
+
+TaichungTileProbe_BackToOldCity{m['name']}::
+	lockall
+	warp MAP_TAICHUNG_OLD_CITY, {m['old_city'][0]}, {m['old_city'][1] - 1}
+	waitstate
+	releaseall
+	end
+'''
+emit('data/scripts/taichung_tile_probe.inc', script)
+write(os.path.join(HERE, 'probe-report.json'), json.dumps(report, indent=1).encode('utf-8'))
+for path, data in outputs.items():
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path + '.tmp', 'wb') as output:
+        output.write(data)
+    os.replace(path + '.tmp', path)
+print('tile pool', len(pool_data), '| palettes', num_palettes, '| designs', len(sprites))
+for n, i in report['maps'].items():
+    print(n, i['region'], i['size'], 'tiles', i['distinctTiles'], 'metatiles', i['distinctMetatiles'], 'to', i['highestMetatile'], 'palettes', i['palettes'],
+          '| on screen at worst (standing): tiles', i['mostTilesAnyStandableCell'], 'palettes', i['mostPalettesAnyStandableCell'], 'cells over 13:', i['standableCellsOver13Palettes'],
+          '| bound while moving: tiles', i['boundTilesWorst'], 'palettes', i['boundPalettesWorst'], 'cells over 13:', sum(row.count(c) for row in i['boundPalettes'] for c in 'opqrstuvwxyz'),
+          '| hardest', [(s['x'], s['y'], s['tiles']) for s in i['hardestForTiles'][:2]], [(s['x'], s['y'], s['palettes']) for s in i['hardestForPalettes'][:2]])
