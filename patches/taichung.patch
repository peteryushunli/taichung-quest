diff --git a/tests/taichung_badge_rewards_test.c b/tests/taichung_badge_rewards_test.c
new file mode 100644
index 0000000..27059c5
--- /dev/null
+++ b/tests/taichung_badge_rewards_test.c
@@ -0,0 +1,199 @@
+#include "global.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWrites;
+static bool8 sWriteFails;
+static bool8 sWriteIgnored;
+static const u16 sTrainers[TAICHUNG_GYM_COUNT] = {
+    TRAINER_TAICHUNG_STATION_JUN, TRAINER_TAICHUNG_PARK_LIAN,
+    TRAINER_TAICHUNG_MIYAHARA_PEIQI, TRAINER_TAICHUNG_SCIENCE_YICHENG,
+    TRAINER_TAICHUNG_GREENWAY_XINGAN, TRAINER_TAICHUNG_SHEN_JI_AXIU,
+    TRAINER_TAICHUNG_FINE_ARTS_CAINING, TRAINER_TAICHUNG_FENGJIA_JIAHE,
+    TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING, TRAINER_TAICHUNG_THEATER_LING
+};
+
+u16 VarGet(u16 id)
+{
+    (void)id;
+    assert(0 && "Badge collection must read real saved progress, not quest replay");
+    return 0;
+}
+
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_GYM_COMPLETION_VAR);
+    if (sWriteFails)
+        return FALSE;
+    if (!sWriteIgnored)
+    {
+        sSave.vars[id - 0x4000] = value;
+        sWrites++;
+    }
+    return TRUE;
+}
+
+static void Reset(u16 mask)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    gSaveBlock1Ptr = &sSave;
+    sSave.vars[0xF7] = 9;
+    sSave.vars[0xF8] = 1;
+    sSave.vars[0xF9] = 3;
+    sSave.vars[0xFA] = mask;
+    sSave.vars[0xFB] = 2;
+    sSave.vars[0xFC] = 4;
+    sSave.vars[0xFD] = 1;
+    sWrites = 0;
+    sWriteFails = FALSE;
+    sWriteIgnored = FALSE;
+    TaichungGymCancelChallenge();
+}
+
+static void Start(u16 gym)
+{
+    assert(TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+    assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+    TaichungGymOnTrainerBattleStart(sTrainers[gym]);
+    assert(TaichungGymIsBadgeChallenge(sTrainers[gym]));
+    assert(!TaichungGymIsBadgeChallenge(TRAINER_YOUNGSTER_BEN));
+}
+
+static void TestAllPriorMasks(void)
+{
+    u16 gym, mask;
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        for (mask = 0; mask <= TAICHUNG_GYM_ALL_MASK; mask++)
+        {
+            u16 expected[256];
+            Reset(mask);
+            memcpy(expected, sSave.vars, sizeof(expected));
+            // Saved legitimate wins render in the collection, without replaying
+            // an award or making a write, including all old-save combinations.
+            assert(TaichungGymGetCompletedMask() == mask);
+            assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+            if (mask & (1 << gym))
+            {
+                assert(!TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+                TaichungGymOnTrainerBattleStart(sTrainers[gym]);
+                assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+                TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+                assert(!TaichungGymConsumeNewBadge(gym));
+                assert(sWrites == 0 && !memcmp(expected, sSave.vars, sizeof(expected)));
+                continue;
+            }
+            Start(gym);
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+            assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+            expected[0xFA] |= 1 << gym;
+            assert(sWrites == 1 && !memcmp(expected, sSave.vars, sizeof(expected)));
+            assert(!TaichungGymConsumeNewBadge((gym + 1) % TAICHUNG_GYM_COUNT));
+            assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_COUNT));
+            assert(!TaichungGymConsumeNewBadge(0xFFFF));
+            // Repeated end notifications cannot manufacture another award, or
+            // erase the still-unconsumed presentation of the real first win.
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+            assert(TaichungGymConsumeNewBadge(gym));
+            assert(!TaichungGymConsumeNewBadge(gym));
+            assert(!TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+            assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 1);
+        }
+    }
+}
+
+static void TestNonWinsAndMissingEvents(void)
+{
+    u16 gym;
+    u8 outcome;
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        for (outcome = 0; outcome < 16; outcome++)
+        {
+            if (outcome == B_OUTCOME_WON)
+                continue;
+            Reset(0);
+            Start(gym);
+            TaichungGymOnTrainerBattleEnd(sTrainers[gym], outcome);
+            assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+        }
+        Reset(0);
+        assert(TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        Start(gym);
+        TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN, B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        assert(TaichungGymPrepareChallenge(gym, sTrainers[gym]));
+        TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+        assert(!TaichungGymIsBadgeChallenge(TRAINER_YOUNGSTER_BEN));
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        Start(gym);
+        TaichungGymCancelChallenge(); // Decline/skipped battle/replay/Continue reset.
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+
+        Reset(0);
+        TaichungGymOnTrainerBattleStart(sTrainers[gym]); // Unprepared ordinary battle.
+        assert(!TaichungGymIsBadgeChallenge(sTrainers[gym]));
+        TaichungGymOnTrainerBattleEnd(sTrainers[gym], B_OUTCOME_WON);
+        assert(!TaichungGymConsumeNewBadge(gym) && sWrites == 0);
+    }
+}
+
+static void TestFailedWriteAndVolatileReset(void)
+{
+    Reset(0);
+    Start(TAICHUNG_GYM_PARK);
+    sWriteFails = TRUE;
+    TaichungGymOnTrainerBattleEnd(sTrainers[TAICHUNG_GYM_PARK], B_OUTCOME_WON);
+    assert(TaichungGymGetLastResult() != TAICHUNG_GYM_RESULT_WON);
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK) && sWrites == 0);
+
+    Reset(0);
+    Start(TAICHUNG_GYM_PARK);
+    sWriteIgnored = TRUE;
+    TaichungGymOnTrainerBattleEnd(sTrainers[TAICHUNG_GYM_PARK], B_OUTCOME_WON);
+    assert(TaichungGymGetLastResult() != TAICHUNG_GYM_RESULT_WON);
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK) && sWrites == 0);
+
+    Reset(0);
+    Start(TAICHUNG_GYM_PARK);
+    TaichungGymOnTrainerBattleEnd(sTrainers[TAICHUNG_GYM_PARK], B_OUTCOME_WON);
+    TaichungGymCancelChallenge(); // New/Continue cannot re-award an old win.
+    assert(TaichungGymIsComplete(TAICHUNG_GYM_PARK));
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK));
+    assert(sWrites == 1);
+
+    Reset(0);
+    // Preparing an unrelated trainer is not an explicit registered gym battle,
+    // even if a caller pairs it with a valid gym ID.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK, TRAINER_YOUNGSTER_BEN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    assert(!TaichungGymIsBadgeChallenge(TRAINER_YOUNGSTER_BEN));
+    TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN, B_OUTCOME_WON);
+    assert(!TaichungGymConsumeNewBadge(TAICHUNG_GYM_PARK));
+}
+
+int main(void)
+{
+    TestAllPriorMasks();
+    TestNonWinsAndMissingEvents();
+    TestFailedWriteAndVolatileReset();
+    puts("PASS: all ten registered gym battles/all1024 masks; new-win consume-once badge events; old-save collection/no popup; nonwins/missing/wrong/cancel/replay-reset guards; registered-only cashless query; failed writes; protected variables.");
+    return 0;
+}
