index 0000000..fbc630e
--- /dev/null
+++ b/tests/test_chinese_glyph_font.py
@@ -0,0 +1,104 @@
+"""Host checks for bitmap-source integrity and the persistent FC19 codebook."""
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+GAME = Path(__file__).resolve().parents[1]
+TOOLS = GAME / 'tools/taichung_gameplay'
+SPEC = importlib.util.spec_from_file_location('native_glyph_append', TOOLS / 'extend-chinese-glyphs.py')
+APPEND = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(APPEND)
+
+
+class BitmapGlyphTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.font = APPEND.load_font(GAME)
+        cls.charmap = (GAME / 'charmap.txt').read_bytes()
+        cls.header = (GAME / 'src/data/taichung_glyphs.h').read_bytes()
+        cls.existing = APPEND.parse_existing(cls.charmap, cls.header)
+
+    def fixture(self, path):
+        shutil.copytree(GAME / 'assets/fonts/fusion-pixel-12', path / 'assets/fonts/fusion-pixel-12')
+        shutil.copyfile(GAME / 'assets/fonts/taichung-native-font.json', path / 'assets/fonts/taichung-native-font.json')
+        (path / 'src/data').mkdir(parents=True)
+        (path / 'charmap.txt').write_bytes(self.charmap)
+        (path / 'src/data/taichung_glyphs.h').write_bytes(self.header)
+        (path / 'src/start_menu.c').write_text('/* retained menu fixture */\n')
+        (path / 'src/taichung_language.c').write_text('/* retained translation fixture */\n')
+        return path
+
+    def run_helper(self, name, game, artifacts, *extra):
+        result = subprocess.run([sys.executable, str(TOOLS / name), '--game', str(game),
+                                 '--artifacts', str(artifacts), *extra], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return result
+
+    def test_every_existing_glyph_matches_pinned_bitmap_without_clipping(self):
+        self.assertEqual(self.font.metadata['provider'], 'bdf-gzip')
+        for row in self.existing['rows']:
+            self.assertEqual(row['masks'], self.font.render(row['character']))
+            self.assertEqual(len(row['masks']), 14)
+            self.assertTrue(all(0 <= mask <= 0xfff for mask in row['masks']))
+
+    def test_append_keeps_every_old_mapping_and_row_and_uses_same_source(self):
+        with tempfile.TemporaryDirectory() as folder:
+            game = self.fixture(Path(folder) / 'game')
+            char = next(c for c in '字像鯨貓蝶嶺' if c not in self.existing['mappings'] and ord(c) in self.font.glyphs)
+            (game / 'src/taichung_test.c').write_text('static const u8 sExample[] = _("' + char + '");\n')
+            self.run_helper('extend-chinese-glyphs.py', game, Path(folder) / 'report', '--write')
+            cmap = (game / 'charmap.txt').read_bytes()
+            current = APPEND.parse_existing(cmap, (game / 'src/data/taichung_glyphs.h').read_bytes())
+            self.assertTrue(cmap.startswith(self.charmap))
+            self.assertEqual(current['rows'][:-1], self.existing['rows'])
+            self.assertEqual(current['rows'][-1]['character'], char)
+            self.assertEqual(current['rows'][-1]['index'], len(self.existing['rows']))
+            self.assertEqual(current['rows'][-1]['masks'], self.font.render(char))
+
+    def test_refresh_is_idempotent_and_does_not_rewrite_content_or_codes(self):
+        with tempfile.TemporaryDirectory() as folder:
+            game = self.fixture(Path(folder) / 'game')
+            protected = {p: (game / p).read_bytes() for p in ['src/start_menu.c', 'src/taichung_language.c', 'charmap.txt']}
+            self.run_helper('refresh-chinese-glyphs.py', game, Path(folder) / 'one', '--write')
+            self.assertEqual((game / 'src/data/taichung_glyphs.h').read_bytes(), self.header)
+            for path, raw in protected.items():
+                self.assertEqual((game / path).read_bytes(), raw)
+            self.run_helper('refresh-chinese-glyphs.py', game, Path(folder) / 'two', '--write')
+            report = json.loads((Path(folder) / 'two/refresh-chinese-glyphs.json').read_text())
+            self.assertEqual(report['changedExistingShapes'], 0)
+            self.assertEqual(report['addedGlyphCount'], 0)
+            self.assertEqual(report['before'], report['candidate'])
+
+    def test_wrong_source_checksum_is_rejected(self):
+        with tempfile.TemporaryDirectory() as folder:
+            game = self.fixture(Path(folder) / 'game')
+            source = game / json.loads((game / 'assets/fonts/taichung-native-font.json').read_text())['source']
+            raw = bytearray(source.read_bytes())
+            raw[-1] ^= 1
+            source.write_bytes(raw)
+            with self.assertRaisesRegex(ValueError, 'checksum mismatch'):
+                APPEND.load_font(game)
+
+    def test_legacy_noto_cannot_silently_mix_with_bitmap_source(self):
+        with self.assertRaisesRegex(ValueError, 'authoritative'):
+            APPEND.load_font(GAME, Path('/unused/NotoSansTC.ttf'))
+
+    def test_missing_character_fails_without_notdef_or_fallback(self):
+        with self.assertRaisesRegex(ValueError, 'no fallback'):
+            self.font.render(chr(0x10ffff))
+
+    def test_bitmap_that_would_clip_is_rejected(self):
+        font = APPEND.load_font(GAME)
+        font.glyphs[ord('字')] = 'DWIDTH 12 0\nBBX 13 1 0 0\nBITMAP\nFFF8\nENDCHAR\n'
+        with self.assertRaisesRegex(ValueError, 'would clip'):
+            font.render('字')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_gym_staff_guard.py b/tests/test_gym_staff_guard.py
