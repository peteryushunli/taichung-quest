+#!/usr/bin/env python3
+"""Build provisional native prefabs from existing source tiles, never map grids."""
+import json
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[3]
+CATALOG = ROOT / "data/taichung/prefabs/catalog.json"
+
+
+def words(path):
+    raw = path.read_bytes()
+    return struct.unpack(f"<{len(raw)//2}H", raw)
+
+
+def build_catalog():
+    layouts = json.loads((ROOT / "data/layouts/layouts.json").read_text())["layouts"]
+    layout = next(x for x in layouts if x.get("id") == "LAYOUT_PEWTER_CITY")
+    source = words(ROOT / layout["blockdata_filepath"])
+    attributes = []
+    for folder in ("primary/general", "secondary/pewter_city"):
+        raw = (ROOT / "data/tilesets" / folder / "metatile_attributes.bin").read_bytes()
+        attributes.append(struct.unpack(f"<{len(raw)//4}I", raw))
+
+    def behavior(tile):
+        which, index = (0,tile) if tile < 640 else (1,tile-640)
+        return attributes[which][index] & 0x1ff
+
+    def rect(box):
+        x0,y0,x1,y1 = box
+        return [[source[y*layout['width']+x] & 0x3ff for x in range(x0,x1+1)] for y in range(y0,y1+1)]
+
+    prefabs = []
+
+    def add(identity, title, role, body, context, material, provenance, entrances=(), traversable=(), note=""):
+        """Include a clear apron, keep every entrance dormant until native wiring."""
+        body = [row[:] for row in body]
+        width, body_height = len(body[0]), len(body)
+        assert all(len(row)==width for row in body)
+        # A copied vanilla door must never become an unpaired decorative warp.
+        for y,row in enumerate(body):
+            for x,tile in enumerate(row):
+                if 0x60 <= behavior(tile) <= 0x6f:
+                    body[y][x] = 0x02e
+        for entry in entrances:
+            body[entry[2]][entry[1]] = entry[3]
+        clear = set(traversable) | {(x,body_height) for x in range(width)}
+        grid = [[(0x3000|tile) if (x,y) in clear else (0x0400|tile) for x,tile in enumerate(row)] for y,row in enumerate(body)]
+        grid.append([0x3175]*width)
+        solid = ["".join('0' if (x,y) in clear else '1' for x in range(width)) for y in range(body_height)] + ['0'*width]
+        paint = ['1'*width for _ in range(body_height)] + ['0'*width]
+        required_clear = ["".join('1' if (x,y) in clear else '0' for x in range(width)) for y in range(body_height+1)]
+        entries = [dict(id=e[0],position=[e[1],e[2]],southApproach=[e[1],e[2]+1],
+                        dormantWord=f'0x{0x400|e[3]:04X}',activeDoorWord='0x043D',
+                        activation='requires-authored-exterior-warp-and-paired-interior-return') for e in entrances]
+        prefabs.append(dict(id=identity,name=title,status='implemented-source-blockout',role=role,
+            artStatus='provisional-native-reuse',taiwanSpecificArt=False,material=material,
+            allowedContext=context,allowedGround=['mowed-grass','paving'],
+            anchorBasis='top-left of entire patch; final row is a mandatory-clear unpainted apron',
+            width=width,height=body_height+1,bodyHeight=body_height,
+            words=[[f'0x{w:04X}' for w in row] for row in grid],
+            masks=dict(paint=paint,solid=solid,mandatoryClear=required_clear),
+            entrances=entries,requires=dict(primary='gTileset_General',secondary='gTileset_PewterCity' if any((w&0x3ff)>=640 for row in grid for w in row) else None),
+            provenance=provenance,notes=note or 'Temporary FireRed source artwork; replace with Taiwan streetscape skin while retaining dimensions/anchors.'))
+
+    house = rect((32,8,36,11))
+    closed_house = [row[:] for row in house]
+    closed_house[-1][1] = 0x2be
+    source_house = dict(map='PewterCity',rect=[32,8,36,11],transforms=['force-solid-building-footprint','replace-vanilla-door-with-dormant-wall','append-clear-apron'])
+    add('building-rowhouse-compact','Compact rowhouse','residential-lowrise',closed_house,['residential','mixed-use'],'blue-grey roof / pale masonry',source_house,
+        entrances=[('front',1,3,0x2be)])
+    pair = [row+row for row in closed_house]
+    add('building-rowhouse-pair','Paired rowhouses','residential-lowrise',pair,['residential','mixed-use'],'repeated blue-grey façade',
+        dict(**source_house,repeatHorizontal=2),entrances=[('west-front',1,3,0x2be),('east-front',6,3,0x2be)])
+    corner = [row[:] for row in closed_house]
+    corner[-2][1:4] = [0x180,0x181,0x182]
+    corner[-1][1:4] = [0x194,0x194,0x194]
+    add('building-corner-store','Corner storefront','commercial-frontage',corner,['shopping','mixed-use','residential-corner'],'wide blue display window',
+        dict(**source_house,frontagePatch=['General180','General181','General182','General194']),
+        entrances=[('front',1,3,0x194)],note='Display-window variation of the source house; intended for a later Taiwan corner-shop/arcade skin. Closed by default; no storefront brand implied.')
+    wide = rect((12,12,18,16))
+    wide[3][1] = 0x155
+    wide[3][3] = 0x155
+    wide[4][1] = 0x15d
+    wide[4][3] = 0x15d
+    add('building-shopfront-wide','Wide shopfront','commercial-frontage',wide,['shopping','mixed-use'],'timber-tone roof / blue shop windows',
+        dict(map='PewterCity',rect=[12,12,18,16],transforms=['remove-gym-emblem','replace-vanilla-sliding-door','force-solid-building-footprint']),
+        entrances=[('front',3,4,0x15d)],note='Reuses the source gym shell with both its central emblem and GYM lettering removed. This is an ordinary shop prefab, not a gym or finished Taiwanese storefront.')
+    for floors,label in ((1,'low'),(2,'tall')):
+        window_top=[0x2a0,0x2a1,0x2a1,0x2a1,0x2a6]
+        window_bottom=[0x2a8,0x2a9,0x2a9,0x2a9,0x2ae]
+        body = closed_house[:3]+[row[:] for _ in range(floors) for row in (window_top,window_bottom)]
+        add('building-walkup-'+label,('Low' if label=='low' else 'Tall')+' walk-up','residential-walkup',body,
+            ['residential','mixed-use'],'stacked pale façade / blue windows',dict(**source_house,repeatWindowBand=floors),
+            entrances=[('front',2,len(body)-1,0x2be)],note='Repeated museum-source window pairs create an apartment-scale blockout. Window/floor rhythm is provisional, not real Taichung architecture.')
+    service = rect((12,0,22,6))
+    service[5][5] = 0x2a9
+    service[6][5] = 0x2a9
+    add('building-service-hall','Wide service hall','civic-service',service,['civic','institutional','neighborhood-centre'],
+        'pink roof / light stone façade',dict(map='PewterCity',rect=[12,0,22,6],transforms=['replace-museum-display','replace-vanilla-door','force-solid-building-footprint']),
+        entrances=[('front',5,6,0x2a9)],note='Museum-derived source shell, intended as a generic service building only. Not a named Taichung landmark or new gym.')
+    kiosk = [[0x028,0x029,0x02a,0x02b],[0x030,0x031,0x032,0x033],[0x034,0x035,0x036,0x037],[0x03c,0x03e,0x03e,0x03f]]
+    add('building-kiosk-glass','Glass-roof kiosk','neighborhood-service',kiosk,['shopping','park-edge','transport-plaza'],'blue glass / cream frame',
+        dict(tileset='General',construction='native four-column roof, wall and frame metatiles'),entrances=[('front',1,3,0x03e)])
+    stall = [[0x048,0x049,0x04a,0x04b],[0x050,0x051,0x052,0x053],[0x054,0x055,0x056,0x057]]
+    add('stall-market-red','Red-roof market stall','market-stall',stall,['market','shopping','festival'],
+        'red roof / yellow brick counter',dict(tileset='General',construction='complete native four-column red roof and frontage'),
+        note='Closed counter module with no door or interior reservation. Temporary roof art, not a realistic Taiwanese market stall yet.')
+    add('prop-sign-board','Wooden sign board','street-furniture',[[0x003]],['street','park-edge','plaza'],'wood',
+        dict(tileset='General',metatiles=['0x003']),note='Blocked sign tile. Background-event script is not attached by this library; the map owner may reserve it separately.')
+    add('prop-shrub','Round shrub','planting',[[0x005]],['park-edge','residential','plaza'],'green foliage',dict(tileset='General',metatiles=['0x005']))
+    add('prop-flower-bed','Three-wide flower bed','planting',[[0x004]*3],['park-edge','plaza','residential'],'red flowers / green foliage',dict(tileset='General',metatiles=['0x004']))
+    tree = [[0x00e,0x00f],[0x016,0x017]]
+    add('prop-tree-wide','Wide tree','planting',tree,['park','park-edge','residential'],'green foliage',dict(tileset='General',construction='complete native2x2 mowed-ground tree'))
+    add('prop-tree-line','Paired tree line','planting',[row+row for row in tree],['park','park-edge','street-edge'],'green foliage',dict(tileset='General',construction='two complete2x2 trees'))
+    gate = [[0x00e,0x00f,0x175,0x00e,0x00f],[0x016,0x017,0x175,0x016,0x017]]
+    add('prop-park-gateway','Tree-framed park opening','park-edge',gate,['park-edge','plaza'],'green trees / clear paving',
+        dict(tileset='General',construction='two source trees and a one-tile clear pedestrian passage'),traversable=[(2,0),(2,1)])
+    add('prop-low-brick-edge','Low brick edge','park-edge',[[0x17b,0x17c,0x17c,0x17f]],['park-edge','street-edge','plaza'],
+        'red brick / light trim',dict(tileset='General',metatiles=['0x17B','0x17C','0x17F']))
+    # A walkable surface module can be placed only on clear ground, like its apron.
+    add('ground-paving-pad','Paving pad','ground-surface',[[0x175]*4 for _ in range(2)],['street','plaza','park-path'],'light paving',
+        dict(tileset='General',metatiles=['0x175']),traversable=[(x,y) for y in range(2) for x in range(4)],note='Walkable source paving; all cells require clear elevation3 ground. It cannot bridge water or override collision.')
+    reservations = [dict(id=i,role=role,status='requires-custom-native-art',proposedDimensions=d,
+                         notes='Category reservation only; no native words, collision footprint or implemented visual asset.')
+                    for i,role,d in [('prop-parked-scooter','street-furniture',[1,2]),('prop-youbike-rack','transport',[4,2]),
+                                     ('prop-bus-shelter','transport',[4,3]),('prop-bench','street-furniture',[2,1]),('prop-traffic-light','street-furniture',[1,2])]]
+    return dict(schemaVersion=1,coordinateSystem='zero-based native16x16 metatiles; top-left patch anchor',
+        status='source-compatible reusable blockout library; Taiwan-specific art pending',
+        tilesetContract=dict(primary='gTileset_General',secondary='gTileset_PewterCity',primaryGraphicsTiles=640,
+                             secondaryGraphicsCapacity=384,totalGraphicsCapacity=1024,activeBackgroundPalettes=13,
+                             primaryPaletteIndices=list(range(7)),secondaryPaletteIndices=list(range(7,13))),
+        placementContract=dict(defaultEntranceMode='dormant',apron='final row; preserved from destination ground',
+            protectedPaths='solid/building cells cannot overlap reserved street/path cells',
+            activation='Only explicit bindings verified against authored native map.json exterior and paired interior return activate a door.',
+            mapMutation='None. Composer returns words and an entrance manifest; map owner performs native integration.'),
+        prefabs=prefabs,artReservations=reservations)
+
+
+if __name__=='__main__':
+    catalog=build_catalog()
+    CATALOG.parent.mkdir(parents=True,exist_ok=True)
+    CATALOG.write_text(json.dumps(catalog,indent=2)+'\n')
+    print(f"Wrote {len(catalog['prefabs'])} implemented prefabs and {len(catalog['artReservations'])} art reservations: {CATALOG}")
