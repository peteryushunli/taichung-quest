+            "v9FallbackChanged": (special,{SAVE:save.replace(b"{%d, %d, %d, %d}" % first,b"{%d, %d, 12, 33}" % first[:2],1)}),
+            "v9WarpPriorityRemoved": (special,{SAVE:save.replace(b"sourceVersion < 9 && IsXitun(warp) && warp->warpId == -1",b"sourceVersion < 9 && IsXitun(warp)",1)}),
+            "v9AgeGateTooLow": (special,{SAVE:save.replace(b"sourceVersion < 9 && IsXitun",b"sourceVersion < 8 && IsXitun",1)}),
+            "v9BeforeHistoricalV8": (special,{SAVE:save.replace(old8+b"\n"+new9,new9+b"\n"+old8,1)}),
+            "known8Missing": ("versionGates",{SAVE:save.replace(b" || version == 8)",b")",1)}),
+            "oldDistrictRefreshLost": ("versionGates",{SAVE:save.replace(b"IsOldCity(warp) || IsGreenway(warp) || IsXitun(warp)",b"IsXitun(warp)",1)}),
+            "historicalV8MapShaChanged": ("repairTable",{SAVE:save.replace(COLLISION_OLD_MAP_SHA.encode(),b"0"*64,1)}),
+            "parkNewGameResetRemoved": (special,{SAVE:save.replace(b"    TaichungGymCancelChallenge();\n",b"",1)}),
+            "parkContinueResetRemoved": (special,{SAVE:save.replace(b"    TaichungGymCancelChallenge();\n",b"",2)}),
+            "facingHandoffRemoved": (special,{SAVE:save.replace(b"    RememberCacheRefreshFacing(warp);",b"    /* removed handoff */",1)}),
+            "nativeHookChanged": (special,{"src/overworld.c":read("src/overworld.c")+b"\n"}),
+            "historicalCheckpointHelperChanged": (special,{SAVE:save.replace(b"    warp->x = 30;",b"    warp->x = 31;",1)}),
+            "collisionArtChanged": (special,{alpha_path:encoded.getvalue()}),
+            "objectReopened": (special,{tool.MAP:map_with(first[0],first[1],struct.unpack_from("<H",read(tool.MAP),(first[1]*WIDTH+first[0])*2)[0]&~0xC00)}),
+            "extra45thBlock": (special,{tool.MAP:map_with(12,35,0x3575)}),
+            "collisionMetatileChanged": (special,{tool.MAP:map_with(first[0],first[1],struct.unpack_from("<H",read(tool.MAP),(first[1]*WIDTH+first[0])*2)[0]^1)}),
+            "collisionElevationChanged": (special,{tool.MAP:map_with(first[0],first[1],struct.unpack_from("<H",read(tool.MAP),(first[1]*WIDTH+first[0])*2)[0]^0x1000)}),
+            "nativeDoorChanged": (special,{tool.MAP:map_with(12,32,0x3175)}),
+            "v8HeaderUnderCollisionMap": ("versionGates",{HEADER:header.replace(b"TAICHUNG_SAVE_VERSION 9",b"TAICHUNG_SAVE_VERSION 8",1)}),
+            "v9UnderHistoricalMap": (special,{tool.MAP:support.Files(source,COLLISION_BASE).read(tool.MAP)}),
+        })
+        for path in COLLISION_PINS:
+            faults["collisionPinChanged:"+path]=(special,{path:read(path)+b"\n"})
+    results = {}
+    for name, (section, edits) in faults.items():
+        changed = all(read(path) != content for path, content in edits.items())
+        report = check(source, edits)
+        results[name] = changed and not report["passed"] and not report["checks"].get(section, {}).get("passed", True)
+    return results
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--self-test", action="store_true")
+    parser.add_argument("--host-rows", action="store_true", help="Print host test rows from the actual maps")
+    args = parser.parse_args()
+    if args.host_rows:
+        host_rows(args.source.resolve())
+        return
+    report = check(args.source)
+    if args.self_test:
+        report["faultProbes"] = self_test(args.source)
+        if not all(report["faultProbes"].values()):
+            report["passed"] = False
+            report["errors"].append("A corruption probe escaped the Xitun streets check")
+    print(json.dumps(report, indent=2))
+    raise SystemExit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
