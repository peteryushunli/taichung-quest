@@ -0,0 +1,48 @@
+// Sweep the actual compiled cartridge with controller input, not RAM movement.
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { open } from '../north-xitun/cdp.mjs';
+import { installTravelEmulator } from '../north-xitun/emulator.mjs';
+const qa = process.argv[2];
+const read = async name => JSON.parse(await readFile(join(qa,name),'utf8'));
+const cases = await read('movement-cases.json');
+const metadata = await read('roms/build.json');
+const results=[];
+for(const [i,site] of cases.entries()) {
+  const plan=await read(site.id+'-plan.json');
+  const fixture=(await readFile(join(qa,site.id+'.sav'))).toString('base64');
+  for(const [j,mode] of ['walk','bike'].entries()) {
+    const browser=await open({url:'http://127.0.0.1:8341/',debugPort:9381+i*2+j,outDir:qa,
+      bootstrap:async evaluate=>{
+        for(let n=0;n<120;n++) {
+          if(await evaluate('crossOriginIsolated && !!document.body').catch(()=>false))break;
+          await new Promise(resolve=>setTimeout(resolve,50));
+        }
+        await evaluate('('+installTravelEmulator.toString()+')('+JSON.stringify({metadata,fixture,speed:6,mode,...plan})+')');
+      }});
+    try {
+      const boot=await browser.evaluate('qa.boot()');
+      await browser.shot(mode+'-'+site.id+'-player');
+      await browser.evaluate('qa.start()');
+      let progress;
+      const deadline=Date.now()+240000;
+      while(Date.now()<deadline) {
+        progress=await browser.evaluate('qa.progress()');
+        if(progress.done!=='running')break;
+        await new Promise(resolve=>setTimeout(resolve,500));
+      }
+      const result=await browser.evaluate('qa.result()');
+      result.mode=mode;result.id=site.id;result.boot=boot;
+      await writeFile(join(qa,mode+'-'+site.id+'-travel.json'),JSON.stringify(result,null,2)+'\n');
+      assert.equal(result.done,'complete',JSON.stringify(result.fails.slice(0,4)));
+      assert.equal(result.passed.length,plan.actions.length);
+      assert.equal(result.visited.length,plan.graph.points.length);
+      assert.equal(result.fails.length,0);
+      const summary={id:site.id,mode,tiles:result.visited.length,edges:plan.edges,wallProbes:plan.wallProbes,nativeMaps:plan.nativeMaps,failures:0};
+      results.push(summary);
+      await writeFile(join(qa,'travel-summary.json'),JSON.stringify(results,null,2)+'\n');
+      console.log(JSON.stringify(summary));
+    } finally {browser.close();}
+  }
+}
