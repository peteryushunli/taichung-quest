+#!/usr/bin/env python3
+"""Check actual bike context/latch/collision bodies using explicit host fixtures.
+
+This does not emulate FireRed. Native runtime QA must measure traversal and
+verify actual task cleanup, animation, field locks, doors and map connections.
+No production body is copied into the fixture: extract it from current source.
+"""
+import os
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def function(source, name):
+    match = re.search(r"^(?:static )?(?:bool8|void|s16) " + re.escape(name) + r"\([^;]*?\)\n\{", source, re.M)
+    if not match:
+        raise SystemExit(f"Missing production function: {name}")
+    start = match.start()
+    cursor = source.index("{", match.start())
+    depth = 1
+    cursor += 1
+    while depth:
+        depth += (source[cursor] == "{") - (source[cursor] == "}")
+        cursor += 1
+    return source[start:cursor]
+
+
+def enum(source, member):
+    pos = source.index(member)
+    start = source.rfind("enum", 0, pos)
+    return source[start:source.index("};", pos) + 2]
+
+
+bike = (ROOT / "src/bike.c").read_text()
+field = (ROOT / "src/field_control_avatar.c").read_text()
+field_types = (ROOT / "include/global.fieldmap.h").read_text()
+keys = (ROOT / "include/gba/io_reg.h").read_text()
+declarations = "\n".join(re.findall(r"^static EWRAM_DATA .*sBikeShortcut\w+ = .*;$", field, re.M))
+if len(declarations.splitlines()) != 4:
+    raise SystemExit("Unexpected B latch state: update explicit host fixture")
+avatar_flags = "\n".join(re.findall(r"^#define PLAYER_AVATAR_FLAG_.*$", field_types, re.M))
+button_flags = "\n".join(re.findall(r"^#define (?:A_BUTTON|B_BUTTON|START_BUTTON|SELECT_BUTTON|DPAD_UP)\s+.*$", keys, re.M))
+
+prefix = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef int16_t s16;
+typedef uint8_t bool8;
+typedef uint32_t bool32;
+#define TRUE 1
+#define FALSE 0
+#define EWRAM_DATA
+#include "constants/global.h"
+#include "constants/flags.h"
+#include "constants/event_object_movement.h"
+#include "constants/map_types.h"
+#include "bike.h"
+struct ObjectEvent { bool8 active, frozen; u8 movementActionId, currentMetatileBehavior, movementDirection; };
+static struct ObjectEvent gObjectEvents[OBJECT_EVENTS_COUNT];
+static struct { u32 vblankCounter2; bool8 inBattle; } gMain;
+static struct { u8 mapType; bool8 bikingAllowed; } gMapHeader;
+static struct { u8 flags, transitionFlags, objectEventId, tileTransitionState, bikeFrameCounter; bool8 preventStep; } gPlayerAvatar;
+static struct { bool8 active; } gPaletteFade;
+struct FieldInput { bool8 pressedBButton; };
+static bool8 sCity, sMainField, sLock, sScript, sLink, sUnion, sReplay, sRoad, sNativeBlocked;
+static bool8 sRailFacing, sStairs;
+static u8 sTile, sCollision, sMovement;
+static u8 sTaskCount;
+#define NUM_TASKS 16
+#define QL_IS_PLAYBACK_STATE sReplay
+enum { MOVE_NONE, MOVE_FACE, MOVE_LEDGE, MOVE_COLLIDE, MOVE_FAST, MOVE_FASTER, MOVE_CURRENT };
+static bool8 TaichungTeamNoGrindActive(void) { return sCity; }
+static bool8 Overworld_IsBikingAllowed(void) { return gMapHeader.bikingAllowed; }
+static bool8 Overworld_IsMainFieldCallback(void) { return sMainField; }
+static bool8 ArePlayerFieldControlsLocked(void) { return sLock; }
+static bool8 ScriptContext_IsEnabled(void) { return sScript; }
+static bool8 IsUpdateLinkStateCBActive(void) { return sLink; }
+static bool8 InUnionRoom(void) { return sUnion; }
+static u8 GetTaskCount(void) { return sTaskCount; }
+static bool8 FlagGet(u16 flag) { assert(flag == FLAG_SYS_ON_CYCLING_ROAD); return sRoad; }
+static u8 ObjectEventGetHeldMovementActionId(struct ObjectEvent *object) { return object->movementActionId; }
+static void PlayerGetDestCoords(s16 *x, s16 *y) { *x = 5; *y = 6; }
+static u8 MapGridGetMetatileBehaviorAt(s16 x, s16 y) { assert(x == 5 && y == 6); return sTile; }
+static bool8 MetatileBehavior_IsForcedMovementTile(u8 tile) { return !!(tile & 1); }
+static bool8 MetatileBehavior_IsVerticalRail(u8 tile) { return !!(tile & 2); }
+static bool8 MetatileBehavior_IsHorizontalRail(u8 tile) { return !!(tile & 4); }
+static bool8 MetatileBehavior_IsIsolatedVerticalRail(u8 tile) { return !!(tile & 8); }
+static bool8 MetatileBehavior_IsIsolatedHorizontalRail(u8 tile) { return !!(tile & 16); }
+bool8 IsBikingDisallowedByPlayer(void) { return sNativeBlocked; }
+static u8 CanBikeFaceDirectionOnRail(u8 direction, u8 tile) { (void)direction; (void)tile; return sRailFacing; }
+static u8 GetBikeCollision(u8 direction) { (void)direction; return sCollision; }
+static void BikeTransition_FaceDirection(u8 direction) { (void)direction; sMovement = MOVE_FACE; }
+static void PlayerJumpLedge(u8 direction) { (void)direction; sMovement = MOVE_LEDGE; }
+static void PlayerOnBikeCollide(u8 direction) { (void)direction; sMovement = MOVE_COLLIDE; }
+static void PlayerWalkFast(u8 direction) { (void)direction; sMovement = MOVE_FAST; }
+static void PlayerRideTaichungBike(u8 direction) { (void)direction; sMovement = MOVE_FASTER; }
+static void PlayerRideWaterCurrent(u8 direction) { (void)direction; sMovement = MOVE_CURRENT; }
+static u8 PlayerIsMovingOnRockStairs(u8 direction) { (void)direction; return sStairs; }
+'''
+
+tests = r'''
+static void Reset(void)
+{
+    memset(&gMain, 0, sizeof(gMain));
+    memset(&gMapHeader, 0, sizeof(gMapHeader));
+    memset(&gPlayerAvatar, 0, sizeof(gPlayerAvatar));
+    memset(gObjectEvents, 0, sizeof(gObjectEvents));
+    sCity = sMainField = sRailFacing = TRUE;
+    sLock = sScript = sLink = sUnion = sReplay = sRoad = sNativeBlocked = sStairs = FALSE;
+    sTile = sTaskCount = sCollision = sMovement = 0;
+    gMapHeader.mapType = MAP_TYPE_TOWN;
+    gMapHeader.bikingAllowed = TRUE;
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_ON_FOOT;
+    gPlayerAvatar.tileTransitionState = T_NOT_MOVING;
+    gObjectEvents[0].active = TRUE;
+    gPaletteFade.active = FALSE;
+    sBikeShortcutInputFrame = 0;
+    sBikeShortcutArmed = sBikeShortcutPending = FALSE;
+    sBikeShortcutPendingAge = 0;
+}
+
+static bool8 Tick(u16 fresh, u16 held)
+{
+    struct FieldInput input = {FALSE};
+    gMain.vblankCounter2++;
+    UpdateTaichungBikeShortcutInput(&input, fresh, held);
+    return input.pressedBButton;
+}
+
+static void CheckContext(void)
+{
+    bool8 *blocked[] = {&sLock, &sScript, &sLink, &sUnion, &sReplay, &sRoad, &sNativeBlocked, &gMain.inBattle, &gPaletteFade.active, &gPlayerAvatar.preventStep, &gObjectEvents[0].frozen};
+    unsigned i;
+    Reset(); assert(TaichungCanToggleBike());
+    for (i = 0; i < sizeof(blocked)/sizeof(blocked[0]); i++)
+    {
+        *blocked[i] = TRUE; assert(!TaichungCanToggleBike()); *blocked[i] = FALSE;
+    }
+    sCity = FALSE; assert(!TaichungCanToggleBike()); sCity = TRUE;
+    sMainField = FALSE; assert(!TaichungCanToggleBike()); sMainField = TRUE;
+    gMapHeader.mapType = MAP_TYPE_INDOOR; assert(!TaichungCanToggleBike());
+    gMapHeader.mapType = MAP_TYPE_TOWN;
+    gMapHeader.bikingAllowed = FALSE; assert(!TaichungCanToggleBike()); gMapHeader.bikingAllowed = TRUE;
+    gObjectEvents[0].active = FALSE; assert(!TaichungCanToggleBike()); gObjectEvents[0].active = TRUE;
+    gPlayerAvatar.objectEventId = OBJECT_EVENTS_COUNT; assert(!TaichungCanToggleBike()); gPlayerAvatar.objectEventId = 0;
+    sTaskCount = NUM_TASKS; assert(!TaichungCanToggleBike()); sTaskCount = 0;
+    gPlayerAvatar.transitionFlags = 1; assert(!TaichungCanToggleBike()); gPlayerAvatar.transitionFlags = 0;
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_SURFING; assert(!TaichungCanToggleBike());
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_UNDERWATER; assert(!TaichungCanToggleBike());
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_ON_FOOT | PLAYER_AVATAR_FLAG_FORCED; assert(!TaichungCanToggleBike());
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_MACH_BIKE; assert(TaichungCanToggleBike());
+    for (i = 0; i < 5; i++) { sTile = 1 << i; assert(!TaichungCanToggleBike()); }
+    sTile = 0;
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_WALK_NORMAL_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_PLAYER_RUN_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_WALK_FASTER_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_TAICHUNG_BIKE_UP; assert(TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_JUMP_2_UP; assert(!TaichungCanToggleBike());
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_SLIDE_UP; assert(!TaichungCanToggleBike());
+}
+
+static void CheckFreshAndHeld(void)
+{
+    unsigned i;
+    Reset();
+    assert(!Tick(B_BUTTON, B_BUTTON)); // No neutral field frame yet.
+    assert(!Tick(0, B_BUTTON));
+    assert(!Tick(0, 0));
+    assert(Tick(B_BUTTON, B_BUTTON));
+    for (i = 0; i < 120; i++) assert(!Tick(0, B_BUTTON));
+    assert(!Tick(0, 0));
+    assert(Tick(B_BUTTON, B_BUTTON));
+}
+
+static void CheckModalReturnAndConflicts(void)
+{
+    static const u16 modalKeys[] = {A_BUTTON, START_BUTTON, SELECT_BUTTON};
+    unsigned i;
+    Reset(); assert(!Tick(0, 0));
+    sLock = TRUE; assert(!Tick(B_BUTTON, B_BUTTON));
+    sLock = FALSE; assert(!Tick(0, B_BUTTON)); assert(!Tick(B_BUTTON, B_BUTTON));
+    assert(!Tick(0, 0)); assert(Tick(B_BUTTON, B_BUTTON));
+    assert(!Tick(0, 0));
+    gMain.vblankCounter2 += 60; // Full-screen menu: field collector absent.
+    assert(!Tick(B_BUTTON, B_BUTTON)); assert(!Tick(0, B_BUTTON));
+    assert(!Tick(0, 0)); assert(Tick(B_BUTTON, B_BUTTON));
+    for (i = 0; i < sizeof(modalKeys)/sizeof(modalKeys[0]); i++)
+    {
+        assert(!Tick(0, 0));
+        assert(!Tick(B_BUTTON | modalKeys[i], B_BUTTON | modalKeys[i]));
+        assert(!Tick(0, B_BUTTON));
+        assert(!Tick(0, 0)); assert(Tick(B_BUTTON, B_BUTTON));
+    }
+}
+
+static void CheckStepBuffer(void)
+{
+    unsigned i;
+    Reset(); assert(!Tick(0, 0));
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    gObjectEvents[0].movementActionId = MOVEMENT_ACTION_WALK_NORMAL_UP;
+    assert(!Tick(B_BUTTON, B_BUTTON | DPAD_UP));
+    assert(!Tick(0, DPAD_UP)); // Quick release still waits for tile center.
+    gPlayerAvatar.tileTransitionState = T_TILE_CENTER;
+    assert(Tick(0, DPAD_UP)); assert(!Tick(0, DPAD_UP));
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    assert(!Tick(B_BUTTON, B_BUTTON));
+    sScript = TRUE; assert(!Tick(0, B_BUTTON));
+    sScript = FALSE; gPlayerAvatar.tileTransitionState = T_TILE_CENTER;
+    assert(!Tick(0, B_BUTTON)); // A new script discards the queued request.
+    assert(!Tick(0, 0));
+    gPlayerAvatar.tileTransitionState = T_TILE_TRANSITION;
+    assert(!Tick(B_BUTTON, B_BUTTON));
+    for (i = 0; i < 40; i++) assert(!Tick(0, B_BUTTON));
+    gPlayerAvatar.tileTransitionState = T_TILE_CENTER;
+    assert(!Tick(0, B_BUTTON)); // Bounded lifetime, no delayed surprise.
+}
+
+static void CheckSpeedAndCollisions(void)
+{
+    Reset();
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_MACH_BIKE;
+    BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FASTER);
+    assert(GetPlayerSpeed() == PLAYER_SPEED_FASTER);
+    sCity = FALSE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_CURRENT);
+    sCity = TRUE; sCollision = COLLISION_IMPASSABLE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_COLLIDE);
+    sCollision = COLLISION_OBJECT_EVENT; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_COLLIDE);
+    sCollision = COLLISION_LEDGE_JUMP; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_LEDGE);
+    sCollision = COLLISION_COUNT; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FAST);
+    sCollision = COLLISION_NONE; sStairs = TRUE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FAST);
+    sStairs = FALSE; sRailFacing = FALSE; BikeTransition_MoveDirection(DIR_NORTH); assert(sMovement == MOVE_FACE);
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_ON_FOOT;
+    assert(GetPlayerSpeed() == PLAYER_SPEED_NORMAL);
+}
+
+int main(void)
+{
+    CheckContext(); CheckFreshAndHeld(); CheckModalReturnAndConflicts(); CheckStepBuffer(); CheckSpeedAndCollisions();
+    puts("PASS: actual bike eligibility/latch/speed/collision bodies; fresh/held/modal/stale/conflicting B, bounded midstep queue, native terrain/locks and untouched fallback motion.");
+    return 0;
+}
+'''
+
+source = "\n".join([
