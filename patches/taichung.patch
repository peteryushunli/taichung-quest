index 0000000..5292f4e
--- /dev/null
+++ b/tools/taichung/city_rework/save_v10.py
@@ -0,0 +1,299 @@
+#!/usr/bin/env python3
+"""Generate the save-v10 position repairs for the city rework.
+
+The rework grows every outdoor district outward (raised freeway, wider Wanhe,
+Old City North), so saved explicit positions move by a per-map shift, and the
+cells that were open at v9 but are closed after the rework move to the nearest
+cell that is open and reachable from the Old City station.
+
+  python3 tools/taichung/city_rework/save_v10.py                 # check src/taichung_save.c is current
+  python3 tools/taichung/city_rework/save_v10.py --write         # regenerate the C tables and the record
+  python3 tools/taichung/city_rework/save_v10.py --old 2c48f28   # the released v9 source (default)
+  python3 tools/taichung/city_rework/save_v10.py --new <tree>    # read the reworked maps from another tree
+
+The released tree is read with `git archive`; the reworked tree is this checkout.
+A table entry is keyed by the released (v9) position and gives the reworked position,
+so the shift is applied only to positions with no entry.
+"""
+
+import argparse
+from collections import deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[3]
+RELEASED = "2c48f28b998b67413baf058557752723ea121500"  # live native source with save v9
+RECORD = "data/taichung/city-rework/save-v10.json"
+SAVE_C = "src/taichung_save.c"
+BEGIN = "// BEGIN generated by tools/taichung/city_rework/save_v10.py"
+END = "// END generated by tools/taichung/city_rework/save_v10.py"
+
+# (map folder, MAP_ constant, released world origin, reworked world origin)
+MAPS = [
+    ("TaichungXitun", "MAP_TAICHUNG_XITUN", (0, 0), (-5, -5)),
+    ("TaichungGreenway", "MAP_TAICHUNG_GREENWAY", (40, 32), (40, -5)),
+    ("TaichungOldCity", "MAP_TAICHUNG_OLD_CITY", (80, 48), (80, 48)),
+    ("TaichungNantunNorth", "MAP_TAICHUNG_NANTUN_NORTH", (0, 64), (-5, 64)),
+    ("TaichungNantunWanhe", "MAP_TAICHUNG_NANTUN_WANHE", (0, 104), (-5, 104)),
+]
+NEW_ONLY = [("TaichungOldCityNorth", "MAP_TAICHUNG_OLD_CITY_NORTH", (80, -5))]
+STATION = ("TaichungOldCity", 30, 66)  # whiteout checkpoint and every new game's arrival
+# Doors the rework moves on purpose, as released cell -> reworked cell. Miyahara goes up a row so OC101's sidewalk
+# runs clear; Shen Ji (+1) and Fine Arts (+3) leave the 8 Greenway columns that Nantun North draws with its own bank.
+MOVED_WARPS = {"TaichungOldCity": {(20, 52): (20, 51)},
+               "TaichungGreenway": {(10, 44): (11, 81), (10, 62): (13, 99)}}
+TALL_GRASS = 0x02
+HEADER_H = "include/taichung_save.h"
+# The reviewed v10 save pair: the header, and the C source with its generated block emptied
+# (that block must equal c_tables() of the record in the tree). Re-review and re-pin when
+# either hand-written byte changes; regenerating the tables alone needs no new pin.
+REVIEWED_HAND_WRITTEN_SHA256 = "07193934c5b0da9922467d5134da425a31fd5b7aedcb9feaf6993b8026ef2ece"
+REVIEWED_HEADER_SHA256 = "42bc31038ed88d4faa90891838cf79a832aef61ba796dfe574b90acf5dbea55e"
+# Each reviewed pair, with the native source whose save pair lies underneath v10 (for guards
+# frozen at v9). The second is v10 plus the playthrough polish (0a24efb): its one added function,
+# TaichungSaveRememberObjectCacheRefreshFacing, now passing the current version to the v10-aware
+# facing helper. Underneath it is the polish's own v9 pair, which the gym staff profile pins.
+REVIEWED_PAIRS = [
+    {"handWritten": REVIEWED_HAND_WRITTEN_SHA256, "header": REVIEWED_HEADER_SHA256, "underneath": RELEASED},
+    {"handWritten": "1154d4f69603500897c4a8f414bca9ddf6ae11ba7597588f375357e31ada194e",
+     "header": "bf773a5e84e7c846183c1ffa2feece2a72e11afb753fa5958b38b3f974479706",
+     "underneath": "0a24efb7cb194e6faed14c363c586410a772bbaf"},
+]
+
+
+def load_validator():
+    spec = importlib.util.spec_from_file_location("save_v10_validate_city", ROOT / "tools/taichung/validate_city.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def export(revision, into):
+    archive = subprocess.run(["git", "-C", str(ROOT), "archive", revision, "data", "src/data"],
+                             check=True, capture_output=True).stdout
+    subprocess.run(["tar", "-x", "-C", str(into)], input=archive, check=True)
+    return into
+
+
+def load_maps(rules, source, names, overrides=None):
+    overrides = overrides or {}
+    read = lambda path: overrides[path] if path in overrides else (source / path).read_bytes()
+    layouts = {x["id"]: x for x in json.loads(read("data/layouts/layouts.json"))["layouts"] if "id" in x}
+    cache, maps = {}, {}
+    for name in names:
+        data = json.loads(read(f"data/maps/{name}/map.json"))
+        view = rules.Map(source, data, layouts[data["layout"]], cache, overrides.get)
+        view.warps = {(w["x"], w["y"]) for w in data.get("warp_events", [])}
+        view.sha = hashlib.sha256(read(layouts[data["layout"]]["blockdata_filepath"])).hexdigest()
+        maps[name] = view
+    return maps
+
+
+def approved_art_underneath(tree):
+    """Explicit historical view only after the current art/v11 pair is verified."""
+    path = tree / "tools/taichung/approved_art_guard.py"
+    if not path.exists():
+        return {}
+    spec = importlib.util.spec_from_file_location("save_v10_approved_art", path)
+    guard = importlib.util.module_from_spec(spec); spec.loader.exec_module(guard)
+    class Tree:
+        source = tree
+        @staticmethod
+        def read(rel):
+            return (tree / rel).read_bytes()
+    return guard.underneath(Tree)
+
+
+def street_signs_underneath(tree):
+    """The maps beneath the registered street-sign layer, when `tree` holds it.
+
+    That layer only opens four signpost cells, where no saved position can stand, so
+    the v10 tables stay those of the maps beneath it (its own guard proves the layer)."""
+    path = tree / "tools/taichung/street_signs.py"
+    if not path.exists():
+        return {}
+    spec = importlib.util.spec_from_file_location("save_v10_street_signs", path)
+    guard = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(guard)
+
+    approved = approved_art_underneath(tree)
+    class Tree:
+        source = tree
+
+        @staticmethod
+        def read(rel):
+            return approved[rel] if rel in approved else (tree / rel).read_bytes()
+    signs = guard.underneath(Tree)
+    return {**approved, **signs} if signs else {}
+
+
+def reachable(maps, origins):
+    """Cells reachable on foot from the station across every reworked district, in world coordinates."""
+    where = {}
+    for name, view in maps.items():
+        ox, oy = origins[name]
+        for y in range(view.height):
+            for x in range(view.width):
+                where[(ox + x, oy + y)] = (name, x, y)
+    name, sx, sy = STATION
+    start = (origins[name][0] + sx, origins[name][1] + sy)
+    seen, queue = {start}, deque([start])
+    while queue:
+        wx, wy = queue.popleft()
+        name, x, y = where[(wx, wy)]
+        here = maps[name]
+        for nx, ny in ((wx + 1, wy), (wx - 1, wy), (wx, wy + 1), (wx, wy - 1)):
+            if (nx, ny) in seen or (nx, ny) not in where:
+                continue
+            other, tx, ty = where[(nx, ny)]
+            if here.can_step(x, y, maps[other], tx, ty):
+                seen.add((nx, ny))
+                queue.append((nx, ny))
+    return {(where[w][0], where[w][1], where[w][2]) for w in seen}
+
+
+def nearest(view, open_cells, src):
+    """Shortest Manhattan distance, then south, west, east, north, then row-major (as v8)."""
+    def key(dst):
+        dx, dy = dst[0] - src[0], dst[1] - src[1]
+        side = 0 if dy > 0 else 1 if dx < 0 else 2 if dx > 0 else 3
+        return (abs(dx) + abs(dy), side, dst[1], dst[0])
+    return min(open_cells, key=key)
+
+
+def generate(old_tree, new_tree=ROOT):
+    rules = load_validator()
+    names = [m[0] for m in MAPS]
+    old = load_maps(rules, old_tree, names)
+    new = load_maps(rules, new_tree, names + [m[0] for m in NEW_ONLY], street_signs_underneath(new_tree))
+    origins = {name: after for name, _, _, after in MAPS}
+    origins.update({name: at for name, _, at in NEW_ONLY})
+    valid = reachable(new, origins)
+    errors, out = [], []
+    if (STATION[0], STATION[1], STATION[2]) not in valid:
+        errors.append("The Old City station checkpoint is not open")
+    for name, constant, before, after in MAPS:
+        a, b = old[name], new[name]
+        dx, dy = before[0] - after[0], before[1] - after[1]
+        if b.width < a.width + dx or b.height < a.height + dy:
+            errors.append(f"{name}: {b.width}x{b.height} cannot hold {a.width}x{a.height} shifted by ({dx},{dy})")
+            continue
+        moved = MOVED_WARPS.get(name, {})
+        shifted = sorted(moved.get((x, y), (x + dx, y + dy)) for x, y in a.warps)
+        if shifted != sorted(b.warps):
+            errors.append(f"{name}: warp cells {sorted(b.warps)} are not the released ones shifted {shifted}")
+        open_cells = [(x, y) for (m, x, y) in valid if m == name
+                      and (x, y) not in b.warps and b.behavior(x, y) != TALL_GRASS]
+        repairs = []
+        for y in range(a.height):
+            for x in range(a.width):
+                if not a.ground(x, y):
+                    continue
+                to = (x + dx, y + dy)
+                if (name, *to) in valid or ((x, y) in a.warps and to in b.warps):
+                    continue
+                repairs.append(((x, y), nearest(b, open_cells, to)))
+        out.append({"map": name, "constant": constant, "shift": [dx, dy],
+                    "releasedSize": [a.width, a.height], "reworkedSize": [b.width, b.height],
+                    "releasedSha256": a.sha, "reworkedSha256": b.sha,
+                    "openBefore": sum(a.ground(x, y) for y in range(a.height) for x in range(a.width)),
+                    "repairs": [[s[0], s[1], t[0], t[1]] for s, t in repairs]})
+    return out, errors
+
+
+def c_tables(record):
+    lines = [BEGIN,
+             f"// Save v10, the city rework: released source {RELEASED[:12]}; each district's released position moves by its",
+             "// shift, except a cell that is closed or cut off after the rework, which moves to the nearest open cell",
+             "// reachable from the Old City station. Map SHA256s are in " + RECORD + "."]
+    for entry in record:
+        symbol = f"s{entry['map'][len('Taichung'):]}V10Relocations"
+        lines.append(f"// {entry['map']}: shift ({entry['shift'][0]},{entry['shift'][1]}), {len(entry['repairs'])} closed cells.")
+        lines.append(f"static const struct SavedPositionRelocation {symbol}[] =")
+        lines.append("{")
+        lines += [f"    {{{sx}, {sy}, {tx}, {ty}}}," for sx, sy, tx, ty in entry["repairs"]] or ["    {0xFF, 0xFF, 0xFF, 0xFF},"]
+        lines.append("};")
+    lines.append("")
+    lines.append("static const struct ReworkShift sReworkShifts[] =")
+    lines.append("{")
+    for entry in record:
+        symbol = f"s{entry['map'][len('Taichung'):]}V10Relocations"
+        count = f"sizeof({symbol}) / sizeof({symbol}[0])" if entry["repairs"] else "0"
+        lines.append(f"    {{MAP_GROUP({entry['constant']}), MAP_NUM({entry['constant']}), {entry['shift'][0]}, {entry['shift'][1]}, {symbol}, {count}}},")
+    lines.append("};")
+    lines.append(END)
+    return "\n".join(lines) + "\n"
+
+
+def hand_written(text):
+    """The C source with its generated block emptied, as pinned by REVIEWED_HAND_WRITTEN_SHA256."""
+    return text[:text.index(BEGIN)] + BEGIN + "\n" + text[text.index(END):]
+
+
+def reviewed_pair(read):
+    """The REVIEWED_PAIRS entry read(path) holds exactly, with its record's tables, else None."""
+    try:
+        text, header = read(SAVE_C).decode("utf-8"), read(HEADER_H)
+        record = json.loads(read(RECORD))
+        block = text[text.index(BEGIN):text.index(END) + len(END) + 1]
+    except (ValueError, KeyError, subprocess.CalledProcessError, FileNotFoundError):
+        return None
+    if record.get("released") != RELEASED or block != c_tables(record["maps"]):
+        return None
+    written, head = hashlib.sha256(hand_written(text).encode()).hexdigest(), hashlib.sha256(header).hexdigest()
+    return next((pair for pair in REVIEWED_PAIRS if pair["handWritten"] == written and pair["header"] == head), None)
+
+
+def underneath(files):
+    """The v9 save pair beneath the registered v10, for guards frozen at v9.
+
+    Returns overrides only when the tree holds exactly a reviewed v10 pair; this tool's
+    check (tables equal the maps) and the host suites prove v10 itself."""
+    pair = reviewed_pair(files.read)
+    if pair is None:
+        return {}
+    base = type(files)(files.source, pair["underneath"])
+    return {SAVE_C: base.read(SAVE_C), HEADER_H: base.read(HEADER_H)}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--old", default=RELEASED, help="released native revision (default: live v9 source)")
+    parser.add_argument("--new", type=Path, default=ROOT, help="reworked tree to read maps from (default: this checkout)")
+    parser.add_argument("--write", action="store_true", help="rewrite the C tables and the record")
+    args = parser.parse_args()
+    approved = approved_art_underneath(ROOT)
+    if args.write and (ROOT / "data/taichung/approved-landmarks/save-v11.json").exists():
+        parser.error("The approved-art/v11 layer is registered; v10 is historical and must not be rewritten")
+    with tempfile.TemporaryDirectory() as tmp:
+        record, errors = generate(export(args.old, Path(tmp)), args.new.resolve())
+    summary = {e["map"]: {"shift": e["shift"], "repairs": len(e["repairs"])} for e in record}
+    read = lambda path: approved[path] if path in approved else (ROOT / path).read_bytes()
+    text = read(SAVE_C).decode()
+    tables = c_tables(record)
+    if BEGIN in text and END in text:
+        current = text[text.index(BEGIN):text.index(END) + len(END) + 1]
+    else:
+        current = None
+    if args.write and not errors:
+        if current is None:
+            errors.append(f"{SAVE_C} has no generated block to replace")
+        else:
+            (ROOT / SAVE_C).write_text(text.replace(current, tables))
+            (ROOT / RECORD).parent.mkdir(parents=True, exist_ok=True)
+            (ROOT / RECORD).write_text(json.dumps({"released": RELEASED, "maps": record}, indent=1) + "\n")
+    elif current != tables:
+        errors.append(f"{SAVE_C} tables are stale; run with --write")
+    if not errors and not reviewed_pair(read):
+        errors.append("The save pair is not the reviewed v10 pair; review the hand-written change and re-pin")
+    print(json.dumps({"ok": not errors, "errors": errors, "maps": summary}, indent=2))
+    return 0 if not errors else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
