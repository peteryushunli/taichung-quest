diff --git a/tests/taichung_exploration_test.c b/tests/taichung_exploration_test.c
new file mode 100644
index 0000000..fd44393
--- /dev/null
+++ b/tests/taichung_exploration_test.c
@@ -0,0 +1,92 @@
+#include "global.h"
+#include "taichung_exploration.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sPreferenceWrites;
+static unsigned sProgressWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Preference reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_EXPLORATION_WILD_VAR || id == TAICHUNG_EXPLORATION_SIGHT_VAR || id == TAICHUNG_GYM_COMPLETION_VAR);
+    if (id == TAICHUNG_GYM_COMPLETION_VAR) ++sProgressWrites;
+    else ++sPreferenceWrites;
+    sVariables[id-0x4000] = value;
+    return TRUE;
+}
+
+int main(void)
+{
+    u16 wild, sight, range;
+    u32 rate;
+    unsigned before;
+    const u32 rates[] = {0,1,3,4,7,16,80,1600,0xFFFFFFFF};
+    unsigned i;
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(sPreferenceWrites == 0); // Old saves default without replay or mutation.
+    assert(!TaichungExplorationSetMode(2,1));
+    assert(!TaichungExplorationSetMode(0,0));
+    assert(!TaichungExplorationSetMode(1,4));
+    assert(sPreferenceWrites == 0);
+    sVariables[0xF8] = 65535;
+    sVariables[0xF9] = 8;
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_NORMAL);
+
+    for (wild = 1; wild <= 3; ++wild)
+    {
+        for (sight = 1; sight <= 3; ++sight)
+        {
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_WILD,wild));
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_SIGHT,sight));
+            before = sPreferenceWrites;
+            assert(TaichungExplorationGetMode(0) == wild && TaichungExplorationGetMode(1) == sight);
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            // Script disabling and re-enabling encounters cannot erase saved Off.
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(TaichungExplorationAllowsTrainerSight() == (sight != TAICHUNG_EXPLORATION_OFF));
+            for (i = 0; i < sizeof(rates)/sizeof(rates[0]); ++i)
+            {
+                rate = rates[i];
+                if (wild == TAICHUNG_EXPLORATION_OFF) rate = 0;
+                else if (wild == TAICHUNG_EXPLORATION_LOW && rate > 0) rate = rate/4 ? rate/4 : 1;
+                assert(TaichungExplorationAdjustAutomaticWildRate(rates[i]) == rate);
+            }
+            for (range = 0; range <= 255; ++range)
+            {
+                u8 expected = sight == TAICHUNG_EXPLORATION_OFF ? 0 : sight == TAICHUNG_EXPLORATION_LOW && range > 1 ? 1 : range;
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected);
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected); // Deterministic, no frame reroll.
+            }
+            assert(sPreferenceWrites == before && sProgressWrites == 0);
+        }
+    }
+
+    // Changing preferences during a real tracked battle never cancels its win.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_OLD_STATION,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungExplorationSetMode(0,TAICHUNG_EXPLORATION_OFF);
+    TaichungExplorationSetMode(1,TAICHUNG_EXPLORATION_OFF);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 1 && sProgressWrites == 1);
+    // Voluntary gym preparation still works with both automatic settings Off.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 2 && sProgressWrites == 2);
+    TaichungGymCancelChallenge();
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_OFF);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_OFF);
+    puts("PASS: nine independent encounter/sight combinations; old-save defaults; quarter-rate/minimum; all sight ranges; temporary reset cannot override Off; voluntary and active gym wins remain valid.");
+    return 0;
+}
diff --git a/tests/taichung_gym_progress_test.c b/tests/taichung_gym_progress_test.c
new file mode 100644
index 0000000..f359f73
--- /dev/null
+++ b/tests/taichung_gym_progress_test.c
@@ -0,0 +1,84 @@
+#include "global.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Progress reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value) { assert(id == TAICHUNG_GYM_COMPLETION_VAR); sVariables[id-0x4000]=value; ++sWrites; return TRUE; }
+static void reset(void) { memset(sVariables,0,sizeof(sVariables)); sWrites=0; TaichungGymOnTrainerBattleStart(TRAINER_NONE); }
+
+int main(void)
+{
+    u16 gym;
+    u8 outcome;
+    const char *expected[] = {"old-taichung-station","taichung-park","miyahara","natural-science-museum","calligraphy-greenway","shen-ji-new-village","fine-arts-museum","fengjia-night-market","maple-garden","taichung-theater"};
+    reset();
+    assert(TaichungGymGetCompletedCount()==0);
+    assert(!TaichungGymIsComplete(10) && !TaichungGymIsComplete(65535));
+    assert(TaichungGymGetLandmarkId(10)==NULL);
+    assert(!TaichungGymPrepareChallenge(10,TRAINER_TAICHUNG_STATION_JUN));
+    assert(!TaichungGymPrepareChallenge(0,TRAINER_NONE));
+    assert(!TaichungGymPrepareChallenge(0,NUM_TRAINERS));
+    assert(sWrites==0);
+
+    // A prepared script or a stale old win alone is not a completed challenge.
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0 && TaichungGymGetCompletedMask()==0);
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_YOUNGSTER_BEN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0);
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_YOUNGSTER_BEN,B_OUTCOME_WON);
+    assert(sWrites==0);
+
+    assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymCancelChallenge();
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(sWrites==0);
+
+    // Every non-win outcome must preserve completion state and allow a retry.
+    for (outcome=0; outcome<16; ++outcome)
+    {
+        if (outcome==B_OUTCOME_WON) continue;
+        assert(TaichungGymPrepareChallenge(0,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,outcome);
+        assert(TaichungGymGetCompletedMask()==0 && sWrites==0);
+    }
+
+    // All ten bits are distinct, in the accepted permanent landmark order.
+    for (gym=0; gym<TAICHUNG_GYM_COUNT; ++gym)
+    {
+        assert(strcmp(TaichungGymGetLandmarkId(gym),expected[gym])==0);
+        assert(TaichungGymPrepareChallenge(gym,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        assert(sWrites==gym);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+        assert(TaichungGymIsComplete(gym));
+        assert(TaichungGymGetCompletedCount()==gym+1);
+        assert(TaichungGymGetLastResult()==TAICHUNG_GYM_RESULT_WON);
+        assert(!TaichungGymPrepareChallenge(gym,TRAINER_TAICHUNG_STATION_JUN));
+        TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+        TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+        assert(sWrites==gym+1);
+    }
+    assert(TaichungGymGetCompletedMask()==0x03FF && sWrites==10);
+    // Volatile battle state can clear while saved mask remains intact.
+    TaichungGymOnTrainerBattleStart(TRAINER_NONE);
+    assert(TaichungGymGetCompletedCount()==10);
+    sVariables[0xFA]=0xFC00; // Reserved high bits must not inflate the ten-state count.
+    assert(TaichungGymGetCompletedCount()==0);
+    puts("PASS: ten independent saved states; real-start/matching-trainer/win guards; loss/retry/duplicate/ID boundaries; stable IDs; no writes outside VAR_0x40FA.");
+    return 0;
+}
diff --git a/tests/taichung_save_test.c b/tests/taichung_save_test.c
new file mode 100644
index 0000000..f780e23
--- /dev/null
+++ b/tests/taichung_save_test.c
@@ -0,0 +1,215 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_save.h"
+#include "constants/maps.h"
+#include "constants/species.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWarpRequests;
+static unsigned sVariableWrites;
+static bool8 sHasContinueWarp;
+#define V(id) sSave.vars[(id) - VARS_START]
+
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_SAVE_VERSION_VAR || id == 0x40FB || id == 0x40FC);
+    V(id) = value;
+    sVariableWrites++;
+    return TRUE;
+}
+
+void SetContinueGameWarpStatus(void)
+{
+    sHasContinueWarp = TRUE;
+    sWarpRequests++;
+}
+
+bool32 UseContinueGameWarp(void)
+{
+    return sHasContinueWarp;
+}
+
+static void Reset(void)
+{
+    unsigned i;
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.preservedPartyAndBag, 0xA5, sizeof(sSave.preservedPartyAndBag));
+    for (i = 0; i < 256; i++)
+        sSave.vars[i] = i ^ 0x5A5A;
+    V(0x40F7) = 0;
+    V(0x40FB) = 0;
+    V(0x40FC) = 0;
+    V(0x40FD) = 0;
+    V(0x40F8) = 1;
+    V(0x40F9) = 2;
+    V(0x40FA) = 0x155;
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    sSave.location.mapNum = MAP_NUM(MAP_ROUTE1);
+    sSave.location.warpId = 2;
+    sSave.location.x = 7;
+    sSave.location.y = 8;
+    sSave.pos.x = 12;
+    sSave.pos.y = 9;
+    sSave.playerPartyCount = 1;
+    sSave.lastHealLocation = sSave.location;
+    sSave.continueGameWarp = sSave.location;
+    sSave.continueGameWarp.x = 4;
+    sSave.continueGameWarp.y = 5;
+    sWarpRequests = 0;
+    sVariableWrites = 0;
+    sHasContinueWarp = FALSE;
+}
+
+static void InOldCity(s16 x, s16 y)
+{
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    sSave.pos.x = x;
+    sSave.pos.y = y;
+}
+
+static void AssertProtected(const struct SaveBlock1 *before, bool8 legacy)
+{
+    unsigned i;
+    assert(sSave.playerPartyCount == before->playerPartyCount);
+    assert(memcmp(sSave.preservedPartyAndBag, before->preservedPartyAndBag, sizeof(sSave.preservedPartyAndBag)) == 0);
+    assert(memcmp(&sSave.location, &before->location, sizeof(sSave.location)) == 0);
+    assert(memcmp(&sSave.pos, &before->pos, sizeof(sSave.pos)) == 0);
+    for (i = 0; i < 256; i++)
+    {
+        if (i == TAICHUNG_SAVE_VERSION_VAR - VARS_START)
+            continue;
+        if (legacy && (i == 0xFB || i == 0xFC))
+            continue;
+        assert(sSave.vars[i] == before->vars[i]);
+    }
+}
+
+static void AssertWarp(s16 x, s16 y)
+{
+    assert(sHasContinueWarp);
+    assert(sSave.continueGameWarp.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(sSave.continueGameWarp.mapNum == MAP_NUM(MAP_TAICHUNG_OLD_CITY));
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == x && sSave.continueGameWarp.y == y);
+}
+
+int main(void)
+{
+    static const u16 starters[] = {SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU};
+    static const s16 newlyBlocked[][2] = {{26,61},{26,62},{26,63},{26,64},{31,57},{32,57}};
+    static const s16 stillSafe[][2] = {{30,66},{32,65},{23,62},{25,61},{30,57},{33,57},{0,21}};
+    struct SaveBlock1 before;
+    unsigned i, map;
+
+    Reset(); before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0 && sWarpRequests == 0 && sVariableWrites == 0);
+
+    for (i = 0; i < sizeof(starters)/sizeof(starters[0]); i++)
+    {
+        Reset();
+        V(0x40FC) = starters[i]; V(0x40FD) = 2; V(0x40FB) = i % 2 ? 2 : 0;
+        before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(V(0x40F7) == 2 && sWarpRequests == 1 && V(0x40FC) == starters[i] && V(0x40FD) == 2);
+        assert(V(0x40FB) == (i % 2 ? 2 : 1));
+        AssertWarp(30,66);
+        assert(TaichungSaveUsesStationCheckpoint());
+        AssertProtected(&before, TRUE);
+        sHasContinueWarp = FALSE; // Engine consumed the one-time Continue warp.
+        TaichungSaveUpgradeOnContinue();
+        assert(sWarpRequests == 1 && !sHasContinueWarp);
+    }
+    for (map = 0; map <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM); map++)
+    {
+        Reset(); V(0x40FC) = SPECIES_PIKACHU; V(0x40FB) = 2;
+        sSave.location.mapGroup = 43; sSave.location.mapNum = map;
+        before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(sWarpRequests == (map == 0 ? 1 : 0));
+        if (map == 0) AssertWarp(12,9);
+        assert(V(0x40F7) == 2 && V(0x40FB) == 2);
+        AssertProtected(&before, TRUE);
+    }
+    Reset(); V(0x40FD) = 3; before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(V(0x40FC) == SPECIES_BULBASAUR && V(0x40FD) == 3 && sWarpRequests == 1);
+    AssertProtected(&before, TRUE);
+
+    // v1 current saved position wins over stale entrance coordinates/warp ID.
+    for (i = 0; i < sizeof(stillSafe)/sizeof(stillSafe[0]); i++)
+    {
+        Reset(); V(0x40F7) = 1; V(0x40FB) = 2; V(0x40FC) = 133;
+        sSave.playerPartyCount = 3;
+        InOldCity(stillSafe[i][0], stillSafe[i][1]);
+        TaichungSaveSetStationCheckpoint();
+        before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(V(0x40F7) == 2 && sWarpRequests == 1);
+        AssertWarp(stillSafe[i][0], stillSafe[i][1]);
+        AssertProtected(&before, FALSE);
+        assert(memcmp(&sSave.lastHealLocation, &before.lastHealLocation, sizeof(sSave.lastHealLocation)) == 0);
+        assert(TaichungSaveUsesStationCheckpoint());
+        sHasContinueWarp = FALSE;
+        TaichungSaveUpgradeOnContinue();
+        assert(sWarpRequests == 1 && !sHasContinueWarp);
+    }
+    for (i = 0; i < sizeof(newlyBlocked)/sizeof(newlyBlocked[0]); i++)
+    {
+        Reset(); V(0x40F7) = 1; V(0x40FB) = 2; V(0x40FC) = SPECIES_PIKACHU;
+        InOldCity(newlyBlocked[i][0], newlyBlocked[i][1]);
+        before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(V(0x40F7) == 2 && sWarpRequests == 1);
+        AssertWarp(30,66);
+        AssertProtected(&before, FALSE);
+    }
+
+    // Other city maps, the added welcome-room slot, and legacy routes stay put.
+    for (map = 1; map <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM) + 2; map++)
+    {
+        Reset(); V(0x40F7) = 1; V(0x40FB) = 2; V(0x40FC) = SPECIES_PIKACHU;
+        if (map <= MAP_NUM(MAP_TAICHUNG_THEATER_GYM) + 1)
+        {
+            sSave.location.mapGroup = 43;
+            sSave.location.mapNum = map;
+        }
+        before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(V(0x40F7) == 2 && sWarpRequests == 0 && !sHasContinueWarp);
+        AssertProtected(&before, FALSE);
+        assert(memcmp(&sSave.continueGameWarp, &before.continueGameWarp, sizeof(sSave.continueGameWarp)) == 0);
+        assert(memcmp(&sSave.lastHealLocation, &before.lastHealLocation, sizeof(sSave.lastHealLocation)) == 0);
+    }
+
+    // Keep an existing native return; it already reloads map data from source.
+    Reset(); V(0x40F7) = 1; InOldCity(30,66); sHasContinueWarp = TRUE; before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(sWarpRequests == 0 && sHasContinueWarp);
+    assert(memcmp(&sSave.continueGameWarp, &before.continueGameWarp, sizeof(sSave.continueGameWarp)) == 0);
+    AssertProtected(&before, FALSE);
+    Reset(); V(0x40F7) = 1; sHasContinueWarp = TRUE;
+    InOldCity(30,66); sSave.continueGameWarp = sSave.location;
+    sSave.continueGameWarp.warpId = -1; sSave.continueGameWarp.x = 26; sSave.continueGameWarp.y = 62;
+    TaichungSaveUpgradeOnContinue();
+    assert(sWarpRequests == 0); AssertWarp(30,66);
+
+    Reset(); V(0x40FC) = SPECIES_PIKACHU; sSave.playerPartyCount = 0; before = sSave;
+    TaichungSaveUpgradeOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0 && sWarpRequests == 0);
+    for (i = 2; i <= 3; i++)
+    {
+        Reset(); V(0x40F7) = i; InOldCity(26,61); before = sSave;
+        TaichungSaveUpgradeOnContinue();
+        assert(memcmp(&sSave, &before, sizeof(sSave)) == 0 && sWarpRequests == 0 && sVariableWrites == 0);
+    }
+    Reset(); TaichungSaveInitNewGame();
+    assert(V(0x40F7) == 2 && V(0x40FB) == 0 && V(0x40FC) == 0 && sWarpRequests == 0);
+    assert(TaichungSaveUsesStationCheckpoint());
+    puts("PASS: v1 Station cache reload at saved position; six new facade blockers use safe plaza; other maps/native warps preserved; v0 prototypes, team/bag/preferences/progress, one-time/current/future behavior.");
+    return 0;
+}
diff --git a/tests/taichung_starter_test.c b/tests/taichung_starter_test.c
new file mode 100644
index 0000000..8eecfaf
--- /dev/null
+++ b/tests/taichung_starter_test.c
@@ -0,0 +1,212 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "pokemon.h"
+#include "taichung_starter.h"
+#include "taichung_team.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+
+static struct SaveBlock1 sSave;
+static struct SaveBlock2 sSave2;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct SaveBlock2 *gSaveBlock2Ptr = &sSave2;
+struct Main gMain;
+struct Pokemon gPlayerParty[6];
+u8 gPlayerPartyCount;
+u16 gSpecialVar_0x8004, gSpecialVar_Result;
+
+static unsigned sCreates, sHistoricalReads;
+static bool8 sFailCreation;
+static u16 sReplaySpecies;
+
+// The party operation has its own production-module tests. This stand-in only
+// exposes whether this helper calls it before/after committing the marker.
+bool8 TaichungTeamSetSlot(u8 slot, u16 species)
+{
+    assert(slot == 0);
+    assert(gPlayerPartyCount == 0);
+    assert(sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] == 0);
+    sCreates++;
+    if (sFailCreation)
+        return FALSE;
+    gPlayerParty[0].species = species;
+    gPlayerPartyCount = 1;
+    return TRUE;
+}
+
+// Mimic the engine's harmful historical read. Every tested path must avoid it.
+u16 VarGet(u16 id)
+{
+    assert(id == TAICHUNG_STARTER_SPECIES_VAR);
+    sHistoricalReads++;
+    sSave.vars[id - VARS_START] = sReplaySpecies;
+    return sReplaySpecies;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    memset(&sSave2, 0xB3, sizeof(sSave2));
+    memset(gPlayerParty, 0, sizeof(gPlayerParty));
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = 0;
+    gSaveBlock1Ptr = &sSave;
+    gSaveBlock2Ptr = &sSave2;
+    gPlayerPartyCount = 0;
+    gMain.inBattle = FALSE;
+    sCreates = sHistoricalReads = 0;
+    sFailCreation = FALSE;
+    sReplaySpecies = 0;
+    gSpecialVar_0x8004 = 0;
+    gSpecialVar_Result = 0xCAFE;
+}
+
+static void AssertOnlyMarkerChanged(const struct SaveBlock1 *before, u16 marker,
+                                  const struct SaveBlock2 *before2)
+{
+    struct SaveBlock1 expected = *before;
+    expected.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = marker;
+    assert(memcmp(&sSave, &expected, sizeof(sSave)) == 0);
+    assert(memcmp(&sSave2, before2, sizeof(sSave2)) == 0);
+    assert(sHistoricalReads == 0);
+}
+
+static void TestAllChoicesAndDuplicate(void)
+{
+    static const u16 choices[] = {SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_PIKACHU};
+    unsigned i;
+    for (i = 0; i < sizeof(choices) / sizeof(choices[0]); i++)
+    {
+        struct SaveBlock1 before;
+        struct SaveBlock2 before2;
+        struct Pokemon granted;
+        Reset();
+        before = sSave;
+        before2 = sSave2;
+        assert(!TaichungStarterHasPartner());
+        assert(TaichungStarterTryGrant(choices[i]) == TAICHUNG_STARTER_RESULT_GRANTED);
+        assert(sCreates == 1 && gPlayerPartyCount == 1);
+        assert(gPlayerParty[0].species == choices[i]);
+        assert(TaichungStarterHasPartner());
+        AssertOnlyMarkerChanged(&before, choices[i], &before2);
+        granted = gPlayerParty[0];
+        assert(TaichungStarterTryGrant(choices[(i + 1) % 4]) == TAICHUNG_STARTER_RESULT_ALREADY);
+        assert(sCreates == 1 && gPlayerPartyCount == 1);
+        assert(memcmp(&granted, &gPlayerParty[0], sizeof(granted)) == 0);
+        AssertOnlyMarkerChanged(&before, choices[i], &before2);
+    }
+}
+
+static void TestInvalidAndFailedCreation(void)
+{
+    static const u16 invalid[] = {0, 2, 3, 5, 6, 8, 26, 150, 151, 0xFFFF};
+    unsigned i;
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    Reset();
+    before = sSave;
+    before2 = sSave2;
+    for (i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++)
+        assert(TaichungStarterTryGrant(invalid[i]) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+
+    sFailCreation = TRUE;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 1 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+    sFailCreation = FALSE;
+    assert(TaichungStarterTryGrant(SPECIES_SQUIRTLE) == TAICHUNG_STARTER_RESULT_GRANTED);
+    assert(sCreates == 2 && gPlayerPartyCount == 1);
+    AssertOnlyMarkerChanged(&before, SPECIES_SQUIRTLE, &before2);
+}
+
+static void TestExistingPartyAndRawMarker(void)
+{
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    struct Pokemon beforeParty[6];
+    Reset();
+    gPlayerParty[0].species = SPECIES_SNORLAX;
+    gPlayerPartyCount = 1;
+    before = sSave;
+    before2 = sSave2;
+    memcpy(beforeParty, gPlayerParty, sizeof(beforeParty));
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_BULBASAUR) == TAICHUNG_STARTER_RESULT_ALREADY);
+    assert(sCreates == 0);
+    assert(memcmp(beforeParty, gPlayerParty, sizeof(beforeParty)) == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2); // Do not infer a legacy marker.
+
+    Reset();
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = SPECIES_PIKACHU;
+    sReplaySpecies = 0;
+    before = sSave;
+    before2 = sSave2;
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_ALREADY);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, SPECIES_PIKACHU, &before2);
+
+    Reset();
+    sReplaySpecies = SPECIES_PIKACHU; // Historical marker must not suppress a new grant.
+    before = sSave;
+    before2 = sSave2;
+    assert(!TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_BULBASAUR) == TAICHUNG_STARTER_RESULT_GRANTED);
+    AssertOnlyMarkerChanged(&before, SPECIES_BULBASAUR, &before2);
+
+    Reset();
+    sSave.vars[TAICHUNG_STARTER_SPECIES_VAR - VARS_START] = 0xFFFF;
+    before = sSave;
+    before2 = sSave2;
+    assert(TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_PIKACHU) == TAICHUNG_STARTER_RESULT_ALREADY);
+    AssertOnlyMarkerChanged(&before, 0xFFFF, &before2);
+}
+
+static void TestUnavailableContextAndWrappers(void)
+{
+    struct SaveBlock1 before;
+    struct SaveBlock2 before2;
+    Reset();
+    before = sSave;
+    before2 = sSave2;
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungStarterHasPartner());
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    gSaveBlock1Ptr = &sSave;
+    gSaveBlock2Ptr = NULL;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    gSaveBlock2Ptr = &sSave2;
+    gMain.inBattle = TRUE;
+    assert(TaichungStarterTryGrant(SPECIES_CHARMANDER) == TAICHUNG_STARTER_RESULT_INVALID);
+    assert(sCreates == 0 && gPlayerPartyCount == 0);
+    AssertOnlyMarkerChanged(&before, 0, &before2);
+
+    gMain.inBattle = FALSE;
+    TaichungStarter_ScriptHasPartner();
+    assert(gSpecialVar_Result == FALSE);
+    gSpecialVar_0x8004 = SPECIES_PIKACHU;
+    TaichungStarter_ScriptGrant();
+    assert(gSpecialVar_Result == TAICHUNG_STARTER_RESULT_GRANTED);
+    assert(gSpecialVar_0x8004 == SPECIES_PIKACHU);
+    gSpecialVar_0x8004 = SPECIES_SQUIRTLE;
+    TaichungStarter_ScriptGrant();
+    assert(gSpecialVar_Result == TAICHUNG_STARTER_RESULT_ALREADY);
+    TaichungStarter_ScriptHasPartner();
+    assert(gSpecialVar_Result == TRUE);
+    assert(gPlayerPartyCount == 1 && gPlayerParty[0].species == SPECIES_PIKACHU && sCreates == 1);
+    AssertOnlyMarkerChanged(&before, SPECIES_PIKACHU, &before2);
+}
+
+int main(void)
+{
+    TestAllChoicesAndDuplicate();
+    TestInvalidAndFailedCreation();
+    TestExistingPartyAndRawMarker();
+    TestUnavailableContextAndWrappers();
+    puts("PASS: four one-time starter grants; duplicate/existing-party/raw-marker guards; failure/context checks; protected fields retained.");
+    return 0;
+}
diff --git a/tests/taichung_team_test.c b/tests/taichung_team_test.c
new file mode 100644
index 0000000..9422a7f
--- /dev/null
+++ b/tests/taichung_team_test.c
@@ -0,0 +1,334 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "main.h"
+#include "pokemon.h"
+#include "pokedex.h"
+#include "taichung_team.h"
+#include "taichung_team_presets.h"
+#include "constants/items.h"
+#include "constants/maps.h"
+
+static struct SaveBlock1 sSave, sProtectedSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+struct Main gMain;
+struct Pokemon gPlayerParty[PARTY_SIZE];
+u8 gPlayerPartyCount;
+
+// Different growth tables catch a level field write or a fixed EXP shortcut.
+const struct SpeciesInfo gSpeciesInfo[NUM_SPECIES] = {
+    [SPECIES_CHARIZARD] = {1},
+    [SPECIES_MEWTWO] = {1}
+};
+const u32 gExperienceTables[2][MAX_LEVEL + 1] = {
+    {[5] = 125, [50] = 125000, [80] = 512000},
+    {[5] = 156, [50] = 156250, [80] = 640000}
+};
+
+static unsigned sCreates, sRecalculations, sPresets, sHeals, sDexWrites;
+static bool8 sSeen[151], sCaught[151];
+
+u32 GetMonData(struct Pokemon *mon, s32 field, ...)
+{
+    assert(mon != NULL);
+    switch (field)
+    {
+    case MON_DATA_SPECIES: return mon->species;
+    case MON_DATA_HELD_ITEM: return mon->heldItem;
+    case MON_DATA_MAIL: return mon->mail;
+    case MON_DATA_IS_EGG: return mon->isEgg;
+    case MON_DATA_LEVEL: return mon->level;
+    case MON_DATA_EXP: return mon->exp;
+    case MON_DATA_HP: return mon->hp;
+    case MON_DATA_MAX_HP: return mon->maxHp;
+    case MON_DATA_STATUS: return mon->status;
+    default: assert(!"Unexpected engine read"); return 0;
+    }
+}
+
+void SetMonData(struct Pokemon *mon, s32 field, const void *value)
+{
+    assert(mon != NULL && value != NULL);
+    switch (field)
+    {
+    case MON_DATA_EXP: memcpy(&mon->exp, value, sizeof(mon->exp)); break;
+    case MON_DATA_HELD_ITEM: memcpy(&mon->heldItem, value, sizeof(mon->heldItem)); break;
+    case MON_DATA_MAIL: memcpy(&mon->mail, value, sizeof(mon->mail)); break;
+    case MON_DATA_HP: memcpy(&mon->hp, value, sizeof(mon->hp)); break;
+    case MON_DATA_STATUS: memcpy(&mon->status, value, sizeof(mon->status)); break;
+    default: assert(!"Unexpected engine write");
+    }
+}
+
+u8 CalculatePlayerPartyCount(void)
+{
+    gPlayerPartyCount = 0;
+    while (gPlayerPartyCount < PARTY_SIZE && gPlayerParty[gPlayerPartyCount].species != SPECIES_NONE)
+        gPlayerPartyCount++;
+    return gPlayerPartyCount;
+}
+
+void CalculateMonStats(struct Pokemon *mon)
+{
+    u16 oldMax = mon->maxHp;
+    assert(mon->exp == gExperienceTables[gSpeciesInfo[mon->species].growthRate][50]);
+    sRecalculations++;
+    mon->level = 50;
+    mon->maxHp = 150;
+    // Model FireRed's documented max-HP delta, including downward underflow.
+    // Production preparation must restore a valid HP after calling the engine.
+    mon->hp = (u16)(mon->hp + mon->maxHp - oldMax);
+}
+
+void CreateMon(struct Pokemon *mon, u16 species, u8 level, u8 fixedIV,
+               u8 hasFixedPersonality, u32 fixedPersonality, u8 otIdType,
+               u32 fixedOtId)
+{
+    (void)hasFixedPersonality;
+    (void)fixedPersonality;
+    (void)fixedOtId;
+    assert(otIdType == OT_ID_PLAYER_ID);
+    sCreates++;
+    memset(mon, 0, sizeof(*mon));
+    mon->species = species;
+    mon->level = level;
+    mon->exp = gExperienceTables[gSpeciesInfo[species].growthRate][level];
+    mon->hp = mon->maxHp = 150;
+    mon->mail = MAIL_NONE;
+    mon->identity.personality = 0x12345600 + sCreates;
+    mon->identity.otId = 0x54657374;
+    memset(mon->identity.ivs, fixedIV, sizeof(mon->identity.ivs));
+}
+
+bool8 TaichungTeamSpeciesAllowed(u16 species)
+{
+    return species >= SPECIES_BULBASAUR && species <= SPECIES_MEWTWO;
+}
+
+void TaichungTeamApplyPreset(struct Pokemon *mon)
+{
+    static const u16 moves[MAX_MON_MOVES] = {10, 20, 30, 0};
+    static const u8 pp[MAX_MON_MOVES] = {35, 15, 10, 0};
+    sPresets++;
+    memcpy(mon->moves, moves, sizeof(moves));
+    memcpy(mon->pp, pp, sizeof(pp));
+}
+
+bool8 GetSetPokedexFlag(u16 species, u8 action)
+{
+    assert(species >= 1 && species <= 150);
+    assert(action == FLAG_SET_SEEN || action == FLAG_SET_CAUGHT);
+    sDexWrites++;
+    if (action == FLAG_SET_SEEN)
+        sSeen[species] = TRUE;
+    else
+        sCaught[species] = TRUE;
+    return TRUE;
+}
+
+void HealPlayerParty(void)
+{
+    unsigned i;
+    sHeals++;
+    for (i = 0; i < gPlayerPartyCount; i++)
+    {
+        gPlayerParty[i].hp = gPlayerParty[i].maxHp;
+        gPlayerParty[i].status = 0;
+        memset(gPlayerParty[i].pp, 10, sizeof(gPlayerParty[i].pp));
+    }
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0xA5, sizeof(sSave));
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.x = 30;
+    sSave.location.y = 66;
+    sSave.vars[0x40F7 - VARS_START] = 1;
+    sSave.vars[0x40F8 - VARS_START] = 1;
+    sSave.vars[0x40F9 - VARS_START] = 3;
+    sSave.vars[0x40FA - VARS_START] = 0x155;
+    sSave.vars[0x40FB - VARS_START] = 2;
+    sSave.vars[0x40FC - VARS_START] = SPECIES_PIKACHU;
+    sSave.vars[0x40FD - VARS_START] = 3;
+    sProtectedSave = sSave;
+    gSaveBlock1Ptr = &sSave;
+    memset(gPlayerParty, 0, sizeof(gPlayerParty));
+    memset(&gMain, 0, sizeof(gMain));
+    memset(sSeen, 0, sizeof(sSeen));
+    memset(sCaught, 0, sizeof(sCaught));
+    gPlayerPartyCount = 0;
+    sCreates = sRecalculations = sPresets = sHeals = sDexWrites = 0;
+}
+
+static void AssertProtectedSave(void)
+{
+    // Includes every variable, in particular 40F7–40FD, and field position.
+    assert(memcmp(&sSave, &sProtectedSave, sizeof(sSave)) == 0);
+}
+
+static struct Pokemon OldPartner(u16 species, u8 level)
+{
+    struct Pokemon mon;
+    memset(&mon, 0x6C, sizeof(mon));
+    mon.species = species;
+    mon.level = level;
+    mon.exp = gExperienceTables[gSpeciesInfo[species].growthRate][level];
+    mon.hp = 1;
+    mon.maxHp = level == 80 ? 300 : 20;
+    mon.status = 0x40;
+    mon.heldItem = ITEM_ORAN_BERRY;
+    mon.mail = 3;
+    mon.isEgg = FALSE;
+    return mon;
+}
+
+static void TestInvalidChoices(void)
+{
+    struct Pokemon original[PARTY_SIZE];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_PIKACHU, 5);
+    memcpy(original, gPlayerParty, sizeof(original));
+    assert(!TaichungTeamSetSlot(2, SPECIES_CHARIZARD)); // Cannot make a gap.
+    assert(!TaichungTeamSetSlot(PARTY_SIZE, SPECIES_CHARIZARD));
+    assert(!TaichungTeamSetSlot(255, SPECIES_CHARIZARD));
+    assert(!TaichungTeamSetSlot(0, SPECIES_NONE));
+    assert(!TaichungTeamSetSlot(0, SPECIES_MEW));
+    assert(!TaichungTeamSetSlot(0, SPECIES_TREECKO));
+    gMain.inBattle = TRUE;
+    assert(!TaichungTeamSetSlot(0, SPECIES_CHARIZARD));
+    assert(!TaichungTeamSetSlot(1, SPECIES_CHARIZARD));
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(gPlayerPartyCount == 1);
+    assert(sCreates == 0 && sPresets == 0 && sDexWrites == 0);
+    AssertProtectedSave();
+}
+
+static void TestSixSlotsAndReplacement(void)
+{
+    static const u16 choices[PARTY_SIZE] = {
+        SPECIES_BULBASAUR, SPECIES_CHARIZARD, SPECIES_PIKACHU,
+        SPECIES_ALAKAZAM, SPECIES_GYARADOS, SPECIES_DRAGONITE
+    };
+    struct Pokemon original[PARTY_SIZE];
+    unsigned i;
+    Reset();
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        memcpy(original, gPlayerParty, sizeof(original));
+        assert(TaichungTeamSetSlot((u8)i, choices[i]));
+        assert(gPlayerPartyCount == i + 1);
+        assert(memcmp(gPlayerParty, original, i * sizeof(struct Pokemon)) == 0);
+        assert(gPlayerParty[i].species == choices[i]);
+        assert(gPlayerParty[i].level == 50);
+        assert(gPlayerParty[i].hp == gPlayerParty[i].maxHp);
+        assert(gPlayerParty[i].heldItem == ITEM_NONE && gPlayerParty[i].mail == MAIL_NONE);
+        assert(gPlayerParty[i].moves[0] == 10 && gPlayerParty[i].pp[0] == 35);
+        assert(sSeen[choices[i]] && sCaught[choices[i]]);
+    }
+    memcpy(original, gPlayerParty, sizeof(original));
+    assert(!TaichungTeamSetSlot(PARTY_SIZE, SPECIES_MEWTWO));
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    gPlayerParty[2].heldItem = ITEM_ORANGE_MAIL;
+    gPlayerParty[2].mail = 4;
+    memcpy(original, gPlayerParty, sizeof(original));
+    assert(TaichungTeamSetSlot(2, SPECIES_MEWTWO));
+    assert(gPlayerPartyCount == PARTY_SIZE);
+    assert(gPlayerParty[2].species == SPECIES_MEWTWO && gPlayerParty[2].level == 50);
+    assert(gPlayerParty[2].heldItem == ITEM_ORANGE_MAIL && gPlayerParty[2].mail == 4);
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (i != 2)
+            assert(memcmp(&gPlayerParty[i], &original[i], sizeof(original[i])) == 0);
+    assert(sCreates == 7 && sPresets == 7 && sDexWrites == 14);
+    AssertProtectedSave();
+}
+
+static void TestPrepareExistingMon(void)
+{
+    struct Pokemon mon, original;
+    Reset();
+    mon = OldPartner(SPECIES_CHARIZARD, 80);
+    original = mon;
+    TaichungTeamPrepareMon(&mon);
+    assert(mon.exp == gExperienceTables[1][50] && mon.level == 50);
+    assert(mon.hp == 150 && mon.hp == mon.maxHp && mon.status == 0);
+    assert(mon.heldItem == original.heldItem && mon.mail == original.mail && mon.species == original.species);
+    assert(memcmp(&mon.identity, &original.identity, sizeof(mon.identity)) == 0);
+    assert(mon.moves[0] == 10 && mon.pp[0] == 35);
+    assert(sCreates == 0 && sRecalculations == 1 && sPresets == 1);
+    mon = OldPartner(SPECIES_MEW, 80);
+    original = mon;
+    TaichungTeamPrepareMon(&mon);
+    assert(memcmp(&mon, &original, sizeof(mon)) == 0);
+    mon = OldPartner(SPECIES_BULBASAUR, 5);
+    mon.isEgg = TRUE;
+    original = mon;
+    TaichungTeamPrepareMon(&mon);
+    assert(memcmp(&mon, &original, sizeof(mon)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1);
+    AssertProtectedSave();
+}
+
+static void TestPrepareParty(void)
+{
+    struct MonIdentity original[2];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_BULBASAUR, 5);
+    gPlayerParty[1] = OldPartner(SPECIES_CHARIZARD, 80);
+    original[0] = gPlayerParty[0].identity;
+    original[1] = gPlayerParty[1].identity;
+    TaichungTeamPrepareParty();
+    assert(gPlayerPartyCount == 2);
+    assert(sRecalculations == 2 && sPresets == 2 && sHeals == 1);
+    assert(gPlayerParty[0].exp == gExperienceTables[0][50]);
+    assert(gPlayerParty[1].exp == gExperienceTables[1][50]);
+    assert(gPlayerParty[0].hp == gPlayerParty[0].maxHp && gPlayerParty[1].hp == gPlayerParty[1].maxHp);
+    assert(gPlayerParty[0].status == 0 && gPlayerParty[1].status == 0);
+    assert(memcmp(&gPlayerParty[0].identity, &original[0], sizeof(original[0])) == 0);
+    assert(memcmp(&gPlayerParty[1].identity, &original[1], sizeof(original[1])) == 0);
+    assert(gPlayerParty[0].heldItem == ITEM_ORAN_BERRY && gPlayerParty[1].mail == 3);
+    AssertProtectedSave();
+}
+
+static void TestEnsureLevelPreservesExplorationDamage(void)
+{
+    struct Pokemon original[PARTY_SIZE];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_PIKACHU, 50);
+    gPlayerParty[1] = OldPartner(SPECIES_BULBASAUR, 5);
+    memcpy(original, gPlayerParty, sizeof(original));
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(sRecalculations == 0 && sPresets == 0 && sHeals == 0);
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungTeamNoGrindActive());
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    gSaveBlock1Ptr = &sSave;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(&gPlayerParty[0], &original[0], sizeof(original[0])) == 0);
+    assert(gPlayerParty[1].level == 50 && gPlayerParty[1].hp == gPlayerParty[1].maxHp);
+    assert(gPlayerParty[1].exp == gExperienceTables[0][50]);
+    assert(memcmp(&gPlayerParty[1].identity, &original[1].identity, sizeof(original[1].identity)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1 && sHeals == 0);
+    memcpy(original, gPlayerParty, sizeof(original));
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1 && sHeals == 0);
+    AssertProtectedSave();
+}
+
+int main(void)
+{
+    TestInvalidChoices();
+    TestSixSlotsAndReplacement();
+    TestPrepareExistingMon();
+    TestPrepareParty();
+    TestEnsureLevelPreservesExplorationDamage();
+    puts("PASS: native team slot/capacity/battle guards, evolved choices, held mail, EXP-derived level 50, identity retention, high-level HP recovery, eggs/roster bounds, city-only upgrade, no exploration refill and protected save fields.");
+    return 0;
+}
