index 0000000..59f4b2f
--- /dev/null
+++ b/data/taichung/landmarks/theater/analyze_bank.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Measure the actual baseline Xitun/candidate graphics union without editing it."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image
+
+from encode_candidate import GAME, HERE, flip
+
+
+def words(path):
+    raw=path.read_bytes()
+    return struct.unpack(f'<{len(raw)//2}H',raw)
+
+
+def canonical(pixels):
+    return min(pixels,flip(pixels,True),flip(pixels,False,True),flip(pixels,True,True))
+
+
+def analyze():
+    layouts=json.loads((GAME/'data/layouts/layouts.json').read_text())['layouts']
+    layout=next(l for l in layouts if l.get('id')=='LAYOUT_TAICHUNG_XITUN')
+    if (layout['primary_tileset'],layout['secondary_tileset'])!=('gTileset_General','gTileset_PewterCity'):
+        raise ValueError('Baseline tilesets changed: update the analysis instead of applying stale budget counts.')
+    contract=json.loads((GAME/'docs/taichung-city-contract.json').read_text())
+    landmark=next(l for l in contract['landmarks'] if l['id']=='taichung-theater')
+    x0,y0,x1,y1=landmark['footprint']
+    cells=words(GAME/layout['blockdata_filepath'])
+    sets=[GAME/'data/tilesets/primary/general',GAME/'data/tilesets/secondary/pewter_city']
+    definitions=[words(folder/'metatiles.bin') for folder in sets]
+    source_png=Image.open(sets[1]/'tiles.png')
+    candidate_raw=(HERE/'candidate/tiles.4bpp').read_bytes()
+    candidate=[tuple((byte>>(4*half))&15 for byte in candidate_raw[i:i+32] for half in (0,1))
+               for i in range(0,len(candidate_raw),32)]
+    candidate_set={canonical(pixels) for pixels in candidate}
+
+    def scene(remove_theater):
+        used=set(c&0x3ff for i,c in enumerate(cells)
+                 if not remove_theater or not(x0<=i%layout['width']<=x1 and y0<=i//layout['width']<=y1))
+        graphic_ids=set()
+        palette_ids=set()
+        for metatile in used:
+            bank,n=(0,metatile) if metatile<640 else (1,metatile-640)
+            for entry in definitions[bank][n*8:n*8+8]:
+                palette_ids.add(entry>>12)
+                if (entry&0x3ff)>=640: graphic_ids.add(entry&0x3ff)
+        pixel_patterns=set()
+        for graphic in graphic_ids:
+            n=graphic-640;sx,sy=n%16*8,n//16*8
+            pixels=tuple(source_png.getpixel((sx+x,sy+y)) for y in range(8) for x in range(8))
+            pixel_patterns.add(canonical(pixels))
+        return dict(usedMetatiles=len(used),secondaryMetatiles=sorted(mt for mt in used if mt>=640),
+                    secondaryGraphicIds=sorted(graphic_ids),rawSecondaryGraphicCount=len(graphic_ids),
+                    flipCanonicalSecondaryGraphicCount=len(pixel_patterns),paletteBanksUsed=sorted(palette_ids)),pixel_patterns
+
+    current,current_patterns=scene(False)
+    remaining,remaining_patterns=scene(True)
+    union=remaining_patterns|candidate_set
+    share=remaining_patterns&candidate_set
+    source_files=[GAME/layout['blockdata_filepath'],sets[0]/'metatiles.bin',sets[1]/'metatiles.bin',sets[1]/'tiles.png']
+    report={
+        'schemaVersion':1,'mapId':'MAP_TAICHUNG_XITUN','status':'read-only baseline integration budget, not a registered bank',
+        'removeOnlyOldTheaterFootprintInclusive':[x0,y0,x1,y1],
+        'currentBaseline':current,'remainingBaselineAfterFacadeRemoval':remaining,
+        'candidate':{'uniqueGraphicCount':len(candidate_set),'paletteBank':7,'paintedDoorLocalMetatile':[8,9]},
+        'combined':{'uniqueSecondaryGraphicsAfterCrossPaletteFlipDedup':len(union),'capacity':376,
+                    'hardwareCapacity':384,'doorAnimationScratchSlots':8,
+                    'slotsRemaining':376-len(union),'sharedPixelPatterns':len(share),'fits':len(union)<=376,
+                    'candidatePalette7UnusedByRemainingBaseline':7 not in remaining['paletteBanksUsed'],
+                    'originalSecondaryMetatileDefinitionCount':len(definitions[1])//8,
+                    'definitionCountIfAll160CandidateCellsAppended':len(definitions[1])//8+160,
+                    'primaryGraphicsAndPalettesUnchanged':True},
+        'recommendation':[
+            'Clone a Xitun-specific secondary bank; retain every remaining source metatile ID and its palette8/9 assignments.',
+            'Pack only graphics referenced by the remaining actual scene, then append candidate patterns with flip-aware dedup and assign candidate palette7.',
+            'Do not add the entire general-purpose prefab catalog to this scene budget; add newly placed variants when they are actually used.',
+            'Keep native source coordinates unchanged until Root reviews alpha-derived footprint, background restoration and the actual animated door binding.'
+        ],
+        'sourceSha256':{str(path.relative_to(GAME)):hashlib.sha256(path.read_bytes()).hexdigest() for path in source_files}
+    }
+    (HERE/'candidate/integration-budget.json').write_text(json.dumps(report,indent=2)+'\n')
+    return report
+
+
+if __name__=='__main__':
+    report=analyze()
+    print(json.dumps({'current':report['currentBaseline']['rawSecondaryGraphicCount'],
+                      'remaining':report['remainingBaselineAfterFacadeRemoval']['rawSecondaryGraphicCount'],
+                      'remainingFlipDedup':report['remainingBaselineAfterFacadeRemoval']['flipCanonicalSecondaryGraphicCount'],
+                      'remainingPalettes':report['remainingBaselineAfterFacadeRemoval']['paletteBanksUsed'],
+                      'combined':report['combined']},indent=2))
