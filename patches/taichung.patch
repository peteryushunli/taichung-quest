+
+    def events():
+        def moved(event):
+            x, y = SIGN_MOVES.get((event["x"], event["y"]), (event["x"], event["y"])) if event.get("type") == "sign" else (event["x"], event["y"])
+            return {**event, "x": x + dx, "y": y + dy}
+
+        for key in install.EVENTS:
+            tests.require(data[key] == [moved(e) for e in base_data[key]], f"{key} are not today's, moved by {install.SHIFT}")
+        tests.require({k: v for k, v in data.items() if k not in install.EVENTS + ("connections",)}
