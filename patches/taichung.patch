+    document = document.replace("mapping-qa-${token}", "gameplay-qa-${token}")
+    document = document.replace("taichung-map-qa-", "taichung-gameplay-qa-")
+    fixture_description = (
+        f"EXPLICIT NATIVE SRAM FIXTURE: {config['fixture']['name']} will be imported before loadGame. Choose native Continue."
