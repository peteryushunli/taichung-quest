+void RunTextPrinters(void) {}
+void AddTextPrinterParameterized3(u8 window, u8 font, u8 x, u8 y, const u8 *colors, s8 speed, const u8 *text)
+{
+    (void)font; (void)colors; (void)speed;
+    assert(sWindow && window == 0 && x < 240 && y < 160 && text != NULL);
+    // Compare pointer identities only; never dereference them after this call.
+    if (strstr((const char *)text, "Badge") || sChinese || !strcmp((const char *)text, "?"))
+        if (sPrintCount < ARRAY_COUNT(sPrinted)) sPrinted[sPrintCount++] = (const char *)text;
+}
