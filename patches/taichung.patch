+#!/usr/bin/env python3
+"""Validate and compose native prefab words; no existing map source is modified."""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+
+ROOT=Path(__file__).resolve().parents[3]
+DEFAULT_CATALOG=ROOT/'data/taichung/prefabs/catalog.json'
+WALK={0x00,0x02,0x08,0x0a,0x0b,0x0c,0x16,0x17,0x21,0x22,0x23,0x28,0x2a}
+DOOR_BEHAVIORS=set(range(0x60,0x70))
+GROUND_CLASSES={
+    'mowed-grass': {0x001,0x008,0x009,0x010,0x011},
+    'paving': {0x165,0x166,0x167,0x16d,0x16e,0x16f,0x175,0x176,0x177,
+               0x1b8,0x1b9,0x1ba,0x1bb,0x1bc,0x1c0,0x1c1,0x1c2,0x1c3,0x1c4,0x1c8},
+}
+
+
+class PrefabError(ValueError):
+    pass
+
+
+def require(value,message):
+    if not value: raise PrefabError(message)
+
+
+def binary(path,fmt):
+    raw=path.read_bytes(); size=struct.calcsize(fmt)
+    require(len(raw)%size==0,f'Odd native data size:{path}')
+    return struct.unpack(f'<{len(raw)//size}{fmt}',raw)
+
+
+def parse_words(prefab):
+    return [[int(w,0) if isinstance(w,str) else w for w in row] for row in prefab['words']]
+
+
+class Library:
+    def __init__(self,source=ROOT,catalog=DEFAULT_CATALOG):
+        self.source=Path(source)
+        self.catalog=json.loads(Path(catalog).read_text()) if not isinstance(catalog,dict) else catalog
+        self.prefabs={p['id']:p for p in self.catalog['prefabs']}
+        self.attributes=[]; self.metatiles=[]; self.graphics_counts=[]
+        for folder in ('primary/general','secondary/pewter_city'):
+            base=self.source/'data/tilesets'/folder
+            self.attributes.append(binary(base/'metatile_attributes.bin','I'))
+            self.metatiles.append(binary(base/'metatiles.bin','H'))
+            png=(base/'tiles.png').read_bytes()
+            require(png[:8]==b'\x89PNG\r\n\x1a\n',f'Expected native indexed PNG:{base}')
+            w,h=struct.unpack('>II',png[16:24])
+            require(w%8==0 and h%8==0,'Graphics dimensions must align to8x8 tiles')
+            self.graphics_counts.append(w*h//64)
+        self._map_index=None
+
+    def attr(self,tile):
+        which,index=(0,tile) if tile<640 else (1,tile-640)
+        require(index<len(self.attributes[which]),f'Undefined native metatile:{tile:#x}')
+        return self.attributes[which][index]
+
+    def walkable(self,word):
+        return not word&0xc00 and (self.attr(word&0x3ff)&0x1ff) in WALK and word>>12==3
+
+    def allowed_ground(self,prefab,word):
+        return self.walkable(word) and any(word&0x3ff in GROUND_CLASSES[name] for name in prefab['allowedGround'])
+
+    def validate(self):
+        require(self.catalog['schemaVersion']==1,'Unknown prefab schema')
+        require(len(self.prefabs)==len(self.catalog['prefabs']),'Duplicate prefab ID')
+        require(self.graphics_counts[0]<=640 and self.graphics_counts[1]<=384,'Native graphics capacity exceeded')
+        rows=[];all_graphics=set();all_palettes=set();all_metatiles=set()
+        for p in self.prefabs.values():
+            name=p['id']; w,h=p['width'],p['height']; grid=parse_words(p)
+            require(w>0 and h>1 and len(grid)==h and all(len(row)==w for row in grid),f'{name}: dimensions disagree')
+            masks=p['masks']
+            for kind in ('paint','solid','mandatoryClear'):
+                require(len(masks[kind])==h and all(len(row)==w and set(row)<=set('01') for row in masks[kind]),f'{name}: invalid{kind} mask')
+            palettes=set(); metatiles=set(); graphics=set()
+            for y,row in enumerate(grid):
+                for x,word in enumerate(row):
+                    require(0<=word<=0xffff,f'{name}: invalid word at{x},{y}')
+                    tile=word&0x3ff; attr=self.attr(tile); metatiles.add(tile)
+                    require((attr&0x1ff) not in DOOR_BEHAVIORS,f'{name}: dormant prefab has active warp behavior at{x},{y}')
+                    require(bool(word&0xc00)==(masks['solid'][y][x]=='1'),f'{name}: solid mask/collision mismatch at{x},{y}')
+                    if masks['solid'][y][x]=='1':
+                        require(masks['paint'][y][x]=='1',f'{name}: solid cell not painted')
+                        require(word>>12==0,f'{name}: building/tree collision must ignore underlying story elevation')
+                    if masks['mandatoryClear'][y][x]=='1':
+                        require(self.walkable(word),f'{name}: required clear cell is not normal elevation3 ground')
+                    which,index=(0,tile) if tile<640 else (1,tile-640)
+                    entries=self.metatiles[which][index*8:(index+1)*8]
+                    require(len(entries)==8,f'{name}: missing metatile graphic references')
+                    for entry in entries:
+                        palette=entry>>12; graphic=entry&0x3ff; palettes.add(palette); graphics.add(graphic)
+                        require(palette<13,f'{name}: palette{palette} is outside active0..12 budget')
+                        bank,num=(0,graphic) if graphic<640 else (1,graphic-640)
+                        require(num<self.graphics_counts[bank],f'{name}: graphic{graphic} missing for tileset pair')
+            require(masks['mandatoryClear'][-1]=='1'*w and masks['paint'][-1]=='0'*w,f'{name}: final apron must be clear and preserve ground')
+            require(masks['solid'][-1]=='0'*w,f'{name}: apron blocks movement')
+            require(set(p['allowedGround'])<=GROUND_CLASSES.keys(),f'{name}: unknown ground class')
+            for entry in p['entrances']:
+                x,y=entry['position']; ax,ay=entry['southApproach']
+                require(0<=x<w and 0<=y<h-1 and [ax,ay]==[x,y+1],f'{name}: invalid southern approach')
+                require(masks['mandatoryClear'][ay][ax]=='1',f'{name}: entrance approach not protected')
+                require(grid[y][x]==int(entry['dormantWord'],0),f'{name}: dormant door word mismatch')
+                active=int(entry['activeDoorWord'],0)
+                require(active&0xc00 and active>>12==0 and self.attr(active&0x3ff)&0x1ff==0x69,f'{name}: active door is not a native animated door')
+            all_graphics|=graphics;all_palettes|=palettes;all_metatiles|=metatiles
+            rows.append(dict(id=name,size=[w,h],role=p['role'],reservedEntrances=len(p['entrances']),
+                             palettes=sorted(palettes),uniqueMetatiles=len(metatiles),uniqueGraphics=len(graphics),
+                             primaryGraphics=len([g for g in graphics if g<640]),
+                             secondaryGraphics=len([g for g in graphics if g>=640])))
+        for r in self.catalog['artReservations']:
+            require(r['status']=='requires-custom-native-art' and 'words' not in r,'Unimplemented art reservation must not imply native asset')
+        return dict(result='pass',implementedPrefabs=len(rows),artReservations=len(self.catalog['artReservations']),
+                    nativeGraphicsCounts=self.graphics_counts,
+                    usedGraphicsUnion=dict(primary=len([g for g in all_graphics if g<640]),
+                        secondary=len([g for g in all_graphics if g>=640]),
+                        secondarySourceIndices=sorted(g-640 for g in all_graphics if g>=640),
+                        secondarySourcePrefix=max((g-640+1 for g in all_graphics if g>=640),default=0),
+                        palettes=sorted(all_palettes),metatileIds=sorted(all_metatiles)),prefabs=rows)
+
+    def map_index(self):
+        if self._map_index is None:
+            self._map_index={}
+            for path in (self.source/'data/maps').glob('*/map.json'):
+                data=json.loads(path.read_text()); self._map_index[data['id']]=data
+        return self._map_index
+
+    def verified_door(self,source_map,world_x,world_y,binding):
+        """Activation follows authored event data; it never invents one-way warps."""
+        maps=self.map_index()
+        require(source_map in maps,f'Active door requires a registered exterior map:{source_map}')
+        require(set(binding)=={'warpIndex','destMap','destWarpId'},'Door binding needs warpIndex,destMap,destWarpId only')
+        index=binding['warpIndex']; exterior=maps[source_map]
+        require(isinstance(index,int) and 0<=index<len(exterior['warp_events']),'Exterior warp index missing')
+        warp=exterior['warp_events'][index]
+        require((warp['x'],warp['y'])==(world_x,world_y),'Authored exterior warp does not match placed door position')
+        require(warp['dest_map']==binding['destMap'] and int(warp['dest_warp_id'])==binding['destWarpId'],'Destination differs from authored exterior warp')
+        require(binding['destMap'] in maps,'Interior map is not registered')
+        target=maps[binding['destMap']]['warp_events']; dest=binding['destWarpId']
+        require(isinstance(dest,int) and 0<=dest<len(target),'Interior entry warp missing')
+        require(target[dest]['dest_map']==source_map and int(target[dest]['dest_warp_id'])==index,'Interior entry lacks paired exterior return')
+        return dict(warpIndex=index,x=world_x,y=world_y,elevation=0,dest_map=binding['destMap'],dest_warp_id=str(dest))
+
+    def compose(self,width,height,placements,base=None,protected_paths=(),source_map=None):
+        """Return a fresh grid and reservation manifest; callers' grids stay unchanged."""
+        require(width>0 and height>0,'Positive composition dimensions required')
+        cells=list(base) if base is not None else [0x3001]*(width*height)
+        require(len(cells)==width*height,'Base grid byte dimensions disagree')
+        occupied=set(); clear=set(); protected=set(map(tuple,protected_paths)); manifest=[]; painted=set()
+        for n,placement in enumerate(placements):
+            require(set(placement)<=set(('id','prefab','x','y','doors','context')),'Unknown placement field')
+            require(placement['prefab'] in self.prefabs,f"Unknown implemented prefab:{placement['prefab']}")
+            p=self.prefabs[placement['prefab']]; grid=parse_words(p); px,py=placement['x'],placement['y']; masks=p['masks']
+            if 'context' in placement:require(placement['context'] in p['allowedContext'],f"{p['id']}: context is not allowed")
+            require(isinstance(px,int) and isinstance(py,int) and px>=0 and py>=0 and px+p['width']<=width and py+p['height']<=height,f"{p['id']}: placement exceeds grid")
+            solids={(px+x,py+y) for y in range(p['height']) for x in range(p['width']) if masks['solid'][y][x]=='1'}
+            required={(px+x,py+y) for y in range(p['height']) for x in range(p['width']) if masks['mandatoryClear'][y][x]=='1'}
+            painting={(px+x,py+y) for y in range(p['height']) for x in range(p['width']) if masks['paint'][y][x]=='1'}
+            require(not solids&(protected|clear|occupied),f"{p['id']}: building/prop blocks reserved path, apron or occupied footprint")
+            require(not required&occupied,f"{p['id']}: mandatory-clear apron/path overlaps a building")
+            for x,y in painting|required:
+                require(self.allowed_ground(p,cells[y*width+x]),f"{p['id']}: destination ground is blocked, unsupported terrain or wrong elevation at{x},{y}")
+            require(not painting&painted,f"{p['id']}: painted modules overlap")
+            for y in range(p['height']):
+                for x in range(p['width']):
+                    if masks['paint'][y][x]=='1':cells[(py+y)*width+px+x]=grid[y][x]
+            door_bindings=placement.get('doors',{})
+            require(set(door_bindings)<=set(e['id'] for e in p['entrances']),f"{p['id']}: unknown entrance binding")
+            for entry in p['entrances']:
+                ex,ey=entry['position']; ax,ay=entry['southApproach']; binding=door_bindings.get(entry['id'])
+                record=dict(placement=placement.get('id',str(n)),prefab=p['id'],entrance=entry['id'],
+                    position=[px+ex,py+ey],southApproach=[px+ax,py+ay],status='dormant-reservation',nativeWarp=None)
+                if binding is not None:
+                    record['nativeWarp']=self.verified_door(source_map,px+ex,py+ey,binding)
+                    cells[(py+ey)*width+px+ex]=int(entry['activeDoorWord'],0);record['status']='active-verified-pair'
+                manifest.append(record)
+            occupied|=solids;clear|=required;painted|=painting
+        # Verify post-composition paths, so later modules cannot silently block them.
+        for x,y in clear|protected:
+            require(0<=x<width and 0<=y<height and self.walkable(cells[y*width+x]),f'Protected path blocked at{x},{y}')
+        raw=struct.pack(f'<{len(cells)}H',*cells)
+        return dict(width=width,height=height,words=cells,entrances=manifest,
+                    solidCells=len(occupied),protectedClearCells=len(clear|protected),sha256=hashlib.sha256(raw).hexdigest())
+
+
+def render_tools():
+    spec=importlib.util.spec_from_file_location('taichung_render_maps',ROOT/'tools/taichung/render_maps.py')
+    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    return module
+
+
+def render_catalog(library,output):
+    from PIL import Image,ImageDraw
+    tiles=render_tools().render_metatiles(library.source,'General','PewterCity')
+    cols=4; cw,ch=400,360; rows=(len(library.prefabs)+cols-1)//cols
+    image=Image.new('RGB',(cols*cw,rows*ch+96),'#e9efeb');draw=ImageDraw.Draw(image)
+    draw.text((16,12),'TAICHUNG NATIVE PREFAB CATALOG / SOURCE BLOCKOUT v1',fill='#172b25')
+    draw.text((16,32),'Reused FireRed art. Taiwan-specific skins are pending. Door squares mark dormant reservations.',fill='#31473d')
+    draw.text((16,50),'Final apron row is clear and unpainted on placement. All native doors remain closed until paired warps are verified.',fill='#31473d')
+    for i,p in enumerate(library.prefabs.values()):
+        ox,oy=(i%cols)*cw,(i//cols)*ch+80;grid=parse_words(p)
+        draw.rounded_rectangle((ox+6,oy+4,ox+cw-6,oy+ch-4),8,fill='#f9faf5',outline='#c3d0c5')
+        draw.text((ox+14,oy+12),p['name'],fill='#152b23');draw.text((ox+14,oy+30),f"{p['width']}x{p['height']} / {p['role']}",fill='#496253')
+        scale=min(2,max(1,370//(p['width']*16)),max(1,270//(p['height']*16))); step=16*scale
+        patch=Image.new('RGB',(p['width']*16,p['height']*16))
+        for y,row in enumerate(grid):
+            for x,word in enumerate(row):patch.paste(tiles[word&0x3ff],(x*16,y*16))
+        patch=patch.resize((patch.width*scale,patch.height*scale),Image.Resampling.NEAREST)
+        px,py=ox+(cw-patch.width)//2,oy+52;image.paste(patch,(px,py))
+        draw.line((px,py+(p['height']-1)*step,px+patch.width,py+(p['height']-1)*step),fill='#3c9b83',width=2)
+        for entry in p['entrances']:
+            x,y=entry['position'];draw.rectangle((px+x*step,py+y*step,px+(x+1)*step-1,py+(y+1)*step-1),outline='#dc6f28',width=2)
+        draw.text((ox+14,oy+ch-24),p['id'],fill='#526c5a')
+    output.parent.mkdir(parents=True,exist_ok=True);image.save(output)
+
+
+def render_composition(library,composition,output):
+    from PIL import Image
+    tiles=render_tools().render_metatiles(library.source,'General','PewterCity')
+    image=Image.new('RGB',(composition['width']*16,composition['height']*16))
+    for i,word in enumerate(composition['words']):image.paste(tiles[word&0x3ff],(i%composition['width']*16,i//composition['width']*16))
+    output.parent.mkdir(parents=True,exist_ok=True);image.resize((image.width*2,image.height*2),Image.Resampling.NEAREST).save(output)
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action',choices=['validate','catalog','compose'])
+    parser.add_argument('--catalog',type=Path,default=DEFAULT_CATALOG)
+    parser.add_argument('--source',type=Path,default=ROOT)
+    parser.add_argument('--output',type=Path)
+    parser.add_argument('--placements',type=Path)
+    args=parser.parse_args();library=Library(args.source,args.catalog);report=library.validate()
+    if args.action=='validate':print(json.dumps(report,indent=2));return
+    require(args.output is not None,'Explicit output path required')
+    if args.action=='catalog':render_catalog(library,args.output);print(args.output);return
+    require(args.placements is not None,'Composition needs --placements')
+    plan=json.loads(args.placements.read_text())
+    width,height=plan['width'],plan['height']
+    base=[int(plan.get('baseWord','0x3001'),0)]*(width*height)
+    protected=list(plan.get('protectedPaths',[]))
+    for layer in plan.get('groundRects',[]):
+        x0,y0,x1,y1=layer['rect'];word=int(layer['word'],0)
+        require(0<=x0<=x1<width and 0<=y0<=y1<height and library.walkable(word),'Ground rectangle must be clear elevation3 native ground')
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):base[y*width+x]=word
+    for x0,y0,x1,y1 in plan.get('protectedRects',[]):
+        require(0<=x0<=x1<width and 0<=y0<=y1<height,'Protected rectangle exceeds composition')
+        protected.extend((x,y) for y in range(y0,y1+1) for x in range(x0,x1+1))
+    composition=library.compose(width,height,plan['placements'],base=base,protected_paths=protected,source_map=plan.get('sourceMap'))
+    args.output.mkdir(parents=True,exist_ok=True)
+    (args.output/'map.bin').write_bytes(struct.pack(f"<{len(composition['words'])}H",*composition['words']))
+    (args.output/'manifest.json').write_text(json.dumps({k:v for k,v in composition.items() if k!='words'},indent=2)+'\n')
+    render_composition(library,composition,args.output/'source-preview.png')
+    print(json.dumps({k:v for k,v in composition.items() if k not in ('words','entrances')},indent=2))
+
+
+if __name__=='__main__':main()
