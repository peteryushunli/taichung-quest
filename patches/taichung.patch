+    reviewed = support.Files(source, STREETS_BASE)
+    report = _check(source, {**(overrides or {}), **(delta or {}), **{path: reviewed.read(path) for path in STREET_FILES}}, False)
+    streets = load("xitun_streets_delegated_guard", source/STREETS_GUARD).check(source, overrides)
+    report["errors"] += ["Xitun streets: "+error for error in streets["errors"]]
+    report["passed"] = report["passed"] and streets["passed"]
+    report["streetIncrement"] = {"guard": STREETS_GUARD, "reviewedV7Commit": STREETS_BASE, "files": list(STREET_FILES),
+                                 "passed": streets["passed"], "checks": {k: v["passed"] for k, v in streets["checks"].items()}}
+    return report
