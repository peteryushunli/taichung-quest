+        paint(*door,0x043d)
+        info.append(dict(id=identity,input=str(path.relative_to(ROOT)),inputSha256=hashlib.sha256(path.read_bytes()).hexdigest(),
+                         origin=list(origin),size=[w,h],door=list(door),occupiedCells=occupied,localMetatileIds=mapping))
+    assert len(definitions)<=384
+    for group in definitions:
