+#!/usr/bin/env python3
+"""Draft blockouts for the Old City and Greenway rework (phase 2a, docs only).
+
+Builds the districts from the cell-exact master plan (`masterplan.json`, today's world
+tiles, rect ends exclusive): Greenway 40x109 at (40,-5), and one 44x130 column at (80,-5)
+that holds two maps, Old City North 44x53 at (80,-5) over Old City 44x77 at (80,48) (today's
+rows, unshifted). The raised highway runs on rows -5..0 with its retaining wall on rows 1-2;
+every street that meets no other street stops one tile short at a kerb. Streets, water, plazas
+and the approved new landmarks come from the plan; the new landmarks are the tile-efficient
+redraws (landmark_redraw.py), or the board's set pieces
+fitted to real tiles (landmark_tiles.py) where there is none. Landmarks keep their live art and
+position. Parks, paths, paving and lots follow the fill pass's `plan-cells.txt` cell for cell:
+the Greenway spine and east lawn and Taichung Park as drawn there, and every 'B' block packed
+wall to wall with building styles the cells' viewers can draw (plan_lots).
+
+Writes blockout PNGs (16 px per tile, map-local, so they lay onto the plan directly),
+framed versions with a legend, a world overview on the plan render, and a JSON summary
+with the checks below. It never writes map.bin.
+
+Checks: every plan street and water cell is drawn as such; every door approach is
+walkable and connected across the Greenway-Old City seam; all water is one body; the
+highway rows are unbroken; what each neighbour has to draw in its connection strip (only
+kit or primary pieces, unless the art is carried at identical IDs today); the buffer limit;
+the secondary tile budget of each map, Old City North's new one included.
+
+  python3 tools/taichung/rework/oldcity_greenway_draft.py --output-dir DIR \
+      [--plan-dir DIR_WITH_masterplan.json_AND_plan.png] [--drafts-dir DIR]
+
+Requires Pillow. Kit pieces are named, not numbered: the city kit has no IDs yet.
+"""
+
+import argparse
+import json
+import re
+import struct
+import sys
+from collections import deque
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import render_maps as native  # noqa: E402
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import landmark_redraw  # noqa: E402
+import landmark_tiles  # noqa: E402
+
+TILE = 16
+TREES = {0x00E, 0x00F, 0x016, 0x017}
+MAIN = ["side", "asp", "line", "asp", "side"]
+
+# class: (fill, walkable, legend label, kit piece)
+CLASSES = {
+    "hwy": ("#35383f", False, "Highway, 6 wide", "highway"),
+    "wall": ("#6e675e", False, "Retaining wall under the highway", "wall-n-upper, wall-n-lower"),
+    "culvert": ("#5d6f80", False, "Culvert arch: Green River leaves the wall", "wall-culvert-nw/ne/sw/se"),
+    "riv": ("#3f86d4", False, "Boundary river (no Surf)", "river, river-bank-*"),
+    "can": ("#3f86d4", False, "Green River, 2 wide (no Surf)", "canal, canal-bank-*"),
+    "lake": ("#3f86d4", False, "Park lake, new banks", "lake-bank-*"),
+    "walk": ("#c9c1a8", True, "Bank: riverside or canal walk", "riverside-walk"),
+    "asp": ("#4b505c", True, "Asphalt", "asphalt"),
+    "line_h": ("#4b505c", True, "Asphalt, dashed centre", "centre-line-h"),
+    "line_v": ("#4b505c", True, "Asphalt, dashed centre", "centre-line-v"),
+    "xwalk_h": ("#4b505c", True, "Crosswalk", "crosswalk-h"),
+    "xwalk_v": ("#4b505c", True, "Crosswalk", "crosswalk-v"),
+    "side": ("#d6d0c2", True, "Sidewalk", "sidewalk, curb"),
+    "pave": ("#eadfc4", True, "Park pavers or plaza", "pavers"),
+    "grass": ("#86bd6c", True, "Lawn", "grass"),
+    "tall": ("#4f9a46", True, "Tall grass (encounters)", "tall grass"),
+    "flower": ("#e7a3b4", True, "Flower bed", "flowers"),
+    "pbridge": ("#b08a5a", True, "Path bridge over Green River", "pb-ew-*"),
+    "yard": ("#d8e6c8", True, "Block interior: yards, parking", "grass, pavers"),
+    "tree": ("#2e7d3c", False, "Trees", "tree"),
+    "shrub": ("#4f9a4a", False, "Shrubs", "shrub"),
+    "bldg": ("#e8925a", False, "New lot: installed city-v3 style", "city-v3 building"),
+    "bldgc": ("#d9b44a", False, "New lot in a strip: style Greenway already draws", "FireRed house (carried)"),
+    "lmk": ("#b48ad8", False, "New landmark on real tiles (redraw or fitted plan art)", "new art"),
+    "prim": ("#9fb7d9", False, "Primary kiosk or stall (city-v3 library), safe in any strip", "real tiles"),
+    "keep": (None, False, "Landmark or sign: live art, unchanged", "unchanged"),
+    "live": (None, True, "Kept live ground (real tiles: park, paths, trees)", "unchanged"),
+}
+WALKABLE = {k for k, v in CLASSES.items() if v[1]}
+WATER = {"riv", "can", "lake"}
+STREETISH = {"asp", "line_h", "line_v", "xwalk_h", "xwalk_v", "side"}
+FREE = {"pave", "grass", "yard", "flower"}
+
+
+def words(path):
+    data = path.read_bytes()
+    return struct.unpack(f"<{len(data) // 2}H", data)
+
+
+def classify(word):
+    m, solid = word & 0x3FF, (word >> 10) & 3
+    if m in TREES:
+        return "tree"
+    if m == 0x005:
+        return "shrub"
+    if 0x1A0 <= m <= 0x1B2:
+        return "lake"
+    if m == 0x00D:
+        return "tall"
+    if m == 0x001:
+        return "grass"
+    if not solid:
+        return "pave"
+    return "keep"
+
+
+class Grid:
+    """One map on the plan. Local cell (x, y) is world (x + ox, y + oy)."""
+
+    def __init__(self, name, key, plan, old_origin, source, fill, rect=None):
+        self.name, self.key = name, key
+        x0, y0, x1, y1 = rect or plan["districts"][key]["plan"]
+        self.ox, self.oy, self.w, self.h = x0, y0, x1 - x0, y1 - y0
+        self.old_ox, self.old_oy = old_origin
+        self.old = words(source / f"data/layouts/{name}/map.bin")
+        self.old_w = 40
+        self.old_h = len(self.old) // self.old_w
+        self.shift = (self.old_ox - self.ox, self.old_oy - self.oy)
+        self.c = [[fill] * self.w for _ in range(self.h)]
+        self.art = {}        # local cell -> old cell whose live art is kept
+        self.under = set()   # bridge cells with water beneath
+        self.kerbs = set()   # street ends the plan stops at a kerb: kit bollards
+        self.railings = set()  # walk, path and plaza cells beside water, bridges aside: kit railings
+        self.rail_corners = {}  # walk cell -> diagonal where a canal ends in open water: kit inner corner
+        self.tiles = {}      # local cell -> 16x16 image of a new landmark's fitted tiles
+        self.landmarks = []
+        self.labels = []     # (text, x, y, axis)
+        self.doors, self.signs, self.npcs, self.moved = [], [], [], []
+        self.streets = []
+        self.split = None    # first local row of the southern map when one grid draws two maps
+        self.prefab_ids = {}  # local cell -> primary metatile of a placed prefab
+        self.lot_rects = []   # (x0, y0, x1, y1, cls, (style, rows, cols)) of every building
+        self.tree_anchors = set()  # top-left cells of the plan's 2x2 trees
+        self.cells = {}           # the plan's cells, world coords (plan_fill)
+        self.overwritten = []     # kept live art the plan's fill replaced
+
+    # Coordinates.
+    def local(self, rect):
+        """World rect (ends exclusive) -> local inclusive rect, clipped; None if outside."""
+        x0, y0, x1, y1 = rect
+        a, b = max(x0 - self.ox, 0), max(y0 - self.oy, 0)
+        c, d = min(x1 - self.ox, self.w) - 1, min(y1 - self.oy, self.h) - 1
+        return (a, b, c, d) if a <= c and b <= d else None
+
+    def is_new(self, x, y):
+        """Land the live map does not cover today."""
+        ox, oy = x - self.shift[0], y - self.shift[1]
+        return not (0 <= ox < self.old_w and 0 <= oy < self.old_h)
+
+    def get(self, x, y):
+        return self.c[y][x] if 0 <= x < self.w and 0 <= y < self.h else None
+
+    def put(self, x, y, cls, force=False):
+        if not (0 <= x < self.w and 0 <= y < self.h):
+            return
+        if self.c[y][x] == "keep" and not force:
+            return
+        if self.c[y][x] in WATER and cls in WALKABLE | {"hwy"}:
+            self.under.add((x, y))
+        self.art.pop((x, y), None)
+        self.tiles.pop((x, y), None)
+        self.prefab_ids.pop((x, y), None)
+        self.c[y][x] = cls
+
+    def rect(self, x0, y0, x1, y1, cls, only=None, force=False):
+        for y in range(y0, y1 + 1):
+            for x in range(x0, x1 + 1):
+                if only is None or self.get(x, y) in only:
+                    self.put(x, y, cls, force)
+
+    def wrect(self, rect, cls, only=None, force=False):
+        r = self.local(rect)
+        if r:
+            self.rect(*r, cls, only, force)
+
+    def copy_old(self, rect=None, move=(0, 0)):
+        """Copy live cells into a world rect, classified, each with its live art."""
+        r = self.local(rect) if rect else (0, 0, self.w - 1, self.h - 1)
+        if not r:
+            return
+        for y in range(r[1], r[3] + 1):
+            for x in range(r[0], r[2] + 1):
+                ox, oy = x - self.shift[0], y - self.shift[1]
+                if 0 <= ox < self.old_w and 0 <= oy < self.old_h:
+                    tx, ty = x + move[0], y + move[1]
+                    cls = classify(self.old[oy * self.old_w + ox])
+                    self.put(tx, ty, cls, force=True)
+                    self.art[(tx, ty)] = (ox, oy)
+
+    # Streets.
+    def street(self, name, axis, first, span, profile=MAIN, label=True):
+        """A plan street in world terms: first asphalt row/col, [span) along it."""
+        at = first - 1 - (self.oy if axis == "h" else self.ox)
+        lo, hi = (span[0] - self.ox, span[1] - self.ox) if axis == "h" else (span[0] - self.oy, span[1] - self.oy)
+        lo, hi = max(lo, 0), min(hi, self.w if axis == "h" else self.h) - 1
+        across = self.h if axis == "h" else self.w
+        if lo > hi or at + len(profile) <= 0 or at >= across:
+            return
+        self.streets.append({"name": name, "axis": axis, "at": at, "span": [lo, hi], "profile": profile})
+        for i, kind in enumerate(profile):
+            cls = {"line": "line_h" if axis == "h" else "line_v"}.get(kind, kind)
+            for t in range(lo, hi + 1):
+                x, y = (t, at + i) if axis == "h" else (at + i, t)
+                self.put(x, y, cls)
+        if label and hi - lo > 6:
+            mid, centre = (lo + hi) / 2, at + (len(profile) - 1) / 2
+            self.labels.append((name, mid if axis == "h" else centre, centre if axis == "h" else mid, axis))
+
+    def junctions(self):
+        """Junction boxes, and crosswalks where a sidewalk line crosses the other street."""
+        for h in (s for s in self.streets if s["axis"] == "h"):
+            for v in (s for s in self.streets if s["axis"] == "v"):
+                for i, hk in enumerate(h["profile"]):
+                    y = h["at"] + i
+                    if not v["span"][0] <= y <= v["span"][1]:
+                        continue
+                    for j, vk in enumerate(v["profile"]):
+                        x = v["at"] + j
+                        if not h["span"][0] <= x <= h["span"][1] or self.get(x, y) == "keep":
+                            continue
+                        h_road, v_road = hk in ("asp", "line"), vk in ("asp", "line")
+                        self.put(x, y, "asp" if h_road and v_road else
+                                 "xwalk_h" if h_road else "xwalk_v" if v_road else "side")
+
+    # Primary pieces.
+    def prefab(self, x, y, kind):
+        """A primary object from the city-v3 library: the same art in every primary."""
+        for dy, row in enumerate(PREFABS[kind]):
+            for dx, metatile in enumerate(row):
+                self.put(x + dx, y + dy, "prim", force=True)
+                self.tiles[(x + dx, y + dy)] = primary_render(metatile)
+                self.prefab_ids[(x + dx, y + dy)] = metatile
+
+    # Events.
+    def door(self, name, ox, oy, move=(0, 0)):
+        x, y = ox + self.shift[0] + move[0], oy + self.shift[1] + move[1]
+        self.doors.append({"name": name, "door": [x, y], "approach": [x, y + 1],
+                           "world": [x + self.ox, y + self.oy], "moved": list(move) if any(move) else None})
+
+    def sign(self, name, ox, oy, search=None, avoid=(), move=(0, 0)):
+        """Keep a sign's art (moved with its landmark); if its cell is now street, water, park or
+        a plan path, move it to the nearest free cell off the paths."""
+        x, y = ox + self.shift[0] + move[0], oy + self.shift[1] + move[1]
+        free = lambda cx, cy: (self.get(cx, cy) in FREE and (cx, cy) not in avoid
+                               and self.cells.get((cx + self.ox, cy + self.oy)) != "p")
+        if self.get(x, y) != "keep" and not free(x, y):
+            x0, y0, x1, y1 = search
+            spots = [(abs(cx - x) + abs(cy - y), cy, cx) for cy in range(y0, y1 + 1) for cx in range(x0, x1 + 1) if free(cx, cy)]
+            _, ny, nx = min(spots)
+            self.moved.append({"name": name, "from": [x, y], "to": [nx, ny]})
+            x, y = nx, ny
+        self.put(x, y, "keep", force=True)
+        self.art[(x, y)] = (ox, oy)
+        self.signs.append({"name": name, "at": [x, y], "world": [x + self.ox, y + self.oy]})
+
+
+def place_landmarks(g, plan, fitted, ground):
+    """The approved new landmarks at their plan rects. A cell whose tiles are plain ground, lawn
+    or flowers stays walkable as that class; Yizhong Street's lane is walkable too."""
+    for lm in plan["newLandmarks"]:
+        r = g.local(lm["rect"])
+        if not r or (r[2] - r[0] + 1, r[3] - r[1] + 1) != (lm["rect"][2] - lm["rect"][0], lm["rect"][3] - lm["rect"][1]):
+            continue
+        render, open_cells = fitted.get(lm["n"], (None, {}))
+        lane = {r[0] + (r[2] - r[0] + 1) // 2 - 1, r[0] + (r[2] - r[0] + 1) // 2} if lm["name"] == "Yizhong Street" else set()
+        for y in range(r[1], r[3] + 1):
+            for x in range(r[0], r[2] + 1):
+                cell = render.crop(((x - r[0]) * TILE, (y - r[1]) * TILE, (x - r[0] + 1) * TILE, (y - r[1] + 1) * TILE)) if render else None
+                cls = open_cells.get(cell.tobytes()) if cell is not None else None
+                g.put(x, y, cls or (ground if x in lane else "lmk"), force=True)
+                if cell is not None:
+                    g.tiles[(x, y)] = cell
+        g.landmarks.append({"n": lm["n"], "name": lm["name"], "rect": list(r), "world": lm["rect"]})
+        g.labels.append((f"{lm['n']} {lm['name']}", (r[0] + r[2]) / 2, r[1] - 0.1 if r[1] > 6 else (r[1] + r[3]) / 2, "t"))
+
+
+def landmark_signs(g):
+    """Each new landmark gets a sign on its edge, read from a walkable cell outside it: the
+    cell nearest its centre column, then the lowest, so a hall's sign sits on its front."""
+    for lm in g.landmarks:
+        x0, y0, x1, y1 = lm["rect"]
+        cx = (x0 + x1) / 2
+        fronts = sorted(((x, y) for y in range(y0, y1 + 1) for x in range(x0, x1 + 1) if g.get(x, y) == "lmk"),
+                        key=lambda c: (abs(c[0] - cx), -c[1]))
+        edges = [((x, y), (x, y + 1)) for x, y in fronts]
+        edges += [((x0, y), (x0 - 1, y)) for y in range(y1, y0 - 1, -1)] + [((x1, y), (x1 + 1, y)) for y in range(y1, y0 - 1, -1)]
+        for (sx, sy), (ax, ay) in edges:
+            if g.get(sx, sy) == "lmk" and g.get(ax, ay) in WALKABLE:
+                lm["sign"] = {"at": [sx, sy], "approach": [ax, ay], "world": [sx + g.ox, sy + g.oy]}
+                break
+
+
+def load_plan(folder):
+    """masterplan.json, with the fill pass's plan-cells.txt as plan["cells"]: {(x, y): char}."""
+    folder = Path(folder)
+    plan = json.loads((folder / "masterplan.json").read_text())
+    lines = (folder / "plan-cells.txt").read_text().split("\n")
+    x0, y0 = (int(v) for v in re.search(r"x (-?\d+)\.\..*y (-?\d+)\.\.", lines[0]).groups())
+    plan["cells"] = {(x0 + i, y0 + j): ch for j, row in enumerate(lines[3:]) for i, ch in enumerate(row)}
+    return plan
+
+
+# plan-cells.txt -> class, for everything the plan draws cell by cell. Streets, water and
+# landmarks ('S', 's', 'H', '~', 'L') come from the plan's rects; 'B' is packed by plan_lots.
+# 'W' is the highway's retaining wall; where Green River runs out under it, a culvert arch.
+RAIL_CORNERS = {"nw": (-1, -1), "ne": (1, -1), "sw": (-1, 1), "se": (1, 1)}
+PLAN_FILL = {"T": "tree", "t": "tree", "g": "grass", "G": "tall", "p": "pave", ".": "pave", "P": "pave",
+             "f": "flower", "h": "shrub", "b": "pbridge", "W": "wall"}
+STREET_ROAD = {"asp", "line_h", "line_v"}
+
+
+def plan_fill(g, cells):
+    """The plan's cells, plus the edge rules that keep their own codes: a sidewalk cell off the
+    streets is a bank walk (Green River's, in kit sidewalk so it draws the same across the Old
+    City seam); a street cell the plan draws as sidewalk is a kerb (the street meets no other
+    street there); a wall cell over the channel's first water row is the culvert; and a walk,
+    path or plaza cell beside water (not a bridge, whose parapet is its own) takes a railing.
+    Where a canal ends in open water at a crossing walk, the walk cell that water touches only
+    at a corner takes an inner corner, joining the side rail beside it to the run across the
+    canal's end; where the canal runs on under a road bridge, the parapet meets the rail itself.
+    Bollards and railings draw over the cell's paving."""
+    g.cells = cells
+    for y in range(g.h):
+        for x in range(g.w):
+            ch = cells.get((x + g.ox, y + g.oy))
+            if ch in PLAN_FILL and g.c[y][x] == "keep":
+                g.overwritten.append((x, y, ch))
+            if ch in PLAN_FILL:
+                g.put(x, y, PLAN_FILL[ch], force=True)
+            if ch == "T":
+                g.tree_anchors.add((x, y))
+            if ch == "s" and g.c[y][x] in STREET_ROAD:
+                g.put(x, y, "side", force=True)
+                g.kerbs.add((x, y))
+            elif ch == "s" and g.c[y][x] not in STREETISH:
+                if g.c[y][x] == "keep":
+                    g.overwritten.append((x, y, ch))
+                g.put(x, y, "walk", force=True)
+    for y in range(g.h - 1, -1, -1):
+        for x in range(g.w):
+            below = cells.get((x + g.ox, y + g.oy + 1))
+            if g.c[y][x] == "wall" and (below == "~" or g.get(x, y + 1) == "culvert"):
+                g.put(x, y, "culvert", force=True)
+    walks = ("s", "p", "P", ".")
+    for y in range(g.h):
+        for x in range(g.w):
+            wx, wy = x + g.ox, y + g.oy
+            if cells.get((wx, wy)) not in walks or g.c[y][x] not in WALKABLE or (x, y) in g.under:
+                continue
+            if any(cells.get((wx + dx, wy + dy)) == "~" for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1))):
+                g.railings.add((x, y))
+            for name, (dx, dy) in RAIL_CORNERS.items():
+                if (x, y) not in g.railings and cells.get((wx + dx, wy + dy)) == "~" and \
+                        cells.get((wx + dx, wy)) in walks and cells.get((wx, wy + dy)) in walks and \
+                        (x + dx, y) not in g.under and (x, y + dy) not in g.under:
+                    g.rail_corners[(x, y)] = name
+
+
+# Mid-block crossings the plan stripes (plan.png), world rects with exclusive ends: the
+# Greenway walk across every street, its cross walks over G41 and G72, and Taichung Park's
+# paths over OC89 and OC101. Junction crosswalks come from the streets themselves.
+CROSSINGS = {"h": [(57, 16, 59, 19), (57, 30, 59, 33), (55, 43, 59, 46), (57, 101, 60, 104), (101, 80, 107, 83)],
+             "v": [(41, 8, 44, 10), (41, 37, 44, 39), (41, 54, 44, 56), (41, 68, 44, 70),
+                   (72, 8, 75, 10), (72, 37, 75, 39), (72, 54, 75, 56), (72, 68, 75, 72), (89, 67, 92, 69)]}
+
+
+def plan_crossings(g):
+    for axis, rects in CROSSINGS.items():
+        for r in rects:
+            g.wrect(r, f"xwalk_{axis}", only={"asp", "line_h", "line_v"})
+
+
+# Lot styles: a style's own rows, cut or stretched to the block's depth, and its bays for the
+# width (the FireRed house widens bay by bay; the city-v3 styles are 4 or 6 wide).
+CITY_ROWS = {3: [(0, 3, 4)], 4: [(0, 1, 3, 4), (0, 2, 3, 4)], 5: [(0, 1, 2, 3, 4)], 6: [(0, 1, 2, 2, 3, 4)]}
+FIRERED_ROWS = {3: (0, 3, 4), 4: (0, 2, 3, 4), 5: (0, 1, 2, 3, 4)}
+
+
+def firered_cols(w):
+    left = (w - 2) // 2
+    return (0,) + (1,) * left + (2,) + (3,) * (w - 3 - left) + (4,)
+
+
+def city_widths(w, k):
+    """Townhouses (4) and teal duplexes (6) wall to wall across w, as evenly mixed as they go."""
+    fits = [(n4, (w - 4 * n4) // 6) for n4 in range(w // 4 + 1) if (w - 4 * n4) % 6 == 0]
+    if not fits:
+        return None
+    n4, n6 = min(fits, key=lambda f: (abs(f[0] - f[1]), f[0] + f[1]))
+    out, turn = [], k % 2
+    while n4 or n6:
+        if (turn and n4) or not n6:
+            out.append(4)
+            n4 -= 1
+        else:
+            out.append(6)
+            n6 -= 1
+        turn ^= 1
+    return out
+
+
+def plan_lots(g, cells):
+    """Every 'B' block, packed wall to wall and bottom-aligned on its doorstep row, with what
+    the cells' viewers can draw: the FireRed house where Greenway draws them (it carries it at
+    Old City's IDs, and so does Old City North now), kiosks and stalls where Wanhe does, and
+    elsewhere the city-v3 townhouse and teal duplex (Old City North carries them too)."""
+    lot = {(x, y) for y in range(g.h) for x in range(g.w) if cells.get((x + g.ox, y + g.oy)) == "B"}
+    bands, k = [], 0
+    for y in range(g.h):
+        x = 0
+        while x < g.w:
+            if (x, y) in lot and (y == 0 or (x, y - 1) not in lot or (x - 1, y) in lot and (x - 1, y - 1) not in lot):
+                x1 = x
+                while (x1 + 1, y) in lot:
+                    x1 += 1
+                if (x, y - 1) not in lot or (x1, y - 1) not in lot:
+                    y1 = y
+                    while all((c, y1 + 1) in lot for c in range(x, x1 + 1)):
+                        y1 += 1
+                    bands.append((x, y, x1, y1))
+                x = x1 + 1
+            else:
+                x += 1
+    covered = {(x, y) for x0, y0, x1, y1 in bands for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)}
+    assert covered == lot, sorted(lot - covered)[:8]
+    for n, (x0, y0, x1, y1) in enumerate(bands):
+        w, h = x1 - x0 + 1, y1 - y0 + 1
+        # Greenway draws Old City's west strip down to world row 110, Wanhe from row 97.
+        greenway, wanhe = x0 <= 7 and y0 + g.oy <= 110, x0 <= 7 and y1 + g.oy >= 97
+        assert x0 > 7 or x1 <= 7, (x0, x1)
+        g.rect(x0, y0, x1, y1, "shrub", force=True)      # whatever no building covers: hedge
+        if wanhe:
+            x = x0
+            while x + 3 <= x1:
+                kind = "stall" if h == 3 else "kiosk"
+                g.prefab(x, y1 - len(PREFABS[kind]) + 1, kind)
+                x += 4
+            continue
+        if greenway:
+            pieces = [w] if w <= 7 else [4] * (w // 4) + ([w % 4] if w % 4 else [])
+            rows = FIRERED_ROWS[min(h, 5)]
+            x = x0
+            for pw in pieces:
+                g.rect(x, y1 - len(rows) + 1, x + pw - 1, y1, "bldgc", force=True)
+                g.lot_rects.append((x, y1 - len(rows) + 1, x + pw - 1, y1, "bldgc", ("firered", rows, firered_cols(pw))))
+                x += pw
+            continue
+        widths = city_widths(w, n)
+        assert widths and h in CITY_ROWS, (g.name, x0, y0, w, h)
+        x = x0
+        for i, pw in enumerate(widths):
+            variants = CITY_ROWS[h]
+            rows = variants[(n + i) % len(variants)]
+            style = "townhouse" if pw == 4 else "teal"
+            g.rect(x, y0, x + pw - 1, y1, "bldg", force=True)
+            g.lot_rects.append((x, y0, x + pw - 1, y1, "bldg", (style, rows, tuple(range(pw)))))
+            x += pw
+        k += 1
+
+
+def plan_streets(g, plan):
+    for s in plan["streetsEastWest"]:
+        g.street(s["name"], "h", s["firstAsphaltRow"], (s["x0"], s["x1"]))
+    for s in plan["streetsNorthSouth"]:
+        g.street(s["name"], "v", s["firstAsphaltCol"], (s["y0"], s["y1"]))
+    g.junctions()
+
+
+def plan_water(g, plan):
+    for r in plan["river"]:
+        g.wrect(r, "riv", force=True)
+    for name, rects in plan["canals"].items():
+        for r in rects:
+            g.wrect(r, "can", force=True)
+
+
+def highway(g, plan):
+    g.wrect(plan["highway"]["north"], "hwy", force=True)
+
+
+def old_city(source, plan, fitted=None, miyahara_dy=-1):
+    north, south = plan["districts"]["oldcity_north"]["plan"], plan["districts"]["oldcity"]["plan"]
+    g = Grid("TaichungOldCity", "oldcity", plan, (80, 48), source, "yard", rect=(north[0], north[1], south[2], south[3]))
+    g.split = south[1] - north[1]
+    for name in ("Old Taichung Station", "Taichung Park", "Taichung Park lake"):
+        g.copy_old(plan["landmarkArt"][name])
+    # Miyahara moves up one row, as plan.png draws it, so OC101's north sidewalk runs clear.
+    mx0, my0, mx1, my1 = plan["landmarkArt"]["Miyahara"]
+    g.wrect((mx0, my0 + miyahara_dy, mx1, my1 + miyahara_dy), "yard", force=True)
+    g.copy_old(plan["landmarkArt"]["Miyahara"], move=(0, miyahara_dy))
+    place_landmarks(g, plan, fitted or {}, "pave")
+    plan_water(g, plan)
+    # The river bridge carries the highway.
+    highway(g, plan)
+    plan_streets(g, plan)
+    plan_fill(g, plan["cells"])
+    plan_lots(g, plan["cells"])
+    plan_crossings(g)
+
+    g.door("Old Station", 32, 64)
+    g.door("Taichung Park", 32, 30)
+    g.door("Miyahara", 20, 52, move=(0, miyahara_dy))
+    approaches = {tuple(d["approach"]) for d in g.doors}
+    g.sign("Old Station", 29, 66, avoid=approaches)
+    g.sign("Taichung Park", 29, 32, search=g.local((93, 72, 120, 79)), avoid=approaches)
+    g.sign("Miyahara", 17, 54, search=g.local((93, 94, 105, 100)), avoid=approaches)
+    g.npcs.append({"name": "Station guide", "at": [28, 66 + g.shift[1]]})
+    landmark_signs(g)
+    world_labels(g, [("Green River", 16.5, 25, "v"), ("Green River", 24.5, 87, "v"), ("East river", 41.5, 57, "v"),
+                     ("South river", 22, 122.5, "t"), ("Taichung Park", 30, 58, "t"), ("Old Station", 32, 103, "t"),
+                     ("Station plaza", 32.5, 114, "t"), ("Miyahara", 19, 93.2, "t")])
+    return g
+
+
+def world_labels(g, labels):
+    """Labels at local columns and world rows."""
+    g.labels += [(text, x, y - g.oy, axis) for text, x, y, axis in labels]
+
+
+# The gyms' live art (world rects, ends exclusive) and how far each moves: Shen Ji's gym with
+# the lawn column west of it, Fine Arts with its paths above and in front.
+SHEN_JI_ART, FINE_ARTS_ART = (46, 73, 51, 77), (45, 91, 55, 96)
+GYM_MOVES = {"Shen Ji": (SHEN_JI_ART, (1, 0)), "Fine Arts": (FINE_ARTS_ART, (3, 0))}
+
+
+def greenway(source, plan, fitted=None):
+    g = Grid("TaichungGreenway", "greenway", plan, (40, 32), source, "yard")
+    g.copy_old()     # the live landmarks' art, which the plan's 'L' cells keep
+    # Two gyms move east (landmarkMoves), out of the 8 columns Nantun North draws from Greenway
+    # with its own bank, which carries none of Greenway's art. Shen Ji's gym takes the path
+    # between it and the village, its lawn column following it; Fine Arts' old west end is the
+    # plan's to fill.
+    for rect, move in GYM_MOVES.values():
+        if rect == FINE_ARTS_ART:
+            g.wrect(rect, "yard", force=True)
+        g.copy_old(rect, move=move)
+    spine = g.local(plan["parks"]["Greenway spine"]["rect"])
+    place_landmarks(g, plan, fitted or {}, "grass")
+    highway(g, plan)
+    plan_streets(g, plan)
+    plan_fill(g, plan["cells"])
+    plan_crossings(g)
+
+    moves = {name: move for name, (_, move) in GYM_MOVES.items()}
+    g.door("Science Museum", 24, 20)
+    g.door("Greenway", 22, 36)
+    g.door("Shen Ji", 10, 44, move=moves["Shen Ji"])
+    g.door("Fine Arts", 10, 62, move=moves["Fine Arts"])
+    approaches = {tuple(d["approach"]) for d in g.doors}
+    for name, x, y in (("Science Museum", 21, 22), ("Greenway", 19, 38), ("Shen Ji", 7, 46), ("Fine Arts", 7, 64)):
+        g.sign(name, x, y, search=spine, avoid=approaches, move=moves.get(name, (0, 0)))
+    # The guide's shifted cell is one of the plan's trees: it stands on the walk below the gym.
+    g.npcs.append({"name": "Greenway guide", "at": [24, 39 + g.shift[1]]})
+    landmark_signs(g)
+    world_labels(g, [("Calligraphy Greenway spine", 28, 87, "v"), ("Science Museum", 23, 47.6, "t"),
+                     ("Greenway gym", 22, 57.6, "t"), ("Shen Ji", 12, 70.6, "t"), ("Fine Arts", 13, 89.6, "t")])
+    return g
+
+
+# Connection strips. The viewer draws these cells with its own tilesets (fieldmap.c: 8 columns
+# from a right neighbour, 7 from a left one, 7 rows from an up or down one, over the viewer's
+# height plus 7 rows each way).
+# (viewer, x0, y0, x1, y1, drawn): cells a neighbour draws with its own tilesets, in local
+# columns and world rows (`strips` gives them in the grid's rows). The Old City grid holds both
+# Old City North (world rows -5..47) and Old City (48..124). `drawn` is what the viewer draws at
+# the same IDs besides primary pieces: kept live art ("keep") where it carries it today, the
+# FireRed house ("bldgc"), the city-v3 styles ("bldg"). Nantun North's bank carries none of
+# Greenway's art (it is Wanhe's), so it draws only primary pieces: the gyms moved out of it.
+STRIPS = {
+    "TaichungOldCity": [("Greenway", 0, -5, 7, 47, {"bldgc"}), ("Old City", 0, 41, 43, 47, {"bldg", "bldgc"}),
+                        ("Old City North", 0, 48, 43, 54, {"bldg", "bldgc"}), ("Greenway", 0, 48, 7, 110, {"keep", "bldgc"}),
+                        ("Wanhe", 0, 97, 7, 124, set())],
+    "TaichungGreenway": [("Xitun", 0, -5, 7, 70, {"keep", "bldgc"}), ("Nantun North", 0, 57, 7, 103, set()),
+                         ("Old City North", 33, -5, 39, 54, set()), ("Old City", 33, 41, 39, 103, {"keep", "bldgc"}),
+                         ("Wanhe", 0, 97, 39, 103, {"keep", "bldgc"})],
+}
+
+
+def strips(g):
+    """STRIPS for one grid in its local rows."""
+    return [(v, x0, y0 - g.oy, x1, y1 - g.oy, drawn) for v, x0, y0, x1, y1, drawn in STRIPS[g.name]]
+NOT_PRIMARY = {"keep", "bldg", "bldgc", "lmk"}
+
+
+def map_of(g, y):
+    """The map a local row belongs to when one grid draws two maps."""
+    return "TaichungOldCityNorth" if g.split and y < g.split else g.name
+
+
+def checks(gw, oc, plan):
+    world = {}
+    for g in (gw, oc):
+        for y in range(g.h):
+            for x in range(g.w):
+                world[(x + g.ox, y + g.oy)] = (g.c[y][x], (x, y) in g.under, g)
+
+    def flood(start, ok):
+        seen, todo = {start}, deque([start])
+        while todo:
+            x, y = todo.popleft()
+            for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+                if n in world and n not in seen and ok(*world[n][:2]):
+                    seen.add(n)
+                    todo.append(n)
+        return seen
+
+    walk = lambda cls, under: cls in WALKABLE
+    wet = lambda cls, under: cls in WATER or under
+    station = oc.doors[0]["approach"]
+    reach = flood((station[0] + oc.ox, station[1] + oc.oy), walk)
+    doors = []
+    for g in (gw, oc):
+        for d in g.doors:
+            p = (d["approach"][0] + g.ox, d["approach"][1] + g.oy)
+            doors.append({"map": map_of(g, d["door"][1]), "name": d["name"], "door": d["door"], "world": d["world"],
+                          "approachClass": world[p][0], "reachable": p in reach})
+    signs = []
+    for g in (gw, oc):
+        for lm in g.landmarks:
+            s = lm.get("sign")
+            p = (s["approach"][0] + g.ox, s["approach"][1] + g.oy) if s else None
+            signs.append({"map": map_of(g, lm["rect"][1]), "landmark": f"{lm['n']} {lm['name']}", "world": lm["world"],
+                          "sign": s and s["world"], "reachable": bool(p and p in reach)})
+    water = [k for k, v in world.items() if wet(*v[:2])]
+    body = flood(water[0], wet)
+
+    # Plan conformity: every plan street cell is street (or a kept landmark), every water cell water.
+    off = {"street": [], "water": []}
+    for s in plan["streetsEastWest"] + plan["streetsNorthSouth"]:
+        if "firstAsphaltRow" in s:
+            cells = [(x, y) for y in range(s["firstAsphaltRow"] - 1, s["firstAsphaltRow"] + 4) for x in range(s["x0"], s["x1"])]
+        else:
+            cells = [(x, y) for x in range(s["firstAsphaltCol"] - 1, s["firstAsphaltCol"] + 4) for y in range(s["y0"], s["y1"])]
+        for p in cells:
+            if p in world and world[p][0] not in STREETISH and not world[p][1]:
+                off["street"].append([s["name"], *p, world[p][0]])
+    wet_plan = [r for r in plan["river"]] + [r for rs in plan["canals"].values() for r in rs]
+    for x0, y0, x1, y1 in wet_plan:
+        for y in range(y0, y1):
+            for x in range(x0, x1):
+                p = (x, y)
+                if p in world and not wet(*world[p][:2]):
+                    off["water"].append([x, y, world[p][0]])
+    crossings = [y + gw.oy for y in range(gw.h) if gw.c[y][gw.w - 1] in STREETISH and oc.c[y][0] in STREETISH]
+    strip = {}
+    for g in (gw, oc):
+        for viewer, x0, y0, x1, y1, drawn in strips(g):
+            seen = {}
+            for y in range(y0, min(y1, g.h - 1) + 1):
+                for x in range(x0, x1 + 1):
+                    cls = g.c[y][x]
+                    live = g.art.get((x, y))
+                    if cls in NOT_PRIMARY or live and g.old[live[1] * g.old_w + live[0]] & 0x3FF >= 640:
+                        seen[cls] = seen.get(cls, 0) + 1
+            strip[f"{viewer} draws {g.name} x{x0}-{x1} rows {y0}-{min(y1, g.h - 1)}"] = {
+                "drawn": sorted(drawn), "cells": seen, "ok": not set(seen) - drawn}
+    highway = all(g.c[y][x] == "hwy" for g in (gw, oc) for y in range(6) for x in range(g.w))
+    return {
+        "planStreetCellsNotStreet": off["street"],
+        "planWaterCellsNotWater": off["water"],
+        "doors": doors,
+        "allDoorsReachable": all(d["reachable"] for d in doors),
+        "landmarkSigns": signs,
+        "allLandmarkSignsReachable": all(s["reachable"] for s in signs),
+        "walkableCellsReachable": len(reach),
+        "waterCells": len(water),
+        "waterBodies": 1 if len(body) == len(water) else "more than one",
+        "streetCrossingRowsAtSeam": crossings,
+        "strips": strip,
+        "highwayRowsUnbroken": highway,
+        "allStripsOk": all(s["ok"] for s in strip.values()),
+        "buffer": {gw.name: [(gw.w + 15) * (gw.h + 14), 10240], "TaichungOldCityNorth": [(oc.w + 15) * (oc.split + 14), 10240],
+                   oc.name: [(oc.w + 15) * (oc.h - oc.split + 14), 10240]},
+    }
+
+
+def font(size):
+    for name in ("/System/Library/Fonts/Supplemental/Arial Bold.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf", "DejaVuSans.ttf"):
+        try:
+            return ImageFont.truetype(name, size)
+        except OSError:
+            pass
+    return ImageFont.load_default()
+
+
+def render_layout(source, layout_id):
+    layout = next(l for l in json.loads((source / "data/layouts/layouts.json").read_text())["layouts"] if l.get("id") == layout_id)
+    tiles = native.render_metatiles(source, layout["primary_tileset"], layout["secondary_tileset"])
+    data = native.words(source / layout["blockdata_filepath"])
+    image = Image.new("RGB", (layout["width"] * TILE, layout["height"] * TILE))
+    for n, value in enumerate(data):
+        image.paste(tiles[value & 0x3FF], (n % layout["width"] * TILE, n // layout["width"] * TILE))
+    return image
+
+
+def paint(g, live, strips=True):
+    """Blockout at 16 px per tile. Landmarks and signs show their live art."""
+    img = Image.new("RGB", (g.w * TILE, g.h * TILE), "#ffffff")
