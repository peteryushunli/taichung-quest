diff --git a/src/taichung_optional_story.c b/src/taichung_optional_story.c
new file mode 100644
index 00000000..38f57542
--- /dev/null
+++ b/src/taichung_optional_story.c
@@ -0,0 +1,135 @@
+#include "global.h"
+#include "event_data.h"
+#include "string_util.h"
+#include "taichung_language.h"
+#include "taichung_optional_story.h"
+#include "characters.h"
+
+const u8 gTaichungStoryAboutEn[] = _("About this place");
+const u8 gTaichungStoryAboutZh[] = _("認識這裡");
+const u8 gTaichungStoryStaffEn[] = _("Staff notes");
+const u8 gTaichungStoryStaffZh[] = _("在地小故事");
+const u8 gTaichungStoryBackEn[] = _("Back");
+const u8 gTaichungStoryBackZh[] = _("返回");
+const u8 gTaichungStoryResearchEn[] = _("Research notebook");
+const u8 gTaichungStoryResearchZh[] = _("研究筆記");
+const u8 gTaichungStoryGardenEn[] = _("Garden notebook");
+const u8 gTaichungStoryGardenZh[] = _("植物園筆記");
+const u8 gTaichungStoryEncounterEn[] = _("Encounter");
+const u8 gTaichungStoryEncounterZh[] = _("地標遭遇");
+
+static const u8 sUnavailableEn[] = _("No notes are available here.");
+static const u8 sUnavailableZh[] = _("這裡沒有筆記。");
+
+static const struct TaichungOptionalStory *FindStory(u16 historyId)
+{
+    u16 i;
+    for (i = 0; i < gTaichungOptionalStoryCount; i++)
+        if (gTaichungOptionalStories[i].historyId == historyId)
+            return &gTaichungOptionalStories[i];
+    return NULL;
+}
+
+static const struct TaichungOptionalStory *FindLeaderStory(u16 gymId)
+{
+    u16 i;
+    for (i = 0; i < gTaichungOptionalStoryCount; i++)
+        if (gTaichungOptionalStories[i].leaderQuestion != NULL
+            && gTaichungOptionalStories[i].leaderGymId == gymId)
+            return &gTaichungOptionalStories[i];
+    return NULL;
+}
+
+bool8 TaichungStoryHasPackage(u16 historyId)
+{
+    return FindStory(historyId) != NULL;
+}
+
+const u8 *TaichungStoryGetText(u16 historyId, u8 topic)
+{
+    const struct TaichungOptionalStory *story = FindStory(historyId);
+    const u8 *const *text = NULL;
+    if (story != NULL)
+    {
+        switch (topic)
+        {
+        case TAICHUNG_STORY_SIGN: text = story->sign; break;
+        case TAICHUNG_STORY_ABOUT: text = story->about; break;
+        case TAICHUNG_STORY_STAFF: text = story->staff; break;
+        case TAICHUNG_STORY_GARDEN: text = story->garden; break;
+        case TAICHUNG_STORY_STAFF_CREDIT: text = story->staffCredit; break;
+        }
+    }
+    if (text == NULL || text[0] == NULL || text[1] == NULL)
+        return TaichungText(sUnavailableEn, sUnavailableZh);
+    return TaichungText(text[0], text[1]);
+}
+
+void TaichungStory_ScriptHasPackage(void)
+{
+    const struct TaichungOptionalStory *story = FindStory(gSpecialVar_0x8004);
+    gSpecialVar_0x8006 = story != NULL ? story->historyId : 0xFFFF;
+    gSpecialVar_Result = story != NULL;
+}
+
+void TaichungStory_ScriptHasLeaderPackage(void)
+{
+    const struct TaichungOptionalStory *story = FindLeaderStory(gSpecialVar_0x8004);
+    gSpecialVar_0x8006 = story != NULL ? story->historyId : 0xFFFF;
+    gSpecialVar_Result = story != NULL;
+}
+
+void TaichungStory_ScriptHasGarden(void)
+{
+    const struct TaichungOptionalStory *story = FindStory(gSpecialVar_0x8006);
+    gSpecialVar_Result = story != NULL && story->garden[0] != NULL && story->garden[1] != NULL;
+}
+
+void TaichungStory_ScriptBufferSign(void)
+{
+    StringCopy(gStringVar4, TaichungStoryGetText(gSpecialVar_0x8006, TAICHUNG_STORY_SIGN));
+}
+
+void TaichungStory_ScriptBufferAbout(void)
+{
+    StringCopy(gStringVar4, TaichungStoryGetText(gSpecialVar_0x8006, TAICHUNG_STORY_ABOUT));
+}
+
+void TaichungStory_ScriptBufferStaff(void)
+{
+    StringCopy(gStringVar4, TaichungStoryGetText(gSpecialVar_0x8006, TAICHUNG_STORY_STAFF));
+}
+
+// A direct NPC conversation uses only the first authored page. FC19 glyph
+// digits are1..240, so the native page terminator cannot occur inside a glyph.
+// Keep the complete source text available to existing data readers.
+void TaichungStory_ScriptBufferStaffAnecdote(void)
+{
+    u8 *cursor;
+    TaichungStory_ScriptBufferStaff();
+    for (cursor = gStringVar4; *cursor != EOS; cursor++)
+    {
+        if (*cursor == CHAR_PROMPT_CLEAR)
+        {
+            *cursor = EOS;
+            break;
+        }
+    }
+}
+
+void TaichungStory_ScriptBufferGarden(void)
+{
+    StringCopy(gStringVar4, TaichungStoryGetText(gSpecialVar_0x8006, TAICHUNG_STORY_GARDEN));
+}
+
+void TaichungStory_ScriptRestoreQuestion(void)
+{
+    const struct TaichungOptionalStory *story = FindStory(gSpecialVar_0x8006);
+    if (story != NULL && story->leaderQuestion != NULL && story->leaderGymId == gSpecialVar_0x8004)
+        story->leaderQuestion();
+}
+
+void TaichungStory_ScriptBufferStaffCredit(void)
+{
+    StringCopy(gStringVar4, TaichungStoryGetText(gSpecialVar_0x8006, TAICHUNG_STORY_STAFF_CREDIT));
+}
