+def module(path):
+    spec=importlib.util.spec_from_file_location('approved_art_save_geometry',path)
+    result=importlib.util.module_from_spec(spec);spec.loader.exec_module(result)
+    return result
+
+
+def beneath_newer_layers(root):
+    """The tree beneath the later guest house layer (tools/taichung/home_start.py),
+    whose own guard proves it only opens signpost cells and makes one solid painted
+    door a working door, so no saved position needs a new repair. A tree without
+    that exact layer is used as it is."""
+    path=Path(root)/'tools/taichung/home_start.py'
+    if not path.exists():return contextlib.nullcontext(Path(root))
+    return module(path).beneath(root)
