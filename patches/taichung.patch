+#!/usr/bin/env python3
+"""Build provisional native prefabs from existing source tiles, never map grids."""
+import json
+from pathlib import Path
+import struct
+
+ROOT = Path(__file__).resolve().parents[3]
+CATALOG = ROOT / "data/taichung/prefabs/catalog.json"
+
+
+def words(path):
+    raw = path.read_bytes()
+    return struct.unpack(f"<{len(raw)//2}H", raw)
+
+
+def build_catalog():
+    layouts = json.loads((ROOT / "data/layouts/layouts.json").read_text())["layouts"]
+    layout = next(x for x in layouts if x.get("id") == "LAYOUT_PEWTER_CITY")
+    source = words(ROOT / layout["blockdata_filepath"])
+    attributes = []
+    for folder in ("primary/general", "secondary/pewter_city"):
+        raw = (ROOT / "data/tilesets" / folder / "metatile_attributes.bin").read_bytes()
+        attributes.append(struct.unpack(f"<{len(raw)//4}I", raw))
+
+    def behavior(tile):
+        which, index = (0,tile) if tile < 640 else (1,tile-640)
+        return attributes[which][index] & 0x1ff
+
+    def rect(box):
+        x0,y0,x1,y1 = box
+        return [[source[y*layout['width']+x] & 0x3ff for x in range(x0,x1+1)] for y in range(y0,y1+1)]
+
+    prefabs = []
+
+    def add(identity, title, role, body, context, material, provenance, entrances=(), traversable=(), note=""):
+        """Include a clear apron, keep every entrance dormant until native wiring."""
+        body = [row[:] for row in body]
+        width, body_height = len(body[0]), len(body)
+        assert all(len(row)==width for row in body)
+        # A copied vanilla door must never become an unpaired decorative warp.
+        for y,row in enumerate(body):
+            for x,tile in enumerate(row):
+                if 0x60 <= behavior(tile) <= 0x6f:
+                    body[y][x] = 0x02e
+        for entry in entrances:
+            body[entry[2]][entry[1]] = entry[3]
+        clear = set(traversable) | {(x,body_height) for x in range(width)}
+        grid = [[(0x3000|tile) if (x,y) in clear else (0x0400|tile) for x,tile in enumerate(row)] for y,row in enumerate(body)]
+        grid.append([0x3175]*width)
+        solid = ["".join('0' if (x,y) in clear else '1' for x in range(width)) for y in range(body_height)] + ['0'*width]
+        paint = ['1'*width for _ in range(body_height)] + ['0'*width]
+        required_clear = ["".join('1' if (x,y) in clear else '0' for x in range(width)) for y in range(body_height+1)]
+        entries = [dict(id=e[0],position=[e[1],e[2]],southApproach=[e[1],e[2]+1],
+                        dormantWord=f'0x{0x400|e[3]:04X}',activeDoorWord='0x043D',
+                        activation='requires-authored-exterior-warp-and-paired-interior-return') for e in entrances]
+        prefabs.append(dict(id=identity,name=title,status='implemented-source-blockout',role=role,
+            artStatus='provisional-native-reuse',taiwanSpecificArt=False,material=material,
+            allowedContext=context,allowedGround=['mowed-grass','paving'],
+            anchorBasis='top-left of entire patch; final row is a mandatory-clear unpainted apron',
+            width=width,height=body_height+1,bodyHeight=body_height,
