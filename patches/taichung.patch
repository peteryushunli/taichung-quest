diff --git a/src/taichung_opening.c b/src/taichung_opening.c
new file mode 100644
index 0000000..9afd2af
--- /dev/null
+++ b/src/taichung_opening.c
@@ -0,0 +1,42 @@
+#include "global.h"
+#include "event_data.h"
+#include "string_util.h"
+#include "taichung_language.h"
+#include "constants/maps.h"
