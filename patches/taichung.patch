+def newer_layer():
+    """The newer gym interiors layer guard beside this one, or None."""
+    path = Path(__file__).with_name("gym_interiors_guard.py")
+    if not path.exists():
+        return None
+    spec = importlib.util.spec_from_file_location("home_start_gym_interiors", path)
+    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
+    return module
+
+
+def peeled(read):
+    """(BASE bytes, added paths, reader) beneath the newer gym interiors layer when
+    `read` gives exactly that layer; ({}, set(), read) when it does not."""
+    layer = newer_layer()
+    if layer is None:
+        return {}, set(), read
+    class View:
+        pass
+    view = View(); view.source = None; view.read = read
+    under = layer.underneath(view)
+    if not under:
+        return {}, set(), read
+    hidden = layer.added(read)
+    def beneath_read(path):
+        if path in under:
+            return under[path]
+        if path in hidden or any(path.startswith(folder + "/") for folder in hidden):
+            raise FileNotFoundError(path)
+        return read(path)
+    return under, hidden, beneath_read
+
+
+def hidden(read):
+    """Paths a mirror beneath this layer leaves out: the guest house maps, and every
+    file and folder the newer gym interiors layer adds when the tree holds it."""
+    return set(ADDED) | set(ADDED_DIRS) | peeled(read)[1]
+
+
+def git_show(source, path, revision=BASE):
+    return subprocess.run(["git", "show", f"{revision}:{path}"], cwd=source, check=True, capture_output=True).stdout
+
+
+def dump_json(value):
+    return (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode()
+
+
+def words(raw, fmt="H"):
+    size = struct.calcsize(fmt)
+    return list(struct.unpack(f"<{len(raw) // size}{fmt}", raw))
+
+
+def pack(values, fmt="H"):
+    return struct.pack(f"<{len(values)}{fmt}", *values)
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def layer(base_read):
+    """{path: bytes} of this layer applied to the files base_read gives; raises
+    ValueError unless BASE holds exactly the cells and events it replaces."""
+    out = {}
+    events = {name: json.loads(base_read(MAP_JSON[name])) for name in WIDTH}
+    grids = {name: words(base_read(MAP_BIN[name])) for name in WIDTH}
+    for name in WIDTH:
+        require(dump_json(events[name]) == base_read(MAP_JSON[name]), f"{MAP_JSON[name]} is not canonical JSON")
+
+    # The working guest house door: a behaviour-only copy of the painted door.
+    metatiles = bytearray(base_read(METATILES))
+    attributes = words(base_read(ATTRIBUTES), "I")
+    slot, painted = DOOR - SECONDARY_START, PAINTED_DOOR - SECONDARY_START
+    require(len(attributes) == 384 and len(metatiles) == 384 * 16, "Old City secondary bank size differs")
+    require(not any(metatiles[slot * 16:slot * 16 + 16]) and attributes[slot] == 0, f"Slot {DOOR:#x} is not blank")
+    require(attributes[painted] & 0x1FF == 0, f"{PAINTED_DOOR:#x} already has a behaviour")
+    metatiles[slot * 16:slot * 16 + 16] = metatiles[painted * 16:painted * 16 + 16]
+    attributes[slot] = (attributes[painted] & ~0x1FF) | MB_WARP_DOOR
+    out[METATILES], out[ATTRIBUTES] = bytes(metatiles), pack(attributes, "I")
+
+    grid, width = grids[OLD_CITY], WIDTH[OLD_CITY]
+    x, y = DOOR_CELL
+    require(grid[y * width + x] & 0x3FF == PAINTED_DOOR, f"Old City {DOOR_CELL} is not the painted door")
+    grid[y * width + x] = (grid[y * width + x] & ~0x3FF) | DOOR
+    data = events[OLD_CITY]
+    require(all((w["x"], w["y"]) != DOOR_CELL for w in data["warp_events"]), "Guest house door already warps")
+    require(len(data["warp_events"]) == 3, "Old City warp list differs: the guest house must be warp 3")
+    data["warp_events"].append(dict(GUEST_HOUSE_WARP))
+    guide = [o for o in data["object_events"] if o.get("local_id") == GUIDE]
+    require(len(guide) == 1 and (guide[0]["x"], guide[0]["y"]) == GUIDE_FROM, "Station guide is not at the plaza")
+    guide[0]["x"], guide[0]["y"] = GUIDE_TO
+    require(grid[GUIDE_TO[1] * width + GUIDE_TO[0]] & 0xC00 == 0, "Guide's new square is not open ground")
+
+    for name, x, y, script, was, ground in REMOVED:
+        hits = [e for e in events[name]["bg_events"] if e.get("script") == script]
+        require(len(hits) == 1 and (hits[0]["type"], hits[0]["x"], hits[0]["y"]) == ("sign", x, y),
+                f"{name}: {script} is not one sign at ({x},{y})")
+        events[name]["bg_events"].remove(hits[0])
+        n = y * WIDTH[name] + x
+        if was is None:
+            require(grids[name][n] & 0xC00 == 0, f"{name} ({x},{y}) has a post")
+            continue
+        require(grids[name][n] == was, f"{name} ({x},{y}) is {grids[name][n]:#06x}, not its signpost")
+        grids[name][n] = ground
+
+    for name in WIDTH:
+        out[MAP_JSON[name]] = dump_json(events[name])
+        out[MAP_BIN[name]] = pack(grids[name])
+    return out
+
+
+def install(source=ROOT):
+    """Write the derived map/bank files from BASE and refresh the baseline bundle.
+    The hand-written edits (EDITED, ADDED) are already in the tree."""
+    source = Path(source).resolve()
+    for path, raw in layer(lambda path: git_show(source, path)).items():
+        (source / path).write_bytes(raw)
+    for path in BEFORE:
+        target = source / BUNDLE / path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(git_show(source, path))
+
+
+def _reader(source, overrides):
+    overrides = overrides or {}
+    return lambda path: overrides[path] if path in overrides else (Path(source) / path).read_bytes()
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def baseline(read):
+    """BASE bytes of every file this layer edits, from the bundle shipped with the
+    patch (no native git history needed); raises ValueError if any copy differs."""
+    out = {}
+    for path, expected in BEFORE.items():
+        raw = read(f"{BUNDLE}/{path}")
+        require(digest(raw) == expected, f"Baseline copy differs: {path}")
+        out[path] = raw
+    return out
+
+
+def verified(read):
+    """The report when the tree `read` gives is exactly BASE plus this layer (plus,
+    optionally, exactly the newer gym interiors layer); raises ValueError (or
+    OSError) otherwise. Returns (report, BASE bytes of both layers)."""
+    newer, _, read = peeled(read)
+    before = baseline(read)
+    want = layer(before.__getitem__)
+    for path, raw in want.items():
+        require(read(path) == raw, f"{path} is not BASE with exactly the guest house door and no waterway signs")
+    for path, expected in {**EDITED, **ADDED}.items():
+        require(digest(read(path)) == expected, f"{path} differs from the reviewed guest house opening")
+
+    # Independent semantic closure, re-derived from the tree, for the report.
+    city = json.loads(read(MAP_JSON[OLD_CITY]))
+    grid = words(read(MAP_BIN[OLD_CITY]))
+    attributes = words(read(ATTRIBUTES), "I")
+    metatiles = read(METATILES)
+    slot, painted = DOOR - SECONDARY_START, PAINTED_DOOR - SECONDARY_START
+    x, y = DOOR_CELL
+    require(grid[y * WIDTH[OLD_CITY] + x] & 0x3FF == DOOR and attributes[slot] & 0x1FF == MB_WARP_DOOR
+            and metatiles[slot * 16:slot * 16 + 16] == metatiles[painted * 16:painted * 16 + 16],
+            "The guest house door is not a working copy of the painted door")
+    require(city["warp_events"][3] == GUEST_HOUSE_WARP, "Old City warp 3 is not the guest house door")
+    first = json.loads(read("data/maps/TaichungGuestHouse_1F/map.json"))
+    second = json.loads(read("data/maps/TaichungGuestHouse_2F/map.json"))
+    warps1, warps2 = first["warp_events"], second["warp_events"]
+    require(warps1[1]["x"] == 4 and warps1[1]["y"] == 8, "Guest house warp 1 is not the door mat")
+    require([w["dest_map"] for w in warps1] == ["MAP_TAICHUNG_OLD_CITY"] * 2 + ["MAP_TAICHUNG_GUEST_HOUSE_2F", "MAP_TAICHUNG_OLD_CITY"]
+            and {w["dest_warp_id"] for i, w in enumerate(warps1) if i != 2} == {"3"} and warps1[2]["dest_warp_id"] == "0",
+            "Guest house 1F exits do not all lead to its Old City door")
+    require(len(warps2) == 1 and warps2[0]["dest_map"] == "MAP_TAICHUNG_GUEST_HOUSE_1F" and warps2[0]["dest_warp_id"] == "2"
+            and (warps2[0]["x"], warps2[0]["y"]) == (warps1[2]["x"], warps1[2]["y"]), "The guest house stairs do not pair up")
+    group = json.loads(read("data/maps/map_groups.json"))["gMapGroup_Taichung"]
+    require(group[-2:] == ["TaichungGuestHouse_1F", "TaichungGuestHouse_2F"] and len(group) == 21,
+            "The guest house maps are not appended as Taichung maps 19 and 20")
+    repair_targets = set()
+    for record, key, value in (("data/taichung/city-rework/save-v10.json", "map", OLD_CITY),
+                               ("data/taichung/approved-landmarks/save-v11.json", "mapId", "MAP_TAICHUNG_OLD_CITY")):
+        for item in json.loads(read(record))["maps"]:
+            if item[key] == value:
+                repair_targets |= {(r[2], r[3]) for r in item["repairs"]}
+    guide = [o for o in city["object_events"] if o.get("local_id") == GUIDE]
+    require(len(guide) == 1 and (guide[0]["x"], guide[0]["y"]) == GUIDE_TO and GUIDE_TO not in repair_targets
+            and not grid[GUIDE_TO[1] * WIDTH[OLD_CITY] + GUIDE_TO[0]] & 0xC00,
+            "Xiaoyu does not stand on open ground that no save repair targets")
+    newly_blocked = []
+    for name in WIDTH:
+        old, new = words(before[MAP_BIN[name]]), words(read(MAP_BIN[name]))
+        newly_blocked += [(name, n % WIDTH[name], n // WIDTH[name]) for n, (a, b) in enumerate(zip(old, new))
+                          if not a & 0xC00 and b & 0xC00]
+    require(not newly_blocked, f"Cells became blocked, which would need a save repair: {newly_blocked}")
+    water = ("River", "Creek", "Canal", "Pond", "Lake", "Stream")
+    signs = []
+    for name in WIDTH:
+        signs += [e["script"] for e in json.loads(read(MAP_JSON[name]))["bg_events"] if e.get("type") == "sign"]
+    require(not [s for s in signs if any(word in s for word in water)], "A waterway sign is still in place")
+    # The bedroom opens one settings screen (language row first, then encounters); the
+    # web answers its startup wait with the browser language, and there is no prompt.
+    bedroom = read("data/maps/TaichungGuestHouse_2F/scripts.inc").decode()
+    wake = bedroom[bedroom.index("TaichungGuestHouse_2F_WakeUp::"):bedroom.index("TaichungGuestHouse_2F_Console::")]
+    require("TaichungExploration_ScriptOpenStartup" in wake and "Taichung_InitLanguageCore" not in wake
+            and "Taichung_ChooseLanguageCore" not in wake and "multichoice" not in wake,
+            "The bedroom must open the settings screen without a separate language prompt")
+    report = {"door": {"cell": list(DOOR_CELL), "metatile": f"{DOOR:#x}", "copyOf": f"{PAINTED_DOOR:#x}",
+                       "warp": GUEST_HOUSE_WARP},
+              "guide": {"from": list(GUIDE_FROM), "to": list(GUIDE_TO)},
+              "removedSigns": [script.removeprefix("TaichungCity_Sign_") for _, _, _, script, _, _ in REMOVED],
+              "newlyBlocked": 0, "pinnedEdits": len(EDITED), "addedFiles": len(ADDED),
+              "peeledGymInteriors": bool(newer)}
+    return report, {**newer, **before}
+
+
+def check(source=ROOT, overrides=None):
+    try:
+        report, before = verified(_reader(Path(source).resolve(), overrides))
+        return {"passed": True, "errors": [], "base": BASE, "checks": report, "underlayPaths": len(before)}
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        return {"passed": False, "errors": [str(error)], "base": BASE}
+
+
+def underneath(files):
+    """{path: BASE bytes} for every file this layer edits, when `files.read` gives
+    exactly BASE plus this layer; otherwise {}, so a guard reads the real bytes.
+    Files the layer adds are listed in ADDED (and their folders in ADDED_DIRS)."""
+    try:
+        return verified(files.read)[1]
+    except (OSError, ValueError, KeyError, TypeError, IndexError):
+        return {}
+
+
+@contextlib.contextmanager
+def beneath(source=ROOT):
+    """A disposable read-only tree of `source` beneath this layer: every edited file
+    holds its BASE bytes and the added guest house maps are absent; everything else
+    is a symlink to the real file. When `source` does not hold exactly this layer it
+    yields `source` itself, so an older tree reads unchanged. The newer gym
+    interiors layer is peeled too (its files read as beneath it, its rooms are
+    absent). For an older guard
+    that only takes a folder (the save-v11 generator); it never writes `source`."""
+    source = Path(source).resolve()
+    class View:
+        pass
+    view = View(); view.source = source; view.read = _reader(source, None)
+    under = underneath(view)
+    if not under:
+        yield source
+        return
+    hidden_paths = hidden(view.read)
+    with tempfile.TemporaryDirectory(prefix="taichung-beneath-guest-house-") as temp:
+        def mirror(folder, rel):
+            folder.mkdir(exist_ok=True)
+            for path in sorted((source / rel).iterdir()):
+                child = str(PurePosixPath(rel) / path.name) if rel else path.name
+                target = folder / path.name
+                if child in hidden_paths:
+                    continue
+                if child in under:
+                    target.write_bytes(under[child])
+                elif any(key.startswith(child + "/") for key in [*under, *hidden_paths]):
+                    mirror(target, child)
+                else:
+                    target.symlink_to(path, target_is_directory=path.is_dir())
+        mirror(Path(temp), "")
+        yield Path(temp)
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve()
+    good = check(source)
+    read = _reader(source, None)
+    before = baseline(read)
+    want = layer(before.__getitem__)
+    probes = {"door-left-painted": {MAP_BIN[OLD_CITY]: before[MAP_BIN[OLD_CITY]]},
+              "post-left-standing": {MAP_BIN[WANHE]: before[MAP_BIN[WANHE]]}}
+    attributes = words(want[ATTRIBUTES], "I"); attributes[DOOR - SECONDARY_START] &= ~0x1FF
+    probes["door-without-behaviour"] = {ATTRIBUTES: pack(attributes, "I")}
+    data = json.loads(want[MAP_JSON[OLD_CITY]]); data["warp_events"].pop()
+    probes["door-without-warp"] = {MAP_JSON[OLD_CITY]: dump_json(data)}
+    data = json.loads(want[MAP_JSON[WANHE]])
+    data["bg_events"].append({"type": "sign", "x": 8, "y": 63, "elevation": 0,
+                              "player_facing_dir": "BG_EVENT_PLAYER_FACING_ANY", "script": "TaichungCity_Sign_FaziRiver"})
+    probes["waterway-sign-back"] = {MAP_JSON[WANHE]: dump_json(data)}
+    grid = words(want[MAP_BIN[OLD_CITY]]); grid[0] ^= 1
+    probes["other-cell"] = {MAP_BIN[OLD_CITY]: pack(grid)}
+    for name, path in [("opening-script", "data/maps/PalletTown/scripts.inc"), ("new-game-warp", "src/new_game.c"),
+                       ("bedroom-script", "data/maps/TaichungGuestHouse_2F/scripts.inc"),
+                       ("guest-house-map", "data/maps/TaichungGuestHouse_1F/map.json"),
+                       ("baseline-copy", f"{BUNDLE}/{MAP_BIN[OLD_CITY]}")]:
+        raw = bytearray(read(path)); raw[len(raw) // 2] ^= 1
+        probes[name] = {path: bytes(raw)}
+    caught = {}
+    for name, overrides in probes.items():
+        class View:
+            pass
+        view = View(); view.source = source; view.read = _reader(source, overrides)
+        caught[name] = not check(source, overrides)["passed"] and underneath(view) == {}
+    original_run = subprocess.run
+    def no_subprocess(*args, **kwargs):
+        raise AssertionError("The portable guest house check must not invoke git")
+    try:
+        subprocess.run = no_subprocess
+        portable = check(source)["passed"]
+    finally:
+        subprocess.run = original_run
+    newer = peeled(read)[0]
+    with beneath(source) as view:
+        view = Path(view)
+        peels = (view == source if not good["passed"] else
+                 (view / "data/taichung/minimap-contract.json").read_bytes() == before["data/taichung/minimap-contract.json"]
+                 and not (view / "data/maps/TaichungGuestHouse_1F").exists()
+                 and (not newer or not (view / "data/layouts/TaichungGymTheater").exists()
+                      and (view / "include/taichung_save.h").read_bytes() == newer["include/taichung_save.h"]))
+    return {"passed": good["passed"] and portable and all(caught.values()) and peels, "tree": good,
+            "portableWithoutGit": portable, "beneathPeelsBothLayers": peels, "rejectedCorruptionProbes": caught}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    parser.add_argument("--install", action="store_true")
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if args.install:
+        install(args.source)
+    report = self_test(args.source) if args.self_test else check(args.source)
+    print(json.dumps(report, indent=2, ensure_ascii=False))
+    sys.exit(0 if report["passed"] else 1)
+
+
+if __name__ == "__main__":
+    main()
