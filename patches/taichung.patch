+    parser.add_argument("--player-avatar-address", type=numeric_address, help="Exact-ROM gPlayerAvatar ELF address (0x20 bytes)")
+    parser.add_argument("--object-events-address", type=numeric_address, help="Exact-ROM gObjectEvents ELF address (16 entries, stride 0x24)")
