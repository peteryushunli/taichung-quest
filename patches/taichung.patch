+        "mapleApproachClosed": ("geometry", world_with(12, 33, words[(33 + dy) * width + 12 + dx] | 0x0400)),
+        "treeOnPaving": ("geometry", world_with(4, 46, 0x040E)),
+        # A Shen Ji home piece (secondary art) on a stall lot inside Greenway's strip.
+        "secondaryInEastStrip": ("seams", world_with(36, 25, next(words[(y + dy) * width + x + dx] for y in range(20, 24) for x in range(3, 11)
+                                                                    if words[(y + dy) * width + x + dx] & 0x3FF >= 640))),
+        "southSeamClosed": ("seams", world_with(25, 63, 0x0400 | kit["hw-ns-0"])),
+        "warpNotMoved": ("events", json_with(install.MAP_JSON, lambda v: v["warp_events"][0].update(x=24))),
+        "greenwayOffsetToday": ("events", json_with(install.MAP_JSON, lambda v: v["connections"][0].update(offset=35))),
+        "mapleSignNotMoved": ("events", json_with(install.MAP_JSON, maple_sign_back)),
