+#!/usr/bin/env python3
+"""Compile the actual save migration C and test the v12 gym-room arrivals."""
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / 'build/taichung-tests/gym-interiors-v12'
+
+
+def main():
+    spec = importlib.util.spec_from_file_location('approved_art_save_truth', ROOT / 'tools/taichung_gameplay/generate-approved-art-save.py')
+    gen = importlib.util.module_from_spec(spec); spec.loader.exec_module(gen)
+    OUT.mkdir(parents=True, exist_ok=True)
+    gen.host_map_groups(ROOT, OUT)   # authored native map IDs, no ROM build needed
+    binary = OUT / 'save-v12'
+    subprocess.run(['cc', '-std=c99', '-Wall', '-Wextra', '-Werror',
+                    '-I' + str(ROOT / 'tests/save_host'), '-I' + str(ROOT / 'include'), '-I' + str(OUT),
+                    str(ROOT / 'src/taichung_save.c'), str(ROOT / 'src/taichung_encounter.c'),
+                    str(ROOT / 'tests/taichung_save_v12_test.c'), '-o', str(binary)], check=True)
+    result = subprocess.run([str(binary)], capture_output=True, text=True)
+    if result.returncode:
+        sys.stderr.write(result.stdout + result.stderr)
+        raise subprocess.CalledProcessError(result.returncode, [str(binary)])
+    print(result.stdout.strip())
+
+
+if __name__ == '__main__':
+    main()
