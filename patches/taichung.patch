+
+    def map_with(x, y, word):
+        raw = bytearray(read(install.MAP))
+        struct.pack_into("<H", raw, 2 * (y * width + x), word)
+        return {install.MAP: bytes(raw)}
+
+    def json_with(path, edit):
+        value = json.loads(read(path))
+        edit(value)
