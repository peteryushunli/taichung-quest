@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Exact two-input field text/map-save preflight fix above capture registration."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = 'data/taichung/encounter-field-fix/registration.json'
+MANIFEST_SHA256 = '517e1e73a6c504cbbd53f2e4c810773cd17b78cbd7eec575de77623084dc0555'
+PATHS = ('src/taichung_encounter_field.c', 'tests/taichung_encounter_field_test.c')
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def reader(source, overrides=None):
+    def read(path):
+        if path in (overrides or {}):
+            if overrides[path] is None:
+                raise FileNotFoundError(path)
+            return overrides[path]
+        return (Path(source) / path).read_bytes()
+    return read
+
+
+def active(read):
+    try:
+        read(MANIFEST)
+        return True
+    except FileNotFoundError:
+        return b'StringExpandPlaceholders(gStringVar4, text);' in read(PATHS[0])
+
+
+def peel(read):
+    if not active(read):
+        return {}
+    raw = read(MANIFEST)
+    require(digest(raw) == MANIFEST_SHA256, 'Encounter field-fix registration differs')
+    registration = json.loads(raw)
+    require(registration['schemaVersion'] == 1 and tuple(registration['inputs']) == PATHS, 'Encounter field-fix scope differs')
+    under = {}
+    for path, item in registration['inputs'].items():
+        raw = read(path)
+        require(digest(raw) == item['afterSha256'], 'Unreviewed encounter field-fix input: ' + path)
+        text = raw.decode()
+        for edit in reversed(item['edits']):
+            require(text.count(edit['after']) == 1, 'Missing/ambiguous encounter field-fix edit: ' + path)
+            text = text.replace(edit['after'], edit['before'], 1)
+        before = text.encode()
+        require(digest(before) == item['beforeSha256'], 'Encounter field-fix baseline differs: ' + path)
+        under[path] = before
+    return under
+
+
+def check(source=ROOT, overrides=None):
+    read = reader(source, overrides)
+    try:
+        under = peel(read)
+        return {'passed': True, 'active': bool(under), 'exactInputs': list(under), 'runtimeTestedByThisGuard': False}
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        return {'passed': False, 'errors': [str(error)]}
+
+
+def self_test(source=ROOT):
+    read = reader(source)
+    good = check(source)
+    if not good['passed']:
+        return good
+    probes = {MANIFEST: read(MANIFEST) + b'\n'}
+    for path in PATHS:
+        raw = bytearray(read(path)); raw[len(raw) // 2] ^= 1
+        probes[path] = bytes(raw)
+    probes['missing-registration'] = None
+    field_raw = read(PATHS[0])
+    needle = b'StringExpandPlaceholders(gStringVar4, text);'
+    require(field_raw.count(needle) == 2, 'Expected exactly two reviewed template expansions')
+    probes['revert-offer'] = field_raw.replace(needle, b'StringCopy(gStringVar4, text);', 1)
+    probes['revert-result'] = b'StringCopy(gStringVar4, text);'.join(field_raw.rsplit(needle, 1))
+    require(field_raw.count(b'        SaveMapView();') == 1, 'Expected one common BEGIN/RESULT map preflight')
+    probes['remove-map-preflight'] = field_raw.replace(b'        SaveMapView();', b'        /* removed map preflight */', 1)
+    caught = {}
+    for name, raw in probes.items():
+        path = MANIFEST if name == 'missing-registration' else PATHS[0] if name.startswith('revert-') or name == 'remove-map-preflight' else name
+        edits = {path: raw}
+        rejected = not check(source, edits)['passed']
+        try:
+            peel(reader(source, edits)); no_view = False
+        except (OSError, ValueError, KeyError, TypeError):
+            no_view = True
+        caught[name] = rejected and no_view
+    before = peel(read)
+    partial = {PATHS[0]: before[PATHS[0]]}
+    caught['partial-source-revert'] = not check(source, partial)['passed']
+    partial = {PATHS[1]: before[PATHS[1]]}
+    caught['partial-test-revert'] = not check(source, partial)['passed']
+    # A fully prepatch tree without this registration remains unmodified.
+    absent = {**before, MANIFEST: None}
+    unchanged = check(source, absent) == {'passed': True, 'active': False, 'exactInputs': [], 'runtimeTestedByThisGuard': False}
+    return {'passed': all(caught.values()) and unchanged, 'current': good,
+            'rejectedCorruptionProbes': caught, 'prepatchAbsentLayerUnchanged': unchanged}
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ROOT)
+    parser.add_argument('--self-test', action='store_true')
+    args = parser.parse_args()
+    report = self_test(args.source) if args.self_test else check(args.source)
+    print(json.dumps(report, indent=2))
+    raise SystemExit(0 if report['passed'] else 1)
