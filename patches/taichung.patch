new file mode 100644
index 00000000..503d796e
--- /dev/null
+++ b/src/taichung_encounter_bridge.c
@@ -0,0 +1,68 @@
+#include "global.h"
+#include "save.h"
+#include "taichung_encounter.h"
+#include "taichung_encounter_bridge.h"
+extern u32 gSaveCounter;
+
+typedef char EncounterBridgeSize[sizeof(struct TaichungEncounterBridge) == TAICHUNG_ENCOUNTER_BRIDGE_SIZE ? 1 : -1];
+typedef char EncounterBridgeAckOffset[offsetof(struct TaichungEncounterBridge, ackSequence) == 0x1C ? 1 : -1];
+typedef char EncounterBridgeCounterOffset[offsetof(struct TaichungEncounterBridge, ackSaveCounter) == 0x40 ? 1 : -1];
+EWRAM_DATA volatile struct TaichungEncounterBridge gTaichungEncounterBridge = {0};
+static EWRAM_DATA u32 sSavedSequence = 0;
+static EWRAM_DATA u32 sSavedCounter = 0;
+
+void TaichungEncounterBridgeSaved(void)
+{
+    sSavedSequence = TaichungEncounterGetSequence();
+    sSavedCounter = gSaveCounter;
+    gTaichungEncounterBridge.ackSequence = 0;
+    gTaichungEncounterBridge.ackStatus = 0;
+}
+
+bool8 TaichungEncounterBridgeAcked(void)
+{
+    volatile struct TaichungEncounterBridge *p = &gTaichungEncounterBridge;
+    return sSavedSequence != 0 && sSavedSequence == TaichungEncounterGetSequence()
+        && p->ackSequence == sSavedSequence && p->ackStatus == TAICHUNG_ENCOUNTER_ACK_DURABLE
+        && p->ackSaveCounter == sSavedCounter
+        && p->ackAttempts == TaichungEncounterGetAttemptMask()
+        && p->ackUnlocks == TaichungEncounterGetUnlockMask();
+}
+
+bool8 TaichungEncounterBridgeFailed(void)
+{
+    return gTaichungEncounterBridge.ackSequence == TaichungEncounterGetSequence()
+        && gTaichungEncounterBridge.ackStatus == TAICHUNG_ENCOUNTER_ACK_FAILED;
+}
+
+void TaichungEncounterBridge_Tick(bool8 callbacksRan)
+{
+    volatile struct TaichungEncounterBridge *p = &gTaichungEncounterBridge;
+    const struct TaichungEncounterSite *site = TaichungEncounterGetSite(TaichungEncounterGetCurrentSite());
+    u32 publication = (p->publication + 1) | 1;
+    p->publication = publication;
+    p->magicA = TAICHUNG_ENCOUNTER_BRIDGE_MAGIC_A;
+    p->magicB = TAICHUNG_ENCOUNTER_BRIDGE_MAGIC_B;
+    p->version = TAICHUNG_ENCOUNTER_BRIDGE_VERSION;
+    p->size = TAICHUNG_ENCOUNTER_BRIDGE_SIZE;
+    p->selfGbaAddress = (u32)p;
+    if (callbacksRan)
+        p->frameCounter++;
+    p->requestSequence = TaichungEncounterGetSequence();
+    p->attempts = TaichungEncounterGetAttemptMask();
+    p->unlocks = TaichungEncounterGetUnlockMask();
+    p->species = site == NULL ? 0 : site->species;
+    p->site = TaichungEncounterGetCurrentSite();
+    p->phase = TaichungEncounterGetPhase();
+    p->balls = TaichungEncounterGetBalls();
+    p->result = TaichungEncounterGetResult();
+    p->saveStatus = sSavedSequence != 0 && sSavedSequence == p->requestSequence ? TAICHUNG_ENCOUNTER_SAVE_FLASH_OK : 0;
+    p->saveCounter = sSavedCounter;
+    p->trainerId = gSaveBlock2Ptr == NULL ? 0 : (u32)gSaveBlock2Ptr->playerTrainerId[0]
+        | ((u32)gSaveBlock2Ptr->playerTrainerId[1] << 8)
+        | ((u32)gSaveBlock2Ptr->playerTrainerId[2] << 16)
+        | ((u32)gSaveBlock2Ptr->playerTrainerId[3] << 24);
+    p->publication = publication + 1;
+    if (p->publication == 0)
+        p->publication = 2;
+}
