new file mode 100644
index 00000000..dd83adfb
--- /dev/null
+++ b/tools/taichung_gameplay/test-gym-dialogue.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Exercise installed gym scripts, not a second model of the award engine.
+
+Native progress/scene behavior is covered by the actual-C suites. This runner
+checks that all four ASM paths invoke those adapters in the requested order.
+"""
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+NAMES = ('Station', 'Park', 'Miyahara', 'Science', 'Greenway', 'Confucius', 'FineArts', 'Fengjia', 'MapleGarden', 'Theater')
+BADGES = ('Departure', 'Pavilion', 'Chill', 'Discovery', 'Brush', 'Rites', 'Palette', 'Feast', 'Tide', 'Encore')
+BADGES_ZH = ('啟程', '湖亭', '沁涼', '發現', '筆意', '禮儀', '調色', '豐味', '潮汐', '謝幕')
+FILES = ('gym_adapter', 'park_gym', 'miyahara_gym', 'science_gym', 'greenway_gym', 'confucius_gym', 'fine_arts_gym', 'fengjia_gym', 'maple_garden_gym', 'theater_gym')
+SYMBOLS = {'TRUE': 1, 'FALSE': 0}
+for path in ('include/constants/taichung_gyms.h', 'include/constants/opponents.h'):
+    SYMBOLS.update({key: int(value, 0) for key, value in re.findall(r'^#define\s+(\w+)\s+(0x[0-9A-Fa-f]+|\d+)\b', (ROOT / path).read_text(), re.M)})
+    for key, target in re.findall(r'^#define[ \t]+(\w+)[ \t]+([A-Za-z_]\w*)[ \t]*$', (ROOT / path).read_text(), re.M):
+        if target in SYMBOLS:
+            SYMBOLS[key] = SYMBOLS[target]
+
+
+def parse(sources):
+    result = {}
+    for source in sources:
+        current, order = None, []
+        for line in source.splitlines():
+            line = line.split('@', 1)[0].strip()
+            if not line or line.startswith('.'):
+                continue
+            if re.fullmatch(r'\w+::?', line):
+                current = line.rstrip(':')
+                assert current not in result
+                result[current] = []
+                order.append(current)
+            elif current:
+                result[current].append(line)
+        for a, b in zip(order, order[1:]):
+            result[a].append('goto ' + b)
+    return result
+
+
+sources = [(ROOT / ('data/scripts/taichung_' + x + '.inc')).read_text() for x in ('gyms', 'park_gym', 'miyahara_gym')]
+macro = (ROOT / 'data/scripts/taichung_landmark_gym.inc').read_text()
+for module in FILES[3:]:
+    invocation = (ROOT / ('data/scripts/taichung_' + module + '.inc')).read_text().strip()
+    name, gym, trainer = re.search(r'^\s*taichung_landmark_gym (\w+), (\w+), (\w+)$', invocation, re.M).groups()
+    sources.append(macro.replace(r'\name\()', name).replace(r'\name', name).replace(r'\gym', gym).replace(r'\trainer', trainer))
+PROGRAM = parse(sources)
+
+
+def run(name, language, *, complete=False, replay=False, available=True, outcome='win', fresh=True, loss_notice=False):
+    label, index, stack = 'TaichungGym_EventScript_' + name + 'Challenge', 0, []
+    variables = {'VAR_0x40FB': language, 'VAR_RESULT': 0}
+    events, locked, text, consumed, scene_returned = [], False, None, False, False
+
+    def value(x):
+        return variables.get(x, SYMBOLS.get(x, int(x) if x.isdecimal() else x))
+
+    for _ in range(200):
+        instruction = PROGRAM[label][index]
+        index += 1
+        command, _, tail = instruction.partition(' ')
+        args = tail.split(', ')
+        if command == 'setvar':
+            variables[args[0]] = value(args[1])
+        elif command in ('lock', 'lockall'):
+            locked = True
+        elif command in ('release', 'releaseall'):
+            locked = False
+        elif command == 'faceplayer':
+            pass
+        elif command == 'goto_if_questlog':
+            if replay:
+                label, index = tail, 0
+        elif command in ('goto_if_eq', 'goto_if_ne'):
+            equal = value(args[0]) == value(args[1])
+            if equal == (command == 'goto_if_eq'):
+                label, index = args[2], 0
+        elif command == 'goto':
+            label, index = tail, 0
+        elif command == 'call':
+            stack.append((label, index))
+            label, index = tail, 0
+        elif command == 'return':
+            label, index = stack.pop()
+        elif command == 'callnative':
+            events.append(tail)
+            if tail == 'TaichungGym_ScriptIsComplete':
+                variables['VAR_RESULT'] = int(complete or outcome == 'win' and 'battle' in events)
+            elif 'Consume' in tail and 'LossNotice' in tail:
+                variables['VAR_RESULT'] = int(loss_notice)
+            elif re.fullmatch(r'TaichungGym_ScriptGet\w+Message', tail):
+                text = value('VAR_0x8005')
+            elif tail == 'TaichungGym_ScriptPrepareChallenge':
+                variables['VAR_RESULT'] = int(available)
+                assert value('VAR_0x8004') == NAMES.index(name)
+            elif tail == 'TaichungGym_ScriptGetResult':
+                variables['VAR_RESULT'] = SYMBOLS['TAICHUNG_GYM_RESULT_WON'] if outcome == 'win' else 0
+            elif tail == 'TaichungBadge_ScriptPrepareAward':
+                assert 'battle' in events and outcome == 'win' and not complete and not replay
+                variables['VAR_RESULT'] = int(fresh and not consumed)
+                consumed = fresh
+            elif tail == 'TaichungBadge_ScriptOpenAward':
+                assert consumed and events[-2] == 'closemessage'
+                events.append('award-screen')
+            elif tail != 'TaichungGym_ScriptCancelChallenge':
+                raise AssertionError(('unexpected native adapter', tail))
+        elif command == 'msgbox':
+            assert tail == 'gStringVar4' and locked
+            assert not scene_returned, 'No follow-up page may run after closing the badge screen'
+            events.append(('message', text))
+        elif command == 'closemessage':
+            events.append(command)
+        elif command == 'trainerbattle_single':
+            assert locked and not complete and not replay
+            suffix = 'Zh' if language == 2 else 'En'
+            assert args[1] == 'TaichungGym_Text_' + name + 'Intro' + suffix
+            events.extend([('intro', args[1]), 'battle'])
+            if outcome == 'loss':
+                locked = False  # Native whiteout exits the field script.
+                break
+            if outcome != 'skip':
+                label, index = args[3], 0
+        elif command == 'waitstate':
+            assert events[-1] == 'award-screen'
+            scene_returned = True
+        elif command == 'end':
+            assert not locked and not stack
+            break
+        else:
+            raise AssertionError(('unexpected script operation/menu', instruction))
+    else:
+        raise AssertionError('script loop')
+    assert not locked
+    return events
+
+
+for language in (1, 2):
+    for name in NAMES:
+        events = run(name, language)
+        assert events.count('battle') == events.count('award-screen') == 1
+        assert ('message', SYMBOLS['TAICHUNG_GYM_MESSAGE_COMPLETE']) in events
+        assert events.index(('message', SYMBOLS['TAICHUNG_GYM_MESSAGE_COMPLETE'])) < events.index('award-screen')
+        assert len([x for x in events if isinstance(x, tuple) and x[0] == 'intro']) == 1
+        assert not any(isinstance(x, tuple) and x[0] == 'message' for x in events[:events.index('battle')])
+        for options in ({'complete': True}, {'replay': True}, {'available': False}, {'outcome': 'loss'}, {'outcome': 'skip'}, {'outcome': 'not-recorded'}, {'fresh': False}):
+            trace = run(name, language, **options)
+            assert 'award-screen' not in trace and ('message', SYMBOLS['TAICHUNG_GYM_MESSAGE_COMPLETE']) not in trace
+        assert 'battle' not in run(name, language, complete=True)
+        assert 'battle' not in run(name, language, replay=True)
+        if name != 'Station':
+            trace = run(name, language, loss_notice=True)
+            assert trace.index(('message', SYMBOLS['TAICHUNG_GYM_MESSAGE_LOSS'])) < trace.index('battle')
+
+
+def literal(source, name):
+    raw = re.search(r'\b' + name + r'\[\] = _\("((?:\\.|[^"\\])*)"\);', source)[1]
+    # Native \p becomes a page separator in this source-only text audit.
+    return json.loads('"' + raw.replace(r'\p', r'\f') + '"')
+
+
+lookup = {m[1]: tuple(int(x, 16) for x in m[2].split()) for m in re.finditer(r"^'(.)'\s*=\s*([0-9A-Fa-f ]+)", (ROOT / 'charmap.txt').read_text(), re.M)}
+lookup["'"] = lookup['’']
+font = (ROOT / 'src/text.c').read_text()
+tables = []
+for face in ('Normal', 'Male', 'Female'):
+    body = re.search(r'sFont' + face + r'LatinGlyphWidths\[\]\s*=\s*\{(.*?)\};', font, re.S)[1]
+    body = re.sub(r'//[^\n]*|/\*.*?\*/', '', body, flags=re.S)
+    tables.append([int(x) for x in re.findall(r'\b\d+\b', body)])
+max_width = 0
+for i, (name, module) in enumerate(zip(NAMES, FILES)):
+    source = (ROOT / ('src/taichung_' + module + '.c')).read_text()
+    for locale, badge in (('En', BADGES[i] + ' Badge'), ('Zh', BADGES_ZH[i] + '徽章')):
+        intro = literal(source, 'TaichungGym_Text_' + name + 'Intro' + locale)
+        award = literal(source, ('sComplete' if i < 3 else 'TaichungGym_Text_' + name + 'Complete') + locale)
+        assert badge in award
+        for text, page_limit in ((intro, 2), (award, 1)):
+            pages = text.split('\f')
+            assert 1 <= len(pages) <= page_limit
+            for page in pages:
+                assert 1 <= len(page.splitlines()) <= 2
+                for line in page.splitlines():
+                    width = 0
+                    for char in line:
+                        assert char in lookup, ('missing glyph', char, name)
+                        code = lookup[char]
+                        width += 13 if code[:2] == (252, 25) else max(t[code[0]] for t in tables)
+                    assert width <= 198, (name, locale, width, line)
+                    max_width = max(max_width, width)
+print(f'PASS: all10 bilingual installed scripts, direct/history battle, loss/replay/revisit/unavailable/stale-award branches, guarded message->badge->release, correct names and native line fit max{max_width}px')
