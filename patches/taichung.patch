+}
diff --git a/src/taichung_gym_preparation.c b/src/taichung_gym_preparation.c
new file mode 100644
index 00000000..5cbdcb9d
--- /dev/null
+++ b/src/taichung_gym_preparation.c
@@ -0,0 +1,105 @@
+#include "global.h"
+#include "event_data.h"
+#include "field_fadetransition.h"
+#include "overworld.h"
+#include "quest_log.h"
+#include "script.h"
+#include "string_util.h"
+#include "task.h"
+#include "taichung_gym_entry.h"
+#include "taichung_gym_progress.h"
+#include "taichung_language.h"
+#include "taichung_team.h"
+#include "constants/opponents.h"
+
+extern const u8 TaichungGymPrepared_Start[], TaichungGymPrepared_Leave[];
+extern void TaichungGym_ScriptPrepareChallenge(void);
+#define LEADER_INTRO(name) extern const u8 TaichungGym_Text_##name##IntroEn[], TaichungGym_Text_##name##IntroZh[];
+LEADER_INTRO(Station) LEADER_INTRO(Park) LEADER_INTRO(Miyahara) LEADER_INTRO(Science) LEADER_INTRO(Greenway)
+LEADER_INTRO(Confucius) LEADER_INTRO(FineArts) LEADER_INTRO(Fengjia) LEADER_INTRO(MapleGarden) LEADER_INTRO(Theater)
+#define INTRO(name) {TaichungGym_Text_##name##IntroEn, TaichungGym_Text_##name##IntroZh}
+static const u8 *const sIntros[TAICHUNG_GYM_COUNT][2] = {INTRO(Station), INTRO(Park), INTRO(Miyahara), INTRO(Science), INTRO(Greenway), INTRO(Confucius), INTRO(FineArts), INTRO(Fengjia), INTRO(MapleGarden), INTRO(Theater)};
+static const u16 sTrainers[TAICHUNG_GYM_COUNT] = {TRAINER_TAICHUNG_STATION_JUN, TRAINER_TAICHUNG_PARK_LIAN, TRAINER_TAICHUNG_MIYAHARA_PEIQI, TRAINER_TAICHUNG_SCIENCE_YICHENG, TRAINER_TAICHUNG_GREENWAY_XINGAN, TRAINER_TAICHUNG_CONFUCIUS_WENYI, TRAINER_TAICHUNG_FINE_ARTS_CAINING, TRAINER_TAICHUNG_FENGJIA_JIAHE, TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING, TRAINER_TAICHUNG_THEATER_LING};
+static const u8 sUnavailableEn[] = _("A healthy team is needed.\nPrepare again when ready.");
+static const u8 sUnavailableZh[] = _("需要能對戰的隊伍。\n準備好再來吧。");
+static EWRAM_DATA u8 sPreparingGym = TAICHUNG_GYM_NONE;
+static EWRAM_DATA u8 sSkipIntroGym = TAICHUNG_GYM_NONE;
+
+void TaichungGymEntry_ScriptBufferPreparationIntro(void)
+{
+    sPreparingGym = TaichungGymEntryCurrentGym();
+    sSkipIntroGym = TAICHUNG_GYM_NONE;
+    gSpecialVar_Result = !QL_IS_PLAYBACK_STATE && sPreparingGym < TAICHUNG_GYM_COUNT
+        && !TaichungGymIsComplete(sPreparingGym);
+    if (gSpecialVar_Result)
+        StringExpandPlaceholders(gStringVar4, TaichungText(sIntros[sPreparingGym][0], sIntros[sPreparingGym][1]));
+    else
+        sPreparingGym = TAICHUNG_GYM_NONE;
+}
+
+static void Task_ReturnPreparation(u8 task)
+{
+    bool8 start;
+    if (!FieldFadeTransitionBackgroundEffectIsFinished())
+        return;
+    start = TaichungTeamTakePreparedStart() && sPreparingGym < TAICHUNG_GYM_COUNT
+        && sPreparingGym == TaichungGymEntryCurrentGym() && !QL_IS_PLAYBACK_STATE
+        && !TaichungGymIsComplete(sPreparingGym);
+    gSpecialVar_0x8004 = sPreparingGym;
+    if (!start)
+        sPreparingGym = TAICHUNG_GYM_NONE;
+    DestroyTask(task);
+    ScriptContext_SetupScript(start ? TaichungGymPrepared_Start : TaichungGymPrepared_Leave);
+}
+
+static void FieldCB_ReturnPreparation(void)
+{
+    LockPlayerFieldControls();
+    Overworld_PlaySpecialMapMusic();
+    FadeInFromBlack();
+    CreateTask(Task_ReturnPreparation, 10);
+}
+
+static void CB2_ReturnPreparation(void)
+{
+    gFieldCallback = FieldCB_ReturnPreparation;
+    CB2_ReturnToField();
+}
+
+void TaichungGymEntry_ScriptOpenTeam(void)
+{
+    CleanupOverworldWindowsAndTilemaps();
+    ShowTaichungBattlePreparation(CB2_ReturnPreparation);
+}
+
+void TaichungGymEntry_ScriptPrepareBattle(void)
+{
+    u8 gym = sPreparingGym;
+    sPreparingGym = sSkipIntroGym = TAICHUNG_GYM_NONE;
+    gSpecialVar_Result = FALSE;
+    if (gym < TAICHUNG_GYM_COUNT && gym == TaichungGymEntryCurrentGym()
+        && !QL_IS_PLAYBACK_STATE && !gMain.inBattle && !TaichungGymIsComplete(gym))
+    {
+        gSpecialVar_0x8004 = gym;
+        gSpecialVar_0x8005 = sTrainers[gym];
+        // Same healthy-party, normalization and prepared-trainer safeguards.
+        TaichungGym_ScriptPrepareChallenge();
+        if (gSpecialVar_Result)
+        {
+            sSkipIntroGym = gym;
+            // Every active gym's authoritative leader is local object1.
+            gSpecialVar_LastTalked = 1;
+            return;
+        }
+    }
+    TaichungGymCancelChallenge();
+    StringCopy(gStringVar4, TaichungText(sUnavailableEn, sUnavailableZh));
+}
+
+bool8 TaichungGymEntryConsumePreparedIntro(u16 trainerId)
+{
+    u8 gym = sSkipIntroGym;
+    sSkipIntroGym = TAICHUNG_GYM_NONE;
+    return gym < TAICHUNG_GYM_COUNT && gym == TaichungGymEntryCurrentGym()
+        && !QL_IS_PLAYBACK_STATE && sTrainers[gym] == trainerId && !TaichungGymIsComplete(gym);
+}
diff --git a/src/taichung_gym_progress.c b/src/taichung_gym_progress.c
new file mode 100644
index 00000000..aaf91499
--- /dev/null
+++ b/src/taichung_gym_progress.c
@@ -0,0 +1,194 @@
+#include "global.h"
+#include "event_data.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include "constants/vars.h"
+
+struct TaichungGymChallenge
+{
+    u16 gymId;
+    u16 trainerId;
+    bool8 started;
+    u8 lastResult;
+};
+
+static EWRAM_DATA struct TaichungGymChallenge sChallenge = {TAICHUNG_GYM_NONE, TRAINER_NONE, FALSE, TAICHUNG_GYM_RESULT_NONE};
+static EWRAM_DATA u16 sLossNoticeGym = TAICHUNG_GYM_NONE;
+static EWRAM_DATA u16 sNewBadgeGym = TAICHUNG_GYM_NONE;
+
+static const u16 sLandmarkTrainers[TAICHUNG_GYM_COUNT] = {
+    TRAINER_TAICHUNG_STATION_JUN, TRAINER_TAICHUNG_PARK_LIAN,
+    TRAINER_TAICHUNG_MIYAHARA_PEIQI, TRAINER_TAICHUNG_SCIENCE_YICHENG,
+    TRAINER_TAICHUNG_GREENWAY_XINGAN, TRAINER_TAICHUNG_CONFUCIUS_WENYI,
+    TRAINER_TAICHUNG_FINE_ARTS_CAINING, TRAINER_TAICHUNG_FENGJIA_JIAHE,
+    TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING, TRAINER_TAICHUNG_THEATER_LING
+};
+
+// Save bit order is permanent. It is independent of vanilla badge order.
+static const char *const sLandmarkIds[TAICHUNG_GYM_COUNT] = {
+    "old-taichung-station", "taichung-park", "miyahara",
+    "natural-science-museum", "calligraphy-greenway", "confucius-temple",
+    "fine-arts-museum", "fengjia-night-market", "maple-garden", "taichung-theater"
+};
+
+static void ClearPendingChallenge(void)
+{
+    sChallenge.gymId = TAICHUNG_GYM_NONE;
+    sChallenge.trainerId = TRAINER_NONE;
+    sChallenge.started = FALSE;
+}
+
+u16 TaichungGymGetCompletedMask(void)
+{
+    // Viewing progress must not replay an older quest-log variable into save.
+    return gSaveBlock1Ptr ? gSaveBlock1Ptr->vars[TAICHUNG_GYM_COMPLETION_VAR - VARS_START] & TAICHUNG_GYM_ALL_MASK : 0;
+}
+
+u8 TaichungGymGetCompletedCount(void)
+{
+    u16 mask = TaichungGymGetCompletedMask();
+    u8 count = 0;
+    while (mask)
+    {
+        count += mask & 1;
+        mask >>= 1;
+    }
+    return count;
+}
+
+bool8 TaichungGymIsComplete(u16 gymId)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT)
+        return FALSE;
+    return (TaichungGymGetCompletedMask() & (1 << gymId)) != 0;
+}
+
+const char *TaichungGymGetLandmarkId(u16 gymId)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT)
+        return NULL;
+    return sLandmarkIds[gymId];
+}
+
+bool8 TaichungGymPrepareChallenge(u16 gymId, u16 trainerId)
+{
+    ClearPendingChallenge();
+    if (gymId >= TAICHUNG_GYM_COUNT || trainerId == TRAINER_NONE || trainerId >= NUM_TRAINERS
+     || sLandmarkTrainers[gymId] != trainerId)
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_INVALID;
+        return FALSE;
+    }
+    if (TaichungGymIsComplete(gymId))
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_ALREADY_COMPLETE;
+        return FALSE;
+    }
+    sLossNoticeGym = TAICHUNG_GYM_NONE;
+    sNewBadgeGym = TAICHUNG_GYM_NONE;
+    sChallenge.gymId = gymId;
+    sChallenge.trainerId = trainerId;
+    sChallenge.lastResult = TAICHUNG_GYM_RESULT_NONE;
+    return TRUE;
+}
+
+void TaichungGymCancelChallenge(void)
+{
+    ClearPendingChallenge();
+    sLossNoticeGym = TAICHUNG_GYM_NONE;
+    sNewBadgeGym = TAICHUNG_GYM_NONE;
+    sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+}
+
+void TaichungGymOnTrainerBattleStart(u16 trainerId)
+{
+    if (sChallenge.gymId < TAICHUNG_GYM_COUNT && sChallenge.trainerId == trainerId)
+    {
+        sChallenge.started = TRUE;
+    }
+    else
+    {
+        ClearPendingChallenge();
+        sLossNoticeGym = TAICHUNG_GYM_NONE;
+        sNewBadgeGym = TAICHUNG_GYM_NONE;
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+    }
+}
+
+bool8 TaichungGymOnTrainerBattleEnd(u16 trainerId, u8 outcome)
+{
+    bool8 wonLeaderBattle = FALSE;
+    if (!sChallenge.started || sChallenge.gymId >= TAICHUNG_GYM_COUNT || sChallenge.trainerId != trainerId)
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+    }
+    else if (outcome != B_OUTCOME_WON)
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_LOST;
+        // The legacy result also covers draw/escape. Retry prose needs an
+        // actual defeat from this matching started battle, recorded once.
+        if (outcome == B_OUTCOME_LOST)
+            sLossNoticeGym = sChallenge.gymId;
+    }
+    else if (TaichungGymIsComplete(sChallenge.gymId))
+    {
+        sChallenge.lastResult = TAICHUNG_GYM_RESULT_ALREADY_COMPLETE;
+    }
+    else
+    {
+        // This is the only writer. It runs after the actual trainer battle ends.
+        if (gSaveBlock1Ptr != NULL
+         && VarSet(TAICHUNG_GYM_COMPLETION_VAR, TaichungGymGetCompletedMask() | (1 << sChallenge.gymId))
+         && TaichungGymIsComplete(sChallenge.gymId))
+        {
+            sChallenge.lastResult = TAICHUNG_GYM_RESULT_WON;
+            if (TaichungGymIsBadgeChallenge(trainerId))
+            {
+                sNewBadgeGym = sChallenge.gymId;
+                wonLeaderBattle = TRUE;
+            }
+        }
+        else
+            sChallenge.lastResult = TAICHUNG_GYM_RESULT_NOT_TRACKED;
+    }
+    ClearPendingChallenge();
+    return wonLeaderBattle;
+}
+
+u8 TaichungGymGetLastResult(void)
+{
+    return sChallenge.lastResult;
+}
+
+bool8 TaichungGymIsBadgeChallenge(u16 trainerId)
+{
+    return sChallenge.started && sChallenge.gymId < TAICHUNG_GYM_COUNT
+        && sChallenge.trainerId == trainerId
+        && sLandmarkTrainers[sChallenge.gymId] == trainerId;
+}
+
+u16 TaichungGymGetBattleLossGym(u16 trainerId, u8 outcome)
+{
+    if (outcome != B_OUTCOME_LOST || !TaichungGymIsBadgeChallenge(trainerId)
+     || TaichungGymIsComplete(sChallenge.gymId))
+        return TAICHUNG_GYM_NONE;
+    return sChallenge.gymId;
+}
+
+bool8 TaichungGymConsumeNewBadge(u16 gymId)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT || sNewBadgeGym != gymId
+     || !TaichungGymIsComplete(gymId))
+        return FALSE;
+    sNewBadgeGym = TAICHUNG_GYM_NONE;
+    return TRUE;
+}
+
+bool8 TaichungGymConsumeLossNotice(u16 gymId)
+{
+    if (gymId >= TAICHUNG_GYM_COUNT || sLossNoticeGym != gymId)
+        return FALSE;
+    sLossNoticeGym = TAICHUNG_GYM_NONE;
+    return TRUE;
+}
diff --git a/src/taichung_jun.c b/src/taichung_jun.c
new file mode 100644
index 00000000..a90f5189
--- /dev/null
+++ b/src/taichung_jun.c
@@ -0,0 +1,61 @@
+#include "global.h"
+#include "load_save.h"
+#include "overworld.h"
+#include "taichung_jun.h"
+#include "constants/event_objects.h"
+#include "constants/maps.h"
+
+void TaichungJunRefreshOnContinue(void)
+{
+    const struct MapHeader *header;
+    const struct ObjectEventTemplate *current;
+    const struct ObjectEventTemplate *saved;
+    struct WarpData *warp;
+    u8 i, j;
+    bool8 refresh = FALSE;
+
+    // Respect an existing migration/return warp, including the interrupted
+    // opening handoff. Unrelated FireRed maps and saves are not affected.
+    if (gSaveBlock1Ptr == NULL || UseContinueGameWarp()
+        || gSaveBlock1Ptr->location.mapGroup != MAP_GROUP(MAP_TAICHUNG_OLD_STATION_GYM)
+        || gSaveBlock1Ptr->location.mapNum != MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM))
+        return;
+
+    header = Overworld_GetMapHeaderByGroupAndId(gSaveBlock1Ptr->location.mapGroup,
+                                             gSaveBlock1Ptr->location.mapNum);
+    if (header->events == NULL || header->mapLayout == NULL
+        || gSaveBlock1Ptr->pos.x < 0 || gSaveBlock1Ptr->pos.y < 0
+        || gSaveBlock1Ptr->pos.x >= header->mapLayout->width
+        || gSaveBlock1Ptr->pos.y >= header->mapLayout->height)
+        return;
+
+    for (i = 0; i < header->events->objectEventCount; i++)
+    {
+        current = &header->events->objectEvents[i];
+        if (current->graphicsId != OBJ_EVENT_GFX_TAICHUNG_JUN)
+            continue;
+        for (j = 0; j < OBJECT_EVENT_TEMPLATES_COUNT; j++)
+        {
+            saved = &gSaveBlock1Ptr->objectEventTemplates[j];
+            if (saved->localId == current->localId)
+                break;
+        }
+        if (j == OBJECT_EVENT_TEMPLATES_COUNT || saved->graphicsId != current->graphicsId)
+        {
+            refresh = TRUE;
+            break;
+        }
+    }
+    if (!refresh)
+        return;
+
+    // Use the engine's full map-load path to rebuild object templates and
+    // replace the cached Jun art. Keep this exact saved position, never a door warp.
+    // No persistent variable, badge, party or mapView bytes are rewritten.
+    warp = &gSaveBlock1Ptr->continueGameWarp;
+    *warp = gSaveBlock1Ptr->location;
+    warp->warpId = -1;
+    warp->x = gSaveBlock1Ptr->pos.x;
+    warp->y = gSaveBlock1Ptr->pos.y;
+    SetContinueGameWarpStatus();
+}
