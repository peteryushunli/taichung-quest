+
+static const u8 *const sMessages[][2] = {
+    [TAICHUNG_GYM_MESSAGE_OFFER] = {TaichungGym_Text_ScienceOfferEn, TaichungGym_Text_ScienceOfferZh},
+    [TAICHUNG_GYM_MESSAGE_COMPLETE] = {TaichungGym_Text_ScienceCompleteEn, TaichungGym_Text_ScienceCompleteZh},
+    [TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE] = {TaichungGym_Text_ScienceAlreadyEn, TaichungGym_Text_ScienceAlreadyZh},
+    [TAICHUNG_GYM_MESSAGE_DECLINED] = {TaichungGym_Text_ScienceDeclinedEn, TaichungGym_Text_ScienceDeclinedZh},
+    [TAICHUNG_GYM_MESSAGE_NOT_RECORDED] = {TaichungGym_Text_ScienceNotRecordedEn, TaichungGym_Text_ScienceNotRecordedZh},
+    [TAICHUNG_GYM_MESSAGE_UNAVAILABLE] = {TaichungGym_Text_ScienceUnavailableEn, TaichungGym_Text_ScienceUnavailableZh},
+    [TAICHUNG_GYM_MESSAGE_GREETING] = {TaichungGym_Text_ScienceGreetingEn, TaichungGym_Text_ScienceGreetingZh},
+    [TAICHUNG_GYM_MESSAGE_LOSS] = {TaichungGym_Text_ScienceLossEn, TaichungGym_Text_ScienceLossZh},
+};
