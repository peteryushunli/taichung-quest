+        mouth = (MAPLE_PATH_MOUTH[0] + dx, MAPLE_PATH_MOUTH[1] + dy)
+        steps, todo = {mouth: 0}, [mouth]
+        while todo and approach not in steps:
+            x, y = todo.pop(0)
+            for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
