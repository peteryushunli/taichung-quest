index 00000000..892c6a90
--- /dev/null
+++ b/data/scripts/taichung_optional_story.inc
@@ -0,0 +1,98 @@
+@ Reading is opt-in. These subroutines never prepare a challenge, award a badge,
+@ alter a party or write a saved variable. VAR_0x8006 is the selected text key;
+@ VAR_0x8004 remains the caller's gym/history ID until an encounter wrapper owns it.
+TaichungStory_ChallengeMenu::
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_STORY_CHALLENGE, FALSE
+	goto_if_eq VAR_RESULT, 0, TaichungStory_ChallengeDone
+	goto_if_eq VAR_RESULT, 1, TaichungStory_ChallengeAbout
+	setvar VAR_RESULT, 1
+TaichungStory_ChallengeDone::
+	return
+
+TaichungStory_ChallengeAbout::
+	callnative TaichungStory_ScriptBufferAbout
+	msgbox gStringVar4
+	goto TaichungStory_ReturnToQuestion
+
+TaichungStory_ReturnToQuestion::
+	callnative TaichungStory_ScriptRestoreQuestion
+	message gStringVar4
+	waitmessage
+	goto TaichungStory_ChallengeMenu
+
+@ Available at completed leaders and informational visits. Back/B only returns
+@ to the caller; it cannot select the challenge branch.
+TaichungStory_VisitMenu::
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_STORY_VISIT, FALSE
+	goto_if_eq VAR_RESULT, 0, TaichungStory_VisitAbout
+	return
+
+TaichungStory_VisitAbout::
+	callnative TaichungStory_ScriptBufferAbout
+	msgbox gStringVar4
+	goto TaichungStory_VisitMenu
+
+@ Signs explain the place. Personal observations belong to the staff NPCs.
+TaichungStory_ReadSignDetails::
+	callnative TaichungStory_ScriptBufferAbout
+	msgbox gStringVar4
+	return
+
+@ Inside NPCs share one short anecdote immediately. Full source notes remain
+@ in the data package; public signs/encounter menus never expose staff notes.
+TaichungStory_StaffEntry::
+	callnative TaichungStory_ScriptHasPackage
+	goto_if_eq VAR_RESULT, FALSE, TaichungStory_StaffDone
+	callnative TaichungStory_ScriptBufferStaffAnecdote
+	msgbox gStringVar4
+TaichungStory_StaffDone::
+	return
+
+@ Explicit Encounter enters the original field wrapper only after this returns.
+@ Reading/Back/B never asks the capture engine to begin, consume or save a trial.
+@ The same menu is available after an attempt is spent or a capture is unlocked.
+TaichungStory_SiteMenu::
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_STORY_SITE, FALSE
+	goto_if_eq VAR_RESULT, 0, TaichungStory_SiteDone
+	goto_if_eq VAR_RESULT, 1, TaichungStory_SiteAbout
+	setvar VAR_RESULT, 1
+TaichungStory_SiteDone::
+	return
+
+TaichungStory_SiteAbout::
+	callnative TaichungStory_ScriptBufferAbout
+	msgbox gStringVar4
+	goto TaichungStory_ReturnToSite
+
+TaichungStory_ReturnToSite::
+	callnative TaichungStory_ScriptBufferSign
+	message gStringVar4
+	waitmessage
+	goto TaichungStory_SiteMenu
+
+@ Existing host objects and public script labels are retained. Wenchang's
+@ outside sign is informational; the host alone can enter existing capture1.
+TaichungStory_WenchangHost::
+	lock
+	faceplayer
+	goto_if_questlog TaichungCity_Host_WenchangTemple_HistoryDone
+	setvar VAR_0x8004, TAICHUNG_HISTORY_WENCHANG_TEMPLE
+	callnative TaichungStory_ScriptHasPackage
+	callnative TaichungStory_ScriptBufferSign
+	msgbox gStringVar4
+	call TaichungStory_SiteMenu
+	goto_if_ne VAR_RESULT, 0, TaichungCity_Host_WenchangTemple_HistoryDone
+	goto TaichungEncounter_WenchangTemple
+
+TaichungStory_WanheHost::
+	lock
+	faceplayer
+	goto_if_questlog TaichungCity_Host_WanheTemple_HistoryDone
+	setvar VAR_0x8004, TAICHUNG_HISTORY_WANHE_TEMPLE
+	callnative TaichungStory_ScriptHasPackage
+	callnative TaichungStory_ScriptBufferSign
+	msgbox gStringVar4
+	call TaichungStory_VisitMenu
+	goto TaichungCity_Host_WanheTemple_HistoryDone
+
+	.include "data/scripts/taichung_optional_story_bindings.inc"
