+#!/usr/bin/env python3
+"""Ensure geometry regeneration retains installed welcome events/scripts."""
+import contextlib
+import io
+import json
+from pathlib import Path
+import tempfile
+
+from build_welcome import build, build_room, NAME
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="taichung-welcome-bindings-") as temporary:
+        root=Path(temporary);map_dir=root/"map";layout_dir=root/"layout";artifacts=root/"preview"
+        map_dir.mkdir()
+        definition=build_room()[3]
+        definition["object_events"]=[{
+            "local_id":"LOCALID_WELCOME_GUIDE", "type":"object",
+            "graphics_id":"OBJ_EVENT_GFX_WOMAN_1", "x":6, "y":3, "elevation":3,
+            "movement_type":"MOVEMENT_TYPE_FACE_DOWN", "movement_range_x":0, "movement_range_y":0,
+            "trainer_type":"TRAINER_TYPE_NONE", "trainer_sight_or_berry_tree_id":"0",
+            "script":"MainWelcome_Guide", "flag":"0",
+        }]
+        definition["bg_events"]=[{"type":"sign", "x":6, "y":1, "elevation":0,
+            "player_facing_dir":"BG_EVENT_PLAYER_FACING_ANY", "script":"MainWelcome_Info"}]
+        script=(f"{NAME}_MapScripts::\n"
+                "\tmap_script MAP_SCRIPT_ON_FRAME, MainWelcome_Condition\n\t.byte 0\n"
+                "@ Main owns selector/party logic; preserve these bindings verbatim.\n")
+        (map_dir/"map.json").write_text(json.dumps(definition,indent=4)+"\n")
+        (map_dir/"scripts.inc").write_text(script)
+        before={n:(map_dir/n).read_bytes() for n in ("map.json","scripts.inc")}
+        with contextlib.redirect_stdout(io.StringIO()):
+            build(artifacts,map_dir=map_dir,layout_dir=layout_dir)
+            build(artifacts,map_dir=map_dir,layout_dir=layout_dir)
+        assert all((map_dir/n).read_bytes()==content for n,content in before.items())
+        report=json.loads((map_dir/"source-validation.json").read_text())
+        assert report["existingObjectCount"]==1 and report["reachableCellsWithExistingActors"]==65
+        assert report["existingMapAndScriptFilesPreservedByteForByte"]==["map.json","scripts.inc"]
+        assert len((layout_dir/"map.bin").read_bytes())==260
+        # A moved guide may not obstruct the mandatory spawn. Reject before any
+        # geometry file can be overwritten, while retaining the caller's events.
+        definition["object_events"][0].update(x=6,y=6)
+        (map_dir/"map.json").write_text(json.dumps(definition)+"\n")
+        geometry=(layout_dir/"map.bin").read_bytes()
+        try:
+            with contextlib.redirect_stdout(io.StringIO()):
+                build(artifacts,map_dir=map_dir,layout_dir=layout_dir)
+        except AssertionError as error:
+            assert "opening anchors" in str(error)
+        else:
+            raise AssertionError("A guide blocking spawn was accepted")
+        assert (layout_dir/"map.bin").read_bytes()==geometry
+    print(json.dumps({"result":"pass", "boundRegenerations":2,
+                      "mapJsonAndFrameScriptPreservedByteForByte":True,
+                      "guideAt6x3Retained":True, "reachableFloorWithGuide":65,
+                      "spawnBlockingGuideRejectedBeforeGeometryWrite":True,
+                      "canonicalOrRegisteredSourceMutations":False},indent=2))
+
+
+if __name__=="__main__":
+    main()
