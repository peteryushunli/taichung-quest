+# Registered OldCity city-v3 buildings increment. Its install contract names the base it
+# was built on; this guard re-derives the additive rules from bytes, never from its code.
+OLDCITY_BUILDINGS = "data/taichung/oldcity-buildings/install.json"
+OLDCITY_PLACEMENTS = "data/taichung/oldcity-buildings/placements.json"
+GENERIC_APARTMENTS = set(range(0x280, 0x2D4)) | set(range(0x32F, 0x34F)) | {0x180, 0x181, 0x182, 0x194}
