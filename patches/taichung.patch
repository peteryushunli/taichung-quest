+#!/usr/bin/env python3
+"""Strict registered approved-art/save-v11 layer, with an explicit frozen view.
+
+No raw Files/Source reader is changed. Historical guards may request underneath()
+only when every pinned art output, unchanged bank input and reviewed save file
+matches. Live geometry, source export and current art validation keep real reads.
+
+  python3 -B tools/taichung/approved_art_guard.py --self-test
+  python3 -B tools/taichung/approved_art_guard.py --historical all --self-test
+
+The first command is portable: the 23 hash-pinned baseline inputs ship with the
+patch and no private git objects are needed. The second is an archived-history
+compatibility check; its unchanged historical suites still require their older
+native git refs. It does not validate current native geometry or prove runtime
+behavior. Run validate_city.py, export_minimap.py and the v11 host tests against
+the actual source separately.
+
+A newer registered layer, the guest house opening (home_start.py), sits on top.
+Every read here first peels it: when the tree holds exactly that layer, its
+files read as the bytes beneath it (the tree this layer was reviewed on), and
+the historical view also hides the guest house maps it adds. home_start.py in
+turn peels the newer gym interiors layer (gym_interiors_guard.py) the same way.
+A tree without those layers reads unchanged.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import importlib.util
+import json
+from pathlib import Path, PurePosixPath
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+BASE = "2362263510dfa38987c36b6cc40dca8d9372fc3c"
+REPORT = "data/taichung/approved-landmarks/integration-report.json"
+REPORT_SHA256 = "e94b0542b1a19bd797a1a8b8b53a31db6a66bf61f44ea1b114db3b1151e0f56a"
+SAVE_MANIFEST = "data/taichung/approved-landmarks/save-v11.json"
+SAVE_FILES = {
+    SAVE_MANIFEST: "349066a5800c8901c45c246e88a074ed673eb90ba82118df8ced2c359053f92b",
+    "src/data/taichung/approved_art_save_v11.h": "952a359fd86c7b4a3cd90252e17bb4a822ce0347f525df226d531e62a5ac312f",
+    "src/taichung_save.c": "ea4d6581ce7f94465621013ca9b5a87219f41508de11e9abcf9955933e28e3c4",
+    "include/taichung_save.h": "ebb18df4438f23b13a896766d1eb53c3ce07e138973123c153414b0edb62b525",
+}
+SAVE_PAIR = ("src/taichung_save.c", "include/taichung_save.h")
+BASELINE_BUNDLE = "data/taichung/approved-landmarks/baseline"
+BASELINE_MANIFEST_SHA256 = "fdc46be597de03b8dfcf6961ac02e65b6aa532bc5560c9cd993a1f1433404895"
+LAYOUTS = "data/layouts/layouts.json"
+ART_MAPS = {
+    "wanhe-temple": "TaichungNantunWanhe", "wenchang-temple": "TaichungNantunWanhe",
+    "botanical-garden": "TaichungGreenway", "confucius-temple": "TaichungOldCityNorth",
+    "yizhong-street": "TaichungOldCityNorth", "prefectural-hall": "TaichungOldCity",
+    "second-market": "TaichungOldCityNorth", "cultural-heritage-park": "TaichungNantunWanhe",
+    "fengle-sculpture-park": "TaichungNantunWanhe", "wenxin-forest-park": "TaichungNantunNorth",
+}
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def matches(raw, expected, path):
+    if digest(raw) == expected:
+        return True
+    # Native palettes are checked out CRLF but stored LF, as in existing guards.
+    if path.endswith(".pal"):
+        canonical = raw.replace(b"\r\n", b"\n")
+        return expected in (digest(canonical), digest(canonical.replace(b"\n", b"\r\n")))
+    return False
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def safe(path):
+    value = PurePosixPath(path)
+    require(not value.is_absolute() and ".." not in value.parts and str(value) == path,
+            f"Unsafe registered path: {path}")
+    return path
+
+
+def baseline_files(source, paths, reader=None):
+    """Read hash-pinned BASE inputs without requiring private native git history."""
+    read = reader or (lambda path: (Path(source) / path).read_bytes())
+    raw = read(BASELINE_BUNDLE + "/manifest.json")
+    require(digest(raw) == BASELINE_MANIFEST_SHA256, "Baseline bundle manifest differs")
+    manifest = json.loads(raw)
+    require(manifest["baselineNativeCommit"] == BASE and len(manifest["files"]) == 23,
+            "Baseline bundle identity/file closure differs")
+    out = {}
+    for path in paths:
+        raw = read(BASELINE_BUNDLE + "/" + safe(path))
+        require(digest(raw) == manifest["files"][path], f"Baseline bundle input differs: {path}")
+        out[path] = raw
+    return out
+
+
+def verified(source, read):
+    report_raw = read(REPORT)
+    require(digest(report_raw) == REPORT_SHA256, "Approved-art report is not the reviewed pinned report")
+    report = json.loads(report_raw)
+    require(report.get("baseline") == BASE and report.get("installed") is True,
+            "Approved-art layer has the wrong baseline or is not installed")
+    require(set(report["maps"]) == set(ART_MAPS.values()) and len(report["landmarks"]) == 10,
+            "Approved-art map/landmark roster differs")
+    require({item["id"] for item in report["landmarks"]} == set(ART_MAPS), "Approved-art landmark IDs differ")
+    outputs, previous, existing = report["outputs"], report["baseSha256"], report["existingOutputs"]
+    require(len(outputs) == 216 and len(previous) == 16 and len(existing) == 110,
+            "Approved-art file closure differs from the reviewed layer")
+    require(set(previous) == set(report["layerFiles"]), "Approved-art existing-path closure differs")
+    require(report["generatedBankFiles"] == {p: outputs[p] for p in report["generatedBankFiles"]},
+            "Generated bank hashes differ from output hashes")
+    for path, expected in {**outputs, **existing, **SAVE_FILES}.items():
+        require(matches(read(safe(path)), expected, path), f"Current file differs from reviewed layer: {path}")
+    old = {path: read(path) for path in existing}
+    old.update(baseline_files(source, tuple(sorted(set(previous) | set(SAVE_PAIR))), read))
+    for path, expected in {**previous, **existing}.items():
+        require(matches(old[path], expected, path), f"Registered BASE hash differs: {path}")
+    for path, binding in report["layerFiles"].items():
+        require(binding == {"beforeSha256": previous[path], "afterSha256": outputs[path]},
+                f"Layer before/after binding differs: {path}")
+
+    # Independent semantic closure: only tileset labels, bounded art cells and
+    # the exact named sign-coordinate moves can differ. Connections, warps,
+    # object events, dimensions and border contents retain Claude's map.
+    layouts_before = json.loads(old[LAYOUTS]); layouts_after = json.loads(read(LAYOUTS))
+    expected_layouts = deepcopy(layouts_before)
+    by_id = {item["id"]: item for item in layouts_after["layouts"] if "id" in item}
+    newly_blocked = {}
+    for name, binding in report["maps"].items():
+        event_path = f"data/maps/{name}/map.json"
+        before = json.loads(old[event_path]); after = json.loads(read(event_path))
+        expected_events = deepcopy(before)
+        for landmark in report["landmarks"]:
+            if ART_MAPS[landmark["id"]] != name:
+                continue
+            script = "TaichungCity_Sign_" + "".join(part.capitalize() for part in landmark["id"].split("-"))
+            hits = [event for event in expected_events["bg_events"] if event.get("script") == script]
+            require(len(hits) == 1, f"Original landmark sign is ambiguous: {landmark['id']}")
+            event = hits[0]
+            require([event["x"], event["y"]] == landmark["signOld"], f"Original sign binding differs: {script}")
+            event["x"], event["y"] = landmark["sign"]
+            art_path = f"data/taichung/approved-landmarks/art/{landmark['id']}.png"
+            require(outputs[art_path] == landmark["artSha256"], f"Art-source binding differs: {art_path}")
+        require(after == expected_events, f"Events differ beyond approved sign positions: {name}")
+        layout = next(item for item in expected_layouts["layouts"] if item.get("id") == before["layout"])
+        current = by_id[layout["id"]]
+        layout["primary_tileset"], layout["secondary_tileset"] = current["primary_tileset"], current["secondary_tileset"]
+        border = layout["border_filepath"]
+        border_old = baseline_files(source, (border,), read)[border]
+        require(read(border) == border_old, f"Map border changed: {name}")
+        path = layout["blockdata_filepath"]
+        before_words = struct.unpack(f"<{len(old[path]) // 2}H", old[path])
+        new_raw = read(path)
+        require(len(new_raw) == len(old[path]), f"Map size changed: {name}")
+        after_words = struct.unpack(f"<{len(new_raw) // 2}H", new_raw)
+        require(digest(old[path]) == binding["oldMapSha256"] and digest(new_raw) == binding["newMapSha256"],
+                f"Map hash binding differs: {name}")
+        allowed = {tuple(point) for point in binding["allowedChangedCells"]}
+        width, height = layout["width"], layout["height"]
+        require(len(before_words) == width * height and all(0 <= x < width and 0 <= y < height for x, y in allowed),
+                f"Approved cell mask is invalid: {name}")
+        for n, (a, b) in enumerate(zip(before_words, after_words)):
+            require(a == b or (n % width, n // width) in allowed, f"Map word changed outside art mask: {name}:{n}")
+        blocked = [[n % width, n // width] for n, (a, b) in enumerate(zip(before_words, after_words))
+                   if not a & 0xC00 and b & 0xC00]
+        require(blocked == binding["newlyBlockedCells"], f"Newly blocked set differs: {name}")
+        newly_blocked[binding["mapId"]] = (binding, layout, after_words, blocked)
+    require(layouts_after == expected_layouts, "Layout registry changed beyond the five approved tileset pairs")
+
+    save = json.loads(read(SAVE_MANIFEST))
+    require(save["schemaVersion"] == 1 and save["baselineNativeCommit"] == BASE, "Save-v11 manifest baseline differs")
+    require(len(save["maps"]) == 5 and {item["mapId"] for item in save["maps"]} == set(newly_blocked),
+            "Save-v11 map roster differs")
+    repairs = 0
+    for item in save["maps"]:
+        binding, layout, words, blocked = newly_blocked[item["mapId"]]
+        require(item["oldMapSha256"] == binding["oldMapSha256"] and item["newMapSha256"] == binding["newMapSha256"],
+                f"Save-v11 map binding differs: {item['mapId']}")
+        require([item["width"], item["height"]] == [layout["width"], layout["height"]], "Save-v11 map size differs")
+        origins = [(x, y) for x, y, *_ in item["repairs"]]
+        require(len(set(origins)) == len(origins) and set(origins) == set(map(tuple, blocked)),
+                f"Save-v11 repair origins differ from exact newly blocked set: {item['mapId']}")
+        for _, _, x, y in item["repairs"]:
+            require(0 <= x < layout["width"] and 0 <= y < layout["height"] and not words[y * layout["width"] + x] & 0xC00,
+                    f"Save-v11 repair destination is not open: {item['mapId']}:{x},{y}")
+        repairs += len(origins)
+    require(repairs == 248, "Reviewed save-v11 repair count differs")
+    return report, {**{path: old[path] for path in previous}, **{path: old[path] for path in SAVE_PAIR}}
+
+
+def home_start():
+    spec = importlib.util.spec_from_file_location("approved_art_home_start", Path(__file__).with_name("home_start.py"))
+    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
+    return module
+
+
+def peeled(source, read):
+    """(BASE bytes, reader) beneath the newer guest house layer when `read` gives
+    exactly that layer; ({}, read) when it does not (no layer, or not exact)."""
+    class View:
+        pass
+    view = View(); view.source = Path(source); view.read = read
+    under = home_start().underneath(view)
+    return under, (lambda path: under[path] if path in under else read(path))
+
+
+def check(source=ROOT, overrides=None, reader=None):
+    source = Path(source).resolve(); overrides = overrides or {}
+    base_read = reader or (lambda path: (source / path).read_bytes())
+    _, read = peeled(source, lambda path: overrides[path] if path in overrides else base_read(path))
+    try:
+        report, under = verified(source, read)
+        return {"passed": True, "errors": [], "baseline": BASE, "maps": len(report["maps"]),
+                "landmarks": len(report["landmarks"]), "checkedOutputs": len(report["outputs"]),
+                "unchangedBankInputs": len(report["existingOutputs"]), "underlayPaths": len(under),
+                "saveVersion": 11, "saveRepairs": 248, "runtimeVerified": False}
+    except (OSError, ValueError, KeyError, TypeError, IndexError, subprocess.CalledProcessError) as error:
+        return {"passed": False, "errors": [str(error)], "baseline": BASE}
+
+
+def underneath(files):
+    """Only a completely verified current layer may yield reviewed BASE bytes."""
+    try:
+        home, read = peeled(files.source, files.read)
+        return {**home, **verified(Path(files.source), read)[1]}
+    except (OSError, ValueError, KeyError, TypeError, IndexError, subprocess.CalledProcessError):
+        return {}
+
+
+def frozen_reader(source, read):
+    """Explicit adapter for a historical guard, not a global Source/Files change."""
+    class View:
+        pass
+    view = View(); view.source = Path(source); view.read = read
+    under = underneath(view)
+    return lambda path: under[path] if path in under else read(path)
+
+
+def self_test(source=ROOT):
+    source = Path(source).resolve(); good = check(source)
+    report = json.loads((source / REPORT).read_bytes())
+    first_map = next(iter(report["maps"].values()))["mapPath"]
+    palette = next(path for path in report["generatedBankFiles"] if path.endswith(".pal"))
+    bank = next(path for path in report["generatedBankFiles"] if path.endswith("metatiles.bin"))
+    event = "data/maps/TaichungOldCity/map.json"
+    probes = {}
+    for name, path in [("map-word", first_map), ("private-palette", palette), ("private-definition", bank),
+                       ("callback", "src/tileset_anims.c"), ("save-source", SAVE_PAIR[0]),
+                       ("save-header", SAVE_PAIR[1]), ("save-table", "src/data/taichung/approved_art_save_v11.h"),
+                       ("save-manifest", SAVE_MANIFEST), ("report", REPORT),
+                       ("baseline-manifest", BASELINE_BUNDLE + "/manifest.json"),
+                       ("baseline-save", BASELINE_BUNDLE + "/src/taichung_save.c")]:
+        raw = bytearray((source / path).read_bytes()); raw[len(raw) // 2] ^= 1
+        probes[name] = {path: bytes(raw)}
+    data = json.loads((source / event).read_bytes()); data["bg_events"][0]["x"] += 1
+    probes["unreviewed-sign"] = {event: (json.dumps(data) + "\n").encode()}
+    old_bank = next(path for path in report["existingOutputs"] if path.endswith("tiles.png"))
+    probes["old-bank"] = {old_bank: (source / old_bank).read_bytes() + b"not-reviewed"}
+    caught = {}
+    for name, overrides in probes.items():
+        class View:
+            pass
+        view = View(); view.source = source
+        view.read = lambda path: overrides[path] if path in overrides else (source / path).read_bytes()
+        caught[name] = not check(source, overrides)["passed"] and underneath(view) == {}
+    original_run = subprocess.run
+    def no_subprocess(*args, **kwargs):
+        raise AssertionError("Portable approved-art check must not invoke git/subprocess")
+    try:
+        subprocess.run = no_subprocess
+        portable = check(source)["passed"]
+    finally:
+        subprocess.run = original_run
+    return {"passed": good["passed"] and portable and all(caught.values()), "tree": good,
+            "portableWithoutGit": portable,
+            "rejectedCorruptionProbes": caught}
+
+
+HISTORICAL_CHECKS = {
+    "water": ("tools/taichung/still_water.py",),
+    "signs": ("tools/taichung/street_signs.py",),
+    "kit": ("tools/taichung/kit/check_city_kit.py",),
+    "oldcity": ("tools/taichung/rework/check_oldcity_rework.py",),
+    "nantun": ("tools/taichung/nantun/check_nantun.py",),
+    "xitun": ("tools/taichung/kit/check_xitun_rework.py",),
+    "cmp": ("tools/taichung/landmarks/check_cmp.py",),
+    "staff": ("tools/taichung/check_gym_staff.py",),
+}
+
+
+def historical_checks(source, names, probes=False):
+    """Run frozen compatibility suites in an explicit, disposable certified view.
+
+    Only the 18 independently attested BASE files are substituted. The guard
+    programs are copied, preserving __file__-based source discovery and their
+    historical source hashes. Other files are symlinked read-only inputs to the
+    real tree. Only fixed read-only checks are offered, never an arbitrary
+    command/build/install interface. Live Validator/export and v11 host tests
+    must be run separately against source, not this historical view.
+    """
+    source = Path(source).resolve()
+    try:
+        home, read = peeled(source, lambda path: (source / path).read_bytes())
+        _, under = verified(source, read)
+        under = {**home, **under}
+        layer = home_start()
+        hidden = layer.hidden(lambda path: (source / path).read_bytes()) if home else set()
+    except (OSError, ValueError, KeyError, TypeError, IndexError, subprocess.CalledProcessError) as error:
+        return {"passed": False, "errors": [str(error)], "checks": {}}
+    names = list(HISTORICAL_CHECKS) if names == ["all"] else list(dict.fromkeys(names))
+    require(all(name in HISTORICAL_CHECKS for name in names), "Unknown historical suite")
+    results = {}
+    with tempfile.TemporaryDirectory(prefix="taichung-approved-history-") as temp:
+        view = Path(temp)
+
+        def mirror(folder, rel=""):
+            folder.mkdir(exist_ok=True)
+            for path in (source / rel).iterdir():
+                target = folder / path.name
+                child = str(PurePosixPath(rel) / path.name)
+                if child in hidden:
+                    continue
+                if child == "tools":
+                    shutil.copytree(path, target, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
+                elif child in under:
+                    target.write_bytes(under[child])
+                elif any(key.startswith(child + "/") for key in [*under, *hidden]):
+                    mirror(target, child)
+                else:
+                    target.symlink_to(path, target_is_directory=path.is_dir())
+
+        mirror(view)
+        for name in names:
+            command = [sys.executable, "-B", *HISTORICAL_CHECKS[name]]
+            if probes and name != "staff":
+                command.append("--self-test")
+            run = subprocess.run(command, cwd=view, capture_output=True, text=True)
+            item = {"passed": run.returncode == 0, "exitCode": run.returncode}
+            try:
+                detail = json.loads(run.stdout)
+                item["errors"] = detail.get("errors", [])
+                for key in ("faultProbes", "failureProbes", "adversarialProbes", "rejectedCorruptionProbes"):
+                    if key in detail:
+                        values = detail[key]
+                        item["corruptionProbes"] = len(values)
+            except (ValueError, TypeError):
+                item["output"] = run.stdout[-2000:]
+            if run.stderr:
+                item["stderr"] = run.stderr[-2000:]
+            results[name] = item
+    return {"passed": all(item["passed"] for item in results.values()), "checks": results,
+            "baseline": BASE, "substitutedPaths": len(under),
+            "reviewedReportSha256": REPORT_SHA256,
+            "scope": "Historical compatibility only; current native geometry/export and v11 tests read the real source"}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=ROOT); parser.add_argument("--self-test", action="store_true")
+    parser.add_argument("--historical", nargs="+", choices=["all", *HISTORICAL_CHECKS],
+                        help="Run fixed frozen suites in an explicitly certified temporary underlay")
+    args = parser.parse_args()
+    result = (historical_checks(args.source, args.historical, args.self_test) if args.historical
+              else self_test(args.source) if args.self_test else check(args.source))
+    print(json.dumps(result, indent=2)); raise SystemExit(0 if result["passed"] else 1)
