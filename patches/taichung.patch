+#!/usr/bin/env python3
+"""Check actual bike context/latch/collision bodies using explicit host fixtures.
+
+This does not emulate FireRed. Native runtime QA must measure traversal and
+verify actual task cleanup, animation, field locks, doors and map connections.
+No production body is copied into the fixture: extract it from current source.
+"""
+import os
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def function(source, name):
+    match = re.search(r"^(?:static )?(?:bool8|void|s16) " + re.escape(name) + r"\([^;]*?\)\n\{", source, re.M)
+    if not match:
+        raise SystemExit(f"Missing production function: {name}")
+    start = match.start()
+    cursor = source.index("{", match.start())
+    depth = 1
+    cursor += 1
+    while depth:
+        depth += (source[cursor] == "{") - (source[cursor] == "}")
+        cursor += 1
+    return source[start:cursor]
+
+
+def enum(source, member):
+    pos = source.index(member)
+    start = source.rfind("enum", 0, pos)
+    return source[start:source.index("};", pos) + 2]
+
+
+bike = (ROOT / "src/bike.c").read_text()
+field = (ROOT / "src/field_control_avatar.c").read_text()
+field_types = (ROOT / "include/global.fieldmap.h").read_text()
+keys = (ROOT / "include/gba/io_reg.h").read_text()
+declarations = "\n".join(re.findall(r"^static EWRAM_DATA .*sBikeShortcut\w+ = .*;$", field, re.M))
+if len(declarations.splitlines()) != 4:
+    raise SystemExit("Unexpected B latch state: update explicit host fixture")
+avatar_flags = "\n".join(re.findall(r"^#define PLAYER_AVATAR_FLAG_.*$", field_types, re.M))
+button_flags = "\n".join(re.findall(r"^#define (?:A_BUTTON|B_BUTTON|START_BUTTON|SELECT_BUTTON|DPAD_UP)\s+.*$", keys, re.M))
+
+prefix = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef int16_t s16;
+typedef uint8_t bool8;
+typedef uint32_t bool32;
+#define TRUE 1
+#define FALSE 0
+#define EWRAM_DATA
+#include "constants/global.h"
+#include "constants/flags.h"
+#include "constants/event_object_movement.h"
+#include "constants/map_types.h"
+#include "bike.h"
+struct ObjectEvent { bool8 active, frozen; u8 movementActionId, currentMetatileBehavior, movementDirection; };
+static struct ObjectEvent gObjectEvents[OBJECT_EVENTS_COUNT];
+static struct { u32 vblankCounter2; bool8 inBattle; } gMain;
+static struct { u8 mapType; bool8 bikingAllowed; } gMapHeader;
+static struct { u8 flags, transitionFlags, objectEventId, tileTransitionState, bikeFrameCounter; bool8 preventStep; } gPlayerAvatar;
+static struct { bool8 active; } gPaletteFade;
+struct FieldInput { bool8 pressedBButton; };
+static bool8 sCity, sMainField, sLock, sScript, sLink, sUnion, sReplay, sRoad, sNativeBlocked;
+static bool8 sRailFacing, sStairs;
+static u8 sTile, sCollision, sMovement;
+static u8 sTaskCount;
+#define NUM_TASKS 16
+#define QL_IS_PLAYBACK_STATE sReplay
+enum { MOVE_NONE, MOVE_FACE, MOVE_LEDGE, MOVE_COLLIDE, MOVE_FAST, MOVE_FASTER, MOVE_CURRENT };
+static bool8 TaichungTeamNoGrindActive(void) { return sCity; }
+static bool8 Overworld_IsBikingAllowed(void) { return gMapHeader.bikingAllowed; }
+static bool8 Overworld_IsMainFieldCallback(void) { return sMainField; }
+static bool8 ArePlayerFieldControlsLocked(void) { return sLock; }
+static bool8 ScriptContext_IsEnabled(void) { return sScript; }
+static bool8 IsUpdateLinkStateCBActive(void) { return sLink; }
+static bool8 InUnionRoom(void) { return sUnion; }
+static u8 GetTaskCount(void) { return sTaskCount; }
+static bool8 FlagGet(u16 flag) { assert(flag == FLAG_SYS_ON_CYCLING_ROAD); return sRoad; }
+static u8 ObjectEventGetHeldMovementActionId(struct ObjectEvent *object) { return object->movementActionId; }
+static void PlayerGetDestCoords(s16 *x, s16 *y) { *x = 5; *y = 6; }
+static u8 MapGridGetMetatileBehaviorAt(s16 x, s16 y) { assert(x == 5 && y == 6); return sTile; }
+static bool8 MetatileBehavior_IsForcedMovementTile(u8 tile) { return !!(tile & 1); }
