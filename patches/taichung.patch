--- /dev/null
+++ b/data/taichung/landmarks/taichung-park/encode_candidate.py
@@ -0,0 +1,210 @@
+#!/usr/bin/env python3
+"""Mechanically encode approved Park art into an unmerged Station-palette candidate."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ART = PROJECT / "artifacts/worktrees/c291d4842985/landmark-art"
+STATION = GAME / "data/taichung/landmarks/old-station/native.png"
+SIZE = (192, 128)
+BODY_WIDTH = 176
+EXPECTED_STUDY = "2e6e22b09a76c7cdec97f18ccba8404059a5662f1a09de990ab32e5564f0b0ad"
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)] for y in range(8) for x in range(8))
+
+
+def box(points):
+    return ([min(x for x, y in points), min(y for x, y in points),
+             max(x for x, y in points), max(y for x, y in points)] if points else None)
+
+
+def encode(source, output, review):
+    if sha(source) != EXPECTED_STUDY:
+        raise ValueError("The frozen approved Park study changed")
+    rgba = Image.open(source).convert("RGBA")
+    station = Image.open(STATION)
+    if station.mode != "P" or station.info.get("transparency") != 0 or station.getextrema()[1] > 15:
+        raise ValueError("Station must be 4bpp indexed art with transparent index 0")
+    palette = [tuple(station.getpalette()[i:i+3]) for i in range(0, 48, 3)]
+    mask = rgba.getchannel("A").point(lambda value: 255 if value >= 224 else 0)
+    crop_box = mask.getbbox()
+    if crop_box is None:
+        raise ValueError("No visible architecture at alpha threshold 224")
+    crop = rgba.crop(crop_box)
+    crop.putalpha(mask.crop(crop_box))
+    scale = min(BODY_WIDTH/crop.width, SIZE[1]/crop.height)
+    subject_size = tuple(max(1, round(value*scale)) for value in crop.size)
+    # Mechanical placement only: retain the complete 176px body and center its
+    # existing red stub near x104. No portal, bridge, ground or architecture repair.
+    offset = (16, SIZE[1]-subject_size[1])
+    if offset[0]+subject_size[0] > SIZE[0]:
+        raise ValueError("Subject would be cropped by the logical canvas")
+    resized = crop.convert("RGBa").resize(subject_size, Image.Resampling.BOX).convert("RGBA")
+    canvas = Image.new("RGBA", SIZE)
+    canvas.paste(resized, offset)
+    indices = []
+    for r, g, b, alpha in canvas.get_flattened_data():
+        if alpha < 128:
+            indices.append(0)
+        else:
+            indices.append(min(range(1, 16), key=lambda n:
+                sum((value-palette[n][channel])**2 for channel, value in enumerate((r, g, b)))))
+    indexed = Image.new("P", SIZE)
+    indexed.putpalette([component for color in palette for component in color] + [0]*720)
+    indexed.putdata(indices)
+    indexed.info["transparency"] = 0
+    native = indexed.convert("RGBA")
+    output.mkdir(parents=True, exist_ok=True)
+    indexed.save(output/"candidate-indexed.png")
+    native.save(output/"candidate-native.png")
+    review.parent.mkdir(parents=True, exist_ok=True)
+    native.resize((SIZE[0]*4, SIZE[1]*4), Image.Resampling.NEAREST).save(review)
+
+    graphics, lookup, tilemap = [], {}, []
+    tile_width, tile_height = SIZE[0]//8, SIZE[1]//8
+    for ty in range(tile_height):
+        for tx in range(tile_width):
+            pixels = tuple(indices[(ty*8+y)*SIZE[0]+tx*8+x] for y in range(8) for x in range(8))
+            canonical, flags = min((flip(pixels, flags), flags) for flags in (0, 0x400, 0x800, 0xC00))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tilemap.append(lookup[canonical] | flags | 0x7000)
+    if len(graphics) > 1024:
+        raise ValueError("Relative graphics exceed the tilemap index field")
+    metatiles, occupied_rows = [], []
+    for my in range(SIZE[1]//16):
+        row = ""
+        for mx in range(SIZE[0]//16):
+            metatiles.append([tilemap[(my*2+y)*tile_width+mx*2+x] for y in range(2) for x in range(2)])
+            occupied = any(indices[(my*16+y)*SIZE[0]+mx*16+x] for y in range(16) for x in range(16))
+            row += "1" if occupied else "0"
+        occupied_rows.append(row)
+    slots = (len(graphics)+15)//16*16
+    sheet = Image.new("P", (128, slots//16*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info["transparency"] = 0
+    for n, pixels in enumerate(graphics):
+        for y in range(8):
+            for x in range(8):
+                sheet.putpixel((n%16*8+x, n//16*8+y), pixels[y*8+x])
+    sheet.save(output/"tiles.png")
+    (output/"tiles.4bpp").write_bytes(bytes(pixels[i] | pixels[i+1]<<4 for pixels in graphics for i in range(0, 64, 2)))
+    (output/"foreground-tilemap-relative.bin").write_bytes(struct.pack(f"<{len(tilemap)}H", *tilemap))
+    (output/"foreground-metatiles-relative.json").write_text(json.dumps(metatiles, indent=2)+"\n")
+    pal_text = "JASC-PAL\r\n0100\r\n16\r\n" + "".join(" ".join(map(str, color))+"\r\n" for color in palette)
+    (output/"07.pal").write_bytes(pal_text.encode("ascii"))
+    (output/"07.gbapal").write_bytes(struct.pack("<16H", *(r//8 | g//8<<5 | b//8<<10 for r, g, b in palette)))
+
+    # Spatial art measurements only, not a proposed collision mask or open warp.
+    # Red-family indices inside the inspected lower-center stub band are retained.
+    barrier_region = [86, 108, 121, 127]
+    barrier = [(x,y) for y in range(108,128) for x in range(86,122)
+               if indexed.getpixel((x,y)) in (5,6,7)]
+    portal_region = [96, 100, 111, 113]
+    glass = [(x,y) for y in range(100,114) for x in range(96,112)
+             if indexed.getpixel((x,y)) in (1,2,3,4,11,12)]
+    target = [96,112,111,127]
+    barrier_in_target = [(x,y) for x,y in barrier if target[0]<=x<=target[2] and target[1]<=y<=target[3]]
+    # The shared palette maps both timber frames and the red bridge to red-family
+    # indices. Project an inspected source-color band separately to avoid calling
+    # all quantized brown timber part of the actual red stub. This is a measured
+    # color extent, not a new art layer or a traversability segmentation.
+    source_bridge_mask = Image.new("L", rgba.size)
+    for y in range(760,914):
+        for x in range(650,890):
+            r,g,b,alpha = rgba.getpixel((x,y))
+            if alpha>=224 and r-g>35 and r-b>40 and r>95:
+                source_bridge_mask.putpixel((x,y),255)
+    fitted_bridge_mask = source_bridge_mask.crop(crop_box).resize(subject_size,Image.Resampling.BOX)
+    bridge_mask = Image.new("L",SIZE)
+    bridge_mask.paste(fitted_bridge_mask,offset)
+    bridge_core = [(x,y) for y in range(SIZE[1]) for x in range(SIZE[0]) if bridge_mask.getpixel((x,y))>=128]
+    bridge_box = box(bridge_core)
+    bridge_core_in_target = [(x,y) for x,y in bridge_core if target[0]<=x<=target[2] and target[1]<=y<=target[3]]
+    glass_box = box(glass)
+    metadata = {
+        "schemaVersion":1, "landmarkId":"taichung-park", "candidateVersion":1,
+        "status":"approved identity; mechanical native candidate only, unmerged and unregistered",
+        "sourceArtifact":str(source), "sourceSha256":sha(source), "sourceStudyUnchanged":True,
+        "recipe":{"sourceAlphaThreshold":224, "sourceCropBox":list(crop_box),
+                  "resampling":"premultiplied RGBA BOX, nearest existing palette, no dither",
+                  "postResampleAlphaThreshold":128, "preserveAspectRatio":True,
+                  "logicalSizePixels":list(SIZE), "visibleBodyTargetWidth":BODY_WIDTH,
+                  "fittedSubjectSize":list(subject_size), "subjectOffset":list(offset),
+                  "nativePixelClusterSize":1, "artOrGroundFixApplied":False,
+                  "PillowVersion":PIL.__version__},
+        "palette":{"bank":7, "source":str(STATION.relative_to(GAME)), "sourceSha256":sha(STATION),
+                   "exactSourcePalette16":[list(color) for color in palette],
+                   "usedOpaqueIndexes":sorted(set(indices)-{0}),
+                   "newColorCount":0, "additionalPaletteBankCount":0,
+                   "sharedPaletteMatchesStationExactly":indexed.getpalette()[:48]==station.getpalette()[:48],
+                   "palFileLineEndings":"CRLF written as bytes; canonical Git representation",
+                   "palFileSha256":sha(output/"07.pal")},
+        "native":{"unique8x8GraphicsBeforeAnyBankMerge":len(graphics),
+                  "uniqueIncludesTransparentGraphic":True, "sheetSlotsIncludingPadding":slots,
+                  "foregroundTilemapDimensions8x8":[tile_width,tile_height],
+                  "foregroundMetatileCells":len(metatiles),
+                  "occupiedMetatileCells":sum(row.count("1") for row in occupied_rows),
+                  "distinctForegroundMetatileDefinitions":len({tuple(mt) for mt in metatiles}),
+                  "occupiedRows":occupied_rows, "relativeGraphicIndexes":True,
+                  "binaryAlpha":set(native.getchannel("A").get_flattened_data())=={0,255},
+                  "mapOrCollisionGenerated":False},
+        "entrance":{"targetLocalMetatile":[6,7], "targetLocalCellPixelsInclusive":target,
+                    "targetCellCenterPixels":[104,120], "proposedBaselineOrigin":[26,23],
+                    "baselineDoor":[32,30], "baselineApproach":[32,31], "baselineArrival":[32,34],
+                    "originPlusLocalDoorMatchesBaseline":True,
+                    "portalGlassSearchRegionPixelsInclusive":portal_region,
+                    "measuredPortalGlassBoxPixelsInclusive":glass_box,
+                    "measuredPortalGlassBoxCenterPixels":[(glass_box[0]+glass_box[2])/2,(glass_box[1]+glass_box[3])/2],
+                    "redBarrierSearchRegionPixelsInclusive":barrier_region,
+                    "quantizedRedFamilyExtentInInspectionBand":box(barrier),
+                    "quantizedRedFamilyPixelsWithinTargetCell":len(barrier_in_target),
+                    "measuredRedBarrierBoxPixelsInclusive":bridge_box,
+                    "redBarrierMetatileColumns":list(range(bridge_box[0]//16,bridge_box[2]//16+1)),
+                    "redBarrierMetatileRows":list(range(bridge_box[1]//16,bridge_box[3]//16+1)),
+                    "redBarrierOverlapTargetCellPixels":len(bridge_core_in_target),
+                    "sourceBridgeMaskMeasurement":{"sourceRegionPixelsInclusive":[650,760,889,913],
+                        "predicate":"alpha>=224, r-g>35, r-b>40, r>95",
+                        "projection":"same crop/BOX size/offset as native art, coverage threshold128; measured only, never painted"},
+                    "targetCenterPaletteIndex":indexed.getpixel((104,120)),
+                    "redBarrierIsNotWalkable":True, "openPortalOrCollisionVerified":False,
+                    "measurementMethod":"Visually identified bands: dark/glass indices1/2/3/4/11/12 above the front barrier; source-color red-stub extent projected through the same crop/BOX transform. Broader quantized red-family extent also includes adjacent brown timber and is reported separately. No mask proves traversal.",
+                    "functionalDoorReplacementOwner":"Root; not performed here"},
+        "budget":{"mergedWithOldCity":False, "stationAndOtherLandmarksNotIncludedInCost":True,
+                  "fitsCombinedOldCity":None, "noClaimOf384GraphicFit":True,
+                  "noSeparateFullBankAllocationAssumed":True,
+                  "rootOwnsCombinedPrimarySecondaryAndColorBudget":True},
+        "integration":{"registeredInRom":False, "nativeReady":False,
+                       "requires":["Root combined graphics and metatile audit", "functional portal/bridge composition", "ground and collision composition", "door/return binding and runtime proof"]},
+        "reviewArtifact":str(review), "nativePngSha256":sha(output/"candidate-native.png"),
+        "encodeScriptSha256":sha(Path(__file__))}
+    (output/"encode-manifest.json").write_text(json.dumps(metadata,indent=2)+"\n")
+    return metadata
+
+
+if __name__ == "__main__":
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source",type=Path,default=ART/"park-study-v1.png")
+    parser.add_argument("--output",type=Path,default=HERE/"candidate")
+    parser.add_argument("--review",type=Path,default=ART/"park-native-candidate-v1.png")
+    args=parser.parse_args()
+    result=encode(args.source,args.output,args.review)
+    print(json.dumps({"recipe":result["recipe"],"native":result["native"],"entrance":result["entrance"],"reviewArtifact":result["reviewArtifact"]},indent=2))
