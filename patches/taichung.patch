+"""National Taiwan Museum of Fine Arts pieces: white galleries, the bronze Water Buffaloes relief,
+the glass Time Atrium, black marble lobby."""
+from PIL import Image, ImageDraw
+import random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((40,40,48))
+WH0,WH1,WH2=q((248,248,244)),q((224,224,220)),q((192,192,188))
+BZ0,BZ1,BZ2,BZ3=q((152,112,64)),q((112,80,48)),q((192,152,96)),q((72,52,36))
+GL0,GL1=q((200,232,240)),q((152,200,216))
+PQ0,PQ1=q((224,200,160)),q((200,176,136))
+MB0,MB1=q((48,48,56)),q((72,72,84))
+ST0,ST1=q((232,208,136)),q((200,176,104))      # warm yellow slate of the facade
+
+def wall(row,seed=0):
+    im=Image.new('RGB',(16,16),WH0); d=ImageDraw.Draw(im)
+    if row==0:
+        d.line([0,0,15,0],fill=OUT); d.line([0,2,15,2],fill=WH2)   # picture rail
+        for x in (4,12): d.point((x,1),fill=q((96,96,104)))         # track spots
+    else:
+        d.rectangle([0,13,15,15],fill=WH2); d.line([0,13,15,13],fill=q((168,168,164)))
+    return im
+
+def stone_wall(row):
+    """lobby wall in the building's warm yellow slate."""
+    im=Image.new('RGB',(16,16),ST0); d=ImageDraw.Draw(im)
+    for y in (5,11): d.line([0,y,15,y],fill=ST1)
+    d.line([7,0,7,4],fill=ST1); d.line([3,6,3,10],fill=ST1); d.line([11,6,11,10],fill=ST1); d.line([7,12,7,15],fill=ST1)
+    if row==0: d.line([0,0,15,0],fill=OUT)
+    else: d.rectangle([0,13,15,15],fill=MB1)
+    return im
+
+def parquet(seed=0):
+    """polished pale gallery floor."""
+    im=Image.new('RGB',(16,16),q((232,228,216))); d=ImageDraw.Draw(im)
+    d.line([0,15,15,15],fill=q((212,208,196))); d.line([15,0,15,15],fill=q((212,208,196)))
+    if seed==1: d.line([3,4,6,4],fill=q((244,242,236)))
+    return im
+
+def marble(seed=0):
+    im=Image.new('RGB',(16,16),MB0); d=ImageDraw.Draw(im); r=random.Random(seed)
+    for _ in range(2):
+        x=r.randrange(16); y=r.randrange(16)
+        for i in range(7): d.point(((x+i)%16,(y+i//2)%16),fill=MB1)
+    d.line([0,15,15,15],fill=q((36,36,44))); d.line([15,0,15,15],fill=q((36,36,44)))
+    d.point((3,3),fill=q((120,120,136)))
+    return im
+
+PAINT={
+ 'sea':  lambda d,x0,y0,x1,y1:(d.rectangle([x0,y0,x1,(y0+y1)//2],fill=q((168,208,240))),d.rectangle([x0,(y0+y1)//2,x1,y1],fill=q((56,112,184))),d.ellipse([x1-6,y0+1,x1-3,y0+4],fill=q((248,224,120)))),
+ 'hills':lambda d,x0,y0,x1,y1:(d.rectangle([x0,y0,x1,y1],fill=q((232,224,192))),d.polygon([(x0,y1),(x0+(x1-x0)//3,y0+2),(x0+(x1-x0)*2//3,y1)],fill=q((88,144,96))),d.polygon([(x0+(x1-x0)//3,y1),(x1-3,y0+3),(x1,y1)],fill=q((56,104,72)))),
+ 'abstract':lambda d,x0,y0,x1,y1:(d.rectangle([x0,y0,x1,y1],fill=q((240,232,216))),d.rectangle([x0+1,y0+1,(x0+x1)//2,y1-2],fill=q((216,64,56))),d.rectangle([(x0+x1)//2+1,y0+2,x1-1,(y0+y1)//2],fill=q((48,88,168))),d.rectangle([(x0+x1)//2+1,(y0+y1)//2+2,x1-2,y1-1],fill=q((240,200,72)))),
+ 'portrait':lambda d,x0,y0,x1,y1:(d.rectangle([x0,y0,x1,y1],fill=q((96,72,64))),d.ellipse([(x0+x1)//2-3,y0+2,(x0+x1)//2+3,y0+8],fill=q((232,184,152))),d.rectangle([(x0+x1)//2-4,y0+9,(x0+x1)//2+4,y1],fill=q((48,64,104)))),
+ 'lotus':lambda d,x0,y0,x1,y1:(d.rectangle([x0,y0,x1,y1],fill=q((216,232,208))),d.ellipse([x0+2,y1-6,x0+8,y1-2],fill=q((88,152,96))),d.ellipse([x1-9,y0+3,x1-4,y0+8],fill=q((240,152,184))),d.line([x1-7,y0+8,x1-7,y1],fill=q((88,152,96)))),
+}
+def painting(base,kind,frame='gold',x0=2,y0=3,x1=13,y1=12):
+    """a framed painting drawn onto an RGB wall image (any size); returns the image."""
+    im=base.copy(); d=ImageDraw.Draw(im)
+    fc={'gold':(q((216,176,88)),q((160,120,48))),'black':(q((48,48,56)),q((24,24,32))),'wood':(q((168,112,64)),q((120,80,40)))}[frame]
+    d.rectangle([x0-1,y0-1,x1+1,y1+1],fill=fc[1]); d.rectangle([x0,y0,x1,y1],fill=fc[0])
+    PAINT[kind](d,x0+1,y0+1,x1-1,y1-1)
+    d.line([x0-1,y1+2,x1+1,y1+2],fill=WH2)
+    # spotlight wash above
+    for x in range(x0+2,x1-1,2): d.point((x,max(0,y0-3)),fill=q((255,248,224)))
+    return im
+
+def relief(w=5,h=2):
+    """bronze Water Buffaloes relief: buffaloes, banana leaves, a boy with a hat."""
+    W,H=w*16,h*16; im=Image.new('RGB',(W,H),BZ1); d=ImageDraw.Draw(im)
+    d.rectangle([0,0,W-1,H-1],outline=OUT); d.rectangle([1,1,W-2,H-2],outline=BZ2); d.rectangle([2,2,W-3,H-3],fill=BZ1)
+    for x in (6,W-12):   # banana plants
+        d.line([x+2,8,x+2,H-4],fill=BZ0)
+        for dx,dy in ((-4,4),(5,6),(-3,10),(5,12)): d.ellipse([x+2+min(0,dx),dy,x+2+max(0,dx)+2,dy+3],fill=BZ2)
+    d.rectangle([2,2,W-3,H-3],fill=BZ3)
+    for bx,by,face in ((14,14,1),(34,12,-1),(54,15,1)):   # three water buffaloes
+        d.rounded_rectangle([bx,by,bx+16,by+8],radius=4,fill=BZ0,outline=OUT)
+        d.line([bx+2,by+1,bx+13,by+1],fill=BZ2)
+        hx=bx+15 if face>0 else bx-6
+        d.rounded_rectangle([hx,by+2,hx+6,by+8],radius=2,fill=BZ0,outline=OUT)
+        d.arc([hx-3,by-3,hx+9,by+5],190,350,fill=BZ2); d.arc([hx-3,by-2,hx+9,by+6],190,350,fill=BZ2)
+        for lx in (bx+2,bx+6,bx+11,bx+14): d.line([lx,by+9,lx,by+12],fill=BZ0)
+    d.ellipse([39,4,46,8],fill=BZ2,outline=OUT); d.rectangle([41,8,44,12],fill=BZ0,outline=OUT)   # the boy in a straw hat
+    d.line([3,H-4,W-4,H-4],fill=BZ3)
+    return im
+
+def atrium(w=3):
+    """the Time Atrium: glass box (top + 2-row face) with artists' photos, (w x 3) RGBA."""
+    W=w*16; im=Image.new('RGBA',(W,48)); d=ImageDraw.Draw(im)
+    d.rectangle([0,2,W-1,15],fill=GL0,outline=OUT)
+    for x in range(0,W,8): d.line([x,2,x,15],fill=GL1)
+    for y in (6,10): d.line([0,y,W-1,y],fill=GL1)
+    d.rectangle([0,16,W-1,45],fill=GL1,outline=OUT); d.line([1,16,W-2,16],fill=q((232,248,255)))
+    for x in range(0,W,16): d.line([x,16,x,45],fill=q((112,128,144)))
+    r=random.Random(3)
+    for x in range(3,W-6,7):
+        for y in (19,30):
+            if r.random()<.75:
+                d.rectangle([x,y,x+4,y+6],fill=q((232,228,220)),outline=q((80,80,88)))
+                d.ellipse([x+1,y+1,x+3,y+3],fill=r.choice([q((200,160,128)),q((168,128,96)),q((96,96,104))]))
+    d.line([3,22,8,17],fill=q((255,255,255))); d.line([W-12,40,W-6,34],fill=q((255,255,255)))
+    d.rectangle([0,44,W-1,47],fill=q((96,100,108)))
+    return im
+
+def partition(base_l,base_r,kind,frame='black'):
+    """free-standing gallery wall, 2x2: thin top, white face with one painting (RGBA over floor)."""
+    im=Image.new('RGBA',(32,32));
+    for i,b in enumerate((base_l,base_r)): im.paste(b[0],(i*16,0)); im.paste(b[1],(i*16,16))
+    d=ImageDraw.Draw(im)
+    d.rectangle([1,1,30,4],fill=WH1,outline=OUT)
+    d.rectangle([1,5,30,28],fill=WH0,outline=OUT); d.rectangle([2,26,29,28],fill=WH2)
+    face=im.crop((0,0,32,32)).convert('RGB'); face=painting(face,kind,frame,7,10,24,21); im.paste(face,(0,0))
+    d=ImageDraw.Draw(im); d.line([1,29,30,29],fill=q((0,0,0))) if False else None
+    return im
+
+def plinth(base_top,base_bot,kind='bronze'):
+    """white plinth with a sculpture, 1x2."""
+    im=Image.new('RGBA',(16,32)); im.paste(base_top,(0,0)); im.paste(base_bot,(0,16)); d=ImageDraw.Draw(im)
+    d.rectangle([3,17,12,29],fill=WH0,outline=OUT); d.rectangle([3,17,12,19],fill=WH1); d.line([12,18,12,29],fill=WH2)
+    if kind=='bronze':
+        d.ellipse([5,3,10,8],fill=BZ0,outline=BZ3); d.rectangle([6,8,9,16],fill=BZ0,outline=BZ3); d.line([4,10,11,10],fill=BZ3)
+    elif kind=='red':
+        d.polygon([(4,16),(8,2),(12,16)],fill=q((216,64,56)),outline=OUT); d.line([8,4,8,15],fill=q((240,120,104)))
+    else:
+        d.ellipse([3,5,12,16],fill=q((96,176,200)),outline=OUT); d.ellipse([5,7,8,10],fill=q((208,240,248)))
+    return im
+
+def rope(base,ends=''):
+    im=base.copy().convert('RGBA'); d=ImageDraw.Draw(im)
+    d.arc([0,4,15,12],20,160,fill=q((176,40,48))); d.arc([0,5,15,13],20,160,fill=q((136,32,40)))
+    for x in ((0,) if 'l' in ends else ())+((13,) if 'r' in ends else ()):
+        d.rectangle([x,4,x+2,13],fill=q((216,176,88)),outline=OUT)
+    return im
+
+def bench(base_l,base_r):
+    im=Image.new('RGBA',(32,16)); im.paste(base_l,(0,0)); im.paste(base_r,(16,0)); d=ImageDraw.Draw(im)
+    d.rectangle([2,4,29,10],fill=q((56,56,64)),outline=OUT); d.line([3,5,28,5],fill=q((96,96,108)))
+    for x in (4,27): d.rectangle([x,11,x+1,14],fill=q((160,160,168)))
+    return im
+
+def bamboo(w=2,h=2):
+    """the bamboo light-well: a glass court of green bamboo, w x h."""
+    W,H=w*16,h*16; im=Image.new('RGB',(W,H),q((152,200,136))); d=ImageDraw.Draw(im)
+    for x in range(3,W-2,5):
+        d.line([x,0,x,H-1],fill=q((72,136,72))); d.line([x+1,0,x+1,H-1],fill=q((120,184,104)))
+        for y in range(4,H,7): d.line([x,y,x+1,y],fill=q((48,96,56)))
+        d.line([x+2,(x*3)%H,x+4,(x*3)%H-2],fill=q((56,120,64)))
+    d.rectangle([0,0,W-1,H-1],outline=GL1); d.rectangle([1,1,W-2,H-2],outline=q((232,248,255)))
+    return im
diff --git a/tools/taichung/gym_interiors/art_park.py b/tools/taichung/gym_interiors/art_park.py
