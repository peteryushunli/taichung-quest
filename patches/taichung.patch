+#!/usr/bin/env python3
+"""Validate authored copy, unchanged source flow and actual ARM text bytes."""
+from pathlib import Path
+import ast, hashlib, importlib.util, json, re, struct, subprocess, tempfile
+ROOT=Path(__file__).resolve().parents[2]
+BASE='f7e7d04d03f22872dad17fbd6bff88d5e1dd4897'
+DATA=ROOT/'data/taichung/leader-challenges-20261124/dialogue.json'
+proof=json.loads(DATA.read_text())
+spec=importlib.util.spec_from_file_location('glyphs',ROOT/'tools/taichung_gameplay/extend-chinese-glyphs.py');glyphs=importlib.util.module_from_spec(spec);spec.loader.exec_module(glyphs)
+existing=glyphs.parse_existing((ROOT/'charmap.txt').read_bytes(),(ROOT/'src/data/taichung_glyphs.h').read_bytes())
+lookup=existing['mappings'];lookup["'"]=lookup['’']
+def literal(source,name):
+    raw=re.search(r'\b'+name+r'\[\] = _\(("(?:\\.|[^"\\])*")\);',source)[1]
+    return json.loads(raw.replace(r'\p',r'\f'))
+def text(pages):return '\f'.join('\n'.join(page) for page in pages)
+def symbols(path):
+    raw=path.read_bytes();h=struct.unpack_from('<16sHHIIIIIHHHHHH',raw);assert h[0][:6]==b'\x7fELF\x01\x01' and h[2]==40
+    sections=[struct.unpack_from('<10I',raw,h[6]+i*h[11]) for i in range(h[12])];out={}
+    for sh in sections:
+        if sh[1]!=2:continue
+        tab=sections[sh[6]];strings=raw[tab[4]:tab[4]+tab[5]]
+        for pos in range(sh[4],sh[4]+sh[5],sh[9]):
+            name,value,size,info,other,index=struct.unpack_from('<IIIBBH',raw,pos)
+            if not size or not index or index>=len(sections):continue
+            label=strings[name:strings.index(0,name)].decode();sec=sections[index];at=sec[4]+value-sec[3];out[label]=raw[at:at+size]
+    return out
+new_win=(ROOT/'src/taichung_leader_win_text.c').read_text();checks=[]
+for row in proof['leaders']:
+    source=(ROOT/row['file']).read_text();old=subprocess.check_output(['git','-C',str(ROOT),'show',BASE+':'+row['file']]).decode();restored=source
+    for locale in ('en','zh-TW'):
+        name=row['introSymbols'][locale]
+        assert literal(source,name)==text(row['intro'][locale])
+        pattern=r'const u8 '+name+r'\[\] = _\("(?:\\.|[^"\\])*"\);'
+        replacement=re.search(pattern,old)[0]
+        restored,n=re.subn(pattern,lambda _:replacement,restored);assert n==1
+        assert literal(new_win,row['leaderWinSymbols'][locale])==text(row['leaderWins'][locale])
+    assert restored==old,('unexpected non-intro source edit',row['file'])
+    objects={ 'intro':symbols(ROOT/'build/firered'/Path(row['file']).with_suffix('.o')),
+              'leaderWins':symbols(ROOT/'build/firered/src/taichung_leader_win_text.o') }
+    for kind,key in [('intro','introSymbols'),('leaderWins','leaderWinSymbols')]:
+        for locale in ('en','zh-TW'):
+            value=text(row[kind][locale]);name=row[key][locale]
+            expected=b''.join(b'\xfe' if c=='\n' else b'\xfb' if c=='\f' else bytes(lookup[c]) for c in value)+b'\xff'
+            actual=objects[kind][name];assert actual[:len(expected)]==expected and all(v==0 for v in actual[len(expected):]),name
+            checks.append({'symbol':name,'kind':kind,'locale':locale,'nativeBytes':expected.hex(' '),'pageMarkers':expected.count(b'\xfb'),'encodedExact':True})
+# Existing ASM flow, outcome paths, badge/revisit text and source are untouched.
+assert not subprocess.check_output(['git','-C',str(ROOT),'diff',BASE,'--','data/scripts','src/taichung_gym_progress.c','src/taichung_badges.c','src/taichung_city_pass.c']).strip()
+with tempfile.TemporaryDirectory(prefix='leader-win-') as directory:
+    p=Path(directory)
+    (p/'driver.c').write_text('''#include "global.h"
+#include "taichung_leader_win_text.h"
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+static int chinese;
+const u8 *TaichungText(const u8 *en,const u8 *zh){return chinese?zh:en;}
+int main(void){unsigned slot;for(chinese=0;chinese<2;chinese++) {
+for(slot=0;slot<10;slot++){const u8 *s=TaichungGymGetLeaderWinText(slot);fwrite(s,strlen((const char*)s)+1,1,stdout);}
+assert(strlen((const char*)TaichungGymGetLeaderWinText(10))==0);
+assert(strlen((const char*)TaichungGymGetLeaderWinText(65535))==0);
+}return 0;}
+''')
+    subprocess.run(['cc','-std=c99','-Wall','-Wextra','-Werror','-I'+str(ROOT/'tests/gym_host'),'-I'+str(ROOT/'include'),str(ROOT/'src/taichung_leader_win_text.c'),str(p/'driver.c'),'-o',str(p/'selector')],check=True)
+    actual=subprocess.check_output([str(p/'selector')]).split(b'\0');assert actual.pop()==b''
+    expected=[text(row['leaderWins'][locale]).encode() for locale in ('en','zh-TW') for row in proof['leaders']];assert actual==expected
+out={'status':'PASS','base':BASE,'all40ActualArmObjectStringsEncodedExact':True,'existingCSourceBytesRestoredExactlyAfterRemovingOnly20IntroEdits':True,'asmAndProgressAwardRevisitSourceUnchanged':True,'actualLeaderWinSelector20LocalizedResults':True,'invalidIdsReturnEmpty':True,'newGlyphCount':len(existing['rows'])-1053,'currentGlyphCount':len(existing['rows']),'strings':checks}
+print(json.dumps(out,ensure_ascii=False,indent=2))
