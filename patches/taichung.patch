+        tests.require(all((plan[y][x] == "H") == ((x, y) in band) for y in range(height) for x in range(width)),
+                      "The plan's highway is not the band")
+        def wall_piece(x, y):
+            return "wall-w-top" if x == 1 else "wall-w-bank" if x == 2 and y >= 3 else "wall-n-upper" if y == 1 else "wall-n-lower"
+        wall = {(x, y) for y in range(height) for x in range(width)
+                if (x - dx in (1, 2) and y - dy >= 1) or (y - dy in (1, 2) and x - dx >= 1)}
+        tests.require({(x, y) for y in range(height) for x in range(width) if plan[y][x] == "W"} == wall,
+                      "The plan's wall is not columns 1-2 and rows 1-2")
+        tests.require(all(cell(x, y) & 0x3FF == kit[wall_piece(x - dx, y - dy)] and cell(x, y) & SOLID_BITS for x, y in wall),
+                      "The wall is not the kit's solid wall pieces")
+        wrong = []
+        for y in range(6, height):
+            for x in range(6, width):
+                c, word = plan[y][x], cell(x, y)
+                if (x, y) in signs:
+                    ok = word == SIGNPOST and c in "L.g"
+                elif c == "W":
+                    ok = True
+                elif (x - dx, y - dy) in KERBS:
+                    ok = c == "s" and plan[y][x + 1] == "S" and word == 0x3000 | kit["st-bollards-e"]
+                elif c in "Ss":
+                    ok = word & 0x3FF in street_ids and not word & SOLID_BITS
+                elif c == "L":
+                    ok = True
+                elif c == "B":
+                    ok = word & 0x3FF in BUILDING_IDS and word & SOLID_BITS
+                elif c in "Tt":
+                    tops = [(x - ox, y - oy) for ox, oy in TREE if plan[y - oy][x - ox] == "T"]
+                    ok = len(tops) == 1 and word == TREE[(x - tops[0][0], y - tops[0][1])]
+                else:
+                    ok = word in FILL_WORDS.get(c, ())
+                if not ok:
+                    wrong.append((x - dx, y - dy))
+        tests.require(not wrong, f"Cells break their plan class at world {wrong[:6]}")
+        for event in base_data["warp_events"]:
+            x, y = event["x"] + dx, event["y"] + dy
+            tests.require(cell(x, y) == today[event["y"] * today_w + event["x"]], f"Door cell ({x},{y}) changed")
+        for warp in base_data["warp_events"]:
+            x, y = warp["x"] + dx, warp["y"] + dy
+            tests.require(bank.attr(cell(x, y) & 0x3FF) & 0x1FF == DOOR_BEHAVIOUR, f"Door ({x},{y}) lost its door behaviour")
