+"""Compile the ten approved gym rooms into native layouts (and, for the six redrawn
+rooms, a private secondary tileset each) in the game worktree.
+
+Rooms come from rooms.py (draft 1: plain words on one FireRed tileset pair) and
+rooms2.py (draft 2/3: cells from any tileset pair, recoloured, or new art).
+
+A draft-1 room keeps its FireRed pair, so its layout points at the original
+tilesets. A redrawn room gets gTileset_TaichungGym<Name> over gTileset_Building:
+- a cell that is an unrecoloured Building metatile is used as is;
+- any other FireRed metatile is copied with both layers and its attributes;
+  its tiles are re-encoded unless they are unrecoloured Building tiles;
+- new art goes in the bottom layer of a COVERED metatile (nothing draws over
+  people), behaviour normal, except the exit mat (south arrow warp).
+Colours are packed into the six secondary palettes, reusing a Building palette
+where a tile fits one; if they do not fit, the closest colours are merged.
+"""
+import json, struct, sys, math
+from pathlib import Path
+from PIL import Image
+S = Path(__file__).resolve().parent
+sys.path.insert(0, str(S))
+import lib2, rm
+import rooms as rooms1
+import rooms2
+from meta import META
+
+NATIVE = lib2.SRC
+BUILDING = 'gTileset_Building'
+MB_SOUTH_ARROW_WARP = 0x65
+LAYER_COVERED = 1 << 29
+FLOOR_ELEVATION = 0x3000
+SOLID = 0x0400
+
+GYMS = {  # room: (map folder, CamelName)
+    'station': ('TaichungOldStation_Gym', 'OldStation'),
+    'park': ('TaichungPark_Gym', 'Park'),
+    'miyahara': ('TaichungMiyahara_Gym', 'Miyahara'),
+    'science': ('TaichungScienceMuseum_Gym', 'ScienceMuseum'),
+    'greenway': ('TaichungGreenway_Gym', 'Greenway'),
+    'shenji': ('TaichungShenJi_Gym', 'ShenJi'),
+    'finearts': ('TaichungFineArts_Gym', 'FineArts'),
+    'fengjia': ('TaichungFengjia_Gym', 'Fengjia'),
+    'theater': ('TaichungTheater_Gym', 'Theater'),
+    'wanhe': ('TaichungWanheTemple_Hall', 'WanheTemple'),
+}
+DRAFT1 = ('science', 'greenway', 'shenji', 'wanhe')
+
+
+def snake(camel):
+    out = ''
+    for i, ch in enumerate(camel):
+        if ch.isupper() and i:
+            out += '_'
+        out += ch.lower()
+    return out
+
+
+def layout_id(n): return 'LAYOUT_TAICHUNG_GYM_' + snake(GYMS[n][1]).upper()
+def layout_dir(n): return 'TaichungGym' + GYMS[n][1]
+def tileset_label(n): return 'gTileset_TaichungGym' + GYMS[n][1]
+def tileset_dir(n): return 'data/tilesets/secondary/taichung_gym_' + snake(GYMS[n][1])
+
+
+def q5(c):
+    return tuple(v // 8 * 8 for v in c[:3])
+
+
+_attrs = {}
+def attributes(label):
+    if label not in _attrs:
+        p = rm.tileset_paths(NATIVE, label)['metatiles'].parent / 'metatile_attributes.bin'
+        raw = p.read_bytes()
+        _attrs[label] = struct.unpack('<%dI' % (len(raw) // 4), raw)
+    return _attrs[label]
+
+
+def attribute(pri, sec, mid):
+    a = attributes(pri if mid < 640 else sec)
+    return a[mid if mid < 640 else mid - 640]
+
+
+_tiles = {}
+def tile_image(pri, sec, t):
+    label = pri if t < 640 else sec
+    if label not in _tiles:
+        _tiles[label] = Image.open(rm.tileset_paths(NATIVE, label)['tiles'])
+    im = _tiles[label]; t = t if t < 640 else t - 640
+    return im.crop(((t % 16) * 8, (t // 16) * 8, (t % 16) * 8 + 8, (t // 16) * 8 + 8))
+
+
+def building_palettes():
+    return lib2.palettes(BUILDING, 'gTileset_GenericBuilding2')[:7]
+
+
+def recolour_for(rc, pri, sec):
+    rc = rc or {}
+    return rc.get((pri, sec)) or rc.get(sec) or {}
+
+
+def palettes_for(pri, sec, rc):
+    pals = [list(p) for p in lib2.palettes(pri, sec)]
+    for slot, m in recolour_for(rc, pri, sec).items():
+        pals[slot] = m if isinstance(m, list) else [m.get(c, c) for c in pals[slot]]
+    return pals
+
+
+def entry_image(pri, sec, v, pals, layer):
+    """8x8 RGBA of one metatile entry; bottom layer opaque (as previewed), top keeps index 0 clear."""
+    t = v & 0x3FF; src = tile_image(pri, sec, t); pal = pals[v >> 12]
+    out = Image.new('RGBA', (8, 8))
+    for y in range(8):
+        for x in range(8):
+            sx = 7 - x if v & 0x400 else x; sy = 7 - y if v & 0x800 else y
+            i = src.getpixel((sx, sy))
+            if i == 0 and layer == 1:
+                continue
+            out.putpixel((x, y), q5(pal[i]) + (255,))
+    return out
+
+
+def quadrants(img):
+    img = img.convert('RGBA')
+    return [img.crop((qx, qy, qx + 8, qy + 8)) for qy in (0, 8) for qx in (0, 8)]
+
+
+def is_void(c):
+    return c[0] == 'custom' and c[1] == 'void'
+
+
+def room_cells(n):
+    """grid of cells as (pri, sec, mid, solid, kind) plus meta; draft-1 rooms use one pair."""
+    if n in DRAFT1:
+        g, sec = rooms1.ROOMS[n]()
+        cells = [[(BUILDING, sec, w & 0x3FF, bool((w >> 10) & 3), 'src') for w in row] for row in g]
+        return cells, None, dict(leader=META[n]['leader'], staff=META[n]['staff'], exit=META[n]['exit']), sec
+    g, rc, m = rooms2.ROOMS[n]()
+    cells = []
+    for row in g:
+        out = []
+        for c in row:
+            if is_void(c):
+                out.append((BUILDING, 'gTileset_GenericBuilding2', 0x008, True, 'src'))
+            elif c[0] == 'custom':
+                out.append(('custom', c[1], None, bool((c[2] >> 10) & 3), 'custom'))
+            else:
+                out.append((c[0], c[1], c[2] & 0x3FF, bool((c[2] >> 10) & 3), 'src'))
+        cells.append(out)
+    return cells, rc, m, None
+
+
+def cdist(a, b):
+    rm_ = (a[0] + b[0]) / 2
+    return (2 + rm_ / 256) * (a[0] - b[0]) ** 2 + 4 * (a[1] - b[1]) ** 2 + (2 + (255 - rm_) / 256) * (a[2] - b[2]) ** 2
+
+
+def nearest(c, pal):
+    return min(pal, key=lambda p: cdist(c, p))
+
+
+def tile_error(h, pal):
+    return sum(n * cdist(c, nearest(c, pal)) for c, n in h.items())
+
+
+def kmeans(weights, k):
+    """weighted k-means on RGB555 colours; exact when there are at most k colours."""
+    cols = sorted(weights, key=lambda c: -weights[c])
+    if len(cols) <= k:
+        return cols
+    centres = [tuple(map(float, c)) for c in cols[:k]]
+    for _ in range(12):
+        acc = [[0.0, 0.0, 0.0, 0.0] for _ in centres]
+        for c, w in weights.items():
+            i = min(range(len(centres)), key=lambda j: cdist(c, centres[j]))
+            a = acc[i]; a[0] += c[0] * w; a[1] += c[1] * w; a[2] += c[2] * w; a[3] += w
+        centres = [(a[0] / a[3], a[1] / a[3], a[2] / a[3]) if a[3] else centres[i] for i, a in enumerate(acc)]
+    # snap each centre to the most-used real colour in its cluster, so frequent colours stay exact
+    best = {}
+    for c, w in weights.items():
+        i = min(range(len(centres)), key=lambda j: cdist(c, centres[j]))
+        if i not in best or w > weights[best[i]]:
+            best[i] = c
+    out = []
+    for c in best.values():
+        if c not in out:
+            out.append(c)
+    return out
+
+
+def quantise(free, nslots=6):
+    """free: [(key, colour histogram, uses)] -> up to six palettes of <=15 colours."""
+    order = sorted(free, key=lambda t: -len(t[1]))
+    groups = []; members = []
+    for t in order:
+        s = set(t[1]); best = None
+        for i, gset in enumerate(groups):
+            u = len(gset | s)
+            score = (u <= 15, len(gset & s), -u)
+            if best is None or score > best[0]:
+                best = (score, i)
+        if best and best[0][0]:
+            groups[best[1]] |= s; members[best[1]].append(t)
+        elif len(groups) < nslots:
+            groups.append(set(s)); members.append([t])
+        else:
+            groups[best[1]] |= s; members[best[1]].append(t)
+    pals = [sorted(g) for g in groups]
+    for _ in range(6):
+        pals = []
+        for mem in members:
+            w = {}
+            for _, h, uses in mem:
+                for c, n in h.items():
+                    w[c] = w.get(c, 0) + n * uses
+            pals.append(sorted(kmeans(w, 15)) if w else [])
+        new = [[] for _ in pals]
+        for t in free:
+            i = min(range(len(pals)), key=lambda j: tile_error(t[1], pals[j]) if pals[j] else float('inf'))
+            new[i].append(t)
+        if [sorted(x[0] for x in m) for m in new] == [sorted(x[0] for x in m) for m in members]:
+            break
+        members = new
+    return pals
+
+
+class Packer:
+    """Metatile specs -> tiles, palettes, metatiles, attributes."""
+
+    def __init__(self, n, rc):
+        self.n = n; self.rc = rc
+        self.specs = []      # [entries(8), attr]; entry = ('direct', word) or ('img', RGBA)
+        self.index = {}      # spec key -> secondary metatile number
+
+    def add(self, key, entries, attr):
+        if key in self.index:
+            return 0x280 + self.index[key]
+        self.index[key] = len(self.specs); self.specs.append((entries, attr))
+        return 0x280 + self.index[key]
+
+    def build(self):
+        fixed = [[q5(c) for c in p] for p in building_palettes()]
+        fixed_sets = [set(p[1:]) for p in fixed]
+        imgs = []
+        for entries, _ in self.specs:
+            for e in entries:
+                if e[0] == 'img':
+                    imgs.append(e[1])
+        hist = {}
+        for im in imgs:
+            key = im.tobytes()
+            if key not in hist:
+                h = {}
+                for p in im.getdata():
+                    if p[3]:
+                        h[p[:3]] = h.get(p[:3], 0) + 1
+                hist[key] = [h, 0]
+            hist[key][1] += 1
+        free = [(k, h, w) for k, (h, w) in hist.items() if h and not any(set(h) <= f for f in fixed_sets)]
+        slots = quantise(free)
+        self.merged = sum(1 for _, h, _ in free for c in h if not any(c in sl for sl in slots))
+        while len(slots) < 6:
+            slots.append([])
+        tiles = []; tile_index = {}
+
+        def encode(im):
+            h = {}
+            for p in im.getdata():
+                if p[3]:
+                    h[p[:3]] = h.get(p[:3], 0) + 1
+            pal_no = None
+            for i, f in enumerate(fixed_sets):
+                if set(h) <= f:
+                    pal_no = i; lut = {}
+                    for idx, c in enumerate(fixed[i]):
+                        if idx and c not in lut:
+                            lut[c] = idx
+                    break
+            if pal_no is None:
+                best = min(range(6), key=lambda i: tile_error(h, slots[i]) if slots[i] else float('inf'))
+                pal_no = 7 + best; lut = {c: 1 + slots[best].index(nearest(c, slots[best])) for c in h}
+            px = tuple(lut[p[:3]] if p[3] else 0 for p in im.getdata())
+            for flags in (0, 1, 2, 3):
+                g = [px[y * 8:(y + 1) * 8] for y in range(8)]
+                if flags & 1: g = [r[::-1] for r in g]
+                if flags & 2: g = g[::-1]
+                form = tuple(v for r in g for v in r)
+                if form in tile_index:
+                    return (640 + tile_index[form]) | ((flags & 1) << 10) | ((flags >> 1) << 11) | (pal_no << 12)
+            if not any(px):
+                return pal_no << 12   # blank: primary tile 0
+            tile_index[px] = len(tiles); tiles.append(px)
+            return (640 + tile_index[px]) | (pal_no << 12)
+        metatiles = []; attrs = []
+        for entries, attr in self.specs:
+            for e in entries:
+                metatiles.append(e[1] if e[0] == 'direct' else encode(e[1]))
+            attrs.append(attr)
+        self.tiles = tiles; self.metatiles = metatiles; self.attrs = attrs; self.slots = slots
+        return self
+
+    def _pack(self, sets):
+        uniq = sorted(set(sets), key=len, reverse=True)
+        uniq = [s for s in uniq if not any(s < o for o in uniq)]
+        pals = []
+        for s in uniq:
+            best = None
+            for i, p in enumerate(pals):
+                u = len(p | s)
+                if u <= 15:
+                    score = (len(p & s), -u)
+                    if best is None or score > best[0]:
+                        best = (score, i)
+            if best:
+                pals[best[1]] |= s
+            elif len(pals) < 6:
+                pals.append(set(s))
+            else:
+                return None
+        return pals
+
+    @staticmethod
+    def _merge_closest(merge, pool, fixed_sets):
+        pool = sorted(pool)
+        best = None
+        for i, a in enumerate(pool):
+            for b in pool[i + 1:]:
+                rm_ = (a[0] + b[0]) / 2
+                d = (2 + rm_ / 256) * (a[0] - b[0]) ** 2 + 4 * (a[1] - b[1]) ** 2 + (2 + (255 - rm_) / 256) * (a[2] - b[2]) ** 2
+                if best is None or d < best[0]:
+                    best = (d, a, b)
+        _, a, b = best
+        keep, drop = (a, b) if any(a in f for f in fixed_sets) or not any(b in f for f in fixed_sets) else (b, a)
+        for k, v in list(merge.items()):
+            if v == drop:
+                merge[k] = keep
+        merge[drop] = keep
+
+
+def compile_room(n):
+    cells, rc, m, sec = room_cells(n)
+    H = len(cells); W = len(cells[0])
+    ex = m['exit']
+    if sec:  # draft 1: original pair
+        words = []
+        for y, row in enumerate(cells):
+            for x, (pri, s, mid, solid, _) in enumerate(row):
+                words.append(mid | (SOLID if solid else FLOOR_ELEVATION))
+        exit_attr = attribute(BUILDING, sec, cells[ex[1]][ex[0]][2])
+        assert exit_attr & 0x1FF == MB_SOUTH_ARROW_WARP, (n, hex(exit_attr))
+        return dict(n=n, W=W, H=H, words=words, primary=BUILDING, secondary=sec, packer=None, meta=m)
+    pk = Packer(n, rc)
+    words = []
+    for y, row in enumerate(cells):
+        for x, (pri, s, mid, solid, kind) in enumerate(row):
+            is_exit = (x, y) == tuple(ex)
+            if kind == 'custom':
+                img = lib2.CUSTOM[mid if mid else s] if False else lib2.CUSTOM[s]
+                ents = [('img', q) for q in quadrants(img)] + [('direct', 0)] * 4
+                attr = LAYER_COVERED | (MB_SOUTH_ARROW_WARP if is_exit else 0)
+                key = ('custom', img.convert('RGBA').tobytes(), attr)
+                mt = pk.add(key, ents, attr)
+            else:
+                pals = palettes_for(pri, s, rc)
+                recoloured = set(recolour_for(rc, pri, s))
+                v8 = lib2.mwords(pri, s, mid)
+                attr = attribute(pri, s, mid)
+                if is_exit and attr & 0x1FF != MB_SOUTH_ARROW_WARP:
+                    attr = (attr & ~0x1FF) | MB_SOUTH_ARROW_WARP
+                direct = [pri == BUILDING and (v & 0x3FF) < 640 and (v >> 12) < 7 and (v >> 12) not in recoloured for v in v8]
+                if pri == BUILDING and mid < 640 and all(direct) and attr == attribute(pri, s, mid):
+                    mt = mid
+                else:
+                    ents = [('direct', v) if d else ('img', entry_image(pri, s, v, pals, i // 4)) for i, (v, d) in enumerate(zip(v8, direct))]
+                    key = ('src', pri, s, mid, repr(sorted((k, repr(v)) for k, v in recolour_for(rc, pri, s).items())), attr)
+                    mt = pk.add(key, ents, attr)
+            words.append(mt | (SOLID if solid else FLOOR_ELEVATION))
+    pk.build()
+    assert len(pk.tiles) <= 384 and len(pk.specs) <= 384, (n, len(pk.tiles), len(pk.specs))
+    return dict(n=n, W=W, H=H, words=words, primary=BUILDING, secondary=tileset_label(n), packer=pk, meta=m)
+
+
+def jasc(colours):
+    lines = ['JASC-PAL', '0100', '16'] + ['%d %d %d' % c for c in colours]
+    return '\r\n'.join(lines) + '\r\n'
+
+
+def render_check(res):
+    """Render the compiled room from the written words/tiles to prove the encoding."""
+    pk = res['packer']
+    bpal = [[q5(c) for c in p] for p in building_palettes()]
+    allpal = bpal + [[(0, 0, 0)] + s + [(0, 0, 0)] * (15 - len(s)) for s in pk.slots]
+    btiles = Image.open(rm.tileset_paths(NATIVE, BUILDING)['tiles'])
+    bmeta = rm.words(rm.tileset_paths(NATIVE, BUILDING)['metatiles'])
+    def tile_px(t):
+        if t < 640:
+            return list(btiles.crop(((t % 16) * 8, (t // 16) * 8, (t % 16) * 8 + 8, (t // 16) * 8 + 8)).getdata())
+        return list(pk.tiles[t - 640])
+    out = Image.new('RGB', (res['W'] * 16, res['H'] * 16))
+    for i, w in enumerate(res['words']):
+        mid = w & 0x3FF; x0 = (i % res['W']) * 16; y0 = (i // res['W']) * 16
+        ents = bmeta[mid * 8:mid * 8 + 8] if mid < 640 else pk.metatiles[(mid - 640) * 8:(mid - 640) * 8 + 8]
+        for layer in range(2):
+            for qd in range(4):
+                v = ents[layer * 4 + qd]; px = tile_px(v & 0x3FF); pal = allpal[v >> 12]
+                for yy in range(8):
+                    for xx in range(8):
+                        sx = 7 - xx if v & 0x400 else xx; sy = 7 - yy if v & 0x800 else yy
+                        k = px[sy * 8 + sx]
+                        if k or layer == 0:
+                            out.putpixel((x0 + qd % 2 * 8 + xx, y0 + qd // 2 * 8 + yy), pal[k])
+    return out
+
+
+def write(res, root=NATIVE):
+    n = res['n']
+    ld = root / 'data/layouts' / layout_dir(n); ld.mkdir(parents=True, exist_ok=True)
+    (ld / 'map.bin').write_bytes(struct.pack('<%dH' % len(res['words']), *res['words']))
+    (ld / 'border.bin').write_bytes(struct.pack('<4H', *(0x0008,) * 4))
+    pk = res['packer']
+    if pk:
+        td = root / tileset_dir(n); (td / 'palettes').mkdir(parents=True, exist_ok=True)
+        rows = max(1, -(-len(pk.tiles) // 16))
+        im = Image.new('P', (128, rows * 8), 0)
+        im.putpalette(sum(([i * 17] * 3 for i in range(16)), []) + [0] * (256 - 16) * 3)
+        for i, px in enumerate(pk.tiles):
+            for k, v in enumerate(px):
+                im.putpixel(((i % 16) * 8 + k % 8, (i // 16) * 8 + k // 8), v)
+        im.save(td / 'tiles.png')
+        for p in range(16):
+            cols = [(0, 0, 0)] * 16
+            if 7 <= p < 13:
+                s = pk.slots[p - 7]
+                cols = [(0, 0, 0)] + list(s) + [(0, 0, 0)] * (15 - len(s))
+            (td / 'palettes' / f'{p:02}.pal').write_bytes(jasc(cols).encode())
+        (td / 'metatiles.bin').write_bytes(struct.pack('<%dH' % len(pk.metatiles), *pk.metatiles))
+        (td / 'metatile_attributes.bin').write_bytes(struct.pack('<%dI' % len(pk.attrs), *pk.attrs))
+
+
+if __name__ == '__main__':
+    names = sys.argv[1:] or list(GYMS)
+    for n in names:
+        res = compile_room(n)
+        pk = res['packer']
+        print(n, res['W'], 'x', res['H'], res['secondary'],
+              '' if not pk else f"tiles {len(pk.tiles)} metatiles {len(pk.specs)} slots {[len(s) for s in pk.slots]} merged {pk.merged}")
+        if pk:
+            render_check(res).save(S / f'compiled-{n}.png')
diff --git a/tools/taichung/gym_interiors/install_gyms.py b/tools/taichung/gym_interiors/install_gyms.py
