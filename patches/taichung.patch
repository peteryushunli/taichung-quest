+++ b/tools/taichung/landmarks/compile_cmp.py
@@ -0,0 +1,328 @@
+#!/usr/bin/env python3
+"""Build CMP's private Greenway banks and map proposal in NEW paths only.
+
+Frozen 38c6172 retains e9's registered geometry/banks. This compiler never edits
+registered maps, layouts, C, old banks, saves or old Greenway evidence. Root owns
+registration, conditional primary loading, independent checks and native QA.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+from check_old_core import Files, Bank, resolved_folder, load_native
+from analyze_theater_cohort import visible_cells, bounds
+
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "38c617288cb4a5220c75e914d916054b1530d9f9"
+GEOMETRY_BASE = "e9a854b969ae3c3bd72a437bd405b4bcdd8c9496"
+OLD_PRIMARY = "data/tilesets/primary/taichung_old_core"
+OLD_SECONDARY = "data/tilesets/secondary/taichung_greenway"
+PRIMARY = "data/tilesets/primary/taichung_greenway_private"
+SECONDARY = "data/tilesets/secondary/taichung_greenway_cmp"
+DATA = "data/taichung/landmarks/cmp-native"
+PRIMARY_LABEL = "gTileset_TaichungGreenwayPrivate"
+SECONDARY_LABEL = "gTileset_TaichungGreenwayCmp"
+MID = "MAP_TAICHUNG_GREENWAY"
+INPUT = "data/taichung/landmarks/calligraphy-greenway/candidate/candidate-indexed.png"
+APPROVAL = "data/taichung/landmarks/calligraphy-greenway/generation.json"
+ENCODING = "data/taichung/landmarks/calligraphy-greenway/candidate/encode-manifest.json"
+ORIGIN, SIZE, DOOR, RETIRED = (18, 27), (9, 10), (22, 36), (17, 30, 27, 36)
+PALETTE = 8
+SPARE_PALETTE_INDICES = {8, 9, 10, 11, 12, 14, 15}
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(pixels):
+    return min((tuple(pixels[(7-y if flags & 0x800 else y)*8 + (7-x if flags & 0x400 else x)]
+                      for y in range(8) for x in range(8)), flags) for flags in (0, 0x400, 0x800, 0xC00))
+
+
+def save_words(path, values, kind="H"):
+    path.write_bytes(struct.pack(f"<{len(values)}{kind}", *values))
+
+
+def crlf(raw):
+    return raw.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+
+
+def save_palette(path, colors):
