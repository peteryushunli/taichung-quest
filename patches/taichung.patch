index 00000000..3058f873
--- /dev/null
+++ b/tools/taichung/boulevard_city/export_named_xitun_hd_anchors.py
@@ -0,0 +1,51 @@
+"""Read-only tower/ref coverage handoff; Main owns pack assembly/publication."""
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+import sys
+
+import numpy as np
+from PIL import Image
+
+game,web,qa=map(Path,sys.argv[1:])
+spec=importlib.util.spec_from_file_location('verified_hd_world',web/'scripts/hd-world.py')
+hd=importlib.util.module_from_spec(spec);spec.loader.exec_module(hd)
+pack=json.loads((web/'web/public/hd/world/pack.json').read_text())
+report=json.loads((qa/'towers/build-report.json').read_text())
+byname={m['name']:m for m in report['maps']}
+maps={name:json.loads((game/'data/maps'/name/'map.json').read_text()) for name in byname}
+layouts=hd.Layouts(str(game));reader=hd.Streamed(str(game))
+output=qa/'fresh-hd-references';output.mkdir(exist_ok=True)
+changed=[];coverage=[]
+for key,entry in pack['maps'].items():
+    if entry['name'] not in byname:continue
+    m=byname[entry['name']];x0,y0,_,_=m['worldRect']
+    grid,_=hd.streamed_grid(str(game),layouts,maps,entry['name'])
+    ref=hd.render_fn(grid,reader.metatiles(m['number']))
+    old=Image.open(web/'web/public/hd/world'/entry['ref']).convert('RGB')
+    delta=(np.asarray(ref)!=np.asarray(old)).any(axis=2)
+    if delta.any():
+        ys,xs=np.nonzero(delta)
+        assert all(75<=int(x)//16+x0-entry['margin']<95 and 113<=int(y)//16+y0-entry['margin']<126 for x,y in zip(xs,ys)),key
+        ref.save(output/(key+'.png'),optimize=True)
+        changed.append(dict(nativeKey=key,name=entry['name'],changedPixels=int(delta.sum()),
+                            changedReferencePixelBounds=[int(xs.min()),int(ys.min()),int(xs.max()+1),int(ys.max()+1)],
+                            freshReferenceSha256=hashlib.sha256((output/(key+'.png')).read_bytes()).hexdigest()))
+    for tower in report['xitunTowerBlock']['buildings']:
+        name=tower['id'];a,b,c,d=tower['worldRect']
+        px,py=(a-x0+entry['margin'])*16,(b-y0+entry['margin'])*16
+        width,height=(c-a)*16,(d-b)*16
+        clip=[max(0,px),max(0,py),min(ref.width,px+width),min(ref.height,py+height)]
+        if clip[0]>=clip[2] or clip[1]>=clip[3]:continue
+        coverage.append(dict(nativeKey=key,sprite=name,worldRect=tower['worldRect'],
+                             fullReferencePixelEnvelope=[px,py,width,height],visibleReferencePixelRect=clip,
+                             visibleSpritePixelRect=[clip[0]-px,clip[1]-py,clip[2]-px,clip[3]-py],
+                             fullSpriteFitsReference=clip==[px,py,px+width,py+height],
+                             note='Derived from this new compiled placement and reference margin; do not reuse old manual positions/masks'))
+result=dict(changedReferences=changed,perReferenceTowerCoverage=coverage,
+            source='Current compiled native data rendered by verified web HD reader; reference files only, no pack writes',
+            fullEntryPolicy='Existing pack has manual complete tower entries on43.36. Partial seam views are explicitly inventoried; Main decides clip-aware HD coverage.',
+            oldManualCoordinatesReusable=False,approvedPictureBytesChanged=False)
+(qa/'tower-hd-handoff.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps({'changedReferences':changed,'coverageEntries':len(coverage)},indent=2))
