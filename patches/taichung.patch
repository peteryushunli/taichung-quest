+"""Night-market pieces in FireRed's manner: RGB555 colours, dark outline, top-left light."""
+from PIL import Image, ImageDraw
+import random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((32,32,48))
+# night asphalt + kerb-less paving
+N0,N1,N2,N3=q((72,72,92)),q((62,62,80)),q((84,84,104)),q((52,52,68))
+GL0,GL1=q((112,100,92)),q((96,88,88))           # warm light spilled from stalls
+BULB,BULB2=q((255,244,176)),q((248,208,96))
+WD0,WD1,WD2=q((184,136,80)),q((152,104,56)),q((104,68,36))
+MT0,MT1,MT2=q((208,212,220)),q((164,168,180)),q((116,120,132))
+WH0,WH1=q((244,240,228)),q((204,200,192))
