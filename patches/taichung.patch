+#!/usr/bin/env python3
+"""Installable OldCity scene compiler: protected General slots plus shared art.
+
+Writes only the assigned feature checkout. Global General/Pewter stay immutable.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+from PIL import Image
+
+ROOT=Path(__file__).resolve().parents[3]
+sys.dont_write_bytecode=True
+sys.path.insert(0,str(ROOT/'tools/taichung/streetscape'))
+from color_compile import compile_colorways
+
+DATA=ROOT/'data/taichung/landmarks/old-core-native'
+PRIMARY=ROOT/'data/tilesets/primary/taichung_old_core'
+SECONDARY=ROOT/'data/tilesets/secondary/taichung_old_core'
+GENERAL=ROOT/'data/tilesets/primary/general'
+PEWTER=ROOT/'data/tilesets/secondary/pewter_city'
+
+
+def words(path,kind='H'):
+    raw=path.read_bytes();return list(struct.unpack(f'<{len(raw)//struct.calcsize(kind)}{kind}',raw))
+
+
+def write_words(path,values,kind='H'):
+    path.write_bytes(struct.pack(f'<{len(values)}{kind}',*values))
+
+
+def flip(p,f):
+    return tuple(p[(7-y if f&0x800 else y)*8+(7-x if f&0x400 else x)] for y in range(8) for x in range(8))
+
+
+def pixels(image,n):
+    x,y=n%(image.width//8)*8,n//(image.width//8)*8
+    return tuple(image.getpixel((x+dx,y+dy)) for dy in range(8) for dx in range(8))
+
+
+def canonical(p):
+    return min((flip(p,f),f) for f in (0,0x400,0x800,0xc00))
+
+
+class Scene:
+    def __init__(self,audit):
+        self.original=Image.open(GENERAL/'tiles.png')
+        self.primary=self.original.copy()
+        free=audit['primaryConservativeRawHoleOption']['freeRawGraphicIds']
+        self.free=iter(free)
+        self.reserved=set(range(640))-set(free)
+        self.lookup={};self.secondary=[];self.allocated=[]
+        animated=set(range(416,482))|set(range(508,512))
+        for n in sorted(self.reserved-animated):
+            p,f=canonical(pixels(self.original,n))
+            self.lookup.setdefault(p,(n,f))
+
+    def pack(self,p):
+        p,f=canonical(p)
+        if p not in self.lookup:
+            n=next(self.free,None)
+            if n is None:
+                if len(self.secondary)>=376:raise ValueError('Scene graphics exhausted')
+                n=640+len(self.secondary);self.secondary.append(p)
+            else:
+                for y in range(8):
+                    for x in range(8):self.primary.putpixel((n%16*8+x,n//16*8+y),p[y*8+x])
+            self.lookup[p]=(n,0);self.allocated.append(n)
+        n,stored=self.lookup[p]
+        assert n<1016
+        return n|(stored^f)
+
+
+def compile_scene(infill=False):
+    DATA.mkdir(parents=True,exist_ok=True)
+    audit=json.loads((ROOT/'data/taichung/landmarks/old-core-bank-audit.json').read_text())
+    scene=Scene(audit)
+    kit=compile_colorways(variant_metatile_start=815)
+    definitions=[]
+    for group in kit['metatiles']:
+        row=[]
+        for e in group:
+            n=e&1023
+            row.append(e if n<640 else (e&0xf000)|((e&0xc00)^scene.pack(kit['graphics'][n-640])))
+        definitions.append(row)
+    attrs=kit['attributes'][:]
+    # Keep the legacy civic definitions used in any connected baseline scene,
+    # including the two stair/door-surround definitions outside the prefab kit.
+    retained=json.loads((ROOT/'data/taichung/landmarks/old-station/native-source-contract.json').read_text())['preservedSourceMetatiles']
+    original_defs=words(PEWTER/'metatiles.bin');original_attrs=words(PEWTER/'metatile_attributes.bin','I')
+    original_sheet=Image.open(PEWTER/'tiles.png')
