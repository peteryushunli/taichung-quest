+
+# The registered Nantun increment adds districts, connections and neighbour seam
+# cells. Its own guard proves them on the actual tree; this guard checks the state
+# underneath, with exactly that delta removed from the shared files.
+NANTUN_GUARD = "tools/taichung/nantun/check_nantun.py"
