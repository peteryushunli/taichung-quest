+    from io import BytesIO
+    from PIL import Image
+    xitun, greenway, oldcore = install.PRIMARIES
+
+    def png_with(folder, n, value):
+        image = Image.open(BytesIO(read(f"{folder}/tiles.png")))
+        image.load()
+        x, y = n % 16 * 8, n // 16 * 8
+        image.putpixel((x, y), value if image.getpixel((x, y)) != value else (value + 1) % 16)
+        out = BytesIO()
+        image.save(out, format="PNG", optimize=False)
+        return out.getvalue()
+
+    def word_with(path, index, kind, xor):
+        size = struct.calcsize(kind)
+        data = bytearray(read(path))
+        value = struct.unpack_from(f"<{kind}", data, index * size)[0] ^ xor
+        struct.pack_into(f"<{kind}", data, index * size, value)
+        return bytes(data)
+
+    def drawn(path, index, word):
+        data = bytearray(read(path))
+        struct.pack_into("<H", data, index * 2, word)
+        return bytes(data)
+
+    def everywhere(name, index, kind, xor):
+        return {f"{f}/{name}": word_with(f"{f}/{name}", index, kind, xor) for f in install.PRIMARIES}
+
+    kit = json.loads(read(install.CONTRACT))
+    a, b = list(kit["metatiles"])[:2]
+    kit["metatiles"][a], kit["metatiles"][b] = kit["metatiles"][b], kit["metatiles"][a]
+    palette = read(f"{greenway}/palettes/02.pal").replace(b"246 246 255", b"246 246 254", 1)
+    xitun_map = word_with("data/layouts/TaichungXitun/map.bin", 100, "H", 0x001)
