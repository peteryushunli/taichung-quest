diff --git a/tools/taichung/tile_limit_probe/packing.py b/tools/taichung/tile_limit_probe/packing.py
new file mode 100644
index 00000000..c995475c
--- /dev/null
+++ b/tools/taichung/tile_limit_probe/packing.py
@@ -0,0 +1,109 @@
+"""Shared RGB555 palette packing and 8×8 tile helpers for Boulevard maps."""
+
+def c15(rgb):
+    return (rgb[0] >> 3) | ((rgb[1] >> 3) << 5) | ((rgb[2] >> 3) << 10)
+def c24(c):
+    return tuple(((c >> s) & 31) << 3 | ((c >> s) & 31) >> 2 for s in (0, 5, 10))
+
+def cells8(im):
+    """8x8 tiles of an RGBA image as lists of 64 (colour or None)."""
+    px = im.load(); out = {}
+    for ty in range(im.height // 8):
+        for tx in range(im.width // 8):
+            t = []
+            for y in range(8):
+                for x in range(8):
+                    r, g, b, a = px[tx * 8 + x, ty * 8 + y]
+                    t.append(c15((r, g, b)) if a >= 128 else None)
+            out[(tx, ty)] = t
+    return out
+
+# ---------------------------------------------------------------- palettes
+# Share colours across related assets in the busiest views. The source sprites
+# are unchanged, and the rest of the art uses the lossless palette packing.
+# The tree, plant and street colours are source colours picked to keep each
+# design closest to its own art in CIELAB (each design weighs the same), so
+# grey stays grey and the reds, pinks and yellows keep their hue. The small
+# plants take two palettes; the busiest camera views still fit 13 slots.
+shared_art_palettes = (
+    (('camphor', 'grove-tree'),
+     '182929 214231 294a31 426339 4a5242 4a7342 5a3931 5a7b42 '
+     '738c4a 849c42 8ca56b 948c7b a5bd63 ad7352 b5bd42'),
+    (('courtyard-tree', 'fern-stone', 'meadow-tuft', 'wild-grass'),
+     '315229 426331 4a5a18 5a7b39 637321 637b8c 6b4a31 6b9439 '
+     '738c18 84a542 8c9c29 9ca5b5 9cbd4a adbd29 bdd663'),
+    (('flower-shrub', 'bank-reeds', 'pond-lilies'),
+     '182118 213918 313121 395221 426b4a 526b29 735a39 738463 '
+     '7b9463 849431 bd8431 bda539 ce735a d65a52 d6949c'),
+    (('glass-midrise', 'terrace-midrise'),
+     '182029 243137 394141 4a524a 65534d 616e66 5b8272 788575 '
+     '958c80 a58f78 debda4 c9a280 ccb9ac e6cfb5 eee0c8'),
+    (('apartment-door-planters', 'burgundy-parked-scooter', 'concrete-bench',
+      'crates-and-pavement-sign', 'cream-delivery-scooter', 'mailbox-and-watering-can',
+      'mint-step-through', 'orange-stools-and-table', 'parked-scooter-pair',
+      'planted-concrete-trough', 'red-snack-cart', 'steel-breakfast-cart',
+      'teal-traffic-bench', 'umbrella-tea-cart', 'utility-box-and-plant', 'wood-park-bench'),
+     '181810 313129 396352 5a5a52 5a7339 5a8c7b 7b7363 844242 '
+     '94bdad ad734a ada594 d66b42 d68c42 d69c6b e7d6bd'),
+)
+
+def distance(a, b):
+    return sum(weight * ((a >> shift & 31) - (b >> shift & 31)) ** 2
+               for weight, shift in ((2, 0), (4, 5), (1, 10)))
+
+def remap_tiles(cells, colors):
+    opaque = {c for tile in cells.values() for c in tile if c is not None}
+    closest = {c: min(colors, key=lambda target: (distance(c, target), target)) for c in opaque}
+    closest[None] = None
+    return {position: [closest[c] for c in tile] for position, tile in cells.items()}
+
+def flips(t):
+    rows = [t[i * 8:i * 8 + 8] for i in range(8)]
+    h = [v for r in rows for v in reversed(r)]
+    v = [x for r in reversed(rows) for x in r]
+    hv = [x for r in reversed(rows) for x in reversed(r)]
+    return (tuple(t), 0), (tuple(h), 1), (tuple(v), 2), (tuple(hv), 3)
+
+def assign_palettes(sprites, extra_cells):
+    # Pack the original art first so assigning a shared palette to plants
+    # cannot reshuffle the lossless palettes already used by nearby buildings.
+    items = []   # (key, colour set)
+    for name, (im, cells) in sprites.items():
+        cols = {c for t in cells.values() for c in t if c is not None}
+        assert len(cols) <= 15, (name, len(cols))
+        items.append((('sprite', name), cols))
+    bins, where = [], {}
+    for key, cols in sorted(items, key=lambda kv: (-len(kv[1]), str(kv[0]))):
+        for i, b in enumerate(bins):
+            if len(b | cols) <= 15:
+                b |= cols; where[key] = i; break
+        else:
+            bins.append(set(cols)); where[key] = len(bins) - 1
+    for names, rgb in shared_art_palettes:
+        colors = {c15(bytes.fromhex(word)) for word in rgb.split()}
+        assert len(colors) == 15, names
+        for name in names:
+            if name not in sprites:
+                continue
+            im, cells = sprites[name]
+            sprites[name] = (im, remap_tiles(cells, colors))
+            where['sprite', name] = len(bins)
+        bins.append(colors)
+    # The four quarters of an extra ground cell must not each claim a palette.
+    # Use the main ground shades for the custom road, curb and pond variants.
+    ground_colors = {
+        c15(bytes.fromhex(word)) for word in (
+            '203038 404868 585870 787880 90a0b0 a8b8c8 c8d8e8 e0e8f8 '
+            '70c8a0 40b088 68a0e0 3060a0 e8e088 784848 c85048'
+        ).split()
+    }
+    assert len(ground_colors) == 15
+    extra_cells = remap_tiles(extra_cells, ground_colors)
+    for x, y in extra_cells:
+        where['extra', x, y] = len(bins)
+    bins.append(ground_colors)
+    kept = sorted(set(where.values()))
+    remap = {old: new for new, old in enumerate(kept)}
+    where = {key: remap[index] for key, index in where.items()}
+    palettes = [sorted(bins[index]) for index in kept]
+    return palettes, where, extra_cells
