+#!/usr/bin/env python3
+"""Serve private native gameplay QA on loopback, using the mapping QA template.
+
+Example: qa_server.py --rom fixed.gba --runtime web/public/emulator --port 8790
+  [--save fixture.sav] [--navigation-address 0x0203abc0]
+Use /?qaSave=distinct-run-name to isolate named native saves. A supplied fixture
+is explicitly imported into that selected save file before loading the ROM;
+choose native Continue to verify it. No emulator snapshot or RAM patch is used.
+The private travel action uses normal directional input and read-only native
+navigation frames; it never changes emulator speed or writes navigation RAM.
+Optional raw movement inspection requires all three exact-ROM ELF addresses:
+--sprites-address, --player-avatar-address, --object-events-address. The source
+ABI is Sprite 0x44 bytes (pos1 0x20, pos2 0x24, data 0x2E), PlayerAvatar 0x20
+bytes and ObjectEvent 0x24 bytes, from include/sprite.h/global.fieldmap.h.
+"""
+
+import argparse
+import hashlib
+import html
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+from pathlib import Path
+from urllib.parse import urlsplit
+
+
+NAVIGATION_JS = r"""
+  let qaNavigationCache;
+  let qaNavigationBusy = false;
+  function resetNavigationCache() { qaNavigationCache = undefined; }
+  const navFlagNames = ['READY', 'FIELD', 'POSITION_VALID', 'OUTDOOR', 'INDOOR', 'CYCLING', 'CAN_TOGGLE_BIKE'];
+  const navContextNames = ['CALLBACKS_SKIPPED', 'NOT_FIELD', 'BATTLE', 'TRANSITION', 'SCRIPT', 'DIALOGUE', 'LINK', 'REPLAY', 'INVALID_SAVE', 'INVALID_AVATAR', 'INVALID_POSITION', 'INVALID_MAP'];
+  const hex = value => `0x${value.toString(16).padStart(8, '0')}`;
+  function navigationHeap() {
+    const heap = emulator?.getTaichungHeapU8?.();
+    if (!heap || !(heap.buffer instanceof SharedArrayBuffer) || heap.byteOffset !== 0 || heap.byteLength % 4) {
+      throw new Error('The pinned runtime getTaichungHeapU8() shared heap is unavailable. No fallback RAM access is used.');
+    }
+    return heap;
+  }
+  function readNavigationAt(heap, offset) {
+    if (offset < 0 || offset % 4 || offset + 48 > heap.byteLength) return;
+    const words = new Uint32Array(heap.buffer, 0, heap.byteLength / 4);
+    const base = offset / 4;
+    for (let attempt = 0; attempt < 3; attempt++) {
+      const sequence = Atomics.load(words, base + 4);
+      if (!sequence || sequence & 1) continue;
+      const copy = new Uint8Array(48);
+      const copiedWords = new Uint32Array(copy.buffer);
+      for (let index = 0; index < 12; index++) copiedWords[index] = Atomics.load(words, base + index);
+      if (sequence !== copiedWords[4] || sequence !== Atomics.load(words, base + 4)) continue;
+      const view = new DataView(copy.buffer);
+      const address = copiedWords[3];
+      if (copiedWords[0] !== 0x414e4354 || copiedWords[1] !== 0x31303056 || copiedWords[2] !== 0x00300001
+          || address < 0x02000000 || address > 0x02040000 - 48 || address % 4
+          || (qaConfig.navigationAddress !== null && address !== qaConfig.navigationAddress)
+          || copiedWords[5] === 0 || view.getUint16(42, true) !== 0 || copiedWords[11] !== 0) return;
+      const flags = copiedWords[6];
+      const contextFlags = view.getUint16(40, true);
+      const packet = {
+        magic: 'TCNAV001', version: 1, size: 48, selfGbaAddress: hex(address), sequence,
+        frameCounter: copiedWords[5], flags, flagNames: navFlagNames.filter((_, bit) => flags & (1 << bit)),
+        localX: view.getInt16(28, true), localY: view.getInt16(30, true),
+        mapGroup: copy[32], mapNum: copy[33], facing: copy[34], mapType: copy[35],
+        mapWidth: view.getUint16(36, true), mapHeight: view.getUint16(38, true),
+        contextFlags, contextNames: navContextNames.filter((_, bit) => contextFlags & (1 << bit)),
+        reserved16: view.getUint16(42, true), reserved32: copiedWords[11],
+      };
+      if (flags & ~0x7f || contextFlags & ~0x0fff) return;
+      if (flags & 4) {
+        const scope = flags & 24;
+        if ((flags & 3) !== 3 || contextFlags || ![8, 16].includes(scope)
+            || packet.facing < 1 || packet.facing > 4 || packet.mapGroup === 255 || packet.mapNum === 255
+            || !packet.mapWidth || !packet.mapHeight || packet.localX < 0 || packet.localY < 0
+            || packet.localX >= packet.mapWidth || packet.localY >= packet.mapHeight) return;
+      } else if (packet.localX !== -1 || packet.localY !== -1 || packet.mapGroup !== 255 || packet.mapNum !== 255
+                 || packet.mapWidth || packet.mapHeight || packet.facing || packet.mapType) return;
+      return packet;
+    }
+  }
+  async function scanNavigation(heap) {
+    const words = new Uint32Array(heap.buffer, 0, heap.byteLength / 4);
+    const candidates = [];
+    const chunkWords = 512 * 1024;
+    for (let start = 0; start <= words.length - 12; start += chunkWords) {
+      const end = Math.min(start + chunkWords, words.length - 11);
+      for (let index = start; index < end; index++) {
+        if (words[index] !== 0x414e4354) continue;
+        const packet = readNavigationAt(heap, index * 4);
+        if (packet) candidates.push({ offset: index * 4, packet });
+        if (candidates.length > 64) throw new Error('Too many navigation candidates; refusing to choose.');
+      }
+      if (end < words.length - 11) await wait(0);
+    }
+    return candidates;
+  }
+  async function navigationSnapshot() {
+    const heap = navigationHeap();
+    let candidates;
+    if (qaNavigationCache?.buffer === heap.buffer && qaNavigationCache.length === heap.byteLength) {
+      const packet = readNavigationAt(heap, qaNavigationCache.offset);
+      if (packet) candidates = [{ offset: qaNavigationCache.offset, packet }];
+    }
+    if (!candidates) {
+      resetNavigationCache();
+      byId('navigation').textContent = 'Scanning the actual shared runtime heap in yielding 2 MiB chunks…';
+      candidates = await scanNavigation(heap);
+    }
+    await wait(120);
+    const currentHeap = navigationHeap();
+    if (currentHeap.buffer !== heap.buffer || currentHeap.byteLength !== heap.byteLength) {
+      resetNavigationCache();
+      throw new Error('Runtime heap changed during the read; try again.');
+    }
+    const advancing = candidates.flatMap(candidate => {
+      const packet = readNavigationAt(currentHeap, candidate.offset);
+      return packet && packet.frameCounter !== candidate.packet.frameCounter && packet.sequence !== candidate.packet.sequence
+        ? [{ offset: candidate.offset, packet }] : [];
+    });
+    if (advancing.length > 1) {
+      resetNavigationCache();
+      throw new Error('Multiple advancing navigation packets; refusing to choose.');
+    }
+    if (!advancing.length) {
+      resetNavigationCache();
+      return {
+        phase: candidates.length ? 'stale-or-paused' : 'unavailable', live: false,
+        reason: candidates.length ? 'No coherent candidate advanced during the 120 ms liveness probe.' : 'No compatible coherent TCNAV001 packet found in this exact runtime/ROM.',
+        coherentCandidateCount: candidates.length,
+        ...(candidates.length === 1 ? { packet: candidates[0].packet } : {}),
+      };
+    }
+    const selected = advancing[0];
+    qaNavigationCache = { buffer: heap.buffer, length: heap.byteLength, offset: selected.offset };
+    const visible = (selected.packet.flags & 7) === 7 && selected.packet.contextFlags === 0;
+    return {
+      phase: visible ? 'live-field' : 'hidden-context', live: true, validForMinimap: visible,
+      romSha256: qaConfig.rom.sha256, heapOffset: hex(selected.offset),
+      addressSource: qaConfig.navigationAddress === null ? 'discovered-native-header' : 'explicit-test-server-option',
+      freshness: 'Coherent sequence and frame both advanced during a 120 ms read-only probe.',
+      coordinateUnits: 'Zero-based destination metatiles (16 game pixels); indoor coordinates require an explicit parent mapping.',
+      packet: selected.packet,
+    };
+  }
+  byId('read-navigation').addEventListener('click', async () => {
+    if (!emulator || qaNavigationBusy) return;
+    qaNavigationBusy = true;
+    byId('read-navigation').disabled = true;
+    try {
+      byId('navigation').textContent = JSON.stringify(await navigationSnapshot(), null, 2);
+    } catch (error) {
+      resetNavigationCache();
+      byId('navigation').textContent = JSON.stringify({ phase: 'unavailable', live: false, error: error.message }, null, 2);
+    } finally {
+      qaNavigationBusy = false;
+      byId('read-navigation').disabled = false;
+    }
+  });
+"""
+
+MOVEMENT_JS = r"""
+  const movementLimits = [16, 8, 6, 4, 2, 3];
+  const movementCaveat = 'Private observational raw reads: two equal copies bracketed by one published navigation sequence. Navigation does not lock raw engine writes. Polling can miss phases; cursor 3 is valid after the three-frame step completes, reset 0 occurs inside initialization, and the first published phase is normally cursor 1. No atomic phase-proof claim is made.';
+  function readMovementState(expectedPacket) {
+    if (!qaConfig.movementInspection) return { available: false, reason: 'Exact-ROM movement symbol addresses were not supplied.' };
+    const heap = navigationHeap();
+    const cache = qaNavigationCache;
+    if (heap.buffer !== cache?.buffer || heap.byteLength !== cache.length) return { available: false, reason: 'Navigation allocation changed.' };
+    const words = new Uint32Array(heap.buffer);
+    const addresses = qaConfig.movementInspection;
+    function copy(address, length, base) {
+      const offset = base + address - 0x02000000;
+      if (offset < 0 || offset % 4 || offset + length > heap.byteLength) throw new Error('Raw movement address lies outside the verified EWRAM allocation.');
+      const bytes = new Uint8Array(length), target = new Uint32Array(bytes.buffer);
+      for (let index = 0; index < length / 4; index++) target[index] = Atomics.load(words, offset / 4 + index);
+      return bytes;
+    }
+    const equal = (left, right) => left.length === right.length && left.every((value, index) => value === right[index]);
+    for (let attempt = 0; attempt < 3; attempt++) {
+      const before = readNavigationAt(heap, cache.offset);
+      if (!before || (before.flags & 7) !== 7 || before.contextFlags) return { available: false, reason: 'Unlocked live field position required.' };
+      if (expectedPacket && (before.sequence !== expectedPacket.sequence || before.frameCounter !== expectedPacket.frameCounter)) {
+        return { available: false, reason: 'Navigation advanced before the raw frame copy.' };
+      }
+      const ewramBase = cache.offset - (Number.parseInt(before.selfGbaAddress, 16) - 0x02000000);
+      if (ewramBase < 0 || ewramBase % 4 || ewramBase + 0x40000 > heap.byteLength) throw new Error('Cannot validate the contiguous EWRAM allocation.');
+      const avatar = copy(addresses.playerAvatarAddress, 0x20, ewramBase);
+      const spriteId = avatar[4], objectId = avatar[5];
+      if (spriteId >= 64 || objectId >= 16) return { available: true, valid: false, reason: 'Player sprite/object ID out of range.' };
+      const object = copy(addresses.objectEventsAddress + objectId * 0x24, 0x24, ewramBase);
+      const sprite = copy(addresses.spritesAddress + spriteId * 0x44, 0x44, ewramBase);
+      const avatarAgain = copy(addresses.playerAvatarAddress, 0x20, ewramBase);
+      const objectAgain = copy(addresses.objectEventsAddress + objectId * 0x24, 0x24, ewramBase);
+      const spriteAgain = copy(addresses.spritesAddress + spriteId * 0x44, 0x44, ewramBase);
+      const after = readNavigationAt(heap, cache.offset);
+      if (!after || before.sequence !== after.sequence || before.frameCounter !== after.frameCounter
+          || !equal(avatar, avatarAgain) || !equal(object, objectAgain) || !equal(sprite, spriteAgain)) continue;
+      const ov = new DataView(object.buffer), sv = new DataView(sprite.buffer);
+      const data = Array.from({ length: 8 }, (_, index) => sv.getInt16(0x2e + index * 2, true));
+      const current = { x: ov.getInt16(0x10, true), y: ov.getInt16(0x12, true) };
+      const active = !!(object[0] & 1), isPlayer = !!(object[2] & 1), inUse = !!(sprite[0x3e] & 1);
+      const speed = data[4], cursor = data[5], action = object[0x1c];
+      const cursorInRange = speed >= 0 && speed < movementLimits.length && cursor >= 0 && cursor <= movementLimits[speed];
+      const dedicatedBikeAction = action >= 0xaa && action <= 0xad;
+      const valid = active && isPlayer && inUse && object[4] === spriteId && data[0] === objectId
+        && current.x - 7 === before.localX && current.y - 7 === before.localY
+        && cursorInRange && (!dedicatedBikeAction || speed === 5 && cursor <= 3);
+      return {
+        available: true, valid, reason: valid ? null : 'Raw player/object/sprite linkage, coordinate agreement or speed/cursor range check failed.',
+        navigation: travelSample(before),
+        avatar: { flags: avatar[0], transitionFlags: avatar[1], runningState: avatar[2], tileTransitionState: avatar[3], spriteId, objectEventId: objectId, preventStep: avatar[6] },
+        objectEvent: { id: objectId, active, isPlayer, spriteId: object[4], localId: object[8], movementAction: action,
+          heldMovementActive: !!(object[0] & 64), heldMovementFinished: !!(object[0] & 128), currentCoords: current,
+          previousCoords: { x: ov.getInt16(0x14, true), y: ov.getInt16(0x16, true) } },
+        sprite: { id: spriteId, inUse, pos1: { x: sv.getInt16(0x20, true), y: sv.getInt16(0x22, true) },
+          pos2: { x: sv.getInt16(0x24, true), y: sv.getInt16(0x26, true) }, data, speed, cursor, cursorInRange, dedicatedBikeAction },
+        basis: 'Sprite stride 0x44, x/y +0x20/+0x22, x2/y2 +0x24/+0x26, data[4]/[5] +0x36/+0x38; Avatar 0x20, ObjectEvent 0x24; include/sprite.h and include/global.fieldmap.h.',
+        symbols: addresses, ewramHeapBase: hex(ewramBase), caveat: movementCaveat,
+      };
+    }
+    return { available: false, reason: 'Raw engine bytes changed during the bracketed double-copy.' };
+  }
+  byId('read-movement').addEventListener('click', async () => {
+    if (!emulator || qaNavigationBusy || qaTravelActive) return;
+    qaNavigationBusy = true;
+    byId('read-movement').disabled = true;
+    try {
+      const connected = await navigationSnapshot();
+      if (!connected.live || !connected.validForMinimap) throw new Error('Live unlocked field required.');
+      byId('movement-result').textContent = JSON.stringify(readMovementState(), null, 2);
+    } catch (error) {
+      byId('movement-result').textContent = JSON.stringify({ available: false, reason: error.message }, null, 2);
+    } finally {
+      qaNavigationBusy = false;
+      byId('read-movement').disabled = !qaConfig.movementInspection;
+    }
+  });
+  byId('download-travel').addEventListener('click', () => {
+    try {
+      const text = byId('travel-result').textContent;
+      const report = JSON.parse(text);
+      if (!['complete', 'aborted'].includes(report.phase)) throw new Error('Finish or stop a measurement first.');
+      download(text + '\n', 'application/json', `taichung-travel-${qaConfig.rom.sha256.slice(0, 12)}-${Date.now()}.json`);
+    } catch (error) { byId('travel-status').textContent = `Report download failed: ${error.message}`; }
+  });
+"""
+
+TRAVEL_JS = r"""
+  let qaTravelActive = false;
+  let qaTravelAbort;
+  let qaTravelHeldDirection;
+  const travelDirections = { Up: [0, -1], Down: [0, 1], Left: [-1, 0], Right: [1, 0] };
+  function stopTravel(reason = 'Stopped by the tester.') {
+    if (!qaTravelActive) return;
+    qaTravelAbort = reason;
+    if (qaTravelHeldDirection) emulator.buttonUnpress(qaTravelHeldDirection);
+  }
+  byId('stop-travel').addEventListener('click', () => stopTravel());
+  function travelSample(packet) {
+    return {
+      frame: packet.frameCounter, sequence: packet.sequence,
+      mapGroup: packet.mapGroup, mapNum: packet.mapNum,
+      x: packet.localX, y: packet.localY, facing: packet.facing,
+      cycling: !!(packet.flags & 32), flags: packet.flags,
+      contextFlags: packet.contextFlags, contextNames: packet.contextNames,
+    };
+  }
+  async function measureTravel(direction, tiles, expectedFramesPerTile) {
+    const report = {
+      phase: 'preparing', romSha256: qaConfig.rom.sha256,
+      fixtureSha256: qaConfig.fixture?.sha256 ?? null,
+      direction, requestedMetatiles: tiles, expectedFramesPerTile: expectedFramesPerTile || null,
+      definition: 'Native destination-coordinate changes: first movement to target arrival spans N−1 tile intervals. This does not measure pixel-animation completion.',
+      sampling: 'Read-only coherent packets polled with 1 ms requested timers; actual browser scheduling may skip frames. Event-frame ranges expose uncertainty.',
+      coordinateEvents: [],
+    };
+    let latest;
+    let anchor;
+    let previous;
+    let lastAdvanceAt;
+    let deadline;
+    let maxObservedFrameGap = 0;
+    let traceMovement = false;
+    let lastRaw;
+    report.movementTrace = [];
+    report.movementTraceLimit = 64;
+    report.movementReadSkips = 0;
+    function captureMovement(packet) {
+      if (!qaConfig.movementInspection) return;
+      const raw = readMovementState(packet);
+      if (!raw.available) { report.movementReadSkips++; return; }
+      if (!raw.valid) throw new Error(raw.reason);
+      if (report.movementTrace.length < 64) {
+        const sample = { frame: packet.frameCounter, sequence: packet.sequence, tile: [packet.localX, packet.localY],
+          spriteId: raw.sprite.id, objectId: raw.objectEvent.id, pos1: [raw.sprite.pos1.x, raw.sprite.pos1.y],
+          pos2: [raw.sprite.pos2.x, raw.sprite.pos2.y], speed: raw.sprite.speed, cursor: raw.sprite.cursor,
+          movementAction: raw.objectEvent.movementAction, tileState: raw.avatar.tileTransitionState,
+          runningState: raw.avatar.runningState, doubleCopyMatched: true };
+        if (lastRaw) sample.pos1Delta = [sample.pos1[0] - lastRaw.pos1[0], sample.pos1[1] - lastRaw.pos1[1]];
+        report.movementTrace.push(sample);
+        lastRaw = sample;
+      } else report.movementTraceTruncated = true;
+    }
+    const started = performance.now();
+    const blur = () => stopTravel('Window lost focus; directional input was released.');
+    const visibility = () => { if (document.hidden) stopTravel('Page hidden; directional input was released.'); };
+    window.addEventListener('blur', blur);
+    document.addEventListener('visibilitychange', visibility);
+    async function nextPacket() {
+      for (;;) {
+        if (qaTravelAbort) throw new Error(qaTravelAbort);
+        const now = performance.now();
+        if (now > deadline) throw new Error('Eight-second measurement limit reached.');
+        const heap = navigationHeap();
+        if (heap.buffer !== qaNavigationCache?.buffer || heap.byteLength !== qaNavigationCache.length) {
+          throw new Error('Runtime heap changed during measurement.');
+        }
+        const packet = readNavigationAt(heap, qaNavigationCache.offset);
+        if (packet) {
+          latest = packet;
+          if ((packet.flags & 7) !== 7 || packet.contextFlags) throw new Error('Native field context changed.');
+          if (packet.mapGroup !== anchor.mapGroup || packet.mapNum !== anchor.mapNum
+              || packet.mapWidth !== anchor.mapWidth || packet.mapHeight !== anchor.mapHeight || packet.mapType !== anchor.mapType) {
+            throw new Error('Native map/warp scope changed.');
+          }
+          if (!!(packet.flags & 32) !== !!(anchor.flags & 32)) throw new Error('Native cycling state changed.');
+          if (packet.frameCounter !== previous.frameCounter) {
+            if (packet.frameCounter < previous.frameCounter || packet.sequence <= previous.sequence) {
+              throw new Error('Native frame/sequence reset or wrapped during measurement.');
+            }
+            const gap = packet.frameCounter - previous.frameCounter;
+            maxObservedFrameGap = Math.max(maxObservedFrameGap, gap);
+            lastAdvanceAt = now;
+            if (traceMovement) captureMovement(packet);
+            return packet;
+          }
+        }
+        if (now - lastAdvanceAt > 750) throw new Error('Native navigation stopped advancing for 750 ms.');
+        await wait(1);
+      }
+    }
+    try {
+      const delta = travelDirections[direction];
+      if (!delta || !Number.isInteger(tiles) || tiles < 2 || tiles > 12) throw new Error('Choose a direction and 2–12 metatiles.');
+      const connected = await navigationSnapshot();
+      if (!connected.live || !connected.validForMinimap) throw new Error('A live, unlocked native field snapshot is required.');
+      anchor = connected.packet;
+      latest = previous = anchor;
+      deadline = performance.now() + 8000;
+      lastAdvanceAt = performance.now();
+      report.heapOffset = connected.heapOffset;
+      report.nativeAddress = anchor.selfGbaAddress;
+      report.stationarityFrames = 32;
+      report.start = travelSample(anchor);
+      const targetX = anchor.localX + delta[0] * tiles;
+      const targetY = anchor.localY + delta[1] * tiles;
+      if (targetX < 0 || targetY < 0 || targetX >= anchor.mapWidth || targetY >= anchor.mapHeight) {
+        throw new Error('Requested target leaves this map; choose a shorter clear route.');
+      }
+      report.target = { x: targetX, y: targetY };
+      byId('travel-status').textContent = 'Checking 32 advancing native frames with no directional input…';
+      const stationaryFrame = previous.frameCounter;
+      while (previous.frameCounter - stationaryFrame < 32) {
+        const packet = await nextPacket();
+        if (packet.localX !== anchor.localX || packet.localY !== anchor.localY) throw new Error('Player was moving before the measurement.');
+        previous = packet;
+      }
+      report.inputPress = travelSample(previous);
+      if (qaConfig.movementInspection) {
+        report.movementObservationCaveat = movementCaveat;
+        report.movementStart = readMovementState(previous);
+        if (report.movementStart.available && !report.movementStart.valid) throw new Error(report.movementStart.reason);
+        traceMovement = true;
+        captureMovement(previous);
+      }
+      report.phase = 'measuring';
+      qaTravelHeldDirection = direction;
+      emulator.buttonPress(direction);
+      let lastMovementFrame = previous.frameCounter;
+      while (report.coordinateEvents.length < tiles) {
+        const packet = await nextPacket();
+        const stepX = packet.localX - previous.localX;
+        const stepY = packet.localY - previous.localY;
+        if (stepX || stepY) {
+          if (stepX !== delta[0] || stepY !== delta[1]) throw new Error('A coordinate step was skipped, reversed or lateral; timing is unusable.');
+          report.coordinateEvents.push({
+            ...travelSample(packet),
+            possibleEventFrame: { min: previous.frameCounter + 1, max: packet.frameCounter },
+          });
+          lastMovementFrame = packet.frameCounter;
+          byId('travel-status').textContent = `Observed ${report.coordinateEvents.length}/${tiles} native destination steps; frame ${packet.frameCounter}.`;
+        } else if (packet.frameCounter - lastMovementFrame >= 48) {
+          throw new Error('No coordinate progress for 48 native frames: obstacle or movement not accepted.');
+        }
+        previous = packet;
+      }
+      // Native currentCoords names the tile being entered. Release before the
+      // next step is selected, then let the engine finish the current tile.
+      emulator.buttonUnpress(direction);
+      qaTravelHeldDirection = undefined;
+      const arrival = previous;
+      if (arrival.localX !== targetX || arrival.localY !== targetY) throw new Error('Observed destination differs from the requested target.');
