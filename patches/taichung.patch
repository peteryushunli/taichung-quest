new file mode 100644
index 0000000..005513d
--- /dev/null
+++ b/tools/taichung/nantun/edge_art.py
@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+"""Draw and encode the edge kit: the highway that forms the world's west edge.
+
+The kit is bank-independent so any district can carry it. It uses only primary
+palette 2 (identical in every Taichung primary and General) and lives at fixed
+secondary slots above every current bank's contents: metatiles 0x3E0-0x3EF,
+graphics 0x3E0-0x3FF. A neighbour that installs the same kit at the same slots
+renders a donated highway strip correctly. The carriageway is three metatiles
+wide (24 m at the precinct's 8 m/tile): parapet, two southbound lanes, median,
+two northbound lanes, parapet; driving on the right.
+
+  python3 tools/taichung/nantun/edge_art.py --preview /tmp/edge-kit.png
+"""
+import argparse
+from pathlib import Path
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+PALETTE_SLOT = 2
+METATILE_BASE, METATILE_SLOTS = 0x3E0, 16
+GRAPHICS_BASE, GRAPHICS_SLOTS = 0x3E0, 32
+# Primary palette 2 indices.
+WHITE, PALE, CONCRETE, MID, ASPHALT, DARK, NAVY = 1, 2, 3, 4, 5, 6, 7
+BROWN, TAN, YELLOW, RED_LIGHT, RED, RED_DARK, BLUE = 8, 9, 10, 12, 13, 14, 15
+VARIANTS = ('W', 'C', 'E', 'W-red', 'W-white', 'E-blue', 'E-truck')
+HIGHWAY = {name: METATILE_BASE + i for i, name in enumerate(VARIANTS)}
+CAR = [' ooo ', 'obbbo', 'owwwo', 'owwwo', 'obhbo', 'obhbo', 'obbbo', 'owwwo', 'obbbo', ' ooo ']
+TRUCK = [' ooo ', 'owwwo', 'obbbo', 'ottto', 'tTTTt', 'tTTTt', 'tTTTt', 'tTTTt', 'tTTTt', 'tTTTt', 'tTTTt', 'tTTTt', 'tTTTt', ' ttt ']
+BODIES = {'red': dict(o=RED_DARK, b=RED, h=RED_LIGHT, w=NAVY), 'white': dict(o=CONCRETE, b=WHITE, h=PALE, w=NAVY),
+          'blue': dict(o=NAVY, b=BLUE, h=PALE, w=NAVY), 'truck': dict(o=NAVY, b=BLUE, h=PALE, w=NAVY, t=BROWN, T=TAN)}
+
+
+def profile(x, y):
+    """Palette index of the carriageway at column x (0-47, west to east), row y (0-15, periodic)."""
+    if x >= 24:
+        x = 47 - x
+    if x == 0:
+        return NAVY
+    if x in (1, 2):
+        return MID if y % 8 == 0 else (PALE if x == 1 else CONCRETE)
+    if x == 3 or x == 22:
+        return DARK
+    if x == 5:
+        return WHITE
+    if x == 13:
+        return WHITE if y < 6 else ASPHALT
+    if x == 21:
+        return YELLOW
+    if x == 23:
+        return PALE
+    seed = (x * 73 + y * 151) % 97
+    return DARK if seed % 23 == 0 else MID if seed % 29 == 0 else ASPHALT
+
+
+def carriageway():
+    image = Image.new('P', (48, 16), 0)
+    for y in range(16):
+        for x in range(48):
+            image.putpixel((x, y), profile(x, y))
+    return image
+
+
+def vehicle(image, sprite, colors, x0, y0, southbound):
+    rows = sprite[::-1] if southbound else sprite
+    for dy, row in enumerate(rows):
+        for dx, ch in enumerate(row):
+            if ch != ' ':
+                image.putpixel((x0 + dx, y0 + dy), colors[ch])
+        if 0 < dy < len(rows) - 1:
+            image.putpixel((x0 + len(row), y0 + dy), DARK)
+
+
+def variants():
+    """{variant: 16x16 indexed image}; W/C/E are the three carriageway columns."""
+    base = carriageway()
+    out = {}
+    for name in VARIANTS:
+        column = name[0]
+        offset = {'W': 0, 'C': 16, 'E': 32}[column]
+        strip = base.copy()
+        if name == 'W-red':
+            vehicle(strip, CAR, BODIES['red'], 7, 3, southbound=True)
+        elif name == 'W-white':
+            vehicle(strip, CAR, BODIES['white'], 7, 4, southbound=True)
+        elif name == 'E-blue':
+            vehicle(strip, CAR, BODIES['blue'], 36, 3, southbound=False)
+        elif name == 'E-truck':
+            vehicle(strip, TRUCK, BODIES['truck'], 36, 1, southbound=False)
+        out[name] = strip.crop((offset, 0, offset + 16, 16))
+    return out
+
+
+def lane_variant(column, x, y, salt):
+    """Deterministic traffic: a car in roughly one cell in six per outer lane."""
+    if column == 'W':
+        h = (y * 7 + salt) % 13
+        return 'W-red' if h == 0 else 'W-white' if h == 6 else 'W'
+    if column == 'E':
+        h = (y * 5 + salt + 3) % 11
+        return 'E-blue' if h == 0 else 'E-truck' if h == 5 else 'E'
+    return 'C'
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7 - y if flags & 0x800 else y) * 8 + (7 - x if flags & 0x400 else x)] for y in range(8) for x in range(8))
+
+
+def encode(compiled):
+    """Place the kit at its reserved slots in a compiled bank in place; return the budget."""
+    graphics, metatiles, attributes = compiled['graphics'], compiled['metatiles'], compiled['attributes']
+    assert len(graphics) <= GRAPHICS_BASE - 640, f'bank graphics ({len(graphics)}) reach the edge-kit slots'
+    assert len(metatiles) <= METATILE_BASE - 640, f'bank metatiles ({len(metatiles)}) reach the edge-kit slots'
+    first_free = dict(graphics=len(graphics), metatiles=len(metatiles))
+    while len(graphics) < GRAPHICS_BASE - 640:
+        graphics.append((0,) * 64)
+    while len(metatiles) < METATILE_BASE - 640:
+        metatiles.append([0] * 8)
+        attributes.append(0)
+    lookup = {}
+
+    def pack(pixels):
+        assert 0 not in pixels, 'edge kit art must be opaque'
+        canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+        if canonical not in lookup:
+            lookup[canonical] = len(graphics)
+            graphics.append(canonical)
+        return (640 + lookup[canonical]) | flags
+
+    for name, image in variants().items():
+        px = image.load()
+        quads = [tuple(px[qx * 8 + x, qy * 8 + y] for y in range(8) for x in range(8)) for qy in range(2) for qx in range(2)]
+        metatiles.append([pack(q) | (PALETTE_SLOT << 12) for q in quads] + [0, 0, 0, 0])
+        attributes.append(0)
+        assert 640 + len(metatiles) - 1 == HIGHWAY[name]
+    used_graphics = len(graphics) - (GRAPHICS_BASE - 640)
+    assert used_graphics <= GRAPHICS_SLOTS and len(VARIANTS) <= METATILE_SLOTS
+    return dict(metatileSlots=f'0x{METATILE_BASE:03X}-0x{METATILE_BASE + METATILE_SLOTS - 1:03X}',
+                graphicsSlots=f'0x{GRAPHICS_BASE:03X}-0x{GRAPHICS_BASE + GRAPHICS_SLOTS - 1:03X}',
+                paletteSlot=PALETTE_SLOT, metatilesUsed=len(VARIANTS), graphicsUsed=used_graphics,
+                bankContentEndsBefore=first_free, ids={k: f'0x{v:03X}' for k, v in HIGHWAY.items()})
+
+
+def palette():
+    lines = (ROOT / 'data/tilesets/primary/general/palettes/02.pal').read_text().splitlines()[3:]
+    return [tuple(map(int, line.split())) for line in lines if line.strip()]
+
+
+def preview(path, scale=4):
+    colors = [v for c in palette() for v in c]
+    tiles = variants()
+    board = Image.new('P', ((16 * len(tiles) + 4 * (len(tiles) + 1)), 16 + 8 + 64), 0)
+    board.putpalette(colors + [0] * (768 - len(colors)))
+    road = Image.new('P', (48, 64))
+    road.putpalette(board.getpalette())
+    for y in range(4):
+        for i, name in enumerate(('W', 'C', 'E')):
+            road.paste(tiles[lane_variant(name, 0, y, 0) if y else name], (i * 16, y * 16))
+    for i, (name, tile) in enumerate(tiles.items()):
+        tile.putpalette(board.getpalette())
+        board.paste(tile, (4 + i * 20, 4))
+    board.paste(road, (4, 24))
+    big = board.convert('RGB').resize((board.width * scale, board.height * scale), Image.NEAREST)
+    big.save(path)
+    return path
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--preview', type=Path, required=True)
+    args = parser.parse_args()
+    print(preview(args.preview))
+    compiled = dict(graphics=[], metatiles=[], attributes=[])
+    print(encode(compiled))
diff --git a/tools/taichung/nantun/landmark_art.py b/tools/taichung/nantun/landmark_art.py
new file mode 100644
index 0000000..cc196c3
--- /dev/null
+++ b/tools/taichung/nantun/landmark_art.py
@@ -0,0 +1,385 @@
+#!/usr/bin/env python3
+"""Landmarks 18-20 as real tiles in palettes both Nantun banks already load.
+
+Each set piece is built from 16x16 pieces drawn in palette indices of one existing secondary
+palette (12 for 18 and 19, 10 for 20), laid as a top layer over ground metatiles (grass, pavers,
+or the city kit's still water under Fengle's castle). Repeating middles and mirrored ends keep the
+new tile count low: tiles are de-duplicated with horizontal and vertical flips, as the GBA allows.
+The approved drafts (artifacts/city-rework/drafts) were drawn from this same source.
+"""
+from pathlib import Path
+
+T = 16
+# Secondary palettes as both Nantun banks load them at 6366b9e. The primaries have no room once
+# the city kit is in, so every piece lives in the Nantun secondaries. main() checks a checkout.
+PALETTES = {
+    "S12": ("data/tilesets/secondary/taichung_nantun/palettes/12.pal",
+            "000000 283038 f0e8d0 d89870 b06048 784038 90c0b0 489088 286068 e0c878 b89848 806830 b0b8c0 708090 405068 b8b0a0"),
+    "S10": ("data/tilesets/secondary/taichung_nantun/palettes/10.pal",
+            "000000 f6f6ff e6eeff b4c5d5 8394a4 7b7b83 5a5a73 394162 fff6ee d5c5bd ac9c94 837b73 f6d5f6 eebdd5 c573b4 ac6a83"),
+}
+
+
+def palette(key):
+    return [tuple(int(h[i:i + 2], 16) for i in (0, 2, 4)) for h in PALETTES[key][1].split()]
+
+
+def read_pal(path):
+    lines = Path(path).read_text().split("\n")
+    return [tuple(map(int, l.split())) for l in lines[3:3 + int(lines[2])]]
+
+
+def grid(fill=0):
+    return [[fill] * T for _ in range(T)]
+
+
+def hflip(g):
+    return [row[::-1] for row in g]
+
+
+# ---------------------------------------------------------------- S12 pieces: brick, roofs, props
+# S12: 1 ink, 2 cream, 3 mortar, 4 brick, 5 dark brick, 6 pale glass, 7 teal, 8 dark teal,
+#      9 light gold, 10 gold, 11 bronze, 12 light grey, 13 grey, 14 slate, 15 stone
+def brick(g, x0=0, x1=T, y0=0, y1=T):
+    for y in range(y0, y1):
+        for x in range(x0, x1):
+            course = y // 4
+            if y % 4 == 3:
+                g[y][x] = 3
+            elif (x + (course % 2) * 4) % 8 == 0:
+                g[y][x] = 3
+            else:
+                g[y][x] = 4
+    return g
+
+
+def corrugated(g, y0=0, y1=T):
+    for y in range(y0, y1):
+        for x in range(T):
+            g[y][x] = 13 if x % 4 == 3 else 12
+    return g
+
+
+def edge(g, side, colour=1):
+    x = 0 if side == "L" else T - 1
+    for y in range(T):
+        if g[y][x]:
+            g[y][x] = colour
+    return g
+
+
+def roof_top(side):
+    g = corrugated(grid())
+    for x in range(T):
+        g[0][x], g[1][x] = 1, 14
+    return edge(g, side) if side != "M" else g
+
+
+def roof_low(side):
+    g = corrugated(grid(), 0, 13)
+    for x in range(T):
+        g[13][x], g[14][x], g[15][x] = 13, 14, 1
+    return edge(g, side) if side != "M" else g
+
+
+def saw_top(side):
+    g = grid()
+    for y in range(2, T):
+        reach = int((y - 2) * 12 / 13)
+        for x in range(0, reach + 1):
+            g[y][x] = 13 if x == reach else 12
+        for x in range(12, 15):
+            g[y][x] = 6 if x < 14 else 1
+    for x in range(T):
+        g[15][x] = 14
+    return edge(g, side) if side != "M" else g
+
+
+def wall(kind, side):
+    g = brick(grid())
+    if kind == "window":
+        for y in range(4, 12):
+            for x in range(4, 12):
+                g[y][x] = 1 if y in (4, 11) or x in (4, 11) else 14
+        g[5][5] = g[5][6] = g[6][5] = 6
+    elif kind == "door":
+        for y in range(3, T):
+            for x in range(4, 12):
+                g[y][x] = 1 if y == 3 or x in (4, 11) else (7 if x == 7 or x == 8 else 8)
+    if kind in ("base", "door"):
+        for x in range(T):
+            if g[15][x] == 4 or g[15][x] == 3:
+                g[15][x] = 5
+    return edge(g, side) if side != "M" else g
+
+
+def barrel():
+    g = grid()
+    for y in range(3, 15):
+        w = 5 if y in (3, 14) else 6
+        for x in range(8 - w, 8 + w):
+            g[y][x] = 1 if x in (8 - w, 8 + w - 1) else (11 if (x - 8 + w) % 4 == 0 else 10)
+    for y in (5, 12):
+        for x in range(2, 14):
+            g[y][x] = 1
+    for y in range(7, 10):
+        for x in range(5, 11):
+            g[y][x] = 4
+    for x in range(4, 12):
+        g[2][x] = 1
+    return g
+
+
+def sculpture(kind):
+    g = grid()
+    for y in range(11, T):
+        for x in range(3, 13):
+            g[y][x] = 1 if y in (11, 15) or x in (3, 12) else (15 if y == 12 else 12)
+    if kind == "arch":
+        for y in range(2, 11):
+            for x in range(2, 14):
+                d = ((x - 7.5) ** 2 + (y - 10) ** 2) ** 0.5
+                if 4 <= d <= 7:
+                    g[y][x] = 5 if d > 6.2 or d < 4.6 else 4
+    elif kind == "ring":
+        for y in range(0, 11):
+            for x in range(2, 14):
+                d = ((x - 7.5) ** 2 + (y - 5) ** 2) ** 0.5
+                if 3 <= d <= 5.2:
+                    g[y][x] = 9 if y < 4 and x < 8 else 10
+    elif kind == "figure":
+        for y in range(0, 4):
+            for x in range(6, 10):
+                g[y][x] = 1 if y == 0 or x in (6, 9) else 11
+        for y in range(4, 11):
+            for x in range(5, 11):
+                g[y][x] = 1 if x in (5, 10) else 11
+    elif kind == "stack":
+        for k, (y0, w) in enumerate(((7, 5), (4, 4), (1, 3))):
+            for y in range(y0, y0 + 3):
+                for x in range(8 - w, 8 + w):
+                    g[y][x] = 1 if y == y0 or x in (8 - w, 8 + w - 1) else (7 if k % 2 == 0 else 8)
+    return g
+
+
+# ---------------------------------------------------------------- Fengle's castle (S12)
+def castle():
+    """A small castle on an island, centred on three cells so the outer halves stay water.
+
+    Only the west half is drawn and then mirrored, so the east cells reuse the west tiles flipped
+    and the middle column's halves are flips of each other: at most 12 tiles.
+    """
+    W = 3 * T
+    g = [[0] * W for _ in range(W)]
+
+    def rect(x0, y0, x1, y1, c, edge=1):
+        for y in range(y0, y1):
+            for x in range(x0, x1):
+                g[y][x] = edge if edge and (x in (x0, x1 - 1) or y in (y0, y1 - 1)) else c
+
+    def cone(cx, top, base, half, c, shade):
+        for y in range(top, base):
+            r = half * (y - top + 1) / (base - top)
+            for x in range(W):
+                d = x + 0.5 - cx
+                if abs(d) <= r:
+                    g[y][x] = 1 if abs(d) > r - 1 or y == base - 1 else (shade if d < 0 else c)
+
+    for y in range(39, 46):                      # island
+        inset = {39: 4, 40: 1, 44: 2, 45: 5}.get(y, 0)
+        for x in range(8 + inset, 24):
+            g[y][x] = 1 if y in (39, 45) or x == 8 + inset else (7 if y >= 43 else 6)
+    rect(13, 22, 25, 41, 2)                      # keep, crenellated (x 24 is the mirror line)
+    for x in range(14, 24, 4):
+        rect(x, 19, x + 2, 23, 2)
+    rect(21, 32, 24, 41, 5, edge=0)              # door (half)
+    g[32][21] = 1
+    rect(16, 26, 18, 30, 14, edge=0)
+    rect(8, 16, 15, 41, 2)                       # west tower, slate cone
+    rect(10, 23, 13, 27, 14, edge=0)
+    cone(11.5, 5, 17, 3.5, 14, 13)
+    rect(19, 10, 25, 27, 2)                      # centre tower (half), brick cone
+    rect(22, 14, 24, 19, 14, edge=0)
+    cone(24, 0, 11, 6, 4, 4)
+    for row in g:
+        row[W // 2:] = row[:W // 2][::-1]
+    return [[[row[x0:x0 + T] for row in g[y0:y0 + T]] for x0 in (0, T, 2 * T)] for y0 in (0, T, 2 * T)]
+
+
+# ---------------------------------------------------------------- S10 pieces: the ribbon-roof stage
+# S10: 1 white, 2 pale, 3 light grey, 4 grey, 5 mid grey, 6 dark grey, 7 ink, 8 warm white, 9 beige,
+#      10 taupe, 11 dark taupe
+def ribbons(side, count):
+    g = grid()
+    for x in range(T):
+        for y in range(T):
+            g[y][x] = 3
+    bands = [(1, 7), (9, 15)] if count == 2 else [(5, 11)]
+    for top, bottom in bands:
+        for x in range(T):
+            g[top][x] = 4
+            for y in range(top + 1, bottom - 2):
+                g[y][x] = 1
+            g[bottom - 2][x] = 2
+            g[bottom - 1][x] = 4
+    if side == "L":
+        for y in range(T):
+            cut = max(0, 7 - abs(y - 8))
+            for x in range(cut):
+                g[y][x] = 0
+            if cut < T and g[y][cut]:
+                g[y][cut] = 4
+    return g
+
+
+def stage(side):
+    g = grid()
+    for y in range(T):
+        for x in range(T):
+            g[y][x] = 11 if y < 11 else (7 if y == 11 else 6)
+    for x in range(T):
+        g[0][x] = 5
+        if x % 4 == 0:
+            g[5][x] = 10
+    if side == "L":
+        for y in range(T):
+            for x in range(0, 3):
+                g[y][x] = 7 if x == 2 else 5
+    return g
+
+
+def seats(side):
+    g = grid()
+    for y in range(T):
+        for x in range(T):
+            g[y][x] = 9 if y % 4 == 0 else (11 if y % 4 == 3 else 10)
+    if side == "L":
+        for y in range(T):
+            cut = max(0, 12 - y)
+            for x in range(cut):
+                g[y][x] = 0
+            if cut < T:
+                g[y][cut] = 11
+    return g
+
+
+# ---------------------------------------------------------------- layouts
+def sides(n):
+    return ["L"] + ["M"] * (n - 2) + ["R"] if n > 1 else ["M"]
+
+
+def put(layer, x, y, g, flip=False):
+    layer[(x, y)] = hflip(g) if flip else g
+
+
+def warehouse(layer, x0, y0, w, saw=False, door_at=None):
+    door_at = x0 + w // 2 if door_at is None else door_at
+    for i, side in enumerate(sides(w)):
+        base = "L" if side == "R" else side
+        flip = side == "R"
+        x = x0 + i
+        put(layer, x, y0, saw_top(base) if saw else roof_top(base), flip)
+        put(layer, x, y0 + 1, roof_low(base), flip)
+        put(layer, x, y0 + 2, wall("window" if x != door_at else "plain", base), flip)
+        put(layer, x, y0 + 3, wall("door" if x == door_at else "base", base), flip)
+
+
+def heritage():
+    w, h = 11, 18
+    ground = {(x, y): "grass" for x in range(w) for y in range(h)}
+    for y in (5, 10, 16):
+        for x in range(w):
+            ground[(x, y)] = "paver"
+    for y in range(5, h):
+        ground[(6, y)] = "paver"
+    layer = {}
+    warehouse(layer, 1, 1, 9)
+    warehouse(layer, 1, 6, 5)
+    warehouse(layer, 7, 6, 3, saw=True)
+    warehouse(layer, 1, 12, 5)
+    for i, (x, y) in enumerate(((8, 12), (9, 13), (8, 14), (9, 15))):
+        put(layer, x, y, barrel(), i % 2 == 1)
+    ground[(5, 17)] = "paver"
+    return {"size": (w, h), "ground": ground, "layer": layer, "signs": [(5, 17)], "palette": "S12"}
+
+
+def fengle():
+    w, h = 11, 9
+    ground = {(x, y): "grass" for x in range(w) for y in range(h)}
+    lake = {(x, y) for x in range(4, 11) for y in range(5)}
+    path = {(2, 0), (2, 1), (2, 2)} | {(x, y) for x in range(1, 4) for y in (3, 4)} | \
+           {(x, 5) for x in range(5)} | {(x, 6) for x in range(4, 9)} | {(x, 5) for x in range(8, w)}
+    for c in path:
+        ground[c] = "paver"
+    for c in lake:
+        ground[c] = "water"
+    layer = {}
+    for (x, y), kind in (((0, 1), "arch"), ((3, 1), "ring"), ((2, 3), "figure"), ((6, 5), "figure"),
+                         ((1, 7), "stack"), ((5, 7), "ring"), ((9, 7), "arch")):
+        put(layer, x, y, sculpture(kind))
+    for j, row in enumerate(castle()):
+        for i, cell in enumerate(row):
+            if any(any(r) for r in cell):
+                layer[(6 + i, 1 + j)] = cell
+    return {"size": (w, h), "ground": ground, "layer": layer, "signs": [(1, 0)], "pond": (4, 0),
+            "palette": "S12"}
+
+
+def amphitheatre():
+    w, h = 12, 7
+    ground = {(x, y): "paver" for x in range(w) for y in range(h)}
+    layer = {}
+    for y, (x0, x1, count) in enumerate(((0, 11, 2), (1, 10, 2), (2, 9, 1))):
+        for i, side in enumerate(sides(x1 - x0 + 1)):
+            put(layer, x0 + i, y, ribbons("L" if side != "M" else "M", count), side == "R")
+    for i, side in enumerate(sides(6)):
+        put(layer, 3 + i, 3, stage("L" if side != "M" else "M"), side == "R")
+    for y, (x0, x1) in zip((4, 5, 6), ((2, 9), (1, 10), (0, 11))):
+        for i, side in enumerate(sides(x1 - x0 + 1)):
+            put(layer, x0 + i, y, seats("L" if side != "M" else "M"), side == "R")
+    walk = {(x, y) for (x, y) in layer if y >= 4}
+    return {"size": (w, h), "ground": ground, "layer": layer, "signs": [(0, 3)], "walk": walk, "palette": "S10"}
+
+
+SETPIECES = {"18": ("Cultural Heritage Park", heritage), "19": ("Fengle Sculpture Park", fengle),
+             "20": ("Wenxin Forest Park amphitheatre", amphitheatre)}
+
+
+# ---------------------------------------------------------------- render and count
+def tile_key(t):
+    variants = [t, [r[::-1] for r in t], t[::-1], [r[::-1] for r in t[::-1]]]
+    return min(tuple(tuple(r) for r in v) for v in variants)
+
+
+def quarters(g):
+    return [[row[x0:x0 + 8] for row in g[y0:y0 + 8]] for y0 in (0, 8) for x0 in (0, 8)]
+
+
+def count(sp):
+    tiles, metas = set(), set()
+    for (x, y), g in sp["layer"].items():
+        qs = [tile_key(q) for q in quarters(g)]
+        tiles.update(k for k in qs if any(any(r) for r in k))
+        metas.add((sp["ground"][(x, y)], tuple(qs)))
+    blocked = (set(sp["layer"]) - sp.get("walk", set())) | set(sp["signs"])
+    blocked |= {c for c, kind in sp["ground"].items() if kind == "water"}
+    for (x, y) in sp.get("trees", []):
+        blocked |= {(x + i, y + j) for i in (0, 1) for j in (0, 1)}
+    return {"cells_with_new_art": len(sp["layer"]), "new_tiles_8x8": len(tiles), "new_metatiles": len(metas),
+            "palettes": sorted({sp["palette"], *sp.get("cell_palette", {}).values()}), "tile_keys": tiles,
+            "blocked": sorted(blocked)}
+
+
+def build_all():
+    out = {}
+    for n, (name, maker) in SETPIECES.items():
+        sp = maker()
+        out[n] = {"name": name, "spec": sp, "count": count(sp)}
+    return out
+
+
+def verify_palettes(native):
+    for key, (path, _) in PALETTES.items():
+        assert read_pal(native / path) == palette(key), f"{key} differs in {native}"
+        north = native / path.replace("/taichung_nantun/", "/taichung_nantun_north/")
+        assert read_pal(north) == palette(key), f"North's {key} differs from Wanhe's"
