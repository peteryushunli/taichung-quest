+#!/usr/bin/env python3
+"""Verify V2 density, native encodings and preservation against the saved V1."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+from color_check import check as check_native_colors
+from color_compile import compile_colorways
+from library import ROOT, parse_words, require
+from neighborhood_density import compile_density, fill_density
+from neighborhood_fill import cells
+
+
+def check(output, v1):
+    output, v1 = Path(output), Path(v1)
+    preserved = {str(p.relative_to(v1)): hashlib.sha256(p.read_bytes()).hexdigest()
+                 for p in v1.rglob('*') if p.is_file()}
+    require(bool(preserved), 'Saved V1 artifacts are required for an invariant comparison')
+    layout = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-r2c2-layout.json').read_text())
+    profile = json.loads((ROOT / 'data/taichung/neighborhoods/pilot-profile.json').read_text())['section']
+    compiled = compile_density(output); base_compiled = compile_colorways()
+    # Derived facades use only source graphics already in the kit. This checks
+    # actual tile/palette/metatile bytes, rather than assuming a free budget.
+    for field in ('graphics', 'metatiles', 'attributes', 'palettes', 'remaps'):
+        require(compiled[field] == base_compiled[field], f'Derived facades unexpectedly alter native bank {field}')
+    source_ids = lambda c: {w & 1023 for p in c['library'].prefabs.values() for row in parse_words(p) for w in row}
+    require(source_ids(compiled) == source_ids(base_compiled), 'Derived facades add unverified source metatiles')
+    native_proof = check_native_colors()
+    result = fill_density(compiled, layout, profile); repeated = fill_density(compiled, layout, profile)
+    require(result['words'] == repeated['words'] and result['placements'] == repeated['placements'], 'Composition is nondeterministic')
+    raw = (output / 'filled-map.bin').read_bytes()
+    require(list(struct.unpack(f'<{len(raw) // 2}H', raw)) == result['words'], 'Saved map differs from validated composition')
+    old_raw = (v1 / 'filled-map.bin').read_bytes(); old = struct.unpack(f'<{len(old_raw) // 2}H', old_raw)
+    require(len(old) == len(result['words']) == 4096, 'V1/V2 dimensions differ')
+    invariant_cells = result['roads'] | result['approaches'] | result['gymReserves']
+    for x, y in invariant_cells:
+        require(result['words'][y * 64 + x] == old[y * 64 + x], f'Approved road/gym/arrival cell changed at {x},{y}')
+    old_report = json.loads((v1 / 'validation.json').read_text())
+    require(old_report['sourceLayoutSha256'] == result['report']['sourceLayoutSha256'], 'Accepted lot/street geometry changed')
+    commercial = set().union(*(cells(l['localRect']) for l in layout['candidateLots'] if l['streetBand'] == 'primaryRetailFrontage'))
+    old_solid = sum(bool(old[y * 64 + x] & 0xc00) for x, y in commercial)
+    new_solid = sum(bool(result['words'][y * 64 + x] & 0xc00) for x, y in commercial)
+    require(new_solid > old_solid, 'Density revision does not increase retail lot built coverage')
+    # Verify the actual artifact encodings as well as the independently proved
+    # base pack: the written files are what the native integrator will consume.
+    bank = output / 'native-color-bank'; gfx_raw = (bank / 'tiles.4bpp').read_bytes()
+    decoded = [tuple(v for byte in gfx_raw[i:i + 32] for v in (byte & 15, byte >> 4)) for i in range(0, len(gfx_raw), 32)]
+    require(decoded == compiled['graphics'], 'Saved native 4bpp pixels changed')
+    meta_raw = (bank / 'metatiles.bin').read_bytes()
+    entries = struct.unpack(f'<{len(meta_raw) // 2}H', meta_raw)
+    require(list(entries) == [e for group in compiled['metatiles'] for e in group], 'Saved native metatile references changed')
+    palette = struct.unpack('<16H', (bank / '12.gbapal').read_bytes())
+    rgb = [((v & 31) * 8, ((v >> 5) & 31) * 8, ((v >> 10) & 31) * 8) for v in palette]
+    require(rgb == compiled['palettes'][12], 'Saved BGR555 palette changed')
+    for name, digest in preserved.items():
+        require(hashlib.sha256((v1 / name).read_bytes()).hexdigest() == digest, f'V1 artifact was modified: {name}')
+    report = dict(result='pass', sourceLayoutPreserved=True, v1ArtifactHashesPreserved=preserved,
+        invariantRoadGymApproachCellsCompared=len(invariant_cells), deterministicMapSha256=hashlib.sha256(raw).hexdigest(),
+        derivedCatalogPrefabs=compiled['library'].validate()['implementedPrefabs'],
+        derivedModulesAddGraphicsOrMetatiles=False,
+        v1CommercialLotSolidCells=old_solid, v2CommercialLotSolidCells=new_solid,
+        commercialLotCells=len(commercial), v1CommercialLotCoverage=round(old_solid / len(commercial), 4),
+        v2CommercialLotCoverage=round(new_solid / len(commercial), 4),
+        native4bppGraphicsRoundtripped=len(decoded), nativeMetatileEntriesRoundtripped=len(entries), nativeBgr555ColorsRoundtripped=16,
+        independentBaseRendersCompared=native_proof['baseMetatileRendersCompared'],
+        independentRoofRemapRendersCompared=native_proof['roofRemapRendersCompared'],
+        reachability=result['report'])
+    (output / 'density-checks.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in report.items() if k not in ('reachability', 'v1ArtifactHashesPreserved')}, indent=2))
+    return report
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--v1', type=Path, required=True)
+    args = parser.parse_args(); check(args.output, args.v1)
