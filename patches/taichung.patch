+++ b/tools/taichung/approved_art.py
@@ -0,0 +1,572 @@
+#!/usr/bin/env python3
+"""Install reviewed landmark art over Claude's frozen city, not a city rebuild.
+
+Private per-map banks retain exact camera-strip raw addresses. Other used graphics
+are packed with flips, with animation destinations and door scratch held aside.
+Defaults to a checked dry run. Old banks, street plans and connection data stay
+untouched. All source inputs are read from BASE for deterministic reapplication.
+"""
+from pathlib import Path
+from io import BytesIO
+from collections import Counter,defaultdict
+import argparse,copy,hashlib,json,re,struct,subprocess,sys
+from PIL import Image,ImageDraw
+
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).resolve().parents[2]
+BASE='2362263510dfa38987c36b6cc40dca8d9372fc3c'
+DATA=ROOT/'data/taichung/approved-landmarks'
+# Claude's eight water frames are identical. Bake that exact frame and reclaim
+# its48 VRAM destinations; flower/used shoreline animation slots stay fixed.
+ANIMATED=set(range(508,512))
+SCRATCH=set(range(1016,1024))
+SPECS=[
+ ('wanhe-temple','TaichungNantunWanhe',[27,27],[9,7],[27,27],None,'WanheTemple',None),
+ ('wenchang-temple','TaichungNantunWanhe',[18,28],[7,6],[18,28],None,'WenchangTemple',None),
+ ('botanical-garden','TaichungGreenway',[9,26],[13,7],[9,25],1,'BotanicalGarden',[15,33]),
+ ('confucius-temple','TaichungOldCityNorth',[30,25],[10,9],[30,25],0x1C1,'ConfuciusTemple',None),
+ ('yizhong-street','TaichungOldCityNorth',[30,39],[10,8],[30,39],0x1C1,'YizhongStreet',[34,45]),
+ ('prefectural-hall','TaichungOldCity',[13,36],[10,10],[13,36],0x175,'PrefecturalHall',[17,45]),
+ ('second-market','TaichungOldCityNorth',[18,25],[7,9],[18,25],0x1C1,'SecondMarket',[18,34]),
+ ('cultural-heritage-park','TaichungNantunWanhe',[65,17],[11,18],[62,17],1,'CulturalHeritagePark',[73,30]),
+ ('fengle-sculpture-park','TaichungNantunWanhe',[65,55],[11,9],[65,55],1,'FengleSculpturePark',[70,63]),
+ ('wenxin-forest-park','TaichungNantunNorth',[20,24],[12,7],[20,24],1,'WenxinForestPark',[26,31]),
+]
+
+
+class Frozen:
+ def __init__(self):self.cache={}
+ def read(self,p):
+  if p not in self.cache:self.cache[p]=subprocess.check_output(['git','show',BASE+':'+str(p)],cwd=ROOT)
+  return self.cache[p]
+ def json(self,p):return json.loads(self.read(p))
+ def words(self,p,kind='H'):
+  b=self.read(p);return list(struct.unpack('<'+kind*(len(b)//struct.calcsize(kind)),b))
+
+
+def flip(t,f):return bytes(t[(7-y if f&0x800 else y)*8+(7-x if f&0x400 else x)] for y in range(8) for x in range(8))
+def canonical(t):return min((flip(t,f),f) for f in (0,0x400,0x800,0xC00))
+def digest(b):return hashlib.sha256(b).hexdigest()
+def packed(values,kind='H'):return struct.pack('<'+kind*len(values),*values)
+
+
+class Bank:
+ def __init__(self,src,primary,secondary):
+  self.src=src;self.labels=[primary,secondary];self.paths=[]
+  hdr=src.read('src/data/tilesets/headers.h').decode()
+  decl='\n'.join(src.read(p).decode() for p in ['src/data/tilesets/graphics.h','src/data/tilesets/metatiles.h','src/graphics.c'])
+  self.callbacks=[]
+  for label in self.labels:
+   body=re.search(r'\b'+label+r'\s*=\s*\{(.*?)\};',hdr,re.S).group(1);paths={}
+   self.callbacks.append(re.search(r'\.callback\s*=\s*(\w+)',body).group(1))
+   for field in ['tiles','metatiles','metatileAttributes','palettes']:
+    symbol=re.search(r'\.'+field+r'\s*=\s*(\w+)',body).group(1)
+    val=re.search(r'\b'+symbol+r'\s*\[.*?=\s*(.*?);',decl,re.S).group(1)
+    paths[field]=re.search(r'INCBIN_\w+\("([^"]+)"\)',val).group(1)
+   paths['tiles']=str(Path(paths['tiles']).parent/'tiles.png')
+   paths['palettes']=str(Path(paths['palettes']).parent)
+   self.paths.append(paths)
+  self.images=[Image.open(BytesIO(src.read(p['tiles']))).copy() for p in self.paths]
+  self.defs=[src.words(p['metatiles']) for p in self.paths]
+  self.attrs=[src.words(p['metatileAttributes'],'I') for p in self.paths]
+  self.pals=[]
+  for n in range(16):
+   p=self.paths[0 if n<7 else 1]['palettes']+f'/{n:02}.pal'
+   self.pals.append([tuple(map(int,l.split())) for l in src.read(p).decode().splitlines()[3:] if l.strip()][:16])
+  self.rendered={}
+  self.static_water=None
+  if self.callbacks[0]=='InitTilesetAnim_General':
+   folder='data/tilesets/primary/general/anim/water_current_landwatersedge/'
+   frames=[Image.open(BytesIO(src.read(folder+f'{n}.png'))).copy() for n in range(8)]
+   assert len({f.tobytes() for f in frames})==1,'Water is no longer static; cannot bake it'
+   self.static_water=frames[0]
+ def entries(self,n):
+  side=0 if n<640 else 1;pos=n if n<640 else n-640
+  return self.defs[side][pos*8:pos*8+8]
+ def attr(self,n):return self.attrs[0][n] if n<640 else self.attrs[1][n-640]
+ def tile(self,n):
+  if self.static_water is not None and 416<=n<464:
+   im=self.static_water;pos=n-416;x=pos%(im.width//8)*8;y=pos//(im.width//8)*8
+   return im.crop((x,y,x+8,y+8)).tobytes()
+  side=0 if n<640 else 1;pos=n if n<640 else n-640;im=self.images[side]
+  x=(pos%(im.width//8))*8;y=(pos//(im.width//8))*8
+  if y+8>im.height:return bytes(64)
+  return im.crop((x,y,x+8,y+8)).tobytes()
+ def render(self,n):
+  if n not in self.rendered:
+   im=Image.new('RGB',(16,16))
+   for k,word in enumerate(self.entries(n)):
+    tile=flip(self.tile(word&1023),word&0xC00);pal=self.pals[word>>12]
+    for p,index in enumerate(tile):
+     if k<4 or index:im.putpixel(((k%4%2)*8+p%8,(k%4//2)*8+p//8),pal[index])
+   self.rendered[n]=im
+  return self.rendered[n]
+
+
+def visible(view,target,direction,offset):
+ for y in range(target['height']):
+  for x in range(target['width']):
+   if ((direction=='left' and x>=target['width']-7 and -7<=y+offset<view['height']+7) or
+       (direction=='right' and x<8 and -7<=y+offset<view['height']+7) or
+       (direction=='up' and y>=target['height']-7 and -7<=x+offset<view['width']+8) or
+       (direction=='down' and y<7 and -7<=x+offset<view['width']+8)):yield x,y
+
+
+def mask_for(ident,im):
+ m=Image.new('L',im.size);d=ImageDraw.Draw(m)
+ if ident in ('wanhe-temple','wenchang-temple'):
+  m=im.convert('RGBA').getchannel('A')
+ elif ident=='confucius-temple':
+  d.polygon([(5,43),(34,34),(34,8),(49,3),(110,3),(125,8),(125,34),(154,43),(147,64),(12,64)],fill=255)
+ elif ident=='prefectural-hall':
+  d.polygon([(4,75),(9,53),(20,28),(48,28),(59,53),(64,75),(60,143),(7,143)],fill=255)
+  d.polygon([(54,78),(59,56),(70,29),(128,29),(139,56),(144,78),(144,142),(56,142)],fill=255)
+ elif ident=='second-market':
+  d.polygon([(1,76),(17,46),(95,46),(111,76),(109,133),(3,133)],fill=255)
+  d.polygon([(28,35),(39,15),(73,15),(84,35),(84,98),(28,98)],fill=255)
+  for x in (7,105):d.rectangle((x-5,121,x+5,137),fill=255)
+ elif ident=='cultural-heritage-park':
+  for p in [[(11,90),(24,60),(54,35),(84,60),(97,90),(94,176),(14,176)],
+            [(143,84),(157,56),(184,32),(211,56),(225,84),(222,150),(146,150)],
+            [(96,134),(109,116),(219,116),(232,134),(230,178),(98,178)],
+            [(134,13),(152,13),(152,129),(134,129)],[(126,37),(130,37),(130,122),(126,122)]]:
+   d.polygon([(x-9,y) for x,y in p],fill=255)
+  for x in (26-9,222-9):d.rectangle((x-7,181,x+7,200),fill=255)
+  d.rectangle((59,192,85,200),fill=255)
+ elif ident=='botanical-garden':
+  for p in [[(48,108),(64,15),(73,27),(112,7),(151,27),(160,15),(176,108),(168,118),(56,118)],
+            [(20,60),(25,60),(81,79),(62,101),(62,121),(40,121),(24,106)],
+            [(23,109),(40,106),(67,111),(78,124),(66,137),(30,138),(17,128)]]:d.polygon(p,fill=255)
+ elif ident=='yizhong-street':
+  d.rectangle((3,0,61,93),fill=255);d.rectangle((98,4,158,94),fill=255)
+ elif ident=='fengle-sculpture-park':
+  d.polygon([(53,21),(78,15),(134,19),(157,30),(165,50),(156,77),(136,89),(77,85),(54,73),(42,49)],fill=255)
+  d.rectangle((28,79,148,126),fill=255)
+ elif ident=='wenxin-forest-park':d.ellipse((10,18,185,105),fill=255)
+ else:raise ValueError(ident)
+ return m
+
+
+def code_meta_ids(src):
+ labels={n:int(v,0) for n,v in re.findall(r'^#define\s+(METATILE_\w+)\s+(0x[0-9a-fA-F]+|\d+)',src.read('include/constants/metatile_labels.h').decode(),re.M)}
+ used=set()
+ for p in (ROOT/'src').rglob('*.c'):
+  text=p.read_text(errors='ignore')
+  names=set(re.findall(r'\bMETATILE_General_\w+',text))
+  names|={f'METATILE_General_{x}' for x in re.findall(r'METATILE_ID\(\s*General\s*,\s*(\w+)\s*\)',text)}
+  used|={labels[n] for n in names if n in labels}
+ # All known General replacements are conservative closure, not arbitrary IDs.
+ used|={labels[n] for n in labels if n.startswith('METATILE_General_') and any(x in n for x in ('Cut','Mowed','Grass','Door'))}
+ return used
+
+
+def load_scenes(src):
+ layouts=src.json('data/layouts/layouts.json');by_layout={l['id']:l for l in layouts['layouts'] if 'id' in l}
+ contract=src.json('data/taichung/minimap-contract.json')
+ scenes={}
+ for e in contract['mapsByNativeKey'].values():
+  if e.get('kind')!='exterior':continue
+  name=e['nativeMapName'];data=src.json(f'data/maps/{name}/map.json');layout=by_layout[data['layout']]
+  bank=Bank(src,layout['primary_tileset'],layout['secondary_tileset'])
+  words=src.words(layout['blockdata_filepath'])
+  scenes[data['id']]=dict(name=name,data=data,layout=layout,bank=bank,old=words,grid=words[:],
+     border=src.words(layout['border_filepath']),origin=e['worldOrigin'],allowed=set(),overlays={},signs={},signInfo={},art=[])
+ return layouts,scenes
+
+
+def stage(sc,rows,spec):
+ ident,name,oldorg,oldsize,origin,floor,script,newsign=spec
+ bank=sc['bank'];w=sc['layout']['width'];grid=sc['grid'];old=sc['old']
+ event=next(b for b in sc['data']['bg_events'] if b.get('script')=='TaichungCity_Sign_'+script)
+ signold=(event['x'],event['y']);signword=old[signold[1]*w+signold[0]]
+ if floor is None:
+  portal=next(b for b in sc['data']['warp_events'] if oldorg[0]<=b['x']<oldorg[0]+oldsize[0] and oldorg[1]<=b['y']<oldorg[1]+oldsize[1])
+  floor=old[(portal['y']+1)*w+portal['x']]&1023
+ image=Image.open(DATA/'art'/f'{ident}.png');mask=mask_for(ident,image)
+ portals={(b['x'],b['y']) for b in sc['data']['warp_events']}
+ floorword=0x3000|floor
+ # Erase only the old landmark rectangle; no surrounding blockout pass is run.
+ for y in range(oldorg[1],oldorg[1]+oldsize[1]):
+  for x in range(oldorg[0],oldorg[0]+oldsize[0]):
+   if (x,y) not in portals:grid[y*w+x]=floorword;sc['allowed'].add((x,y))
+ if ident=='fengle-sculpture-park':
+  # Use the city's own paving/grass behind the exact bridge/lake/sculpture art.
