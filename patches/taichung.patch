+        sign = next((event for event in events if event.get("place") in aliases and event["type"] == "sign"
+                     and event["tile"] == list(sign_tile)), None)
+        if sign is None:
+            x, y = sign_tile
+            require(world.at(x, y) in "GWyn", f"The sign tile for {name} has changed.")
+            world.put((x, y, x + 1, y + 1), "n")
+            sign = {"type": "sign", "place": name, "tile": list(sign_tile), "readFrom": read_from}
+            events.append(sign)
+        else:
+            require(sign["tile"] == list(sign_tile) and sign["readFrom"] == read_from,
+                    f"The existing sign for {name} differs from its approved placement.")
+        sign.update(script=script, inLiveGame=True)
+        installed.append({"id": name, "worldRect": rect, "signTile": sign_tile,
+                          "readFrom": read_from, "script": script})
+    removed = {point for point, _ in MUSEUMBRARY_RETIRED_POSTS}
+    for (x, y), ground in MUSEUMBRARY_RETIRED_POSTS:
+        require(world.at(x, y) == "n", "The reviewed Museumbrary frontage moved")
+        world.put((x, y, x + 1, y + 1), ground)
+    events[:] = [event for event in events
+                 if not (event["type"] == "sign" and tuple(event.get("tile") or ()) in removed)]
+    return installed
+
