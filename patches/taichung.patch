+#!/usr/bin/env python3
+"""Independent checks of the actual OldCity clone/bank/map, with no source writes.
+
+Uses the compiler manifest as an address/remap contract, never imports its code.
+Static source checks do not claim ROM, animation, save-cache or runtime safety.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+from io import BytesIO
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+from PIL import Image
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+PROJECT = ROOT.parents[1]
+DEFAULT_MANIFEST = "data/taichung/landmarks/old-core-native/manifest.json"
+GENERAL = "data/tilesets/primary/general"
+PEWTER = "data/tilesets/secondary/pewter_city"
+DISTRICTS = ("TaichungOldCity", "TaichungGreenway", "TaichungXitun")
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def number(value):
+    return int(value, 0) if isinstance(value, str) and value.lower().startswith("0x") else int(value)
+
+
+class Files:
+    def __init__(self, source, revision=None):
+        self.source, self.revision, self.cache = source, revision, {}
+
+    def read(self, path):
+        key = str(path)
+        if key not in self.cache:
+            if self.revision:
+                self.cache[key] = subprocess.check_output(["git", "show", f"{self.revision}:{key}"], cwd=self.source)
+            else:
+                self.cache[key] = (self.source/path).read_bytes()
+        return self.cache[key]
+
+    def text(self, path):
+        return self.read(path).decode("utf-8")
+
+    def json(self, path):
+        return json.loads(self.text(path))
+
+    def words(self, path, kind="H"):
+        raw = self.read(path)
+        if len(raw) % struct.calcsize(kind):
+            raise ValueError(f"Invalid {kind} file size: {path}")
+        return list(struct.unpack(f"<{len(raw)//struct.calcsize(kind)}{kind}", raw))
+
+    def image(self, path):
+        image = Image.open(BytesIO(self.read(path)))
+        image.load()
+        return image
+
+
+class Bank:
+    """Small independent renderer that resolves only requested metatiles."""
+    def __init__(self, files, primary, secondary, palette_overrides=None):
+        self.files, self.folders = files, (str(primary), str(secondary))
+        self.images = [files.image(f"{folder}/tiles.png") for folder in self.folders]
+        self.defs = [files.words(f"{folder}/metatiles.bin") for folder in self.folders]
+        self.attrs = [files.words(f"{folder}/metatile_attributes.bin", "I") for folder in self.folders]
+        for image, defs, attrs in zip(self.images, self.defs, self.attrs):
+            if image.mode != "P" or image.width % 8 or image.height % 8 or image.getextrema()[1] > 15:
+                raise ValueError("Bank graphics are not an indexed 4bpp tile sheet")
+            if len(defs) != len(attrs)*8:
+                raise ValueError("Metatile/attribute count mismatch")
+        self.palettes = []
+        for n in range(13):
+            folder = self.folders[0 if n < 7 else 1]
+            path = (palette_overrides or {}).get(n, f"{folder}/palettes/{n:02}.pal")
+            colors = [tuple(map(int, line.split())) for line in files.text(path).splitlines()[3:] if line.strip()]
+            if len(colors) != 16:
+                raise ValueError(f"Palette {n} does not have 16 colors")
+            self.palettes.append(colors)
+        self.render_cache = {}
+
+    def attr(self, metatile):
+        which, local = (0, metatile) if metatile < 640 else (1, metatile-640)
+        if not 0 <= local < len(self.attrs[which]):
+            raise ValueError(f"Undefined metatile {metatile:#x}")
+        return self.attrs[which][local]
+
+    def entries(self, metatile):
+        self.attr(metatile)
+        which, local = (0, metatile) if metatile < 640 else (1, metatile-640)
+        return self.defs[which][local*8:(local+1)*8]
+
+    def graphic(self, n):
+        which, local = (0, n) if n < 640 else (1, n-640)
+        image = self.images[which]
+        count = image.width*image.height//64
+        if not 0 <= local < count:
+            raise ValueError(f"Undefined graphic {n}")
+        sx, sy = local % (image.width//8)*8, local // (image.width//8)*8
+        return tuple(image.getpixel((sx+x, sy+y)) for y in range(8) for x in range(8))
+
+    def layer(self, metatile, layer):
+        entries = self.entries(metatile)
+        pixels = [0]*256
+        for q in range(4):
+            entry = entries[layer*4+q]
+            graphic, palette = entry & 1023, entry >> 12
+            if not 0 <= palette < 13:
+                raise ValueError(f"Invalid palette {palette} in {metatile:#x}")
+            tile = self.graphic(graphic)
+            for y in range(8):
+                for x in range(8):
+                    value = tile[(7-y if entry & 0x800 else y)*8+(7-x if entry & 0x400 else x)]
+                    pixels[(q//2*8+y)*16+q%2*8+x] = (value, self.palettes[palette][value])
+        return pixels
+
+    def render(self, metatile):
+        if metatile not in self.render_cache:
+            lower, upper = self.layer(metatile, 0), self.layer(metatile, 1)
+            self.render_cache[metatile] = tuple(top[1] if top[0] else bottom[1] for bottom, top in zip(lower, upper))
+        return self.render_cache[metatile]
+
+
+class Checks:
+    def __init__(self):
+        self.errors, self.warnings, self.results = [], [], {}
+
+    def require(self, condition, message):
+        if not condition:
+            self.errors.append(message)
+        return condition
+
+    def section(self, label, function):
+        before = len(self.errors)
+        try:
+            details = function()
+        except (AssertionError, ValueError, KeyError, IndexError, FileNotFoundError) as error:
+            self.errors.append(f"{label}: {error}")
+            details = {}
+        self.results[label] = {"passed": len(self.errors) == before, **(details or {})}
+
+
+def load_native(source):
+    spec = importlib.util.spec_from_file_location("old_core_geometry_source", source/"tools/taichung/validate_city.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def resolved_folder(files, label):
+    header = re.search(rf"\b{re.escape(label)}\s*=\s*\{{(.*?)\}};", files.text("src/data/tilesets/headers.h"), re.S)
+    if not header:
+        raise ValueError(f"Unregistered C tileset {label}")
+    symbol = re.search(r"\.metatiles\s*=\s*(\w+)", header.group(1)).group(1)
+    declaration = re.search(rf"\b{symbol}\s*\[.*?=\s*(.*?);", files.text("src/data/tilesets/metatiles.h"), re.S)
+    path = re.search(r'INCBIN_\w+\("([^"]+)"\)', declaration.group(1)).group(1)
+    return str(Path(path).parent), header.group(1)
+
+
+def script_lines(text):
+    return [re.sub(r"\s+", " ", line.split("@", 1)[0].strip()) for line in text.splitlines() if line.split("@", 1)[0].strip()]
+
+
+def script_block(text, label):
+    match = re.search(rf"^{re.escape(label)}::\s*\n(.*?)(?=^\w+::|\Z)", text, re.S | re.M)
+    if not match:
+        raise ValueError(f"Missing script block {label}")
+    return script_lines(match.group(1))
+
+
+def check(source, manifest_path, audit_ref, opening_ref, self_test=False):
+    current, baseline, opening = Files(source), Files(source, audit_ref), Files(source, opening_ref)
+    manifest = current.json(manifest_path)
+    audit = baseline.json("data/taichung/landmarks/old-core-bank-audit.json")
+    checks = Checks()
+    bank = Bank(current, manifest["primaryFolder"], manifest["secondaryFolder"])
+    reference = Bank(baseline, GENERAL, PEWTER)
+    allowed = set(audit["primaryConservativeRawHoleOption"]["generalMetatileIdsToKeepCompatible"])
+    animated = set(audit["generalAnimation"]["fixedGraphicIds"])
+    reserved = set(audit["primaryConservativeRawHoleOption"]["requiredRawGraphicIds"]) | animated
+    old_layouts = {item["id"]: item for item in baseline.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    layouts = {item["id"]: item for item in current.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    map_json = {name: current.json(f"data/maps/{name}/map.json") for name in DISTRICTS}
+    counts = Counter()
+
+    def preserve_primary():
+        original_paths = subprocess.check_output(["git", "ls-tree", "-r", "--name-only", audit_ref, GENERAL], cwd=source, text=True).splitlines()
+        for path in original_paths:
+            # Git normalizes text palettes. Compare their parsed colors as well as
+            # the exact working-tree hashes captured by the frozen audit.
+            if path.endswith(".pal"):
+                checks.require(current.text(path).splitlines() == baseline.text(path).splitlines(), f"Original General palette changed: {path}")
+            else:
+                checks.require(current.read(path) == baseline.read(path), f"Original General source changed: {path}")
+        audited = 0
+        for path, expected in audit["sourceSha256RelativeToProject"].items():
+            marker = "data/tilesets/primary/general/"
+            if marker in path:
+                relative = marker + path.split(marker, 1)[1]
+                checks.require(digest(current.read(relative)) == expected, f"General audit hash changed: {relative}")
+                audited += 1
+        checks.require(len(reserved) == 228 and len(animated) == 70, "Frozen protection set must contain 228 graphics and 70 animation destinations")
+        checks.require(set(manifest["preservedPrimaryGraphics"]) == reserved, "Compiler preservation list differs from the frozen audit")
+        checks.require(not set(manifest["allocatedPrimaryGraphics"]) & reserved, "New graphics allocated into protected primary slots")
+        checks.require(bank.images[0].width*bank.images[0].height//64 == 640, "Clone primary must contain 640 graphics")
+        for n in reserved:
+            checks.require(bank.graphic(n) == reference.graphic(n), f"Protected primary graphic changed at raw slot {n}")
+        for n in range(7):
+            checks.require(bank.palettes[n] == reference.palettes[n], f"Primary palette {n} changed")
+        checks.require(manifest["generalMetatileRemap"] == "identity", "General ID contract changed")
+        for n in allowed:
+            checks.require(bank.entries(n) == reference.entries(n), f"Allowed General definition changed at {n:#x}")
+            checks.require(bank.attr(n) == reference.attr(n), f"Allowed General attributes/layers changed at {n:#x}")
+            checks.require(bank.render(n) == reference.render(n), f"Allowed General rendering changed at {n:#x}")
+        folder, header = resolved_folder(current, manifest["primary"])
+        checks.require(folder == manifest["primaryFolder"], "Primary C label resolves to a different bank")
+        checks.require(re.search(r"\.callback\s*=\s*InitTilesetAnim_General\b", header) is not None, "Clone lost General's animation callback")
+        writes = sorted((int(a),int(b)) for a,b in re.findall(r"AppendTilesetAnimToBuffer\(sTilesetAnims_General_[^;]*?TILE_OFFSET_4BPP\((\d+)\)\),\s*(\d+)\s*\*\s*TILE_SIZE_4BPP\);", current.text("src/tileset_anims.c")))
+        checks.require(writes == [(416,48),(464,18),(508,4)], "General animation destinations changed")
+        return {"originalGeneralFilesCompared": len(original_paths), "exactAuditHashesCompared": audited, "protectedGraphics": len(reserved), "fixedAnimationDestinations": len(animated), "allowedGeneralMetatiles": len(allowed)}
+
+    def bank_integrity():
+        checks.require(len(bank.attrs[0]) == 640 and len(bank.attrs[1]) <= 384, "Actual native metatile capacity exceeded")
+        checks.require(len(bank.attrs[1]) == manifest["secondaryMetatiles"], "Manifest secondary definition count disagrees with bytes")
+        loaded = bank.images[1].width*bank.images[1].height//64
+        checks.require(loaded == manifest["loadedSecondaryGraphics"] and loaded <= 384, "Secondary sheet padding/capacity mismatch")
+        for metatile in list(allowed) + list(range(640,640+len(bank.attrs[1]))):
+            layer = (bank.attr(metatile) >> 29) & 3
+            checks.require(layer in (0,1,2), f"Unsupported native layer type at {metatile:#x}")
+            for entry in bank.entries(metatile):
+                graphic, palette = entry & 1023, entry >> 12
+                checks.require(graphic < 1016, f"Static graphic references door-animation scratch at {metatile:#x}: {graphic}")
+                checks.require(palette < 13, f"Palette outside loaded range at {metatile:#x}")
+                bank.graphic(graphic)
+                counts["checkedGraphicReferences"] += 1
+        station = current.image("data/taichung/landmarks/old-station/native.png")
+        expected = [tuple(station.getpalette()[i:i+3]) for i in range(0,48,3)]
+        checks.require(bank.palettes[7] == expected, "Shared palette 7 differs from approved Station")
+        for path in ("data/taichung/landmarks/miyahara/candidate-v2/candidate-indexed.png", "data/taichung/landmarks/taichung-park/candidate/candidate-indexed.png"):
+            checks.require(current.image(path).getpalette()[:48] == station.getpalette()[:48], f"Landmark palette source diverged: {path}")
+        secondary_folder, _ = resolved_folder(current, manifest["secondary"])
+        checks.require(secondary_folder == manifest["secondaryFolder"], "Secondary C label resolves to a different bank")
+        declarations = "\n".join(current.text(path) for path in ("src/data/tilesets/graphics.h","src/data/tilesets/metatiles.h","src/graphics.c"))
+        for which,label in enumerate((manifest["primary"],manifest["secondary"])):
+            _,header = resolved_folder(current,label)
+            folder = bank.folders[which]
+            checks.require(re.search(rf"\.isSecondary\s*=\s*{'FALSE' if which==0 else 'TRUE'}",header) is not None, f"Wrong C bank role for {label}")
+            checks.require(re.search(r"\.isCompressed\s*=\s*TRUE",header) is not None, f"Wrong compression declaration for {label}")
+            for field,suffix in (("tiles","tiles.4bpp.lz"),("metatiles","metatiles.bin"),("metatileAttributes","metatile_attributes.bin"),("palettes",None)):
+                symbol = re.search(rf"\.{field}\s*=\s*(\w+)",header).group(1)
+                declaration = re.search(rf"\b{re.escape(symbol)}\s*\[.*?=\s*(.*?);",declarations,re.S)
+                if declaration is None:
+                    raise ValueError(f"Missing C source declaration for {label}.{field}")
+                paths = re.findall(r'INCBIN_\w+\("([^"]+)"\)',declaration.group(1))
+                if suffix:
+                    checks.require(paths==[f"{folder}/{suffix}"], f"C {label}.{field} does not load the validated bank bytes")
+                else:
+                    checks.require(len(paths)==16, f"C {label}.palettes does not have 16 indexed source entries")
