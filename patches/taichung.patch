@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Refresh shapes and append missing glyphs while preserving all FC19 indices.
+
+Never regenerates content, translations, menus, scripts or existing mappings.
+Dry-run by default. Uses the same provider as extend-chinese-glyphs.py.
+"""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+
+SPEC = importlib.util.spec_from_file_location('taichung_extend', Path(__file__).with_name('extend-chinese-glyphs.py'))
+EXTEND = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(EXTEND)
+glyph_records, load_font, sha256 = EXTEND.glyph_records, EXTEND.load_font, EXTEND.sha256
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument('--artifacts', type=Path, required=True)
+    parser.add_argument('--font', type=Path, help='Legacy Noto file only for older checkouts without a bitmap manifest')
+    parser.add_argument('--corpus', type=Path, help='Optional extra UTF8 corpus; only missing glyphs are consumed, never content generation')
+    parser.add_argument('--write', action='store_true')
+    args = parser.parse_args()
+    game = args.game.resolve()
+    cmap_path, header_path = game / 'charmap.txt', game / 'src/data/taichung_glyphs.h'
+    cmap, header = cmap_path.read_bytes(), header_path.read_bytes()
+    existing = EXTEND.parse_existing(cmap, header)
+    sources, characters = EXTEND.native_sources(game)
+    corpus = args.corpus.read_bytes() if args.corpus else None
+    if corpus is not None:
+        characters.update(filter(EXTEND.is_chinese, corpus.decode('utf8')))
+    missing = sorted(characters - set(existing['mappings']))
+    font = load_font(game, args.font)
+    records = glyph_records(font, [row['character'] for row in existing['rows']] + missing, 0)
+    additions = records[len(existing['rows']):]
+    new_cmap, _ = EXTEND.extend(cmap, header, existing, additions)
+    rows = ''.join('    {' + ', '.join(f'0x{x:03x}' for x in row['masks'])
+                   + f"}}, // {row['index']}: {row['character']}\n" for row in records)
+    new_header = ('// Generated by tools/taichung_gameplay/refresh-chinese-glyphs.py.\n'
+                  '// Taichung Native Bitmap12; source/licenses: assets/fonts/taichung-native-font.json\n'
+                  'static const u16 sTaichungChineseGlyphs[][14] = {\n' + rows + '};\n').encode('utf8')
+    candidate = EXTEND.parse_existing(new_cmap, new_header)
+    if not new_cmap.startswith(cmap) or any(candidate['mappings'].get(c) != value for c, value in existing['mappings'].items()):
+        raise ValueError('Refusing to alter any existing character encoding')
+    if [r['character'] for r in candidate['rows'][:len(existing['rows'])]] != [r['character'] for r in existing['rows']]:
+        raise ValueError('Refusing to renumber a released glyph')
+    changed = sum(a['masks'] != b['masks'] for a, b in zip(existing['rows'], candidate['rows']))
+    if args.write:
+        current_sources, _ = EXTEND.native_sources(game)
+        if current_sources != sources or cmap_path.read_bytes() != cmap or header_path.read_bytes() != header:
+            raise ValueError('Font/content inputs changed during preparation; rerun')
+        if args.corpus and args.corpus.read_bytes() != corpus:
+            raise ValueError('Extra corpus changed during preparation; rerun')
+        if new_cmap != cmap:
+            cmap_path.write_bytes(new_cmap)
+        if new_header != header:
+            header_path.write_bytes(new_header)
+    report = {'mode': 'write' if args.write else 'dry-run', 'game': str(game),
+              'existingGlyphCount': len(existing['rows']), 'addedGlyphCount': len(additions),
+              'glyphCount': len(records), 'changedExistingShapes': changed,
+              'allExistingMappingsAndIndicesUnchanged': True,
+              'originalCharmapBytesPreservedAsPrefix': True,
+              'fontSource': font.metadata,
+              'before': {'charmapSha256': sha256(cmap), 'headerSha256': sha256(header)},
+              'candidate': {'charmapSha256': sha256(new_cmap), 'headerSha256': sha256(new_header)},
+              'sourceSha256': {str(path.relative_to(game)): sha256(raw) for path, raw in sources.items()},
+              'additions': [{k: row[k] for k in ('character', 'index', 'encoding')} for row in additions],
+              'scope': 'Glyph shapes and append-only missing glyphs. No translation/menu/script/content writes.'}
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    output = args.artifacts / 'refresh-chinese-glyphs.json'
+    output.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({'mode': report['mode'], 'glyphCount': len(records),
+                      'changedShapes': changed, 'added': len(additions),
+                      'preservedAllIndices': True, 'report': str(output)}))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (OSError, ValueError, KeyError) as error:
+        raise SystemExit(str(error))
