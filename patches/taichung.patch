+++ b/tools/taichung/build_city.py
@@ -0,0 +1,289 @@
+#!/usr/bin/env python3
+"""Author the native Taichung blockout, without touching legacy maps or gameplay.
+
+Run only in the mapping checkout. This owns the generated Taichung geometry and
+initial placeholder events; do not rerun over subsequent gameplay/localization
+work without reconciling those changes. Existing map/layout/section IDs are kept.
+"""
+import json
+import struct
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ELEVATION = 3
+GRASS, PAVING, TALL_GRASS, SIGN = 0x001, 0x175, 0x00D, 0x003
+
+DISTRICTS = [
+    ("TaichungOldCity", "OLD_CITY", 40, 72, (80, 48), "OLD TAICHUNG", "MUS_VERMILLION"),
+    ("TaichungGreenway", "GREENWAY", 40, 72, (40, 32), "TAICHUNG GREENWAY", "MUS_PALLET"),
+    ("TaichungXitun", "XITUN", 40, 64, (0, 0), "TAICHUNG XITUN", "MUS_CELADON"),
+]
+
+LANDMARKS = [
+    # Stable ID, room suffix, region, door, arrival, English, Traditional Chinese, source facade.
+    ("old-taichung-station", "OldStation", "OLD_CITY", (32, 64), (30, 66), "Old Taichung Station", "舊臺中車站", "museum"),
+    ("taichung-park", "Park", "OLD_CITY", (32, 30), (32, 34), "Taichung Park", "臺中公園", "house"),
+    ("miyahara", "Miyahara", "OLD_CITY", (20, 52), (20, 55), "Miyahara", "宮原眼科", "house"),
+    ("natural-science-museum", "ScienceMuseum", "GREENWAY", (24, 20), (24, 23), "Science Museum", "國立自然科學博物館", "museum"),
+    ("calligraphy-greenway", "Greenway", "GREENWAY", (22, 36), (22, 39), "Calligraphy Greenway", "草悟道／市民廣場", "gym"),
+    ("shen-ji-new-village", "ShenJi", "GREENWAY", (10, 44), (10, 47), "Shen Ji New Village", "審計新村", "house"),
+    ("fine-arts-museum", "FineArts", "GREENWAY", (10, 62), (10, 65), "Fine Arts Museum", "國立臺灣美術館", "museum"),
+    ("fengjia-night-market", "Fengjia", "XITUN", (24, 12), (24, 15), "Fengjia Night Market", "逢甲夜市", "gym"),
+    ("maple-garden", "MapleGarden", "XITUN", (12, 32), (12, 35), "Maple Garden", "秋紅谷", "house"),
+    ("taichung-theater", "Theater", "XITUN", (12, 44), (12, 47), "National Taichung Theater", "臺中國家歌劇院", "museum"),
+]
+
+
+def snake(name):
+    import re
+    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).upper()
+
+
+def save_json(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
+
+
+def read_words(path):
+    raw = path.read_bytes()
+    return list(struct.unpack(f"<{len(raw)//2}H", raw))
+
+
+def write_words(path, words):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(struct.pack(f"<{len(words)}H", *words))
+
+
+class Grid:
+    def __init__(self, width, height):
+        self.width, self.height = width, height
+        self.cells = [0x3000 | GRASS] * (width * height)
+        self.boundary()
+
+    def put(self, x, y, tile, blocked=False, elevation=3):
+        assert 0 <= x < self.width and 0 <= y < self.height, (x, y)
+        self.cells[y*self.width+x] = (elevation << 12) | (0x400 if blocked else 0) | tile
+
+    def rect(self, x0, y0, x1, y1, tile=PAVING, blocked=False, elevation=3):
+        for y in range(y0, y1+1):
+            for x in range(x0, x1+1):
+                self.put(x, y, tile, blocked, elevation)
+
+    def boundary(self):
+        for y in range(self.height):
+            for x in range(self.width):
+                if x < 2 or x >= self.width-2 or y < 2 or y >= self.height-2:
+                    self.put(x, y, ((0x00E, 0x00F), (0x016, 0x017))[y % 2][x % 2], True, 0)
+
+    def grove(self, x0, y0, cols, rows):
+        for y in range(rows*2):
+            for x in range(cols*2):
+                self.put(x0+x, y0+y, ((0x00E, 0x00F), (0x016, 0x017))[y % 2][x % 2], True, 0)
+
+    def pond(self, x0, y0, x1, y1):
+        # Fishing/encounter ownership comes later; water is not a walking route.
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):
+                row = 0 if y==y0 else 2 if y==y1 else 1
+                col = 0 if x==x0 else 2 if x==x1 else 1
+                tile=((0x1A0,0x1A1,0x1A2),(0x1A8,0x1A9,0x1AA),(0x1B0,0x1B1,0x1B2))[row][col]
+                self.put(x,y,tile,True,1)
+
+
+def object_event(local_id, x, y, script, graphics="OBJ_EVENT_GFX_WOMAN_1"):
+    return dict(local_id=local_id, type="object", graphics_id=graphics, x=x, y=y,
+                elevation=3, movement_type="MOVEMENT_TYPE_FACE_DOWN", movement_range_x=0,
+                movement_range_y=0, trainer_type="TRAINER_TYPE_NONE",
+                trainer_sight_or_berry_tree_id="0", script=script, flag="0")
+
+
+def map_data(name, key, layout=None, indoor=False):
+    return dict(id="MAP_TAICHUNG_"+key, name=name, layout=layout or "LAYOUT_TAICHUNG_"+key,
+                music="MUS_GYM" if indoor else next(d[6] for d in DISTRICTS if d[1]==key),
+                region_map_section="MAPSEC_TAICHUNG_"+key if not indoor else "MAPSEC_TAICHUNG_OLD_CITY",
+                requires_flash=False, weather="WEATHER_NONE" if indoor else "WEATHER_SUNNY",
+                map_type="MAP_TYPE_INDOOR" if indoor else "MAP_TYPE_CITY",
+                allow_cycling=not indoor, allow_escaping=False, allow_running=not indoor,
+                show_map_name=not indoor, floor_number=0, battle_scene="MAP_BATTLE_SCENE_GYM" if indoor else "MAP_BATTLE_SCENE_NORMAL",
+                connections=None if indoor else [], object_events=[], warp_events=[], coord_events=[], bg_events=[])
+
+
+def make_layout(name, key, width, height, primary="General", secondary="PewterCity"):
+    return dict(id="LAYOUT_TAICHUNG_"+key, name=name+"_Layout", width=width, height=height,
