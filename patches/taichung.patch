+
+bool8 TaichungTeamNoGrindActive(void)
+{
+    // All three city districts and their ten halls use this dedicated group.
+    // Kanto, link play and the original tutorials retain their own rules.
+    return gSaveBlock1Ptr != NULL
+        && gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+}
+
+static void PrepareMon(struct Pokemon *mon, bool8 applyPreset)
+{
+    u16 species;
+    u32 status = 0;
+    u16 hp;
+
+    if (mon == NULL)
+        return;
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    if (!TaichungTeamSpeciesAllowed(species) || GetMonData(mon, MON_DATA_IS_EGG))
+        return;
+    // Level is derived from experience. Preserve identity, IVs/EVs, nickname,
+    // ownership and held items when updating an existing saved partner.
+    SetMonData(mon, MON_DATA_EXP, &gExperienceTables[gSpeciesInfo[species].growthRate][TAICHUNG_TEAM_LEVEL]);
+    CalculateMonStats(mon);
+    if (applyPreset)
+        TaichungTeamApplyPreset(mon);
+    else
+        MonRestorePP(mon);
+    hp = GetMonData(mon, MON_DATA_MAX_HP);
+    // Explicitly set HP after calculation, including downward normalization:
+    // the original engine's max-HP delta can underflow on older high-level saves.
+    SetMonData(mon, MON_DATA_HP, &hp);
+    SetMonData(mon, MON_DATA_STATUS, &status);
+}
+
+void TaichungTeamPrepareMon(struct Pokemon *mon)
+{
+    PrepareMon(mon, TRUE);
+}
+
+void TaichungTeamPrepareTrainerMon(struct Pokemon *mon, u8 partyFlags)
+{
+    PrepareMon(mon, !(partyFlags & F_TRAINER_PARTY_CUSTOM_MOVESET));
+}
+
+void TaichungTeamPrepareParty(void)
+{
+    u8 slot;
+    CalculatePlayerPartyCount();
+    for (slot = 0; slot < gPlayerPartyCount; slot++)
+        TaichungTeamPrepareMon(&gPlayerParty[slot]);
+    HealPlayerParty();
+}
+
+void TaichungTeamEnsurePartyLevel(void)
+{
+    u8 slot;
+    if (!TaichungTeamNoGrindActive())
+        return;
+    CalculatePlayerPartyCount();
+    for (slot = 0; slot < gPlayerPartyCount; slot++)
+    {
+        // Upgrade an older party once. Ordinary exploration battles do not
+        // refill an already-normalized partner's HP, status or PP.
+        if (GetMonData(&gPlayerParty[slot], MON_DATA_LEVEL) != TAICHUNG_TEAM_LEVEL)
+            TaichungTeamPrepareMon(&gPlayerParty[slot]);
+    }
+}
+
+bool8 TaichungTeamSetSlot(u8 slot, u16 species)
+{
+    struct Pokemon replacement;
+    u16 heldItem = 0;
+    u8 mail = MAIL_NONE;
+    u8 count = CalculatePlayerPartyCount();
+
+    // Append at the first empty slot, or replace an existing one. Never make
+    // gaps, send a choice to the PC, or remove the player's last partner.
+    if (gMain.inBattle || slot >= PARTY_SIZE || slot > count || !TaichungTeamSpeciesAllowed(species))
+        return FALSE;
+    if (slot < count)
+    {
+        heldItem = GetMonData(&gPlayerParty[slot], MON_DATA_HELD_ITEM);
+        mail = GetMonData(&gPlayerParty[slot], MON_DATA_MAIL);
+    }
+    CreateMon(&replacement, species, TAICHUNG_TEAM_LEVEL, 31, FALSE, 0, OT_ID_PLAYER_ID, 0);
+    TaichungTeamApplyPreset(&replacement);
+    SetMonData(&replacement, MON_DATA_HELD_ITEM, &heldItem);
+    SetMonData(&replacement, MON_DATA_MAIL, &mail);
+    gPlayerParty[slot] = replacement;
+    CalculatePlayerPartyCount();
+    GetSetPokedexFlag(species, FLAG_SET_SEEN);
+    GetSetPokedexFlag(species, FLAG_SET_CAUGHT);
+    return TRUE;
+}
