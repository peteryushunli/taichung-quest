+            expected = bytes(pixels[k] | pixels[k+1] << 4
+                             for n in range(image.width*image.height//64)
+                             for pixels in (graphic(image, n),) for k in range(0, 64, 2))
+            target = temp / (role+".4bpp")
+            subprocess.run([str(converter), str(out / "tiles.png"), str(target)], check=True, capture_output=True)
+            assert target.read_bytes() == expected
+            if role == "secondary":
+                assert set(expected[len(pack.secondary)*32:]) <= {0}
+            for n in range(16):
+                raw = (out / f"palettes/{n:02}.pal").read_bytes()
+                assert raw == raw.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+                colors = palette_colors(raw)
+                expected_pal = packed_words([r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors])
+                target = temp / (role+f"-{n:02}.gbapal")
+                subprocess.run([str(converter), str(out / f"palettes/{n:02}.pal"), str(target)], check=True, capture_output=True)
+                assert target.read_bytes() == expected_pal
+    generated = [p for folder in paths[:2] for p in folder.rglob("*") if p.is_file()]
+    plan = {
+        "schemaVersion": 1, "baselineCommit": BASE,
+        "scope": "unregistered deterministic graphics pack and foreground templates; no map/terrain/portal installation",
+        "primaryFolder": PRIMARY, "secondaryFolder": SECONDARY,
+        "primarySymbolProposed": "gTileset_TaichungXitunPrivatePrimary", "secondarySymbolProposed": "gTileset_TaichungXitunFinal",
+        "primaryCallbackMustRetainGeneralAnimation": True, "conditionalPrimaryReloadEngineChangeRequired": True,
+        "graphics": {"protectedPrimarySlots": len(reserved), "protectedAnimationSlots": len(animated),
+                     "protectedPrimaryIds": sorted(reserved), "protectedAnimationIds": sorted(animated),
+                     "primaryAvailableHolesInitially": len(pack.free), "oldSecondaryReferencedGraphics": len(old_refs),
+                     "oldGraphicsAllocatedInPrimary": after_old_primary_count, "oldGraphicsReusedFromProtectedStatic": len(old_refs)-after_old_primary_count,
+                     "primaryHolesAfterOldRelocation": len(pack.free)-after_old_primary_count,
+                     "newArtUnmergedPatternSum": source_pattern_sum, "newArtPatternUnion": len(source_pattern_union),
+                     "newArtPrimarySlotsAllocated": len(pack.primary_allocated)-after_old_primary_count,
+                     "primaryHolesRemaining": len(pack.free)-len(pack.primary_allocated),
+                     "secondaryStaticGraphics": len(pack.secondary), "loadedSecondaryGraphics": loaded,
+                     "secondaryStaticLimit": 376, "remainingStaticSecondarySlots": 376-len(pack.secondary),
+                     "reservedDoorScratchGlobalIdsInclusive": [1016, 1023], "primaryAllocatedIds": pack.primary_allocated,
+                     "oldToNewGraphicEntries": {str(n): entry for n, entry in relocation.items()}},
+        "metatiles": {"preservedLegacyCount": 239, "preservedLegacyIdsInclusive": [640, 878],
+                      "preservedTheaterIdsInclusive": [719, 878], "appendedStart": 879,
+                      "appendedOccupiedCells": len(definitions)-239, "totalSecondaryDefinitions": len(definitions),
+                      "remainingDefinitionSlots": 384-len(definitions), "allNumericIdsAndLegacyAttributesPreserved": True,
+                      "newGroundLayers": "zero-filled templates; Root must compose before installation",
+                      "newAttributes": "zero-filled placeholders; no collision/terrain approval", "newMapWords": None},
+        "palettes": {"newArtPalettes": {"maple-garden": 8, "fengjia-night-market": 9},
+                     "legacyPaletteAliases": {str(a): b for a, b in palette_aliases.items()},
+                     "legacy8CopiedExactlyTo10": True, "legacy9CopiedExactlyTo11": True,
+                     "primary0to6AndTheater7Unchanged": True, "palette12Untouched": True,
+                     "secondaryPaletteUsageProposed": [7, 8, 9, 10, 11],
+                     "unallocatedSecondaryPaletteFamilies": [12], "allPalettesCrlf": True},
+        "landmarks": landmarks,
+        "proof": {"protectedGraphicsUnchanged": True, "all70AnimationSlotsUnchanged": True,
+                  "protectedGeneralClosureCount": len(closure), "protectedGeneralEntryWordsUnchanged": True,
+                  "all239LegacyRendersAndAttributesUnchanged": True,
+                  "legacyRenderDigestBefore": render_digest(before, preserved_ids), "legacyRenderDigestAfter": render_digest(actual, preserved_ids),
+                  "all160TheaterRendersAndAttributesUnchanged": True, "artForegroundIndexAndRgbRoundTrip": True,
+                  "actualGbagfxPrimaryAndSecondaryBytesMatch": True, "actualGbagfxAll32PalettesMatchBgr555": True,
+                  "secondarySheetPaddingAllZero": True,
+                  "connectedStripMapWordsChecked": strip_total, "connectedStripEntryWordsChecked": strip_total*8,
+                  "connectionProof": connection_proof, "registeredMapFilesWritten": False},
+        "sourceSha256": {path: digest(raw) for path, raw in sorted(frozen.cache.items())},
+        "approvedIndexedInputsSha256": art_hashes,
+        "outputFilesSha256": {str(p.relative_to(output_root)): digest(p.read_bytes()) for p in sorted(generated)},
+        "limits": ["Graphics pack only: no native map, registry, C, UI, save or ROM changes.",
+                   "Root/streetscape must author Maple ground, paths, pond/tree collisions, gym portal and layer priorities.",
+                   "Fengjia has opaque dark lane art and no painted gym door; Root must decide the entry treatment.",
+                   "General definitions outside the86-ID compatibility closure are not promised unchanged rendering.",
+                   "Dynamic engine behavior, animation execution, caches and boundary-transition VRAM reload remain runtime work."],
+        "registeredInSource": False, "geometryApproved": False, "runtimeVerified": False, "nativeReady": False,
+    }
+    (data_out / "pack-plan.json").write_text(json.dumps(plan, indent=2)+"\n")
+    if verify_rebuild:
+        # Both passes consume the same frozen baseline and exact current input
+        # bytes. All outputs, including the unstamped plan, must match exactly.
+        with tempfile.TemporaryDirectory(prefix="xitun-rebuild-") as folder:
+            temp = Path(folder)
+            again = compile_pack(temp, verify_rebuild=False)
+            assert again == plan
+            assert all((temp / path).read_bytes() == (output_root / path).read_bytes()
+                       for path in plan["outputFilesSha256"])
+            assert (temp / DATA / "pack-plan.json").read_bytes() == (data_out / "pack-plan.json").read_bytes()
+        plan["proof"]["deterministicRebuildVerified"] = True
+        plan["proof"]["deterministicBankFilesChecked"] = len(plan["outputFilesSha256"])
+        plan["proof"]["deterministicUnstampedPlanAlsoByteIdentical"] = True
+        (data_out / "pack-plan.json").write_text(json.dumps(plan, indent=2)+"\n")
+    return plan
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-root", type=Path, default=ROOT, help="Only assigned new folders are written beneath this root")
+    args = parser.parse_args()
+    result = compile_pack(args.output_root)
+    print(json.dumps({"graphics": {k: v for k, v in result["graphics"].items() if not isinstance(v, (list, dict))},
+                      "metatiles": result["metatiles"], "palettes": result["palettes"],
+                      "plan": str(args.output_root / DATA / "pack-plan.json")}, indent=2))
