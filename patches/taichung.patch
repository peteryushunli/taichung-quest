+
+static const u16 sPalette[] = {
+    RGB(0, 0, 0), RGB(31, 31, 30), RGB(4, 8, 13), RGB(15, 19, 22),
+    RGB(6, 14, 24), RGB(26, 29, 31), RGB(12, 21, 28), RGB(16, 23, 29),
+    RGB(28, 8, 7), RGB(29, 30, 31), RGB(31, 31, 31), RGB(31, 31, 31),
+    RGB(31, 31, 31), RGB(31, 31, 31), RGB(31, 31, 31), RGB(31, 31, 31)
+};
