+        self.lookup, self.allocated, self.secondary = {}, [], []
+        for n in sorted(protected - animated):
+            pixels, flags = canonical(bank.graphic(n))
+            self.lookup.setdefault(pixels, (n, flags))
+
+    def pack(self, pixels):
+        pixels, flags = canonical(pixels)
+        if pixels not in self.lookup:
+            if len(self.allocated) < len(self.free):
+                n = self.free[len(self.allocated)]
+                self.allocated.append(n)
+                for y in range(8):
+                    for x in range(8):
