@@ -0,0 +1,74 @@
+@ Park-only voluntary challenge. Never write progress or trainer-fought flags.
+TaichungGym_EventScript_ParkChallenge::
+	lock
+	faceplayer
+	goto_if_questlog TaichungGym_ParkReplaySkipped
+	setvar VAR_0x8004, TAICHUNG_GYM_PARK
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_eq VAR_RESULT, TRUE, TaichungGym_ParkAlreadyComplete
+	callnative TaichungGym_ScriptConsumeParkLossNotice
+	goto_if_ne VAR_RESULT, TRUE, TaichungGym_ParkGreeting
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_LOSS
+	callnative TaichungGym_ScriptGetParkMessage
+	msgbox gStringVar4
+
+TaichungGym_ParkGreeting::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_GREETING
+	callnative TaichungGym_ScriptGetParkMessage
+	msgbox gStringVar4
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_OFFER
+	callnative TaichungGym_ScriptGetParkMessage
+	msgbox gStringVar4, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, TaichungGym_ParkDeclined
+	setvar VAR_0x8004, TAICHUNG_GYM_PARK
+	setvar VAR_0x8005, TRAINER_TAICHUNG_PARK_LIAN
+	callnative TaichungGym_ScriptPrepareChallenge
+	goto_if_eq VAR_RESULT, FALSE, TaichungGym_ParkUnavailable
+	goto_if_eq VAR_0x40FB, 2, TaichungGym_ParkBattleChinese
+	trainerbattle_single TRAINER_TAICHUNG_PARK_LIAN, TaichungGym_Text_ParkIntroEn, TaichungGym_Text_ParkDefeatEn, TaichungGym_ParkAfterBattle
+	goto TaichungGym_ParkBattleSkipped
+
+TaichungGym_ParkBattleChinese::
+	trainerbattle_single TRAINER_TAICHUNG_PARK_LIAN, TaichungGym_Text_ParkIntroZh, TaichungGym_Text_ParkDefeatZh, TaichungGym_ParkAfterBattle
+	goto TaichungGym_ParkBattleSkipped
+
+TaichungGym_ParkBattleSkipped::
+	callnative TaichungGym_ScriptCancelChallenge
+	goto TaichungGym_ParkNotRecorded
+
+@ Native quest-log trainer replay can set a fought flag without running an
+@ actual battle. Exit before preparation or trainerbattle is ever reached.
+TaichungGym_ParkReplaySkipped::
+	callnative TaichungGym_ScriptCancelChallenge
+	release
+	end
+
+TaichungGym_ParkAfterBattle::
+	setvar VAR_0x8004, TAICHUNG_GYM_PARK
+	callnative TaichungGym_ScriptGetResult
+	goto_if_ne VAR_RESULT, TAICHUNG_GYM_RESULT_WON, TaichungGym_ParkNotRecorded
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_ne VAR_RESULT, TRUE, TaichungGym_ParkNotRecorded
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_COMPLETE
+	goto TaichungGym_ParkMessage
+
+TaichungGym_ParkAlreadyComplete::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE
+	goto TaichungGym_ParkMessage
+
+TaichungGym_ParkDeclined::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_DECLINED
+	goto TaichungGym_ParkMessage
+
+TaichungGym_ParkUnavailable::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_UNAVAILABLE
+	goto TaichungGym_ParkMessage
+
+TaichungGym_ParkNotRecorded::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_NOT_RECORDED
+
