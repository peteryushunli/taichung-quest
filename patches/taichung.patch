+++ b/tests/taichung_jun_test.c
@@ -0,0 +1,93 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_jun.h"
+#include "constants/maps.h"
+#include "constants/event_objects.h"
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static bool32 sPendingWarp;
+static unsigned sHeaderReads;
+static const struct MapLayout sLayout = {13, 15};
+static const struct ObjectEventTemplate sObjects[] = {
+    {1, OBJ_EVENT_GFX_TAICHUNG_JUN}
+};
+static const struct MapEvents sEvents = {1, sObjects};
+static const struct MapHeader sHeader = {&sLayout, &sEvents};
+
+bool32 UseContinueGameWarp(void) { return sPendingWarp; }
+void SetContinueGameWarpStatus(void) { sPendingWarp = TRUE; }
+const struct MapHeader *Overworld_GetMapHeaderByGroupAndId(u16 group, u16 number)
+{
+    assert(group == MAP_GROUP(MAP_TAICHUNG_OLD_CITY));
+    assert(number == MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM));
+    sHeaderReads++;
+    return &sHeader;
+}
+
+static void Reset(void)
+{
+    memset(&sSave, 0, sizeof(sSave));
+    memset(sSave.partyBadgesAndOtherSavedData, 0xA5, sizeof(sSave.partyBadgesAndOtherSavedData));
+    sSave.pos.x = 3; sSave.pos.y = 10;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    sSave.location.mapNum = MAP_NUM(MAP_TAICHUNG_OLD_STATION_GYM);
+    sSave.location.warpId = 1;
+    sSave.location.x = 6; sSave.location.y = 13;
+    sSave.objectEventTemplates[0].localId = 1;
+    sSave.objectEventTemplates[0].graphicsId = OBJ_EVENT_GFX_GYM_GUY;
+    gSaveBlock1Ptr = &sSave;
+    sPendingWarp = FALSE;
+    sHeaderReads = 0;
+}
+
+static void ExpectUnchanged(void)
+{
+    struct SaveBlock1 before = sSave;
+    TaichungJunRefreshOnContinue();
+    assert(memcmp(&sSave, &before, sizeof(sSave)) == 0);
+}
+
+int main(void)
+{
+    struct SaveBlock1 before;
+    Reset();
+    before = sSave;
+    TaichungJunRefreshOnContinue();
+    assert(sPendingWarp && sHeaderReads == 1);
+    assert(sSave.continueGameWarp.mapGroup == sSave.location.mapGroup);
+    assert(sSave.continueGameWarp.mapNum == sSave.location.mapNum);
+    assert(sSave.continueGameWarp.warpId == -1);
+    assert(sSave.continueGameWarp.x == 3 && sSave.continueGameWarp.y == 10);
+    before.continueGameWarp = sSave.continueGameWarp;
+    assert(memcmp(&before, &sSave, sizeof(sSave)) == 0);
+
+    Reset();
+    sSave.objectEventTemplates[0].localId = 0;
+    TaichungJunRefreshOnContinue();
+    assert(sPendingWarp); // Missing Station host cache also reloads safely.
+
+    Reset();
+    sSave.objectEventTemplates[0] = sObjects[0];
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); sPendingWarp = TRUE;
+    sSave.continueGameWarp.mapGroup = 1;
+    ExpectUnchanged(); assert(sHeaderReads == 0);
+
+    Reset(); sSave.location.mapGroup = 1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.location.mapNum = -1;
+    ExpectUnchanged(); assert(!sPendingWarp && sHeaderReads == 0);
+
+    Reset(); sSave.pos.x = 13;
+    ExpectUnchanged(); assert(!sPendingWarp);
+
+    Reset(); gSaveBlock1Ptr = NULL;
+    TaichungJunRefreshOnContinue(); assert(sHeaderReads == 0);
+    puts("PASS: stale Jun cache refresh at saved position; party/badges preserved; current caches, pending warps, unrelated maps and invalid inputs untouched");
+    return 0;
+}
