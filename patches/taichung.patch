@@ -0,0 +1,16 @@
+// Read-only local mGBA test origin; never writes to the production references.
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+const [qa, publicRoot] = process.argv.slice(2).map(value => resolve(value));
+const mime = {'.js':'text/javascript', '.wasm':'application/wasm', '.json':'application/json'};
+createServer(async (req,res) => {
+  const url = new URL(req.url,'http://127.0.0.1:8341');
+  const headers={'Cross-Origin-Opener-Policy':'same-origin','Cross-Origin-Embedder-Policy':'require-corp','Cache-Control':'no-store'};
+  if(url.pathname==='/') {res.writeHead(200,{...headers,'Content-Type':'text/html'});res.end('<!doctype html><title>North Xitun native QA</title><body></body>');return;}
+  const root=url.pathname.startsWith('/roms/')?qa:publicRoot;
+  const path=resolve(root,'.'+url.pathname);
+  if(!path.startsWith(root+'/')) {res.writeHead(404);res.end();return;}
+  try {const data=await readFile(path);res.writeHead(200,{...headers,'Content-Type':mime[path.slice(path.lastIndexOf('.'))]??'application/octet-stream'});res.end(data);}
+  catch {res.writeHead(404);res.end();}
+}).listen(8341,'127.0.0.1',()=>console.log('North Xitun native QA at http://127.0.0.1:8341'));
diff --git a/tools/taichung/boulevard_city/qa/tour.mjs b/tools/taichung/boulevard_city/qa/tour.mjs
