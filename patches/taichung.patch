+#!/usr/bin/env python3
+"""Independent checks of the actual OldCity clone/bank/map, with no source writes.
+
+Uses the compiler manifest as an address/remap contract, never imports its code.
+Static source checks do not claim ROM, animation, save-cache or runtime safety.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+from copy import deepcopy
+import hashlib
+import importlib.util
+from io import BytesIO
+import json
