+#!/usr/bin/env python3
+"""Native color proof: render contracts, flip packing, encodings and pilot egress."""
+import json
+from pathlib import Path
+import struct
+from tempfile import TemporaryDirectory
+
+from PIL import Image
+
+from color_compile import compile_colorways,native_tile_images,save_native
+from library import require,parse_words,render_tools
+from neighborhood_pilot import make_pilot,pilot_plan
+
+
+def check():
+    c=compile_colorways();lib=c['library'];recipe=c['recipe']
+    source_images=[Image.open(lib.source/'data/tilesets'/folder/'tiles.png') for folder in ('primary/general','secondary/pewter_city')]
+    original=render_tools().render_metatiles(lib.source,'General','PewterCity')
+    source_ids={word&1023 for p in lib.prefabs.values() for row in parse_words(p) for word in row}|{1}
+    compiled_images=native_tile_images(c,source_ids|{v for m in c['remaps'].values() for v in m.values()})
+    for tile in source_ids:
+        require(compiled_images[tile].tobytes()==original[tile].tobytes(),f'Base kit render changed after flip dedup:{tile:#x}')
+    # Reference shader reads original graphics and applies material recipes in
+    # displayed-pixel space. It never reads the packed variant graphic arrays.
+    roof_count=0
+    for family,mapping in c['remaps'].items():
+        pixel_remap={int(k):v for k,v in recipe['sourceMaterial']['neutralIndexRemap'].items()}
+        pixel_remap.update(zip(recipe['sourceMaterial']['sourceShadeIndicesLightToDark'],recipe['families'][family]))
+        allowed=set(recipe['sourceMaterial']['allowedSourcePixelIndices']);shades=set(recipe['sourceMaterial']['sourceShadeIndicesLightToDark'])
+        for source_id,new_id in mapping.items():
+            bank,index=(0,source_id) if source_id<640 else (1,source_id-640)
+            entries=lib.metatiles[bank][index*8:index*8+8];expected=Image.new('RGB',(16,16))
+            for layer in range(2):
+                for q in range(4):
+                    e=entries[layer*4+q];g=e&1023;b,n=(0,g) if g<640 else (1,g-640);sx,sy=n%16*8,n//16*8
+                    data=[source_images[b].getpixel((sx+x,sy+y)) for y in range(8) for x in range(8)]
+                    recolor=(e>>12 in recipe['sourceMaterial']['sourcePaletteBanks'] and set(data)<=allowed and bool(set(data)&shades))
+                    palette=c['palettes'][12 if recolor else e>>12]
+                    for y in range(8):
+                        for x in range(8):
+                            value=data[(7-y if e&0x800 else y)*8+(7-x if e&0x400 else x)]
+                            if value or layer==0:
+                                expected.putpixel((q%2*8+x,q//2*8+y),palette[pixel_remap[value] if recolor else value])
+            require(expected.tobytes()==compiled_images[new_id].tobytes(),f'Roof remap render differs:{family}/{source_id:#x}')
+            roof_count+=1
+    with TemporaryDirectory(prefix='taichung-native-colors-') as temp:
+        out=Path(temp);save_native(c,out);raw=(out/'tiles.4bpp').read_bytes()
+        unpacked=[tuple(v for byte in raw[i:i+32] for v in (byte&15,byte>>4)) for i in range(0,len(raw),32)]
+        require(unpacked==c['graphics'],'Native4bpp roundtrip changed pixel indices')
+        packed=(out/'metatiles.bin').read_bytes();entries=struct.unpack(f'<{len(packed)//2}H',packed)
+        require(list(entries)==[e for row in c['metatiles'] for e in row],'Native16-bit metatile roundtrip changed references/flips/palettes')
+        for e in entries:
+            require(e>>12<13,'Native metatile references invalid palette')
+            require((e&1023)<640+len(c['graphics']),'Native metatile references absent graphic')
+        palette=struct.unpack('<16H',(out/'12.gbapal').read_bytes())
+        decoded=[((v&31)*8,((v>>5)&31)*8,((v>>10)&31)*8) for v in palette]
+        require(decoded==c['palettes'][12],'BGR555 roundtrip changed target palette')
+    _,pilot=make_pilot(c,pilot_plan())
+    return dict(result='pass',baseMetatileRendersCompared=len(source_ids),roofRemapRendersCompared=roof_count,
+        graphics4bppRoundtripped=len(c['graphics']),metatileEntriesRoundtripped=len(c['metatiles'])*8,
+        paletteColorsBgr555Roundtripped=16,pilotReachableCells=pilot['reachableCells'],pilotExits=len(pilot['exits']),
+        pilotDoorApproaches=pilot['reservedEntrances'],nativeBankBudget=c['budget'])
+
+
+if __name__=='__main__':print(json.dumps(check(),indent=2))
