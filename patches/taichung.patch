@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+set -euo pipefail
+GAME_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+OUT="$GAME_ROOT/build/taichung-tests"
+mkdir -p "$OUT"
+# The v10 tables in src/taichung_save.c must equal a fresh derivation from the released (2c48f28) and
+# reworked maps. Until the reworked districts land in this checkout, SAVE_V10_TREE names a tree that has them.
+check=(python3 -B "$GAME_ROOT/tools/taichung/city_rework/save_v10.py")
+if [ -n "${SAVE_V10_TREE:-}" ]; then check+=(--new "$SAVE_V10_TREE"); fi
+"${check[@]}" > "$OUT/save-v10-check.json" || {
+  cat "$OUT/save-v10-check.json"
+  echo "save v10 tables do not match the maps; SAVE_V10_TREE=${SAVE_V10_TREE:-<unset>}" >&2
+  exit 1
+}
+# Compose only the new art layer after the historical v10 expectations.
+python3 -B "$GAME_ROOT/tools/taichung_gameplay/generate-approved-art-save.py" \
+  --host-truth "$OUT/save-v11-expect.inc" > "$OUT/save-v11-check.json"
+# Flatten the committed v10 record for the C test, which never reads the C tables back: per district
+# "constant dx dy releasedW releasedH reworkedW reworkedH repairs", then one "sx sy tx ty" per repair.
+python3 -B - "$GAME_ROOT/data/taichung/city-rework/save-v10.json" > "$OUT/save-v10.txt" <<'PY'
+import json, sys
+for m in json.load(open(sys.argv[1]))["maps"]:
+    print(m["constant"], *m["shift"], *m["releasedSize"], *m["reworkedSize"], len(m["repairs"]))
+    print("".join("%d %d %d %d\n" % tuple(r) for r in m["repairs"]), end="")
+PY
+cc -std=c99 -Wall -Wextra -Werror -I"$GAME_ROOT/tests/save_host" -I"$GAME_ROOT/include" -I"$OUT" \
+  "$GAME_ROOT/src/taichung_save.c" "$GAME_ROOT/tests/taichung_save_test.c" \
+  -o "$OUT/save"
+# Independent collision truth for the v9 tests; never copy its expected origin set from the C
+# implementation. 6366b9e is Xitun before the Maple collision, 2c48f28 the released v9 map (the
+# checkout's own Xitun becomes the reworked 45x69 map). This writes only ignored host-test output.
+git -C "$GAME_ROOT" show 6366b9e5c037647ce4d2a007efa3d3dfbedcdb48:data/layouts/TaichungXitun/map.bin > "$OUT/xitun-before-v9.bin"
+git -C "$GAME_ROOT" show 2c48f28b998b67413baf058557752723ea121500:data/layouts/TaichungXitun/map.bin > "$OUT/xitun-released-v9.bin"
+"$OUT/save" "$OUT/xitun-before-v9.bin" "$OUT/xitun-released-v9.bin" "$OUT/save-v10.txt"
+python3 "$GAME_ROOT/tools/taichung_gameplay/test-save-facing.py"
