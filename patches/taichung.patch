@@ -0,0 +1,159 @@
+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<title>Tile limit probe QA</title>
+<style>
+  html, body { margin: 0; background: #000; }
+  canvas { width: 240px; height: 160px; image-rendering: pixelated; display: block; }
+</style>
+<canvas id="screen" width="240" height="160"></canvas>
+<script type="module">
+  import createMgba from '/mgba.js';
+
+  const canvas = document.getElementById('screen');
+  const originalGetContext = canvas.getContext.bind(canvas);
+  canvas.getContext = (type, attributes) => originalGetContext(type,
+    ['webgl', 'webgl2', 'experimental-webgl'].includes(type) ? { ...attributes, preserveDrawingBuffer: true } : attributes);
+  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+  let emulator, ewram = null, addresses = {};
+  const recorder = { frames: [], gaps: 0, on: false, timer: null, tag: '', last: -1 };
+
+  function heap() {
+    const h = emulator.getTaichungHeapU8();
+    if (!h || h.byteOffset !== 0) throw new Error('runtime heap unavailable');
+    return h;
+  }
+  // The navigation bridge the game already publishes carries its own GBA
+  // address, which places all of EWRAM inside the runtime's heap.
+  function locate() {
+    const h = heap(); const words = new Uint32Array(h.buffer, 0, h.byteLength >> 2);
+    const found = [];
+    for (let i = 0; i + 12 <= words.length; i++) {
+      if (words[i] === 0x414e4354 && words[i + 1] === 0x31303056 && words[i + 3] === addresses.nav) found.push(i * 4 - (addresses.nav - 0x02000000));
+    }
+    if (found.length !== 1) throw new Error(`navigation bridge found ${found.length} times`);
+    ewram = found[0];
+    return ewram;
+  }
+  function view() {
+    const h = heap();
+    if (ewram === null) locate();
+    return new DataView(h.buffer, ewram, 0x40000);
+  }
+
+  window.qa = {
+    async load(symbols, withSave) {
+      addresses = symbols;
+      const rom = new Uint8Array(await (await fetch('/rom.gba', { cache: 'no-store' })).arrayBuffer());
+      emulator = await createMgba({ canvas });
+      await emulator.FSInit();
+      emulator.setCoreSettings({ autoSaveStateEnable: false, restoreAutoSaveStateOnLoad: false, rewindEnable: false, allowOpposingDirections: false });
+      const token = crypto.randomUUID();
+      const romPath = `${emulator.filePaths().gamePath}/probe-${token}.gba`;
+      const savePath = `${emulator.filePaths().savePath}/probe-${token}.sav`;
+      emulator.FS.writeFile(romPath, rom);
+      if (withSave) emulator.FS.writeFile(savePath, new Uint8Array(await (await fetch('/start.sav', { cache: 'no-store' })).arrayBuffer()));
+      if (!emulator.loadGame(romPath, savePath)) throw new Error('mGBA could not open the cartridge');
+      emulator.toggleInput(false);
+      emulator.setMainLoopTiming(0, 16);
+      emulator.setVolume(0);
+      return rom.length;
+    },
+    async press(key, ms = 100, after = 150) {
+      emulator.buttonPress(key); await wait(ms); emulator.buttonUnpress(key); await wait(after);
+    },
+    down(key) { emulator.buttonPress(key); },
+    up(key) { emulator.buttonUnpress(key); },
+    wait,
+    speed(multiplier) { emulator.setFastForwardMultiplier(multiplier); return emulator.getFastForwardMultiplier(); },
+    state() {
+      let v;
+      try { v = view(); } catch (error) { return { error: error.message }; }
+      const n = addresses.nav - 0x02000000, s = addresses.stats - 0x02000000;
+      const flags = v.getUint32(n + 24, true);
+      return {
+        frame: v.getUint32(n + 20, true), flags, context: v.getUint16(n + 40, true),
+        field: (flags & 7) === 7 && v.getUint16(n + 40, true) === 0,
+        x: v.getInt16(n + 28, true), y: v.getInt16(n + 30, true), group: v.getUint8(n + 32), map: v.getUint8(n + 33), facing: v.getUint8(n + 34),
+        stream: {
+          active: v.getUint32(s, true) === 0x52545354,
+          residentTiles: v.getUint16(s + 4, true), peakTiles: v.getUint16(s + 6, true), dynamicSlots: v.getUint16(s + 8, true), overflowTiles: v.getUint16(s + 10, true),
+          residentPals: v.getUint16(s + 12, true), peakPals: v.getUint16(s + 14, true), overflowPals: v.getUint16(s + 16, true), resets: v.getUint16(s + 18, true),
+          tileLoads: v.getUint32(s + 20, true), palLoads: v.getUint32(s + 24, true),
+        },
+        // times are CPU cycles; a frame is 280,896
+        timing: (() => {
+          const u = o => v.getUint32(s + o, true);
+          const late = [];
+          for (let i = 0; i < 8; i++) {
+            const o = 0x5c + i * 12;
+            if (u(o)) late.push({ frameCycles: u(o), drawCycles: u(o + 4), flags: v.getUint16(s + o + 8, true), cells: v.getUint16(s + o + 10, true) });
+          }
+          return { lastSlice: u(0x1c), maxSlice: u(0x20), sliceSum: u(0x24), slices: u(0x28), lastWhole: u(0x2c), mainLoops: u(0x30), vblanks: u(0x34), lateFrames: u(0x38),
+                   fieldFrames: u(0x3c), fieldFrameSum: u(0x40), maxPlainFrame: u(0x44), maxSliceFrame: u(0x48), metatileSum: u(0x4c), metatilesDrawn: u(0x50), pendingMax: u(0x54),
+                   lateIndex: v.getUint16(s + 0x5a, true), late, loadCells: u(0xbc), loadCellSum: u(0xc0), maxCell: u(0xc4), cellsUnchanged: u(0xcc) };
+        })(),
+      };
+    },
+    frame() { return canvas.toDataURL('image/png'); },
+    startMenuAction() {
+      const v = view();
+      const cursor = v.getUint8(addresses.startCursor - 0x02000000);
+      return v.getUint8(addresses.startOrder - 0x02000000 + cursor);
+    },
+    battleActionReady() {
+      const v = view();
+      return (v.getUint32(addresses.battleExec - 0x02000000, true) & 1) !== 0
+        && v.getUint8(addresses.battleBuffer - 0x02000000) === 18; // CONTROLLER_CHOOSEACTION
+    },
+    saveBase64() {
+      const bytes = emulator.getSave(); if (!bytes) return null;
+      let s = ''; for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+      return btoa(s);
+    },
+    async reset() { await emulator.FSSync(); emulator.quickReload(); emulator.setMainLoopTiming(0, 16); ewram = null; },
+    pace(ms) { emulator.setMainLoopTiming(0, ms); },
+
+    // Hold directions one after another with no pause between them: [[key, tiles], ...].
+    // A tile counts when the reported position or map changes. Returns the tiles moved for each.
+    async run(sequence, timeoutMs = 1500) {
+      const moved = [];
+      let last = window.qa.state();
+      for (const [key, tiles] of sequence) {
+        let n = 0, idle = performance.now();
+        emulator.buttonPress(key);
+        while (n < tiles) {
+          await wait(4);
+          const now = window.qa.state();
+          const hasPosition = now.x >= 0 && now.y >= 0 && now.map !== 255;
+          if (hasPosition && (now.x !== last.x || now.y !== last.y || now.map !== last.map)) { n++; idle = performance.now(); last = now; }
+          else if (performance.now() - idle > timeoutMs) break;
+        }
+        emulator.buttonUnpress(key);
+        moved.push(n);
+      }
+      return moved;
+    },
+
+    // Capture every frame the game shows: the picture plus the game's own counters at that moment.
+    recordStart(tag) {
+      const rec = recorder; rec.tag = tag; rec.last = -1; rec.on = true;
+      if (rec.timer) return;
+      rec.timer = setInterval(() => {
+        if (!rec.on) return;
+        const st = window.qa.state();
+        if (st.error || st.timing.vblanks === rec.last) return;
+        rec.gaps += rec.last >= 0 && st.timing.vblanks !== rec.last + 1 ? 1 : 0;
+        rec.last = st.timing.vblanks;
+        rec.frames.push({ tag: rec.tag, v: st.timing.vblanks, x: st.x, y: st.y, map: st.map, group: st.group, field: st.field, flags: st.flags, context: st.context, facing: st.facing,
+                          tiles: st.stream.residentTiles, pals: st.stream.residentPals, overflowTiles: st.stream.overflowTiles, overflowPals: st.stream.overflowPals,
+                          late: st.timing.lateFrames, png: canvas.toDataURL('image/png').slice(22) });
+      }, 3);
+    },
+    recordTag(tag) { recorder.tag = tag; },
+    recordStop() { recorder.on = false; return { waiting: recorder.frames.length, gaps: recorder.gaps }; },
+    recordTake(count) { return recorder.frames.splice(0, count); },
+  };
+  window.qaReady = true;
+</script>
+</html>
