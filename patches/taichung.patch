+#!/usr/bin/env python3
+"""Compile the real navigation publisher against bounded native API mocks."""
+
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[2]
+GLOBAL = """#ifndef NAV_TEST_GLOBAL_H
+#define NAV_TEST_GLOBAL_H
+#include <stddef.h>
+#include "gba/types.h"
+#define EWRAM_DATA
+// The host address is truncated by the actual native adapter; accept its
+// nonzero aligned low 32 bits, while still testing NULL rejection.
+#define EWRAM_START 1
+#define EWRAM_END 0xFFFFFFFFu
+#define TRUE 1
+#define FALSE 0
+#define OBJECT_EVENTS_COUNT 16
+#define PLAYER_AVATAR_FLAG_ON_FOOT 1
+#define PLAYER_AVATAR_FLAG_MACH_BIKE 2
+#define PLAYER_AVATAR_FLAG_ACRO_BIKE 4
+#define PLAYER_AVATAR_FLAG_SURFING 8
+#define PLAYER_AVATAR_FLAG_UNDERWATER 16
+#define PLAYER_AVATAR_FLAG_CONTROLLABLE 32
+#define NOT_MOVING 0
+#define MOVING 2
+#define DIR_SOUTH 1
+#define DIR_NORTH 2
+#define DIR_WEST 3
+#define DIR_EAST 4
+#define MAP_OFFSET 7
+#define NUM_TEXT_PRINTERS 32
+#define QL_PLAYBACK_STATE_RUNNING 1
+#define QL_IS_PLAYBACK_STATE sReplay
+struct WarpData { s8 mapGroup, mapNum; };
+struct SaveBlock1 { u32 alignment; struct WarpData location; };
+struct Coords { s16 x, y; };
+struct ObjectEvent { bool8 active, isPlayer; struct Coords currentCoords; u8 facingDirection; };
+struct PlayerAvatar { u8 flags, objectEventId, runningState; };
+struct MapLayout { s32 width, height; };
+struct MapHeader { const struct MapLayout *mapLayout; u8 mapType; };
+struct Main { bool8 inBattle; };
+struct PaletteFade { bool8 active; };
+extern struct SaveBlock1 *gSaveBlock1Ptr;
+extern struct ObjectEvent gObjectEvents[OBJECT_EVENTS_COUNT];
+extern struct PlayerAvatar gPlayerAvatar;
+extern struct MapHeader gMapHeader;
+extern struct Main gMain;
+extern struct PaletteFade gPaletteFade;
+extern void (*gFieldCallback)(void);
+extern bool8 (*gFieldCallback2)(void);
+extern bool8 gReceivedRemoteLinkPlayers;
+extern bool8 sReplay;
+bool8 Overworld_IsMainFieldCallback(void);
+bool8 ArePlayerFieldControlsLocked(void);
+bool8 ScriptContext_IsEnabled(void);
+bool8 IsFieldMessageBoxHidden(void);
+bool8 IsTextPrinterActive(u8);
+bool8 IsUpdateLinkStateCBActive(void);
+u8 QL_GetPlaybackState(void);
+void PlayerGetDestCoords(s16 *, s16 *);
+u8 GetPlayerFacingDirection(void);
+bool8 IsMapTypeOutdoors(u8);
+bool8 TestPlayerAvatarFlags(u8);
+bool8 TaichungCanToggleBike(void);
+#endif
+"""
+TEST = r"""
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_navigation_bridge.h"
+#include "constants/map_types.h"
+struct SaveBlock1 *gSaveBlock1Ptr;
+struct ObjectEvent gObjectEvents[OBJECT_EVENTS_COUNT];
+struct PlayerAvatar gPlayerAvatar;
+struct MapHeader gMapHeader;
+struct Main gMain;
+struct PaletteFade gPaletteFade;
+void (*gFieldCallback)(void);
+bool8 (*gFieldCallback2)(void);
+bool8 gReceivedRemoteLinkPlayers, sReplay;
+static struct SaveBlock1 sSave;
+static struct MapLayout sLayout;
+static bool8 sField, sLocked, sScript, sMessage, sPrinter, sLink, sCanBike;
+static u8 sPlayback;
+static unsigned sPositionReads;
+bool8 Overworld_IsMainFieldCallback(void) { return sField; }
+bool8 ArePlayerFieldControlsLocked(void) { return sLocked; }
+bool8 ScriptContext_IsEnabled(void) { return sScript; }
+bool8 IsFieldMessageBoxHidden(void) { return !sMessage; }
+bool8 IsTextPrinterActive(u8 printer) { return sPrinter && printer == 0; }
+bool8 IsUpdateLinkStateCBActive(void) { return sLink; }
+u8 QL_GetPlaybackState(void) { return sPlayback; }
+void PlayerGetDestCoords(s16 *x, s16 *y) { sPositionReads++; *x = gObjectEvents[0].currentCoords.x; *y = gObjectEvents[0].currentCoords.y; }
+u8 GetPlayerFacingDirection(void) { return gObjectEvents[0].facingDirection; }
+bool8 IsMapTypeOutdoors(u8 type) { return type == MAP_TYPE_TOWN || type == MAP_TYPE_CITY || type == MAP_TYPE_ROUTE; }
+bool8 TestPlayerAvatarFlags(u8 flags) { return (gPlayerAvatar.flags & flags) != 0; }
+bool8 TaichungCanToggleBike(void) { return sCanBike; }
+static void Callback(void) {}
+static void ResetField(void) {
+    sField = TRUE; sLocked = sScript = sMessage = sPrinter = sLink = sCanBike = sReplay = FALSE; sPlayback = 0;
+    gReceivedRemoteLinkPlayers = FALSE; gFieldCallback = NULL; gFieldCallback2 = NULL;
+    gMain.inBattle = FALSE; gPaletteFade.active = FALSE;
+    gSaveBlock1Ptr = &sSave; sSave.location.mapGroup = 43; sSave.location.mapNum = 0;
+    sLayout.width = 40; sLayout.height = 72; gMapHeader.mapLayout = &sLayout; gMapHeader.mapType = MAP_TYPE_TOWN;
+    memset(gObjectEvents, 0, sizeof gObjectEvents);
+    gObjectEvents[0].active = TRUE; gObjectEvents[0].isPlayer = TRUE; gObjectEvents[0].currentCoords.x = 37;
+    gObjectEvents[0].currentCoords.y = 73; gObjectEvents[0].facingDirection = DIR_SOUTH;
+    gPlayerAvatar.objectEventId = 0;
+    gPlayerAvatar.flags = PLAYER_AVATAR_FLAG_ON_FOOT | PLAYER_AVATAR_FLAG_CONTROLLABLE;
+    gPlayerAvatar.runningState = NOT_MOVING;
+}
+static void Hidden(u16 expected, bool8 callbacks) {
+    unsigned before = sPositionReads;
+    u32 frame = gTaichungNavigationBridge.frameCounter;
+    TaichungNavigationBridge_Tick(callbacks);
+    assert(gTaichungNavigationBridge.sequence != 0 && !(gTaichungNavigationBridge.sequence & 1));
+    assert(gTaichungNavigationBridge.frameCounter != frame);
+    assert(gTaichungNavigationBridge.contextFlags & expected);
+    assert(!(gTaichungNavigationBridge.flags & TAICHUNG_NAVIGATION_POSITION_VALID));
+    assert(gTaichungNavigationBridge.localX == -1 && gTaichungNavigationBridge.localY == -1);
+    assert(gTaichungNavigationBridge.mapGroup == 255 && gTaichungNavigationBridge.mapNum == 255);
+    assert(gTaichungNavigationBridge.reserved16 == 0 && gTaichungNavigationBridge.reserved32 == 0);
+    if (expected <= TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE) assert(sPositionReads == before);
+}
+int main(void) {
+    u32 frame, sequence;
+    unsigned state;
+    const u8 locomotion[] = {PLAYER_AVATAR_FLAG_ON_FOOT, PLAYER_AVATAR_FLAG_MACH_BIKE,
+                            PLAYER_AVATAR_FLAG_ACRO_BIKE, PLAYER_AVATAR_FLAG_SURFING,
+                            PLAYER_AVATAR_FLAG_UNDERWATER};
+    struct SaveBlock1 before;
+    assert(sizeof(gTaichungNavigationBridge) == 48);
+    Hidden(TAICHUNG_NAVIGATION_CONTEXT_NOT_FIELD, FALSE);
+    ResetField(); before = sSave;
+    TaichungNavigationBridge_Tick(TRUE);
+    assert(gTaichungNavigationBridge.magicA == TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A);
+    assert(gTaichungNavigationBridge.magicB == TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B);
+    assert(gTaichungNavigationBridge.version == 1 && gTaichungNavigationBridge.size == 48);
+    assert(gTaichungNavigationBridge.contextFlags == 0 && gTaichungNavigationBridge.flags == 15);
+    assert(gTaichungNavigationBridge.localX == 30 && gTaichungNavigationBridge.localY == 66);
+    assert(gTaichungNavigationBridge.mapWidth == 40 && gTaichungNavigationBridge.mapHeight == 72);
+    assert(gTaichungNavigationBridge.mapGroup == 43 && gTaichungNavigationBridge.mapNum == 0);
+    frame = gTaichungNavigationBridge.frameCounter; sequence = gTaichungNavigationBridge.sequence;
+    TaichungNavigationBridge_Tick(TRUE);
+    assert(gTaichungNavigationBridge.frameCounter == frame + 1 && gTaichungNavigationBridge.sequence == sequence + 2);
+    sCanBike = TRUE; gPlayerAvatar.flags |= PLAYER_AVATAR_FLAG_MACH_BIKE;
