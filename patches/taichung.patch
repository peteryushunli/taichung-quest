+        path=ROOT/'data/taichung/landmarks'/identity/name
+        art=Image.open(path)
+        assert art.mode=='P' and art.getextrema()[1]<=15
+        station=Image.open(ROOT/'data/taichung/landmarks/old-station/native.png')
+        assert art.getpalette()[:48]==station.getpalette()[:48],identity
+        w,h=art.width//16,art.height//16;occupied=[];mapping={}
+        for y in range(h):
+            for x in range(w):
+                ink=any(art.getpixel((x*16+dx,y*16+dy)) for dy in range(16) for dx in range(16))
+                if fixed is None and not ink:continue
+                top=[scene.pack(pixels(art,(y*2+dy)*(art.width//8)+x*2+dx))|0x7000 for dy in range(2) for dx in range(2)]
+                entries=grass+top;attr=0x20000000 if y==h-1 else 0
