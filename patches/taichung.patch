+#!/usr/bin/env python3
+"""Compile shared-bank roof colorways into native indexed graphics/metatiles."""
+import argparse
+from copy import deepcopy
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image
+
+from library import ROOT,Library,parse_words,require
+
+
+def flip(pixels,h=False,v=False):
+    return tuple(pixels[(7-y if v else y)*8+(7-x if h else x)] for y in range(8) for x in range(8))
+
+
+def compile_colorways(source=ROOT,catalog=None,colorways=None,variant_metatile_start=None):
+    """Return encodable bank arrays; caller owns final native registration/merging.
+
+    graphics are64 indexed pixels each; entries contain global graphics IDs.
+    secondary metatile IDs preserve the original source-entry range. The
+    variant start can be moved by the integrator to avoid landmark allocations.
+    """
+    library=Library(source,catalog or ROOT/'data/taichung/prefabs/catalog.json');library.validate()
+    recipe=json.loads(Path(colorways or ROOT/'data/taichung/prefabs/colorways.json').read_text())
+    images=[Image.open(Path(source)/'data/tilesets'/folder/'tiles.png') for folder in ('primary/general','secondary/pewter_city')]
+    def source_pixels(graphic):
+        bank,n=(0,graphic) if graphic<640 else (1,graphic-640)
+        sx,sy=n%16*8,n//16*8
+        return tuple(images[bank].getpixel((sx+x,sy+y)) for y in range(8) for x in range(8))
+    graphics=[];graphic_lookup={};source_graphics={}
+    def pack(pixels):
+        variants=[(pixels,0),(flip(pixels,True),0x400),(flip(pixels,False,True),0x800),(flip(pixels,True,True),0xc00)]
+        canonical,flags=min(variants,key=lambda p:(p[0],p[1]))
+        if canonical not in graphic_lookup:
+            graphic_lookup[canonical]=len(graphics);graphics.append(canonical)
+        return 640+graphic_lookup[canonical],flags
+    def base_entry(entry):
+        graphic=entry&0x3ff
+        if graphic<640:return entry
+        new,flags=pack(source_pixels(graphic));source_graphics[str(graphic-640)]=new-640
+        return new|((entry&0xc00)^flags)|(entry&0xf000)
+    used=set(w&0x3ff for p in library.prefabs.values() for row in parse_words(p) for w in row)
+    count=len(library.attributes[1]);metatiles=[[0]*8 for _ in range(count)];attributes=[0]*count
+    for tile in sorted(t for t in used if t>=640):
+        i=tile-640;metatiles[i]=[base_entry(e) for e in library.metatiles[1][i*8:i*8+8]];attributes[i]=library.attributes[1][i]
+    base_graphics_count=len(graphics)
+    palettes=[]
+    for bank in range(13):
+        folder='primary/general' if bank<7 else 'secondary/pewter_city'
+        lines=(Path(source)/'data/tilesets'/folder/'palettes'/f'{bank:02}.pal').read_text().splitlines()[3:]
+        palettes.append([tuple(map(int,line.split())) for line in lines if line.strip()])
+    palette12=[tuple(item['rgb8']) for item in recipe['palette']]
+    require(len(palette12)==16 and all(all(0<=v<=248 and v%8==0 for v in c) for c in palette12),'Palette12 must be exactly16 native5-bit-aligned colors')
+    palettes[12]=palette12
+    source_material=recipe['sourceMaterial'];shades=source_material['sourceShadeIndicesLightToDark'];allowed=set(source_material['allowedSourcePixelIndices'])
+    def recolorable(entry):
+        colors=set(source_pixels(entry&0x3ff))
+        return entry>>12 in source_material['sourcePaletteBanks'] and colors<=allowed and bool(colors&set(shades))
+    eligible=set()
+    for identity in recipe['eligiblePrefabs']:
+        for y,row in enumerate(parse_words(library.prefabs[identity])):
+            if y not in recipe['roofRows']:continue
+            for word in row:
+                tile=word&0x3ff;bank,index=(0,tile) if tile<640 else (1,tile-640)
+                if any(recolorable(e) for e in library.metatiles[bank][index*8:index*8+8]):eligible.add(tile)
+    start=variant_metatile_start if variant_metatile_start is not None else 640+len(metatiles)
+    require(start>=640+len(metatiles),'Variant metatiles overlap source range')
+    while len(metatiles)<start-640:metatiles.append([0]*8);attributes.append(0)
+    remaps={};variant_entries={};source_roof_graphics=set()
+    for family,ramp in recipe['families'].items():
