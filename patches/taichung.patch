+static void Task_CityPassInput(u8 taskId)
+{
+    u8 choice;
+    if (gPaletteFade.active)
+        return;
+    if (gTasks[taskId].data[0] == 0)
+    {
+        if (JOY_NEW(A_BUTTON))
+            gTasks[taskId].data[0] = 1;
+        else if (JOY_NEW(B_BUTTON | START_BUTTON))
+            gTasks[taskId].data[0] = 2;
+        else
+            return;
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+    }
+    else
+    {
+        choice = gTasks[taskId].data[0];
+        DestroyTask(taskId);
+        SetVBlankCallback(NULL);
+        FreeAllWindowBuffers();
+        if (choice == 1)
+            ShowPlayerTrainerCard(CB2_ReopenCityPass);
+        else
+            SetMainCallback2(sReturnCallback);
+    }
+}
diff --git a/src/taichung_exploration.c b/src/taichung_exploration.c
new file mode 100644
index 0000000..e396c0f
--- /dev/null
+++ b/src/taichung_exploration.c
@@ -0,0 +1,66 @@
+#include "global.h"
+#include "event_data.h"
+#include "taichung_exploration.h"
+#include "constants/vars.h"
+
+static u16 GetPreferenceVar(u16 setting)
+{
+    if (setting == TAICHUNG_EXPLORATION_WILD)
+        return TAICHUNG_EXPLORATION_WILD_VAR;
+    if (setting == TAICHUNG_EXPLORATION_SIGHT)
+        return TAICHUNG_EXPLORATION_SIGHT_VAR;
+    return 0;
+}
+
+u8 TaichungExplorationGetMode(u16 setting)
+{
+    u16 variable = GetPreferenceVar(setting);
+    // VarGet replays quest-log values into the save during recap playback.
+    // Preferences describe the current player, rather than a recorded scene.
+    u16 mode = variable && gSaveBlock1Ptr ? gSaveBlock1Ptr->vars[variable - VARS_START] : TAICHUNG_EXPLORATION_UNSET;
+    if (mode < TAICHUNG_EXPLORATION_OFF || mode > TAICHUNG_EXPLORATION_NORMAL)
+        return TAICHUNG_EXPLORATION_NORMAL;
+    return mode;
+}
+
+bool8 TaichungExplorationSetMode(u16 setting, u16 mode)
+{
+    u16 variable = GetPreferenceVar(setting);
+    if (!variable || mode < TAICHUNG_EXPLORATION_OFF || mode > TAICHUNG_EXPLORATION_NORMAL)
+        return FALSE;
+    return VarSet(variable, mode);
+}
+
+bool8 TaichungExplorationAllowsAutomaticWild(bool8 temporarilyDisabled)
+{
+    return !temporarilyDisabled && TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD) != TAICHUNG_EXPLORATION_OFF;
+}
+
+u32 TaichungExplorationAdjustAutomaticWildRate(u32 rate)
+{
+    u8 mode = TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD);
+    if (mode == TAICHUNG_EXPLORATION_OFF)
+        return 0;
+    if (mode == TAICHUNG_EXPLORATION_LOW && rate > 0)
+    {
+        rate /= 4;
+        if (rate == 0)
+            rate = 1;
+    }
+    return rate;
+}
+
+bool8 TaichungExplorationAllowsTrainerSight(void)
+{
+    return TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT) != TAICHUNG_EXPLORATION_OFF;
+}
+
+u8 TaichungExplorationGetTrainerSightRange(u8 configuredRange)
+{
+    u8 mode = TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT);
+    if (mode == TAICHUNG_EXPLORATION_OFF)
+        return 0;
+    if (mode == TAICHUNG_EXPLORATION_LOW && configuredRange > 1)
+        return 1;
+    return configuredRange;
+}
