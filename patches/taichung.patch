@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Serve only the isolated QA harness, supplied feature ROM and mGBA runtime."""
+
+import argparse
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from urllib.parse import urlsplit
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rom", type=Path, required=True)
+    parser.add_argument("--runtime", type=Path, required=True, help="Directory containing mgba.js and mgba.wasm")
+    parser.add_argument("--port", type=int, default=8786)
+    args = parser.parse_args()
+    routes = {
+        "/": (Path(__file__).with_name("qa.html"), "text/html; charset=utf-8"),
+        "/qa.html": (Path(__file__).with_name("qa.html"), "text/html; charset=utf-8"),
+        "/mgba.js": (args.runtime / "mgba.js", "text/javascript; charset=utf-8"),
+        "/mgba.wasm": (args.runtime / "mgba.wasm", "application/wasm"),
+        "/mapping.gba": (args.rom, "application/octet-stream"),
+    }
+    for path, _ in routes.values():
+        if not path.is_file():
+            parser.error(f"Missing input: {path}")
+
+    class Handler(BaseHTTPRequestHandler):
+        def end_headers(self):
+            self.send_header("Cross-Origin-Opener-Policy", "same-origin")
+            self.send_header("Cross-Origin-Embedder-Policy", "require-corp")
+            self.send_header("Cross-Origin-Resource-Policy", "same-origin")
+            self.send_header("Cache-Control", "no-store")
+            super().end_headers()
+
+        def do_GET(self):
+            self.serve(head=False)
+
+        def do_HEAD(self):
+            self.serve(head=True)
+
+        def serve(self, head):
+            route = routes.get(urlsplit(self.path).path)
+            if route is None:
+                self.send_error(404)
+                return
+            path, mime = route
+            self.send_response(200)
+            self.send_header("Content-Type", mime)
+            self.send_header("Content-Length", str(path.stat().st_size))
+            self.end_headers()
+            if not head:
+                with path.open("rb") as file:
+                    while chunk := file.read(1024 * 1024):
+                        self.wfile.write(chunk)
+
+    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
+    print(f"Isolated mapping QA: http://127.0.0.1:{args.port}/", flush=True)
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/taichung/render_maps.py b/tools/taichung/render_maps.py
