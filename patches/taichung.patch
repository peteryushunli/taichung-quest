+#!/usr/bin/env python3
+"""Refresh shapes and append missing glyphs while preserving all FC19 indices.
+
+Never regenerates content, translations, menus, scripts or existing mappings.
+Dry-run by default. Uses the same provider as extend-chinese-glyphs.py.
+"""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+
+SPEC = importlib.util.spec_from_file_location('taichung_extend', Path(__file__).with_name('extend-chinese-glyphs.py'))
+EXTEND = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(EXTEND)
+glyph_records, load_font, sha256 = EXTEND.glyph_records, EXTEND.load_font, EXTEND.sha256
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument('--artifacts', type=Path, required=True)
+    parser.add_argument('--font', type=Path, help='Legacy Noto file only for older checkouts without a bitmap manifest')
+    parser.add_argument('--corpus', type=Path, help='Optional extra UTF8 corpus; only missing glyphs are consumed, never content generation')
+    parser.add_argument('--write', action='store_true')
+    args = parser.parse_args()
+    game = args.game.resolve()
+    cmap_path, header_path = game / 'charmap.txt', game / 'src/data/taichung_glyphs.h'
+    cmap, header = cmap_path.read_bytes(), header_path.read_bytes()
+    existing = EXTEND.parse_existing(cmap, header)
+    sources, characters = EXTEND.native_sources(game)
+    corpus = args.corpus.read_bytes() if args.corpus else None
+    if corpus is not None:
+        characters.update(filter(EXTEND.is_chinese, corpus.decode('utf8')))
+    missing = sorted(characters - set(existing['mappings']))
+    font = load_font(game, args.font)
+    records = glyph_records(font, [row['character'] for row in existing['rows']] + missing, 0)
+    additions = records[len(existing['rows']):]
+    new_cmap, _ = EXTEND.extend(cmap, header, existing, additions)
+    rows = ''.join('    {' + ', '.join(f'0x{x:03x}' for x in row['masks'])
+                   + f"}}, // {row['index']}: {row['character']}\n" for row in records)
+    new_header = ('// Generated by tools/taichung_gameplay/refresh-chinese-glyphs.py.\n'
+                  '// Taichung Native Bitmap12; source/licenses: assets/fonts/taichung-native-font.json\n'
+                  'static const u16 sTaichungChineseGlyphs[][14] = {\n' + rows + '};\n').encode('utf8')
+    candidate = EXTEND.parse_existing(new_cmap, new_header)
+    if not new_cmap.startswith(cmap) or any(candidate['mappings'].get(c) != value for c, value in existing['mappings'].items()):
+        raise ValueError('Refusing to alter any existing character encoding')
+    if [r['character'] for r in candidate['rows'][:len(existing['rows'])]] != [r['character'] for r in existing['rows']]:
+        raise ValueError('Refusing to renumber a released glyph')
+    changed = sum(a['masks'] != b['masks'] for a, b in zip(existing['rows'], candidate['rows']))
+    if args.write:
+        current_sources, _ = EXTEND.native_sources(game)
+        if current_sources != sources or cmap_path.read_bytes() != cmap or header_path.read_bytes() != header:
+            raise ValueError('Font/content inputs changed during preparation; rerun')
+        if args.corpus and args.corpus.read_bytes() != corpus:
+            raise ValueError('Extra corpus changed during preparation; rerun')
+        if new_cmap != cmap:
+            cmap_path.write_bytes(new_cmap)
+        if new_header != header:
+            header_path.write_bytes(new_header)
+    report = {'mode': 'write' if args.write else 'dry-run', 'game': str(game),
+              'existingGlyphCount': len(existing['rows']), 'addedGlyphCount': len(additions),
+              'glyphCount': len(records), 'changedExistingShapes': changed,
+              'allExistingMappingsAndIndicesUnchanged': True,
+              'originalCharmapBytesPreservedAsPrefix': True,
+              'fontSource': font.metadata,
+              'before': {'charmapSha256': sha256(cmap), 'headerSha256': sha256(header)},
+              'candidate': {'charmapSha256': sha256(new_cmap), 'headerSha256': sha256(new_header)},
+              'sourceSha256': {str(path.relative_to(game)): sha256(raw) for path, raw in sources.items()},
+              'additions': [{k: row[k] for k in ('character', 'index', 'encoding')} for row in additions],
+              'scope': 'Glyph shapes and append-only missing glyphs. No translation/menu/script/content writes.'}
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    output = args.artifacts / 'refresh-chinese-glyphs.json'
+    output.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({'mode': report['mode'], 'glyphCount': len(records),
+                      'changedShapes': changed, 'added': len(additions),
+                      'preservedAllIndices': True, 'report': str(output)}))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (OSError, ValueError, KeyError) as error:
+        raise SystemExit(str(error))
diff --git a/tools/taichung_gameplay/render-landmark-history.py b/tools/taichung_gameplay/render-landmark-history.py
new file mode 100644
index 0000000..3ecdbcf
--- /dev/null
+++ b/tools/taichung_gameplay/render-landmark-history.py
@@ -0,0 +1,174 @@
+#!/usr/bin/env python3
+"""Render source-backed bilingual history records; check native page bounds.
+
+Only --write replaces the generated C data module. Source records, the existing
+charmap and font are never edited. Missing glyphs are reported for Main's final
+append-only union, not assigned or reserved by this tool.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+IDS = (
+    'old-taichung-station', 'taichung-park', 'miyahara',
+    'natural-science-museum', 'calligraphy-greenway', 'shen-ji-new-village',
+    'fine-arts-museum', 'fengjia-night-market', 'maple-garden', 'taichung-theater',
+    'wenchang-temple', 'wanhe-temple',
+)
+
+
+def render(game):
+    spec = importlib.util.spec_from_file_location('history_glyphs', game / 'tools/taichung_gameplay/extend-chinese-glyphs.py')
+    glyphs = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(glyphs)
+    before = [(game / path).read_bytes() for path in ('charmap.txt', 'src/data/taichung_glyphs.h')]
+    existing = glyphs.parse_existing(*before)
+    mapping = dict(existing['mappings'])
+    mapping["'"] = mapping['’']
+    font = glyphs.load_font(game)
+    widths = []
+    native_text = (game / 'src/text.c').read_text()
+    for name in ('Normal', 'Male', 'Female'):
+        body = re.search(r'sFont' + name + r'LatinGlyphWidths\[\]\s*=\s*\{(.*?)\};', native_text, re.S)[1]
+        body = re.sub(r'//[^\n]*|/\*.*?\*/', '', body, flags=re.S)
+        widths.append([int(value) for value in re.findall(r'\b\d+\b', body)])
+    output = ['// Generated by tools/taichung_gameplay/render-landmark-history.py.',
+              '// Source facts and citations: data/taichung/landmark-history/*.json.',
+              '#include "global.h"', '#include "taichung_landmark_history.h"', '']
+    snapshot = json.loads((game / 'docs/landmark-history-source-snapshot.json').read_text())
+    approved_hashes = {entry['path']:entry['sha256'] for entry in snapshot['entries']}
+    records, proof, missing, hashes = {}, [], set(), {}
+    displayed_ids = []
+    page_counts = dict(sign=0, tour=0, staff=0)
+    buffer_sizes = []
+    action_records = {}
+
+    def text(pages, record_id, locale):
+        assert isinstance(pages, list) and 1 <= len(pages) <= 3, record_id
+        for page in pages:
+            assert isinstance(page, list) and 1 <= len(page) <= 2, record_id
+            for line in page:
+                assert isinstance(line, str) and line and not any(c in line for c in ('\\', '"', '$', '{', '}', '\n', '\r')), (record_id, line)
+                width = 0
+                for char in line:
+                    if glyphs.is_chinese(char):
+                        width += 13
+                        if char not in mapping:
+                            assert any(font.render(char)), char
+                            missing.add(char)
+                    else:
+                        assert char in mapping and len(mapping[char]) == 1, (record_id, char)
+                        width += max(table[mapping[char][0]] for table in widths) + 1
+                assert width <= 198, (record_id, locale, width, line)
+                proof.append(dict(id=record_id, locale=locale, line=line, pixels=width))
+        return r'\p'.join(r'\n'.join(page) for page in pages)
+
+    for path in sorted((game / 'data/taichung/landmark-history').glob('*.json')):
+        raw = path.read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == approved_hashes[str(path.relative_to(game))], path
+        data = json.loads(raw)
+        landmark = data['landmarkId']
+        assert landmark in IDS and landmark not in records, landmark
+        index = IDS.index(landmark)
+        sources = {item['id']: item for item in data['sources']}
+        assert sources and all(item['url'].startswith('https://') and item['sourceType'].startswith('primary-') for item in sources.values())
+        for entry in [data['sign'], *data['facts'], *data.get('npcFacts', [])]:
+            assert entry['id'] and entry['sources'] and all(item in sources for item in entry['sources'])
+            if entry in data.get('npcFacts', []):
+                assert entry['speakerId'] and entry['factBoundary'], entry['id']
+            else:
+                assert entry['claimId'], entry['id']
+            displayed_ids.append(entry['id'])
+        for action in data['interactionText']:
+            if action['id'] in action_records:
+                assert action == action_records[action['id']], landmark
+            else:
+                action_records[action['id']] = action
+        # sourceFactReference/helperProposal are provenance metadata only.
+        # They are intentionally neither serialized nor counted for glyphs.
+        assert 1 <= len(data['facts']) <= 3
+        sign = data['sign']
+        tours = {locale: [page for fact in data['facts'] for page in fact[locale]] for locale in ('en', 'zh-TW')}
+        staff_facts = data.get('npcFacts', [])
+        assert bool(staff_facts) == (index < 10), landmark
+        if staff_facts:
+            assert len({entry['speakerId'] for entry in staff_facts}) == 1, landmark
+        staff = {locale: [page for fact in staff_facts for page in fact[locale]] for locale in ('en', 'zh-TW')}
+        names = []
+        for kind, entry in [('Sign', sign), ('Tour', tours), ('Staff', staff)]:
+            if kind == 'Staff' and not staff_facts:
+                names.extend(['NULL','NULL'])
+                continue
+            assert len(entry['en']) == len(entry['zh-TW']), (landmark,kind)
+            page_counts[kind.lower()] += len(entry['en'])
+            for locale, suffix in [('en', 'En'), ('zh-TW', 'Zh')]:
+                symbol = 'sHistory' + str(index) + kind + suffix
+                literal = text(entry[locale], landmark + '.' + kind.lower(), locale)
+                encoded_upper_bound = sum(4 if glyphs.is_chinese(char) else 1 for page in entry[locale] for line in page for char in line) + sum(len(page) - 1 for page in entry[locale]) + len(entry[locale])
+                assert encoded_upper_bound <= 1000, (landmark, kind)
+                buffer_sizes.append(dict(landmark=landmark,kind=kind,locale=locale,maxEncodedBytes=encoded_upper_bound))
+                output.append('static const u8 ' + symbol + '[] = _("' + literal + '");')
+                names.append(symbol)
+        records[landmark] = names
+        hashes[str(path.relative_to(game))] = hashlib.sha256(raw).hexdigest()
+    assert set(records) == set(IDS), 'History must cover exactly twelve installed landmarks'
+    # Validate the actual shared action/fallback literals too; these are UI text,
+    # not source-backed historical claims.
+    core = (game / 'src/taichung_landmark_history.c').read_text()
+    assert set(action_records) == {'landmark.action.challenge','landmark.action.about','landmark.action.leave'}
+    # Leaders now tell the history before their challenge question, so the
+    # handoff's About label stays in the frozen records but is never rendered.
+    assert 'gTaichungHistoryAbout' not in core
+    for stem in ('Challenge','Leave'):
+        entry = action_records['landmark.action.'+stem.lower()]
+        for locale, suffix in [('en','En'),('zh-TW','Zh')]:
+            literal = text(entry[locale],entry['id'],locale)
+            assert re.search(r'gTaichungHistory'+stem+suffix+r'\[\] = _\("'+re.escape(literal)+r'"\);',core)
+    for suffix,locale in [('En','en'),('Zh','zh-TW')]:
+        value = re.search(r'sUnavailable'+suffix+r'\[\] = _\("([^"\n]+)"\);',core)[1]
+        text([[value]],'history.unavailable',locale)
+    output.extend(['', 'const struct TaichungLandmarkHistory gTaichungLandmarkHistory[TAICHUNG_LANDMARK_HISTORY_COUNT] = {'])
+    for landmark in IDS:
+        if landmark in records:
+            a, b, c, d, e, f = records[landmark]
+            output.append('    [' + str(IDS.index(landmark)) + '] = {{' + a + ', ' + b + '}, {' + c + ', ' + d + '}, {' + e + ', ' + f + '}},')
+    output.extend(['};', ''])
+    assert before == [(game / path).read_bytes() for path in ('charmap.txt', 'src/data/taichung_glyphs.h')]
+    report = dict(landmarks=list(records), sourceSha256=hashes, existingGlyphCount=len(existing['rows']), missingGlyphs=sorted(missing),
+                  maxLinePixels=max(item['pixels'] for item in proof), safeLinePixels=198, lines=proof,
+                  displayedRecordIds=displayed_ids, pageCountsPerLocale=page_counts,
+                  bilingualMessageLiterals=len(buffer_sizes), buffers=buffer_sizes,
+                  maxEncodedMessageBytes=max(item["maxEncodedBytes"] for item in buffer_sizes),
+                  sourceFactReferenceDisplayed=False, provenanceMetadataRequestedGlyphs=False,
+                  fontAndCharmapUnchanged=True, progressOrSaveWrites=False, runtimeAcceptance=False)
+    return '\n'.join(output).encode(), report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--game', type=Path, default=ROOT)
+    parser.add_argument('--artifacts', type=Path, required=True)
+    parser.add_argument('--write', action='store_true')
+    args = parser.parse_args()
+    game = args.game.resolve()
+    candidate, report = render(game)
+    dest = game / 'src/taichung_landmark_history_data.c'
+    if args.write:
+        dest.write_bytes(candidate)
+    else:
+        assert dest.read_bytes() == candidate, 'Generated history module differs; inspect sources and rerender explicitly'
+    args.artifacts.mkdir(parents=True, exist_ok=True)
+    report['mode'] = 'write' if args.write else 'check'
+    report['moduleSha256'] = hashlib.sha256(candidate).hexdigest()
+    (args.artifacts / 'native-history-review.json').write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({key: report[key] for key in ('mode', 'landmarks', 'maxLinePixels', 'missingGlyphs')}, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    main()
