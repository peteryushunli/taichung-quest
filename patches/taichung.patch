+    for feature in transport:
+        summary={k:v for k,v in feature.items() if k not in ('geometryWgs84','projectedOutline')}
+        xy=feature['projectedOutline'];summary['projectedBounds']=[min(x for x,y in xy),min(y for x,y in xy),max(x for x,y in xy),max(y for x,y in xy)]
+        summary['geometryArtifactRef']=dict(file='transport-context-full.json',featureId=feature['id'])
+        transport_summaries.append(summary)
+    data=dict(schemaVersion=1,status='sourced geography / planning draft; not native map registration',
+        source=metadata,coordinateContract=dict(wgs84BoundsSWNE=list(BBOX),worldWidth=256,worldHeight=256,
+            sectionWidth=64,sectionHeight=64,sectionRows=4,sectionColumns=4,sourceCrs=crs,
+            sourceCoordinates='real WGS84 geometry',projectedCoordinates='raw geographic sizing projection, north up',
+            authoredGameCoordinates='TBD after landmark clearance and street simplification review',metatileIdsIncluded=False),
+        nativeBaseline=dict(contract='docs/taichung-city-contract.json',mapGroup=43,spawn=baseline['spawn'],changed=False),
+        selectionRules=dict(backbone='Official width R2J >=30m with named road, OR named spine/frontage regex excluding alleys, OR surveyed dedicated cycle corridor',
+            namedSpineRegex=SPINE_NAMES.pattern,gameRoadWidths='proposed 3–4 metatile clear corridors; no lane-by-lane reproduction',
+            localRoads='Retained in archived source and preview context; not all become game streets',
+            buildingFootprints='Not supplied; candidate lots are authored empty reserves, not cadastral data'),
+        statistics={**stats,'sourceCrs':crs,'sections':len(sections),'selectedUniqueRoadNames':len({r['sourceName'] for r in roads}),
+            'selectedSourceVertices':sum(len(r['sourceGeometryWgs84']) for r in roads),'simplifiedProjectedVertices':sum(len(r['projectedCenterline']) for r in roads),
+            'seamCandidates':len(ports),'eligiblePlayerSeamCandidates':sum(p['eligiblePlayerConnector'] for p in ports),
+            'landmarkReserveConflicts':len(conflicts),'unpaintedLotCandidates':len(lots),
+            'unpaintedLotSizes':dict(Counter(f"{l['width']}x{l['height']}" for l in lots)),
+            'nonGymSections':sum(not s['landmarkGymIds'] for s in sections)},
+        sections=sections,streets=roads,seamCandidates=ports,landmarks=gyms,landmarkReserveConflicts=conflicts,
+        transportContext=transport_summaries,unpaintedLotCandidates=lots,
+        missingLayers=[dict(layer='rail centerlines',status='not retrieved; unnamed R0004 transport polygons are not assumed rail'),
+            dict(layer='waterway geometry',status='not retrieved; Overpass attempts failed; no river paths invented'),
+            dict(layer='surveyed building footprints / land-use zoning',status='not in road extract; fill recipes and lots are game-design proposals')],
+        integrationNotes=['Do not replace existing native maps or move current doors with this draft alone',
+            'Fix landmark envelope overlaps by local elastic placement before prefab painting',
+            'Choose/merge source seam candidates; retain reciprocal ports, clear sidewalks and common primary edge tiles',
+            'Respect survey grade separation; an apparent line crossing is not proof of a walkable junction',
+            'Publish v2 map/door/arrival/version/migration contract with Main before changing actual grids',
+            'Ten approved landmark IDs remain the only gym anchors; ordinary sections add city life, not gyms'])
+    dump(args.output,data)
