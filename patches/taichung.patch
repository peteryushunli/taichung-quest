@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Prove old native EC02 writers leave newly supported bits21-23 zero."""
+from pathlib import Path
+import hashlib, json, re, subprocess
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / 'build/taichung-tests/upper-history'
+OUT.mkdir(parents=True, exist_ok=True)
+BASE = 'a701ed5109ffd5eddd6b0581ade46591146e9656'
+def old(path, ref=BASE):
+    return subprocess.check_output(['git','show',ref+':'+path],cwd=ROOT)
+header = old('include/constants/taichung_encounters.h')
+source = old('src/taichung_encounter.c')
+assert b'#define TAICHUNG_ENCOUNTER_COUNT 21' in header
+assert b'#define TAICHUNG_ENCOUNTER_SAVE_LOW_BITS 10' in header
+# All native revisions since EC02 was introduced have the same initialization
+# and bounded single-bit writer. The only later source change was a site slug.
+history = subprocess.check_output(['git','rev-list',BASE,'--','src/taichung_encounter.c'],cwd=ROOT,text=True).splitlines()
+audited = []
+for ref in history:
+    hdr = old('include/constants/taichung_encounters.h',ref).decode()
+    if '#define TAICHUNG_ENCOUNTER_SCHEMA 0xEC02' not in hdr:
+        continue
+    body = old('src/taichung_encounter.c',ref).decode()
+    assert '#define TAICHUNG_ENCOUNTER_COUNT 21' in hdr
+    assert 'VarSet(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR, 0)' in body
+    assert 'VarSet(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR, 0)' in body
+    assert 'VarSet(upper, Saved(upper) | (1u << (site - TAICHUNG_ENCOUNTER_SAVE_LOW_BITS)))' in body
+    assert 'site < TAICHUNG_ENCOUNTER_COUNT' in body
+    # Only initializer + Begin + confirmed caught result call the writer.
+    assert body.count('SetSiteBit(') == 3
+    audited.append(ref)
+# An exact repository-wide native/script token audit also rejects independent
+# writers to either named/raw variable. Numeric text hashes are irrelevant.
+files = subprocess.check_output(['git','ls-tree','-r','--name-only',BASE,'src','data/scripts','include'],cwd=ROOT,text=True).splitlines()
+refs = []
+pattern = re.compile(r'\b(?:TAICHUNG_ENCOUNTER_(?:ATTEMPT|UNLOCK)_UPPER_VAR|VAR_0x40[Ff][02]|0x40[Ff][02])\b')
+for path in files:
+    if not path.endswith(('.c','.h','.s','.inc')): continue
+    text = old(path).decode(errors='replace')
+    if pattern.search(text):
+        refs.append(path)
+        assert path in {'include/constants/vars.h','include/constants/taichung_encounters.h','src/taichung_encounter.c','src/taichung_save.c'}, path
+# Freeze the old header before native public headers are read, preserving its
+# actual21-site bound rather than accidentally compiling old C with count24.
+(OUT/'legacy-constants.h').write_bytes(header)
+(OUT/'legacy.c').write_bytes(source)
+exports = sorted(set(re.findall(r'\b(TaichungEncounter\w+)\([^;]*\);',old('include/taichung_encounter.h').decode())))
+assert len(exports) == 23, exports
+flags = ['cc','-DGUARD_GLOBAL_H','-std=c99','-O2','-Wall','-Wextra','-Werror','-I'+str(ROOT/'tests/host'),'-I'+str(ROOT/'include')]
+subprocess.run(flags+['-include',str(OUT/'legacy-constants.h')]+['-D'+name+'=Legacy'+name for name in exports]+['-c',str(OUT/'legacy.c'),'-o',str(OUT/'legacy.o')],check=True)
+subprocess.run(flags+[str(ROOT/'src/taichung_encounter.c'),str(ROOT/'tests/taichung_encounter_upper_history_test.c'),str(OUT/'legacy.o'),'-o',str(OUT/'upper-history')],check=True)
+run = subprocess.run([str(OUT/'upper-history')],capture_output=True,text=True,check=True)
+(OUT/'results.log').write_text(run.stdout+run.stderr)
+proof = {'baseline':BASE,'baselineCoreSha256':hashlib.sha256(source).hexdigest(),'baselineConstantsSha256':hashlib.sha256(header).hexdigest(),'auditedEC02CoreRevisions':audited,'onlyNativeVariableReferences':refs,'results':run.stdout.strip(),'scope':'Released native-generated valid EC02 saves and supported EC01 migration. No sanitation or version bump. Arbitrarily externally edited EC02 upper garbage is not distinguishable from legitimate new24-site progress; do not claim that provenance.'}
+(OUT/'PROOF.json').write_text(json.dumps(proof,indent=2)+'\n')
+print(json.dumps(proof,indent=2))
