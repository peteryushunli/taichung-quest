+#define COUNT(a) (sizeof(a) / sizeof((a)[0]))
+static void Versioned(u16 version)
+{
+    Reset(); V(0x40F7) = version; V(0x40FB) = 2; V(0x40FC) = 133;
+    sSave.playerPartyCount = 3; // Established saves need not own an original starter.
+}
+
+static void AssertSamePartyAndVars(const struct SaveBlock1 *before)
+{
+    assert(V(0x40F7) == TAICHUNG_SAVE_VERSION && sVariableWrites == 1);
+    assert(sChallengeCancels == 1);
+    AssertProtected(before, FALSE); // Includes checkpoint, all nonversion vars and bag/party bytes.
+}
+
+// Save v12 gave every gym its own room (and moved Muqing's gym into Wanhe Temple): an older
+// save made inside one, or an explicit pending target inside one, reloads that room on its
+// exit mat (warp 1). tests/taichung_save_v12_test.c covers it; the cases here only expect it.
+static bool8 IsGymRoomV12(const struct WarpData *warp)
+{
+    static const u16 rooms[] = {
+        MAP_TAICHUNG_OLD_STATION_GYM, MAP_TAICHUNG_PARK_GYM, MAP_TAICHUNG_MIYAHARA_GYM,
+        MAP_TAICHUNG_SCIENCE_MUSEUM_GYM, MAP_TAICHUNG_GREENWAY_GYM, MAP_TAICHUNG_SHEN_JI_GYM,
+        MAP_TAICHUNG_FINE_ARTS_GYM, MAP_TAICHUNG_FENGJIA_GYM, MAP_TAICHUNG_THEATER_GYM,
+        MAP_TAICHUNG_WANHE_TEMPLE_HALL, MAP_TAICHUNG_MAPLE_GARDEN_GYM,
+    };
+    unsigned i;
+    for (i = 0; i < COUNT(rooms); i++)
+        if (warp->mapGroup == MAP_GROUP(rooms[i]) && warp->mapNum == MAP_NUM(rooms[i]))
+            return TRUE;
+    return FALSE;
+}
+
+static void AssertOnGymMatV12(const struct WarpData *room)
+{
+    assert(sHasContinueWarp && sSave.continueGameWarp.mapGroup == room->mapGroup
+        && sSave.continueGameWarp.mapNum == room->mapNum && sSave.continueGameWarp.warpId == 1
+        && sSave.continueGameWarp.x == -1 && sSave.continueGameWarp.y == -1);
+}
+
+// A save in a room the older migrations leave alone keeps its location, unless v12 reloads its gym room.
+static void AssertRoomKept(const struct SaveBlock1 *before)
+{
+    if (IsGymRoomV12(&before->location))
+    {
+        AssertOnGymMatV12(&before->location); assert(sWarpRequests == 1);
+        return;
+    }
+    assert(!sHasContinueWarp && sWarpRequests == 0);
+    assert(memcmp(&sSave.continueGameWarp,&before->continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+}
+
+// A pending return the older migrations leave alone is kept, unless it is an explicit target in a gym room.
+static void AssertPendingKept(const struct SaveBlock1 *before)
+{
+    if (before->continueGameWarp.warpId == -1 && IsGymRoomV12(&before->continueGameWarp))
+    {
+        AssertOnGymMatV12(&before->continueGameWarp); assert(sWarpRequests == 0);
+        return;
+    }
+    assert(sHasContinueWarp && sWarpRequests == 0);
+    assert(memcmp(&sSave.continueGameWarp,&before->continueGameWarp,sizeof(sSave.continueGameWarp)) == 0);
+}
