+static void Print(u8 x, u8 y, const u8 *colors, const u8 *text)
+{
+    AddTextPrinterParameterized3(0, FONT_SMALL, x, y, colors, -1, text);
+}
+
+static void PrintNumber(u8 x, u8 y, u16 value, u8 digits)
+{
+    u8 text[12];
+    ConvertIntToDecimalStringN(text, value, STR_CONV_MODE_LEADING_ZEROS, digits);
+    Print(x, y, sMutedColors, text);
+}
+
+static void DrawSlots(void)
+{
+    u8 slot;
+    u8 count = CalculatePlayerPartyCount();
+    u8 text[12];
+    u16 species;
+
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    Print(8, 22, sMutedColors, TaichungText(sSlotHelpEn, sSlotHelpZh));
+    for (slot = 0; slot < PARTY_SIZE; slot++)
+    {
+        u8 y = 40 + slot * 16;
+        if (slot == sSlot)
+            Print(6, y, sSelectedColors, sCursor);
+        PrintNumber(18, y, slot + 1, 1);
+        if (slot < count)
+        {
+            species = GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES);
+            Print(34, y, sTextColors, gSpeciesNames[species]);
+            StringCopy(text, sLv);
+            ConvertIntToDecimalStringN(text + 2, GetMonData(&gPlayerParty[slot], MON_DATA_LEVEL), STR_CONV_MODE_LEFT_ALIGN, 3);
+            Print(166, y, sMutedColors, text);
+        }
+        else
+            Print(34, y, sMutedColors, slot == count ? TaichungText(sEmptyEn, sEmptyZh) : sLocked);
+    }
+    Print(8, 144, sTextColors, TaichungText(sSlotFooterEn, sSlotFooterZh));
+}
+
+static void DrawMoves(u8 x, u8 y)
+{
+    u8 move;
+    const u16 *moves = TaichungTeamGetPresetMoves(sSpecies);
+    Print(x, y, sMutedColors, TaichungText(sMovesEn, sMovesZh));
+    for (move = 0; move < MAX_MON_MOVES; move++)
+        Print(x, y + 16 + move * 16, sTextColors, moves[move] ? gMoveNames[moves[move]] : sLocked);
+}
+
+static void DrawSpecies(void)
+{
+    u16 first = ((sSpecies - 1) / SPECIES_PER_PAGE) * SPECIES_PER_PAGE + 1;
+    u16 species;
+    u8 y;
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sChooseEn, sChooseZh));
+    PrintNumber(188, 6, sSpecies, 3);
+    Print(8, 22, sMutedColors, TaichungText(sRosterHintEn, sRosterHintZh));
+    for (species = first; species < first + SPECIES_PER_PAGE && species <= TEAM_ROSTER_COUNT; species++)
+    {
+        y = 36 + (species - first) * 13;
+        if (species == sSpecies)
+            Print(6, y, sSelectedColors, sCursor);
+        Print(18, y, species == sSpecies ? sSelectedColors : sTextColors, gSpeciesNames[species]);
+    }
+    Print(148, 30, sSelectedColors, sLevel);
+    DrawMoves(140, 48);
+    Print(8, 144, sMutedColors, TaichungText(sSpeciesFooterEn, sSpeciesFooterZh));
+}
+
+static void DrawConfirmation(void)
+{
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    Print(8, 24, sTextColors, TaichungText(sConfirmEn, sConfirmZh));
+    Print(8, 48, sSelectedColors, gSpeciesNames[sSpecies]);
+    Print(100, 48, sSelectedColors, sLevel);
+    if (sSlot < CalculatePlayerPartyCount())
+    {
+        Print(8, 70, sMutedColors, TaichungText(sReplacingEn, sReplacingZh));
+        Print(8, 86, sTextColors, gSpeciesNames[GetMonData(&gPlayerParty[sSlot], MON_DATA_SPECIES)]);
+    }
+    DrawMoves(140, 48);
+    Print(8, 126, sMutedColors, TaichungText(sFullHpEn, sFullHpZh));
+    Print(8, 144, sTextColors, TaichungText(sConfirmFooterEn, sConfirmFooterZh));
+}
