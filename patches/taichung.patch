+"""Taichung Park pavilion pieces: white timber walls, vermilion trim, wood floor, lamp posts, the lake seen
+through the windows, and the tea hall's furniture (tea tables, stools, wooden benches, ferns, red runner)."""
+from PIL import Image, ImageDraw
+import random
+def q(c): return tuple(v//8*8 for v in c)+((c[3],) if len(c)>3 else ())
+OUT=q((40,32,40))
+WAT=q((104,160,224)); WAT1=q((88,144,208))
+FL0,FL1,FL2=q((216,168,112)),q((184,136,88)),q((232,192,136))
+WW0,WW1,WW2=q((244,240,228)),q((216,212,200)),q((184,180,172))
+VM0,VM1=q((208,72,56)),q((152,48,40))
+DW0,DW1=q((112,64,48)),q((80,44,36))
+IR0,IR1=q((56,60,72)),q((96,100,112))
+
+def floor(seed=0,n=False,s=False,w=False,e=False):
+    im=Image.new('RGB',(16,16),FL0); d=ImageDraw.Draw(im); r=random.Random(seed)
+    for x in (3,7,11,15): d.line([x,0,x,15],fill=FL1)
+    for col in range(4):
+        y=r.randrange(16); d.line([col*4,y,col*4+2,y],fill=FL1)
+        d.line([col*4,0,col*4,15],fill=FL2) if col==0 else None
+    if n: d.rectangle([0,0,15,1],fill=DW0)
+    if s: d.rectangle([0,14,15,15],fill=DW0)
+    if w: d.rectangle([0,0,1,15],fill=DW0)
+    if e: d.rectangle([14,0,15,15],fill=DW0)
+    return im
+
+def wall(row,window=False,end=None):
+    """white clapboard pavilion wall, row 0 (top, vermilion eave trim) or 1 (with skirting)."""
+    im=Image.new('RGB',(16,16),WW0); d=ImageDraw.Draw(im)
+    for y in range(2,16,3): d.line([0,y,15,y],fill=WW1)
+    if row==0:
+        d.rectangle([0,0,15,3],fill=VM0); d.line([0,3,15,3],fill=VM1); d.line([0,0,15,0],fill=OUT)
+    else:
+        d.rectangle([0,12,15,15],fill=DW0); d.line([0,12,15,12],fill=DW1)
+    if window:
+        y0,y1=(6,15) if row==0 else (0,8)
+        d.rectangle([2,y0,13,y1],fill=DW0)
+        d.rectangle([3,y0+1 if row==0 else 0,12,y1-1],fill=WAT); d.line([7,y0,7,y1],fill=DW0); d.line([8,y0,8,y1],fill=DW0)
+        if row==0:
+            d.line([3,y0+3,6,y0+3],fill=q((168,208,240))); d.line([9,y0+3,12,y0+3],fill=q((168,208,240)))
+            d.line([3,y0+1,12,y0+1],fill=q((88,136,72)))   # far shore treeline
+    if end=='l': d.rectangle([0,0,1,15],fill=OUT if row==0 else DW1)
+    if end=='r': d.rectangle([14,0,15,15],fill=OUT if row==0 else DW1)
+    return im
+
+def side_wall(base,side):
+    """top of a side wall seen from above, on its floor tile."""
+    im=base.copy(); d=ImageDraw.Draw(im)
+    x0,x1=(0,4) if side=='l' else (11,15)
+    d.rectangle([x0,0,x1,15],fill=WW1); d.line([x0+1 if side=='l' else x0,0,x0+1 if side=='l' else x0,15],fill=WW0)
+    d.line([x1 if side=='l' else x0,0,x1 if side=='l' else x0,15],fill=OUT)
+    for y in (4,10): d.rectangle([x0+1,y,x1-1,y+3],fill=WAT)  # windows on every side
+    return im
+
+def post(base_top,base_bot,lamp=True):
+    """corner post with a cast-iron lamp bracket, 1x2."""
+    im=Image.new('RGBA',(16,32)); im.paste(base_top,(0,0)); im.paste(base_bot,(0,16)); d=ImageDraw.Draw(im)
+    d.rectangle([6,2,9,29],fill=VM1,outline=OUT); d.line([7,3,7,28],fill=VM0)
+    if lamp:
+        d.arc([8,4,15,11],180,270,fill=IR0); d.line([9,4,13,4],fill=IR0)
+        d.rectangle([11,5,14,10],fill=q((248,232,152)),outline=IR0); d.line([11,5,14,5],fill=IR0)
+    return im
+
+# --- the tea hall (draft 4, option B): the pavilion stands on the shore, so no water inside ---
+POT0, POT1 = q((176, 88, 56)), q((128, 60, 40))
+LF0, LF1, LF2 = q((72, 136, 72)), q((48, 96, 56)), q((120, 184, 104))
+TEA0, TEA1 = q((152, 96, 64)), q((112, 64, 48))
+CUP = q((240, 236, 224))
+RUN0, RUN1 = q((176, 48, 56)), q((216, 112, 96))
+
+
+def plant(base):
+    """potted fern in a glazed pot, 1x1."""
+    im = base.copy().convert('RGBA'); d = ImageDraw.Draw(im)
+    d.polygon([(4, 9), (12, 9), (11, 15), (5, 15)], fill=POT0, outline=OUT); d.line([5, 10, 11, 10], fill=q((208, 120, 80)))
+    for x0, y0, x1, y1 in ((8, 9, 2, 3), (8, 9, 14, 3), (8, 9, 8, 0), (8, 9, 4, 1), (8, 9, 12, 1)):
+        d.line([x0, y0, x1, y1], fill=LF1, width=2); d.line([x0, y0 - 1, x1, y1], fill=LF0)
+    d.point([(3, 3), (13, 3), (8, 1)], fill=LF2)
+    return im
+
+
+def tea_table(base):
+    """round tea table with a pot and two cups, 1x1."""
+    im = base.copy().convert('RGBA'); d = ImageDraw.Draw(im)
+    d.rectangle([7, 10, 8, 15], fill=TEA1)
+    d.ellipse([1, 3, 14, 12], fill=TEA0, outline=OUT); d.arc([2, 4, 13, 11], 200, 340, fill=q((184, 128, 88)))
+    d.ellipse([6, 3, 10, 7], fill=CUP, outline=OUT); d.line([10, 4, 12, 4], fill=OUT)     # teapot
+    d.rectangle([3, 7, 4, 8], fill=CUP); d.rectangle([11, 8, 12, 9], fill=CUP)                # cups
+    return im
+
+
+def stool(base):
+    """low round stool, 1x1."""
+    im = base.copy().convert('RGBA'); d = ImageDraw.Draw(im)
+    d.rectangle([5, 9, 6, 14], fill=TEA1); d.rectangle([9, 9, 10, 14], fill=TEA1)
+    d.ellipse([3, 5, 12, 11], fill=TEA0, outline=OUT)
+    return im
+
+
+def runner(base, top=False, bottom=False):
+    """red runner down the hall, 1x1."""
+    im = base.copy(); d = ImageDraw.Draw(im)
+    d.rectangle([2, 0 if not top else 2, 13, 15 if not bottom else 13], fill=RUN0)
+    d.line([4, 0 if not top else 4, 4, 15 if not bottom else 11], fill=RUN1); d.line([11, 0 if not top else 4, 11, 15 if not bottom else 11], fill=RUN1)
+    if top: d.line([4, 4, 11, 4], fill=RUN1)
+    return im
+
+
+def bench(base_l, base_r):
+    """wooden park bench against the wall, 2x1."""
+    im = Image.new('RGBA', (32, 16)); im.paste(base_l, (0, 0)); im.paste(base_r, (16, 0)); d = ImageDraw.Draw(im)
+    d.rectangle([2, 2, 29, 5], fill=TEA1, outline=OUT)                       # back rail
+    d.rectangle([2, 6, 29, 10], fill=TEA0, outline=OUT); d.line([3, 7, 28, 7], fill=q((184, 128, 88)))
+    for x in (4, 26): d.rectangle([x, 11, x + 1, 14], fill=TEA1)
+    return im
