+"""Rebuild only the approved Theater room; leave all IDs, actors and warps intact."""
+from collections import deque
+import json
+from pathlib import Path
+import struct
+import compile_gyms as C
+
+root=C.NATIVE
+path=root/'data/layouts/TaichungGymTheater/map.bin'
+before=struct.unpack('<276H',path.read_bytes())
+r=C.compile_room('theater')
+assert (r['W'],r['H'])==(23,12)
+assert len(r['packer'].tiles)<=384
+open_cells=lambda w:{(i%23,i//23) for i,v in enumerate(w) if not v&0x400}
+was,now=open_cells(before),open_cells(r['words'])
+assert was<=now, 'The focused room correction must not block any old saved position'
+assert {(x,y) for x in range(10,13) for y in range(2,11)}<=now
+assert {(x,y) for x in (4,5,17,18) for y in range(5,10)}<=now
+m=json.loads((root/'data/maps/TaichungTheater_Gym/map.json').read_text())
+assert [(o['x'],o['y'])for o in m['object_events']]==[(11,1),(2,7)]
+assert [(w['x'],w['y'])for w in m['warp_events']]==[(10,10),(11,10),(12,10)]
+allowed=now-{(11,1),(2,7)};seen={(11,10)};pending=deque(seen)
+while pending:
+ x,y=pending.popleft()
+ for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
+  q=x+dx,y+dy
+  if q in allowed and q not in seen:seen.add(q);pending.append(q)
+assert {(11,2),(3,7),(4,5),(5,5),(17,5),(18,5),(10,9),(12,9)}<=seen
+C.write(r)
+print('PASS: Theater only; entry turn, three-wide center/stairs, two-wide sides, actors/warps retained, no newly blocked old-save positions')
