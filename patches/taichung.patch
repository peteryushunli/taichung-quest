diff --git a/data/taichung/landmarks/fengjia/check_candidate.py b/data/taichung/landmarks/fengjia/check_candidate.py
new file mode 100644
index 0000000..82561f9
--- /dev/null
+++ b/data/taichung/landmarks/fengjia/check_candidate.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Verify Fengjia candidate formats only; no map, UI, bank or game build."""
+import contextlib
+import io
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+from PIL import Image
+
+from encode_candidate import HERE, GAME, SOURCE, EXPECTED_SOURCE_SHA, PALETTE_BANK, encode, sha
+
+
+def check(output):
+    manifest = json.loads((output / "encode-manifest.json").read_text())
+    recipe = manifest["recipe"]
+    width, height = recipe["nativeSizePixels"]
+    method = recipe.get("quantizationMethod", "median")
+    assert sha(SOURCE) == EXPECTED_SOURCE_SHA == manifest["originalStudySha256"]
+    image = Image.open(output / "candidate-indexed.png")
+    native = Image.open(output / "candidate-native.png")
+    assert image.mode == "P" and image.size == (width, height) and image.info["transparency"] == 0
+    assert max(image.get_flattened_data()) < 16
+    assert image.convert("RGBA").tobytes() == native.tobytes()
+    assert set(native.getchannel("A").get_flattened_data()) == {0, 255}
+    assert all(image.getpixel((x, y)) == image.getpixel((x//2*2, y//2*2))
+               for y in range(height) for x in range(width))
+    pal = (output / "09.pal").read_bytes()
+    assert pal == pal.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+    colors = [tuple(map(int, row.split())) for row in pal.decode().splitlines()[3:] if row]
+    assert len(colors) == 16 and all(0 <= v <= 248 and v%8 == 0 for color in colors for v in color)
+    assert image.getpalette()[:48] == [v for color in colors for v in color]
+    gbapal = struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors))
+    assert (output / "09.gbapal").read_bytes() == gbapal
+    raw = (output / "tiles.4bpp").read_bytes()
+    graphics = [tuple(value for byte in raw[n:n+32] for value in (byte & 15, byte >> 4))
+                for n in range(0, len(raw), 32)]
+    words = struct.unpack("<"+str(width*height//64)+"H", (output / "foreground-tilemap-relative.bin").read_bytes())
+    assert all(word >> 12 == PALETTE_BANK and word & 1023 < len(graphics) for word in words)
+    for y in range(height):
+        for x in range(width):
+            word = words[y//8*(width//8)+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            assert graphics[word & 1023][sy*8+sx] == image.getpixel((x, y))
+    groups = [[words[(my*2+y)*(width//8)+mx*2+x] for y in range(2) for x in range(2)]
+              for my in range(height//16) for mx in range(width//16)]
+    assert json.loads((output / "foreground-metatiles-relative.json").read_text()) == groups
+    assert len(graphics) == manifest["native"]["unmergedUniqueGraphicsIncludingBlank"]
+    assert len(set(graphics)) == len(graphics)
+    assert not manifest["entryAnalysis"]["actualPaintedDoorExists"]
+    assert manifest["entryAnalysis"]["paintedDoorCenterOrBinding"] is None
+    assert manifest["entryAnalysis"]["alpha0CorridorFromSouthExists"] is False
+    if method == "maxcoverage":
+        features = manifest["recognizabilityMeasurements"]
+        assert features["fourSeparateYellowStarComponentsMeasured"]
+        assert all(features["rainbowChromaticBandsMeasured"].values())
+        assert all(item["whitePixels"] > 0 for item in features["whiteRoundEndPanelRegions"].values())
+    with tempfile.TemporaryDirectory(prefix="fengjia-format-") as folder:
+        temp = Path(folder)
+        with contextlib.redirect_stdout(io.StringIO()):
+            again = encode(temp / "candidate", (width, height), method)
+        assert again == manifest
+        reproduced = [path.relative_to(temp / "candidate") for path in (temp / "candidate").rglob("*") if path.is_file()]
+        assert all((output / path).read_bytes() == (temp / "candidate" / path).read_bytes() for path in reproduced)
+        converter = GAME / "tools/gbagfx/gbagfx"
+        subprocess.run([str(converter), str(output / "tiles.png"), str(temp / "tiles.4bpp")], check=True, capture_output=True)
+        converted = (temp / "tiles.4bpp").read_bytes()
+        assert converted[:len(raw)] == raw and set(converted[len(raw):]) <= {0}
+        subprocess.run([str(converter), str(output / "09.pal"), str(temp / "09.gbapal")], check=True, capture_output=True)
+        assert (temp / "09.gbapal").read_bytes() == gbapal
+    assert sha(SOURCE) == EXPECTED_SOURCE_SHA
+    report = {"result": "pass", "scope": "unmerged format and source preservation only", "sizePixels": [width, height],
+              "quantizationMethod": method, "originalStudyUnchanged": True,
+              "unmergedUniqueGraphics": len(graphics), "paddedSheetSlots": manifest["native"]["paddedSheetSlots"],
+              "opaqueColors": recipe["opaqueColorCount"], "paletteCandidate": PALETTE_BANK,
+              "binaryAlpha": True, "uniform2PixelClusters": True, "flipAware4bppRoundTripPixels": width*height,
+              "paletteCrlfAndBgr555Verified": True, "gbagfxMatches": True,
+              "reproducedFiles": len(reproduced), "reproducedByteIdentically": True,
+              "fourSeparateYellowStarComponents": manifest["recognizabilityMeasurements"]["fourSeparateYellowStarComponentsMeasured"],
+              "actualPaintedDoorExists": False, "alpha0CorridorFromSouthExists": False,
+              "doorBindingAllocated": False, "jointXitunBudgetChecked": False,
+              "mapOrBankChanged": False, "nativeReady": False}
+    (output / "validation.json").write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps({"candidate": output.name, **report}, indent=2))
+    return report
+
+
+if __name__ == "__main__":
+    for name in ("candidate", "candidate-maxcoverage", "candidate-192"):
+        if (HERE / name / "encode-manifest.json").exists():
+            check(HERE / name)
diff --git a/data/taichung/landmarks/fengjia/encode_candidate.py b/data/taichung/landmarks/fengjia/encode_candidate.py
new file mode 100644
index 0000000..b81035d
--- /dev/null
+++ b/data/taichung/landmarks/fengjia/encode_candidate.py
@@ -0,0 +1,227 @@
+#!/usr/bin/env python3
+"""Mechanical Fengjia native-format preparation; never installs a bank/map.
+
+The approved study is immutable. Alpha thresholding, nearest resampling and
+palette encoding are the only raster operations. No doorway is drawn or erased.
+"""
+import argparse
+from collections import Counter, deque
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+SOURCE = PROJECT / "artifacts/worktrees/c291d4842985/landmark-art/fengjia-study-v1.png"
+PALETTE_BANK = 9
+EXPECTED_SOURCE_SHA = "f790071e1ff366d340c5d5f86e32a71b105fc8939c37ff27e25d591c91a222cc"
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags & 0x800 else y)*8 +
+                        (7-x if flags & 0x400 else x)]
+                 for y in range(8) for x in range(8))
+
+
+def components(points):
+    remaining = set(points)
+    result = []
+    while remaining:
+        seed = min(remaining)
+        pending, part = deque([seed]), set()
+        while pending:
+            point = pending.popleft()
+            if point not in remaining:
+                continue
+            remaining.remove(point)
+            part.add(point)
+            x, y = point
+            pending.extend(((x-1, y), (x+1, y), (x, y-1), (x, y+1)))
+        result.append({"pixels": len(part), "boxExclusive": [min(x for x, _ in part), min(y for _, y in part),
+                       max(x for x, _ in part)+1, max(y for _, y in part)+1]})
+    return sorted(result, key=lambda item: (item["boxExclusive"][0], item["boxExclusive"][1]))
+
+
+def encode(output, size=(160, 96), quantization="maxcoverage"):
+    if size not in ((160, 96), (192, 128)):
+        raise ValueError("Only the first160x96 candidate or a192x128 format alternative is authorized")
+    assert sha(SOURCE) == EXPECTED_SOURCE_SHA
+    generation = json.loads((HERE / "generation.json").read_text())
+    assert generation["acceptance"]["architectureUserApproved"]
+    width, height = size
+    cluster, working = 2, (width//2, height//2)
+    source = Image.open(SOURCE).convert("RGBA")
+    source_mask = source.getchannel("A").point(lambda value: 255 if value >= 224 else 0)
+    crop_box = source_mask.getbbox()
+    crop = source.crop(crop_box)
+    crop.putalpha(source_mask.crop(crop_box))
+    scale = min(working[0]/crop.width, working[1]/crop.height)
+    fit = tuple(round(n*scale) for n in crop.size)
+    offset = ((working[0]-fit[0])//2, working[1]-fit[1])
+    canvas = Image.new("RGBA", working)
+    canvas.paste(crop.resize(fit, Image.Resampling.NEAREST), offset)
+    rgba = list(canvas.get_flattened_data())
+    opaque = [pixel[:3] for pixel in rgba if pixel[3]]
+    strip = Image.new("RGB", (len(opaque), 1))
+    strip.putdata(opaque)
+    methods = {"median": Image.Quantize.MEDIANCUT, "maxcoverage": Image.Quantize.MAXCOVERAGE}
+    quantized = strip.quantize(colors=15, method=methods[quantization], dither=Image.Dither.NONE)
+    raw_palette = quantized.getpalette()
+    colors = []
+    for index in sorted(set(quantized.get_flattened_data())):
+        color = tuple(min(248, (raw_palette[index*3+n]+4)//8*8) for n in range(3))
+        if color not in colors:
+            colors.append(color)
+    palette = [(0, 0, 0)] + colors + [(0, 0, 0)]*(15-len(colors))
+    indices = [0 if not a else 1+min(range(len(colors)), key=lambda i:
+               (r-colors[i][0])**2+(g-colors[i][1])**2+(b-colors[i][2])**2) for r, g, b, a in rgba]
+    indexed = Image.new("P", working)
+    indexed.putpalette([component for color in palette for component in color]+[0]*720)
+    indexed.putdata(indices)
+    indexed = indexed.resize(size, Image.Resampling.NEAREST)
+    indexed.info["transparency"] = 0
+    output.mkdir(parents=True, exist_ok=True)
+    indexed.save(output / "candidate-indexed.png")
+    native = indexed.convert("RGBA")
+    native.save(output / "candidate-native.png")
+    native.resize((width*4, height*4), Image.Resampling.NEAREST).save(output / "preview-4x.png")
+    graphics, lookup, tilemap = [], {}, []
+    for ty in range(height//8):
+        for tx in range(width//8):
+            pixels = tuple(indexed.getpixel((tx*8+x, ty*8+y)) for y in range(8) for x in range(8))
+            canonical, flags = min((flip(pixels, f), f) for f in (0, 0x400, 0x800, 0xC00))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tilemap.append(lookup[canonical] | flags | PALETTE_BANK << 12)
+    metatiles, rows = [], []
+    for my in range(height//16):
+        row = ""
+        for mx in range(width//16):
+            metatiles.append([tilemap[(my*2+y)*(width//8)+mx*2+x] for y in range(2) for x in range(2)])
+            row += "1" if any(indexed.getpixel((mx*16+x, my*16+y)) for y in range(16) for x in range(16)) else "0"
+        rows.append(row)
+    for y in range(height):
+        for x in range(width):
+            word = tilemap[y//8*(width//8)+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            assert graphics[word & 1023][sy*8+sx] == indexed.getpixel((x, y))
+    physical = (len(graphics)+15)//16*16
+    sheet = Image.new("P", (128, physical//16*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info["transparency"] = 0
+    for n, pixels in enumerate(graphics):
+        for y in range(8):
+            for x in range(8):
+                sheet.putpixel((n%16*8+x, n//16*8+y), pixels[y*8+x])
+    sheet.save(output / "tiles.png")
+    (output / "tiles.4bpp").write_bytes(bytes(pixels[n] | pixels[n+1] << 4 for pixels in graphics for n in range(0, 64, 2)))
+    (output / "foreground-tilemap-relative.bin").write_bytes(struct.pack("<"+str(len(tilemap))+"H", *tilemap))
+    (output / "foreground-metatiles-relative.json").write_text(json.dumps(metatiles, indent=2)+"\n")
+    (output / "09.pal").write_bytes(("JASC-PAL\r\n0100\r\n16\r\n"+"".join(" ".join(map(str, color))+"\r\n" for color in palette)).encode())
+    (output / "09.gbapal").write_bytes(struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in palette)))
+    # These are image-analysis regions only, never collision or active doors.
+    def measure(box):
+        pixels = list(indexed.crop(box).get_flattened_data())
+        return {"boxExclusive": list(box), "pixelCount": len(pixels),
+                "transparentPixels": pixels.count(0), "opaquePixels": sum(bool(v) for v in pixels),
+                "opaquePaletteIndexCounts": {str(k): v for k, v in sorted(Counter(v for v in pixels if v).items())}}
+    # Project measured160px body coordinates through the actual fitted subject,
+    # rather than scaling the whole canvas/padding of the192px alternative.
+    def scaled(box):
+        return tuple(round(v*(fit[0]*2)/160 + offset[0]*2) if i%2 == 0 else
+                     round((v-26)*(fit[1]*2)/70 + offset[1]*2) for i, v in enumerate(box))
+    entry_regions = {
+        "centralMarketLane": measure(scaled((68, 62, 92, 96))),
+        "leftShopfront": measure(scaled((4, 78, 42, 96))),
+        "rightShopfront": measure(scaled((116, 78, 156, 96))),
+        "hypotheticalFixedDoorCell": measure(scaled((80, 80, 96, 96))),
+    }
+    star_box = scaled((46, 24, 82, 38))
+    yellow = {(x, y) for y in range(star_box[1], star_box[3]) for x in range(star_box[0], star_box[2])
+              if (index := indexed.getpixel((x, y))) and palette[index][0] >= 176 and palette[index][1] >= 144 and palette[index][2] <= 112}
+    stars = components(yellow)
+    lane_box = entry_regions["centralMarketLane"]["boxExclusive"]
+    lane_transparent_by_row = [sum(indexed.getpixel((x, y)) == 0 for x in range(lane_box[0], lane_box[2]))
+                               for y in range(lane_box[1], lane_box[3])]
+    panel_rois = {"left": scaled((40, 40, 54, 54)), "right": scaled((106, 40, 120, 54))}
+    panels = {name: {"roiExclusive": list(box), "whitePixels": sum(bool(indexed.getpixel((x, y))) and
+                    min(palette[indexed.getpixel((x, y))]) >= 232
+                    for y in range(box[1], box[3]) for x in range(box[0], box[2]))}
+              for name, box in panel_rois.items()}
+    banner_box = scaled((38, 36, 122, 58))
+    banner_colors = {palette[indexed.getpixel((x, y))] for y in range(banner_box[1], banner_box[3])
+                     for x in range(banner_box[0], banner_box[2]) if indexed.getpixel((x, y))}
+    chromatic_bands = {
+        "blue": any(b > 160 and b-r > 80 and b-g > 64 for r, g, b in banner_colors),
+        "cyan": any(g > 160 and b > 160 and min(g, b)-r > 48 for r, g, b in banner_colors),
+        "green": any(g > 112 and g-r > 32 and g-b > 32 for r, g, b in banner_colors),
+        "yellow": any(r > 160 and g > 112 and min(r, g)-b > 64 for r, g, b in banner_colors),
+    }
+    metadata = {
+        "schemaVersion": 1, "landmarkId": "fengjia-night-market",
+        "status": "approved architecture direction; unmerged native format candidate; entrance binding unresolved",
+        "originalStudySha256": sha(SOURCE), "originalStudyUnchanged": True,
+        "recipe": {"sourceCropBoxAlpha224": list(crop_box), "alphaThreshold": 224,
+                   "nativeSizePixels": list(size), "workingSizePixels": list(working), "nativePixelCluster": 2,
+                   "fitSizePixels": [v*2 for v in fit], "offsetPixels": [v*2 for v in offset],
+                   "resampling": "nearest; aspect-preserving fit with integer rounding; south aligned",
+                   "quantization": quantization+"15 opaque colors, nearest GBA5bit RGB, no dithering",
+                   "quantizationMethod": quantization,
+                   "opaqueColorCount": len(colors), "PillowVersion": PIL.__version__,
+                   "paletteBankCandidate": PALETTE_BANK,
+                   "paletteAvailability": "unallocated; Root may choose9 or another new Xitun bank after joint budgeting"},
+        "native": {"unmergedUniqueGraphicsIncludingBlank": len(graphics), "paddedSheetSlots": physical,
+                   "provisionalTargetAtMost": 200, "meetsProvisionalTarget": len(graphics) <= 200,
+                   "binaryAlpha": set(native.getchannel("A").get_flattened_data()) == {0, 255},
+                   "relativeGraphicIndices": True, "tilemapDimensions8x8": [width//8, height//8],
+                   "foregroundEnvelopeCells": len(metatiles), "occupiedMetatiles": sum(row.count("1") for row in rows),
+                   "distinctForegroundDefinitionsIncludingEmpty": len({tuple(group) for group in metatiles}),
+                   "occupancyRows": rows, "roundTripPixels": width*height, "tilemapRoundTripPass": True},
+        "entryAnalysis": {"regions": entry_regions, "regionsAreMeasurementsOnly": True,
+                          "actualPaintedDoorExists": False,
+                          "visuallyIdentifiedEntry": "dark central market-lane mouth; flanking open stall counters, not a rendered door leaf/frame",
+                          "laneAlphaMustBeMeasuredNotAssumed": True,
+                          "centralLaneTransparentCountsByRow": lane_transparent_by_row,
+                          "centralLaneFullyTransparentRowCount": sum(n == lane_box[2]-lane_box[0] for n in lane_transparent_by_row),
+                          "centralLaneBottomEdgeHasTransparentPixel": bool(lane_transparent_by_row[-1]),
+                          "alpha0CorridorFromSouthExists": False if not lane_transparent_by_row[-1] else None,
+                          "doorDrawnOrErasedByConversion": False,
+                          "fixedWorldDoor": [24, 12], "fixedApproach": [24, 13], "fixedArrival": [24, 15],
+                          "rootPotentialOriginOnly": [19, 7] if size == (160, 96) else None,
+                          "rootHypotheticalDoorLocalOnly": [5, 5] if size == (160, 96) else None,
+                          "hypotheticalDoorRegionIs16x16Cell": size == (160, 96),
+                          "largerVariantDoorRegionIsOnlyProjected160Probe": size != (160, 96),
+                          "paintedDoorCenterOrBinding": None, "mapAllocationOrActivation": False,
+                          "woodenDoorFloatingInLaneApproved": False},
+        "recognizabilityMeasurements": {"fourStarInspectionROI": list(star_box), "yellowComponentsInROI": stars,
+                       "fourSeparateYellowStarComponentsMeasured": len(stars) == 4,
+                       "whiteRoundEndPanelRegions": panels, "rainbowChromaticBandsMeasured": chromatic_bands,
+                       "roundEndPanelsAndRainbowRequireVisualReview": True},
+        "files": {"indexed": "candidate-indexed.png", "rgba": "candidate-native.png", "preview": "preview-4x.png",
+                  "palette": "09.pal", "graphics4bpp": "tiles.4bpp", "foregroundTilemapRelative": "foreground-tilemap-relative.bin"},
+        "jointXitunBudgetChecked": False, "mapOrBankChanged": False, "registeredInRom": False, "nativeReady": False,
+    }
+    (output / "encode-manifest.json").write_text(json.dumps(metadata, indent=2)+"\n")
+    assert sha(SOURCE) == EXPECTED_SOURCE_SHA
+    print(json.dumps({"png": str(output / "preview-4x.png"), "format": metadata["native"],
+                      "entryAnalysis": metadata["entryAnalysis"], "stars": metadata["recognizabilityMeasurements"]}, indent=2))
+    return metadata
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, default=HERE / "candidate-maxcoverage")
+    parser.add_argument("--size", choices=("160x96", "192x128"), default="160x96")
+    parser.add_argument("--quantization", choices=("median", "maxcoverage"), default="maxcoverage")
+    args = parser.parse_args()
+    encode(args.output, tuple(map(int, args.size.split("x"))), args.quantization)
