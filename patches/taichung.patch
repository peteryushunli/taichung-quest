+#!/usr/bin/env python3
+"""Run real encounter field/core/bridge and the actual battle-return callback."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "build/taichung-tests/encounter-return"
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("extract", ROOT / "tools/taichung_gameplay/test-save-facing.py")
+extract = importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+callback = extract.definition((ROOT / "src/battle_setup.c").read_text(), "CB2_EndScriptedWildBattle")[0]
+(OUT / "native-encounter-battle-return.inc").write_text(callback + "\n")
+subprocess.run(["cc", "-std=gnu99", "-Werror=implicit-function-declaration", "-Wno-unknown-attributes",
+    "-Wno-unknown-escape-sequence", "-Wno-pointer-to-int-cast", "-Wno-int-to-pointer-cast",
+    "-I"+str(ROOT/"include"), "-I"+str(OUT), str(ROOT/"src/taichung_encounter.c"),
+    str(ROOT/"src/taichung_encounter_bridge.c"), str(ROOT/"src/taichung_encounter_field.c"),
+    str(ROOT/"tests/taichung_encounter_field_test.c"), "-o", str(OUT/"encounter-return")], check=True)
+subprocess.run([str(OUT/"encounter-return")], check=True)
+# Clean worktrees do not contain the ROM build's generated map header.
+groups = json.loads((ROOT / "data/maps/map_groups.json").read_text())
+lines = []
+for group, name in enumerate(groups["group_order"]):
+    for number, folder in enumerate(groups[name]):
+        info = json.loads((ROOT / f"data/maps/{folder}/map.json").read_text())
+        lines.append(f'#define {info["id"]} ({number} | ({group} << 8))')
+header = OUT / "include/constants/map_groups.h"
+header.parent.mkdir(parents=True, exist_ok=True); header.write_text("\n".join(lines)+"\n")
+env = dict(os.environ, CPATH=str(OUT/"include"))
+(OUT / "native-gym-prepare.inc").write_text(extract.definition((ROOT / "src/taichung_gym_adapter.c").read_text(), "TaichungGym_ScriptPrepareChallenge")[0] + "\n")
+subprocess.run(["cc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-I"+str(ROOT/"tests/team_host"),
+    "-I"+str(ROOT/"include"), str(ROOT/"src/taichung_team.c"), str(ROOT/"src/taichung_encounter.c"),
+    str(ROOT/"src/taichung_gym_progress.c"), "-I"+str(OUT),
+    str(ROOT/"tests/taichung_encounter_team_test.c"), "-o", str(OUT/"encounter-team")], env=env, check=True)
+subprocess.run([str(OUT/"encounter-team")], check=True)
