+            actual = gym_data['warp_events'][ret['warpId']]
+            require((actual['x'], actual['y'], actual['dest_map'], int(actual['dest_warp_id'])) == (ret['x'], ret['y'], parent['mapId'], entrance['warpId']), 'Gym return does not target its parent entrance')
+        require(landmark['gymEntryWarpId'] < len(gym_data['warp_events']), 'Gym entry warp is absent')
+        world = [parent['worldOrigin'][0] + local[0], parent['worldOrigin'][1] + local[1]]
+        marker = dict(id=landmark['id'], gymId=landmark['id'], name=landmark['name'], kind='landmark-gym',
+            exteriorMapId=parent['mapId'], exteriorNativeKey=parent['nativeKey'], localEntrance=local, world=world,
+            exteriorWarpId=entrance['warpId'], gymMapId=gym['mapId'], gymNativeKey=gym['nativeKey'], gymEntryWarpId=landmark['gymEntryWarpId'])
+        require(marker['id'] not in markers, 'Duplicate landmark marker')
+        markers[marker['id']] = marker; parent['markerIds'].append(marker['id'])
