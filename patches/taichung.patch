diff --git a/tools/taichung_gameplay/test-landmark-history.py b/tools/taichung_gameplay/test-landmark-history.py
new file mode 100644
index 0000000..153e4a3
--- /dev/null
+++ b/tools/taichung_gameplay/test-landmark-history.py
@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+"""Exercise optional history routes in the installed scripts, including B/replay.
+
+This is a source-level script interpreter, not an emulator. Native runtime
+acceptance remains separate. Battle preparation is observed, never simulated as
+a win, and history actions must never write progress or prepare a battle.
+"""
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def labels(texts):
+    result = {}
+    current = None
+    for text in texts:
+        for line in text.splitlines():
+            line = line.split('@', 1)[0].strip()
+            if not line or line.startswith('#'):
+                continue
+            if line.startswith('.'):
+                continue
+            if line.endswith(':'):
+                current = line.rstrip(':')
+                assert current not in result
+                result[current] = []
+            elif current:
+                result[current].append(line)
+    # Script labels naturally fall through into the next label's instructions.
+    names = list(result)
+    for i, name in enumerate(names[:-1]):
+        result[name].append('goto ' + names[i + 1])
+    return result
+
+
+TEXTS = [(ROOT / ('data/scripts/' + name)).read_text() for name in (
+    'taichung_gyms.inc', 'taichung_park_gym.inc', 'taichung_miyahara_gym.inc',
+    'taichung_landmark_history.inc', 'taichung_city.inc')]
+MACRO = (ROOT / 'data/scripts/taichung_landmark_gym.inc').read_text()
+MACRO_NAMES = []
+for file in ('science', 'greenway', 'shen_ji', 'fine_arts', 'fengjia', 'maple_garden', 'theater'):
+    invocation = (ROOT / ('data/scripts/taichung_' + file + '_gym.inc')).read_text().strip()
+    match = re.fullmatch(r'taichung_landmark_gym (\w+), (\w+), (\w+)', invocation)
+    assert match is not None, invocation
+    name, gym, trainer = match.groups()
+    MACRO_NAMES.append(name)
+    TEXTS.append(MACRO.replace(r'\name\()', name).replace(r'\name', name).replace(r'\gym', gym).replace(r'\trainer', trainer))
+TEXTS.append((ROOT / 'data/taichung_character_npcs.s').read_text())
+PROGRAM = labels(TEXTS)
+SYMBOLS = {'TRUE': 1, 'FALSE': 0, 'NO': 0, 'YES': 1}
+
+
+def run(choices, complete=False, replay=False, available=True, name='Miyahara', temple=False, locale=1, helper=None):
+    entry = 'TaichungCity_Host_' + name if temple else 'TaichungGym_EventScript_' + name + 'Challenge'
+    if helper is not None: entry = helper
+    label, index, stack = entry, 0, []
+    locked = False
+    waiting_message = False
+    protected = {'VAR_0x40FB':locale,'VAR_0x40FA':0x3FF if complete else 0,'VAR_0x40F8':1,'VAR_0x40F9':2}
+    variables = {'VAR_RESULT': 0, **protected}
+    choices = iter(choices)
+    events = []
+
+    def value(text):
+        if text in variables:
+            return variables[text]
+        if text in SYMBOLS:
+            return SYMBOLS[text]
+        if re.fullmatch(r'\d+', text):
+            return int(text)
+        return text
+
+    for _ in range(300):
+        instruction = PROGRAM[label][index]
+        index += 1
+        operation, _, arguments = instruction.partition(' ')
+        parts = [part.strip() for part in arguments.split(',')]
+        if operation == 'setvar':
+            variables[parts[0]] = value(parts[1])
+            assert parts[0] in ('VAR_RESULT', 'VAR_0x8004', 'VAR_0x8005'), instruction
+        elif operation == 'lock':
+            assert not locked; locked = True
+        elif operation == 'release':
+            assert locked and not waiting_message; locked = False
+        elif operation in ('faceplayer','msgbox'):
+            assert locked, instruction
+        elif operation == 'message':
+            assert locked and arguments == 'gStringVar4', instruction
+            waiting_message = True
+            if variables.get('VAR_0x8005') == 'TAICHUNG_GYM_MESSAGE_OFFER':
+                events.append('offer')
+        elif operation == 'waitmessage':
+            assert locked and waiting_message, instruction
+            if events and events[-1] == 'offer':
+                waiting_message = False
+        elif operation == 'waitbuttonpress':
+            assert locked and waiting_message, instruction
+            waiting_message = False
+        elif operation == 'goto_if_questlog':
+            if replay:
+                label, index = arguments, 0
+        elif operation in ('goto_if_eq', 'goto_if_ne'):
+            matched = value(parts[0]) == value(parts[1])
+            if matched == (operation == 'goto_if_eq'):
+                label, index = parts[2], 0
+        elif operation == 'goto':
+            label, index = arguments, 0
+        elif operation == 'call':
+            stack.append((label, index))
+            label, index = arguments, 0
+        elif operation == 'return':
+            if not stack:
+                return events
+            label, index = stack.pop()
+        elif operation == 'end':
+            assert not locked
+            assert all(variables[key] == value for key,value in protected.items())
+            return events
+        elif operation == 'multichoice':
+            # Only a gym's own challenge question opens the Challenge/Leave menu;
+            # completed gyms and temples never show a menu.
+            assert not complete and not temple, instruction
+            assert parts[2] == 'MULTICHOICE_TAICHUNG_HISTORY' and parts[3] == 'FALSE', instruction
+            assert events and events[-1] == 'offer', ('menu without the challenge question', events)
+            choice = next(choices)
+            assert choice in (0, 1, 127)
+            variables['VAR_RESULT'] = choice
+        elif operation == 'callnative':
+            if arguments == 'TaichungGym_ScriptIsComplete':
+                variables['VAR_RESULT'] = int(complete)
+            elif arguments == 'TaichungHistory_ScriptHasFacts':
+                variables['VAR_RESULT'] = int(available)
+            elif re.fullmatch(r'TaichungGym_ScriptConsume\w+LossNotice', arguments):
+                variables['VAR_RESULT'] = 0
+            elif arguments == 'TaichungHistory_ScriptBufferTour':
+                assert 'offer' not in events, ('history after the challenge question', events)
+                events.append('history')
+            elif arguments == 'TaichungHistory_ScriptBufferSign':
+                events.append('sign')
+            elif arguments == 'TaichungHistory_ScriptBufferStaff':
+                expected_id = {
+                    'TaichungHistory_StaffMiyahara':'TAICHUNG_GYM_MIYAHARA',
+                    'TaichungHistory_StaffPark':'TAICHUNG_GYM_PARK',
+                    'TaichungHistory_StaffShenJi':'TAICHUNG_GYM_SHEN_JI',
+                    'TaichungHistory_StaffFineArts':'TAICHUNG_GYM_FINE_ARTS',
+                    'TaichungHistory_StaffMapleGarden':'TAICHUNG_GYM_MAPLE_GARDEN',
+                }[helper]
+                assert variables['VAR_0x8004'] == expected_id, (helper,variables)
+                events.append('staff')
+            elif re.fullmatch(r'TaichungNpc_(Aming|Ayan|Qiaoqiao|Mei|Boxun)Message',arguments):
+                assert arguments == helper+'Message'
+                waiting_message = True
+                events.append('staff')
+            elif arguments == 'TaichungGym_ScriptPrepareChallenge':
+                assert events[-1] == 'offer' and 'history' in events or not available, events
+                events.append('prepare')
+                variables['VAR_RESULT'] = 1
+            elif arguments == 'TaichungGym_ScriptCancelChallenge':
+                events.append('cancel')
+            elif re.fullmatch(r'TaichungGym_ScriptGet\w+Message', arguments):
+                pass
+            else:
+                raise AssertionError(arguments)
+        elif operation == 'trainerbattle_single':
+            events.append('battle')
+            return events
+        else:
+            raise AssertionError(instruction)
+    raise AssertionError('History interaction did not terminate')
+
+
+CASES = [
+    ([0], False, False, True, ['history', 'offer', 'prepare', 'battle']),
+    ([1], False, False, True, ['history', 'offer']),
+    ([127], False, False, True, ['history', 'offer']),
+    ([], True, False, True, ['history']),
+    ([], False, True, True, ['cancel']),
+    ([], True, True, True, ['cancel']),
+    ([0], False, False, False, ['offer', 'prepare', 'battle']),
+    ([1], False, False, False, ['offer']),
+    ([], True, False, False, []),
+]
+count = 0
+for name in ('Station', 'Park', 'Miyahara', *MACRO_NAMES):
+    for locale in (1, 2):
+        for choices, complete, replay, available, expected in CASES:
+            assert run(choices, complete, replay, available, name=name, locale=locale) == expected, (name, locale, choices, complete, replay)
+            count += 1
+for name in ('WenchangTemple', 'WanheTemple'):
+    for locale in (1, 2):
+        for choices, replay, expected in [([], False, ['sign', 'history']), ([], True, [])]:
+            assert run(choices, replay=replay, name=name, temple=True, locale=locale) == expected, (name, choices)
+            count += 1
+
+# Every source record's existing sign routes through the selected read-only API.
+import json
+city = (ROOT / 'data/scripts/taichung_city.inc').read_text()
+records = list((ROOT / 'data/taichung/landmark-history').glob('*.json'))
+assert len(records) == 12
+for path in records:
+    record = json.loads(path.read_text())
+    sign = record['nativeBinding']['sign']['script']
+    block = re.search(r'^' + re.escape(sign) + r'::\s*\n(.*?)(?=^\w+::|\Z)', city, re.S | re.M)[1]
+    assert 'callnative TaichungHistory_ScriptBufferSign' in block and 'msgbox gStringVar4, MSGBOX_SIGN' in block
+    assert not any(word in block for word in ('setflag', 'trainerbattle', 'VarSet', 'PrepareChallenge'))
+print(f'PASS:{count} installed bilingual history routes across10 gyms/2 temples;12 sign bindings; history as the lead-in to each challenge question; Challenge/Leave/B; post-win telling; replay isolation.')
+
+# Every existing or new helper remains voluntary, read-only and reachable after
+# victory. Replay must skip both the buffer and the existing wait sequence.
+helpers = ['TaichungNpc_'+name for name in ('Aming','Ayan','Qiaoqiao','Mei','Boxun')]
+helpers += ['TaichungHistory_Staff'+name for name in ('Miyahara','Park','ShenJi','FineArts','MapleGarden')]
+helper_count = 0
+for helper in helpers:
+    for locale in (1,2):
+        for complete in (False,True):
+            for replay in (False,True):
+                expected = [] if replay else ['staff']
+                assert run([],complete=complete,replay=replay,locale=locale,helper=helper) == expected, (helper,locale,complete,replay)
+                helper_count += 1
+print(f'PASS:{helper_count} installed bilingual helper routes across10 NPCs; exact replay skip, retained lock/wait/release and pre/post-win access; no battle/progress/settings writes.')
+
+# The installed native menu sources must select the matching language and offer
+# only Challenge/Leave under a gym's question; About and the completed menu are gone.
+menu = (ROOT / 'src/script_menu.c').read_text()
+for suffix in ('','Zh'):
+    block = re.search(r'static const struct MenuAction sMultichoiceList_TaichungHistory'+suffix+r'\[\] = \{(.*?)\};',menu,re.S)[1]
+    names = re.findall(r'gTaichungHistory(\w+?)(En|Zh)\b',block)
+    assert names == [(name,'Zh' if suffix else 'En') for name in ('Challenge','Leave')], names
+assert re.search(r'if \(mcId == MULTICHOICE_TAICHUNG_HISTORY && TaichungIsChinese\(\)\)\s*list = sMultichoiceList_TaichungHistoryZh;',menu)
+assert 'HistoryComplete' not in menu and 'gTaichungHistoryAbout' not in menu
+assert 'MULTICHOICE_TAICHUNG_HISTORY_COMPLETE' not in (ROOT / 'include/constants/menu.h').read_text()
+print('PASS: installed EN/ZH menu bindings; the gym question offers Challenge/Leave only; no About menu remains.')
