@@ -0,0 +1,304 @@
+#!/usr/bin/env python3
+"""Propose native ordinary blocks for the current 40x72 Old City, without install."""
+import argparse
+from collections import deque
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+from tempfile import TemporaryDirectory
+
+from PIL import Image, ImageDraw
+
+from color_compile import compile_colorways, color_grid, native_tile_images
+from library import ROOT, parse_words, render_tools, require
+from neighborhood_blocks import block_prefab
+from neighborhood_fill import cells
+from neighborhood_frontage import bay_widths
+from neighborhood_pilot import player_reference
+
+PROPOSAL = ROOT / 'data/taichung/neighborhoods/old-city-route-fill.json'
+MAP_ID = 'MAP_TAICHUNG_OLD_CITY'
+WIDTH, HEIGHT = 40, 72
+ROW_SPECS = [
+    ('west-north-upper', [2, 2, 11, 9], 'residential', 'terracotta'),
+    ('west-north-lower', [2, 12, 11, 19], 'residential', 'terracotta'),
+    ('west-middle-upper', [2, 24, 11, 31], 'residential', 'slate'),
+    ('west-middle-centre', [2, 33, 11, 40], 'residential', 'terracotta'),
+    ('west-middle-lower', [2, 42, 11, 49], 'shop', 'terracotta'),
+    ('west-south-upper', [2, 54, 11, 61], 'residential', 'slate'),
+    ('west-south-lower', [2, 62, 11, 69], 'residential', 'terracotta'),
+    ('north-attached-run', [16, 2, 37, 7], 'residential', 'teal'),
+    ('miyahara-north-shops', [16, 37, 29, 44], 'shop', 'terracotta'),
+    ('miyahara-east-shops', [26, 45, 29, 52], 'shop', 'mustard'),
+    ('east-park-shops', [34, 34, 37, 41], 'shop', 'teal'),
+    ('east-middle-shops', [34, 42, 37, 49], 'shop', 'slate'),
+    ('east-station-shops', [34, 51, 37, 56], 'shop', 'slate'),
+]
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    value = importlib.util.module_from_spec(spec); spec.loader.exec_module(value)
+    return value
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def adjacent(point):
+    x, y = point
+    return ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1))
+
+
+def source_context():
+    contract_path = ROOT / 'docs/taichung-city-contract.json'
+    map_path = ROOT / 'data/maps/TaichungOldCity/map.json'; layout_path = ROOT / 'data/layouts/layouts.json'
+    contract = json.loads(contract_path.read_text()); data = json.loads(map_path.read_text())
+    layout = next(l for l in json.loads(layout_path.read_text())['layouts'] if l.get('id') == data['layout'])
+    require((layout['width'], layout['height']) == (WIDTH, HEIGHT), 'Proposal only applies to current 40x72 Old City')
+    validator = module('route_source_geometry', ROOT / 'tools/taichung/validate_city.py')
+    native = validator.Map(ROOT, data, layout, {})
+    # The registered map may already contain this proposal. Always observe the
+    # compiler's three-landmark pre-infill snapshot when it is available, so
+    # rebuild/check never replans from installed ordinary buildings.
+    landmark_path = ROOT / 'data/taichung/landmarks/old-core-native/landmark-map.bin'
+    native.proposal_base_path = landmark_path if landmark_path.exists() else ROOT / layout['blockdata_filepath']
+    native.cells = struct.unpack('<2880H', native.proposal_base_path.read_bytes())
+    baseline_path = ROOT / 'data/taichung/landmarks/old-core-native/baseline-map.bin'
+    native.baseline_cells = struct.unpack('<2880H', baseline_path.read_bytes())
+    paths = [contract_path, map_path, layout_path, native.proposal_base_path,
+             ROOT / 'src/data/tilesets/headers.h', ROOT / 'src/data/tilesets/metatiles.h', ROOT / 'src/data/tilesets/graphics.h',
+             ROOT / 'data/taichung/prefabs/catalog.json', ROOT / 'data/taichung/prefabs/colorways.json', baseline_path]
+    for label in (layout['primary_tileset'], layout['secondary_tileset']):
+        resolved = render_tools().tileset_paths(ROOT, label)
+        paths.extend([resolved['tiles'], resolved['metatiles'], resolved['metatiles'].parent / 'metatile_attributes.bin'])
+        paths.extend(sorted(resolved['palettes'].glob('*.pal')))
+    fingerprints = {str(p.relative_to(ROOT)): sha(p) for p in dict.fromkeys(paths)}
+    return contract, data, layout, native, validator, fingerprints
+
+
+def protection(contract, data, native):
+    rules = []
+    def rect(name, value): rules.append(dict(id=name, rectInclusive=value))
+    rect('outer-boundary', [0, 0, 39, 1]); rect('outer-boundary-south', [0, 70, 39, 71])
+    rect('outer-boundary-west', [0, 2, 1, 69]); rect('outer-boundary-east', [38, 2, 39, 69])
+    rect('main-avenue', [12, 2, 15, 69]); rect('north-crossing-and-west-seam', [0, 20, 37, 23])
+    rect('south-crossing-and-west-seam', [0, 50, 23, 53]); rect('miyahara-south-road', [12, 54, 23, 56])
+    rect('station-boulevard', [12, 66, 37, 69]); rect('east-north-south-road', [30, 31, 33, 69])
+    rect('park-main-avenue-link', [12, 33, 33, 36])
+    rect('actual-park-lake-lawns-shore-promenade', [19, 9, 37, 32])
+    rect('station-candidate-envelope', [26, 57, 37, 64])
+    rect('miyahara-candidate-and-old-placeholder-clearance', [15, 45, 25, 52])
+    rect('park-candidate-and-old-placeholder-clearance', [26, 23, 37, 30])
+    rect('station-west-walking-connection', [24, 53, 25, 69])
+    rect('station-roof-north-clear-shoulder', [26, 53, 29, 56])
+    # Geometry derives from the baseline contract, including real route anchors.
+    for h in contract.get('habitatRegions', []):
+        if h['map'] == MAP_ID: rect('habitat-' + h['id'], h['rect'])
+    for landmark in contract['landmarks']:
+        if landmark['exteriorMap'] != MAP_ID: continue
+        door = landmark['entrance']; rect(landmark['id'] + '-door', [door['x'], door['y'], door['x'], door['y']])
+        rect(landmark['id'] + '-original-front-apron', [max(2, door['x'] - 4), door['y'] + 1, min(37, door['x'] + 4), door['y'] + 3])
+    protected = set().union(*(cells(r['rectInclusive']) for r in rules))
+    event_cells = native.actors | native.signs
+    event_interactions = set()
+    for point in event_cells:
+        protected.add(point)
+        for neighbor in adjacent(point):
+            if native.walkable(*neighbor): protected.add(neighbor); event_interactions.add(neighbor)
+    # Preserve all actual tall-grass and water cells, even if a future source
+    # revision adds a habitat beyond the explicit park/contract rectangles.
+    for y in range(HEIGHT):
+        for x in range(WIDTH):
+            behavior = native.behavior(x, y)
+            if behavior == 2 or behavior in (0x10, 0x11, 0x12, 0x13, 0x14): protected.add((x, y))
+    # Approved repair: the original decorative grove overwrote an existing
+    # road alignment. Only those baseline tree cells may change to road paving.
+    repair = {(x, y) for x, y in cells([30, 38, 33, 45])
+              if native.baseline_cells[y * WIDTH + x] & 1023 in (0xe, 0xf, 0x16, 0x17)}
+    protected -= repair
+    return rules, protected, event_interactions, repair
+
+
+def plan_units():
+    units = []; rows = []
+    for index, (name, rect, role, family) in enumerate(ROW_SPECS):
+        x0, y0, x1, y1 = rect; h = y1 - y0 + 1; x = x0; identities = []
+        for bay, w in enumerate(bay_widths(x1 - x0 + 1)):
+            # Residential bay pairs have controlled height contrast; the shop
+            # avenue uses deeper joined fronts. No side-yard gap is introduced.
+            bh = 6 if role == 'residential' and h == 8 and bay == 1 and index % 2 == 0 else h
+            material = family
+            if name == 'west-middle-upper': material = 'source'
+            if name == 'north-attached-run' and bay < 2: material = 'slate'
+            identity = f'old-city-route-{name}-bay-{bay + 1}'
+            unit = dict(id=identity, prefab=f'block-bay-{role}-{w}x{bh}', x=x, y=y1 - bh + 1,
+                width=w, height=bh, role=role, colorway=material, context='shopping' if role == 'shop' else 'residential', rowId=name)
+            units.append(unit); identities.append(identity); x += w
+        rows.append(dict(id=name, envelopeInclusive=rect, role=role, unitIds=identities,
+            character='continuous commercial main-avenue frontage' if role == 'shop' else 'quieter attached residential lane'))
+    return units, rows
+
+
+def build_proposal():
+    contract, data, layout, native, validator, fingerprints = source_context()
+    rules, protected, interactions, repair = protection(contract, data, native); units, rows = plan_units()
+    all_building_patches = set().union(*(cells([u['x'], u['y'], u['x'] + u['width'] - 1, u['y'] + u['height'] - 1]) for u in units))
+    require(not all_building_patches & protected, f'Building/apron enters protected source: {sorted(all_building_patches & protected)}')
+    # Ground work is deliberately limited to unsourced decorative groves/open
+    # land within the row neighborhoods. Roads/park/shore/habitat remain exact.
+    zones = [([2, 2, 11, 19], 0x31c1), ([2, 24, 11, 49], 0x31c1), ([2, 54, 11, 69], 0x31c1),
+             ([16, 2, 37, 8], 0x31c1), ([16, 37, 29, 44], 0x316e), ([26, 45, 29, 52], 0x316e),
+             ([34, 33, 37, 56], 0x316e)]
+    ground = {}
+    for rect, word in zones:
+        for point in cells(rect) - protected: ground[point] = word
+    for point in repair: ground[point] = 0x3175
+    allowed_tree_cells = set().union(*(cells(r) for r in ([3, 3, 10, 12], [3, 27, 10, 44], [17, 2, 22, 7], [23, 38, 36, 45], [3, 57, 10, 64])))
+    allowed_ground = {1, 8, 9, 0x10, 0x11, 0x165, 0x166, 0x167, 0x16d, 0x16e, 0x16f, 0x175, 0x176, 0x177, 0x1c1}
+    for x, y in ground:
+        old = native.baseline_cells[y * WIDTH + x]; tree = (old & 1023) in (0xe, 0xf, 0x16, 0x17)
+        require((tree and (x, y) in allowed_tree_cells) or (not old & 0xc00 and old & 1023 in allowed_ground), f'Ground patch would erase non-decorative terrain at {x},{y}: {old:#x}')
+    catalog = json.loads((ROOT / 'data/taichung/prefabs/catalog.json').read_text()); template = catalog['prefabs'][0]
+    definitions = {u['prefab']: u for u in units}; added = [block_prefab(u, template) for _, u in sorted(definitions.items())]
+    catalog['prefabs'].extend(added)
+    recipe = json.loads((ROOT / 'data/taichung/prefabs/colorways.json').read_text()); recipe['eligiblePrefabs'].extend(p['id'] for p in added)
+    with TemporaryDirectory(prefix='old-city-infill-colors-') as temporary:
+        path = Path(temporary) / 'colors.json'; path.write_text(json.dumps(recipe))
+        compiled = compile_colorways(catalog=catalog, colorways=path, variant_metatile_start=815)
+    proposal_base = list(native.cells)
+    for (x, y), word in ground.items(): proposal_base[y * WIDTH + x] = word
+    bare = [{k: u[k] for k in ('id', 'prefab', 'x', 'y', 'context')} for u in units]
+    composed = compiled['library'].compose(WIDTH, HEIGHT, bare, base=proposal_base)
+    words = color_grid(compiled, composed, units)
+    painted = {(u['x'] + x, u['y'] + y) for u in units for y, row in enumerate(compiled['library'].prefabs[u['prefab']]['masks']['paint']) for x, bit in enumerate(row) if bit == '1'}
+    # Main has already installed these metatile IDs. Compare their displayed
+    # native pixels/behaviors rather than assuming the two packed banks agree.
+    used = {words[y * WIDTH + x] & 1023 for x, y in painted}
+    actual_atlas = render_tools().render_metatiles(ROOT, layout['primary_tileset'], layout['secondary_tileset'])
+    for tile, image in native_tile_images(compiled, used).items():
+        require(tile < len(actual_atlas) and image.tobytes() == actual_atlas[tile].tobytes(), f'Installed native metatile differs from approved source color kit: {tile:#x}')
+        expected_attr = compiled['library'].attr(tile) if tile < 640 else compiled['attributes'][tile - 640]
+        require(native.attribute(tile) == expected_attr, f'Installed native behavior differs: {tile:#x}')
+    changed = set(ground) | painted
+    def behavior(x, y):
+        tile = words[y * WIDTH + x] & 1023
+        attribute = native.attribute(tile)
+        require(attribute is not None, f'Proposed word has no installed native behavior: {tile:#x}')
+        return attribute & 0x1ff
+    def walk(point):
+        x, y = point
+        return 0 <= x < WIDTH and 0 <= y < HEIGHT and point not in native.obstacles and not words[y * WIDTH + x] & 0xc00 and behavior(x, y) in validator.WALK_BEHAVIORS
+    spawn = (30, 66); require(walk(spawn), 'Station arrival blocked'); seen = {spawn}; queue = deque([spawn]); previous = {}
+    while queue:
+        point = queue.popleft(); current_elevation = words[point[1] * WIDTH + point[0]] >> 12
+        for n in adjacent(point):
+            if n in seen or not walk(n): continue
+            target_elevation = words[n[1] * WIDTH + n[0]] >> 12
+            if current_elevation != 0 and target_elevation not in (0, 15, current_elevation): continue
+            seen.add(n); previous[n] = point; queue.append(n)
+    approaches = {}
+    for landmark in contract['landmarks']:
+        if landmark['exteriorMap'] != MAP_ID: continue
+        p = landmark['approach']; point = (p['x'], p['y']); require(point in seen, f'Landmark approach disconnected: {landmark["id"]}'); approaches[landmark['id']] = list(point)
+    seams = [(0, y) for y in (20, 21, 22, 23, 50, 51, 52, 53)]
+    for p in seams: require(p in seen, f'West seam blocked: {p}')
+    for e in composed['entrances']: require(e['status'] == 'dormant-reservation' and tuple(e['southApproach']) in seen, 'Ordinary entrance approach unreachable/active')
+    for p in interactions: require(p in seen, f'Actor/sign interaction cell blocked: {p}')
+    for x, y in protected: require(words[y * WIDTH + x] == native.cell(x, y), f'Protected source cell changed at {x},{y}')
+    require(all(words[y * WIDTH + x] & 0xc00 and words[y * WIDTH + x] >> 12 == 0 for x, y in painted), 'Roof footprint not fully blocked independently of story flags')
+    for u in units:
+        p = compiled['library'].prefabs[u['prefab']]
+        for row in parse_words(p):
+            for w in row: require(compiled['library'].attr(w & 1023) & 0x1ff not in range(0x60, 0x70), 'New prefab has active warp behavior')
+    ground_patches = []
+    for y in range(HEIGHT):
+        x = 0
+        while x < WIDTH:
+            if (x, y) not in ground: x += 1; continue
+            x0 = x; word = ground[x, y]
+            while x + 1 < WIDTH and ground.get((x + 1, y)) == word: x += 1
+            ground_patches.append(dict(rectInclusive=[x0, y, x, y], word=f'0x{word:04X}')); x += 1
+    paths = {}
+    for identity, end in approaches.items():
+        p = tuple(end); chain = [list(p)]
+        while p != spawn: p = previous[p]; chain.append(list(p))
+        paths[identity] = list(reversed(chain))
+    result = dict(schemaVersion=1, status='proposal only; native installation and bank merge belong to Main', mapId=MAP_ID,
+        dimensions=[WIDTH, HEIGHT], baseMapSha256=fingerprints[str(native.proposal_base_path.relative_to(ROOT))],
+        proposalBasePath=str(native.proposal_base_path.relative_to(ROOT)), sourceSha256=fingerprints,
+        frozenBaselineSha256=fingerprints['data/taichung/landmarks/old-core-native/baseline-map.bin'],
+        sourceTileNamespace=dict(primary='General', secondary='PewterCity', targetSecondary=layout['secondary_tileset'],
+            colorVariantMetatilesInclusive=[815, 846], installedNativeRenderAndBehaviorVerified=True, extraMetatilesRequired=0),
+        landmarkEnvelopes=[r for r in rules if 'candidate' in r['id'] or 'placeholder' in r['id']],
+        protectedRules=rules, protectedCells=sorted([list(p) for p in protected]),
+        explicitRoadCorridorRepair=dict(rectInclusive=[30, 38, 33, 45], cells=sorted([list(p) for p in repair]), word='0x3175',
+            reason='Approved clearing of decorative trees that overwrote the existing road; no road alignment changes.'),
+        protectedActors=sorted([list(p) for p in native.actors]), protectedSigns=sorted([list(p) for p in native.signs]),
+        groundPatches=ground_patches, rows=rows, placements=units,
+        sourcePrefabs=added, colorwayRecipe='data/taichung/prefabs/colorways.json',
+        doorApproaches=composed['entrances'], routeProofPaths=paths,
+        wordDelta=[dict(x=x, y=y, baselineWord=f'0x{native.baseline_cells[y * WIDTH + x]:04X}',
+            observedCurrentWord=f'0x{native.cell(x,y):04X}', word=f'0x{words[y * WIDTH + x]:04X}',
+            reason='ordinary-building' if (x,y) in painted else 'approved-corridor-repair' if (x,y) in repair else 'ordinary-block-ground')
+            for x,y in sorted(changed, key=lambda p:(p[1],p[0])) if words[y*WIDTH+x] != native.baseline_cells[y*WIDTH+x]],
+        validation=dict(result='pass', protectedCellsUnchanged=len(protected), changedGroundCells=len(ground),
+            buildingSolidCells=len(painted), ordinaryBuildingBays=len(units), continuousRows=len(rows), restoredRoadTreeCells=len(repair),
+            reachableCells=len(seen), landmarkApproaches=approaches, westSeamCells=[list(p) for p in seams],
+            actorAndSignInteractionCells=len(interactions), dormantApproaches=len(composed['entrances']),
+            roofOrProtectedOverflows=0, sourceNativeBank=compiled['budget']),
+        artStatus='accepted V4 native source geometry/colors; provisional FireRed art, no actual parcel claims')
+    applied = list(native.cells)
+    for delta in result['wordDelta']:
+        point = (delta['x'], delta['y']); require(point not in protected, 'Native delta enters a protected landmark/road/park cell')
+        applied[delta['y'] * WIDTH + delta['x']] = int(delta['word'], 0)
+    require(applied == words, 'Delta does not reconstruct the verified current-art map')
+    result['validation']['nativeWordDeltaCells'] = len(result['wordDelta'])
+    result['validation']['installedMetatileRenderAndBehaviorComparisons'] = len(used)
+    result['validation']['nativeDeltaRoundtripPreservesCurrentLandmarkArt'] = True
+    # Source could be under Main's serial integration while this leaf runs.
+    # Reject a mixed snapshot instead of silently proposing against stale words.
+    for name, digest in fingerprints.items(): require(sha(ROOT / name) == digest, f'Source changed during proposal; rerun: {name}')
+    return result, compiled, words, native, layout, painted, ground
+
+
+def write(output, proposal=PROPOSAL, check=False):
+    result, compiled, words, native, layout, painted, ground = build_proposal()
+    if check:
+        require(json.loads(Path(proposal).read_text()) == result, 'Proposal is stale/edited; regenerate against current Main source')
+        print(json.dumps(result['validation'], indent=2)); return
+    output = Path(output); output.mkdir(parents=True, exist_ok=True)
+    atlas = render_tools().render_metatiles(ROOT, layout['primary_tileset'], layout['secondary_tileset'])
+    private = native_tile_images(compiled, {words[y * WIDTH + x] & 1023 for x, y in painted})
+    image = Image.new('RGB', (WIDTH * 16, HEIGHT * 16))
+    for y in range(HEIGHT):
+        for x in range(WIDTH):
+            tile = words[y * WIDTH + x] & 1023
+            source = private[tile] if (x, y) in painted else atlas[tile]
+            image.paste(source, (x * 16, y * 16))
+    player = player_reference(ROOT)
+    if player: image.paste(player, (30 * 16, 66 * 16 - 16), player)
+    image.save(output / 'old-city-route-native.png')
+    board = Image.new('RGB', (WIDTH * 16, HEIGHT * 16 + 80), '#e9efeb'); board.paste(image, (0, 56)); draw = ImageDraw.Draw(board)
+    draw.text((10, 8), 'PLAYABLE OLD CITY / ORDINARY BLOCK INFILL PROPOSAL / 40x72', fill='#19392f')
+    draw.text((10, 24), 'Attached homes west; main-avenue shop rows; fixed landmarks/park/routes.', fill='#365a4b')
+    draw.text((10, 40), 'Actual source base + native prefab overlay; Main owns final bank/map install.', fill='#365a4b')
+    draw.text((10, HEIGHT * 16 + 62), 'Station 30,66 -> Miyahara 20,53 -> Park 32,31; both west crossings clear.', fill='#365a4b')
+    board.save(output / 'old-city-route-overview.png')
+    Path(proposal).parent.mkdir(parents=True, exist_ok=True); Path(proposal).write_text(json.dumps(result, indent=2, ensure_ascii=False) + '\n')
+    (output / 'base-map-snapshot.bin').write_bytes(struct.pack('<2880H', *native.cells))
+    # Installed-native IDs were verified above. Return only explicit deltas,
+    # never an old whole map that could restore stale landmark placeholders.
+    mask = bytes(1 if (i % WIDTH, i // WIDTH) in painted else 0 for i in range(WIDTH * HEIGHT))
+    (output / 'prefab-overlay-mask.bin').write_bytes(mask)
+    (output / 'prefab-overlay-native-words.bin').write_bytes(struct.pack('<2880H', *(w if mask[i] else 0 for i, w in enumerate(words))))
+    print(json.dumps({k: v for k, v in result['validation'].items() if k != 'sourceNativeBank'}, indent=2)); print(output / 'old-city-route-overview.png')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--proposal', type=Path, default=PROPOSAL); parser.add_argument('--check', action='store_true')
+    args = parser.parse_args(); write(args.output, args.proposal, args.check)
