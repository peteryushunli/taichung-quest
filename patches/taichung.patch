diff --git a/tests/taichung_ai_test.c b/tests/taichung_ai_test.c
new file mode 100644
index 00000000..40b831b0
--- /dev/null
+++ b/tests/taichung_ai_test.c
@@ -0,0 +1,110 @@
+#include "global.h"
+#include "battle.h"
+#include "pokemon.h"
+#include "random.h"
+#include "taichung_battle_ai.h"
+#include "constants/battle_ai.h"
+#include "constants/battle_move_effects.h"
+#include "constants/moves.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "data/battle_moves.h"
+
+struct BattlePokemon gBattleMons[MAX_BATTLERS_COUNT];
+u32 gBattleTypeFlags, gRngValue;
+u16 gTrainerBattleOpponent_A;
+u8 gBattlerAttacker;
+static bool8 sGym, sCapture;
+static struct AI_ThinkingStruct sThinking;
+#define AI_THINKING_STRUCT (&sThinking)
+#define AI_ACTION_FLEE 2
+#define AI_ACTION_WATCH 4
+#define AI_CHOICE_FLEE 4
+#define AI_CHOICE_WATCH 5
+#define AIState_SettingUp 0
+bool8 TaichungGymIsBadgeChallenge(u16 trainer) { (void)trainer; return sGym; }
+bool8 TaichungEncounterIsActive(void) { return sCapture; }
+static void RecordLastUsedMoveByTarget(void) {}
+// This test supplies the scored turn boundary. It executes the actual selector
+// and policy, not the entire native scoring VM/damage engine.
+static void BattleAI_DoAIProcessing(void) { abort(); }
+#include "native-selector.inc"
+
+static void Turn(u8 def, u8 spDef)
+{
+    unsigned i;
+    memset(&sThinking, 0, sizeof(sThinking));
+    memset(gBattleMons, 0, sizeof(gBattleMons));
+    gBattlerAttacker = 1;
+    gBattleMons[1].moves[0] = MOVE_TACKLE;
+    gBattleMons[1].moves[1] = MOVE_HEADBUTT;
+    gBattleMons[1].moves[2] = MOVE_DEFENSE_CURL;
+    gBattleMons[1].moves[3] = MOVE_AMNESIA;
+    gBattleMons[1].statStages[STAT_DEF] = def;
+    gBattleMons[1].statStages[STAT_SPDEF] = spDef;
+    for (i = 0; i < 4; i++)
+    {
+        gBattleMons[1].pp[i] = 10;
+        sThinking.score[i] = 100;
+    }
+}
+
+int main(void)
+{
+    unsigned seed, repeats = 0, initialSetup = 0;
+    sCapture = TRUE; sGym = FALSE; gBattleTypeFlags = BATTLE_TYPE_WILD_SCRIPTED;
+    for (seed = 0; seed < 4096; seed++)
+    {
+        u8 first, second;
+        // The real CBM script leaves all four Snorlax moves at100 while neither
+        // defense is capped. Reproduce the real selector's repeated setup.
+        gRngValue = seed;
+        Turn(8, 8); first = BaselineChoose();
+        Turn(8, 8); second = BaselineChoose();
+        repeats += first >= 2 && second >= 2;
+        gRngValue = seed; Turn(8, 8);
+        assert(BattleAI_ChooseMoveOrAction() < 2);
+        assert(sThinking.score[2] == 92 && sThinking.score[3] == 92);
+        gRngValue = seed; Turn(6, 6);
+        initialSetup += BattleAI_ChooseMoveOrAction() >= 2;
+        assert(sThinking.score[2] == 100 && sThinking.score[3] == 100);
+    }
+    assert(repeats && initialSetup);
+    printf("PASS:4096 real RNG/selector seeds; baseline consecutive defense turns=%u; repeated pure defense at+2 now loses equal-score attacks; initial setup remains selectable=%u\n", repeats, initialSetup);
+
+    for (sCapture = FALSE; sCapture <= TRUE; sCapture++)
+    {
+        sGym = !sCapture; gBattleTypeFlags = sGym ? BATTLE_TYPE_TRAINER : BATTLE_TYPE_WILD_SCRIPTED;
+        // Standard viability can favor useful initial setup, and finishing
+        // logic gives a feasible KO+4. Neither advantage is overwritten.
+        Turn(6, 6); sThinking.score[3] = 102;
+        assert(BattleAI_ChooseMoveOrAction() == 3);
+        Turn(8, 8); sThinking.score[1] = 104;
+        assert(BattleAI_ChooseMoveOrAction() == 1);
+        Turn(8, 8); sThinking.score[3] = 102;
+        assert(BattleAI_ChooseMoveOrAction() < 2);
+        // Mixed offensive setup and genuinely ineffective attacks keep the
+        // native scores: this is a modest preference, not an attack mandate.
+        Turn(8, 8); gBattleMons[1].moves[3] = MOVE_CALM_MIND; sThinking.score[3] = 103;
+        assert(BattleAI_ChooseMoveOrAction() == 3 && sThinking.score[3] == 103);
+        Turn(8, 8); sThinking.score[0] = sThinking.score[1] = 80;
+        assert(BattleAI_ChooseMoveOrAction() >= 2);
+        Turn(8, 8); sThinking.score[2] = 0; gBattleMons[1].pp[3] = 0;
+        TaichungBattleAI_AdjustScores(sThinking.score, 1);
+        assert(sThinking.score[2] == 0 && sThinking.score[3] == 100);
+    }
+    sCapture = FALSE; sGym = FALSE;
+    for (gBattleTypeFlags = 0; gBattleTypeFlags <= BATTLE_TYPE_TRAINER; gBattleTypeFlags += BATTLE_TYPE_TRAINER)
+    {
+        Turn(8, 8); TaichungBattleAI_AdjustScores(sThinking.score, 1);
+        assert(sThinking.score[2] == 100 && sThinking.score[3] == 100);
+    }
+    sGym = TRUE; Turn(8, 8); sThinking.aiAction = AI_ACTION_FLEE;
+    assert(BattleAI_ChooseMoveOrAction() == AI_CHOICE_FLEE && sThinking.score[2] == 100);
+    Turn(8, 8); sThinking.aiAction = AI_ACTION_WATCH;
+    assert(BattleAI_ChooseMoveOrAction() == AI_CHOICE_WATCH && sThinking.score[2] == 100);
+    puts("PASS:meaningful setup, clear finishing attack, spent setup, mixed boosts, unsuitable attacks, invalid moves, normal wild/untracked trainers and safari action bypass");
+    return 0;
+}
