+                'TaichungCity_Text_GreenwayGuide::', '\t.string "This green corridor links art,\\n"',
+                '\t.string "science, and neighborhood life.\\p"', '\t.string "West: MAPLE GARDEN and THEATER.\\n"',
+                '\t.string "East: OLD STATION and CITY PARK.$"','']
+    for stable_id,suffix,key,door,arrival,en,zh,style in LANDMARKS:
+        title=en.upper()
+        scripts += [f'TaichungCity_Sign_{suffix}::',f'\tmsgbox TaichungCity_Text_{suffix}, MSGBOX_SIGN','\tend','',
+                    f'TaichungCity_Host_{suffix}::',f'\tmsgbox TaichungCity_Text_Host_{suffix}, MSGBOX_NPC','\tend','',
+                    f'TaichungCity_Text_{suffix}::',f'\t.string "{title}\\p"',
+                    '\t.string "Landmark hall: enter to explore.$"','',
+                    f'TaichungCity_Text_Host_{suffix}::',f'\t.string "Welcome to {title}!\\p"' if len(title)<18 else '\t.string "Welcome to this landmark hall!\\p"',
+                    '\t.string "Our city league is preparing\\n"','\t.string "this hall for future challenges.$"','']
+    (ROOT/'data/scripts/taichung_city.inc').write_text('\n'.join(scripts))
+    print(f'Authored {len(DISTRICTS)} native districts and {len(LANDMARKS)} paired landmark rooms.')
+
