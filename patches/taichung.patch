+++ b/tools/taichung_gameplay/validate-encounters.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Check the native Old City encounter table against reachable authored grass."""
+from collections import Counter
+import json
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'tools/taichung'))
+from validate_city import Validator
+
+contract = json.loads((ROOT / 'docs/taichung-city-contract.json').read_text())
+city = Validator(ROOT, contract)
+city.run()
+assert not city.errors, city.errors
+old_city = city.maps['MAP_TAICHUNG_OLD_CITY']
+regions = [h for h in contract['habitatRegions'] if h['map'] == old_city.id]
+# Parent approved recording this existing authored lawn without a geometry or
+# mapping-contract rewrite. build_city.py places it beside the park lake.
+if not any(h['id'] == 'park-lawns-east' for h in regions):
+    regions.append({'id':'park-lawns-east', 'map':old_city.id,
+                    'rect':[35,14,36,22], 'terrain':'tall-grass'})
+reserved = set()
+for habitat in regions:
+    assert habitat['terrain'] == 'tall-grass'
+    x0, y0, x1, y1 = habitat['rect']
+    reserved.update((x,y) for x in range(x0,x1+1) for y in range(y0,y1+1))
+# The native encounter attribute occupies bits 24–26; LAND = 1.
+actual = {(x,y) for x in range(old_city.width) for y in range(old_city.height)
+          if old_city.walkable(x,y) and ((old_city.attribute(old_city.cell(x,y) & 0x3FF) >> 24) & 7) == 1}
+assert actual == reserved, f'Unexpected/missing grass cells: extra={actual-reserved}, missing={reserved-actual}'
+spawn = contract['spawn']
+assert all((old_city.id,x,y) in city.distances for x,y in actual)
+# The table must not make a wild battle mandatory for any landmark approach.
+old_city.obstacles.update(actual)
+quiet_paths = city.flood((spawn['map'],spawn['x'],spawn['y']),city.district_ids)
+for landmark in contract['landmarks']:
+    approach = landmark['approach']
+    assert (landmark['exteriorMap'],approach['x'],approach['y']) in quiet_paths, f"Grass blocks required approach to {landmark['id']}"
+
+wild = json.loads((ROOT / 'src/data/wild_encounters.json').read_text())
+group = next(g for g in wild['wild_encounter_groups'] if g['label']=='gWildMonHeaders')
+entries = [e for e in group['encounters'] if e.get('map') == old_city.id]
+assert len(entries) == 1, 'Old City needs exactly one native table'
+entry = entries[0]
+assert set(entry) == {'map','base_label','land_mons'}, 'No unapproved water/fishing/rock encounter table'
+land = entry['land_mons']
+weights = next(f['encounter_rates'] for f in group['fields'] if f['type']=='land_mons')
+assert len(land['mons']) == len(weights) == 12 and sum(weights) == 100
+assert 0 < land['encounter_rate'] <= 100
+species_header = (ROOT / 'include/constants/species.h').read_text()
+shares = Counter()
+for weight, mon in zip(weights,land['mons']):
+    assert 1 <= mon['min_level'] <= mon['max_level'] <= 100
+    assert re.search(r'^#define\s+'+re.escape(mon['species'])+r'\s+',species_header,re.M), mon['species']
+    shares[mon['species']] += weight
+print('PASS: Old City table uses',len(actual),'reachable authored grass cells in',', '.join(h['id'] for h in regions))
+print('PASS: every landmark approach remains reachable without entering this encounter grass.')
+print('Provisional native rate:',land['encounter_rate'],'weighted species shares:',dict(shares))
diff --git a/tools/taichung_gameplay/validate-team-presets.py b/tools/taichung_gameplay/validate-team-presets.py
new file mode 100644
index 0000000..7048531
--- /dev/null
+++ b/tools/taichung_gameplay/validate-team-presets.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Check the hand-authored demo presets against this checkout's Gen III data."""
+
+import json
+from pathlib import Path
+import re
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def read(name):
+    return (ROOT / name).read_text()
+
+
+def entries(text):
+    """Slice designated species entries without depending on table whitespace."""
+    matches = list(re.finditer(r"\[(SPECIES_\w+)\]\s*=", text))
+    return {
+        match[1]: text[match.end():matches[i + 1].start() if i + 1 < len(matches) else len(text)]
+        for i, match in enumerate(matches)
+    }
+
+
+def main():
+    species = {
+        name: int(value)
+        for name, value in re.findall(r"^#define (SPECIES_\w+) (\d+)$", read("include/constants/species.h"), re.M)
+        if 1 <= int(value) <= 150
+    }
+    assert len(species) == 150, "Native Kanto species layout changed"
+    pointers = dict(re.findall(r"\[(SPECIES_\w+)\] = (s\w+LevelUpLearnset)", read("src/data/pokemon/level_up_learnset_pointers.h")))
+    learnsets = {
+        name: [(int(level), move) for level, move in re.findall(r"LEVEL_UP_MOVE\((\d+), (MOVE_\w+)\)", body)]
+        for name, body in re.findall(r"static const u16 (s\w+LevelUpLearnset)\[\] = \{(.*?)\};", read("src/data/pokemon/level_up_learnsets.h"), re.S)
+    }
+    parents = {}
+    for parent, body in entries(read("src/data/pokemon/evolution.h")).items():
+        for child in re.findall(r"\{EVO_\w+,\s*\w+,\s*(SPECIES_\w+)\}", body):
+            parents.setdefault(child, set()).add(parent)
+
+    def inherited_level_moves(name, seen=None):
+        seen = set() if seen is None else seen
+        if name in seen:
+            return set()
+        seen.add(name)
+        result = {move for level, move in learnsets[pointers[name]] if level <= 50}
+        for parent in parents.get(name, set()):
+            result |= inherited_level_moves(parent, seen)
+        return result
+
+    tm = {
+        name: {"MOVE_" + move for move in re.findall(r"TMHM\((?:TM|HM)\d+_(\w+)\)", body)}
+        for name, body in entries(read("src/data/pokemon/tmhm_learnsets.h")).items()
+    }
+    tutors = {
+        name: set(re.findall(r"TUTOR\((MOVE_\w+)\)", body))
+        for name, body in entries(read("src/data/pokemon/tutor_learnsets.h")).items()
+    }
+    moves = {
+        name: (int(power), int(pp))
+        for name, power, pp in re.findall(
+            r"\[(MOVE_\w+)\]\s*=\s*\{.*?\.power = (\d+),.*?\.pp = (\d+),.*?\}",
+            read("src/data/battle_moves.h"), re.S,
+        )
+    }
+    presets = {}
+    errors = []
+    text = read("src/data/taichung_team_presets.h")
+    for name, body in re.findall(r"\[(SPECIES_\w+) - 1\] = \{([^}]+)\}", text):
+        if name in presets:
+            errors.append(f"Duplicate species entry: {name}")
+        presets[name] = re.findall(r"MOVE_\w+", body)
+    if set(presets) != set(species):
+        errors.append(f"Roster mismatch; missing {sorted(set(species) - set(presets))}, extra {sorted(set(presets) - set(species))}")
+
+    source_counts = {"level_or_inherited": 0, "tm_hm": 0, "tutor": 0}
+    total_moves = 0
+    short = {}
+    for name, slots in presets.items():
+        if name not in species:
+            continue
+        if len(slots) != 4:
+            errors.append(f"{name}: expected four slots, found {len(slots)}")
+        active = [move for move in slots if move != "MOVE_NONE"]
+        if not active or len(active) != len(set(active)):
+            errors.append(f"{name}: empty set or duplicate moves")
+        if slots[:len(active)] != active:
+            errors.append(f"{name}: nonempty move after MOVE_NONE")
+        if len(active) < 4:
+            short[name] = active
+        level_moves = inherited_level_moves(name)
+        legal = level_moves | tm.get(name, set()) | tutors.get(name, set())
+        for move in active:
+            total_moves += 1
+            if move not in moves or moves[move][1] <= 0:
+                errors.append(f"{name}: unknown or unusable PP: {move}")
+            if move not in legal:
+                errors.append(f"{name}: {move} unavailable from level <=50 / inherited level / TM / FireRed tutor")
+            elif move in level_moves:
+                source_counts["level_or_inherited"] += 1
+            elif move in tm.get(name, set()):
+                source_counts["tm_hm"] += 1
+            else:
+                source_counts["tutor"] += 1
+            if move in {"MOVE_RETURN", "MOVE_FRUSTRATION", "MOVE_HIDDEN_POWER"}:
+                errors.append(f"{name}: {move} depends on friendship or IV-specific tuning")
+        if name != "SPECIES_DITTO" and not any(moves.get(move, (0, 0))[0] > 0 for move in active):
+            errors.append(f"{name}: no damaging move")
+
+    if errors:
+        print("\n".join(errors), file=sys.stderr)
+        return 1
+    print(json.dumps({
+        "status": "pass",
+        "species": len(presets),
+        "nonemptyMoveSlots": total_moves,
+        "level": 50,
+        "moveSources": source_counts,
+        "shortPresets": short,
+        "scope": "Native FireRed data; level-up through 50, inherited pre-evolution level moves, species TM/HM and FireRed tutors. No egg/event/trade source needed.",
+    }, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
