+static void Task_ReturnFromEncounterMenu(u8 task)
+{
+    if (!FieldFadeTransitionBackgroundEffectIsFinished())
+        return;
+    gSpecialVar_0x8007 = sReturnSite;
+    if (sMenuReturnScript == TaichungEncounter_ConfirmReplacement)
+        gSpecialVar_0x8004 = sReplacementSlot;
+    {
+        const u8 *script = sMenuReturnScript;
+        if (script == TaichungEncounter_Begin && !TaichungTeamTakePreparedStart())
+            script = TaichungEncounter_Leave;
+        sMenuReturnScript = NULL; // A return continuation is consumed once.
+        DestroyTask(task);
+        if (script != NULL)
+            ScriptContext_SetupScript(script);
+    }
+}
