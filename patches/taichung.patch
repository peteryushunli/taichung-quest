+    FillWindowPixelBuffer(0, PIXEL_FILL(1));
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 8, 4, sTextColors, -1, TaichungText(sTitleEn, sTitleZh));
+    TaichungGymFormatCount(countText);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 196, 4, sDoneColors, -1, countText);
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 22, sPendingColors, -1, TaichungText(sSubtitleEn, sSubtitleZh));
+    for (gym = 0; gym < TAICHUNG_GYM_COUNT; gym++)
+    {
+        x = gym < 5 ? 8 : 126;
+        y = 40 + (gym % 5) * 20;
+        complete = TaichungGymIsComplete(gym);
+        AddTextPrinterParameterized3(0, FONT_SMALL, x, y, complete ? sDoneColors : sPendingColors, -1, complete ? sDone : sPending);
+        AddTextPrinterParameterized3(0, FONT_SMALL, x + 18, y, sTextColors, -1, TaichungText(sNames[gym][0], sNames[gym][1]));
+    }
+    AddTextPrinterParameterized3(0, FONT_SMALL, 8, 144, sTextColors, -1, TaichungText(sFooterEn, sFooterZh));
