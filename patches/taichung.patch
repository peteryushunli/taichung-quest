index 00000000..3300b21a
--- /dev/null
+++ b/tools/taichung/boulevard_city/covered_flowers.py
@@ -0,0 +1,37 @@
+"""Compose a pinned opaque flower quartet while preserving the stock animation."""
+from pathlib import Path
+import argparse,struct
+from PIL import Image
+ROOT=Path(__file__).resolve().parents[3]
+PRIMARY=ROOT/'data/tilesets/primary/taichung_approved_old_city_north'
+PRIVATE=ROOT/'data/tilesets/primary/taichung_boulevard/tiles.png'
+DEST=ROOT/'data/taichung/covered-flower-animation/frames.bin'
+def derive():
+ image=Image.open(PRIMARY/'tiles.png');assert image.mode=='P' and image.size==(128,320)
+ table=struct.unpack('<5120H',(PRIMARY/'metatiles.bin').read_bytes());assert not any(500<=w&1023<=503 for w in table)
+ flower=table[4*8:5*8];assert [w&1023 for w in flower]==[588,589,604,605,508,509,510,511] and all(w>>10==0 for w in flower)
+ crop=lambda n:image.crop(((n%16)*8,(n//16)*8,(n%16)*8+8,(n//16)*8+8))
+ grass=Image.new('P',(16,16));grass.putpalette(image.getpalette())
+ for i,w in enumerate(flower[:4]):grass.paste(crop(w),((i%2)*8,(i//2)*8))
+ data=bytearray()
+ for frame in range(5):
+  anim=Image.open(ROOT/f'data/tilesets/primary/general/anim/flower/{frame}.png');assert anim.mode=='P' and anim.size==(16,16)
+  merged=Image.new('P',(16,16));merged.putpalette(image.getpalette());merged.putdata([a or g for a,g in zip(anim.getdata(),grass.getdata())]);assert 0 not in merged.getdata()
+  for i in range(4):
+   pixels=list(merged.crop(((i%2)*8,(i//2)*8,(i%2)*8+8,(i//2)*8+8)).getdata())
+   data.extend(pixels[j]|pixels[j+1]<<4 for j in range(0,64,2))
+ # Match the existing initial flower picture exactly before the first tick.
+ updated=image.copy()
+ for i in range(4):
+  initial=Image.new('P',(8,8));initial.putpalette(image.getpalette())
+  initial.putdata([a or g for a,g in zip(crop(508+i).getdata(),crop(flower[i]).getdata())])
+  updated.paste(initial,(((500+i)%16)*8,((500+i)//16)*8))
+ return image,updated,bytes(data)
+if __name__=='__main__':
+ p=argparse.ArgumentParser();p.add_argument('--write',action='store_true');args=p.parse_args();old,new,data=derive()
+ if args.write:
+  PRIVATE.parent.mkdir(parents=True,exist_ok=True);new.save(PRIVATE);DEST.parent.mkdir(parents=True,exist_ok=True);DEST.write_bytes(data)
+ else:
+  assert Image.open(PRIVATE).tobytes()==new.tobytes(),'Private pinned initial quartet differs';assert DEST.read_bytes()==data,'Covered flower frames differ'
+ assert all(new.getpixel(((n%16)*8+x,(n//16)*8+y)) for n in range(500,504) for y in range(8) for x in range(8))
+ print('PASS: private opaque initial quartet and five palette0 grass+flower frames; shared primary and stock508-511 unchanged')
diff --git a/tools/taichung/boulevard_city/export_named_xitun_hd_anchors.py b/tools/taichung/boulevard_city/export_named_xitun_hd_anchors.py
