index 00000000..929e61af
--- /dev/null
+++ b/tools/taichung/capture_release_guard.py
@@ -0,0 +1,236 @@
+#!/usr/bin/env python3
+"""Exact existing-map capture release above Main21633; no map/version layer.
+
+Prove current product/dependencies before returning only its seven prior source
+inputs. Old field/init/capture/gym registrations and their probes stay immutable.
+"""
+from __future__ import annotations
+import argparse
+import contextlib
+import hashlib
+import importlib.util
+from io import BytesIO
+import json
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import sys
+import zipfile
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+LAYER = "data/taichung/capture-release"
+REGISTRATION = LAYER + "/registration.json"
+BUNDLE = LAYER + "/baseline.zip"
+REGISTRATION_SHA256 = "ad9006df4826df593cb2d2f87399b285c7a311a29efb4f59a8c1f7771bd6c15e"
+SAVE = "src/taichung_save.c"
+MENU = "src/taichung_team_menu.c"
+TEXT = "src/taichung_onboarding_text.c"
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def reader(source=ROOT, overrides=None):
+    overrides = overrides or {}
+    def read(path):
+        if path in overrides:
+            if overrides[path] is None:
+                raise FileNotFoundError(path)
+            return overrides[path]
+        return (Path(source) / path).read_bytes()
+    return read
+
+
+def active(read):
+    try:
+        read(REGISTRATION)
+        return True
+    except FileNotFoundError:
+        return (b"IsUnfinishedCityOpening" in read(SAVE)
+                or b"sEncounterNotOpenEn" in read(MENU)
+                or b"goto TaichungEncounter_MapleGarden" in read("data/scripts/taichung_city.inc"))
+
+
+def load(read):
+    raw = read(REGISTRATION)
+    require(sha(raw) == REGISTRATION_SHA256, "Capture release registration changed")
+    return json.loads(raw)
+
+
+def bundle(read, record):
+    raw = read(BUNDLE)
+    require(sha(raw) == record["baselineBundleSha256"], "Capture release baseline bundle changed")
+    with zipfile.ZipFile(BytesIO(raw)) as archive:
+        require(set(archive.namelist()) == set(record["baselineBundleEntries"]), "Capture baseline inventory changed")
+        result = {name: archive.read(name) for name in archive.namelist()}
+    for name, expected in record["baselineBundleEntries"].items():
+        require(sha(result[name]) == expected, "Capture baseline member changed: " + name)
+    return result
+
+
+def definition(text, name):
+    spec = importlib.util.spec_from_file_location("capture_release_native_function", ROOT / "tools/taichung_gameplay/test-save-facing.py")
+    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
+    return module.definition(text, name)[0]
+
+
+def semantics(read, before, record):
+    require(re.search(rb"#define TAICHUNG_SAVE_VERSION 12\b", read("include/taichung_save.h")), "Release must remain save12")
+    groups = json.loads(read("data/maps/map_groups.json"))
+    require(len(groups["gMapGroup_Taichung"]) == 21, "Release must retain the21 existing native contexts")
+    mini = json.loads(read("data/taichung/minimap-contract.json"))
+    require(mini["geometryFingerprintSha256"] == record["geometryFingerprint"], "Released geometry fingerprint changed")
+    old, now = before[SAVE].decode(), read(SAVE).decode()
+    arrays = re.findall(r"^static const [^;]+?\b(\w+)\[\]\s*=\s*\{.*?^\};", old, re.M | re.S)
+    for name in arrays:
+        pattern = r"^static const [^;]+?\b" + re.escape(name) + r"\[\]\s*=\s*\{.*?^\};"
+        require(re.search(pattern, old, re.M | re.S)[0] == re.search(pattern, now, re.M | re.S)[0], "Historical repair changed: " + name)
+    functions = re.findall(r"^[\w *]+\b(\w+)\([^;{}]*\)\s*\n\{", old, re.M)
+    for name in functions:
+        if name != "TaichungSaveUpgradeOnContinue":
+            require(definition(old, name) == definition(now, name), "Historical save/facing helper changed: " + name)
+    prior = definition(old, "TaichungSaveUpgradeOnContinue"); current = definition(now, "TaichungSaveUpgradeOnContinue")
+    boundary = "    if (version >= TAICHUNG_SAVE_VERSION"
+    require(prior[prior.index(boundary):] == current[current.index(boundary):], "Historical migration/empty-party early return changed")
+    require("playerPartyCount != 0 || IsUnfinishedCityOpening()" in current
+            and "version > 0 && version <= TAICHUNG_SAVE_VERSION" in current,
+            "Startup authentication/version gate changed")
+    helper = definition(now, "IsUnfinishedCityOpening")
+    for symbol in ("MAP_GROUP(MAP_TAICHUNG_OLD_CITY)", "MAP_TAICHUNG_GUEST_HOUSE_1F", "MAP_TAICHUNG_GUEST_HOUSE_2F", "MAP_TAICHUNG_STATION_WELCOME"):
+        require(symbol in helper, "A startup context qualification changed")
+
+    # The Team topic alone changes. Old nearby directions/phase tables stay
+    # literal, rather than inheriting the rejected horizontal-map directions.
+    literals = lambda text: dict(re.findall(r"^(?:static )?const u8 (\w+)\[\] = (_\(.*\);)$", text, re.M))
+    old_text = literals(before[TEXT].decode()); new_text = literals(read(TEXT).decode())
+    require(old_text.keys() == new_text.keys(), "Tutorial topic set changed")
+    require(all(new_text[k] == value for k, value in old_text.items() if k not in ("sTeamEn", "sTeamZh")), "Unrelated tutorial/directions changed")
+    require("Catch rare ones at landmarks." in new_text["sTeamEn"] and "地標捕捉後，可解鎖更多。" in new_text["sTeamZh"], "Reviewed Team copy changed")
+
+    old_menu, new_menu = before[MENU].decode(), read(MENU).decode()
+    names = re.findall(r"^[\w *]+\b(\w+)\([^;{}]*\)\s*\n\{", old_menu, re.M)
+    for name in names:
+        if name != "DrawLocked":
+            require(definition(old_menu, name) == definition(new_menu, name), "Unrelated Team function changed: " + name)
+    locked = definition(new_menu, "DrawLocked")
+    for symbol in ("TAICHUNG_ENCOUNTER_LUCE_CHAPEL", "TAICHUNG_ENCOUNTER_RAINBOW_VILLAGE", "TAICHUNG_ENCOUNTER_CITY_HALL", "TAICHUNG_ENCOUNTER_JINGMING_STREET"):
+        require(locked.count(symbol) == 1, "Four-site presentation qualification changed")
+    require("This encounter is not open yet." in new_menu and "目前尚未開放。" in new_menu, "Unavailable copy changed")
+    spec = json.loads(read("data/taichung/encounters/existing-bindings.json"))
+    require([r["stableSiteId"] for r in spec["signBindings"]] == [0, 2, 3, 4, 5, 6, 7, 8, 9], "Existing-site binding IDs changed")
+    require(spec["reservedUnboundSites"] == [10, 11, 12, 13], "Reserved sites became bound")
+    require(spec["existingHostBinding"]["stableSiteId"] == 1, "Wenchang binding changed")
+    return dict(saveVersion=12,contexts=21,geometry=record["geometryFingerprint"],unchangedRepairArrays=len(arrays),
+                unchangedSaveFacingHelpers=len(functions)-1,unchangedOtherTeamFunctions=len(names)-1,
+                existingCaptureSites=10,reservedNotOpenSites=[10,11,12,13],codebook="byte-identical808",
+                oldNearbyDirectionsUnchanged=True,historicalMigrationSuffixUnchanged=True)
+
+
+def verified(read):
+    record = load(read)
+    for path, row in record["edited"].items():
+        require(sha(read(path)) == row["after"], "Capture release edited input changed: " + path)
+    for path, expected in {**record["added"], **record["dependencies"]}.items():
+        require(sha(read(path)) == expected, "Capture release added/dependency changed: " + path)
+    stored = bundle(read, record)
+    before = {path: stored["before/" + path] for path in record["edited"]}
+    for path, raw in before.items():
+        require(sha(raw) == record["edited"][path]["before"], "Prior accepted input changed: " + path)
+    for path, row in record["guardAdapters"].items():
+        require(sha(read(path)) == row["after"], "Capture executable-mirror adapter changed")
+        raw = stored["guard-before/" + path]
+        require(sha(raw) == row["before"], "Historical executable-mirror bytes changed")
+        before[path] = raw
+    detail = semantics(read, before, record)
+    return dict(passed=True,active=True,baseline=record["baseline"],feature=record["feature"],
+                edited=len(record["edited"]),added=len(record["added"]),dependencies=len(record["dependencies"]),
+                checks=detail,runtimeAcceptanceClaimed=False), before
+
+
+def peel(read):
+    return verified(read)[1] if active(read) else {}
+
+
+def hidden(read):
+    if not active(read):
+        return set()
+    verified(read)
+    return set(load(read)["added"]) | {REGISTRATION, BUNDLE}
+
+
+def check(source=ROOT, overrides=None):
+    try:
+        read = reader(source, overrides)
+        return verified(read)[0] if active(read) else dict(passed=True,active=False)
+    except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
+        return dict(passed=False,errors=[str(error)])
+
+
+@contextlib.contextmanager
+def mirror(source, replacements, absent=()):
+    source = Path(source).resolve(); absent = set(absent)
+    with __import__("tempfile").TemporaryDirectory(prefix="taichung-capture-qualified-") as folder:
+        target = Path(folder)
+        def copy(rel=""):
+            for path in (source / rel).iterdir():
+                child = str(PurePosixPath(rel) / path.name); dest = target / child
+                if child in absent or child in (".git", "build"):
+                    continue
+                if child in replacements:
+                    dest.write_bytes(replacements[child])
+                elif child == "tools":
+                    shutil.copytree(path, dest, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
+                    for name, raw in replacements.items():
+                        if name.startswith("tools/"):
+                            (target / name).write_bytes(raw)
+                    for name in absent:
+                        if name.startswith("tools/") and (target / name).is_file():
+                            (target / name).unlink()
+                elif any(p.startswith(child + "/") for p in [*replacements, *absent]):
+                    dest.mkdir(); copy(child)
+                else:
+                    dest.symlink_to(path, target_is_directory=path.is_dir())
+        copy(); yield target
+
+
+def self_test(source=ROOT):
+    read = reader(source); good = check(source); require(good["passed"], str(good))
+    paths = [REGISTRATION,BUNDLE,SAVE,MENU,TEXT,"tests/taichung_encounter_save_test.c",
+             "tests/taichung_locked_menu_test.c","data/scripts/taichung_city.inc","data/taichung/encounters/sites.json",
+             "tools/taichung_gameplay/audit-encounter-slice.py","data/taichung/encounters/existing-bindings.json",
+             "include/taichung_save.h","include/constants/taichung_encounters.h","src/taichung_team.c",
+             "data/maps/map_groups.json","data/layouts/TaichungOldCity/map.bin","data/maps/TaichungOldCity/map.json",
+             "charmap.txt","src/data/taichung_glyphs.h"]
+    probes = {p: not check(source,{p:read(p)+b"\nforeign-mutation"})["passed"] for p in paths}
+    probes["missing-registration"] = not check(source,{REGISTRATION:None})["passed"]
+    probes["missing-binding-spec"] = not check(source,{"data/taichung/encounters/existing-bindings.json":None})["passed"]
+    record=load(read);stored=bundle(read,record)
+    for p in (SAVE,MENU,TEXT):
+        probes["partial-revert:"+p]=not check(source,{p:stored["before/"+p]})["passed"]
+    raw=read(SAVE);changed=raw.replace(b"|| IsUnfinishedCityOpening()",b"|| TRUE",1)
+    require(changed!=raw,"No-op startup authentication probe")
+    probes["all-zero-party-authentication"]=not check(source,{SAVE:changed})["passed"]
+    raw=read(MENU);changed=raw.replace(b"site == TAICHUNG_ENCOUNTER_LUCE_CHAPEL",b"site >= TAICHUNG_ENCOUNTER_MAPLE_GARDEN",1)
+    require(changed!=raw,"No-op bound-site presentation probe")
+    probes["mark-bound-sites-unavailable"]=not check(source,{MENU:changed})["passed"]
+    raw=read(SAVE);cell=re.search(rb"(static const[^;]+?\[\]\s*=\s*\{\s*\{)(\d+)",raw)
+    require(cell is not None,"No actual historical repair probe")
+    changed=raw[:cell.start(2)]+str(int(cell[2])+1).encode()+raw[cell.end(2):]
+    probes["changed-historical-repair"]=not check(source,{SAVE:changed})["passed"]
+    require(all(probes.values()),"A real capture release corruption was accepted")
+    return dict(passed=True,current=good,rejectedCorruptionProbes=probes)
+
+
+if __name__ == "__main__":
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument("--source",type=Path,default=ROOT);parser.add_argument("--self-test",action="store_true")
+    args=parser.parse_args()
+    try:report=self_test(args.source) if args.self_test else check(args.source)
+    except (OSError,ValueError,KeyError,TypeError,IndexError) as error:report=dict(passed=False,errors=[str(error)])
+    print(json.dumps(report,indent=2));sys.exit(0 if report["passed"] else 1)
