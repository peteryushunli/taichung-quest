+#!/usr/bin/env python3
+"""One progressive, game-scale block study with native indexed roof colorways."""
+import argparse
+from collections import deque
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image,ImageDraw
+
+from color_compile import compile_colorways,color_grid,native_tile_images,save_native
+from library import ROOT,WALK,require
+
+
+def pilot_plan():
+    return dict(schemaVersion=1,status='single unregistered source block study; palette-index colors; not installed in ROM',
+        width=32,height=24,profileId='city-v2-r2-c2',archetype='old-mixed-residential',spawn=[29,14],
+        exits=[[0,13],[31,13],[29,0],[29,23]],
+        groundRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,16,26,23]],
+        protectedRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,23,31,23],[0,0,0,23],[31,0,31,23]],
+        placements=[
+            dict(id='old-home-a',prefab='building-rowhouse-compact',x=1,y=0,colorway='terracotta',context='residential'),
