@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Check current production actors and real direct staff/info script paths."""
+import importlib.util
+import json
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location('gym_dialogue_routes', Path(__file__).with_name('test-gym-dialogue.py'))
+gym = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gym)
+texts = [(ROOT / p).read_text() for p in ('data/taichung_character_npcs.s', 'data/scripts/taichung_landmark_history.inc',
+         'data/scripts/taichung_optional_story.inc', 'data/scripts/taichung_boulevard_people.inc')]
+program = gym.parse(texts)
+constants = dict(gym.SYMBOLS)
+constants.update({key:int(number) for key,number in re.findall(r'^#define\s+(TAICHUNG_HISTORY_\w+)\s+(\d+)', (ROOT/'include/constants/taichung_landmark_history.h').read_text(), re.M)})
+workers = {'TaichungNpc_Aming':0,'TaichungHistory_StaffPark':1,'TaichungHistory_StaffMiyahara':2,
+           'TaichungNpc_Qiaoqiao':3,'TaichungNpc_Ayan':4,'TaichungHistory_StaffShenJi':5,
+           'TaichungHistory_StaffFineArts':6,'TaichungNpc_Mei':7,'TaichungHistory_StaffMapleGarden':8,'TaichungNpc_Boxun':9}
+helpers = {'TaichungBoulevard_Helper_MapleGarden':8,'TaichungBoulevard_Helper_BotanicalGarden':12,
+           'TaichungBoulevard_Helper_ConfuciusTemple':13,'TaichungBoulevard_Helper_YizhongStreet':14,
+           'TaichungBoulevard_Helper_PrefecturalHall':15,'TaichungBoulevard_Helper_SecondMarket':16,
+           'TaichungBoulevard_Helper_CulturalHeritagePark':17,'TaichungBoulevard_Helper_FengleSculpturePark':18,
+           'TaichungBoulevard_Helper_WenxinForestPark':19}
+owners = {key:[] for key in workers | helpers}
+for path in (ROOT/'data/maps').glob('Taichung*/map.json'):
+    for actor in json.loads(path.read_text())['object_events']:
+        if actor.get('script') in owners:
+            owners[actor['script']].append(path.parent.name)
+assert all(len(value)==1 for value in owners.values()), owners
+assert all(owners[key][0].endswith('_Gym') for key in workers)
+assert all(owners[key][0].startswith('TaichungBlvd') for key in helpers)
+
+
+def run(entry, replay):
+    label,index,stack=entry,0,[]
+    saved={f'VAR_0x{0x4000+i:04X}':(i*73)&0xFFFF for i in range(256)}
+    variables={**saved,'VAR_RESULT':0,'VAR_0x8006':0xCAFE}
+    events=[]
+    locked=False
+    pending=None
+    def value(x):return variables.get(x,constants.get(x,int(x) if x.isdecimal() else x))
+    for _ in range(100):
+        instruction=program[label][index];index+=1
+        command,_,tail=instruction.partition(' ');args=tail.split(', ')
+        if command=='setvar':
+            assert args[0]=='VAR_0x8004'
+            variables[args[0]]=value(args[1])
+        elif command in ('lock','lockall'):locked=True
+        elif command in ('release','releaseall'):locked=False
+        elif command=='faceplayer':assert locked
+        elif command=='goto_if_questlog':
+            if replay:label,index=tail,0
+        elif command=='goto_if_eq':
+            if value(args[0])==value(args[1]):label,index=args[2],0
+        elif command=='goto':label,index=tail,0
+        elif command=='call':stack.append((label,index));label,index=tail,0
+        elif command=='return':label,index=stack.pop()
+        elif command=='callnative':
+            if tail=='TaichungStory_ScriptHasPackage':
+                assert value('VAR_0x8004')==(workers|helpers)[entry]
+                variables['VAR_0x8006']=value('VAR_0x8004');variables['VAR_RESULT']=1
+            elif tail=='TaichungStory_ScriptBufferStaffAnecdote':
+                assert entry in workers and not replay;pending='staff-first-page'
+            elif tail=='TaichungStory_ScriptBufferSign':
+                assert entry in helpers and not replay;pending='place-introduction'
+            else:raise AssertionError(('unexpected native effect',tail))
+        elif command=='msgbox':
+            assert locked and pending and tail=='gStringVar4'
+            events.append(pending);pending=None
+        elif command=='closemessage':pass
+        elif command=='end':
+            assert not locked and not stack
+            assert all(variables[k]==v for k,v in saved.items())
+            return events
+        else:raise AssertionError(('submenu/battle/unexpected effect',instruction))
+    raise AssertionError('loop')
+
+
+for entry in workers | helpers:
+    assert run(entry,False)==['staff-first-page' if entry in workers else 'place-introduction']
+    assert run(entry,True)==[]
+menus=(ROOT/'src/script_menu.c').read_text()
+for kind in ('Challenge','Visit','Site'):
+    for suffix in ('','Zh'):
+        body=re.search('sMultichoiceList_TaichungStory'+kind+suffix+r'\[\] = \{(.*?)\};',menus,re.S)[1]
+        assert 'gTaichungStoryStaff' not in body
+        assert 'gTaichungStoryBack' in body
+        if kind=='Site':assert body.index('gTaichungStoryEncounter')<body.index('gTaichungStoryAbout')
+print('PASS:10 actual inside staff and9 outdoor helpers, immediate one-page speech/no menu, replay exit, exact place IDs, no saved writes or battle calls; no staff choice in public EN/TW reading menus')
