+def pixels_with_flip(bank, entry):
+    raw = bank.graphic(entry & 1023)
+    return tuple(raw[(7-y if entry & 0x800 else y)*8 + (7-x if entry & 0x400 else x)] for y in range(8) for x in range(8))
