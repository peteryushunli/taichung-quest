+    u8 flags;
+    for (flags = 0; flags <= (F_TRAINER_PARTY_CUSTOM_MOVESET | F_TRAINER_PARTY_HELD_ITEM); flags++)
+    {
+        struct Pokemon mon, original;
+        Reset();
+        mon = OldPartner(SPECIES_PIKACHU, 80);
+        memset(mon.identity.ivs, 31, sizeof(mon.identity.ivs));
+        memset(mon.identity.evs, 0, sizeof(mon.identity.evs));
+        mon.heldItem = ITEM_ORANGE_MAIL;
+        memcpy(mon.moves, authoredMoves, sizeof(authoredMoves));
+        memset(mon.pp, 0, sizeof(mon.pp));
+        original = mon;
+
+        TaichungTeamPrepareTrainerMon(&mon, flags);
+        assert(mon.exp == gExperienceTables[0][50] && mon.level == 50);
+        assert(mon.hp == 150 && mon.hp == mon.maxHp && mon.status == 0);
+        assert(memcmp(&mon.identity, &original.identity, sizeof(mon.identity)) == 0);
+        assert(mon.heldItem == ITEM_ORANGE_MAIL && mon.mail == original.mail && mon.species == original.species);
+        assert(sCreates == 0 && sRecalculations == 1 && sHeals == 0 && sDexWrites == 0);
+        if (flags & F_TRAINER_PARTY_CUSTOM_MOVESET)
+        {
+            assert(memcmp(mon.moves, authoredMoves, sizeof(authoredMoves)) == 0);
+            assert(memcmp(mon.pp, authoredPP, sizeof(authoredPP)) == 0);
+            assert(sPresets == 0 && sPPRestores == 1);
+        }
+        else
+        {
+            assert(memcmp(mon.moves, presetMoves, sizeof(presetMoves)) == 0);
+            assert(memcmp(mon.pp, presetPP, sizeof(presetPP)) == 0);
+            assert(sPresets == 1 && sPPRestores == 0);
+        }
+        AssertProtectedSave();
+    }
+}
+
+static void TestEnsureLevelPreservesExplorationDamage(void)
+{
+    struct Pokemon original[PARTY_SIZE];
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_PIKACHU, 50);
+    memcpy(gPlayerParty[0].moves, TaichungTeamGetPresetMoves(SPECIES_PIKACHU), sizeof(gPlayerParty[0].moves));
+    gPlayerParty[1] = OldPartner(SPECIES_BULBASAUR, 5);
+    memcpy(original, gPlayerParty, sizeof(original));
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(sRecalculations == 0 && sPresets == 0 && sHeals == 0);
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungTeamNoGrindActive());
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    gSaveBlock1Ptr = &sSave;
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(&gPlayerParty[0], &original[0], sizeof(original[0])) == 0);
+    assert(gPlayerParty[1].level == 50 && gPlayerParty[1].hp == original[1].hp);
+    assert(gPlayerParty[1].status == original[1].status);
+    assert(gPlayerParty[1].pp[0] == 35); // Old invalid PP is clamped to the new move's maximum.
+    assert(gPlayerParty[1].exp == gExperienceTables[0][50]);
+    assert(memcmp(&gPlayerParty[1].identity, &original[1].identity, sizeof(original[1].identity)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1 && sHeals == 0);
+    memcpy(original, gPlayerParty, sizeof(original));
+    TaichungTeamEnsurePartyLevel();
+    assert(memcmp(gPlayerParty, original, sizeof(original)) == 0);
+    assert(sRecalculations == 1 && sPresets == 1 && sHeals == 0);
+    AssertProtectedSave();
+}
+
+static void TestPresetRefreshWithoutHealing(void)
+{
+    struct Pokemon before, refreshed;
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_BULBASAUR, 50);
+    before = gPlayerParty[0];
+    gMain.inBattle = TRUE;
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    gMain.inBattle = FALSE;
+    sSave.location.mapGroup = MAP_GROUP(MAP_ROUTE1);
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    sSave.location.mapGroup = MAP_GROUP(MAP_TAICHUNG_OLD_CITY);
+    TaichungTeamSyncPresetMoves();
+    assert(sPresets == 1 && sHeals == 0 && sRecalculations == 0);
+    refreshed = gPlayerParty[0];
+    assert(refreshed.hp == before.hp && refreshed.status == before.status);
+    assert(refreshed.pp[0] == 35 && refreshed.pp[1] == 15 && refreshed.pp[2] == 10 && refreshed.pp[3] == 0);
+    assert(refreshed.exp == before.exp && refreshed.heldItem == before.heldItem && refreshed.mail == before.mail);
+    assert(memcmp(&refreshed.identity, &before.identity, sizeof(before.identity)) == 0);
+    gPlayerParty[0].pp[0] = 1;
+    TaichungTeamSyncPresetMoves();
+    TaichungTeamEnsurePartyLevel();
+    assert(gPlayerParty[0].pp[0] == 1 && sPresets == 1);
+    gPlayerParty[0] = OldPartner(SPECIES_BULBASAUR, 50);
+    gPlayerParty[0].isEgg = TRUE;
+    before = gPlayerParty[0];
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    gPlayerParty[0] = OldPartner(SPECIES_MEW, 50);
+    before = gPlayerParty[0];
+    TaichungTeamSyncPresetMoves();
+    assert(memcmp(&before, &gPlayerParty[0], sizeof(before)) == 0);
+    assert(sPresets == 1);
+    AssertProtectedSave();
+}
+
+static void TestCaughtLevelAndRandomTeam(void)
+{
+    u8 target, i, j;
+    for (target = 3; target <= 5; target++)
+    {
+        struct Pokemon partner;
+        Reset();
+        partner = OldPartner(SPECIES_PIKACHU, 50);
+        gPlayerParty[0] = partner;
+        assert(TaichungTeamFillRandom(target));
+        assert(gPlayerPartyCount == target);
+        assert(memcmp(&gPlayerParty[0], &partner, sizeof(partner)) == 0);
+        for (i = 0; i < target; i++)
+        {
+            assert(gPlayerParty[i].species != SPECIES_ALAKAZAM);
+            for (j = 0; j < i; j++)
+                assert(gPlayerParty[i].species != gPlayerParty[j].species);
+        }
+    }
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_ALAKAZAM, 50);
+    assert(!TaichungTeamSetSlot(1, SPECIES_ALAKAZAM));
+    sUnlocks = 1 << 3;
+    assert(TaichungTeamLevelForSpecies(SPECIES_ALAKAZAM) == 65);
+    TaichungTeamEnsurePartyLevel();
+    assert(gPlayerParty[0].level == 65);
+    assert(!TaichungTeamSetSlot(1, SPECIES_ALAKAZAM));
+    assert(TaichungTeamSetSlot(0, SPECIES_ALAKAZAM));
+    assert(gPlayerParty[0].level == 65);
+    assert(TaichungTeamSetSlot(1, SPECIES_VENUSAUR));
+    TaichungTeamPrepareParty();
+    assert(gPlayerParty[0].level == 65 && gPlayerParty[1].level == 50);
+    sUnlocks = 0;
+}
+
+#ifdef TAICHUNG_TEST_NATIVE_LEAD
+#include "constants/battle.h"
+#define GET_BATTLER_SIDE2(battler) ((battler) & 1)
+u32 gBattleTypeFlags;
+u8 gBattlersCount;
+u16 gBattlerPartyIndexes[4];
+struct Pokemon gEnemyParty[PARTY_SIZE];
+#include "native-party-lead.inc"
+#endif
+
+static void TestUniqueSelectionsAndLegacyDuplicates(void)
+{
+    struct Pokemon before[PARTY_SIZE];
+    unsigned created, dex;
+    Reset();
+    gPlayerParty[0] = OldPartner(SPECIES_PIKACHU, 50);
+    gPlayerParty[1] = OldPartner(SPECIES_DRAGONITE, 50);
+    CalculatePlayerPartyCount();
+    memcpy(before, gPlayerParty, sizeof(before));
+    assert(!TaichungTeamSetSlot(2, SPECIES_DRAGONITE));
+    assert(!TaichungTeamSetSlot(0, SPECIES_DRAGONITE));
+    assert(!memcmp(before, gPlayerParty, sizeof(before)) && sCreates==0 && sDexWrites==0);
+    assert(TaichungTeamSetSlot(1, SPECIES_DRAGONITE));
+    assert(!memcmp(before, gPlayerParty, sizeof(before)) && sCreates==0 && sDexWrites==0);
+    assert(TaichungTeamSetSlot(2, SPECIES_VENUSAUR));
+    assert(!memcmp(before, gPlayerParty, 2*sizeof(struct Pokemon)));
+    // Legacy duplicate records survive Continue/prep; only an explicitly
+    // selected replacement changes, with no invisible reorder or extra clone.
+    gPlayerParty[2] = gPlayerParty[1];
+    gPlayerParty[0].hp=0;
+    memcpy(before,gPlayerParty,sizeof(before));
+    created=sCreates;dex=sDexWrites;
+    assert(TaichungTeamSetSlot(2,SPECIES_DRAGONITE));
+    assert(!memcmp(before,gPlayerParty,sizeof(before)) && sCreates==created && sDexWrites==dex);
+    assert(!TaichungTeamSetSlot(0,SPECIES_DRAGONITE));
+    assert(!memcmp(before,gPlayerParty,sizeof(before)));
+    assert(TaichungTeamSetSlot(2,SPECIES_CHARIZARD));
+    assert(!memcmp(before,gPlayerParty,2*sizeof(struct Pokemon)) && sCreates==created+1);
+    assert(gPlayerParty[0].hp==0 && gPlayerParty[1].species==SPECIES_DRAGONITE && gPlayerParty[2].species==SPECIES_CHARIZARD);
+#ifdef TAICHUNG_TEST_NATIVE_LEAD
+    memcpy(before,gPlayerParty,sizeof(before));
+    memset(gEnemyParty,0,sizeof(gEnemyParty));gEnemyParty[0]=OldPartner(SPECIES_RATICATE,50);
+    gBattleTypeFlags=0;gBattlersCount=2;gBattlerPartyIndexes[0]=5;gBattlerPartyIndexes[1]=5;
+    SetBattlePartyIds();
+    assert(gBattlerPartyIndexes[0]==1 && gBattlerPartyIndexes[1]==0);
+    assert(!memcmp(before,gPlayerParty,sizeof(before)));
+    puts("PASS: native first-healthy selector leads slot1Dragonite when slot0Pikachu is fainted; finalized roster bytes and order stay intact.");
+#endif
+    AssertProtectedSave();
+}
+
+int main(void)
+{
+    TestPresetRefreshWithoutHealing();
+    TestInvalidChoices();
+    TestSixSlotsAndReplacement();
+    TestPrepareExistingMon();
+    TestPrepareParty();
+    TestPrepareSixPartners();
+    TestPrepareTrainerMoves();
+    TestEnsureLevelPreservesExplorationDamage();
+    TestCaughtLevelAndRandomTeam();
+    TestUniqueSelectionsAndLegacyDuplicates();
+    puts("PASS: landmark levels on fresh selections, old parties and battle preparation; unique random teams of 3/4/5 preserve existing partners.");
+    puts("PASS: native team slot/capacity/battle guards, evolved choices, six-partner preparation, held mail, EXP-derived level 50, identity retention, high-level HP recovery, authored trainer moves/full PP versus default presets, eggs/roster bounds, city-only upgrade, no exploration refill and protected save fields.");
+    return 0;
+}
