+#!/usr/bin/env python3
+"""Read-only proof for the Xitun rework (city-rework phase 2b, with the
+2026-11-09 fill pass).
+
+Xitun grows from 40x64 to the master plan's 45x69 at world (-5,-5): today's
+cells move by (+5,+5), and the five new columns and rows hold the six-lane
+highway and the start of its retaining wall. The registered files must be
+install_xitun.py's exact output from BASE (3634df4) and fill.json, the plan's
+cells and the buildings on its lots. The proof below is independent of the
+draft tool where it can be:
+  - geometry: the highway band is solid kit highway, and the plan's wall is
+    the kit's solid wall pieces (the west wall's top up to the highway at
+    x 1, its planted bank at x 2, the north face on rows 1 and 2); S1 and S2
+    stop at bollards on x 3; Fengjia, the Maple Garden
+    pond and the Theater keep today's art on the plan's landmark cells; every
+    other cell holds what its plan class allows (kit street pieces, one fixed
+    piece for paving, path, grass, tall grass, hedge and tree, solid stall,
+    kiosk or Shen Ji home art on building lots); doors keep their words and
+    signs stand on signposts; every open cell is reachable from Fengjia's
+    arrival; the tall grass is exactly the contract's habitats; the Maple
+    Garden's registered collision (save v9) is carried, its 44 cells solid,
+    with its door, approach and arrival open and the park path from X26's
+    sidewalk reaching the approach;
+  - seams: the 7 columns Greenway and 7 rows Nantun North draw with their own
+    banks hold primary and kit pieces that render identically there, and the
+    open edge cells are the plan's;
+  - events, contract and encounters: every event and contract point moved by
+    the same shift (the Maple Garden sign to the park path's mouth), the
+    connections at the master plan's offsets, and a land table at rate 12,
+    levels 2-5.
+Neighbours still at today's geometry are reported as pending, not failed:
+Greenway and Nantun North move to the plan in their own increments.
+
+The frozen district guards compare whole files with older baselines, so they
+check the state underneath this increment: underneath() hands them BASE's
+Xitun files and Xitun's BASE entries in the shared files, and only when the
+tree holds exactly the registered rework.
+
+  check_xitun_rework.py               print the report
+  check_xitun_rework.py --self-test   also prove each corruption probe is caught
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+BASE = "3634df42a776a602f955046213bf8d569002f8e1"
+RECORD = "data/taichung/xitun-rework/install.json"
+KIT = "data/taichung/city-kit/kit.json"
+FILL = "data/taichung/xitun-rework/fill.json"
+COLLISION_DELTA = "data/taichung/landmark-collision/delta.json"
+# World cell of X26's west sidewalk at the park path's mouth.
+MAPLE_PATH_MOUTH = (25, 34)
+SIDEWALK, SOLID_BITS = 0x175, 0x0C00
+DOOR_BEHAVIOUR, TALL_GRASS, LAND = 0x69, 0x02, 1
+# The plan's landmark cells, in world (today's) coordinates: Fengjia, the Maple
+# Garden pond and the Theater, each today's art.
+PROTECTED = {(x, y) for x0, y0, x1, y1 in ((18, 8, 29, 14), (10, 27, 19, 33), (3, 37, 20, 45))
+             for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)}
+# The words each plan class allows outside the streets, landmarks and lots.
+FILL_WORDS = {".": {0x316E}, "p": {0x3175}, "g": {0x3001}, "G": {0x300D}, "h": {0x0405}}
+TREE = {(0, 0): 0x040E, (1, 0): 0x040F, (0, 1): 0x0416, (1, 1): 0x0417}
+SIGNPOST = 0x3403
