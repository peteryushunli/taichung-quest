+#!/usr/bin/env python3
+"""Deterministic whole-park format conversion; no semantic collision or map install."""
+import argparse
+import colorsys
+import hashlib
+import json
+import math
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ART = PROJECT / 'artifacts/worktrees/c291d4842985/landmark-art'
+SOURCE = ART / 'maple-garden-study-v1.png'
+REGIONS = {
+    'pavilionGlazedEntranceBand': [272, 631, 600, 744],
+    'possibleCentralGlassDoorPanels': [374, 640, 496, 732],
+    'southFrontPathAndStairs': [654, 892, 824, 1001],
+}
+
+
+def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, h=False, v=False):
+    return tuple(pixels[(7-y if v else y)*8 + (7-x if h else x)] for y in range(8) for x in range(8))
+
+
+def family(rgb):
+    h,s,v=colorsys.rgb_to_hsv(*(c/255 for c in rgb))
+    if v>.64 and s<.28:return 'cream-path-or-concrete'
+    if .44<=h<=.65 and s>.16:return 'water-or-building-glazing'
+    if .15<=h<.44 and s>.2:return 'greens-lawn-or-trees'
+    if (h<.08 or h>.86) and s>.25:return 'red-bridge-or-planting'
+    if v<.34:return 'dark-building-frame-wood-or-shadows'
+    return 'neutral-building-wood-or-planting'
+
+
+def encode(source, output, target=(192,128), threshold=224, step=2, bank=8):
+    output.mkdir(parents=True,exist_ok=True)
+    original=sha(source);rgba=Image.open(source).convert('RGBA')
+    mask=rgba.getchannel('A').point(lambda a:255 if a>=threshold else 0);bbox=mask.getbbox()
+    if not bbox:raise ValueError('No whole-park pixels above alpha threshold')
+    crop=rgba.crop(bbox);crop.putalpha(mask.crop(bbox));working=(target[0]//step,target[1]//step)
+    scale=min(working[0]/crop.width,working[1]/crop.height)
+    size=(max(1,round(crop.width*scale)),max(1,round(crop.height*scale)))
+    offset=((working[0]-size[0])//2,working[1]-size[1]);fitted=crop.resize(size,Image.Resampling.NEAREST)
+    canvas=Image.new('RGBA',working);canvas.paste(fitted,offset);pixels=list(canvas.getdata())
+    opaque=[p[:3] for p in pixels if p[3]];strip=Image.new('RGB',(len(opaque),1));strip.putdata(opaque)
+    q=strip.quantize(colors=15,method=Image.Quantize.MEDIANCUT,dither=Image.Dither.NONE);raw=q.getpalette();colors=[]
+    for i in sorted(set(q.getdata())):
+        c=tuple(min(248,((raw[i*3+k]+4)//8)*8) for k in range(3))
+        if c not in colors:colors.append(c)
+    palette=[(0,0,0)]+colors+[(0,0,0)]*(15-len(colors));indices=[];errors=[]
+    for r,g,b,a in pixels:
+        if not a:indices.append(0);continue
+        i=1+min(range(len(colors)),key=lambda n:sum((c-colors[n][k])**2 for k,c in enumerate((r,g,b))))
+        indices.append(i);errors.append(sum((c-palette[i][k])**2 for k,c in enumerate((r,g,b))))
+    indexed=Image.new('P',working);indexed.putpalette([v for c in palette for v in c]+[0]*(768-48));indexed.putdata(indices);indexed.info['transparency']=0
+    indexed=indexed.resize(target,Image.Resampling.NEAREST);indexed.info['transparency']=0;indices=list(indexed.getdata())
+    reference=canvas.resize(target,Image.Resampling.NEAREST);reference.save(output/'reference-nearest-rgba.png')
+    native=indexed.convert('RGBA');indexed.save(output/'candidate-indexed.png');native.save(output/'candidate-native.png')
+    tw,th=target[0]//8,target[1]//8;graphics=[];lookup={};entries=[]
+    for ty in range(th):
+        for tx in range(tw):
+            p=tuple(indices[(ty*8+y)*target[0]+tx*8+x] for y in range(8) for x in range(8))
+            g,flags=min(((p,0),(flip(p,True),0x400),(flip(p,False,True),0x800),(flip(p,True,True),0xc00)),key=lambda a:(a[0],a[1]))
+            if g not in lookup:lookup[g]=len(graphics);graphics.append(g)
+            entries.append(lookup[g]|flags|(bank<<12))
+    sheet=Image.new('P',(128,((len(graphics)+15)//16)*8));sheet.putpalette(indexed.getpalette());sheet.info['transparency']=0
+    for n,g in enumerate(graphics):
+        for y in range(8):
+            for x in range(8):sheet.putpixel((n%16*8+x,n//16*8+y),g[y*8+x])
+    sheet.save(output/'tiles.png')
+    (output/'tiles.4bpp').write_bytes(bytes(g[i]|g[i+1]<<4 for g in graphics for i in range(0,64,2)))
+    (output/'foreground-tilemap-relative.bin').write_bytes(struct.pack(f'<{len(entries)}H',*entries))
+    metas=[[entries[(my*2+y)*tw+mx*2+x] for y in range(2) for x in range(2)] for my in range(target[1]//16) for mx in range(target[0]//16)]
+    (output/'foreground-metatiles-relative.json').write_text(json.dumps(metas,indent=2)+'\n')
+    paltext='JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,c)) for c in palette)+'\r\n'
+    (output/f'{bank:02}.pal').write_bytes(paltext.encode());palraw=struct.pack('<16H',*(r//8|(g//8)<<5|(b//8)<<10 for r,g,b in palette))
+    (output/f'{bank:02}.gbapal').write_bytes(palraw)
+    # Round-trip actual saved bytes, reference flags and native palette.
+    raw=(output/'tiles.4bpp').read_bytes();decoded_g=[tuple(v for b in raw[i:i+32] for v in (b&15,b>>4)) for i in range(0,len(raw),32)]
+    rawmap=(output/'foreground-tilemap-relative.bin').read_bytes();saved=struct.unpack(f'<{len(rawmap)//2}H',rawmap);decoded=[]
+    for y in range(target[1]):
+        for x in range(target[0]):
+            e=saved[(y//8)*tw+x//8];xx=7-x%8 if e&0x400 else x%8;yy=7-y%8 if e&0x800 else y%8
+            decoded.append(decoded_g[e&1023][yy*8+xx])
+    if decoded!=indices:raise ValueError('4bpp/flip/tilemap roundtrip failed')
+    saved_pal=struct.unpack('<16H',(output/f'{bank:02}.gbapal').read_bytes())
+    if [((v&31)*8,((v>>5)&31)*8,((v>>10)&31)*8) for v in saved_pal]!=palette:raise ValueError('BGR555 palette roundtrip failed')
+    if any(len({indexed.getpixel((x+dx,y+dy)) for dy in range(step) for dx in range(step)})!=1 for y in range(0,target[1],step) for x in range(0,target[0],step)):
+        raise ValueError('Uniform2pixel cluster check failed')
+    counts=[indices.count(i) for i in range(16)];hints=[dict(index=i,rgb8=list(c),nativePixels=counts[i],roughColorFamily=family(c)) for i,c in enumerate(palette) if i and counts[i]]
+    (output/'palette-color-groups.json').write_text(json.dumps(dict(schemaVersion=1,paletteBankCandidate=bank,entries=hints,
+        interpretation='Color-family hints only: water/glazing, path/concrete and greenery share colors. This is NOT semantic segmentation or a collision/walkability mask.'),indent=2)+'\n')
+    occupancy=[]
+    for my in range(target[1]//16):
+        occupancy.append(''.join('1' if any(indexed.getpixel((mx*16+x,my*16+y)) for y in range(16) for x in range(16)) else '0' for mx in range(target[0]//16)))
+    (output/'ink-occupancy.json').write_text(json.dumps(dict(schemaVersion=1,logicalSize=list(target),opaqueInkRows=occupancy,
+        notASolidFootprint=True,notAWalkabilityMask=True,reason='Whole-park ink includes opaque water, paved paths, lawn, trees, bridge and building. Root must author terrain/collision separately.'),indent=2)+'\n')
+    measured={}
+    for name,roi in REGIONS.items():
+        points=[]
+        for y in range(target[1]):
+            for x in range(target[0]):
+                wx=x//step-offset[0];wy=y//step-offset[1]
+                if not(0<=wx<size[0] and 0<=wy<size[1]) or not indexed.getpixel((x,y)):continue
+                sx=bbox[0]+int((wx+.5)*crop.width/size[0]);sy=bbox[1]+int((wy+.5)*crop.height/size[1])
+                if roi[0]<=sx<roi[2] and roi[1]<=sy<roi[3]:points.append([x,y])
+        box=[min(p[0] for p in points),min(p[1] for p in points),max(p[0] for p in points)+1,max(p[1] for p in points)+1]
+        measured[name]=dict(sourceRoiExclusive=roi,nativePixelBBoxExclusive=box,nativePixelCount=len(points),
+            touchedLocalMetatiles=sorted({(x//16,y//16) for x,y in points}))
+    region_data=dict(schemaVersion=1,regions=measured,pavilionDoorUnambiguouslyPainted=False,
+        portalCaution='The original has similar glazed panels and a foreground red railing, not a distinct operable native door. The central-panel ROI is a measured portal candidate, not an approved warp or guaranteed accessible doorway.',
+        frontEntry='South-front pale stair/path opening, distinct from the pavilion glazing; geometry must connect them during Root authoring.',
+        fixedWorldDoor=[12,32],fixedApproach=[12,33],fixedArrival=[12,35],activeDoorBaked=False,originOrMapGeometryAssigned=False)
+    (output/'entry-regions.json').write_text(json.dumps(region_data,indent=2)+'\n')
+    review=ART/f'maple-garden-native-{target[0]}x{target[1]}-2px-v1.png';native.resize((target[0]*4,target[1]*4),Image.Resampling.NEAREST).save(review)
+    errors.sort();result=dict(schemaVersion=1,landmarkId='maple-garden',status='unregistered whole-park native FORMAT candidate; terrain semantics unassigned',
+        directionApprovedByDirectUser=True,sourceArtifact=str(source),sourceSha256=original,
+        recipe=dict(alphaThreshold=threshold,sourceCropBox=list(bbox),preserveAspectRatio=True,resampling='nearest',
+            logicalSize=list(target),workingResolution=list(working),nativePixelClusterSize=step,fittedSubjectSize=[v*step for v in size],
+            subjectOffset=[v*step for v in offset],quantization='MEDIANCUT15 opaque source colors; nearest5-bit GBA rounding; nearest RGB; no dithering',
+            candidatePaletteBank=bank,opaqueColors=len(colors),PillowVersion=PIL.__version__),
+        native=dict(unique8x8GraphicsFlipDeduplicated=len(graphics),graphicsCountBeforePrimaryReuse=True,raw4bppLogicalTiles=len(graphics),
+            tilesPngPaddedSlots=((len(graphics)+15)//16)*16,tilemapDimensions8x8=[tw,th],foregroundMetatileCells=len(metas),
+            binaryAlpha=True,uniformTwoPixelClusters=True,saved4bppFlipRoundtripPass=True,savedBgr555RoundtripPass=True,
+            meetsApprox280GraphicAim=len(graphics)<=280,relativeGraphicsIdsNotRegistered=True),
+        quality=dict(metric='RGB nearest-palette error over opaque nearest-resized source samples',rmsePerChannel=math.sqrt(sum(errors)/(3*len(errors))),
+            meanEuclidean=sum(math.sqrt(e) for e in errors)/len(errors),p95Euclidean=math.sqrt(errors[min(len(errors)-1,int(.95*len(errors)))])),
+        entryRegionsFile='entry-regions.json',paletteHintsFile='palette-color-groups.json',inkOccupancyFile='ink-occupancy.json',
+        noCollisionOrWalkabilityInference=True,integration=dict(mapChanged=False,globalPaletteChanged=False,registeredInRom=False,COrSaveChanged=False,
+            activeDoorBaked=False,privatePrimaryEnginePatchApplied=False,rootMustAuthorWalkablePathsPondAndTreeCollision=True,
+            fixedDoor=[12,32],fixedApproach=[12,33],fixedArrival=[12,35],nativeReady=False),reviewArtifact=str(review),
+        candidatePngSha256=sha(output/'candidate-indexed.png'))
+    (output/'encode-manifest.json').write_text(json.dumps(result,indent=2)+'\n')
+    if sha(source)!=original:raise ValueError('Original study changed')
+    print(json.dumps(dict(output=str(output),native=result['native'],quality=result['quality'],entryRegions=measured,review=str(review)),indent=2))
+    return result
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--source',type=Path,default=SOURCE)
+    args=parser.parse_args();primary=encode(args.source,HERE/'candidate',(192,128));alternatives=[]
+    if primary['native']['unique8x8GraphicsFlipDeduplicated']>280:
+        alternatives.append(encode(args.source,HERE/'candidate-160x112',(160,112)))
+    index=dict(schemaVersion=1,landmarkId='maple-garden',directionApproved=True,approvalSource='direct user UseThisDirection relayed by Main',
+        primaryDirectory='candidate',primaryGraphics=primary['native']['unique8x8GraphicsFlipDeduplicated'],
+        alternativeDirectories=['candidate-160x112'] if alternatives else [],alternativeGraphics=[v['native']['unique8x8GraphicsFlipDeduplicated'] for v in alternatives],
+        recommendedDirectory='candidate-160x112' if alternatives else 'candidate',
+        recommendationBasis='Use the smaller mechanical alternative to meet the approximate280-graphic aim; final Root choice pending' if alternatives else 'Primary candidate meets the approximate280-graphic aim',
+        candidates=[dict(directory='candidate' if i==0 else 'candidate-160x112',logicalSize=v['recipe']['logicalSize'],
+            unique8x8GraphicsBeforePrimaryReuse=v['native']['unique8x8GraphicsFlipDeduplicated'],opaqueColors=v['recipe']['opaqueColors'],
+            reviewArtifact=v['reviewArtifact'],manifestFile='encode-manifest.json',entryRegionsFile='entry-regions.json',
+            paletteHintsFile='palette-color-groups.json') for i,v in enumerate([primary]+alternatives)],
+        sourceSha256=primary['sourceSha256'],sourceOriginalUnchanged=True,
+        fixedWorldDoor=[12,32],fixedApproach=[12,33],fixedArrival=[12,35],activeDoorBaked=False,
+        noCollisionOrWalkabilityInference=True,wholeParkContainsOpaqueTerrainAndStructures=True,
+        palette8UnregisteredCandidateOnly=True,privatePrimaryEnginePatchApplied=False,
+        footprintAndPathsApproved=False,nativeReady=False,rootOwnsFinalGeometryAndRegistration=True)
+    (HERE/'native-candidate.json').write_text(json.dumps(index,indent=2)+'\n')
