@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""Audit local-only quest-log wording, storage preservation and native bounds.
+
+Missing CJK glyphs are reported for Main's append-only union, never generated.
+The actual native replay/Save flow is intentionally left to Main's next ROM.
+"""
+import argparse
+from collections import Counter
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[2]
+BASE = '970295050920093f99a4cc2c4a85d247e0f1afdc'
+# Merged onto the live city rework (save v10), the save pair carries the city's v10
+# changes. This feature never touched it; the registered staff guard proves the
+# tree's pair is exactly the city's pair with the reviewed staff cache wrapper.
+CITY_RECORD = 'data/taichung/city-rework/save-v10.json'
+CITY_SAVE_PAIR = ('src/taichung_save.c', 'include/taichung_save.h')
+DEFINITION = re.compile(r'(?:static )?const u8 (\w+)\[\] = _\(("(?:[^"\\]|\\.)*")\);')
+LOCAL_DYNAMIC = {
+    'MultiBattleWithPeopleResultedInOutcome': 0,
+    'PlayerBattledChampionRival': 0,
+    'PlayerSentOutMon1RivalSentOutMon2': 2,
+    'DefeatedWildMon': 5,
+    'CaughtWildMon': 5,
+    'DefeatedWildMonAndCaughtWildMon': 5,
+    'DefeatedWildMonsAndCaughtWildMon': 5,
+    'SoldNumOfItem': 0,
+}
+
+
+def frozen(path):
+    return subprocess.check_output(['git', 'show', BASE + ':' + path], cwd=ROOT)
+
+
+def definitions(text):
+    return {name: json.loads(value) for name, value in DEFINITION.findall(text)}
+
+
+def audit():
+    source = (ROOT / 'src/taichung_quest_log_text.c').read_text()
+    original = definitions((ROOT / 'src/data/text/quest_log.h').read_text())
+    replacements = definitions(source)
+    pairs = {name: (replacements[en], replacements[zh]) for name, en, zh in
+             re.findall(r'\{(gText_QuestLog_\w+), (s\w+En), (s\w+Zh)\}', source)}
+    standard = {name for name, text in original.items() if '{PLAYER}' in text}
+    dynamic = {'gText_QuestLog_' + name: index for name, index in LOCAL_DYNAMIC.items()}
+    assert len(standard) == 13 and len(dynamic) == 8 and set(pairs) == standard | dynamic.keys()
+
+    # Only original-source pointer selection and the five local pointer arguments
+    # may differ. Reversing them must restore both complete native source files.
+    for path in ('src/quest_log.c', 'src/quest_log_events.c'):
+        actual = (ROOT / path).read_text()
+        normalized = actual.replace('#include "taichung_quest_log_text.h"\n', '')
+        normalized = normalized.replace('#include "taichung_player_text.h"\n', '')
+        normalized = re.sub(r'TaichungQuestLogPlayerText\(([^()]*)\)', r'\1', normalized)
+        normalized = normalized.replace('TaichungPlayerTextGet(TAICHUNG_PLAYER_YOU)', 'gSaveBlock2Ptr->playerName')
+        assert normalized.encode() == frozen(path), 'Storage/record/replay or unrelated render code changed: ' + path
+    events = (ROOT / 'src/quest_log_events.c').read_text()
+    assert 'gSaveBlock2Ptr->playerName' not in events
+    assert events.count('TaichungPlayerTextGet(TAICHUNG_PLAYER_YOU)') == 5
+    direct = re.findall(r'TaichungQuestLogPlayerText\((gText_QuestLog_\w+)\)',
+                        events + (ROOT / 'src/quest_log.c').read_text())
+    arrays = events.count('TaichungQuestLogPlayerText(sDepartedLocationTexts[sLocationToDepartedTextId[locationId]])')
+    departure_body = re.search(r'sDepartedLocationTexts\[\].*?=\s*\{(.*?)\};', events, re.S)[1]
+    departure = set(re.findall(r'gText_QuestLog_\w+', departure_body))
+    assert len(direct) == 16 and arrays == 2 and set(pairs) <= set(direct) | departure
+
+    protected = ('src/quest_log_battle.c', 'src/quest_log_objects.c', 'src/quest_log_player.c',
+                 'src/data/text/quest_log.h', 'data/text/save.inc', 'src/start_menu.c',
+                 'src/save.c', 'src/taichung_save.c', 'include/taichung_save.h',
+                 'include/global.h', 'src/pokemon.c', 'src/string_util.c', 'src/text.c',
+                 'src/taichung_language.c', 'tools/taichung_gameplay/extend-chinese-glyphs.py',
+                 'tools/taichung_gameplay/chinese_glyph_font.py', 'assets/fonts/taichung-native-font.json',
+                 'assets/fonts/fusion-pixel-12/fusion-pixel-12px-monospaced-zh_tw.bdf.gz')
+    city = (ROOT / CITY_RECORD).exists()
+    for path in protected:
+        if city and path in CITY_SAVE_PAIR:
+            continue
+        assert (ROOT / path).read_bytes() == frozen(path), 'Protected identity/storage/engine/font source changed: ' + path
+    if city:
+        spec = importlib.util.spec_from_file_location('quest_log_staff_guard', ROOT / 'tools/taichung/check_gym_staff.py')
+        staff = importlib.util.module_from_spec(spec); spec.loader.exec_module(staff)
+        proof = staff.check(ROOT)
+        assert proof['passed'] and proof.get('cityRework'), 'Protected save pair is not the city pair with the staff cache wrapper'
+
+    token = re.compile(r'\{[^}]+\}')
+    for name, texts in pairs.items():
+        expected = Counter(token.findall(original[name]))
+        expected.pop('{PLAYER}', None)
+        if name in dynamic:
+            expected.pop('{DYNAMIC 0x%02X}' % dynamic[name])
+        for text in texts:
+            assert Counter(token.findall(text)) == expected, (name, 'Nonlocal placeholder changed')
+            assert '{PLAYER}' not in text and 'WALKER' not in text
+            assert not re.search(r"\byou(?:'s| is| has)\b", text, re.I)
+            assert text.count('\n') <= 2 and '\r' not in text
+        assert re.search(r'\byou\b', texts[0], re.I) and '你' in texts[1]
+
+    # Same native font table/spacing and maximum inserted source values. The
+    # recap has x=2, width240, height48 and only three line-origin entries.
+    spec = importlib.util.spec_from_file_location('quest_text_glyphs', ROOT / 'tools/taichung_gameplay/extend-chinese-glyphs.py')
+    glyphs = importlib.util.module_from_spec(spec); spec.loader.exec_module(glyphs)
+    existing = glyphs.parse_existing((ROOT / 'charmap.txt').read_bytes(), (ROOT / 'src/data/taichung_glyphs.h').read_bytes())
+    base_charmap, base_header = frozen('charmap.txt'), frozen('src/data/taichung_glyphs.h')
+    released = glyphs.parse_existing(base_charmap, base_header)
+    assert len(released['rows']) == 748 and existing['rows'][:748] == released['rows']
+    assert (ROOT / 'charmap.txt').read_bytes().startswith(base_charmap)
+    assert existing['header'].startswith(released['header'][:released['closeAt']])
+    assert existing['header'][existing['closeAt']:] == released['header'][released['closeAt']:]
+    assert all(existing['mappings'].get(char) == code for char, code in released['mappings'].items())
+    mapping = dict(existing['mappings']); mapping["'"] = mapping['’']
+    body = re.search(r'sFontNormalLatinGlyphWidths\[\]\s*=\s*\{(.*?)\};', (ROOT / 'src/text.c').read_text(), re.S)[1]
+    widths = [int(value) for value in re.findall(r'\b\d+\b', body)]
+    missing = set()
+
+    def width(text):
+        if '{POKEBLOCK}' in text:
+            codes = re.search(r'^POKEBLOCK\s*=\s*([^\n]+)', (ROOT / 'charmap.txt').read_text(), re.M)[1]
+            return width(text.replace('{POKEBLOCK}', '')) + sum(widths[int(code, 16)] + 1 for code in codes.split())
+        total = 0
+        for char in text:
+            if glyphs.is_chinese(char):
+                total += 13
+                if char not in mapping:
+                    missing.add(char)
+            else:
+                assert char in mapping and len(mapping[char]) == 1, char
+                total += widths[mapping[char][0]] + 1
+        return total
+
+    species = [json.loads(value) for value in re.findall(r'_\(("(?:[^"\\]|\\.)*")\)', (ROOT / 'src/data/text/species_names.h').read_text())]
+    item_names = [item['english'] for item in json.loads((ROOT / 'src/data/items.json').read_text())['items']]
+    map_names = [item['name'] for item in json.loads((ROOT / 'src/data/region_map/region_map_sections.json').read_text())['map_sections'] if 'name' in item]
+    map_names += list(definitions((ROOT / 'src/taichung_city_names.c').read_text()).values())
+    location_body = re.search(r'sLocationNameTexts\[\].*?=\s*\{(.*?)\};', events, re.S)[1]
+    locations = [original[name] for name in re.findall(r'gText_QuestLog_\w+', location_body)]
+    bounds = dict(species=max(map(width, species)),
+                  # Include a 14-character custom item name at max Latin width10.
+                  item=max(max(map(width, item_names)), 14 * 11),
+                  place=max(map(width, map_names)), location=max(map(width, locations)),
+                  person=7 * 11, number=width('999'), outcome=max(map(width, ('win', 'loss', 'draw'))),
+                  quantity=max(width('just one'), width('999')))
+    def encoded_size(text):
+        return sum(1 if char == '\n' else len(mapping[char]) if char in mapping else 4 for char in text)
+    byte_bounds = dict(species=10, item=14,
+                       place=max(map(encoded_size, map_names)),
+                       location=max(map(encoded_size, locations)),
+                       person=11, number=3, outcome=4, quantity=len('just one'))
+    roles = {
+        'SwitchMon1WithMon2': ['species', 'species'], 'UsedTheItem': ['item'],
+        'WithdrewItemFromPC': ['item'], 'GaveMonHeldItemFromPC': ['item', 'species'],
+        'GaveMonHeldItem2': ['species', 'item'], 'LeftTownsLocationForNextDestination': ['place', 'location'],
+        'UsedEscapeRope': [None, 'location'], 'DepartedFromLocationToNextDestination': [None, 'location'],
+        'ObtainedItemInLocation': ['place', 'item'], 'SavedGameAtLocation': ['place'],
+    }
+    dynamic_roles = {
+        'MultiBattleWithPeopleResultedInOutcome': {1:'person', 2:'person', 3:'person', 4:'outcome'},
+        'PlayerBattledChampionRival': {1:'person'},
+        'PlayerSentOutMon1RivalSentOutMon2': {0:'person', 1:'species', 3:'species'},
+        'DefeatedWildMon': {0:'place', 1:'species'}, 'CaughtWildMon': {0:'place', 3:'species'},
+        'DefeatedWildMonAndCaughtWildMon': {0:'place', 1:'species', 3:'species'},
+        'DefeatedWildMonsAndCaughtWildMon': {0:'place', 1:'species', 2:'number', 3:'species'},
+        'SoldNumOfItem': {1:'place', 2:'item', 3:'quantity'},
+    }
+    layout, expanded_bytes = [], []
+    for name, texts in pairs.items():
+        suffix = name.removeprefix('gText_QuestLog_')
+        by_token = {'{STR_VAR_%d}' % index: bounds[role] for index, role in enumerate(roles.get(suffix, []), 1) if role}
+        by_token.update({'{DYNAMIC 0x%02X}' % index: bounds[role] for index, role in dynamic_roles.get(suffix, {}).items()})
+        token_bytes = {'{STR_VAR_%d}' % index: byte_bounds[role] for index, role in enumerate(roles.get(suffix, []), 1) if role}
+        token_bytes.update({'{DYNAMIC 0x%02X}' % index: byte_bounds[role] for index, role in dynamic_roles.get(suffix, {}).items()})
+        for locale, text in zip(('en', 'zh'), texts):
+            size = 1 + sum(token_bytes[part] if part.startswith('{') else encoded_size(part) for part in re.split(r'(\{[^}]+\})', text) if part)
+            assert size <= 0x100, (name, locale, size, 'Recap scans only its first256 encoded bytes')
+            expanded_bytes.append(dict(symbol=name, locale=locale, maxEncodedBytesIncludingEos=size))
+            for line in text.split('\n'):
+                pixels = sum(by_token[part] if part.startswith('{') else width(part) for part in re.split(r'(\{[^}]+\})', line) if part)
+                assert pixels <= 236, (name, locale, pixels, line, bounds)
+                layout.append(dict(symbol=name, locale=locale, line=line, maxPixels=pixels))
+    font = glyphs.load_font(ROOT)
+    assert all(any(font.render(char)) for char in missing), 'Required glyph unavailable in pinned Fusion font'
+    assert all(font.render(row['character']) == row['masks'] for row in existing['rows'])
+    return dict(status='SOURCE_AND_TEMPLATE_AUDIT_PASS', standardContexts=13, dynamicContexts=8,
+                directRoutes=len(direct), departureArrayRoutes=arrays, localPlayerPointers=5,
+                recordStorageReplayAndOtherParticipantsUnchanged=True, protectedPaths=list(protected),
+                nativeLineLimit=3, nativePixelLimit=236, insertedWidthBounds=bounds,
+                measuredLines=layout, boundedExpandedBytes=expanded_bytes,
+                missingGlyphs=sorted(missing), missingGlyphCount=len(missing),
+                released748GlyphPrefixUnchanged=True,
+                fontFilesUnchangedOnThisWorktree=(base_charmap == (ROOT / 'charmap.txt').read_bytes() and base_header == (ROOT / 'src/data/taichung_glyphs.h').read_bytes()),
+                missingGlyphsAvailableInPinnedFusion=True)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--json', type=Path)
+    parser.add_argument('--require-glyphs', action='store_true')
+    args = parser.parse_args()
+    result = audit()
+    if args.json:
+        args.json.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
+    print('PASS:21 complete bilingual quest-log templates; local-only routes, immutable storage/replay/participants and bounded native lines')
+    if result['missingGlyphs']:
+        print('MAIN APPEND REQUIRED (font/charmap untouched): ' + ''.join(result['missingGlyphs']))
+    raise SystemExit(1 if args.require_glyphs and result['missingGlyphs'] else 0)
