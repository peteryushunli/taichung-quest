+static const u8 sRosterHintZh[] = _("001-150   L/R快選");
+static const u8 sMovesEn[] = _("PRESET MOVES");
+static const u8 sMovesZh[] = _("招式");
+static const u8 sConfirmEn[] = _("Use this POKéMON in this slot?");
+static const u8 sConfirmZh[] = _("要使用這隻寶可夢嗎？");
+static const u8 sConfirmFooterEn[] = _("A: confirm   B: keep choosing");
