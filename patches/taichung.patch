diff --git a/data/maps/TaichungGuestHouse_1F/scripts.inc b/data/maps/TaichungGuestHouse_1F/scripts.inc
new file mode 100644
index 0000000..bb65d10
--- /dev/null
+++ b/data/maps/TaichungGuestHouse_1F/scripts.inc
@@ -0,0 +1,73 @@
+@ Downstairs, like FireRed's player's house: Xiaoyu, the city guide who runs
+@ the guest house, greets the player coming down the stairs, offers the four
+@ starters, then heads out the front door ahead of them. Her object hides once
+@ the player has a POKéMON (FLAG_SYS_POKEMON_GET); outside, she waits beside
+@ the door for the quick tips.
+TaichungGuestHouse_1F_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, TaichungCity_OnTransition
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, TaichungGuestHouse_1F_OnFrame
+	.byte 0
+
+TaichungGuestHouse_1F_OnFrame::
+	map_script_2 TAICHUNG_LANGUAGE, 0, Taichung_InitLanguage
+	map_script_2 TAICHUNG_STARTER_SPECIES, 0, TaichungGuestHouse_1F_Welcome
+	.2byte 0
+
+@ The only way down is the stairs, so the player stands on (10,2).
+TaichungGuestHouse_1F_Welcome::
+	lockall
+	callnative TaichungStarter_ScriptHasPartner
+	goto_if_eq VAR_RESULT, TRUE, TaichungGuestHouse_1F_Release
+	playse SE_PIN
+	applymovement LOCALID_TAICHUNG_GUEST_HOUSE_XIAOYU, TaichungGuestHouse_1F_Movement_Greet
+	waitmovement 0
+	turnobject LOCALID_PLAYER, DIR_SOUTH
+	callnative TaichungOnboarding_ScriptWelcome
+	callnative TaichungGuestHouse_BufferWelcome
+	msgbox gStringVar4
+	call Taichung_StarterChoice
+	callnative TaichungOnboarding_ScriptGranted
+	callnative TaichungGuestHouse_BufferSeeYouOutside
+	msgbox gStringVar4
+	closemessage
+	applymovement LOCALID_TAICHUNG_GUEST_HOUSE_XIAOYU, TaichungGuestHouse_1F_Movement_Leave
+	waitmovement 0
+	playse SE_EXIT
+	removeobject LOCALID_TAICHUNG_GUEST_HOUSE_XIAOYU
+TaichungGuestHouse_1F_Release::
+	releaseall
+	end
+
+TaichungGuestHouse_1F_Movement_Greet:
+	emote_exclamation_mark
+	delay_16
+	walk_up
+	walk_right
+	walk_right
+	face_up
+	step_end
+
+TaichungGuestHouse_1F_Movement_Leave:
+	walk_down
+	walk_down
+	walk_down
+	walk_down
+	walk_down
+	walk_left
+	walk_left
+	walk_left
+	walk_left
+	walk_left
+	walk_down
+	step_end
+
+TaichungGuestHouse_1F_Xiaoyu::
+	callnative TaichungGuestHouse_BufferSeeYouOutside
+	msgbox gStringVar4, MSGBOX_NPC
+	end
+
+TaichungGuestHouse_1F_TV::
+	callnative TaichungGuestHouse_BufferTv
+	msgbox gStringVar4, MSGBOX_SIGN
+	end
