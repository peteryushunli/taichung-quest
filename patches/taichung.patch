+# The registered city kit fills unused slots of the private primaries, and the
+# registered Xitun, Nantun and Old City reworks grow their maps to the master plan. Their
+# own guards prove those deltas; this guard checks the Xitun state underneath them
+# (the Old City rework, the latest layer, stripped first).
+def _city_kit(source, overrides, nantun=True):
+    support = load("xitun_city_kit_support", source/"tools/taichung/landmarks/check_old_core.py")
+    tree = support.Files(source)
+    tree.cache.update(overrides or {})
+    oldcity = support.oldcity_rework_underneath(tree)
+    tree.cache.update(oldcity)
+    rework = support.xitun_rework_underneath(tree)
+    tree.cache.update(rework)
+    layer = support.nantun_rework_underneath(tree) if nantun else {}
+    tree.cache.update(layer)
+    return {**oldcity, **rework, **layer, **support.city_kit_underneath(tree)}
