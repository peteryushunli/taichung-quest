index 00000000..02abbe35
--- /dev/null
+++ b/data/scripts/taichung_gym_preparation.inc
@@ -0,0 +1,63 @@
+@ Only an explicitly completed preparation can arm this one-shot continuation.
+@ The leader's authored intro was shown before Team. Native configuration skips
+@ that repeat while preserving the original trainer and badge-award return.
+TaichungGymPrepared_Start::
+	lockall
+	callnative TaichungGymEntry_ScriptPrepareBattle
+	goto_if_eq VAR_RESULT, FALSE, TaichungGymPrepared_Unavailable
+	.macro prepared_gym_route name, gym, trainer
+	goto_if_eq VAR_0x8004, \gym, TaichungGymPrepared_\name
+	.endm
+	prepared_gym_route Station, TAICHUNG_GYM_OLD_STATION, TRAINER_TAICHUNG_STATION_JUN
+	prepared_gym_route Park, TAICHUNG_GYM_PARK, TRAINER_TAICHUNG_PARK_LIAN
+	prepared_gym_route Miyahara, TAICHUNG_GYM_MIYAHARA, TRAINER_TAICHUNG_MIYAHARA_PEIQI
+	prepared_gym_route Science, TAICHUNG_GYM_SCIENCE_MUSEUM, TRAINER_TAICHUNG_SCIENCE_YICHENG
+	prepared_gym_route Greenway, TAICHUNG_GYM_GREENWAY, TRAINER_TAICHUNG_GREENWAY_XINGAN
+	prepared_gym_route Confucius, TAICHUNG_GYM_CONFUCIUS_TEMPLE, TRAINER_TAICHUNG_CONFUCIUS_WENYI
+	prepared_gym_route FineArts, TAICHUNG_GYM_FINE_ARTS, TRAINER_TAICHUNG_FINE_ARTS_CAINING
+	prepared_gym_route Fengjia, TAICHUNG_GYM_FENGJIA, TRAINER_TAICHUNG_FENGJIA_JIAHE
+	prepared_gym_route MapleGarden, TAICHUNG_GYM_MAPLE_GARDEN, TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING
+	prepared_gym_route Theater, TAICHUNG_GYM_THEATER, TRAINER_TAICHUNG_THEATER_LING
+	goto TaichungGymPrepared_Leave
+
+	.macro prepared_gym_battle name, trainer
+TaichungGymPrepared_\name:
+	goto_if_eq VAR_0x40FB, 2, TaichungGymPrepared_\name\()Chinese
+	trainerbattle_single \trainer, TaichungGym_Text_\name\()IntroEn, TaichungGym_Text_\name\()DefeatEn, TaichungGym_\name\()AfterBattle
+	goto TaichungGymPrepared_Leave
+TaichungGymPrepared_\name\()Chinese:
+	trainerbattle_single \trainer, TaichungGym_Text_\name\()IntroZh, TaichungGym_Text_\name\()DefeatZh, TaichungGym_\name\()AfterBattle
+	goto TaichungGymPrepared_Leave
+	.endm
+	prepared_gym_battle Station, TRAINER_TAICHUNG_STATION_JUN
+	prepared_gym_battle Park, TRAINER_TAICHUNG_PARK_LIAN
+	prepared_gym_battle Miyahara, TRAINER_TAICHUNG_MIYAHARA_PEIQI
+	prepared_gym_battle Science, TRAINER_TAICHUNG_SCIENCE_YICHENG
+	prepared_gym_battle Greenway, TRAINER_TAICHUNG_GREENWAY_XINGAN
+	prepared_gym_battle Confucius, TRAINER_TAICHUNG_CONFUCIUS_WENYI
+	prepared_gym_battle FineArts, TRAINER_TAICHUNG_FINE_ARTS_CAINING
+	prepared_gym_battle Fengjia, TRAINER_TAICHUNG_FENGJIA_JIAHE
+	prepared_gym_battle MapleGarden, TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING
+	prepared_gym_battle Theater, TRAINER_TAICHUNG_THEATER_LING
+
+TaichungGymPrepared_Unavailable::
+	msgbox gStringVar4
+TaichungGymPrepared_Leave::
+	closemessage
+	releaseall
+	end
+
+@ Same native fought/replay/movement safeguards as a normal trainer challenge,
+@ with only the already-shown intro omitted. Continue-script award target stays.
+TaichungGymPrepared_TrainerBattle::
+	lock
+	faceplayer
+	applymovement VAR_LAST_TALKED, Movement_RevealTrainer
+	waitmovement 0
+	specialvar VAR_RESULT, Script_HasTrainerBeenFought
+	goto_if_ne VAR_RESULT, FALSE, EventScript_NoTrainerBattle
+	special PlayTrainerEncounterMusic
+	special SetUpTrainerMovement
+	goto_if_questlog EventScript_EndQuestLogBattle
+	dotrainerbattle
+	gotopostbattlescript
diff --git a/data/scripts/taichung_gyms.inc b/data/scripts/taichung_gyms.inc
new file mode 100644
index 00000000..b8109f8d
--- /dev/null
+++ b/data/scripts/taichung_gyms.inc
@@ -0,0 +1,122 @@
+@ Optional reusable adapter. The map owner may point the Station host here.
+@ Other gyms need their own approved trainer/adapter; listed names do not grant badges.
+TaichungGym_EventScript_StationChallenge::
+	lock
+	faceplayer
+	goto_if_questlog TaichungGym_StationReplaySkipped
+	setvar VAR_0x8004, TAICHUNG_GYM_OLD_STATION
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_eq VAR_RESULT, TRUE, TaichungGym_StationAlreadyComplete
+	setvar VAR_0x8004, TAICHUNG_GYM_OLD_STATION
+	setvar VAR_0x8005, TRAINER_TAICHUNG_STATION_JUN
+	callnative TaichungGym_ScriptPrepareChallenge
+	goto_if_eq VAR_RESULT, FALSE, TaichungGym_StationUnavailable
+	goto_if_eq VAR_0x40FB, 2, TaichungGym_StationBattleChinese
+	trainerbattle_single TRAINER_TAICHUNG_STATION_JUN, TaichungGym_Text_StationIntroEn, TaichungGym_Text_StationDefeatEn, TaichungGym_StationAfterBattle
+	goto TaichungGym_StationBattleSkipped
+
+TaichungGym_StationBattleChinese::
+	trainerbattle_single TRAINER_TAICHUNG_STATION_JUN, TaichungGym_Text_StationIntroZh, TaichungGym_Text_StationDefeatZh, TaichungGym_StationAfterBattle
+	goto TaichungGym_StationBattleSkipped
+
+@ Native trainer flags can bypass a battle (for example, a quest-log replay).
+@ Cancel tracking and release controls rather than trusting an old battle result.
+TaichungGym_StationBattleSkipped::
+	callnative TaichungGym_ScriptCancelChallenge
+	goto TaichungGym_StationNotRecorded
+
+TaichungGym_StationAfterBattle::
+	setvar VAR_0x8004, TAICHUNG_GYM_OLD_STATION
+	callnative TaichungGym_ScriptGetResult
+	goto_if_ne VAR_RESULT, TAICHUNG_GYM_RESULT_WON, TaichungGym_StationNotRecorded
+	callnative TaichungGym_ScriptIsComplete
+	goto_if_ne VAR_RESULT, TRUE, TaichungGym_StationNotRecorded
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_COMPLETE
+	callnative TaichungGym_ScriptGetStationMessage
+	goto TaichungBadge_EventScript_AwardAndRelease
+
+TaichungGym_StationAlreadyComplete::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_ALREADY_COMPLETE
+	callnative TaichungGym_ScriptGetStationMessage
+	msgbox gStringVar4
+	release
+	end
+
+TaichungGym_StationDeclined::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_DECLINED
+	goto TaichungGym_StationMessage
+
+TaichungGym_StationUnavailable::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_UNAVAILABLE
+	goto TaichungGym_StationMessage
+
+TaichungGym_StationNotRecorded::
+	setvar VAR_0x8005, TAICHUNG_GYM_MESSAGE_NOT_RECORDED
+
+TaichungGym_StationMessage::
+	callnative TaichungGym_ScriptGetStationMessage
+	msgbox gStringVar4
+	release
+	end
+
+TaichungGym_StationReplaySkipped::
+	callnative TaichungGym_ScriptCancelChallenge
+	release
+	end
+
+@ Called only after each real matching win and its saved-bit guard. A pending
+@ one-time event is required; old wins, history and NPC chats cannot open it.
+TaichungBadge_EventScript_AwardAndRelease::
+	callnative TaichungBadge_ScriptPrepareAward
+	goto_if_ne VAR_RESULT, TRUE, TaichungBadge_AwardDone
+	msgbox gStringVar4
+	closemessage
+	callnative TaichungBadge_ScriptOpenAward
+	waitstate
+TaichungBadge_AwardDone::
+	release
+	end
+
+@ TEMP_F resets on actual map entry, not when returning from the team menu.
+@ Offer explicit battle preparation once per visit; later browsing stays optional.
+TaichungGymEntry_OnFrame::
+	map_script_2 VAR_TEMP_F, 0, TaichungGymEntry_Check
+	.2byte 0
+
+TaichungGymEntry_Check::
+	setvar VAR_TEMP_F, 1
+	goto_if_questlog TaichungGymEntry_Done
+	callnative TaichungGymEntry_ScriptCheck
+	goto_if_ne VAR_RESULT, TRUE, TaichungGymEntry_Done
+	lockall
+	message gStringVar4
+	waitmessage
+	multichoice 0, 0, MULTICHOICE_TAICHUNG_TEAM_REMINDER, FALSE
+	goto_if_eq VAR_RESULT, 0, TaichungGymEntry_ChooseTeam
+	goto_if_gt VAR_RESULT, 3, TaichungGymEntry_Close
+	copyvar VAR_0x8006, VAR_RESULT
+	closemessage
+	callnative TaichungGymEntry_ScriptBufferPreparationIntro
+	goto_if_ne VAR_RESULT, TRUE, TaichungGymEntry_Release
+	msgbox gStringVar4
+	closemessage
+	copyvar VAR_RESULT, VAR_0x8006
+	callnative TaichungGymEntry_ScriptFillRandom
+	goto_if_eq VAR_RESULT, TRUE, TaichungGymPrepared_Start
+	msgbox gStringVar4
+	goto TaichungGymEntry_Release
+TaichungGymEntry_Close::
+	closemessage
+	goto TaichungGymEntry_Release
+TaichungGymEntry_ChooseTeam::
+	closemessage
+	callnative TaichungGymEntry_ScriptBufferPreparationIntro
+	goto_if_ne VAR_RESULT, TRUE, TaichungGymEntry_Release
+	msgbox gStringVar4
+	closemessage
+	callnative TaichungGymEntry_ScriptOpenTeam
+	waitstate
+TaichungGymEntry_Release::
+	releaseall
+TaichungGymEntry_Done::
+	end
