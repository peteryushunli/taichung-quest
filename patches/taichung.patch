+            dict(layer='waterway geometry',status='not retrieved; Overpass attempts failed; no river paths invented'),
+            dict(layer='surveyed building footprints / land-use zoning',status='not in road extract; fill recipes and lots are game-design proposals')],
+        integrationNotes=['Do not replace existing native maps or move current doors with this draft alone',
+            'Fix landmark envelope overlaps by local elastic placement before prefab painting',
