+}
+
+static const struct Expected *Expected(u8 map, s16 x, s16 y)
+{
+    unsigned i;
+    for (i=0;i<sizeof(sExpected)/sizeof(sExpected[0]);i++)
+        if (map==sExpected[i].map && x==sExpected[i].x && y==sExpected[i].y)
+            return &sExpected[i];
+    return NULL;
+}
+
+static void Protected(struct SaveBlock1 before, bool8 allowWarp)
+{
+    if (allowWarp) before.continueGameWarp=sSave.continueGameWarp;
+    assert(memcmp(&before,&sSave,sizeof(before))==0);
+    sCases++;
+}
+
+int main(void)
+{
+    unsigned m, x, y, i, v;
+    const u8 maps[]={27,35,36,29};
+    const u8 widths[]={33,49,49,33};
+    const u8 heights[]={46,46,19,19};
