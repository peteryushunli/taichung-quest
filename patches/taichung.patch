+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Taichung native map QA</title>
+<style>
+  :root { color-scheme: dark; font: 15px system-ui, sans-serif; background: #172223; color: #e8f0ed; }
+  body { max-width: 950px; margin: 12px auto; padding: 0 20px; }
+  h1 { font-size: 22px; margin: 8px 0; }
+  p { margin: 8px 0; }
+  canvas { width: 480px; max-width: 100%; height: auto; image-rendering: pixelated; background: #000; display: block; margin: 8px 0; }
+  button, input { font: inherit; padding: 8px 12px; margin: 3px; }
+  button { cursor: pointer; }
+  button:disabled { cursor: default; opacity: .5; }
+  input[type=number] { width: 85px; }
+  pre { white-space: pre-wrap; background: #0b1516; padding: 12px; min-height: 24px; }
+  .controls { display: flex; flex-wrap: wrap; gap: 4px; margin: 12px 0; }
+  label { display: inline-block; margin-right: 12px; }
+</style>
+<h1>Taichung native map QA</h1>
+<p>Isolated feature ROM and fresh save. Use the in-game Save menu before reading the saved location.</p>
+<button id="load">Load cartridge</button>
+<label><input id="mute" type="checkbox" checked>mute audio</label>
+<span id="timing">Timing not started.</span>
+<p id="status" role="status">Ready to load.</p>
+<canvas id="screen" width="240" height="160" aria-label="Native Game Boy Advance game screen"></canvas>
+<label>hold ms <input id="hold-ms" type="number" value="300" min="16" max="10000" step="10"></label>
+<label>repeat count <input id="repeat-count" type="number" value="1" min="1" max="50"></label>
+<div class="controls" id="keys">
+  <button data-key="Up" disabled>up</button>
+  <button data-key="Down" disabled>down</button>
+  <button data-key="Left" disabled>left</button>
+  <button data-key="Right" disabled>right</button>
+  <button data-key="A" disabled>a</button>
+  <button data-key="B" disabled>b</button>
+  <button data-key="Start" disabled>start</button>
+  <button data-key="Select" disabled>select</button>
+</div>
+<pre id="last-action" aria-live="polite">No input sent.</pre>
+<button id="read-location" disabled>Read saved location</button>
+<button id="reset" disabled>Reset cartridge (keep save)</button>
+<button id="download-screen" disabled>Download screen</button>
+<button id="download-save" disabled>Download save</button>
+<pre id="location">No saved location read.</pre>
+<script type="module">
+  import createMgba from '/mgba.js';
+
+  const byId = id => document.getElementById(id);
+  const canvas = byId('screen');
+  const originalGetContext = canvas.getContext.bind(canvas);
+  // The bundled runtime calls canvas.getContext('webgl2', attributes) and does
+  // not request preservation. Set it before the first context is created so a
+  // PNG capture can read the displayed frame after the browser has presented it.
+  canvas.getContext = (type, attributes) => originalGetContext(type,
+    ['webgl', 'webgl2', 'experimental-webgl'].includes(type)
+      ? { ...attributes, preserveDrawingBuffer: true }
+      : attributes);
+  const status = message => { byId('status').textContent = message; };
+  const keyButtons = [...document.querySelectorAll('[data-key]')];
+  const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+  let emulator;
+  let busy = false;
+  let saveDescription = '';
+
+  function configureTiming() {
+    // Local mGBA declarations link to this API, and the bundled implementation
+    // confirms mode 0 = setTimeout with value in milliseconds:
+    // https://emscripten.org/docs/api_reference/emscripten.h.html#c.emscripten_set_main_loop_timing
+    // Timers can still be throttled in a hidden tab; this avoids depending on RAF.
+    emulator.setMainLoopTiming(0, 16);
+    byId('timing').textContent = `Timing: mode ${emulator.getMainLoopTimingMode()}, value ${emulator.getMainLoopTimingValue()} (0 = timer ms).`;
+  }
+
+  function download(bytes, type, filename) {
+    const url = URL.createObjectURL(new Blob([bytes], { type }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = filename;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 30000);
+  }
+
+  byId('load').addEventListener('click', async () => {
+    byId('load').disabled = true;
+    status('Loading isolated cartridge…');
+    try {
+      if (!crossOriginIsolated || typeof SharedArrayBuffer === 'undefined') {
+        throw new Error('This tab needs COOP/COEP headers and SharedArrayBuffer.');
+      }
+      const response = await fetch('/mapping.gba', { cache: 'no-store' });
+      if (!response.ok) throw new Error(`ROM request failed: ${response.status}`);
+      const rom = new Uint8Array(await response.arrayBuffer());
+      emulator = await createMgba({ canvas });
+      await emulator.FSInit();
+      emulator.setCoreSettings({
+        autoSaveStateEnable: false,
+        restoreAutoSaveStateOnLoad: false,
+        rewindEnable: false,
+        allowOpposingDirections: false,
+      });
+      emulator.addCoreCallbacks({ coreCrashedCallback: () => status('Emulator reported a core crash.') });
+      const requestedToken = new URLSearchParams(location.search).get('qaSave');
+      if (requestedToken !== null && !/^[A-Za-z0-9_-]{1,100}$/.test(requestedToken)) {
+        throw new Error('qaSave must contain 1–100 letters, numbers, hyphens or underscores.');
+      }
+      const token = requestedToken ?? crypto.randomUUID();
+      const romPath = `${emulator.filePaths().gamePath}/mapping-qa-${token}.gba`;
+      const savePath = `${emulator.filePaths().savePath}/mapping-qa-${token}.sav`;
+      const saveExisted = emulator.FS.analyzePath(savePath).exists;
+      saveDescription = requestedToken === null ? `Fresh unique save ${token}.`
+        : saveExisted ? `Reusing named save ${token}; persisted file found.`
+        : `Named save ${token}; no persisted file found, starting fresh.`;
+      emulator.FS.writeFile(romPath, rom);
+      if (!emulator.loadGame(romPath, savePath)) throw new Error('mGBA could not open the cartridge.');
+      emulator.toggleInput(false);
+      configureTiming();
+      emulator.setVolume(byId('mute').checked ? 0 : 0.5);
+      if (!byId('mute').checked) {
+        emulator.resumeAudio();
+        await emulator.SDL2?.audioContext?.resume();
+      }
+      keyButtons.forEach(button => { button.disabled = false; });
+      byId('read-location').disabled = false;
+      for (const id of ['reset', 'download-screen', 'download-save']) byId(id).disabled = false;
+      status(`Running feature cartridge (${rom.length.toLocaleString()} bytes). ${saveDescription}`);
+    } catch (error) {
+      status(`Load failed: ${error.message}`);
+      byId('load').disabled = false;
+    }
+  });
+
+  byId('mute').addEventListener('change', async () => {
+    if (!emulator) return;
+    emulator.setVolume(byId('mute').checked ? 0 : 0.5);
+    if (!byId('mute').checked) {
+      emulator.resumeAudio();
+      await emulator.SDL2?.audioContext?.resume();
+    }
+  });
+
+  for (const button of keyButtons) {
+    button.addEventListener('click', async () => {
+      if (!emulator || busy) return;
+      busy = true;
+      keyButtons.forEach(b => { b.disabled = true; });
+      const key = button.dataset.key;
+      const hold = Math.max(16, Math.min(10000, Number(byId('hold-ms').value) || 300));
+      const repeat = Math.max(1, Math.min(50, Math.floor(Number(byId('repeat-count').value) || 1)));
+      byId('last-action').textContent = `Sending ${key}, ${hold} ms, ${repeat} time(s)…`;
+      try {
+        for (let i = 0; i < repeat; i++) {
+          emulator.buttonPress(key);
+          await wait(hold);
+          emulator.buttonUnpress(key);
+          if (i + 1 < repeat) await wait(100);
+        }
+        byId('last-action').textContent = `Sent ${key}, ${hold} ms, ${repeat} time(s).`;
+      } catch (error) {
+        byId('last-action').textContent = `Input failed: ${error.message}`;
+      } finally {
+        emulator.buttonUnpress(key);
+        busy = false;
+        keyButtons.forEach(b => { b.disabled = false; });
+      }
+    });
+  }
+
+  byId('reset').addEventListener('click', async () => {
+    if (!emulator || busy) return;
+    busy = true;
+    byId('reset').disabled = true;
+    keyButtons.forEach(button => { button.disabled = true; });
+    try {
+      await emulator.FSSync();
+      emulator.quickReload();
+      configureTiming();
+      status(`Cartridge reset. Native save retained; choose Continue to verify it. ${saveDescription}`);
+    } catch (error) {
+      status(`Reset failed: ${error.message}`);
+    } finally {
+      busy = false;
+      byId('reset').disabled = false;
+      keyButtons.forEach(button => { button.disabled = false; });
+    }
+  });
+
+  byId('download-screen').addEventListener('click', async () => {
+    try {
+      const filename = `taichung-map-qa-${Date.now()}.png`;
+      // Capture the actual displayed native-ROM canvas. This runtime's separate
+      // screenshot API returned an all-black file during QA, so do not use it as
+      // evidence. Copy unchanged pixels into a 2D canvas and reject blank frames.
+      const frame = document.createElement('canvas');
+      frame.width = canvas.width;
+      frame.height = canvas.height;
+      const context = frame.getContext('2d', { willReadFrequently: true });
+      context.drawImage(canvas, 0, 0);
+      const pixels = context.getImageData(0, 0, frame.width, frame.height).data;
+      let nonBlackPixels = 0;
+      for (let i = 0; i < pixels.length; i += 4) {
+        if (pixels[i] || pixels[i + 1] || pixels[i + 2]) nonBlackPixels++;
+      }
+      if (!nonBlackPixels) throw new Error('Captured frame is entirely black. Reload this updated QA page, load the cartridge, and retry after the game is visible.');
+      const blob = await new Promise(resolve => frame.toBlob(resolve, 'image/png'));
+      if (!blob) throw new Error('Could not encode the game canvas.');
+      download(blob, 'image/png', filename);
+      byId('last-action').textContent = `Downloaded ${filename}; ${frame.width}×${frame.height}, ${nonBlackPixels} non-black pixels from the native game canvas.`;
+    } catch (error) {
+      byId('last-action').textContent = `Screen download failed: ${error.message}`;
+    }
+  });
+
+  byId('download-save').addEventListener('click', () => {
+    try {
+      const bytes = emulator.getSave();
+      if (!bytes) throw new Error('Save through the game menu first.');
+      const filename = `taichung-map-qa-${Date.now()}.sav`;
+      download(bytes, 'application/octet-stream', filename);
+      byId('last-action').textContent = `Downloaded ${filename} (${bytes.length} bytes).`;
+    } catch (error) {
+      byId('last-action').textContent = `Save download failed: ${error.message}`;
+    }
+  });
+
+  byId('read-location').addEventListener('click', () => {
+    try {
+      const bytes = emulator?.getSave();
+      if (!bytes) throw new Error('No save exists yet. Save through the game menu first.');
+      const data = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+      const sectors = [];
+      for (let offset = 0; offset + 0x1000 <= bytes.length; offset += 0x1000) {
+        if (data.getUint16(offset + 0xFF4, true) === 1 && data.getUint32(offset + 0xFF8, true) === 0x08012025) {
+          sectors.push({ offset, counter: data.getUint32(offset + 0xFFC, true) });
+        }
+      }
+      if (!sectors.length) throw new Error('No valid SaveBlock1 sector found. Finish saving in the game first.');
+      sectors.sort((a, b) => b.counter - a.counter);
+      const { offset, counter } = sectors[0];
+      byId('location').textContent = JSON.stringify({
+        saveCounter: counter,
+        x: data.getInt16(offset, true),
+        y: data.getInt16(offset + 2, true),
+        mapGroup: data.getUint8(offset + 4),
+        mapNumber: data.getUint8(offset + 5),
+        partyCount: data.getUint8(offset + 0x34),
+        saveBytes: bytes.length,
+      }, null, 2);
+    } catch (error) {
+      byId('location').textContent = error.message;
+    }
+  });
+</script>
+</html>
