diff --git a/src/taichung_language_bridge.c b/src/taichung_language_bridge.c
new file mode 100644
index 0000000..234d028
--- /dev/null
+++ b/src/taichung_language_bridge.c
@@ -0,0 +1,83 @@
+#include "global.h"
+#include "event_data.h"
+#include "field_message_box.h"
+#include "link.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "quest_log.h"
+#include "script.h"
+#include "taichung_language.h"
+#include "taichung_language_bridge.h"
+#include "text.h"
+
+EWRAM_DATA volatile struct TaichungLanguageBridge gTaichungLanguageBridge = {0};
+static EWRAM_DATA bool8 sHasEnteredOverworld = FALSE;
+static EWRAM_DATA bool8 sApplyingBrowserRequest = FALSE;
+
+static bool8 SaveVariablesReady(void)
+{
+    u32 address = (u32)gSaveBlock1Ptr;
+
+    // Pointers exist during the title screen, before a new game/save has been
+    // initialized. Do not inspect them until a real field callback has run.
+    if (Overworld_IsMainFieldCallback())
+        sHasEnteredOverworld = TRUE;
+    return sHasEnteredOverworld
+        && address >= EWRAM_START
+        && address <= EWRAM_END - sizeof(*gSaveBlock1Ptr)
+        && (address & 3) == 0;
+}
+
+static bool8 IsSafeField(bool8 gameCallbacksRan)
+{
+    u8 printer;
+
+    if (!gameCallbacksRan || !Overworld_IsMainFieldCallback()
+        || gMain.inBattle || gPaletteFade.active
+        || gReceivedRemoteLinkPlayers || IsUpdateLinkStateCBActive()
+        || ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled()
+        || !IsFieldMessageBoxHidden()
+        || QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+        return FALSE;
+
+    for (printer = 0; printer < NUM_TEXT_PRINTERS; printer++)
+    {
+        if (IsTextPrinterActive(printer))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static bool8 ApplyBrowserLanguage(u8 language)
+{
+    bool8 written;
+
+    sApplyingBrowserRequest = TRUE;
+    written = VarSet(TAICHUNG_LANGUAGE_VAR, language);
+    sApplyingBrowserRequest = FALSE;
+    return written;
+}
+
+void TaichungLanguageBridge_OnNativeChoice(u16 language)
+{
+    if (!sApplyingBrowserRequest)
+        TaichungLanguageBridge_PublishNativeChoice(&gTaichungLanguageBridge, language);
+}
+
+void TaichungLanguageBridge_Tick(bool8 gameCallbacksRan)
+{
+    bool8 ready = SaveVariablesReady();
+    u16 language = 0;
+
+    // VarGet can replay quest-log values. Reading this one saved variable
+    // directly publishes the current preference without those side effects.
+    if (ready)
+        language = gSaveBlock1Ptr->vars[TAICHUNG_LANGUAGE_VAR - VARS_START];
+
+    TaichungLanguageBridge_UpdatePacket(&gTaichungLanguageBridge,
+                                       (u32)&gTaichungLanguageBridge,
+                                       language <= 2 ? language : 0,
+                                       ready, ready && IsSafeField(gameCallbacksRan),
+                                       ApplyBrowserLanguage);
+}
diff --git a/src/taichung_language_bridge_protocol.c b/src/taichung_language_bridge_protocol.c
new file mode 100644
index 0000000..08f92e7
--- /dev/null
+++ b/src/taichung_language_bridge_protocol.c
@@ -0,0 +1,116 @@
+#include <stddef.h>
+#include "taichung_language_bridge.h"
+
+typedef char PacketSizeCheck[sizeof(struct TaichungLanguageBridge) == TAICHUNG_LANGUAGE_BRIDGE_SIZE ? 1 : -1];
+typedef char FrameOffsetCheck[offsetof(struct TaichungLanguageBridge, frameCounter) == 16 ? 1 : -1];
+typedef char RequestOffsetCheck[offsetof(struct TaichungLanguageBridge, requestSequence) == 24 ? 1 : -1];
+typedef char AckOffsetCheck[offsetof(struct TaichungLanguageBridge, ackSequence) == 28 ? 1 : -1];
+
+static bool8 IsLanguage(u16 language)
+{
+    return language == 1 || language == 2;
+}
+
+static bool8 HasHeader(volatile struct TaichungLanguageBridge *packet)
+{
+    return packet->magicA == TAICHUNG_LANGUAGE_BRIDGE_MAGIC_A
+        && packet->magicB == TAICHUNG_LANGUAGE_BRIDGE_MAGIC_B
+        && packet->version == TAICHUNG_LANGUAGE_BRIDGE_VERSION
+        && packet->size == TAICHUNG_LANGUAGE_BRIDGE_SIZE;
+}
+
+static void InitializePacket(volatile struct TaichungLanguageBridge *packet, u32 selfGbaAddress)
+{
+    packet->magicA = 0;
+    packet->magicB = 0;
+    packet->version = TAICHUNG_LANGUAGE_BRIDGE_VERSION;
+    packet->size = TAICHUNG_LANGUAGE_BRIDGE_SIZE;
+    packet->selfGbaAddress = selfGbaAddress;
+    packet->frameCounter = 0;
+    packet->activeLanguage = 0;
+    packet->requestedLanguage = 0;
+    packet->flags = 0;
+    packet->result = TAICHUNG_LANGUAGE_BRIDGE_NONE;
+    packet->requestSequence = 0;
+    packet->ackSequence = 0;
+    // Publish the signature after the remaining fields are initialized.
+    packet->magicB = TAICHUNG_LANGUAGE_BRIDGE_MAGIC_B;
+    packet->magicA = TAICHUNG_LANGUAGE_BRIDGE_MAGIC_A;
+}
+
+static void Acknowledge(volatile struct TaichungLanguageBridge *packet, u32 sequence, u8 result)
+{
+    packet->requestedLanguage = 0;
+    packet->result = result;
+    packet->ackSequence = sequence;
+}
+
+void TaichungLanguageBridge_PublishNativeChoice(volatile struct TaichungLanguageBridge *packet, u16 language)
+{
+    u32 sequence;
+
+    if (!IsLanguage(language) || !HasHeader(packet))
+        return;
+
+    packet->activeLanguage = language;
+    sequence = packet->requestSequence;
+    if (sequence != 0 && sequence != packet->ackSequence)
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+}
+
+void TaichungLanguageBridge_UpdatePacket(volatile struct TaichungLanguageBridge *packet,
+                                       u32 selfGbaAddress, u8 nativeLanguage,
+                                       bool8 variablesReady, bool8 safeField,
+                                       TaichungLanguageBridgeWriter writer)
+{
+    u32 sequence;
+    u8 requested;
+    u8 previousLanguage;
+
+    if (!HasHeader(packet) || packet->selfGbaAddress != selfGbaAddress)
+        InitializePacket(packet, selfGbaAddress);
+
+    packet->frameCounter++;
+    if (packet->frameCounter == 0)
+        packet->frameCounter = 1;
+
+    previousLanguage = packet->activeLanguage;
+    packet->activeLanguage = variablesReady && IsLanguage(nativeLanguage) ? nativeLanguage : 0;
+    packet->flags = variablesReady ? TAICHUNG_LANGUAGE_BRIDGE_READY : 0;
+    if (variablesReady && safeField)
+        packet->flags |= TAICHUNG_LANGUAGE_BRIDGE_SAFE_FIELD;
+
+    sequence = packet->requestSequence;
+    requested = packet->requestedLanguage;
+    if (sequence == 0 || sequence == packet->ackSequence)
+        return;
+    // One outstanding request is required. A half-published/replaced request
+    // is left for the next frame, rather than acknowledging the wrong value.
+    if (sequence != packet->requestSequence || requested != packet->requestedLanguage)
+        return;
+
+    // Also catches a native variable change made outside the normal menu hook.
+    if (packet->activeLanguage != 0 && previousLanguage != packet->activeLanguage)
+    {
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_NATIVE_WON);
+        return;
+    }
+    if (!IsLanguage(requested))
+    {
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_INVALID);
+        return;
+    }
+    if (!variablesReady || packet->activeLanguage == 0)
+    {
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_UNSET);
+        return;
+    }
+    if (!safeField || writer == 0)
+        return;
+
+    if (writer(requested))
+    {
+        packet->activeLanguage = requested;
+        Acknowledge(packet, sequence, TAICHUNG_LANGUAGE_BRIDGE_APPLIED);
+    }
+}
diff --git a/src/taichung_navigation_bridge.c b/src/taichung_navigation_bridge.c
new file mode 100644
index 0000000..0e1d492
--- /dev/null
+++ b/src/taichung_navigation_bridge.c
@@ -0,0 +1,184 @@
+#include "global.h"
+#include <stddef.h>
+#include "bike.h"
+#include "field_message_box.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "link.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "quest_log.h"
+#include "script.h"
+#include "taichung_navigation_bridge.h"
+#include "text.h"
+#include "constants/map_types.h"
+
+typedef char NavigationSizeCheck[sizeof(struct TaichungNavigationBridge) == TAICHUNG_NAVIGATION_BRIDGE_SIZE ? 1 : -1];
+typedef char NavigationSequenceCheck[offsetof(struct TaichungNavigationBridge, sequence) == 0x10 ? 1 : -1];
+typedef char NavigationPositionCheck[offsetof(struct TaichungNavigationBridge, localX) == 0x1C ? 1 : -1];
+typedef char NavigationContextCheck[offsetof(struct TaichungNavigationBridge, contextFlags) == 0x28 ? 1 : -1];
+
+EWRAM_DATA volatile struct TaichungNavigationBridge gTaichungNavigationBridge = {0};
+
+static bool8 SavePointerValid(void)
+{
+    u32 address = (u32)gSaveBlock1Ptr;
+
+    return address >= EWRAM_START
+        && address <= EWRAM_END - sizeof(*gSaveBlock1Ptr)
+        && (address & 3) == 0;
+}
+
+static u16 GetHiddenContext(bool8 gameCallbacksRan, bool8 field)
+{
+    u16 context = 0;
+    u8 printer;
+
+    if (!gameCallbacksRan)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_CALLBACKS_SKIPPED;
+    if (!field)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_NOT_FIELD;
+    if (gMain.inBattle)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_BATTLE;
+    if (gPaletteFade.active || gFieldCallback || gFieldCallback2)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_TRANSITION;
+    if (ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_SCRIPT;
+    if (!IsFieldMessageBoxHidden())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE;
+    for (printer = 0; printer < NUM_TEXT_PRINTERS; printer++)
+    {
+        if (IsTextPrinterActive(printer))
+            context |= TAICHUNG_NAVIGATION_CONTEXT_DIALOGUE;
+    }
+    if (gReceivedRemoteLinkPlayers || IsUpdateLinkStateCBActive())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_LINK;
+    if (QL_IS_PLAYBACK_STATE || QL_GetPlaybackState() == QL_PLAYBACK_STATE_RUNNING)
+        context |= TAICHUNG_NAVIGATION_CONTEXT_REPLAY;
+    if (!SavePointerValid())
+        context |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE;
+    return context;
+}
+
+static void ReadFieldPosition(struct TaichungNavigationBridge *snapshot)
+{
+    const struct MapLayout *layout = gMapHeader.mapLayout;
+    const struct ObjectEvent *player;
+    s16 x, y;
+    u8 facing;
+
+    if (gSaveBlock1Ptr->location.mapGroup < 0 || gSaveBlock1Ptr->location.mapNum < 0
+        || layout == NULL || layout->width <= 0 || layout->height <= 0
+        || layout->width > 0x7FFF || layout->height > 0x7FFF)
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP;
+        return;
+    }
+    if (gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT)
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR;
+        return;
+    }
+    player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    // CONTROLLABLE is cleared during ordinary walking/cycling and can stay
+    // clear after stopping. A live player retains its concrete locomotion flag.
+    if (!player->active || !player->isPlayer
+        || !(gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_ON_FOOT | PLAYER_AVATAR_FLAG_MACH_BIKE
+                                   | PLAYER_AVATAR_FLAG_ACRO_BIKE | PLAYER_AVATAR_FLAG_SURFING
+                                   | PLAYER_AVATAR_FLAG_UNDERWATER)))
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_AVATAR;
+        return;
+    }
+
+    PlayerGetDestCoords(&x, &y);
+    x -= MAP_OFFSET;
+    y -= MAP_OFFSET;
+    facing = GetPlayerFacingDirection();
+    // Connection/warp boundary frames can temporarily lie outside the new map.
+    if (x < 0 || y < 0 || x >= layout->width || y >= layout->height
+        || facing < DIR_SOUTH || facing > DIR_EAST)
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_POSITION;
+        return;
+    }
+    if (IsMapTypeOutdoors(gMapHeader.mapType))
+        snapshot->flags |= TAICHUNG_NAVIGATION_OUTDOOR;
+    else if (gMapHeader.mapType == MAP_TYPE_INDOOR || gMapHeader.mapType == MAP_TYPE_UNDERGROUND
+             || gMapHeader.mapType == MAP_TYPE_SECRET_BASE)
+        snapshot->flags |= TAICHUNG_NAVIGATION_INDOOR;
+    else
+    {
+        snapshot->contextFlags |= TAICHUNG_NAVIGATION_CONTEXT_INVALID_MAP;
+        return;
+    }
+    snapshot->localX = x;
+    snapshot->localY = y;
+    snapshot->mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    snapshot->mapNum = gSaveBlock1Ptr->location.mapNum;
+    snapshot->facing = facing;
+    snapshot->mapType = gMapHeader.mapType;
+    snapshot->mapWidth = layout->width;
+    snapshot->mapHeight = layout->height;
+    snapshot->flags |= TAICHUNG_NAVIGATION_POSITION_VALID;
+    if (TestPlayerAvatarFlags(PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE))
+        snapshot->flags |= TAICHUNG_NAVIGATION_CYCLING;
+    if (TaichungCanToggleBike())
+        snapshot->flags |= TAICHUNG_NAVIGATION_CAN_TOGGLE_BIKE;
+}
+
+void TaichungNavigationBridge_Tick(bool8 gameCallbacksRan)
+{
+    volatile struct TaichungNavigationBridge *packet = &gTaichungNavigationBridge;
+    struct TaichungNavigationBridge snapshot = {0};
+    bool8 field = Overworld_IsMainFieldCallback();
+    u32 sequence = 1;
+    u32 frame = 1;
+
+    if (packet->magicA == TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A
+        && packet->magicB == TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B
+        && packet->version == TAICHUNG_NAVIGATION_BRIDGE_VERSION
+        && packet->size == TAICHUNG_NAVIGATION_BRIDGE_SIZE
+        && packet->selfGbaAddress == (u32)packet)
+    {
+        sequence = (packet->sequence & ~1u) + 1;
+        frame = packet->frameCounter + 1;
+        if (frame == 0)
+            frame = 1;
+    }
+    snapshot.flags = field ? TAICHUNG_NAVIGATION_FIELD : 0;
+    snapshot.localX = -1;
+    snapshot.localY = -1;
+    snapshot.mapGroup = 0xFF;
+    snapshot.mapNum = 0xFF;
+    snapshot.contextFlags = GetHiddenContext(gameCallbacksRan, field);
+    if (field && !(snapshot.contextFlags & TAICHUNG_NAVIGATION_CONTEXT_INVALID_SAVE))
+        snapshot.flags |= TAICHUNG_NAVIGATION_READY;
+    if (snapshot.contextFlags == 0)
+        ReadFieldPosition(&snapshot);
+
+    // Every shared write is volatile and sequenced between odd/even markers.
+    // The browser must reread sequence after copying and reject a changed value.
+    packet->sequence = sequence;
+    packet->magicA = TAICHUNG_NAVIGATION_BRIDGE_MAGIC_A;
+    packet->magicB = TAICHUNG_NAVIGATION_BRIDGE_MAGIC_B;
+    packet->version = TAICHUNG_NAVIGATION_BRIDGE_VERSION;
+    packet->size = TAICHUNG_NAVIGATION_BRIDGE_SIZE;
+    packet->selfGbaAddress = (u32)packet;
+    packet->frameCounter = frame;
+    packet->flags = snapshot.flags;
+    packet->localX = snapshot.localX;
+    packet->localY = snapshot.localY;
+    packet->mapGroup = snapshot.mapGroup;
+    packet->mapNum = snapshot.mapNum;
+    packet->facing = snapshot.facing;
+    packet->mapType = snapshot.mapType;
+    packet->mapWidth = snapshot.mapWidth;
+    packet->mapHeight = snapshot.mapHeight;
+    packet->contextFlags = snapshot.contextFlags;
+    packet->reserved16 = 0;
+    packet->reserved32 = 0;
+    sequence++;
+    packet->sequence = sequence == 0 ? 2 : sequence;
+}
