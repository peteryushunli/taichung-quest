+// Chinese glyphs are 12x14 bitmap cells. Each one is drawn with the FireRed
+// text shadow (one pixel right, below and diagonally) and advances 13 pixels,
+// leaving a one-pixel gap so neighbouring characters do not touch.
+#define TAICHUNG_CJK_ADVANCE 13
+
+static void DecompressGlyph_TaichungRows(const u16 *rows)
+{
+    u32 x, y;
+    u32 offset;
+    u32 here, left, above, aboveLeft;
+    u8 color;
+    u8 bg = GetLastTextColor(2);
+    u8 fg = GetLastTextColor(0);
+    u8 shadow = GetLastTextColor(1);
+    memset(gGlyphInfo.pixels, bg | (bg << 4), sizeof(gGlyphInfo.pixels));
+    for (y = 0; y < 14; y++)
+    {
+        for (x = 0; x < TAICHUNG_CJK_ADVANCE; x++)
+        {
+            here = x < 12 && (rows[y] & (1 << x));
+            left = x > 0 && (rows[y] & (1 << (x - 1)));
+            above = y > 0 && x < 12 && (rows[y - 1] & (1 << x));
+            aboveLeft = y > 0 && x > 0 && (rows[y - 1] & (1 << (x - 1)));
+            if (here)
+                color = fg;
+            else if (left || above || aboveLeft)
+                color = shadow;
+            else
+                continue;
+            offset = ((y / 8) * 2 + x / 8) * 32 + (y % 8) * 4 + (x % 8) / 2;
+            if (x & 1)
+                gGlyphInfo.pixels[offset] = (gGlyphInfo.pixels[offset] & 0x0F) | (color << 4);
+            else
+                gGlyphInfo.pixels[offset] = (gGlyphInfo.pixels[offset] & 0xF0) | color;
+        }
+    }
+    gGlyphInfo.width = TAICHUNG_CJK_ADVANCE;
+    gGlyphInfo.height = 14;
+}
+
+static void DecompressGlyph_Taichung(u16 glyphId)
+{
+    if (glyphId >= ARRAY_COUNT(sTaichungChineseGlyphs))
+        glyphId = 0;
+    DecompressGlyph_TaichungRows(sTaichungChineseGlyphs[glyphId]);
+}
+
+// ！？。 share FireRed's Latin bytes with English text. Right after a Chinese
+// glyph (FC 19 lo hi; lo and hi are 1-240 so never FC) they use full-width rows.
+static bool32 TaichungFollowsCjk(const u8 *punctuation)
+{
+    return punctuation[-4] == EXT_CTRL_CODE_BEGIN && punctuation[-3] == EXT_CTRL_CODE_TAICHUNG_CJK;
+}
+
+static bool32 TaichungIsCjkPunctuation(u16 c)
+{
+    return c == CHAR_EXCL_MARK || c == CHAR_QUESTION_MARK || c == CHAR_PERIOD;
+}
