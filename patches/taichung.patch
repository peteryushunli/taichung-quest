+def put_encounter(encounters, mid, entry, after="MAP_TAICHUNG_OLD_CITY"):
+    """One map's table set to entry (in its place, or right after `after`'s), or removed when
+    entry is None."""
+    out = copy.deepcopy(encounters)
+    for group in out["wild_encounter_groups"]:
+        rows = group["encounters"]
+        at = next((i for i, e in enumerate(rows) if e["map"] == mid), None)
+        if at is not None and entry is None:
+            del rows[at]
+        elif at is not None:
+            rows[at] = entry
+        elif entry is not None:
+            at = next((i for i, e in enumerate(rows) if e["map"] == after), None)
+            if at is not None:
+                rows.insert(at + 1, entry)
+    return out
