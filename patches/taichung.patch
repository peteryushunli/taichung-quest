index 0000000..316ca06
--- /dev/null
+++ b/tools/taichung/gym_interiors/install_gyms.py
@@ -0,0 +1,119 @@
+"""Install the ten approved gym rooms and the Wanhe gym move into the native worktree.
+
+- writes each room's layout (and, for the six redrawn rooms, its private tileset)
+- registers the tilesets (graphics.h, metatiles.h, headers.h) and layouts (appended)
+- points each gym map at its room, moves its leader and helper, rebuilds its three exit warps
+- Wanhe Temple hall becomes the gym: Muqing moves in as leader, the temple host stays as helper
+- Maple Garden becomes visit-only: Muqing leaves, its scientist hosts at the centre
+"""
+import json, sys
+from pathlib import Path
+S = Path(__file__).resolve().parent
+sys.path.insert(0, str(S))
+import compile_gyms as C
+
+ROOT = C.NATIVE
+
+
+def dump(path, value):
+    (ROOT / path).write_text(json.dumps(value, indent=2) + '\n')
+
+
+def load(path):
+    return json.loads((ROOT / path).read_text())
+
+
+def register_tileset(n):
+    label = C.tileset_label(n); name = label[len('gTileset_'):]; d = C.tileset_dir(n)
+    gfx = ROOT / 'src/data/tilesets/graphics.h'; mt = ROOT / 'src/data/tilesets/metatiles.h'; hd = ROOT / 'src/data/tilesets/headers.h'
+    g = gfx.read_text()
+    if f'gTilesetTiles_{name}[]' not in g:
+        pals = ''.join(f'    INCBIN_U16("{d}/palettes/{p:02}.gbapal"),\n' for p in range(16))
+        g += (f'\nconst u32 gTilesetTiles_{name}[] = INCBIN_U32("{d}/tiles.4bpp.lz");\n\n'
+              f'const u16 gTilesetPalettes_{name}[][16] =\n{{\n{pals}}};\n')
+        gfx.write_text(g)
+    m = mt.read_text()
+    if f'gMetatiles_{name}[]' not in m:
+        m += (f'\nconst u16 gMetatiles_{name}[] = INCBIN_U16("{d}/metatiles.bin");\n'
+              f'const u32 gMetatileAttributes_{name}[] = INCBIN_U32("{d}/metatile_attributes.bin");\n')
+        mt.write_text(m)
+    h = hd.read_text()
+    if f'{label} =' not in h:
+        h += (f'\nconst struct Tileset {label} =\n{{\n    .isCompressed = TRUE,\n    .isSecondary = TRUE,\n'
+              f'    .tiles = gTilesetTiles_{name},\n    .palettes = gTilesetPalettes_{name},\n'
+              f'    .metatiles = gMetatiles_{name},\n    .metatileAttributes = gMetatileAttributes_{name},\n'
+              f'    .callback = NULL,\n}};\n')
+        hd.write_text(h)
+
+
+def register_layouts(results):
+    data = load('data/layouts/layouts.json')
+    keep = [l for l in data['layouts'] if not str(l.get('id', '')).startswith('LAYOUT_TAICHUNG_GYM_')]
+    for n, res in results.items():
+        keep.append({
+            'id': C.layout_id(n), 'name': C.layout_dir(n) + '_Layout',
+            'width': res['W'], 'height': res['H'], 'border_width': 2, 'border_height': 2,
+            'primary_tileset': res['primary'], 'secondary_tileset': res['secondary'],
+            'border_filepath': f'data/layouts/{C.layout_dir(n)}/border.bin',
+            'blockdata_filepath': f'data/layouts/{C.layout_dir(n)}/map.bin'})
+    data['layouts'] = keep
+    dump('data/layouts/layouts.json', data)
+
+
+def place(obj, xy):
+    obj['x'], obj['y'] = xy
+
+
+def exit_warps(m, ex, res):
+    """Warp 1 is the exit mat (every door lands there). Warps 0 and 2 are landing
+    metadata beside it; where the mat has no open floor beside it (the park's
+    one-tile stair) they sit on the open cells just above it instead."""
+    old = m['warp_events']
+    assert len(old) == 3 and len({(w['dest_map'], w['dest_warp_id']) for w in old}) == 1, m['id']
+    W, H, words = res['W'], res['H'], res['words']
+    open_ = lambda x, y: 0 <= x < W and 0 <= y < H and not (words[y * W + x] >> 10) & 3
+    x, y = ex
+    sides = [(x - 1, y), (x + 1, y)] if open_(x - 1, y) and open_(x + 1, y) else [(x, y - 1), (x, y - 2)]
+    assert all(open_(*c) for c in sides), (m['id'], sides)
+    cells = [sides[0], (x, y), sides[1]]
+    m['warp_events'] = [dict(old[i], x=cells[i][0], y=cells[i][1]) for i in range(3)]
+
+
+def wire(results):
+    for n, res in results.items():
+        folder = C.GYMS[n][0]; path = f'data/maps/{folder}/map.json'; m = load(path); meta = res['meta']
+        m['layout'] = C.layout_id(n)
+        exit_warps(m, meta['exit'], res)
+        if n == 'wanhe':
+            maple = load('data/maps/TaichungMapleGarden_Gym/map.json')
+            muqing = [o for o in maple['object_events'] if o['graphics_id'] == 'OBJ_EVENT_GFX_TAICHUNG_MUQING']
+            if muqing:   # first install: Muqing moves here from Maple Garden
+                muqing = dict(muqing[0], local_id='LOCALID_TAICHUNG_WANHE_TEMPLE_GYM_HOST')
+                host = m['object_events'][0]
+                m['object_events'] = [muqing, host]
+                maple['object_events'] = [o for o in maple['object_events'] if o['graphics_id'] != 'OBJ_EVENT_GFX_TAICHUNG_MUQING']
+                place(maple['object_events'][0], (6, 5))
+                maple['music'] = 'MUS_FUCHSIA'
+                dump('data/maps/TaichungMapleGarden_Gym/map.json', maple)
+            m['music'] = 'MUS_GYM'
+        objs = m['object_events']
+        assert len(objs) == 2, (n, len(objs))
+        place(objs[0], meta['leader']); place(objs[1], meta['staff'])
+        dump(path, m)
+
+
+def main():
+    results = {}
+    for n in C.GYMS:
+        res = C.compile_room(n); C.write(res, ROOT); results[n] = res
+        if res['packer']:
+            register_tileset(n)
+    register_layouts(results)
+    wire(results)
+    for n, res in results.items():
+        pk = res['packer']
+        print(n, C.layout_id(n), res['W'], 'x', res['H'], res['secondary'], '' if not pk else f'tiles {len(pk.tiles)} metatiles {len(pk.specs)}')
+
+
+if __name__ == '__main__':
+    main()
