index 0000000..3f74f73
--- /dev/null
+++ b/tests/test_gym_staff_guard.py
@@ -0,0 +1,322 @@
+#!/usr/bin/env python3
+"""Exercise real non-no-op corruption at the registered staff/cache boundary."""
+from copy import deepcopy
+import ast
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+import unittest
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+BASE_GUARDS = '9aad495d855ba07b2e1b3e265cfc8cf7ab732cc3'
+# The city guards plus exactly the reviewed plaza tutorial onboarding profile (parent: the city).
+TUTORIAL_GUARD = 'c5ce8f5ebf74a68c33679f19912ffe59bcfcaed7'
+spec = importlib.util.spec_from_file_location('staff_guard_under_test', ROOT / 'tools/taichung/check_gym_staff.py')
+guard = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(guard)
+
+
+def encoded(value):
+    return (json.dumps(value, indent=2) + '\n').encode()
+
+
+def historical(path, revision=BASE_GUARDS):
+    return subprocess.check_output(['git', 'show', revision + ':' + path], cwd=ROOT)
+
+
+class StaffGuardTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.proof = guard.check(ROOT)
+        if not cls.proof['passed']:
+            raise AssertionError(cls.proof['errors'])
+        cls.reject_count = 0
+        # With the registered city rework the staff increment sits on the city, not BASE.
+        cls.city = bool(cls.proof.get('cityRework'))
+        cls.under = guard.CITY if cls.city else guard.BASE
+        cls.delegate = (guard.DELEGATE_CITY if cls.city else guard.DELEGATE_V9).encode()
+
+    def rejected(self, edits, gate=None):
+        for path, value in edits.items():
+            self.assertNotEqual(value, (ROOT / path).read_bytes(), 'No-op mutation: ' + path)
+        proof = guard.check(ROOT, edits)
+        self.assertTrue(proof['active'])
+        self.assertFalse(proof['passed'], edits.keys())
+        if gate:
+            self.assertFalse(proof['checks'][gate]['passed'], proof['errors'])
+        type(self).reject_count += 1
+
+    def test_actual_five_room_positive_and_resolved_scripts(self):
+        self.assertTrue(self.proof['active'])
+        self.assertEqual(len(self.proof['maps']), 5)
+        self.assertEqual(len(self.proof['checks']['authoredAndFallbackGeometry']['nativeCases']), 10)
+        self.assertEqual(guard.header_underneath((ROOT / guard.HEADER).read_bytes(), self.proof), historical(guard.HEADER, self.under))
+        # Script dependencies are reported, not silently converted to acceptance.
+        self.assertTrue(self.proof['scriptDependencies']['resolved'])
+        self.assertEqual(guard.save_underneath((ROOT / guard.SAVE).read_bytes(), self.proof), historical(guard.SAVE, self.under))
+        if self.city:
+            # Guards frozen at v9 read save_v10.py's peeled pair, the polish's own: it strips to BASE.
+            for path, strip in ((guard.HEADER, guard.header_underneath), (guard.SAVE, guard.save_underneath)):
+                self.assertEqual(strip(historical(path, guard.API), self.proof), historical(path, guard.BASE))
+
+    def test_verified_underlay_forwards_nonstaff_edits(self):
+        path = 'data/layouts/TaichungXitun/map.bin'
+        raw = (ROOT / path).read_bytes()
+        changed = bytes([raw[0] ^ 1]) + raw[1:]
+        edits = {path: changed, 'data/scripts/Forwarded.inc': b'Forwarded::\n\tend\n'}
+        forwarded = guard.legacy_overrides(ROOT, self.proof, edits)
+        self.assertEqual(set(forwarded), set(edits) | set(guard.MAP_PATHS))
+        for name, value in edits.items():
+            self.assertIs(forwarded[name], value)
+        for name in guard.MAP_PATHS:
+            self.assertEqual(forwarded[name], historical(name, guard.BASE))
+        damaged = deepcopy(self.proof); damaged['passed'] = False
+        with self.assertRaises(ValueError):
+            guard.legacy_overrides(ROOT, damaged, edits)
+        result = guard.check_final_xitun(ROOT, {path: changed})
+        self.assertFalse(result['passed'])
+        self.assertTrue(result['registeredStaff']['currentProofPassed'])
+        self.assertEqual(result['registeredStaff']['forwardedOverridePaths'], [path])
+        self.assertEqual(set(result['registeredStaff']['substitutedMaps']), set() if self.city else set(guard.MAP_PATHS))
+
+    def test_nested_current_guard_reproves_projection(self):
+        path = 'data/layouts/TaichungXitun/map.bin'
+        original = {path: (ROOT / path).read_bytes()}
+        view = guard.legacy_overrides(ROOT, self.proof, original)
+        self.assertEqual(guard.current_overrides(ROOT, view), original)
+        changed = guard.legacy_overrides(ROOT, self.proof, original)
+        changed[guard.MAP_PATHS[0]] += b'\n'
+        with self.assertRaises(ValueError):
+            guard.current_overrides(ROOT, changed)
+        changed = guard.legacy_overrides(ROOT, self.proof, original)
+        changed['data/scripts/Unforwarded.inc'] = b'Unreviewed::\n\tend\n'
+        with self.assertRaises(ValueError):
+            guard.current_overrides(ROOT, changed)
+        changed = guard.legacy_overrides(ROOT, self.proof, original)
+        damaged = deepcopy(self.proof['maps'][guard.MAP_PATHS[0]]['after'])
+        damaged['warp_events'][0]['x'] += 1
+        changed._staff_actual_overrides[guard.MAP_PATHS[0]] = encoded(damaged)
+        with self.assertRaises(ValueError):
+            guard.current_overrides(ROOT, changed)
+        # An ordinary deletion/corruption override has no projection privilege.
+        plain = {guard.MAP_PATHS[0]: historical(guard.MAP_PATHS[0], guard.BASE)}
+        self.assertIs(guard.current_overrides(ROOT, plain), plain)
+        self.assertFalse(guard.check(ROOT, plain)['passed'])
+
+    def test_each_current_room_verified_before_substitution(self):
+        for path in guard.MAP_PATHS:
+            original = json.loads((ROOT / path).read_bytes())
+            variants = []
+            changed = deepcopy(original); changed['object_events'].append(deepcopy(changed['object_events'][-1])); variants.append(changed)
+            changed = deepcopy(original); changed['music'] = 'MUS_PALLET'; variants.append(changed)
+            changed = deepcopy(original); changed['warp_events'][0]['x'] += 1; variants.append(changed)
+            for index, changed in enumerate(variants):
+                with self.subTest(map=path, variant=index):
+                    result = guard.check_final_xitun(ROOT, {path: encoded(changed)})
+                    self.assertFalse(result['passed'])
+                    self.assertFalse(result['registeredStaff']['currentProofPassed'])
+                    self.assertEqual(result['registeredStaff']['substitutedMaps'], [])
+        path = 'data/layouts/TaichungLandmarkGym/map.bin'
+        raw = (ROOT / path).read_bytes()
+        result = guard.check_final_xitun(ROOT, {path: bytes([raw[0] ^ 1]) + raw[1:]})
+        self.assertFalse(result['passed'])
+        self.assertEqual(result['registeredStaff']['substitutedMaps'], [])
+
+    def test_current_final_xitun_wrapper_positive(self):
+        result = guard.check_final_xitun(ROOT)
+        self.assertTrue(result['passed'], result['errors'])
+        # With the city, FinalXitun reads the staff rooms through the staff proof itself.
+        self.assertEqual(result['registeredStaff']['rawGuardModified'], self.city)
+        self.assertEqual(set(result['registeredStaff']['substitutedMaps']), set() if self.city else set(guard.MAP_PATHS))
+
+    def test_script_dependencies_require_reachable_unique_labels(self):
+        path = 'data/scripts/staff_guard_test.inc'
+        bodies = ''.join('TaichungHistory_Staff' + script + '::\n\tend\n' for _, _, _, script in guard.ROOMS).encode()
+        # A parser-only fixture must not inherit the real installed labels.
+        # Actual content resolution is asserted separately on the current tree.
+        entry = 'data/event_scripts.s'
+        edits = {path: bodies, entry: b'@ Isolated dependency-parser fixture.\n'}
+        self.assertFalse(guard.script_dependencies(guard.Files(ROOT, overrides=edits))['resolved'])
+        edits[entry] += ('\n\t.include "' + path + '"\n').encode()
+        self.assertTrue(guard.script_dependencies(guard.Files(ROOT, overrides=edits))['resolved'])
+        edits[path] += b'TaichungHistory_StaffMiyahara::\n\tend\n'
+        result = guard.script_dependencies(guard.Files(ROOT, overrides=edits))
+        self.assertFalse(result['resolved'])
+        self.assertIn('TaichungHistory_StaffMiyahara', result['missingOrDuplicate'])
+
+    def test_each_actor_field_and_structure(self):
+        changes = dict(local_id='UNAPPROVED_ID', type='clone', graphics_id='OBJ_EVENT_GFX_RED',
+                       x=4, y=10, elevation=0, movement_type='MOVEMENT_TYPE_WANDER_AROUND',
+                       movement_range_x=1, movement_range_y=1, trainer_type='TRAINER_TYPE_NORMAL',
+                       trainer_sight_or_berry_tree_id='1', script='UNAPPROVED_SCRIPT', flag='FLAG_0x001')
+        for path in guard.MAP_PATHS:
+            original = json.loads((ROOT / path).read_bytes())
+            name = original['name']
+            before = self.proof['maps'][path]['before']
+            self.assertTrue(guard.matches_map(before, original, name, self.proof))
+            for field, value in changes.items():
+                with self.subTest(map=name, field=field):
+                    changed = deepcopy(original); changed['object_events'][-1][field] = value
+                    self.assertFalse(guard.matches_map(before, changed, name, self.proof))
+                    self.rejected({path: encoded(changed)}, 'registrationAndExactMapDelta')
