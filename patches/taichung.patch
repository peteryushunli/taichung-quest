diff --git a/data/taichung/landmarks/maple-garden/encode_candidate.py b/data/taichung/landmarks/maple-garden/encode_candidate.py
new file mode 100644
index 0000000..ec14625
--- /dev/null
+++ b/data/taichung/landmarks/maple-garden/encode_candidate.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Deterministic whole-park format conversion; no semantic collision or map install."""
+import argparse
+import colorsys
+import hashlib
+import json
+import math
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ART = PROJECT / 'artifacts/worktrees/c291d4842985/landmark-art'
+SOURCE = ART / 'maple-garden-study-v1.png'
+REGIONS = {
+    'pavilionGlazedEntranceBand': [272, 631, 600, 744],
+    'possibleCentralGlassDoorPanels': [374, 640, 496, 732],
+    'southFrontPathAndStairs': [654, 892, 824, 1001],
+}
+
+
+def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def flip(pixels, h=False, v=False):
+    return tuple(pixels[(7-y if v else y)*8 + (7-x if h else x)] for y in range(8) for x in range(8))
+
+
+def family(rgb):
+    h,s,v=colorsys.rgb_to_hsv(*(c/255 for c in rgb))
+    if v>.64 and s<.28:return 'cream-path-or-concrete'
+    if .44<=h<=.65 and s>.16:return 'water-or-building-glazing'
+    if .15<=h<.44 and s>.2:return 'greens-lawn-or-trees'
+    if (h<.08 or h>.86) and s>.25:return 'red-bridge-or-planting'
+    if v<.34:return 'dark-building-frame-wood-or-shadows'
+    return 'neutral-building-wood-or-planting'
+
+
+def encode(source, output, target=(192,128), threshold=224, step=2, bank=8):
+    output.mkdir(parents=True,exist_ok=True)
+    original=sha(source);rgba=Image.open(source).convert('RGBA')
