+#!/usr/bin/env python3
+"""Provenance, fail-closed qualification and unchanged-profile composition."""
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location("compact_story_under_test", ROOT / "tools/taichung/compact_story_guard.py")
+story = importlib.util.module_from_spec(spec); spec.loader.exec_module(story)
+
+
+def git(*args):
+    return subprocess.check_output(["git", *args], cwd=ROOT)
+
+
+class CompactStoryGuard(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.read = staticmethod(story.reader(ROOT))
+        cls.record = story.load(cls.read)
+        cls.stored = story.bundle(cls.read, cls.record)
+
+    def test_exact_scope_and_committed_input_provenance(self):
+        r = self.record
+        changes = [line.split("\t") for line in git("diff", "--name-status", story.BASE, story.FEATURE).decode().splitlines()]
+        self.assertEqual({p for status, p in changes if status == "M"}, set(r["edited"]))
+        self.assertEqual({p for status, p in changes if status == "A"}, set(r["added"]))
+        self.assertEqual((len(r["edited"]), len(r["added"])), (7, 37))
+        for path, row in r["edited"].items():
+            self.assertEqual(self.stored["before/" + path], git("show", story.BASE + ":" + path), path)
+            self.assertEqual(story.sha(git("show", story.FEATURE + ":" + path)), row["after"], path)
+        for path, expected in {**r["added"], **r["dependencies"]}.items():
+            self.assertEqual(story.sha(git("show", story.FEATURE + ":" + path)), expected, path)
+        for path in r["dependencies"]:
+            self.assertEqual(self.read(path), git("show", story.BASE + ":" + path), path)
+        for path in (story.CHARMAP, story.GLYPHS):
+            self.assertEqual(self.stored["prefix857/" + path], git("show", r["prefix857Commit"] + ":" + path))
+        for path in ("data/maps", "data/layouts", "data/tilesets", "graphics", "src/taichung_save.c",
+                     "src/taichung_encounter.c", "src/taichung_encounter_bridge.c", "src/taichung_encounter_field.c"):
+            self.assertEqual(git("rev-parse", story.BASE + ":" + path), git("rev-parse", story.FEATURE + ":" + path), path)
+
+    def test_all_existing_guard_bytes_profiles_and_probes_unchanged(self):
+        # Whole original programs/tests/registrations are immutable. This is
+        # stronger than comparing just selected assertions or self-test bodies.
+        paths = ("tools/taichung/capture_release_guard.py", "tools/taichung/gym_interiors_guard.py",
+                 "tools/taichung/home_start.py", "tools/taichung/approved_art_guard.py",
+                 "tools/taichung/capture_gameplay_guard.py", "tools/taichung/encounter_field_fix_guard.py",
+                 "tools/taichung/encounter_save_init_guard.py", "tests/test_capture_release_guard.py",
+                 "tools/taichung_gameplay/test-capture-release.py", "data/taichung/gym-interiors/manifest.json",
+                 "data/taichung/capture-release/registration.json", "data/taichung/capture-release/baseline.zip",
+                 "data/taichung/capture-gameplay-guard/registration.json",
+                 "data/taichung/encounter-field-fix/registration.json",
+                 "data/taichung/encounter-save-init/registration.json")
+        for path in paths:
+            self.assertEqual(self.read(path), git("show", story.BASE + ":" + path), path)
+
+    def test_portable_proof_runs_before_any_baseline_substitution(self):
+        with patch("subprocess.run", side_effect=AssertionError("No processes allowed")), \
+             patch("subprocess.check_output", side_effect=AssertionError("No Git allowed")):
+            self.assertTrue(story.check(ROOT)["passed"])
+        before = story.peel(self.read)
+        self.assertEqual(set(before), set(self.record["edited"]))
+        self.assertFalse(any(p.startswith(("data/maps/", "data/layouts/", "data/tilesets/", "graphics/")) for p in before))
+        absent = story.hidden(self.read)
+        self.assertEqual(absent, set(self.record["added"]) | {story.REGISTRATION, story.BUNDLE})
+        self.assertTrue(all((ROOT / path).is_file() for path in absent))
+        with patch.object(story, "semantics", side_effect=AssertionError("Must reject inputs first")):
+            damaged = {"src/taichung_optional_story.c": self.read("src/taichung_optional_story.c") + b"\nchanged"}
+            self.assertFalse(story.check(ROOT, damaged)["passed"])
+            with self.assertRaises(ValueError):
+                with story.qualified_mirror(ROOT, damaged):
+                    self.fail("Corrupted source produced a historical view")
+
+    def test_qualified_mirror_preserves_foreign_inputs_and_original_profiles(self):
+        foreign = {"src/compact_story_foreign.c": b"int unregistered_runtime;\n",
+                   "data/taichung/optional-story/foreign.json": b'{"unregistered": true}\n',
+                   "data/scripts/compact_story_foreign.inc": b"ForeignStory::\n\tend\n"}
+        with story.qualified_mirror(ROOT, foreign) as view:
+            self.assertFalse(story.active(story.reader(view)))
+            for path, raw in foreign.items():
+                self.assertEqual((view / path).read_bytes(), raw)
+            for path in self.record["edited"]:
+                self.assertEqual((view / path).read_bytes(), self.stored["before/" + path])
+            for path in story.hidden(self.read):
+                self.assertFalse((view / path).exists(), path)
+            release_spec = importlib.util.spec_from_file_location("old_capture_in_story_view", view / "tools/taichung/capture_release_guard.py")
+            release = importlib.util.module_from_spec(release_spec); release_spec.loader.exec_module(release)
+            self.assertTrue(release.check(view)["passed"])
+            self.assertTrue((view / ".git").is_file())
+            self.assertFalse((view / "build").exists())
+            for path in ("tests/test_capture_release_guard.py", "tools/taichung/gym_interiors_guard.py"):
+                self.assertEqual((view / path).resolve(), view / path)
+                self.assertEqual((view / path).read_bytes(), self.read(path))
+            # The unmodified provenance test resolves __file__; the unmodified
+            # gym self-test uses Git's real working-tree file types. Exercise
+            # both against the concrete view instead of disabling either check.
+            for command in (("tests/test_capture_release_guard.py",),
+                            ("tools/taichung/gym_interiors_guard.py", "--self-test")):
+                result = subprocess.run([sys.executable, "-B", *command], cwd=view, capture_output=True, text=True)
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        # An actual foreign battle change cannot yield a historical view.
+        path = "src/battle_main.c"
+        with self.assertRaises(ValueError):
+            with story.qualified_mirror(ROOT, {path: self.read(path) + b"\nforeign battle change"}):
+                self.fail("Battle change was hidden")
+
+    def test_original_baseline_absent_but_partial_story_rejected(self):
+        old = {path: self.stored["before/" + path] for path in self.record["edited"]}
+        old.update({path: None for path in self.record["added"]})
+        old.update({story.REGISTRATION: None, story.BUNDLE: None})
+        self.assertEqual(story.check(ROOT, old), dict(passed=True, active=False))
+        self.assertEqual(story.peel(story.reader(ROOT, old)), {})
+        self.assertEqual(story.hidden(story.reader(ROOT, old)), set())
+        self.assertFalse(story.check(ROOT, {story.REGISTRATION: None})["passed"])
+        self.assertFalse(story.check(ROOT, {"data/scripts/taichung_optional_story_bindings.inc": None})["passed"])
+        for path in self.record["edited"]:
+            self.assertFalse(story.check(ROOT, {**old, path: self.read(path)})["passed"], path)
+
+    def test_every_single_orphan_rejects_public_apis_and_default_cli(self):
+        old = {path: self.stored["before/" + path] for path in self.record["edited"]}
+        old.update({path: None for path in self.record["added"]})
+        old.update({story.REGISTRATION: None, story.BUNDLE: None})
+        self.assertEqual(set(story.INTRODUCED_INPUTS), set(self.record["added"]))
+        with story.qualified_mirror(ROOT) as view:
+            command = [sys.executable, "-B", str(view / "tools/taichung/compact_story_guard.py")]
+            baseline = subprocess.run(command, cwd=view, capture_output=True, text=True)
+            self.assertEqual(baseline.returncode, 0, baseline.stdout + baseline.stderr)
+            self.assertEqual(json.loads(baseline.stdout), dict(passed=True, active=False))
+            for path in self.record["added"]:
+                edits = {**old, path: self.read(path)}
+                read = story.reader(ROOT, edits)
+                self.assertTrue(story.active(read), path)
+                self.assertFalse(story.check(ROOT, edits)["passed"], path)
+                for api in (story.peel, story.hidden):
+                    with self.assertRaises(FileNotFoundError, msg=path):
+                        api(read)
+                orphan = view / path
+                orphan.parent.mkdir(parents=True, exist_ok=True)
+                orphan.write_bytes(self.read(path))
+                result = subprocess.run(command, cwd=view, capture_output=True, text=True)
+                orphan.unlink()
+                self.assertEqual(result.returncode, 1, path + result.stdout + result.stderr)
+                report = json.loads(result.stdout)
+                self.assertFalse(report["passed"], path)
+                self.assertIn(story.REGISTRATION, report["errors"][0], path)
+
+    def test_all_real_corruptions_rejected(self):
+        report = story.self_test(ROOT)
+        self.assertTrue(report["passed"])
+        self.assertGreaterEqual(len(report["rejectedCorruptionProbes"]), 70)
+        self.assertTrue(all(report["rejectedCorruptionProbes"].values()))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
