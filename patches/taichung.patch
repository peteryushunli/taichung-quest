+#!/usr/bin/env python3
+"""Installable OldCity scene compiler: protected General slots plus shared art.
+
+Writes only the assigned feature checkout. Global General/Pewter stay immutable.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+from PIL import Image
+
+ROOT=Path(__file__).resolve().parents[3]
+sys.dont_write_bytecode=True
+sys.path.insert(0,str(ROOT/'tools/taichung/streetscape'))
+from color_compile import compile_colorways
+
+DATA=ROOT/'data/taichung/landmarks/old-core-native'
+PRIMARY=ROOT/'data/tilesets/primary/taichung_old_core'
+SECONDARY=ROOT/'data/tilesets/secondary/taichung_old_core'
+GENERAL=ROOT/'data/tilesets/primary/general'
+PEWTER=ROOT/'data/tilesets/secondary/pewter_city'
+
+
+def words(path,kind='H'):
+    raw=path.read_bytes();return list(struct.unpack(f'<{len(raw)//struct.calcsize(kind)}{kind}',raw))
+
+
+def write_words(path,values,kind='H'):
+    path.write_bytes(struct.pack(f'<{len(values)}{kind}',*values))
+
+
+def flip(p,f):
+    return tuple(p[(7-y if f&0x800 else y)*8+(7-x if f&0x400 else x)] for y in range(8) for x in range(8))
+
+
+def pixels(image,n):
+    x,y=n%(image.width//8)*8,n//(image.width//8)*8
+    return tuple(image.getpixel((x+dx,y+dy)) for dy in range(8) for dx in range(8))
+
+
+def canonical(p):
+    return min((flip(p,f),f) for f in (0,0x400,0x800,0xc00))
+
+
+class Scene:
+    def __init__(self,audit):
+        self.original=Image.open(GENERAL/'tiles.png')
+        self.primary=self.original.copy()
+        free=audit['primaryConservativeRawHoleOption']['freeRawGraphicIds']
+        self.free=iter(free)
+        self.reserved=set(range(640))-set(free)
+        self.lookup={};self.secondary=[];self.allocated=[]
+        animated=set(range(416,482))|set(range(508,512))
+        for n in sorted(self.reserved-animated):
+            p,f=canonical(pixels(self.original,n))
+            self.lookup.setdefault(p,(n,f))
+
+    def pack(self,p):
+        p,f=canonical(p)
+        if p not in self.lookup:
+            n=next(self.free,None)
+            if n is None:
+                if len(self.secondary)>=376:raise ValueError('Scene graphics exhausted')
+                n=640+len(self.secondary);self.secondary.append(p)
+            else:
+                for y in range(8):
+                    for x in range(8):self.primary.putpixel((n%16*8+x,n//16*8+y),p[y*8+x])
+            self.lookup[p]=(n,0);self.allocated.append(n)
+        n,stored=self.lookup[p]
+        assert n<1016
+        return n|(stored^f)
+
+
+def compile_scene(infill=False):
+    DATA.mkdir(parents=True,exist_ok=True)
+    audit=json.loads((ROOT/'data/taichung/landmarks/old-core-bank-audit.json').read_text())
+    scene=Scene(audit)
+    kit=compile_colorways(variant_metatile_start=815)
+    definitions=[]
+    for group in kit['metatiles']:
+        row=[]
+        for e in group:
+            n=e&1023
+            row.append(e if n<640 else (e&0xf000)|((e&0xc00)^scene.pack(kit['graphics'][n-640])))
+        definitions.append(row)
+    attrs=kit['attributes'][:]
+    # Keep the legacy civic definitions used in any connected baseline scene,
+    # including the two stair/door-surround definitions outside the prefab kit.
+    retained=json.loads((ROOT/'data/taichung/landmarks/old-station/native-source-contract.json').read_text())['preservedSourceMetatiles']
+    original_defs=words(PEWTER/'metatiles.bin');original_attrs=words(PEWTER/'metatile_attributes.bin','I')
+    original_sheet=Image.open(PEWTER/'tiles.png')
+    for tile in retained:
+        group=[]
+        for e in original_defs[(tile-640)*8:(tile-639)*8]:
+            n=e&1023
+            group.append(e if n<640 else (e&0xf000)|((e&0xc00)^scene.pack(pixels(original_sheet,n-640))))
+        definitions[tile-640]=group;attrs[tile-640]=original_attrs[tile-640]
+    grid=words(DATA/'baseline-map.bin')
+    art_specs=[('old-station','native.png',(26,57),(32,64),719),
+               ('miyahara','candidate-v2/candidate-indexed.png',(15,45),(20,52),None),
+               ('taichung-park','candidate/candidate-indexed.png',(26,23),(32,30),None)]
+    grass=words(GENERAL/'metatiles.bin')[8:12]
+    def paint(x,y,w):grid[y*40+x]=w
+    # Clear obsolete facade words before transparency exposes the visitor plazas.
+    for x0,y0,x1,y1 in [(15,46,25,52),(27,24,37,30)]:
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):paint(x,y,0x3175)
+    info=[]
+    for identity,name,origin,door,fixed in art_specs:
+        path=ROOT/'data/taichung/landmarks'/identity/name
+        art=Image.open(path)
+        assert art.mode=='P' and art.getextrema()[1]<=15
+        station=Image.open(ROOT/'data/taichung/landmarks/old-station/native.png')
+        assert art.getpalette()[:48]==station.getpalette()[:48],identity
+        w,h=art.width//16,art.height//16;occupied=[];mapping={}
+        for y in range(h):
+            for x in range(w):
+                ink=any(art.getpixel((x*16+dx,y*16+dy)) for dy in range(16) for dx in range(16))
+                if fixed is None and not ink:continue
+                top=[scene.pack(pixels(art,(y*2+dy)*(art.width//8)+x*2+dx))|0x7000 for dy in range(2) for dx in range(2)]
+                entries=grass+top;attr=0x20000000 if y==h-1 else 0
+                if fixed is not None:
+                    tile=fixed+y*w+x;definitions[tile-640]=entries;attrs[tile-640]=attr
+                else:
+                    tile=640+len(definitions);definitions.append(entries);attrs.append(attr)
+                mapping[f'{x},{y}']=tile
+                if ink:
+                    paint(origin[0]+x,origin[1]+y,tile|0x400);occupied.append([origin[0]+x,origin[1]+y])
+        paint(*door,0x043d)
+        info.append(dict(id=identity,input=str(path.relative_to(ROOT)),inputSha256=hashlib.sha256(path.read_bytes()).hexdigest(),
+                         origin=list(origin),size=[w,h],door=list(door),occupiedCells=occupied,localMetatileIds=mapping))
+    assert len(definitions)<=384
+    for group in definitions:
+        for e in group:assert e&1023<1016 and e>>12<13
+    PRIMARY.mkdir(parents=True,exist_ok=True);SECONDARY.mkdir(parents=True,exist_ok=True)
+    scene.primary.save(PRIMARY/'tiles.png')
+    (PRIMARY/'metatiles.bin').write_bytes((GENERAL/'metatiles.bin').read_bytes())
+    (PRIMARY/'metatile_attributes.bin').write_bytes((GENERAL/'metatile_attributes.bin').read_bytes())
+    sheet=Image.new('P',(128,max(1,(len(scene.secondary)+15)//16)*8));sheet.putpalette(scene.original.getpalette())
+    for n,p in enumerate(scene.secondary):
+        for y in range(8):
+            for x in range(8):sheet.putpixel((n%16*8+x,n//16*8+y),p[y*8+x])
+    sheet.save(SECONDARY/'tiles.png')
+    write_words(SECONDARY/'metatiles.bin',[e for g in definitions for e in g])
+    write_words(SECONDARY/'metatile_attributes.bin',attrs,'I')
+    for dest,base in [(PRIMARY,GENERAL),(SECONDARY,PEWTER)]:
+        (dest/'palettes').mkdir(exist_ok=True)
+        for n in range(16):
+            raw=(base/f'palettes/{n:02}.pal').read_bytes()
+            if dest==SECONDARY and n in (7,12):
+                colors=[tuple(station.getpalette()[i:i+3]) for i in range(0,48,3)] if n==7 else kit['palettes'][12]
+                raw=('JASC-PAL\r\n0100\r\n16\r\n'+'\r\n'.join(' '.join(map(str,c)) for c in colors)+'\r\n').encode()
+            (dest/f'palettes/{n:02}.pal').write_bytes(raw)
+    infill_count=0
+    write_words(DATA/'landmark-map.bin',grid)
+    if infill:
+        proposal=json.loads((ROOT/'data/taichung/neighborhoods/old-city-route-fill.json').read_text())
+        protected={tuple(p) for p in proposal['protectedCells']}
+        for item in proposal['wordDelta']:
+            x,y=item['x'],item['y'];i=y*40+x
+            assert (x,y) not in protected, f'Infill touches protected cell{x},{y}'
+            assert grid[i]==int(item['baselineWord'],0), f'Infill base changed at{x},{y}'
+            grid[i]=int(item['word'],0);infill_count+=1
+    write_words(DATA/'map.bin',grid)
+    manifest=dict(schemaVersion=1,status='compiled proposed scene; installation/runtime tracked separately',
+        primary='gTileset_TaichungOldCorePrimary',secondary='gTileset_TaichungOldCore',
+        primaryFolder=str(PRIMARY.relative_to(ROOT)),secondaryFolder=str(SECONDARY.relative_to(ROOT)),
+        mapFile=str((DATA/'map.bin').relative_to(ROOT)),baselineMapFile=str((DATA/'baseline-map.bin').relative_to(ROOT)),
+        width=40,height=72,landmarks=info,preservedPrimaryGraphics=sorted(scene.reserved),
+        compatibleLayoutCohort=['LAYOUT_TAICHUNG_OLD_CITY','LAYOUT_TAICHUNG_GREENWAY','LAYOUT_TAICHUNG_XITUN'],
+        allocatedPrimaryGraphics=[n for n in scene.allocated if n<640],
+        secondaryGraphics=len(scene.secondary),loadedSecondaryGraphics=sheet.width*sheet.height//64,
+        secondarySceneCapacity=376,doorScratch=[1016,1024],secondaryMetatiles=len(definitions),
+        generalMetatileRemap='identity',pewterMetatileRemap={str(n):n for n in retained},
+        colorMetatileRemaps=kit['budget']['colorMetatileRemaps'],
+        sourceGeneralHashes={name:hashlib.sha256((GENERAL/name).read_bytes()).hexdigest() for name in ('tiles.png','metatiles.bin','metatile_attributes.bin')},
+        bankSourceRemaps={'colorKit':{str(n):n for n in range(640,719)}},
+        infillInstalled=infill,infillChangedCells=infill_count)
+    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+    return manifest
+
+
+def install():
+    p=ROOT/'data/layouts/TaichungOldCity/map.bin';p.write_bytes((DATA/'map.bin').read_bytes())
+    p=ROOT/'data/layouts/layouts.json';ls=json.loads(p.read_text())
+    for layout in ls['layouts']:
+        if layout.get('id') in ('LAYOUT_TAICHUNG_OLD_CITY','LAYOUT_TAICHUNG_GREENWAY','LAYOUT_TAICHUNG_XITUN'):
+            layout.update(primary_tileset='gTileset_TaichungOldCorePrimary',secondary_tileset='gTileset_TaichungOldCore')
+    p.write_text(json.dumps(ls,indent=2)+'\n')
+
+
+if __name__=='__main__':
+    ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('--install',action='store_true');ap.add_argument('--infill',action='store_true');args=ap.parse_args()
+    m=compile_scene(infill=args.infill)
