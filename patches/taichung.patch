+def put_contract(contract, districts, landmarks, habitats):
+    """The city contract with these maps' entries set: districts and landmarks replaced in
+    place (a district the contract lacks is appended, one set to None is dropped), and the
+    maps' habitat regions first, as today's contract lists them."""
+    out, mids = copy.deepcopy(contract), set(districts)
+    out["districts"] = [districts[d["map"]] if d["map"] in mids else d for d in out["districts"]]
+    out["districts"] = [d for d in out["districts"] if d is not None]
+    out["districts"] += [d for mid, d in districts.items() if d and all(x["map"] != mid for x in out["districts"])]
+    out["landmarks"] = [landmarks.get(l["id"], l) for l in out["landmarks"]]
+    out["habitatRegions"] = list(habitats) + [h for h in out["habitatRegions"] if h["map"] not in mids]
+    return out
