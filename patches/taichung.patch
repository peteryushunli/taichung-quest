+        return FALSE;
+    if (TaichungTeamSpeciesInOtherSlot(sSlot, species))
+        return FALSE;
+    if (type == TEAM_CATEGORY_CAUGHT)
+    {
+        site = TaichungEncounterSiteForSpecies(species);
+        return site < TAICHUNG_ENCOUNTER_COUNT && (TaichungEncounterGetUnlockMask() & (1 << site)) != 0;
+    }
+    if (type == TEAM_CATEGORY_ALL)
+        return TRUE;
+    // Dual-type species belong to both of their types.
+    return gSpeciesInfo[species].types[0] == type || gSpeciesInfo[species].types[1] == type;
