diff --git a/data/taichung/landmarks/calligraphy-greenway/check_candidate.py b/data/taichung/landmarks/calligraphy-greenway/check_candidate.py
new file mode 100644
index 0000000..e7a4472
--- /dev/null
+++ b/data/taichung/landmarks/calligraphy-greenway/check_candidate.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Independent saved-format checks for the frozen CMP candidate; no install.
+
+All reconstruction outputs go to a temporary directory. This checker writes
+only format-validation.json; the Root-owned encoder/candidate stay unchanged.
+"""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def read_palette(raw):
+    lines = raw.decode().splitlines()
+    assert lines[:3] == ["JASC-PAL", "0100", "16"]
+    result = [tuple(map(int, row.split())) for row in lines[3:] if row.strip()]
+    assert len(result) == 16
+    return result
+
+
+def bgr555(colors):
+    return struct.pack("<16H", *(r//8 | g//8 << 5 | b//8 << 10 for r, g, b in colors))
+
+
+def check():
+    directory = HERE / "candidate"
+    manifest = json.loads((directory / "encode-manifest.json").read_text())
+    recipe, native_meta = manifest["recipe"], manifest["native"]
+    source = Path(manifest["sourceArtifact"])
+    palette_source = Path(recipe["sharedPaletteSource"])
+    review = Path(manifest["reviewArtifact"])
+    palette_meta = json.loads((HERE / "palette-candidate/manifest.json").read_text())
+    watched = [path for path in directory.iterdir() if path.is_file()] + [source, palette_source, review, HERE / "encode_candidate.py"]
+    before = {str(path): digest(path) for path in watched}
+    assert digest(source) == manifest["sourceSha256"]
+    width, height = recipe["logicalSize"]
+    assert (width, height) == (144, 160)
+    indexed = Image.open(directory / "candidate-indexed.png")
+    native = Image.open(directory / "candidate-native.png")
+    assert indexed.mode == "P" and indexed.size == (width, height) and indexed.info["transparency"] == 0
+    assert indexed.getextrema()[1] < 16
+    assert indexed.convert("RGBA").tobytes() == native.convert("RGBA").tobytes()
+    assert set(native.getchannel("A").get_flattened_data()) == {0, 255}
+    assert digest(directory / "candidate-native.png") == manifest["nativePngSha256"]
+    step = recipe["nativePixelClusterSize"]
+    assert step == 2 and all(indexed.getpixel((x, y)) == indexed.getpixel((x//step*step, y//step*step))
+                             for y in range(height) for x in range(width))
+    palette_raw = (directory / "08.pal").read_bytes()
+    assert palette_raw == palette_raw.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
+    colors = read_palette(palette_raw)
+    assert colors == read_palette(palette_source.read_bytes())
+    assert indexed.getpalette()[:48] == [v for color in colors for v in color]
+    assert (directory / "08.gbapal").read_bytes() == bgr555(colors)
+    released_raw = subprocess.check_output(["git", "show", palette_meta["baselineCommit"]+":"+palette_meta["sourcePalette"]], cwd=GAME)
+    assert hashlib.sha256(released_raw).hexdigest() == palette_meta["sourcePaletteGitSha256"]
+    released = read_palette(released_raw)
+    fixed, spare = [0, 1, 2, 3, 4, 5, 6, 7, 13], [8, 9, 10, 11, 12, 14, 15]
+    changed = [index for index in range(16) if colors[index] != released[index]]
+    assert changed == spare and all(colors[index] == released[index] for index in fixed)
+    assert all(all(0 <= v <= 248 and v%8 == 0 for v in colors[index]) for index in spare)
+    # Released RGB8 values such as index0=(24,41,82) deliberately remain exact;
+    # BGR555 encoding truncates these to the same loaded native words.
+    release_words, candidate_words = struct.unpack("<16H", bgr555(released)), struct.unpack("<16H", bgr555(colors))
+    assert all(release_words[index] == candidate_words[index] for index in fixed)
+    raw = (directory / "tiles.4bpp").read_bytes()
+    graphics = [tuple(value for byte in raw[n:n+32] for value in (byte & 15, byte >> 4)) for n in range(0, len(raw), 32)]
+    assert len(graphics) == native_meta["unique8x8GraphicsFlipDeduplicated"] == 262
+    assert len(set(graphics)) == len(graphics)
+    words = struct.unpack("<360H", (directory / "foreground-tilemap-relative.bin").read_bytes())
+    assert all(word >> 12 == 8 and word & 1023 < len(graphics) for word in words)
+    for y in range(height):
+        for x in range(width):
+            word = words[y//8*18+x//8]
+            sx, sy = 7-x%8 if word & 0x400 else x%8, 7-y%8 if word & 0x800 else y%8
+            assert graphics[word & 1023][sy*8+sx] == indexed.getpixel((x, y))
+    groups = [[words[(my*2+y)*18+mx*2+x] for y in range(2) for x in range(2)]
+              for my in range(10) for mx in range(9)]
+    assert groups == json.loads((directory / "foreground-metatiles-relative.json").read_text())
+    canonical_from_png = set()
+    for ty in range(20):
+        for tx in range(18):
+            variants = [tuple(indexed.getpixel((tx*8+(7-x if horizontal else x), ty*8+(7-y if vertical else y)))
+                              for y in range(8) for x in range(8)) for horizontal, vertical in ((False, False), (True, False), (False, True), (True, True))]
+            canonical_from_png.add(min(variants))
+    assert canonical_from_png == set(graphics)
+    assert Image.open(review).convert("RGBA").tobytes() == native.resize((576, 640), Image.Resampling.NEAREST).tobytes()
+    with tempfile.TemporaryDirectory(prefix="cmp-format-") as folder:
+        temp = Path(folder)
+        spec = importlib.util.spec_from_file_location("cmp_frozen_encoder", HERE / "encode_candidate.py")
+        encoder = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(encoder)
+        rebuilt = encoder.encode(source, temp / "candidate", temp / "review.png", recipe["alphaThreshold"], step,
+                                 (width, height), palette_source)
+        # reviewArtifact is the only location-dependent manifest field. Never
+        # point the rebuild at Root's actual saved review file merely to match it.
+        rebuilt["reviewArtifact"] = manifest["reviewArtifact"]
+        assert rebuilt == manifest
+        normalized_manifest = json.dumps(rebuilt, indent=2)+"\n"
+        assert normalized_manifest.encode() == (directory / "encode-manifest.json").read_bytes()
+        reproduced = [path.name for path in (temp / "candidate").iterdir() if path.is_file() and path.name != "encode-manifest.json"]
+        assert all((directory / name).read_bytes() == (temp / "candidate" / name).read_bytes() for name in reproduced)
+        assert (temp / "review.png").read_bytes() == review.read_bytes()
+        converter = GAME / "tools/gbagfx/gbagfx"
+        subprocess.run([str(converter), str(directory / "tiles.png"), str(temp / "converted.4bpp")], check=True, capture_output=True)
+        converted = (temp / "converted.4bpp").read_bytes()
+        assert converted[:len(raw)] == raw and set(converted[len(raw):]) <= {0}
+        subprocess.run([str(converter), str(directory / "08.pal"), str(temp / "converted.gbapal")], check=True, capture_output=True)
+        assert (temp / "converted.gbapal").read_bytes() == (directory / "08.gbapal").read_bytes()
+    assert all(digest(Path(path)) == expected for path, expected in before.items())
+    fit_path = PROJECT / "artifacts/worktrees/c291d4842985/greenway-primary-plan/cmp-candidate-fit.json"
+    fit = json.loads(fit_path.read_text())
+    assert fit["candidate"]["sha256"] == digest(directory / "candidate-indexed.png")
+    report = {
+        "result": "pass", "landmarkId": "calligraphy-greenway", "scope": "independent frozen-candidate format validation only",
+        "sizePixels": [width, height], "paletteBankCandidate": 8, "uniqueFlipDeduplicatedGraphics": 262,
+        "paddedSheetSlots": 272, "binaryAlpha": True, "uniform2PixelClusters": True,
+        "pngRgbaIdentity": True, "independentPngCanonicalPatternSetMatches": True,
+        "flipAware4bppRoundTripPixels": width*height, "foregroundMetatileCells": len(groups),
+        "relativeTilemapDimensions8x8": [18, 20], "paletteCrlfVerified": True, "bgr555Verified": True,
+        "releasedPaletteCommit": palette_meta["baselineCommit"], "preservedPaletteIndices": fixed,
+        "changedPaletteIndices": changed, "onlySevenSpareEntriesChanged": True,
+        "transparentIndex0RgbPreserved": list(colors[0]), "preservedLoadedBgr555WordsMatch": True,
+        "gbagfxGraphicsAndPaletteMatch": True, "gbagfxTrailingSheetPaddingZero": True,
+        "deterministicRebuild": {"savedCandidateFilesByteIdentical": len(reproduced),
+            "manifestByteIdenticalAfterReviewPathNormalization": True, "reviewPngByteIdentical": True,
+            "onlyNormalizedField": "reviewArtifact", "allOriginalInputsAndOutputsUnchanged": True},
+        "fitArtifact": {"pathRelativeToProject": str(fit_path.relative_to(PROJECT)), "sha256": digest(fit_path),
+            "candidateIndexedShaMatches": True, "packingAndCollisionClaimsNotIndependentlyValidatedHere": True},
+        "savedFilesSha256": {str(path.relative_to(HERE)): before[str(path)] for path in watched if path.is_relative_to(HERE)},
+        "sourceStudySha256": before[str(source)], "sourceStudyUnchanged": True,
+        "reviewPngSha256": before[str(review)], "sourcePaletteOrMapChanged": False,
+        "doorBindingOrCollisionOrRuntimeVerified": False, "registeredInRom": False, "nativeReady": False,
+    }
+    (HERE / "format-validation.json").write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(report, indent=2))
+    return report
+
+
+if __name__ == "__main__":
+    check()
diff --git a/data/taichung/landmarks/calligraphy-greenway/encode_candidate.py b/data/taichung/landmarks/calligraphy-greenway/encode_candidate.py
new file mode 100644
index 0000000..bf94bd9
--- /dev/null
+++ b/data/taichung/landmarks/calligraphy-greenway/encode_candidate.py
@@ -0,0 +1,175 @@
+#!/usr/bin/env python3
+"""Deterministically encode the CMP Park Lane study as an independent candidate.
+
+This performs asset-format conversion only; architecture approval is tracked separately: hard alpha, aspect-preserving nearest
+reduction, 15 opaque GBA colors, and flip-aware 4bpp packing. It does not register
+tiles, alter any native map or activate the painted entrance as a game warp.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+import PIL
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+GAME = HERE.parents[3]
+PROJECT = GAME.parents[1]
+ARTIFACT = PROJECT / 'artifacts/worktrees' / hashlib.sha256(str(GAME).encode()).hexdigest()[:12]
+
+
+def flip(pixels, horizontal=False, vertical=False):
+    return tuple(pixels[(7-y if vertical else y)*8+(7-x if horizontal else x)]
+                 for y in range(8) for x in range(8))
+
+
+def encode(source, output, review, threshold=224, pixel_step=2, logical_size=(144,160), palette_source=None):
+    width,height=logical_size
+    if width%16 or height%16:raise ValueError("Envelope must be a multiple of16")
+    rgba = Image.open(source).convert('RGBA')
+    mask = rgba.getchannel('A').point(lambda value: 255 if value >= threshold else 0)
+    bbox = mask.getbbox()
+    if not bbox:
+        raise ValueError('The source has no foreground at this alpha threshold.')
+    # Preserve the approved architecture's aspect ratio, centered and aligned to
+    # the native envelope's south edge. Transparent north space remains walkable
+    # until the integrator assigns source layers and actual collision geometry.
+    crop = rgba.crop(bbox)
+    crop.putalpha(mask.crop(bbox))
+    if pixel_step not in (1,2,4):
+        raise ValueError('Pixel step must be1,2 or4 and divide the native envelope.')
+    working_size = (width//pixel_step,height//pixel_step)
+    scale = min(working_size[0]/crop.width, working_size[1]/crop.height)
+    size = (max(1, round(crop.width*scale)), max(1, round(crop.height*scale)))
+    resized = crop.resize(size, Image.Resampling.NEAREST)
+    offset = ((working_size[0]-size[0])//2, working_size[1]-size[1])
+    canvas = Image.new('RGBA', working_size)
+    canvas.paste(resized, offset)
+
+    raw_pixels = list(canvas.get_flattened_data())
+    opaque = [pixel[:3] for pixel in raw_pixels if pixel[3]]
+    strip = Image.new('RGB', (len(opaque),1))
+    strip.putdata(opaque)
+    quantized = strip.quantize(colors=15, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
+    source_palette = quantized.getpalette()
+    palette = []
+    for index in sorted(set(quantized.get_flattened_data())):
+        color = tuple(min(248, ((source_palette[index*3+c]+4)//8)*8) for c in range(3))
+        if color not in palette:
+            palette.append(color)
+    if len(palette)>15:
+        raise ValueError('Opaque palette exceeds 4bpp capacity.')
+    # Index zero is transparency. Opaque black, if chosen, receives its own index.
+    if palette_source is not None:
+        lines=palette_source.read_text().splitlines()[3:]
+        colors=[tuple(map(int,line.split())) for line in lines if line.strip()]
+        if len(colors)!=16:raise ValueError('Shared palette must contain16 entries')
+        palette=colors[1:]
+    # Transparent PNG index0 still becomes a loaded palette entry in the ROM;
+    # preserve it along with every other existing bank value.
+    full_palette = [colors[0] if palette_source is not None else (0,0,0)] + palette + [(0,0,0)]*(15-len(palette))
+    indices = []
+    for r,g,b,a in raw_pixels:
+        if not a:
+            indices.append(0)
+        else:
+            indices.append(1+min(range(len(palette)), key=lambda i:
+                (r-palette[i][0])**2+(g-palette[i][1])**2+(b-palette[i][2])**2))
+    indexed = Image.new('P', working_size)
+    indexed.putpalette([v for color in full_palette for v in color] + [0]*(768-48))
+    indexed.putdata(indices)
+    indexed.info['transparency'] = 0
+    if pixel_step != 1:
+        # A deliberately coarser, uniform native-pixel cluster size reduces tile
+        # cost while retaining the approved silhouette and full map footprint.
+        indexed = indexed.resize((width,height),Image.Resampling.NEAREST)
+        indexed.info['transparency'] = 0
+        indices = list(indexed.get_flattened_data())
+
+    graphics = []
+    lookup = {}
+    tile_entries = []
+    for ty in range(height//8):
+        for tx in range(width//8):
+            pixels = tuple(indices[(ty*8+y)*width+tx*8+x] for y in range(8) for x in range(8))
+            options = [(pixels,0),(flip(pixels,True),0x400),(flip(pixels,False,True),0x800),(flip(pixels,True,True),0xc00)]
+            canonical, flags = min(options, key=lambda item:(item[0],item[1]))
+            if canonical not in lookup:
+                lookup[canonical] = len(graphics)
+                graphics.append(canonical)
+            tile_entries.append(lookup[canonical] | flags | (8<<12))
+    # Explicit relative entries: integrator chooses final secondary graphic base.
+    relative_metatiles = []
+    for my in range(height//16):
+        for mx in range(width//16):
+            relative_metatiles.append([tile_entries[(my*2+y)*(width//8)+mx*2+x]
+                                       for y in range(2) for x in range(2)])
+
+    # Meaningful format round-trip against the indexed target, including flips.
+    decoded = []
+    for y in range(height):
+        for x in range(width):
+            entry = tile_entries[(y//8)*(width//8)+x//8]
+            local_x, local_y = x%8, y%8
+            if entry&0x400: local_x=7-local_x
+            if entry&0x800: local_y=7-local_y
+            decoded.append(graphics[entry&0x3ff][local_y*8+local_x])
+    if decoded != indices:
+        raise ValueError('Flip-aware native tilemap did not round-trip.')
+    if len(graphics)>376:
+        raise ValueError(f'Candidate alone exceeds secondary capacity: {len(graphics)}.')
+
+    output.mkdir(parents=True, exist_ok=True)
+    indexed.save(output/'candidate-indexed.png')
+    native = indexed.convert('RGBA')
+    native.save(output/'candidate-native.png')
+    review.parent.mkdir(parents=True, exist_ok=True)
+    native.resize((width*4,height*4), Image.Resampling.NEAREST).save(review)
+    sheet = Image.new('P', (128, ((len(graphics)+15)//16)*8))
+    sheet.putpalette(indexed.getpalette())
+    sheet.info['transparency'] = 0
+    for n,pixels in enumerate(graphics):
+        for y in range(8):
+            for x in range(8): sheet.putpixel((n%16*8+x,n//16*8+y),pixels[y*8+x])
+    sheet.save(output/'tiles.png')
+    (output/'tiles.4bpp').write_bytes(bytes(pixels[i]|pixels[i+1]<<4
+                                           for pixels in graphics for i in range(0,64,2)))
+    (output/'foreground-tilemap-relative.bin').write_bytes(struct.pack(f'<{len(tile_entries)}H',*tile_entries))
+    (output/'foreground-metatiles-relative.json').write_text(json.dumps(relative_metatiles,indent=2)+'\n')
+    palette_text = 'JASC-PAL\n0100\n16\n'+'\n'.join(' '.join(map(str,color)) for color in full_palette)+'\n'
+    (output/'08.pal').write_bytes(palette_text.replace('\n','\r\n').encode())
+    (output/'08.gbapal').write_bytes(struct.pack('<16H',*(r//8|(g//8)<<5|(b//8)<<10 for r,g,b in full_palette)))
+    metadata = {
+        'schemaVersion':1,'landmarkId':'calligraphy-greenway','status':'independent native-encoded candidate; not registered in ROM',
+        'sourceArtifact':str(source),'sourceSha256':hashlib.sha256(source.read_bytes()).hexdigest(),
+        'recipe':{'alphaThreshold':threshold,'sourceCropBox':list(bbox),'preserveAspectRatio':True,'resampling':'nearest',
+                  'quantization':('nearest RGB in supplied palette; no dithering' if palette_source else 'MEDIANCUT over opaque pixels only; no dithering'),'gbaColorRounding':'nearest multiple of8 clamped248',
+                  'logicalSize':list(logical_size),'workingResolution':list(working_size),'nativePixelClusterSize':pixel_step,
+                  'fittedSubjectSize':[v*pixel_step for v in size],'subjectOffset':[v*pixel_step for v in offset],'paletteBankCandidate':8,
+                  'opaqueColors':len(palette),'PillowVersion':PIL.__version__,'sharedPaletteSource':str(palette_source) if palette_source else None},
+        'native':{'unique8x8GraphicsFlipDeduplicated':len(graphics),'staticSecondaryCapacity':376,'staticSlotsRemainingBeforeOtherAssets':376-len(graphics),'doorScratchReservedGraphicIds':[1016,1023],
+                  'foregroundMetatileCells':width//16*(height//16),'paletteEntries':16,'binaryAlpha':True,'tilemapRoundTripPass':True,
+                  'tilemapGraphicIndices':'relative to this candidate bank, not global640-based registration IDs',
+                  'tilemapDimensions8x8':[width//8,height//8],'provisionalPortalCellForLaterMeasurement':[4,9],'paintedDoorRequiresNativeBinding':True},
+        'integration':{'registeredInRom':False,'sharedPaletteAssigned':False,'geometryReviewed':False,'nativeReady':False,
+                       'rootMustAssignGraphicOffsetAndMergeSharedKit':True,'baselineDoor':[22,36],'baselineArrival':[22,39]},
+        'reviewArtifact':str(review),'nativePngSha256':hashlib.sha256((output/'candidate-native.png').read_bytes()).hexdigest()
+    }
+    (output/'encode-manifest.json').write_text(json.dumps(metadata,indent=2)+'\n')
+    return metadata
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ARTIFACT/'landmark-art/calligraphy-greenway-study-v1.png')
+    parser.add_argument('--output', type=Path, default=HERE/'candidate')
+    parser.add_argument('--review', type=Path, default=ARTIFACT/'landmark-art/calligraphy-greenway-native-candidate-v1.png')
+    parser.add_argument('--alpha-threshold', type=int, default=224)
+    parser.add_argument('--pixel-step', type=int, default=2)
+    parser.add_argument('--width',type=int,default=144);parser.add_argument('--height',type=int,default=160)
+    parser.add_argument('--palette-source',type=Path,default=HERE/'palette-candidate/08.pal')
+    args=parser.parse_args()
+    result=encode(args.source,args.output,args.review,args.alpha_threshold,args.pixel_step,(args.width,args.height),args.palette_source)
+    print(json.dumps({'native':result['native'],'recipe':result['recipe'],'reviewArtifact':result['reviewArtifact']},indent=2))
