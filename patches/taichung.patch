+            buildBindingOwner='Main; source fingerprint alone is not proof of loaded-ROM compatibility'),
+        gymIdNamespace='stable landmark string ID; numeric progression/save bits are owned by Gameplay, not inferred here',
+        mapsByNativeKey=maps, nativeKeysByMapId={entry['mapId']: key for key, entry in maps.items()},
+        markersById=markers, seams=seams, plannedMaps=planned)
+    geometry = {key: contract[key] for key in ('schemaVersion', 'coordinateSystem', 'world', 'mapsByNativeKey', 'markersById', 'seams')}
+    contract['geometryFingerprintSha256'] = hashlib.sha256(canonical(geometry)).hexdigest()
+    for path in dict.fromkeys(used_paths):
+        require(hashlib.sha256(path.read_bytes()).hexdigest() == loaded_hashes[path], f'Source changed during export; rerun after registration settles: {path}')
+    contract['sourceSha256'] = {str(p.relative_to(source)): loaded_hashes[p] for p in dict.fromkeys(used_paths)}
+    contract['validation'] = validate_contract(contract)
+    return contract
+
+
+def validate_contract(contract):
+    require(contract['schemaVersion'] == 1, 'Unsupported minimap contract schema')
+    maps = contract['mapsByNativeKey']; reverse = contract['nativeKeysByMapId']; require(len(maps) == len(reverse), 'Native ID lookup is not bijective')
+    for key, entry in maps.items():
+        require(key == f"{entry['group']}:{entry['number']}" and reverse[entry['mapId']] == key, 'Native ID reverse lookup differs')
+        require(entry['packedMapId'] == entry['number'] | entry['group'] << 8, 'Packed native ID differs')
+    seen = {}; count = 0
+    for key, entry in maps.items():
+        if entry['kind'] != 'exterior': continue
+        for y in range(entry['height']):
+            for x in range(entry['width']):
+                position = project_position(contract, key, x, y); require(position is not None, 'Valid local tile projects out of world')
+                world = tuple(position['world']); require(world not in seen, 'Exterior projections overlap')
+                seen[world] = (key, x, y)
+                require(inverse_world(contract, *world) == dict(nativeKey=key, local=[x, y]), 'Exterior projection roundtrip differs'); count += 1
+        for bad in ((-1, 0), (entry['width'], 0), (0, entry['height']), (0.5, 1)):
+            require(project_position(contract, key, *bad) is None, 'Invalid local coordinates are not hidden')
+    require(project_position(contract, '255:255', 0, 0) is None, 'Unknown native map is not hidden')
+    for blank in ((85, 130), (128, 180)):  # the corner east of Wanhe and south of Old City, beyond the river
+        require(inverse_world(contract, *blank) is None, 'Blank world canvas is treated as a playable map')
+    markers = contract['markersById']; gym_keys = set(); marker_points = set()
+    for identity, marker in markers.items():
+        require(identity == marker['id'] == marker['gymId'] and marker['name']['en'] and marker['name']['zh'], 'Marker ID/name contract incomplete')
+        require(marker['gymNativeKey'] not in gym_keys and tuple(marker['world']) not in marker_points, 'Gym markers are not bijective')
+        gym_keys.add(marker['gymNativeKey']); marker_points.add(tuple(marker['world']))
+        require(inverse_world(contract, *marker['world']) == dict(nativeKey=marker['exteriorNativeKey'], local=marker['localEntrance']), 'Marker entrance roundtrip differs')
+        room = maps[marker['gymNativeKey']]
+        for local in ((0, 0), (room['width'] - 1, room['height'] - 1)):
+            position = project_position(contract, marker['gymNativeKey'], *local)
+            require(position['indoor'] and position['world'] == marker['world'], 'Indoor room XY leaks into world projection')
+    require(len(markers) == len(gym_keys) == 12, 'Current baseline requires twelve landmark markers: ten gyms and two Nantun temples')
+    for key, room in maps.items():
+        if room['kind'] != 'interior': continue
+        parent = maps[room['parentNativeKey']]; marker = markers[room['parentMarkerId']]
+        require(parent['kind'] == 'exterior' and room['parentEntranceWorld'] == marker['world'], 'Interior parent anchor differs from its landmark')
+        for local in ((0, 0), (room['width'] - 1, room['height'] - 1)):
+            require(project_position(contract, key, *local)['world'] == marker['world'], 'Interior coordinates projected as city tiles')
+        require(project_position(contract, key, room['width'], 0) is None, 'Invalid interior position is not hidden')
+    for entry in contract['plannedMaps']: require(entry['nativeKey'] is None and not entry['usableForLivePosition'], 'Planned room exposed as registered')
+    spawn = project_position(contract, reverse['MAP_TAICHUNG_OLD_CITY'], 30, 66)
+    return dict(result='pass', registeredExteriors=sum(e['kind'] == 'exterior' for e in maps.values()),
+        registeredGymInteriors=len(gym_keys), registeredOptionalInteriors=sum(e['kind'] == 'interior' for e in maps.values()) - len(gym_keys),
+        nativeIdBijectionEntries=len(maps), markerGymBijectionEntries=len(markers), exteriorTilesRoundtripped=count,
+        directedSeamsValidated=len(contract['seams']), seamEdgePairsValidated=sum(s['overlappingEdgeTiles'] for s in contract['seams']),
+        projectionExample=dict(nativeKey=reverse['MAP_TAICHUNG_OLD_CITY'], local=[30, 66], world=spawn['world'],
+            normalizedCellCenter=spawn['normalizedCellCenter'], pixelCenterOn160x160=[v * 160 for v in spawn['normalizedCellCenter']]))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__); parser.add_argument('--source', type=Path, default=ROOT)
+    parser.add_argument('--output', type=Path); parser.add_argument('--check', action='store_true'); args = parser.parse_args()
+    result = build_contract(args.source); output = args.output or args.source / CONTRACT
+    if args.check:
