diff --git a/tools/taichung_gameplay/test-native-badge-sprites.py b/tools/taichung_gameplay/test-native-badge-sprites.py
new file mode 100644
index 0000000..668de96
--- /dev/null
+++ b/tools/taichung_gameplay/test-native-badge-sprites.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Run native sprite allocation/animation/copy/OAM bodies with real badge art.
+
+Only GBA memory copies, palette services, sorting and unused affine/subsprite
+paths are host substitutes. The frame command and copy queue are native code.
+No ROM build or emulator is needed. --prove-regression also reverts only the
+badge animation binding and requires the same rendering assertions to fail.
+"""
+from pathlib import Path
+import argparse
+import re
+import subprocess
+
+
+def braced(source, start):
+    opening = source.index("{", start)
+    depth, index = 1, opening + 1
+    while depth:
+        depth += (source[index] == "{") - (source[index] == "}")
+        index += 1
+    return source[start:index]
+
+
+def definition(source, name):
+    match = re.search(r"^[\w *]+\b" + re.escape(name) + r"\([^;{}]*\)\s*\n\{", source, re.M)
+    if not match:
+        raise ValueError(f"Missing native function {name}")
+    body = braced(source, match.start())
+    return body, body[:body.index("{")].strip() + ";"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--prove-regression", action="store_true")
+    args = parser.parse_args()
+    game = Path(__file__).resolve().parents[2]
+    out = game / "build/taichung-tests/native-badge-sprites"
+    out.mkdir(parents=True, exist_ok=True)
+    sprite = (game / "src/sprite.c").read_text()
+    header = (game / "include/sprite.h").read_text()
+    gba = (game / "include/gba/types.h").read_text()
+    types = gba[gba.index("struct OamData"):gba.index("struct BgAffineSrcData")]
+    types += header[header.index("#define MAX_SPRITES"):header.index("extern const struct OamData")]
+    types += sprite[sprite.index("#define ALLOC_SPRITE_TILE"):sprite.index("struct OamDimensions")]
+    types += sprite[sprite.index("#define DUMMY_OAM_DATA"):sprite.index("// Unreferenced error message.")]
+    types += braced(sprite, sprite.index("static const u8 sCenterToCornerVecTable")) + ";\n"
+    types += sprite[sprite.index("static const struct Sprite sDummySprite"):sprite.index("static const AnimFunc sAnimFuncs")]
+    (out / "native-badge-types.inc").write_text(types)
+
+    names = [
+        "CreateSprite", "CreateSpriteAt", "ResetSprite", "CalcCenterToCornerVec", "AllocSpriteTiles",
+        "SpriteCallbackDummy", "AnimateSprites", "AnimateSprite", "BeginAnim", "ContinueAnim",
+        "AnimCmd_frame", "AnimCmd_end", "SetSpriteOamFlipBits", "DecrementAnimDelayCounter",
+        "RequestSpriteFrameImageCopy", "ProcessSpriteCopyRequests", "BuildOamBuffer", "UpdateOamCoords",
+        "BuildSpritePriorities", "AddSpritesToOamBuffer", "AddSpriteToOamBuffer", "CopyMatricesToOamBuffer", "LoadOam",
+    ]
+    pairs = [definition(sprite, name) for name in names]
+    city = (game / "src/taichung_city_pass.c").read_text()
+    pairs.append(definition(city, "VBlankCB_CityPass"))
+    prototypes = "\n".join(proto for _, proto in pairs) + "\n"
+    # Native dispatch tables; affine/jump/loop branches are asserted unused by
+    # this stationary, non-affine icon fixture, rather than reimplemented.
+    for marker in ("static const AnimFunc sAnimFuncs", "static const AnimFunc sAffineAnimFuncs",
+                   "static const AnimCmdFunc sAnimCmdFuncs"):
+        prototypes += braced(sprite, sprite.index(marker)) + ";\n"
+    (out / "native-badge-engine.inc").write_text(prototypes + "\n".join(body for body, _ in pairs))
+
+    badges = (game / "src/taichung_badges.c").read_text()
+    data = badges[badges.index("#define BADGE_PALETTE_EARNED"):badges.index("static const u8 sDepartureEn")]
+    data = re.sub(r"^static EWRAM_DATA u16 sPreparedAward.*\n", "", data, flags=re.M)
+
+    def incbin(match):
+        kind, path = match.groups()
+        raw = (game / path).read_bytes()
+        size = 1 if kind == "8" else 2
+        return "{" + ",".join(str(int.from_bytes(raw[i:i + size], "little")) for i in range(0, len(raw), size)) + "}"
+
+    data = re.sub(r'INCBIN_U(8|16)\("([^"]+)"\)', incbin, data)
+    for name in ("TaichungBadgeLoadPalettes", "TaichungBadgeCreateSprite"):
+        data += "\n" + definition(badges, name)[0]
+    include = out / "native-badge-data.inc"
+    include.write_text(data)
+    # The unchanged native dummy callback intentionally has an unused arg;
+    # native two-argument frame macros intentionally zero their flip fields.
+    command = ["cc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter", "-Wno-missing-field-initializers",
+               "-I" + str(out), str(game / "tests/taichung_native_badge_sprites_test.c")]
+    binary = out / "native-badge-sprites"
+    subprocess.run(command + ["-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
+    if args.prove_regression:
+        original = include.read_text()
+        needle = ".anims = sBadgeAnimTable"
+        if original.count(needle) != 1:
+            raise ValueError("Expected exactly one shared static badge animation binding")
+        # Keep the table referenced, changing only its frame dispatch binding.
+        include.write_text(original.replace(needle, ".anims = gDummySpriteAnimTable") +
+                           "\nconst void *sRetainedBadgeAnimTableForRegression = sBadgeAnimTable;\n")
+        mutant = out / "native-badge-sprites-dummy"
+        try:
+            subprocess.run(command + ["-o", str(mutant)], check=True)
+            result = subprocess.run([str(mutant)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+            if result.returncode == 0:
+                raise AssertionError("Dummy-animation regression unexpectedly rendered badge pixels")
+            if b"gSpriteCopyRequestCount == TAICHUNG_GYM_COUNT" not in result.stderr:
+                raise AssertionError(f"Regression failed for an unexpected reason: {result.stderr!r}")
+            print("PASS: reverting only the shared animation to native ANIM_END fails the real copy-queue assertion")
+        finally:
+            include.write_text(original)
+
+
+if __name__ == "__main__":
+    main()
