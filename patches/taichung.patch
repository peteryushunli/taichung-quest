+
+def snake(name):
+    import re
+    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).upper()
+
+
+def save_json(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
+
+
+def read_words(path):
+    raw = path.read_bytes()
+    return list(struct.unpack(f"<{len(raw)//2}H", raw))
+
+
+def write_words(path, words):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(struct.pack(f"<{len(words)}H", *words))
+
+
+class Grid:
+    def __init__(self, width, height):
+        self.width, self.height = width, height
+        self.cells = [0x3000 | GRASS] * (width * height)
+        self.boundary()
+
+    def put(self, x, y, tile, blocked=False, elevation=3):
+        assert 0 <= x < self.width and 0 <= y < self.height, (x, y)
+        self.cells[y*self.width+x] = (elevation << 12) | (0x400 if blocked else 0) | tile
+
+    def rect(self, x0, y0, x1, y1, tile=PAVING, blocked=False, elevation=3):
+        for y in range(y0, y1+1):
+            for x in range(x0, x1+1):
+                self.put(x, y, tile, blocked, elevation)
+
+    def boundary(self):
+        for y in range(self.height):
+            for x in range(self.width):
+                if x < 2 or x >= self.width-2 or y < 2 or y >= self.height-2:
+                    self.put(x, y, ((0x00E, 0x00F), (0x016, 0x017))[y % 2][x % 2], True, 0)
+
+    def grove(self, x0, y0, cols, rows):
+        for y in range(rows*2):
+            for x in range(cols*2):
+                self.put(x0+x, y0+y, ((0x00E, 0x00F), (0x016, 0x017))[y % 2][x % 2], True, 0)
+
+    def pond(self, x0, y0, x1, y1):
+        # Fishing/encounter ownership comes later; water is not a walking route.
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):
+                row = 0 if y==y0 else 2 if y==y1 else 1
+                col = 0 if x==x0 else 2 if x==x1 else 1
+                tile=((0x1A0,0x1A1,0x1A2),(0x1A8,0x1A9,0x1AA),(0x1B0,0x1B1,0x1B2))[row][col]
+                self.put(x,y,tile,True,1)
+
+
+def object_event(local_id, x, y, script, graphics="OBJ_EVENT_GFX_WOMAN_1"):
+    return dict(local_id=local_id, type="object", graphics_id=graphics, x=x, y=y,
+                elevation=3, movement_type="MOVEMENT_TYPE_FACE_DOWN", movement_range_x=0,
