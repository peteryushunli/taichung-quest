+        protectedActors=sorted([list(p) for p in native.actors]), protectedSigns=sorted([list(p) for p in native.signs]),
+        groundPatches=ground_patches, rows=rows, placements=units,
+        sourcePrefabs=added, colorwayRecipe='data/taichung/prefabs/colorways.json',
+        doorApproaches=composed['entrances'], routeProofPaths=paths,
+        wordDelta=[dict(x=x, y=y, baselineWord=f'0x{native.baseline_cells[y * WIDTH + x]:04X}',
+            observedCurrentWord=f'0x{native.cell(x,y):04X}', word=f'0x{words[y * WIDTH + x]:04X}',
+            reason='ordinary-building' if (x,y) in painted else 'approved-corridor-repair' if (x,y) in repair else 'ordinary-block-ground')
+            for x,y in sorted(changed, key=lambda p:(p[1],p[0])) if words[y*WIDTH+x] != native.baseline_cells[y*WIDTH+x]],
+        validation=dict(result='pass', protectedCellsUnchanged=len(protected), changedGroundCells=len(ground),
+            buildingSolidCells=len(painted), ordinaryBuildingBays=len(units), continuousRows=len(rows), restoredRoadTreeCells=len(repair),
+            reachableCells=len(seen), landmarkApproaches=approaches, westSeamCells=[list(p) for p in seams],
+            actorAndSignInteractionCells=len(interactions), dormantApproaches=len(composed['entrances']),
+            roofOrProtectedOverflows=0, sourceNativeBank=compiled['budget']),
+        artStatus='accepted V4 native source geometry/colors; provisional FireRed art, no actual parcel claims')
+    applied = list(native.cells)
+    for delta in result['wordDelta']:
+        point = (delta['x'], delta['y']); require(point not in protected, 'Native delta enters a protected landmark/road/park cell')
+        applied[delta['y'] * WIDTH + delta['x']] = int(delta['word'], 0)
+    require(applied == words, 'Delta does not reconstruct the verified current-art map')
+    result['validation']['nativeWordDeltaCells'] = len(result['wordDelta'])
+    result['validation']['installedMetatileRenderAndBehaviorComparisons'] = len(used)
+    result['validation']['nativeDeltaRoundtripPreservesCurrentLandmarkArt'] = True
