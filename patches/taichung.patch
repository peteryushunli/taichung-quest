+# accepted too. The five rooms, their layout and the actors are unchanged by the city, so the
+# staff delta is proved on the same base either way.
+CITY = 'a2f2afaeaebd0fd5a30c4547bed8a0df5dac00fd'
+CITY_RECORD = 'data/taichung/city-rework/save-v10.json'
+DELEGATE_V9 = 'RememberCacheRefreshFacing(warp);'
+DELEGATE_CITY = 'RememberCacheRefreshFacing(warp, TAICHUNG_SAVE_VERSION);'
+CITY_NOTE = '    // The save is already current here (the upgrade ran first), so no v10 shift applies.\n'
+MANIFEST = 'data/taichung/gym-staff/manifest.json'
+MANIFEST_SHA256 = '6239ee27e7a517407df04124fc578ded3116a2f9b73b1a4d1defecfa08ae7827'
+SAVE, HEADER = 'src/taichung_save.c', 'include/taichung_save.h'
+CHARACTERS, IDS = 'src/taichung_characters.c', 'include/constants/event_objects.h'
+API_NAME = 'TaichungSaveRememberObjectCacheRefreshFacing'
+HEADER_ADDITION = ('// A qualified object-cache refresh calls this after filling continueGameWarp,\n'
+                   '// before setting its pending flag. Reuses the existing one-shot facing state.\n'
+                   'void TaichungSaveRememberObjectCacheRefreshFacing(void);\n')
