@@ -0,0 +1,213 @@
+#!/usr/bin/env python3
+"""Convert the approved city-v3 building study into indexed native building art.
+
+The study (data/taichung/neighborhoods/city-v3-studies) is generated high-resolution
+art. This tool crops its eight buildings, downsamples them to native 16px cells at one
+shared scale, quantizes them in Lab space to the existing OldCore Taichung kit palette
+(secondary slot 12, so no loaded palette changes) and writes indexed PNGs.
+
+The buildings installed into OldCity share a tight graphics budget, so their 8x8 tiles
+are merged (flip-aware, Lab distance, greedy then k-medoids) until the set fits. The
+other styles are written unmerged for a later bank with more room.
+
+Outputs are the reviewed source for oldcity_buildings.py, which packs them without any
+floating-point work. Rerunning this tool may differ by machine; review its PNGs.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+STUDY = ROOT / 'data/taichung/neighborhoods/city-v3-studies/taichung-building-kit-study.png'
+KIT_PALETTE = ROOT / 'data/tilesets/secondary/taichung_old_core/palettes/12.pal'
+OUT = ROOT / 'data/taichung/oldcity-buildings'
+MIN_SCALE = 4.5
+# name, study crop (x0, y0, x1, y1), native cells (w, h)
+STYLES = [
+    ('townhouse', (72, 64, 357, 431), (4, 5)),
+    ('teal-pair', (458, 64, 856, 431), (6, 5)),
+    ('corner-cafe', (926, 64, 1287, 431), (5, 5)),
+    ('courtyard-workshop', (1345, 64, 1754, 431), (6, 5)),
+    ('balcony-walkup', (80, 466, 355, 871), (4, 6)),
+    ('attached-shops', (443, 466, 858, 871), (6, 5)),
+    ('flat-roof-store', (929, 466, 1270, 871), (5, 5)),
+    ('apartment', (1353, 466, 1741, 871), (6, 6)),
+]
+# OldCity's additive budget is 85 appended metatiles and 118 free graphics: three styles fit.
+OLDCITY_STYLES = ['townhouse', 'teal-pair', 'balcony-walkup']
+OLDCITY_TILE_BUDGET = 118
+FLIPS = [lambda q: q, lambda q: q[:, ::-1], lambda q: q[::-1], lambda q: q[::-1, ::-1]]
+
+
+def lab(rgb):
+    c = np.asarray(rgb, float) / 255.0
+    c = np.where(c > 0.04045, ((c + 0.055) / 1.055) ** 2.4, c / 12.92)
+    m = np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]])
+    xyz = c @ m.T / np.array([0.9505, 1.0, 1.089])
+    f = np.where(xyz > 0.008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
+    # Chroma is weighted up so teal roofs and planting do not collapse into grey.
+    return np.stack([116 * f[..., 1] - 16, 800 * (f[..., 0] - f[..., 1]), 320 * (f[..., 1] - f[..., 2])], -1)
+
+
+def downsample(study, box, cells):
+    crop = np.array(study.crop(box))
+    alpha = crop[:, :, 3] > 40
+    ys, xs = np.where(alpha.any(1))[0], np.where(alpha.any(0))[0]
+    crop = crop[ys[0]:ys[-1] + 1, xs[0]:xs[-1] + 1]
+    h, w = crop.shape[:2]
+    scale = max(MIN_SCALE, w / (cells[0] * 16), h / (cells[1] * 16))
+    size = (round(w / scale), round(h / scale))
+    rgba = crop.astype(float)
+    rgba[:, :, :3] *= rgba[:, :, 3:4] / 255
+    small = np.array(Image.fromarray(rgba.clip(0, 255).astype(np.uint8)).resize(size, Image.BOX)).astype(float)
+    a = small[:, :, 3:4]
+    small[:, :, :3] = np.where(a > 0, small[:, :, :3] * 255 / np.maximum(a, 1), 0)
+    out = np.zeros((cells[1] * 16, cells[0] * 16, 4), np.uint8)
+    ox = (out.shape[1] - size[0]) // 2
+    out[out.shape[0] - size[1]:, ox:ox + size[0], :3] = small[:, :, :3].clip(0, 255)
+    out[out.shape[0] - size[1]:, ox:ox + size[0], 3] = np.where(small[:, :, 3] >= 128, 255, 0)
+    return out, scale
+
+
+def kit_palette():
+    lines = KIT_PALETTE.read_text().split()
+    values = [int(v) for v in lines[3:]]
+    return np.array(values[3:48]).reshape(15, 3)
+
+
+def quantize(image, palette):
+    idx = ((lab(image[:, :, :3].reshape(-1, 3))[:, None] - lab(palette)[None]) ** 2).sum(2).argmin(1) + 1
+    return np.where(image[:, :, 3].reshape(-1) > 0, idx, 0).reshape(image.shape[:2]).astype(np.uint8)
+
+
+def tiles_of(index):
+    h, w = index.shape
+    return {(tx, ty): index[ty * 8:ty * 8 + 8, tx * 8:tx * 8 + 8] for ty in range(h // 8) for tx in range(w // 8)}
+
+
+def canonical(q):
+    return min(f(q).tobytes() for f in FLIPS)
+
+
+def merge(indexed, palette, budget):
+    """Replace near-identical tiles across the given buildings until at most `budget` remain."""
+    colours = lab(np.vstack([[0, 0, 0], palette]))
+    counts = {}
+    for index in indexed.values():
+        for q in tiles_of(index).values():
+            if q.any():
+                k = canonical(q)
+                counts[k] = counts.get(k, 0) + 1
+    keys = sorted(counts)
+    n = len(keys)
+    grids = [np.frombuffer(k, np.uint8).reshape(8, 8) for k in keys]
+    feats = np.array([colours[g] for g in grids])
+    masks = np.array([g > 0 for g in grids], float)
+    dist = np.full((n, n), np.inf)
+    for i in range(n):
+        best = None
+        for f in FLIPS:
+            fi, mi = f(feats[i]), f(masks[i])
+            d = (np.sqrt(((feats - fi[None]) ** 2).sum(-1)) * masks * mi[None]).sum((1, 2))
+            d += (np.abs(masks - mi[None]) * 80).sum((1, 2))
+            best = d if best is None else np.minimum(best, d)
+        dist[i] = best
+    dist = np.minimum(dist, dist.T)
+    np.fill_diagonal(dist, 0)
+    weight = np.array([counts[k] for k in keys], float)
+    rep, alive, work = np.arange(n), np.ones(n, bool), dist.copy()
+    np.fill_diagonal(work, np.inf)
+    w = weight.copy()
+    for _ in range(max(0, n - budget)):
+        cost = work * np.minimum(w[:, None], w[None, :])
+        i, j = np.unravel_index(np.argmin(cost), cost.shape)
+        if w[i] < w[j]:
+            i, j = j, i
+        rep[rep == j] = i
+        w[i] += w[j]
+        alive[j] = False
+        work[j, :] = work[:, j] = np.inf
+    medoids = sorted(set(rep.tolist()))
+    for _ in range(8):
+        label = dist[:, medoids].argmin(1)
+        new = []
+        for c in range(len(medoids)):
+            members = np.where(label == c)[0]
+            if len(members):
+                new.append(int(members[(dist[np.ix_(members, members)] * weight[members][:, None]).sum(0).argmin()]))
+        new = sorted(set(new))
+        if new == medoids:
+            break
+        medoids = new
+    chosen = {keys[i]: grids[medoids[c]] for i, c in enumerate(dist[:, medoids].argmin(1))}
+
+    def replace(q):
+        r = chosen[canonical(q)]
+        f0, m0 = colours[q], q > 0
+        return min((f(r) for f in FLIPS), key=lambda v: (np.sqrt(((colours[v] - f0) ** 2).sum(-1)) * (v > 0) * m0).sum()
+                   + (np.abs((v > 0).astype(int) - m0)).sum() * 80)
+
+    merged = {}
+    for name, index in indexed.items():
+        out = index.copy()
+        for (tx, ty), q in tiles_of(index).items():
+            if q.any():
+                out[ty * 8:ty * 8 + 8, tx * 8:tx * 8 + 8] = replace(q)
+        merged[name] = out
+    return merged, n, len(medoids)
+
+
+def unique_tiles(indexed):
+    return len({canonical(q) for index in indexed for q in tiles_of(index).values() if q.any()})
+
+
+def write_png(path, index, palette):
+    image = Image.fromarray(index, 'P')
+    flat = [0, 0, 0] + [int(v) for c in palette for v in c]
+    image.putpalette(flat + [0] * (768 - len(flat)))
+    image.save(path, optimize=False)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('--budget', type=int, default=OLDCITY_TILE_BUDGET)
+    args = parser.parse_args()
+    study = Image.open(STUDY).convert('RGBA')
+    rgba, scales = {}, {}
+    for name, box, cells in STYLES:
+        rgba[name], scales[name] = downsample(study, box, cells)
+    # The paired homes become a mirrored duplex: its right half reuses the left half's
+    # graphics flipped, which leaves room in the shared budget for the other buildings.
+    pair = rgba['teal-pair']
+    pair[:, pair.shape[1] // 2:] = pair[:, :pair.shape[1] // 2][:, ::-1]
+    palette = kit_palette()
+    indexed = {name: quantize(rgba[name], palette) for name in rgba}
+    merged, before, after = merge({n: indexed[n] for n in OLDCITY_STYLES}, palette, args.budget)
+    indexed.update(merged)
+    (OUT / 'art').mkdir(parents=True, exist_ok=True)
+    styles = []
+    for name, box, cells in STYLES:
+        path = OUT / 'art' / f'{name}.png'
+        write_png(path, indexed[name], palette)
+        styles.append(dict(id=name, studyCrop=list(box), cells=list(cells), scale=round(scales[name], 4),
+                           mergedForOldCity=name in OLDCITY_STYLES, uniqueTiles=unique_tiles([indexed[name]]),
+                           png=str(path.relative_to(ROOT)), sha256=hashlib.sha256(path.read_bytes()).hexdigest()))
+    manifest = dict(
+        schemaVersion=1, id='oldcity-buildings-art',
+        status='indexed native art derived from the approved city-v3 building study',
+        study=dict(png=str(STUDY.relative_to(ROOT)), sha256=hashlib.sha256(STUDY.read_bytes()).hexdigest()),
+        palette=dict(source=str(KIT_PALETTE.relative_to(ROOT)), bankSlot=12,
+                     note='index 0 transparent; the existing OldCore kit palette, unchanged', colours=palette.tolist()),
+        oldCityMerge=dict(styles=OLDCITY_STYLES, uniqueTilesBefore=before, uniqueTilesAfter=after, budget=args.budget),
+        styles=styles)
+    (OUT / 'art.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    print(json.dumps(dict(palette=len(palette), oldCityTiles=f'{before}->{after}',
+                          styles={s['id']: s['uniqueTiles'] for s in styles}), indent=1))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/taichung/streetscape/plan_fill.py b/tools/taichung/streetscape/plan_fill.py
new file mode 100644
index 0000000..33fc8f7
--- /dev/null
+++ b/tools/taichung/streetscape/plan_fill.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Join geographic lot proposals to prefab roles and dimensions, without painting maps.
+
+This checks the handoff between the independent geography and streetscape streams.
+It does not infer surveyed building footprints or validate final native traversal.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def read(path):
+    raw = path.read_bytes()
+    return json.loads(raw), hashlib.sha256(raw).hexdigest()
+
+
+def plan(draft, catalog, bindings):
+    for label, value in (('geography',draft),('catalog',catalog),('bindings',bindings)):
+        if value.get('schemaVersion') != 1:
+            raise ValueError('Unsupported ' + label + ' schema version')
+    sections = {s['id']: s for s in draft['sections']}
+    implemented = [p for p in catalog['prefabs'] if p.get('words')]
+    lots, usage = [], Counter()
+    undersized = Counter()
+    for lot in draft['unpaintedLotCandidates']:
+        section = sections[lot['section']]
+        recipe = section['fillRecipe']
+        if recipe['id'] not in bindings['recipeContexts']:
+            raise ValueError('Unmapped geography context: ' + recipe['id'])
+        contexts = bindings['recipeContexts'][recipe['id']]
+        categories = set()
+        for role in recipe['roles']:
+            if role not in bindings['roleCategories']:
+                raise ValueError('Unmapped geography role: ' + role)
+            categories.update(bindings['roleCategories'][role])
+        eligible, too_large = [], []
+        for prefab in implemented:
+            matches = [c for c in contexts if c in prefab['allowedContext']]
+            if prefab['role'] not in categories or not matches:
+                continue
+            if prefab['width'] > lot['width'] or prefab['height'] > lot['height']:
+                too_large.append(prefab['id'])
+                undersized[prefab['id']] += 1
+                continue
+            eligible.append(dict(prefabId=prefab['id'], role=prefab['role'],
+                                 placementContext=matches[0],
+                                 sizeIncludingApron=[prefab['width'],prefab['height']],
+                                 nativeTilesetRequirement=prefab['requires'],
+                                 artStatus=prefab['artStatus']))
+            usage[prefab['id']] += 1
+        buildings = [p for p in eligible if p['prefabId'].startswith('building-')]
+        if not buildings:
+            raise ValueError('No compatible building including its apron for lot ' + lot['id'])
+        lots.append(dict(lotId=lot['id'], section=lot['section'],
+                         localOrigin=lot['localOrigin'], lotSize=[lot['width'],lot['height']],
+                         recipe=recipe['id'], eligibleModules=eligible,
+                         contextCompatibleButTooLarge=too_large,
+                         selectedPrefabId=None, nativeMapId=None,
+                         status='unpainted module options; masks and authored geometry still require composition'))
+    return dict(schemaVersion=1,
+                status='cross-stream compatibility plan; no native maps or placements changed',
+                statistics=dict(sections=len(sections), lots=len(lots),
+                                implementedModules=len(implemented),
+                                modulesWithAtLeastOneCompatibleLot=len(usage),
+                                compatibleLotCountsByModule=dict(sorted(usage.items())),
+                                undersizedLotCountsByModule=dict(sorted(undersized.items()))),
+                lots=lots, missingSourceLayers=draft['missingLayers'],
+                unresolvedLandmarkReserveConflicts=draft['landmarkReserveConflicts'],
+                integrationConstraints=bindings['constraints'])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--draft',type=Path,default=ROOT/'docs/city-v2-streets.json')
+    parser.add_argument('--catalog',type=Path,default=ROOT/'data/taichung/prefabs/catalog.json')
+    parser.add_argument('--bindings',type=Path,default=ROOT/'data/taichung/prefabs/geography-bindings.json')
+    parser.add_argument('--output',type=Path,required=True)
+    args = parser.parse_args()
+    draft, dh = read(args.draft)
+    catalog, ch = read(args.catalog)
+    bindings, bh = read(args.bindings)
+    result = plan(draft,catalog,bindings)
+    result['inputSha256'] = dict(geographyDraft=dh,prefabCatalog=ch,geographyBindings=bh)
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
+    print(json.dumps({'result':'pass',**result['statistics']},indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/taichung/streetscape/xitun_streets.py b/tools/taichung/streetscape/xitun_streets.py
new file mode 100644
index 0000000..20becfe
--- /dev/null
+++ b/tools/taichung/streetscape/xitun_streets.py
@@ -0,0 +1,474 @@
+#!/usr/bin/env python3
+"""Xitun streets: road surfaces, the Shen Ji small home and the highway edge in
+the Xitun bank, plus the authored Xitun street layout.
+
+Every output is rebuilt from the reviewed baseline commit, so reruns are
+byte-identical. The Shen Ji house comes from Codex's city-v3 object library at
+LIBRARY_COMMIT and is copied into kit.json with its source hashes. Road surfaces
+follow the city-v3 road templates without the speckle texture, drawn in the
+existing Fengjia palette 9. The west edge is the shared edge kit
+(tools/taichung/nantun/edge_art.py) at its reserved slots; the north edge is the
+same carriageway turned east-west. Released Xitun metatiles, graphics and
+palettes are never modified: new definitions fill the released bank's empty,
+unreferenced slots and new graphics are appended.
+
+  xitun_streets.py kit     refresh data/taichung/xitun-streets/kit.json
+  xitun_streets.py bank    write the Xitun secondary bank
+  xitun_streets.py map     write the Xitun map from ground.txt + objects.json
+  xitun_streets.py save-table   print the save v8 relocation table for src/taichung_save.c
+"""
+import argparse
+import hashlib
+import importlib.util
+from io import BytesIO
+import json
+from pathlib import Path
+import struct
+import subprocess
+
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[3]
+_spec = importlib.util.spec_from_file_location("xitun_edge_art", Path(__file__).resolve().parents[1] / "nantun/edge_art.py")
+edge = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(edge)
+BASE = "a72bd0ea92d3ce41c0b67b1b470066a3b0cfe2d0"
+LIBRARY_COMMIT = "890b0caf238b371e8205ab1b09355ed13bb6c301"
+LIBRARY = "data/taichung/neighborhoods/city-v3-object-library.json"
+SECONDARY = "data/tilesets/secondary/taichung_xitun_landmarks"
+PRIMARY = "data/tilesets/primary/taichung_xitun_private"
+MAP = "data/layouts/TaichungXitun/map.bin"
+DATA = "data/taichung/xitun-streets"
+WIDTH, HEIGHT = 40, 64
+
+# The released bank defines 351 secondary metatiles (0x280-0x3DE); 64 of them
+# are empty (all-zero words and attribute) and nothing references them. New
+# Xitun definitions fill those slots in ascending order. The edge kit then
+# takes its reserved definitions 0x3E0-0x3EF (0x3DF stays empty) and graphics
+# 0x3E0-0x3FF, of which it uses 0x3E0-0x3F5. Xitun's own graphics append after
+# the 288 released tiles, below the kit; nothing references the eight
+# door-animation tiles at 1016..1023.
+RELEASED_DEFINITIONS, EMPTY_SLOTS = 351, 64
+FIRST_TILE, TILE_LIMIT = 288, 376
+HOUSE_PALETTE = 12
+ROAD_PALETTE = 9
+COVERED = 0x20000000
+
+# Fengjia palette 9 indices used by the road surfaces.
+ROAD_COLORS = {"A": 10, "Y": 8, "W": 1}
+PAVING_BOTTOM = (0x1152, 0x1153, 0x1162, 0x1163)
+
+WALK = 0x3000      # elevation 3, collision 0
+SOLID = 0x0400     # elevation 0, collision 1
+GROUND = {".": 0x001, ",": 0x175, ":": 0x1C1}
+# Solid ground: 'H' is the highway edge, '*' a primary shrub (city-v3
+# v3-prop-shrub) that closes a tree cut by the highway.
+SHRUB = 0x005
+HIGHWAY_WEST_COLUMNS, HIGHWAY_NORTH_ROWS = "WCE", "NMS"
+ROAD_CHARS = {"a": "asphalt", "-": "lane-horizontal", "|": "lane-vertical",
+              "!": "crosswalk-horizontal", "~": "crosswalk-vertical"}
+
+# Objects whose art already exists in the Xitun primary, as in the city-v3
+# library: exact metatile IDs, solid painted rows, and the clear south apron.
+EXISTING_OBJECTS = {
+    "stall": ("v3-stall-market-red", ((0x048, 0x049, 0x04A, 0x04B), (0x050, 0x051, 0x052, 0x053), (0x054, 0x055, 0x056, 0x057))),
+    "kiosk": ("v3-building-kiosk-glass", ((0x028, 0x029, 0x02A, 0x02B), (0x030, 0x031, 0x032, 0x033), (0x034, 0x035, 0x036, 0x037), (0x03C, 0x03E, 0x03E, 0x03F))),
+    "tree": ("v3-prop-tree-wide", ((0x00E, 0x00F), (0x016, 0x017))),
+    "tree-line": ("v3-prop-tree-line", ((0x00E, 0x00F, 0x00E, 0x00F), (0x016, 0x017, 0x016, 0x017))),
+    "flowers": ("v3-prop-flower-bed", ((0x004, 0x004, 0x004),)),
+    "brick-edge": ("v3-prop-low-brick-edge", ((0x17B, 0x17C, 0x17C, 0x17F),)),
+}
+
+
+def git_bytes(commit, path, source=ROOT):
+    return subprocess.run(["git", "-C", str(source), "show", f"{commit}:{path}"],
+                          check=True, capture_output=True).stdout
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def words(data):
+    return list(struct.unpack(f"<{len(data) // 2}H", data))
+
+
+def flipped(pixels, h, v):
+    return tuple(pixels[(7 - y if v else y) * 8 + (7 - x if h else x)] for y in range(8) for x in range(8))
+
+
+def road_patterns():
+    """city-v3 road templates (16x16 role grids) without speckle."""
+    def blank():
+        return [["A"] * 16 for _ in range(16)]
+    out = {"asphalt": blank()}
+    grid = out["lane-horizontal"] = blank()
+    for x in range(3, 13):
+        grid[7][x] = grid[8][x] = "Y"
+    grid = out["lane-vertical"] = blank()
+    for y in range(3, 13):
+        grid[y][7] = grid[y][8] = "Y"
+    grid = out["crosswalk-horizontal"] = blank()
+    for x in (1, 5, 9, 13):
+        for y in range(2, 14):
+            grid[y][x] = grid[y][x + 1] = "W"
+    grid = out["crosswalk-vertical"] = blank()
+    for y in (1, 5, 9, 13):
+        for x in range(2, 14):
+            grid[y][x] = grid[y + 1][x] = "W"
+    return out
+
+
+def highway_rows():
+    """The edge kit's carriageway turned east-west for the north edge, as
+    {name: 16x16 grid of primary palette 2 indices}. Rows N, M and S are the
+    kit's W, C and E columns: westbound lanes north of the median, eastbound
+    south (driving on the right). One westbound and one eastbound car keep the
+    kit's sprites and east-side shadow and each sits inside one quadrant row."""
+    strip = [[edge.profile(y, x) for x in range(16)] for y in range(48)]
+    out = {f"highway-{row}": [r[:] for r in strip[16 * i:16 * i + 16]] for i, row in enumerate(HIGHWAY_NORTH_ROWS)}
+
+    def car(name, row, colors, x0, y0, westbound):
+        grid = out[name] = [r[:] for r in out[f"highway-{row}"]]
+        length = len(edge.CAR)
+        for i, line in enumerate(edge.CAR):
+            for j, ch in enumerate(line):
+                if ch != " ":
+                    grid[y0 + j][x0 + (i if westbound else length - 1 - i)] = colors[ch]
+        for j in range(1, len(edge.CAR[0]) - 1):
+            grid[y0 + j][x0 + length] = edge.DARK
+
+    car("highway-N-red", "N", edge.BODIES["red"], 2, 8, westbound=True)
+    car("highway-S-blue", "S", edge.BODIES["blue"], 3, 3, westbound=False)
+    return out
+
+
+def highway_name(x, y):
+    """Bank name of the highway edge at (x, y): the kit's carriageway down
+    x0-2, the turned carriageway along y0-2 east of it, with a little traffic."""
+    if x < 3:
+        return f"highway-{edge.lane_variant(HIGHWAY_WEST_COLUMNS[x], x, y, 0)}"
+    row = HIGHWAY_NORTH_ROWS[y]
+    car = {"N": "N-red" if x % 9 == 5 else "N", "S": "S-blue" if x % 11 == 8 else "S"}.get(row, row)
+    return f"highway-{car}"
+
+
+def read_pal(data):
+    lines = data.decode().splitlines()[3:]
+    return [tuple(map(int, line.split())) for line in lines if line.strip()]
+
+
+def write_pal(colors):
+    lines = ["JASC-PAL", "0100", "16"] + [f"{r} {g} {b}" for r, g, b in colors]
+    return ("\r\n".join(lines) + "\r\n").encode()
+
+
+def extract_kit(source=ROOT):
+    """Copy the pinned Shen Ji small home into a self-contained kit."""
+    raw = git_bytes(LIBRARY_COMMIT, LIBRARY, source)
+    library = json.loads(raw)
+    entry = next(e for e in library["entries"] if e["id"] == "v3-shenji-small-home")
+    bank = library["banks"]["shenji-current"]
+    require(entry["sourcePaletteBanks"] == [9], "Shen Ji home must use only source palette 9")
+    cells, metatiles, graphics = [], {}, {}
+    for row in entry["cells"]:
+        out = []
+        for cell in row:
+            if cell is None:
+                out.append(None)
+                continue
+            require(cell["bank"] == "shenji-current" and cell["copyMode"] == "foreground", "unexpected Shen Ji cell")
+            source_entry = bank["metatiles"][str(cell["metatile"])]
+            top = [int(w, 16) for w in source_entry["entries"][4:]]
+            for w in top:
+                require(w >> 12 == 9, "Shen Ji top layer must use palette 9")
+                graphics[str(w & 0x3FF)] = bank["graphicsIndexed8x8"][str(w & 0x3FF)]
+            metatiles[str(cell["metatile"])] = {"top": [f"0x{w:04X}" for w in top], "attribute": source_entry["attribute"]}
+            out.append(cell["metatile"])
+        cells.append(out)
+    return {
+        "schemaVersion": 1,
+        "source": {"commit": LIBRARY_COMMIT, "path": LIBRARY, "sha256": sha256(raw),
+                   "entry": entry["id"], "bank": "shenji-current", "sourcePalette": 9,
+                   "renderedPngSha256": entry["renderedPngSha256"]},
+        "palette": bank["palettesRgb8"]["9"],
+        "masks": entry["masks"],
+        "cells": cells,
+        "metatiles": dict(sorted(metatiles.items(), key=lambda kv: int(kv[0]))),
+        "graphics": dict(sorted(graphics.items(), key=lambda kv: int(kv[0]))),
+    }
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+class Baseline:
+    def __init__(self, source=ROOT):
+        image = Image.open(BytesIO(git_bytes(BASE, f"{SECONDARY}/tiles.png", source)))
+        require(image.mode == "P" and image.width == 128, "unexpected Xitun secondary tile image")
+        self.image_palette = image.getpalette()
+        self.tiles = [tuple(image.getpixel(((n % 16) * 8 + x, (n // 16) * 8 + y)) for y in range(8) for x in range(8))
+                      for n in range((image.height // 8) * 16)]
+        require(len(self.tiles) == FIRST_TILE, "baseline secondary must load 288 tiles")
+        self.metatiles = words(git_bytes(BASE, f"{SECONDARY}/metatiles.bin", source))
+        data = git_bytes(BASE, f"{SECONDARY}/metatile_attributes.bin", source)
+        self.attributes = list(struct.unpack(f"<{len(data) // 4}I", data))
+        require(len(self.metatiles) == 8 * len(self.attributes) == 8 * RELEASED_DEFINITIONS, "baseline secondary must define 351 metatiles")
+        self.empty = [n for n in range(RELEASED_DEFINITIONS) if not any(self.metatiles[n * 8:n * 8 + 8]) and self.attributes[n] == 0]
+        require(len(self.empty) == EMPTY_SLOTS, "baseline secondary must have 64 empty definitions")
+        self.palette12 = read_pal(git_bytes(BASE, f"{SECONDARY}/palettes/12.pal", source))
+        require(all(c == (0, 0, 0) for c in self.palette12[1:]), "baseline palette 12 must be unused")
+        self.map = words(git_bytes(BASE, MAP, source))
+        require(len(self.map) == WIDTH * HEIGHT, "unexpected baseline Xitun map size")
+
+
+class Allocator:
+    """Append 8x8 graphics, reusing any secondary pattern equal under flips."""
+    def __init__(self, tiles):
+        self.tiles = list(tiles)
+        self.index = {}
+        for n, pixels in enumerate(self.tiles):
+            if any(pixels):
+                self.remember(n, pixels)
+
+    def remember(self, n, pixels):
+        for h in (0, 1):
+            for v in (0, 1):
+                self.index.setdefault(flipped(pixels, h, v), (n, h, v))
+
+    def word(self, pixels, palette):
+        if not any(pixels):
+            return 0
+        if pixels not in self.index:
+            self.tiles.append(pixels)
+            require(len(self.tiles) <= edge.GRAPHICS_BASE - 640, "Xitun secondary graphics would reach the edge-kit slots")
+            self.remember(len(self.tiles) - 1, pixels)
+        n, h, v = self.index[pixels]
+        return (640 + n) | (h << 10) | (v << 11) | (palette << 12)
+
+
+def quadrants(grid):
+    return [tuple(grid[qy * 8 + y][qx * 8 + x] for y in range(8) for x in range(8)) for qy in (0, 1) for qx in (0, 1)]
+
+
+def build_bank(kit, source=ROOT):
+    base = Baseline(source)
+    alloc = Allocator(base.tiles)
+    metatiles, attributes, names = list(base.metatiles), list(base.attributes), {}
+    empty = list(base.empty)
+
+    def add(name, entries, attribute):
+        require(empty, "Xitun has no empty released definition left")
+        n = empty.pop(0)
+        metatiles[n * 8:n * 8 + 8] = entries
+        attributes[n] = attribute
+        names[name] = 0x280 + n
+
+    for name, grid in road_patterns().items():
+        indexed = [[ROAD_COLORS[c] for c in row] for row in grid]
+        add(name, [alloc.word(q, ROAD_PALETTE) for q in quadrants(indexed)] + [0, 0, 0, 0], 0)
+    for source_id, cell in kit["metatiles"].items():
+        top = []
+        for w in (int(x, 16) for x in cell["top"]):
+            pixels = flipped(tuple(kit["graphics"][str(w & 0x3FF)]), w & 0x400, w & 0x800)
+            top.append(alloc.word(pixels, HOUSE_PALETTE))
+        add(f"shenji-{source_id}", list(PAVING_BOTTOM) + top, int(cell["attribute"], 16) & COVERED)
+    for name, grid in highway_rows().items():
+        add(name, [alloc.word(q, edge.PALETTE_SLOT) for q in quadrants(grid)] + [0, 0, 0, 0], 0)
+
+    own_tiles = len(alloc.tiles)
+    compiled = {"graphics": alloc.tiles, "metatiles": [metatiles[n * 8:n * 8 + 8] for n in range(len(attributes))],
+                "attributes": attributes}
+    edge_kit = edge.encode(compiled)
+    metatiles = [w for entries in compiled["metatiles"] for w in entries]
+    require(len(alloc.tiles) <= TILE_LIMIT, "Edge kit graphics would reach the door-animation tiles")
+    for name, mid in edge.HIGHWAY.items():
+        names[f"highway-{name}"] = mid
+
+    rows = (len(alloc.tiles) + 15) // 16
+    image = Image.new("P", (128, rows * 8))
+    image.putpalette(base.image_palette)
+    for n, pixels in enumerate(alloc.tiles):
+        for i, value in enumerate(pixels):
+            image.putpixel(((n % 16) * 8 + i % 8, (n // 16) * 8 + i // 8), value)
+    png = BytesIO()
+    image.save(png, format="PNG", optimize=False)
+    palette = [tuple(c) for c in kit["palette"]]
+    files = {
+        f"{SECONDARY}/tiles.png": png.getvalue(),
+        f"{SECONDARY}/metatiles.bin": struct.pack(f"<{len(metatiles)}H", *metatiles),
+        f"{SECONDARY}/metatile_attributes.bin": struct.pack(f"<{len(attributes)}I", *attributes),
+        f"{SECONDARY}/palettes/12.pal": write_pal(palette),
+    }
+    manifest = {
+        "base": BASE,
+        "kitSha256": sha256(canonical(kit)),
+        "metatiles": {name: f"0x{mid:03X}" for name, mid in names.items()},
+        "firstNewTile": FIRST_TILE,
+        "xitunTiles": own_tiles,
+        "newXitunTiles": own_tiles - FIRST_TILE,
+        "loadedTiles": len(alloc.tiles),
+        "definitions": len(attributes),
+        "emptyReleasedSlotsFilled": EMPTY_SLOTS - len(empty),
+        "emptyReleasedSlotsLeft": len(empty),
+        "edgeKit": {"source": "tools/taichung/nantun/edge_art.py", **edge_kit},
+        "palettes": {"house": HOUSE_PALETTE, "road": ROAD_PALETTE, "highway": edge.PALETTE_SLOT},
+        "files": {path: sha256(data) for path, data in files.items()},
+    }
+    return files, manifest
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+
+
+def compose_map(kit, bank_manifest, ground_text, objects, source=ROOT):
+    """Return (map words, report). Raises on any unsafe placement."""
+    base = Baseline(source)
+    names = {k: int(v, 16) for k, v in bank_manifest["metatiles"].items()}
+    rows = [line for line in ground_text.splitlines() if line and not line.startswith("#")]
+    require(len(rows) == HEIGHT and all(len(r) == WIDTH for r in rows), "ground.txt must be 64 rows of 40 characters")
+    grid = list(base.map)
+    owner = {}
+    for y, row in enumerate(rows):
+        for x, c in enumerate(row):
+            if c == "=":
+                owner[(x, y)] = "baseline"
+            elif c == "H":
+                owner[(x, y)] = "highway"
+                grid[y * WIDTH + x] = SOLID | names[highway_name(x, y)]
+            elif c == "*":
+                owner[(x, y)] = "shrub"
+                grid[y * WIDTH + x] = SOLID | SHRUB
+            elif c in GROUND:
+                grid[y * WIDTH + x] = WALK | GROUND[c]
+            elif c in ROAD_CHARS:
+                grid[y * WIDTH + x] = WALK | names[ROAD_CHARS[c]]
+            else:
+                raise ValueError(f"unknown ground character {c!r} at {x},{y}")
+    aprons = set()
+    for n, obj in enumerate(objects):
+        kind, ox, oy = obj["type"], obj["x"], obj["y"]
+        label = f"{kind}#{n}@{ox},{oy}"
+        if kind == "shenji-home":
+            painted = [[None if s is None else names[f"shenji-{s}"] for s in row] for row in kit["cells"]]
+            painted = [r for r in painted if any(v is not None for v in r)]
+        else:
+            painted = [list(r) for r in EXISTING_OBJECTS[kind][1]]
+        for dy, row in enumerate(painted):
+            for dx, mid in enumerate(row):
+                if mid is None:
+                    continue
+                pos = (ox + dx, oy + dy)
+                require(0 <= pos[0] < WIDTH and 0 <= pos[1] < HEIGHT, f"{label} leaves the map")
+                require(pos not in owner, f"{label} overlaps {owner.get(pos)} at {pos}")
+                require(pos not in aprons, f"{label} covers an apron at {pos}")
+                owner[pos] = label
+                grid[pos[1] * WIDTH + pos[0]] = SOLID | mid
+        for dx in range(len(painted[0])):
+            pos = (ox + dx, oy + len(painted))
+            require(pos not in owner, f"{label} apron at {pos} is covered by {owner.get(pos)}")
+            aprons.add(pos)
+    for pos in aprons:
+        require(grid[pos[1] * WIDTH + pos[0]] & 0x0C00 == 0, f"apron {pos} must be walkable")
+    reach = reachable(grid, FENGJIA_ARRIVAL)
+    open_cells = {(x, y) for y in range(HEIGHT) for x in range(WIDTH) if walkable(grid, x, y)}
+    require(open_cells == reach, f"unreachable walkable cells: {sorted(open_cells - reach)[:12]}")
+    for name, pos in FIXED_WALKABLE.items():
+        require(pos in reach, f"{name} {pos} must stay walkable and reachable")
+    blocked = sorted(((x, y) for y in range(HEIGHT) for x in range(WIDTH)
+                      if walkable(base.map, x, y) and not walkable(grid, x, y)), key=lambda p: (p[1], p[0]))
+    report = {
+        "changedCells": sum(a != b for a, b in zip(grid, base.map)),
+        "walkable": len(open_cells),
+        "newlyBlocked": len(blocked),
+        "newlyWalkable": sum(1 for pos in open_cells if not walkable(base.map, *pos)),
+    }
+    return grid, base, blocked, report
+
+
+FENGJIA_ARRIVAL = (24, 15)
+# Door approaches, arrivals and the Greenway seam rows.
+FIXED_WALKABLE = {
+    "fengjia approach": (24, 13), "fengjia arrival": (24, 15),
+    "maple approach": (12, 33), "maple arrival": (12, 35),
+    "theater arrival": (12, 47),
+    **{f"greenway seam {y}": (39, y) for y in range(56, 60)},
+}
+
+
+def repair_targets(grid, blocked):
+    """Nearest open cell for every newly blocked one: shortest Manhattan
+    distance, then south, west, east, north, then row-major. Door warps and
+    tall grass are never targets."""
+    open_cells = [(x, y) for y in range(HEIGHT) for x in range(WIDTH)
+                  if walkable(grid, x, y) and (x, y) not in DOORS and grid[y * WIDTH + x] & 0x3FF != TALL_GRASS]
+    def key(src, dst):
+        dx, dy = dst[0] - src[0], dst[1] - src[1]
+        side = 0 if dy > 0 else 1 if dx < 0 else 2 if dx > 0 else 3
+        return (abs(dx) + abs(dy), side, dst[1], dst[0])
+    return [(src, min(open_cells, key=lambda dst: key(src, dst))) for src in blocked]
+
+
+DOORS = {(24, 12), (12, 32), (12, 44)}
+TALL_GRASS = 0x00D
+
+
+def save_table(repairs, map_sha):
+    lines = [f"// Xitun v8 PREPARATION ONLY, street layout from data/taichung/xitun-streets; native acceptance pending.",
+             f"// Xitun map SHA256 {map_sha}",
+             f"// Generated by tools/taichung/streetscape/xitun_streets.py: each of the {len(repairs)} newly blocked cells moves to its nearest open cell.",
+             "static const struct SavedPositionRelocation sXitunV8Relocations[] =", "{"]
+    lines += [f"    {{{sx}, {sy}, {tx}, {ty}}}," for (sx, sy), (tx, ty) in repairs]
+    return "\n".join(lines + ["};"]) + "\n"
+
+
+def walkable(grid, x, y):
+    return 0 <= x < WIDTH and 0 <= y < HEIGHT and grid[y * WIDTH + x] & 0x0C00 == 0
+
+
+def reachable(grid, start):
+    seen, todo = {start}, [start]
+    while todo:
+        x, y = todo.pop()
+        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
+            if (nx, ny) not in seen and walkable(grid, nx, ny):
+                seen.add((nx, ny))
+                todo.append((nx, ny))
+    return seen
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("command", choices=("kit", "bank", "map", "save-table"))
+    parser.add_argument("--source", type=Path, default=ROOT)
+    args = parser.parse_args()
+    data = args.source / DATA
+    if args.command == "kit":
+        data.mkdir(parents=True, exist_ok=True)
+        (data / "kit.json").write_text(json.dumps(extract_kit(args.source), indent=1) + "\n")
+        print(data / "kit.json")
+        return
+    kit = json.loads((data / "kit.json").read_text())
+    if args.command == "bank":
+        files, manifest = build_bank(kit, args.source)
+        for path, content in files.items():
+            (args.source / path).write_bytes(content)
+        (data / "bank.json").write_text(json.dumps(manifest, indent=1) + "\n")
+        print(json.dumps({k: manifest[k] for k in ("xitunTiles", "loadedTiles", "definitions", "emptyReleasedSlotsLeft")}))
+        return
+    manifest = json.loads((data / "bank.json").read_text())
+    grid, base, blocked, report = compose_map(kit, manifest, (data / "ground.txt").read_text(),
+                                              json.loads((data / "objects.json").read_text())["objects"], args.source)
+    packed = struct.pack(f"<{len(grid)}H", *grid)
+    if args.command == "save-table":
+        print(save_table(repair_targets(grid, blocked), sha256(packed)), end="")
+    else:
+        (args.source / MAP).write_bytes(packed)
+        print(json.dumps(report))
+
+
+if __name__ == "__main__":
+    main()
