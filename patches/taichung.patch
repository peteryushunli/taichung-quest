+#!/usr/bin/env python3
+"""Nantun North and Wanhe cell layout on the city-rework master plan (world coordinates).
+
+The fill pass the user approved on 2026-11-09 is the master plan's cell file (plan-cells.txt,
+one class per cell) and its art (plan.png, drawn with live metatiles), copied with the plan
+into data/taichung/nantun/rework. Every cell outside the city kit takes the metatile plan.png
+draws there (build_rework.py reads it off the art); streets, water, highway and the freeway's
+wall come from the master plan (plan_mask.py) and build_rework.py paints them with the kit.
+These differ from plan.png on purpose:
+  - landmarks 18-20 are set pieces in real tiles (landmark_art.py) on their plan rects;
+  - a lot whose secondary art reaches into a seam strip takes the primary red terrace, with a
+    hedge behind it and paving beside it, since a neighbour on another bank draws strip cells
+    with its own tileset; so does a lot plan.png draws with another district's homes;
+  - a park or path cell plan.png draws with art outside the bank (a railing or bank edge on the
+    water) takes the nearest live art of its class; build_rework.py then puts the kit's railing
+    on every sidewalk-paver cell on a bank;
+  - the temple signs stand one row up off today's spot, which became a sidewalk;
+  - build_rework.py adds the road signs, and crosswalks where a park path crosses a street.
+  - build_rework.py hedges an open cell on the North/Wanhe seam whose neighbour across it is
+    blocked (Wenxin's grass over a lot, an alley under a tree), which validate_city rejects;
+    on the Xitun seam, where Xitun builds the plan's open row above a North hedge, the hedge
+    takes paving instead.
+"""
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import landmark_art  # noqa: E402
+from plan_mask import highway_cells, rect_cells, street_cells, water_cells  # noqa: E402
+
+MAPS = {"north": (-5, 64, 40, 104), "wanhe": (-5, 104, 80, 176)}
+# Neighbours on other banks draw our cells inside their map buffer (7 tiles west, north and
+# south of the map, 8 east) with their own tilesets, so those cells stay kit or primary pieces.
+FOREIGN = {"north": ["xitun", "greenway"], "wanhe": ["greenway", "oldcity"]}
+KIT_CLASSES, PATHS = set("HSs~bW"), set("pb")
+# The primary red terrace, 4 wide with its doors on the bottom row, as plan.png draws it on the
+# homes along the freeway's wall.
+TERRACE = ((0x048, 0x049, 0x04A, 0x04B), (0x050, 0x051, 0x052, 0x053), (0x054, 0x055, 0x056, 0x057))
+HEDGE, PAVING = 0x005, 0x16E
+# The temple signs' spot today (world) became the W139 sidewalk; each moves one row up.
+OLD_SIGNS = [(14, 139), (29, 139)]
+CANDIDATES = {"H": "Wenxin Forest Park amphitheatre", "F": "Cultural Heritage Park", "G": "Fengle Sculpture Park"}
+
+
+def read_cells(text):
+    """plan-cells.txt -> {(x, y): class} in world coordinates. Three header lines; the first
+    names the first column and row ("x -5..123 ..., y -5..175 ...")."""
+    lines = text.split("\n")
+    x0, y0 = (int(re.search(rf"\b{axis} (-?\d+)\.\.", lines[0]).group(1)) for axis in "xy")
+    return {(x + x0, y + y0): ch for y, row in enumerate(lines[3:]) for x, ch in enumerate(row)}
+
+
+def candidate(plan, key):
+    for c in plan.get("newLandmarks", []):
+        if c["name"] == CANDIDATES[key]:
+            return c["rect"]
+    return None
+
+
+def number(plan, key):
+    for c in plan.get("newLandmarks", []):
+        if c["name"] == CANDIDATES[key]:
+            return str(c["n"])
+    return key
+
+
+class Layout:
+    def __init__(self, name, plan, cells):
+        self.name, self.plan, self.plan_cells = name, plan, cells
+        self.x0, self.y0, self.x1, self.y1 = MAPS[name]
+        self.streets = street_cells(plan)
+        self.water = water_cells(plan)
+        self.highway = highway_cells(plan)
+        self.fixed = set(self.streets) | self.water | self.highway
+        self.cls = {c: cells[c] for c in self.cells()}
+        self.art, self.pieces, self.notes, self.terraced, self.seam_hedges, self.kerbs, self.stand_ins = {}, [], [], [], [], [], []
+        self.rails, self.unrailed, self.seam_openings = {}, [], []
+        strips = set()
+        for other in FOREIGN[name]:
+            x0, y0, x1, y1 = plan["districts"][other]["plan"]
+            strips |= rect_cells(x0 - 7, y0 - 7, x1 + 8, y1 + 7)
+        self.strip_cells = {c for c in strips if self.inside(*c)}
+
+    def cells(self):
+        return [(x, y) for y in range(self.y0, self.y1) for x in range(self.x0, self.x1)]
+
+    def inside(self, x, y):
+        return self.x0 <= x < self.x1 and self.y0 <= y < self.y1
+
+    def walk(self, cell):
+        """A paved way outside the street grid: a park path, or a sidewalk of its own (the canal walk)."""
+        k = self.plan_cells.get(cell)
+        return k in PATHS or (k == "s" and cell not in self.streets)
+
+    def crossing(self, cell):
+        """A path or walk runs across the street here: the cells just past both sidewalks are one."""
+        x, y = cell
+        for s in self.plan["streetsNorthSouth"]:
+            c = s["firstAsphaltCol"]
+            if s["y0"] <= y < s["y1"] and c <= x <= c + 2:
+                if self.walk((c - 2, y)) and self.walk((c + 4, y)):
+                    return "st-ns-crosswalk"
+        for s in self.plan["streetsEastWest"]:
+            r = s["firstAsphaltRow"]
+            if s["x0"] <= x < s["x1"] and r <= y <= r + 2:
+                if self.walk((x, r - 2)) and self.walk((x, r + 4)):
+                    return "st-ew-crosswalk"
+        return None
+
+    def railings(self):
+        """Walk, path and plaza cells on a bank (not a bridge): the kit's railing goes on these."""
+        return sorted([x, y] for (x, y), k in self.cls.items() if k in "sp.P" and (x, y) not in self.water
+                      and any(self.plan_cells.get(n) == "~" for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1))))
+
+    def lots(self):
+        """The plan's building lots ('B'), each a rectangle (x0, y0, x1, y1)."""
+        todo, out = {c for c, k in self.cls.items() if k == "B"}, []
+        while todo:
+            seen, stack = set(), [min(todo)]
+            while stack:
+                c = stack.pop()
+                if c in todo and c not in seen:
+                    seen.add(c)
+                    x, y = c
+                    stack += [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
+            todo -= seen
+            xs, ys = [c[0] for c in seen], [c[1] for c in seen]
+            r = (min(xs), min(ys), max(xs) + 1, max(ys) + 1)
+            if rect_cells(*r) != seen:
+                raise ValueError(f"{self.name}: lot at {r[:2]} is not a rectangle")
+            out.append(r)
+        return sorted(out, key=lambda r: (r[1], r[0]))
+
+    def terrace(self, r, why):
+        """Primary red terraces along the lot's front (bottom) row, a hedge behind, paving beside."""
+        x0, y0, x1, y1 = r
+        if x1 - x0 < 4 or y1 - y0 < 3:
+            raise ValueError(f"{self.name}: lot {r} has no room for a terrace")
+        for c in rect_cells(*r):
+            self.art[c] = HEDGE if c[1] < y1 - 3 else PAVING
+        n = (x1 - x0) // 4
+        for i in range(n):
+            for j, row in enumerate(TERRACE):
+                for k, m in enumerate(row):
+                    self.art[(x0 + 4 * i + k, y1 - 3 + j)] = m
+        self.terraced.append({"lot": list(r), "terraces": n, "why": why})
+
+    def stand_in(self, c):
+        """The nearest live art of the cell's class: a tree part three columns along (trees
+        repeat every third column), anything else by distance."""
+        k, (x, y) = self.cls[c], c
+        if k in "Tt":
+            near = [(x + d, y) for n in range(1, 8) for d in (-3 * n, 3 * n)]
+        else:
+            near = sorted((o for o, ok in self.cls.items() if ok == k and o != c),
+                          key=lambda o: (abs(o[0] - x) + abs(o[1] - y), o[0] != x, o))
+        for o in near:
+            if self.cls.get(o) == k and self.art.get(o) is not None:
+                self.stand_ins.append({"cell": list(c), "class": k, "from": list(o)})
+                return self.art[o]
+        raise ValueError(f"{self.name}: no live {k!r} art near {c}")
+
+
+def build(name, plan, cells, art):
+    """art: {(x, y): the metatile plan.png draws there, or None where it draws no live metatile}."""
+    lay = Layout(name, plan, cells)
+    for c, k in lay.cls.items():
+        # Street cells are asphalt or sidewalk; a sidewalk may also stand off the grid as a walk.
+        if (k == "H") != (c in lay.highway) or (c in lay.streets and k not in "Ss") \
+                or (k == "S" and c not in lay.streets) \
+                or (k in "~b") != (c in lay.water and c not in lay.streets and c not in lay.highway):
+            raise ValueError(f"{name}: plan cell {c} '{k}' disagrees with the master plan's geometry")
+
+    # Landmarks 18-20: set pieces in real tiles on their plan rects.
+    pieces = {b["name"]: b for b in landmark_art.build_all().values()}
+    for key in ("H", "F", "G"):
+        r = candidate(plan, key)
+        if not r or not any(lay.inside(*c) for c in rect_cells(*r)):
+            continue
+        piece, (x0, y0) = pieces[CANDIDATES[key]], r[:2]
+        if piece["spec"]["size"] != (r[2] - x0, r[3] - y0) or any(lay.cls[c] != "L" for c in rect_cells(*r)):
+            raise ValueError(f"{name}: {piece['name']} does not fit {r}")
+        lay.pieces.append({"n": number(plan, key), "name": piece["name"], "rect": r, "spec": piece["spec"],
+                           "signs": [(x0 + lx, y0 + ly) for lx, ly in piece["spec"]["signs"]],
+                           **{k: v for k, v in piece["count"].items() if k not in ("tile_keys", "blocked")}})
+    landmark = set().union(*(rect_cells(*p["rect"]) for p in lay.pieces))
+
+    # Every other cell outside the kit draws plan.png's metatile.
+    for c, k in lay.cls.items():
+        if k not in KIT_CLASSES and c not in landmark:
+            if k == "L":
+                raise ValueError(f"{name}: landmark cell {c} outside every set piece")
+            lay.art[c] = art[c]
+    if not any(all(lay.art.get((x + i, y + j)) == m for j, row in enumerate(TERRACE) for i, m in enumerate(row))
+               for x, y in lay.art):
+        raise ValueError(f"plan.png draws no primary red terrace in {name}")
+    for r in lay.lots():
+        strip = rect_cells(*r) & lay.strip_cells
+        if any(lay.art[c] is None or lay.art[c] >= 640 for c in strip):
+            lay.terrace(r, "strip")
+        elif any(lay.art[c] is None for c in rect_cells(*r)):
+            lay.terrace(r, "art")
+    for c in sorted(c for c, n in lay.art.items() if n is None and lay.cls[c] != "B"):
+        lay.art[c] = lay.stand_in(c)
+    missing = sorted(c for c, n in lay.art.items() if n is None)
+    if missing:
+        raise ValueError(f"{name}: plan.png draws no live metatile at {missing[:6]}")
+
+    for x, y in OLD_SIGNS:
+        if lay.inside(x, y):
+            if (x, y) not in lay.streets or lay.cls[(x, y - 1)] in KIT_CLASSES:
+                raise ValueError(f"Temple sign at {(x, y)}: no free cell one row up")
+            lay.notes.append({"type": "sign-moved", "from": [x, y], "to": [x, y - 1]})
+    return lay
