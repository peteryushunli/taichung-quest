+#!/usr/bin/env python3
+"""Authored Xitun street layout: writes data/taichung/xitun-streets/ground.txt
+and objects.json, which xitun_streets.py composes into the Xitun map.
+
+ground.txt is 64 rows of 40 cells: '=' keeps the released word, '.' grass,
+',' pavers, ':' frontage pavers, road surfaces 'a' asphalt, '-'/'|' lane
+lines, '!'/'~' crosswalks, 'H' the highway edge and '*' a shrub. objects.json
+places stalls, kiosks, trees, flower beds and Shen Ji homes by their top-left
+cell.
+
+The world's west and north edges are highway, not tree walls: the shared edge
+kit down x0-2 (it continues south into Nantun North) and the same carriageway
+turned east-west along y0-2. Seams stay street connections.
+
+Neighbours draw the Xitun cells they can see with their own banks. Greenway
+sees x33-39 from row 25 down and Nantun North sees rows 57-63, so those cells
+hold only primary art or the edge kit: no road surface or Shen Ji home there.
+
+  xitun_streets_layout.py          rewrite both files
+"""
+import argparse
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+DATA = "data/taichung/xitun-streets"
+WIDTH, HEIGHT = 40, 64
+
+
+def layout():
+    """Return (ground.txt text, objects.json text)."""
+    g = [["="] * WIDTH for _ in range(HEIGHT)]
+    objs = []
+
+    def fill(x0, y0, x1, y1, c):
+        for y in range(y0, y1 + 1):
+            for x in range(x0, x1 + 1):
+                g[y][x] = c
+
+    def obj(kind, x, y):
+        objs.append({"type": kind, "x": x, "y": y})
+
+    # Highway edges: x0-2 replace the west tree wall and its path, y0-2 the
+    # north one. Shrubs close the trees the highway cuts in half.
+    fill(0, 0, 2, 63, "H"); fill(3, 0, 39, 2, "H")
+    fill(3, 3, 14, 3, "*"); fill(38, 3, 39, 3, "*"); fill(3, 62, 3, 63, "*")
+    # Fengjia Road (E-W) y16-18, sidewalks y15 and y19
+    fill(3, 15, 31, 15, ",")
+    fill(3, 16, 31, 16, "a"); fill(3, 17, 31, 17, "-"); fill(3, 18, 31, 18, "a")
+    fill(3, 19, 25, 19, ",")
+    # Xitun Road (N-S) x26-28 from y16 to y56, sidewalks x25 and x29; it ends
+    # at the promenade, and pavers carry on to the south edge.
+    fill(26, 16, 28, 56, "a"); fill(27, 19, 27, 55, "|")
+    fill(26, 16, 28, 18, "a")
+    fill(25, 19, 25, 61, ","); fill(29, 19, 29, 61, ","); fill(26, 57, 28, 61, ",")
+    # The Nantun North seam: x26-29 at rows 62-63 are pavers (word 0x3175), as
+    # Nantun's build writes them. The connection itself is Nantun's.
+    fill(26, 62, 29, 63, ",")
+    # crosswalks around the Fengjia/Xitun intersection
+    fill(24, 16, 24, 18, "!"); fill(29, 16, 29, 18, "!")
+    fill(26, 19, 28, 19, "~")
+    # Theater Road (E-W) y48-50 x3-25, sidewalks y47 and y51
+    fill(3, 47, 25, 47, ","); fill(3, 48, 25, 48, "a"); fill(3, 49, 25, 49, "-"); fill(3, 50, 25, 50, "a"); fill(3, 51, 24, 51, ",")
+    fill(26, 48, 28, 50, "a"); fill(25, 48, 25, 50, "!")
+    fill(26, 47, 28, 47, "~"); fill(26, 51, 28, 51, "~")
+    # The released paver promenade y56-59 still runs from the end of Xitun Road
+    # to the Greenway seam.
+    # East block x29-37, y20-55, replacing the tree belt. Homes south of row 24
+    # sit at x29-32 on the sidewalk line; x34-37 holds primary stalls/kiosks.
+    fill(30, 3, 37, 55, ",")
+    rows = [(20, (("shenji-home", 30), ("shenji-home", 34))), (25, (("tree-line", 30), ("tree-line", 34))),
+            (28, (("shenji-home", 29), ("kiosk", 34))), (33, (("shenji-home", 29), ("stall", 34))),
+            (38, (("stall", 30), ("stall", 34))), (42, (("shenji-home", 29), ("kiosk", 34))),
+            (47, (("tree-line", 30), ("flowers", 35))), (50, (("shenji-home", 29), ("stall", 34)))]
+    for y, pair in rows:
+        for kind, x in pair:
+            obj(kind, x, y)
+    # North-east corner beside Fengjia: home and kiosk below the highway, then
+    # two stalls
+    obj("shenji-home", 30, 3); obj("kiosk", 34, 3); obj("stall", 30, 8); obj("stall", 34, 8)
+    fill(29, 3, 29, 14, ",")
+    # Fengjia market row north of the gate: two stalls on paving
+    fill(19, 3, 28, 6, ",")
+    obj("stall", 19, 3); obj("stall", 23, 3)
+    # Fengjia frontage pavers, keeping the sign and the door approach words
+    fill(16, 13, 31, 14, ":"); g[14][21] = "="; g[13][24] = "="
+    # Maple park: tree row on the north edge, flower beds, trees by the Theater
+    fill(5, 22, 20, 26, "."); fill(10, 34, 22, 37, ",")
+    for x in (5, 9, 13, 17):
+        obj("tree-line", x, 22)
+    obj("flowers", 6, 25); obj("flowers", 16, 25)
+    fill(20, 38, 22, 46, ","); obj("tree", 20, 39); obj("tree", 20, 43)
+    # South residential x3-24, y52-61, replacing the tree block: homes on the
+    # north row, primary market stalls on the south row that Nantun North sees
+    fill(3, 52, 24, 61, ",")
+    for y, kind in ((52, "shenji-home"), (57, "stall")):
+        for x in (3, 7, 13, 17):
+            obj(kind, x, y)
+        obj("tree", 22, y + 1)
+    fill(11, 52, 12, 61, ":")
+    # Street trees between the Maple ring and Xitun Road (x23-24)
+    fill(23, 20, 24, 46, ".")
+    for y in range(20, 45, 3):
+        obj("tree", 23, y)
+    return "\n".join("".join(r) for r in g) + "\n", json.dumps({"objects": objs}, indent=1) + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, default=ROOT)
+    args = parser.parse_args()
+    ground, objects = layout()
+    (args.source / DATA / "ground.txt").write_text(ground)
+    (args.source / DATA / "objects.json").write_text(objects)
+    print(len(json.loads(objects)["objects"]), "objects")
+
+
+if __name__ == "__main__":
+    main()
