+        assert(!TaichungEncounterGetUnlockMask() && TaichungEncounterWasAttempted(TAICHUNG_ENCOUNTER_SECOND_MARKET));
+        Protected();
+    }
+    for (site = 0; site < TAICHUNG_ENCOUNTER_COUNT; site++)
+    {
+        const struct TaichungEncounterSite *s = TaichungEncounterGetSite(site);
+        assert(s && s->species >= 1 && s->species <= 150 && s->level >= 60 && s->level <= 75);
+        assert(TaichungEncounterSiteForSpecies(s->species) == site);
+        if (!TaichungEncounterSiteAvailable(site))
+        {
+            Fixture(0, 0);
+            assert(TaichungEncounterSpeciesSelectable(s->species));
+            assert(!TaichungEncounterBegin(site) && !sWrites);
+            continue;
+        }
+        // Exercise every low word with both sparse and dense patterns in the extension.
+        for (bits = 0; bits < 2048; bits++)
+        {
+            mask = (bits & TAICHUNG_ENCOUNTER_SAVE_LOW_MASK) | (bits << TAICHUNG_ENCOUNTER_SAVE_LOW_BITS);
+            Fixture(mask, mask);
+            assert(TaichungEncounterWasAttempted(site) == !!(mask & (1 << site)));
+            assert(TaichungEncounterSpeciesSelectable(s->species) == !!(mask & (1 << site)));
+            if (mask & (1 << site))
+            {
+                assert(!TaichungEncounterBegin(site) && !sWrites);
+            }
+            else
+            {
+                Arm(site);
+                assert(TaichungEncounterGetBalls() == 3);
+                assert(!TaichungEncounterRecordCapture(s->species));
+                assert(TaichungEncounterTakeBall());
+                assert(!TaichungEncounterRecordCapture(SPECIES_MEW));
+                assert(TaichungEncounterRecordCapture(s->species));
+                assert(!TaichungEncounterRecordCapture(s->species));
+                assert(!TaichungEncounterTakeBall());
+                assert(TaichungEncounterOnBattleEnd(s->species, B_OUTCOME_CAUGHT));
+                assert(TaichungEncounterGetResult() == TAICHUNG_ENCOUNTER_RESULT_CAUGHT);
+                assert(!TaichungEncounterOnBattleEnd(s->species, B_OUTCOME_CAUGHT));
+                assert(!TaichungEncounterBegin((site + 1) % TAICHUNG_ENCOUNTER_COUNT));
+                assert(TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), TaichungEncounterGetAttemptMask(), TaichungEncounterGetUnlockMask()));
+                assert(TaichungEncounterGetPhase() == TAICHUNG_ENCOUNTER_PHASE_DONE);
+                assert(TaichungEncounterSpeciesSelectable(s->species));
+                assert(TaichungEncounterGetAttemptMask() == (mask | (1u << site)));
+                assert(TaichungEncounterGetUnlockMask() == (mask | (1u << site)));
+                assert((V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) & 0xfc00) == 0xC000);
+                assert((V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) & 0xfc00) == 0x8000);
+                assert(sWrites == 2);
+                TaichungEncounterResetSession();
+                assert(!TaichungEncounterBegin(site)); // Continue never refunds an attempt.
+                assert(TaichungEncounterInitSaveState() && sWrites == 2); // Idempotent migration.
+            }
+            Protected();
+        }
+        for (outcome = 0; outcome < 16; outcome++)
+        {
+            Fixture(0, 0); Arm(site);
+            assert(TaichungEncounterOnBattleEnd(s->species, outcome));
+            assert(!TaichungEncounterSpeciesSelectable(s->species));
+            assert(TaichungEncounterGetUnlockMask() == 0 && TaichungEncounterWasAttempted(site));
+            assert(TaichungEncounterGetResult() != TAICHUNG_ENCOUNTER_RESULT_CAUGHT);
+            Protected();
+        }
+        Fixture(0, 0); Arm(site);
+        assert(TaichungEncounterTakeBall() && TaichungEncounterGetBalls() == 2);
+        assert(TaichungEncounterTakeBall() && TaichungEncounterGetBalls() == 1);
+        assert(TaichungEncounterTakeBall() && TaichungEncounterGetBalls() == 0);
+        assert(!TaichungEncounterTakeBall());
+        assert(TaichungEncounterOnBattleEnd(s->species, B_OUTCOME_NO_SAFARI_BALLS));
+        assert(TaichungEncounterGetResult() == TAICHUNG_ENCOUNTER_RESULT_EXHAUSTED);
+        assert(!TaichungEncounterSpeciesSelectable(s->species));
+        Fixture(0, 0); Arm(site); assert(TaichungEncounterTakeBall());
+        assert(TaichungEncounterRecordCapture(s->species));
+        sIgnoreWrite = TRUE;
+        assert(TaichungEncounterOnBattleEnd(s->species, B_OUTCOME_CAUGHT));
+        assert(TaichungEncounterGetResult() != TAICHUNG_ENCOUNTER_RESULT_CAUGHT);
+        Fixture(0, 0); sFailWrite = TRUE;
+        assert(!TaichungEncounterBegin(site) && !TaichungEncounterWasAttempted(site));
+        sFailWrite = FALSE; sIgnoreWrite = TRUE;
+        assert(!TaichungEncounterBegin(site) && !TaichungEncounterWasAttempted(site));
+        Fixture(0, 0); assert(TaichungEncounterBegin(site)); TaichungEncounterStorageFailed();
+        assert(TaichungEncounterWasAttempted(site) && !TaichungEncounterIsActive());
+        assert(!TaichungEncounterAcknowledge(TaichungEncounterGetSequence(), 1 << site, 0));
+    }
+    Fixture(0, 0);
+    for (species = 1; species <= 150; species++)
+        assert(TaichungEncounterSpeciesSelectable(species) == !TaichungEncounterSiteAvailable(TaichungEncounterSiteForSpecies(species)));
+    assert(TaichungEncounterSpeciesSelectable(SPECIES_SCYTHER));
+    assert(!TaichungEncounterSpeciesSelectable(0) && !TaichungEncounterSpeciesSelectable(SPECIES_MEW));
+    assert(!TaichungEncounterBegin(TAICHUNG_ENCOUNTER_COUNT) && !TaichungEncounterBegin(0xFFFF));
+    assert(!TaichungEncounterGetSite(TAICHUNG_ENCOUNTER_COUNT) && !TaichungEncounterGetSite(0xFFFF));
+    gSaveBlock1Ptr = NULL;
+    assert(!TaichungEncounterInitSaveState() && !TaichungEncounterBegin(0));
+    assert(!TaichungEncounterWasAttempted(0) && !TaichungEncounterSpeciesSelectable(SPECIES_LAPRAS));
+    gSaveBlock1Ptr = &sSave;
+    V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) = 0;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) = 0;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) = 0;
+    assert(TaichungEncounterInitSaveState());
+    assert(TaichungEncounterGetAttemptMask() == 0 && TaichungEncounterGetUnlockMask() == 0);
+    Protected();
+    Fixture(0, 0);
+    V(TAICHUNG_ENCOUNTER_SCHEMA_VAR) = TAICHUNG_ENCOUNTER_SCHEMA_V1;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) = 0xE104;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) = 0xE004;
+    V(TAICHUNG_ENCOUNTER_ATTEMPT_UPPER_VAR) = 0xFFFF;
+    V(TAICHUNG_ENCOUNTER_UNLOCK_UPPER_VAR) = 0xFFFF;
+    assert(TaichungEncounterInitSaveState());
+    assert(TaichungEncounterGetAttemptMask() == 0x104 && TaichungEncounterGetUnlockMask() == 4);
+    assert(V(TAICHUNG_ENCOUNTER_ATTEMPT_VAR) == 0xE104 && V(TAICHUNG_ENCOUNTER_UNLOCK_VAR) == 0xE004);
+    assert(TaichungEncounterSpeciesSelectable(SPECIES_EXEGGUTOR));
+    assert(TaichungEncounterSpeciesSelectable(SPECIES_VICTREEBEL)); // Retired, as with the other legacy targets.
+    assert(!TaichungEncounterBegin(TAICHUNG_ENCOUNTER_BOTANICAL_GARDEN));
+    assert(!TaichungEncounterSpeciesSelectable(SPECIES_VENUSAUR));
+    assert(TaichungEncounterBegin(TAICHUNG_ENCOUNTER_VENUSAUR));
+    {
+        const u32 oldPark = 1u << 10;
+        const u32 oldMuseum = 1u << 15;
+        assert(TaichungEncounterSiteForSpecies(SPECIES_DRAGONITE) == 10);
+        assert(TaichungEncounterSiteForSpecies(SPECIES_PORYGON) == 15);
+
+        Fixture(oldMuseum, oldMuseum);
+        assert(TaichungEncounterSpeciesSelectable(SPECIES_PORYGON));
+        assert(!TaichungEncounterSpeciesSelectable(SPECIES_DRAGONITE));
+        assert(!TaichungEncounterBegin(TAICHUNG_ENCOUNTER_LEGACY_GREEN_MUSEUMBRARY));
+        assert(TaichungEncounterBegin(TAICHUNG_ENCOUNTER_GREEN_MUSEUMBRARY));
+        assert(TaichungEncounterGetUnlockMask() == oldMuseum);
+
+        Fixture(oldPark | oldMuseum, oldPark | oldMuseum);
+        assert(TaichungEncounterSpeciesSelectable(SPECIES_DRAGONITE));
+        assert(TaichungEncounterGetUnlockMask() == (oldPark | oldMuseum));
+        assert(!TaichungEncounterBegin(TAICHUNG_ENCOUNTER_GREEN_MUSEUMBRARY));
+
+        Fixture(oldPark, 0);
+        assert(!TaichungEncounterSpeciesSelectable(SPECIES_DRAGONITE));
+        assert(!TaichungEncounterBegin(TAICHUNG_ENCOUNTER_GREEN_MUSEUMBRARY));
+    }
+    puts("PASS: 20 active sites, independent retired and replacement slots, Dragonite and Porygon save continuity, durable ACKs and three throws");
+    return 0;
+}
diff --git a/tests/taichung_encounter_upper_history_test.c b/tests/taichung_encounter_upper_history_test.c
new file mode 100644
index 00000000..c2759f06
--- /dev/null
+++ b/tests/taichung_encounter_upper_history_test.c
@@ -0,0 +1,102 @@
+#include "global.h"
+#include "taichung_encounter.h"
+#include "constants/battle.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static unsigned sWrites, sCases;
+#define V(id) sSave.vars[(id) - 0x4000]
+u16 VarGet(u16 id) { (void)id; assert(0); return 0; }
+bool8 VarSet(u16 id, u16 value) { assert(id == 0x40EF || id == 0x40F0 || (id >= 0x40F2 && id <= 0x40F5)); V(id) = value; sWrites++; return TRUE; }
+bool8 LegacyTaichungEncounterInitSaveState(void);
+void LegacyTaichungEncounterResetSession(void);
+bool8 LegacyTaichungEncounterBegin(u16 site);
+u32 LegacyTaichungEncounterGetAttemptMask(void);
+u32 LegacyTaichungEncounterGetUnlockMask(void);
+u32 LegacyTaichungEncounterGetSequence(void);
+const struct TaichungEncounterSite *LegacyTaichungEncounterGetSite(u16 site);
+bool8 LegacyTaichungEncounterAcknowledge(u32 sequence, u32 attempts, u32 unlocks);
+bool8 LegacyTaichungEncounterOnBattleStart(u16 species, u8 level);
+bool8 LegacyTaichungEncounterTakeBall(void);
+bool8 LegacyTaichungEncounterRecordCapture(u16 species);
+bool8 LegacyTaichungEncounterOnBattleEnd(u16 species, u8 outcome);
+static void Reset(void) { memset(&sSave,0,sizeof(sSave)); sWrites=0; LegacyTaichungEncounterResetSession(); TaichungEncounterResetSession(); }
+static void CheckMigratedLegacy(void)
+{
+    struct SaveBlock1 input = sSave, expected = sSave;
+    unsigned writes = sWrites, id;
+    u32 attempts = LegacyTaichungEncounterGetAttemptMask();
+    u32 unlocks = LegacyTaichungEncounterGetUnlockMask();
+    // Independent contract: original EC02 history0..23 only, stamp last,
+    // clear unallocated EF. Every unrelated native byte remains exact.
+    expected.vars[0xF0] &= 0x3FFF;
+    expected.vars[0xF2] &= 0x3FFF;
+    expected.vars[0xEF] = 0;
+    expected.vars[0xF3] = 0xEC03;
+    sWrites = 0;
+    assert(TaichungEncounterInitSaveState());
+    assert(sWrites == 4 && !memcmp(&sSave, &expected, sizeof(sSave)));
+    assert(TaichungEncounterGetAttemptMask() == attempts);
+    assert(TaichungEncounterGetUnlockMask() == unlocks);
+    for (id = 21; id < 27; id++) assert(!TaichungEncounterWasAttempted(id));
+    sWrites = 0;
+    assert(TaichungEncounterInitSaveState() && !sWrites);
+    assert(!memcmp(&sSave, &expected, sizeof(sSave)));
+    sSave = input; sWrites = writes;
+}
+static void CheckNewSitesUnspent(void)
+{
+    assert((V(0x40F0) & 0xF800) == 0 && (V(0x40F2) & 0xF800) == 0);
+    CheckMigratedLegacy();
+}
+int main(void)
+{
+    unsigned value, id, caught;
+    Reset(); assert(LegacyTaichungEncounterInitSaveState());
+    assert(sWrites == 3 && V(0x40F3) == 0xEC02); CheckNewSitesUnspent();
+    // Even arbitrary stale upper-word data from EC01 is cleared by the actual
+    // old migration, with all low/reserved bits retained exactly.
+    for(value=0;value<=0xFFFF;value++)
+    {
+        Reset(); V(0x40F3)=0xEC01; V(0x40F0)=value; V(0x40F2)=value ^ 0xA55A;
+        V(0x40F4)=value; V(0x40F5)=value ^ 0xCAFE;
+        assert(LegacyTaichungEncounterInitSaveState());
+        assert(V(0x40F4)==value && V(0x40F5)==(value ^ 0xCAFE));
+        CheckNewSitesUnspent(); sCases++;
+    }
+    // Every historically reachable upper11-bit pattern, every old site, both
+    // true-caught and KO outcomes. Direct legacy and new reads agree exactly.
+    for(value=0;value<0x800;value++)
+    {
+        struct SaveBlock1 initial;
+        Reset(); V(0x40F3)=0xEC02; V(0x40F0)=value; V(0x40F2)=value & 0x555;
+        V(0x40F4)=0xC000 | (value & 0x3FF); V(0x40F5)=0x8000 | (value & 0x155);
+        initial=sSave;
+        assert(LegacyTaichungEncounterInitSaveState());
+        assert(!sWrites && !memcmp(&initial,&sSave,sizeof(sSave)));
+        CheckMigratedLegacy();
+        CheckNewSitesUnspent(); sCases++;
+        for(id=0;id<21;id++) for(caught=0;caught<2;caught++)
+        {
+            const struct TaichungEncounterSite *site;
+            sSave=initial; LegacyTaichungEncounterResetSession();
+            if(!LegacyTaichungEncounterBegin(id)) continue; // Retired/spent stay spent.
+            site=LegacyTaichungEncounterGetSite(id);
+            CheckNewSitesUnspent(); // The Begin writer cannot set upper bits11+.
+            assert(LegacyTaichungEncounterAcknowledge(LegacyTaichungEncounterGetSequence(),LegacyTaichungEncounterGetAttemptMask(),LegacyTaichungEncounterGetUnlockMask()));
+            assert(LegacyTaichungEncounterOnBattleStart(site->species,site->level));
+            if(caught) assert(LegacyTaichungEncounterTakeBall() && LegacyTaichungEncounterRecordCapture(site->species));
+            assert(LegacyTaichungEncounterOnBattleEnd(site->species,caught?B_OUTCOME_CAUGHT:B_OUTCOME_WON));
+            CheckNewSitesUnspent();
+            CheckMigratedLegacy();
+            assert(LegacyTaichungEncounterGetAttemptMask() & (1u << id));
+            assert(!!(LegacyTaichungEncounterGetUnlockMask() & (1u<<id))==!!caught);
+            assert((V(0x40F4)&0xFC00)==0xC000 && (V(0x40F5)&0xFC00)==0x8000);
+            sCases++;
+        }
+    }
+    printf("PASS:%u frozen-old/new native C cases; all65536EC01 stale upper patterns clear; all2048reachable EC02upper patterns plus all old sites Begin/caught/KO keep bits21-23 zero; EC03 full-save migration delta and idempotence checked on every old result; original low/reserved bits retained.\n",sCases);
+    return 0;
+}
diff --git a/tests/taichung_exploration_test.c b/tests/taichung_exploration_test.c
new file mode 100644
index 00000000..fd443935
--- /dev/null
+++ b/tests/taichung_exploration_test.c
@@ -0,0 +1,92 @@
+#include "global.h"
+#include "taichung_exploration.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+#define sVariables sSave.vars
+static unsigned sPreferenceWrites;
+static unsigned sProgressWrites;
+u16 VarGet(u16 id) { (void)id; assert(0 && "Preference reads must bypass quest-log replay"); return 0; }
+bool8 VarSet(u16 id, u16 value)
+{
+    assert(id == TAICHUNG_EXPLORATION_WILD_VAR || id == TAICHUNG_EXPLORATION_SIGHT_VAR || id == TAICHUNG_GYM_COMPLETION_VAR);
+    if (id == TAICHUNG_GYM_COMPLETION_VAR) ++sProgressWrites;
+    else ++sPreferenceWrites;
+    sVariables[id-0x4000] = value;
+    return TRUE;
+}
+
+int main(void)
+{
+    u16 wild, sight, range;
+    u32 rate;
+    unsigned before;
+    const u32 rates[] = {0,1,3,4,7,16,80,1600,0xFFFFFFFF};
+    unsigned i;
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_WILD) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(TAICHUNG_EXPLORATION_SIGHT) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(sPreferenceWrites == 0); // Old saves default without replay or mutation.
+    assert(!TaichungExplorationSetMode(2,1));
+    assert(!TaichungExplorationSetMode(0,0));
+    assert(!TaichungExplorationSetMode(1,4));
+    assert(sPreferenceWrites == 0);
+    sVariables[0xF8] = 65535;
+    sVariables[0xF9] = 8;
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_NORMAL);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_NORMAL);
+
+    for (wild = 1; wild <= 3; ++wild)
+    {
+        for (sight = 1; sight <= 3; ++sight)
+        {
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_WILD,wild));
+            assert(TaichungExplorationSetMode(TAICHUNG_EXPLORATION_SIGHT,sight));
+            before = sPreferenceWrites;
+            assert(TaichungExplorationGetMode(0) == wild && TaichungExplorationGetMode(1) == sight);
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            // Script disabling and re-enabling encounters cannot erase saved Off.
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(!TaichungExplorationAllowsAutomaticWild(TRUE));
+            assert(TaichungExplorationAllowsAutomaticWild(FALSE) == (wild != TAICHUNG_EXPLORATION_OFF));
+            assert(TaichungExplorationAllowsTrainerSight() == (sight != TAICHUNG_EXPLORATION_OFF));
+            for (i = 0; i < sizeof(rates)/sizeof(rates[0]); ++i)
+            {
+                rate = rates[i];
+                if (wild == TAICHUNG_EXPLORATION_OFF) rate = 0;
+                else if (wild == TAICHUNG_EXPLORATION_LOW && rate > 0) rate = rate/4 ? rate/4 : 1;
+                assert(TaichungExplorationAdjustAutomaticWildRate(rates[i]) == rate);
+            }
+            for (range = 0; range <= 255; ++range)
+            {
+                u8 expected = sight == TAICHUNG_EXPLORATION_OFF ? 0 : sight == TAICHUNG_EXPLORATION_LOW && range > 1 ? 1 : range;
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected);
+                assert(TaichungExplorationGetTrainerSightRange(range) == expected); // Deterministic, no frame reroll.
+            }
+            assert(sPreferenceWrites == before && sProgressWrites == 0);
+        }
+    }
+
+    // Changing preferences during a real tracked battle never cancels its win.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_OLD_STATION,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungExplorationSetMode(0,TAICHUNG_EXPLORATION_OFF);
+    TaichungExplorationSetMode(1,TAICHUNG_EXPLORATION_OFF);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 1 && sProgressWrites == 1);
+    // Voluntary gym preparation still works with both automatic settings Off.
+    assert(TaichungGymPrepareChallenge(TAICHUNG_GYM_PARK,TRAINER_TAICHUNG_STATION_JUN));
+    TaichungGymOnTrainerBattleStart(TRAINER_TAICHUNG_STATION_JUN);
+    TaichungGymOnTrainerBattleEnd(TRAINER_TAICHUNG_STATION_JUN,B_OUTCOME_WON);
+    assert(TaichungGymGetCompletedCount() == 2 && sProgressWrites == 2);
+    TaichungGymCancelChallenge();
+    assert(TaichungExplorationGetMode(0) == TAICHUNG_EXPLORATION_OFF);
+    assert(TaichungExplorationGetMode(1) == TAICHUNG_EXPLORATION_OFF);
+    puts("PASS: nine independent encounter/sight combinations; old-save defaults; quarter-rate/minimum; all sight ranges; temporary reset cannot override Off; voluntary and active gym wins remain valid.");
+    return 0;
+}
