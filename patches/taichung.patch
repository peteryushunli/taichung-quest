+def open_sources(engine, world, fill, extent, owners, fill_dir):
+    marks = world.markings()
+    original = engine.tile
+    engine.tile = lambda metatile, sheet="north": GroundRef(metatile, sheet)
+    try:
+        refs = {point: world.ground_tile(*point, marks) for point in points(extent)}
+        # The painted boulevard extends over the western highway for the
+        # planning preview. Render the continuous barrier at the playable edge.
+        for edge in engine.P.EDGES:
+            if edge["kind"] == "highway":
+                for point in points(edge["rect"]):
+                    if point in refs and world.at(*point) != "H":
+                        refs[point] = world.edge_tile(*point)
+        paint_perimeter(engine, world, owners, refs)
+    finally:
+        engine.tile = original
+    rail_art = viaduct_tiles()
+
+    def load_terrain(metatile, sheet):
+        return rail_art[metatile] if sheet == "rail" else original(metatile, sheet)
+
+    for item in fill["placements"]:
+        if item["kind"] == "tree":
+            for i, metatile in enumerate(engine.TREE):
+                refs[item["x"] + i % 2, item["y"] + i // 2] = GroundRef(metatile, "north")
+    # Flatten mixed-sheet and decorated ground into a shared terrain palette.
+    refs_used = sorted({ref for ref in refs.values() if ref is not None},
+                       key=lambda ref: (ref.sheet, ref.metatile, ref.transforms))
+    keys = {ref: index for index, ref in enumerate(refs_used)}
+    flat = Image.new("RGBA", (16, 16), (88, 92, 104, 255))
+    extra = {}
+    for ref in [*refs_used, None]:
+        index = len(keys) if ref is None else keys[ref]
+        image = flat if ref is None else ref.image(load_terrain)
+        for (x, y), pixels in cells8(image).items():
+            extra[(index * 2 + x, y)] = pixels
+
+    names = sorted({item["sprite"] for item in fill["placements"]} - {"tree"})
+    sprites = {}
+    art_hashes = {}
+    for name in names:
+        path = sprite_path(fill_dir, name)
+        image = Image.open(path).convert("RGBA")
+        cells = cells8(image)
+        if name in LANDMARK_PALETTES:
+            colors = {c15(bytes.fromhex(rgb)) for rgb in LANDMARK_PALETTES[name].split()}
+            cells = remap_tiles(cells, colors)
+        sprites[name] = image, cells
+        art_hashes[name] = digest(path)
+    # The draft's small sand/play detail reuses the street-furniture palette.
+    # A separate palette exceeds the cartridge's 64 virtual-palette address space.
+    sand_play = sprites.pop("huimin-sand-play", None)
+    palettes, palette_for, extra = assign_palettes(sprites, extra)
+    if sand_play is not None:
+        image, cells = sand_play
+        palette = palette_for["sprite", "wood-park-bench"]
+        sprites["huimin-sand-play"] = image, remap_tiles(cells, set(palettes[palette]))
+        palette_for["sprite", "huimin-sand-play"] = palette
+    require(len(palettes) + PRIMARY_PALETTES <= 64, "The city needs more than 64 virtual palettes.")
+    pool = TilePool(palettes)
+    artwork = {}
+    color_maps = {}
+
+    def overlay(tile, under, palette):
+        if under is None:
+            return tile, palette
+        bottom, old_palette = under
+        if old_palette != palette:
+            mapping = color_maps.get((old_palette, palette))
+            if mapping is None:
+                mapping = {
+                    color: min(palettes[palette], key=lambda new: (distance(color, new), new))
+                    for color in palettes[old_palette]
+                }
+                mapping[None] = None
+                color_maps[old_palette, palette] = mapping
+            bottom = [mapping[color] for color in bottom]
+        return [color if color is not None else lower for color, lower in zip(tile, bottom)], palette
+
+    placements = sorted(fill["placements"], key=lambda item: (item["y"] + item["tiles"][1], item["x"]))
+    for item in placements:
+        name = item["sprite"]
+        if name not in sprites:
+            continue
+        image, source = sprites[name]
+        w, h = item["tiles"]
+        require(image.size == (16 * w, 16 * h), f"Sprite envelope differs for {name}")
+        palette = palette_for["sprite", name]
+        for j in range(h):
+            for i in range(w):
+                point = item["x"] + i, item["y"] + j
+                quads = artwork.get(point, [None] * 4)
+                for q in range(4):
+                    x, y = i * 2 + q % 2, j * 2 + q // 2
+                    if item["mirrored"]:
+                        row = source[2 * w - x - 1, y]
+                        tile = [value for start in range(0, 64, 8) for value in row[start:start + 8][::-1]]
+                    else:
+                        tile = source[x, y]
+                    if any(color is not None for color in tile):
+                        quads[q] = overlay(tile, quads[q], palette)
+                if any(quads):
+                    artwork[point] = quads
+    return refs, keys, extra, palettes, palette_for, pool, artwork, art_hashes
+
+
+def raw_entry(value):
+    tile = value & 1023
+    return (tile, value >> 10 & 3, value >> 12) if tile else None
+
+
+def encode_tables(table):
+    raw, banks, attributes = [], bytearray(), []
+    for entries, attr in table:
+        for entry in entries:
+            if entry is None:
+                raw.append(0)
+                banks.append(0)
+            else:
+                tile, flip, palette = entry
+                raw.append((tile & 1023) | (flip << 10) | ((palette & 15) << 12))
+                banks.append((tile >> 10) | ((palette >> 4) << 6))
+        attributes.append(attr)
+    return struct.pack(f"<{len(raw)}H", *raw), bytes(banks), struct.pack(f"<{len(attributes)}I", *attributes)
+
+
+def world_cells(engine, world, fill, extent, owners, refs, keys, extra, pool, palette_for, artwork, overhead):
+    values = struct.unpack("<5120H", (PRIMARY / "metatiles.bin").read_bytes())
+    attrs = struct.unpack("<640I", (PRIMARY / "metatile_attributes.bin").read_bytes())
+    entries = [tuple(raw_entry(value) for value in values[i:i + 8]) for i in range(0, 5120, 8)]
+    tiles = [(value, attr) for value, attr in zip(entries, attrs)]
+    indexes = {}
+
+    blocked = set()
+    fixed_solids = set()
+    for item in world.objects:
+        footprint = world.solid_cells(item)
+        blocked.update(footprint)
+        if item["kind"] not in ("building", "landmark") or "solid" in item:
+            fixed_solids.update(footprint)
+    for rect in fill["reservedLots"]["rects"]:
+        fixed_solids.update(points(rect))
+    blocked.update(fixed_solids)
+    doors = {tuple(event["tile"]) for event in fill["events"]["list"] if event["type"] == "door"}
+    painted_doors = {tuple(event["tile"]) for event in fill["events"]["list"]
+                     if event["type"] == "door" and event.get("preserveFacade")}
+    pending_signs = {tuple(event["tile"]) for event in fill["events"]["list"]
+                     if event["type"] == "sign" and event["tile"] and not event.get("inLiveGame")}
+    paving = {GroundRef(tile, "north") for tile in (engine.PAVING, engine.SIDEWALK, engine.BRIDGE_N, engine.BRIDGE_S)}
+    cells, walk, optional_ground = {}, set(), set()
+    theater_audit = []
+    for point in points(extent):
+        ch = world.at(*point)
+        ref = refs[point]
+        if point in pending_signs:
+            ch, ref = "o", GroundRef(GRASS, "north")
+        quad = artwork.get(point)
+        wild = ch == "w"
+        if point in doors and point not in painted_doors:
+            key = DOOR
+        elif ref is not None and ref.reusable and not quad and not wild:
+            key = ref.metatile
+        else:
+            ground = (entries[ref.metatile][:4] if ref is not None and ref.reusable
+                      and not any(entries[ref.metatile][4:]) else None)
+            if point in GREENWAY_REAR_FLOWERS:
+                require(ref is not None and ref.reusable and ref.metatile == 4 and quad,
+                        f"The reviewed rear flower/tree composition moved: {point} ref={ref} quad={bool(quad)}")
+                # A separate opaque grass+flower quartet leaves the original
+                # tree on the upper layer; ordinary flowers retain transparency.
+                ground = tuple((500 + i, 0, 0) for i in range(4))
+                require({tile[0] for tile in entries[ref.metatile][4:]} == STOCK_FLOWERS,
+                        "Rear flowers must retain the four stock animation slots")
+            if ground is None:
+                index = keys.get(ref, len(keys))
+                ground = tuple(pool.entry(extra[x, y], palette_for["extra", x, y])
+                               for y in (0, 1) for x in (index * 2, index * 2 + 1))
+            top = tuple(pool.entry(*tile) if tile is not None else None for tile in quad) if quad else (None,) * 4
+            attr = attrs[TALL_GRASS] if wild else attrs[ref.metatile] if ref and ref.reusable else 0
+            layer = LAYER_NORMAL if quad and point in overhead else LAYER_COVERED
+            if point in painted_doors:
+                attr = (attr & ~0x1ff) | (attrs[DOOR] & 0x1ff)
+            base = ground + top, (attr & ~LAYER_MASK) | layer
+            if base not in indexes:
+                indexes[base] = len(tiles)
+                tiles.append(base)
+            key = indexes[base]
+        cells[point] = key
+        if point in owners and point in CONFUCIUS_STEPS:
+            # Only the two inner stairs are traversable; side rails/walls stay solid.
+            walk.add(point)
+        elif point in owners and point not in doors:
+            # Rectangular sprite envelopes can include clear sidewalks and plaza paving.
+            clear_paving = ch in "bslWpay=A" and ref in paving and not quad and point not in fixed_solids
+            # The Theater's P feature strip is ordinary visible lawn, not a wall.
+            # Reconcile clear floor through the complete district and its seam ring;
+            # retain every actual prop, reserved lot, facade and sign footprint.
+            theater_floor = (71 <= point[0] < 122 and 126 <= point[1] < 147
+                             and ch == "P" and ref == GroundRef(GRASS, "north")
+                             and not quad and point not in blocked)
+            if theater_floor or (point not in blocked and ch in engine.WALK | engine.ROAD):
+                walk.add(point)
+            elif clear_paving or (ch == "G" and point not in blocked):
+                optional_ground.add(point)
+        if point in owners and 71 <= point[0] < 122 and 126 <= point[1] < 147:
+            theater_audit.append(dict(world=point, feature=ch, clearFloor=ref in paving | {GroundRef(GRASS, "north")},
+                                      artwork=bool(quad), authoredSolid=point in blocked,
+                                      fixedSolid=point in fixed_solids,
+                                      proposedWalkable=point in walk | optional_ground))
+    world_cells.theater_audit = theater_audit
+    require(PRIMARY_TILES + len(pool.patterns) <= 65536, "The global graphics pool is too large.")
+    return cells, tiles, walk, optional_ground
+
+
+def install_pavilion_deck(engine, world, owners, refs, cells, tiles, walk, pool, palette):
+    paving = engine.tile(engine.PAVING)
+    deck = draw_deck(paving)
+    x0, y0, x1, y1 = PLATFORM
+    colors = set(pool.palettes[palette])
+    art = {}
+    for y in range(y0, CAUSEWAY[3]):
+        for x in range(x0, x1):
+            point = x, y
+            left, top = 16 * (x - x0), 16 * (y - y0)
+            layer = deck.crop((left, top, left + 16, top + 16))
+            if not layer.getbbox():
+                continue
+            require(point in owners, "The pavilion deck drifted out of the Park map.")
+            entries, attr = tiles[cells[point]]
+            if layer.tobytes() == paving.tobytes():
+                ground = tiles[engine.PAVING][0][:4]
+            else:
+                under = refs[point].image(engine.tile).convert("RGBA")
+                image = Image.alpha_composite(under, layer)
+                blocks = remap_tiles(cells8(image), colors)
+                ground = tuple(pool.entry(block, palette) for block in blocks.values())
+            # The current building sprite and sign stay above the new paving.
+            key = (ground + entries[4:], attr)
+            if key not in art:
+                art[key] = len(tiles)
+                tiles.append(key)
+            cells[point] = art[key]
+    for point in points((x0 + 1, SIGN_TILE[1], x1 - 1, y1 - 1)):
+        require(world.at(*point) in "~=n", f"Unexpected object on the pavilion landing at {point}.")
+        if point != SIGN_TILE:
+            walk.add(point)
+    for y in range(CAUSEWAY[1] + 1, CAUSEWAY[3]):
+        require((CAUSEWAY[0] - 1, y) not in walk and (CAUSEWAY[2], y) not in walk,
+                "A rail tile is walkable.")
+
+
+def reachability(maps, owners, walk):
+    require(STATION_SPAWN in walk, "The preview entrance is blocked.")
+    connections = [{c["map"] for c in game_map["nativeConnections"]} for game_map in maps]
+    visited = {STATION_SPAWN}
+    pending = deque(visited)
+    used_seams = set()
+    while pending:
+        point = pending.popleft()
+        here = owners[point]
+        for dx, dy in DIRECTIONS.values():
+            next_point = point[0] + dx, point[1] + dy
+            if next_point not in walk:
+                continue
+            there = owners[next_point]
+            if there != here:
+                if maps[there]["nativeId"] not in connections[here]:
+                    continue
+                used_seams.add((here, there))
+            if next_point not in visited:
+                visited.add(next_point)
+                pending.append(next_point)
+    return visited, used_seams
+
