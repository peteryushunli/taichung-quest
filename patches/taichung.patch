+#!/usr/bin/env python3
+"""Read-only Theater/connected-bank analysis against the released d7053fd scene.
+
+Writes only analysis JSON under the chosen isolated artifact directory. It never
+executes an installer/compiler or changes registered banks, maps or save code.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "d7053fd115b3744b22a2ba3160b4240f5cc80355"
+CORE_PRIMARY = "data/tilesets/primary/taichung_old_core"
+CORE_SECONDARY = "data/tilesets/secondary/taichung_old_core"
+THEATER_SECONDARY = "data/tilesets/secondary/taichung_xitun"
+ORIGIN, SIZE, OLD_FACADE = (4,35), (16,10), (7,38,17,44)
+NAMES = ("TaichungOldCity","TaichungGreenway","TaichungXitun")
+
+
+def module():
+    spec = importlib.util.spec_from_file_location("theater_readonly_bank", ROOT/"tools/taichung/landmarks/check_old_core.py")
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
+
+
+def flip(pixels, flags):
+    return tuple(pixels[(7-y if flags&0x800 else y)*8+(7-x if flags&0x400 else x)] for y in range(8) for x in range(8))
+
+
+def canonical(pixels):
+    return min(flip(pixels, flags) for flags in (0,0x400,0x800,0xC00))
+
+
+def visible_cells(view, target, direction, offset):
+    """Exact copied strip extent from fieldmap.c, including buffer clipping."""
+    for y in range(target["height"]):
+        for x in range(target["width"]):
+            if ((direction=="left" and x>=target["width"]-7 and -7<=y+offset<view["height"]+7) or
+                (direction=="right" and x<8 and -7<=y+offset<view["height"]+7) or
+                (direction=="up" and y>=target["height"]-7 and -7<=x+offset<view["width"]+8) or
+                (direction=="down" and y<7 and -7<=x+offset<view["width"]+8)):
+                yield x,y
+
+
+def bounds(points):
+    return [min(x for x,y in points),min(y for x,y in points),max(x for x,y in points),max(y for x,y in points)]
+
+
+def stats(bank, words):
+    metas = {word&1023 for word in words}
+    refs, palettes = set(),set()
+    for n in metas:
+        for entry in bank.entries(n):
+            refs.add(entry&1023)
+            palettes.add(entry>>12)
+    return {"metatiles":len(metas),"primaryMetatiles":len({n for n in metas if n<640}),
+            "secondaryMetatiles":sorted(n for n in metas if n>=640),
+            "rawPrimaryGraphicSlots":len({n for n in refs if n<640}),
+            "rawSecondaryGraphicSlots":len({n for n in refs if n>=640}),
+            "flipCanonicalAllPatterns":len({canonical(bank.graphic(n)) for n in refs}),
+            "paletteBanks":sorted(palettes)}
+
+
+def analyze(source):
+    support = module()
+    frozen, current = support.Files(source,BASE),support.Files(source)
+    core = support.Bank(frozen,CORE_PRIMARY,CORE_SECONDARY)
+    theater = support.Bank(frozen,CORE_PRIMARY,THEATER_SECONDARY)
+    original = support.Bank(frozen,"data/tilesets/primary/general","data/tilesets/secondary/pewter_city")
+    layouts = {item["id"]:item for item in frozen.json("data/layouts/layouts.json")["layouts"] if "id" in item}
+    scenes, map_stats = {},{}
+    for name in NAMES:
+        data = frozen.json(f"data/maps/{name}/map.json")
+        layout = layouts[data["layout"]]
+        words = frozen.words(layout["blockdata_filepath"])
+        border = frozen.words(layout["border_filepath"])
+        scenes[data["id"]] = dict(name=name,data=data,layout=layout,words=words,border=border)
+        map_stats[name] = stats(core,words+border)
+    xitun = scenes["MAP_TAICHUNG_XITUN"]
+    proposal = frozen.words(f"{THEATER_SECONDARY}/proposal/map.bin")
+    before = xitun["words"]
+    ground = before[:]
+    for y in range(OLD_FACADE[1],OLD_FACADE[3]+1):
+        for x in range(OLD_FACADE[0],OLD_FACADE[2]+1):ground[y*40+x]=0x3175
+    proposed_banks = {mid:theater if mid=="MAP_TAICHUNG_XITUN" else core for mid in scenes}
+    proposed_words = {mid:proposal if mid=="MAP_TAICHUNG_XITUN" else scene["words"] for mid,scene in scenes.items()}
+    strip_records = []
+    incoming_ids, outgoing_ids = set(),set()
+    all_pass = True
+    for mid,view in scenes.items():
+        for connection in view["data"]["connections"]:
+            target = scenes[connection["map"]]
+            cells = list(visible_cells(view["layout"],target["layout"],connection["direction"],connection["offset"]))
+            ids = {proposed_words[connection["map"]][y*target["layout"]["width"]+x]&1023 for x,y in cells}
+            equal = all(proposed_banks[mid].render(n)==proposed_banks[connection["map"]].render(n) and
+                        proposed_banks[mid].attr(n)==proposed_banks[connection["map"]].attr(n) for n in ids)
+            all_pass &= equal
+            if mid=="MAP_TAICHUNG_XITUN":incoming_ids.update(ids)
+            if connection["map"]=="MAP_TAICHUNG_XITUN":outgoing_ids.update(ids)
+            strip_records.append({"viewer":mid,"donor":connection["map"],"direction":connection["direction"],
+                "offset":connection["offset"],"donorBoundsInclusive":bounds(cells),"cells":len(cells),
+                "metatileIds":sorted(ids),"paletteBanks":stats(proposed_banks[mid],[n for n in ids])["paletteBanks"],
+                "renderAndAttributeEqual":equal})
+    art = frozen.image("data/taichung/landmarks/theater/candidate/candidate-indexed.png")
+    art_patterns = {canonical(tuple(art.getpixel((tx*8+x,ty*8+y)) for y in range(8) for x in range(8)))
+                    for ty in range(20) for tx in range(32)}
+    needed = {word&1023 for word in ground+xitun["border"]}|incoming_ids
+    source_secondary_patterns = {canonical(original.graphic(entry&1023)) for n in needed for entry in original.entries(n) if entry&1023>=640}
+    animated = set(range(416,482))|set(range(508,512))
+    primary_patterns = {canonical(core.graphic(n)) for n in range(640) if n not in animated}
+    union = art_patterns|source_secondary_patterns
+    needed_original_equal = all(core.render(n)==original.render(n) and core.attr(n)==original.attr(n) for n in needed)
+    keep_palettes = stats(original,list(needed))["paletteBanks"]
+    outside_matches = 0
+    occupied = set()
+    for my in range(10):
+        for mx in range(16):
+            if any(art.getpixel((mx*16+x,my*16+y)) for y in range(16) for x in range(16)):
+                occupied.add((ORIGIN[0]+mx,ORIGIN[1]+my))
+    allowed = occupied|{(x,y) for y in range(38,45) for x in range(7,18)}
+    new_blocks = []
+    for y in range(64):
+        for x in range(40):
+            i = y*40+x
+            if (x,y) not in allowed:
+                assert proposal[i]==before[i]
+                assert theater.render(proposal[i]&1023)==core.render(before[i]&1023)
+                assert theater.attr(proposal[i]&1023)==core.attr(before[i]&1023)
+                outside_matches += 1
+            if not before[i]&0xC00 and proposal[i]&0xC00:
+                new_blocks.append([x,y])
+    assert all(proposal[y*40+x]==before[y*40+x] for y in range(35,38) for x in range(3,30))
+    core_manifest = frozen.json("data/taichung/landmarks/old-core-native/manifest.json")
+    theater_manifest = frozen.json(f"{THEATER_SECONDARY}/compile-manifest.json")
+    source_overworld = frozen.text("src/overworld.c")
+    transition = re.search(r"void LoadMapFromCameraTransition\([^)]*\)\s*\{(.*?)\n\}",source_overworld,re.S).group(1)
+    save_c = frozen.text("src/taichung_save.c")
+    current_version = int(re.search(r"#define TAICHUNG_SAVE_VERSION\s+(\d+)",frozen.text("include/taichung_save.h")).group(1))
+    shared_union = {canonical(core.graphic(n)) for n in range(640+core_manifest["secondaryGraphics"]) if n not in animated}|art_patterns
+    return {"schemaVersion":1,"baselineCommit":BASE,"scope":"read-only source/engine analysis; no ROM or save behavior claimed",
+        "recommendation":"Keep gTileset_TaichungOldCorePrimary in all three districts; switch only Xitun's secondary to gTileset_TaichungXitun with the approved proposal. Reuse the existing337-graphic bank; exact borrowed strips need no additional definitions.",
+        "engine":{"cameraTransitionReloadsSecondary":"CopySecondaryTilesetToVramUsingHeap" in transition,
+                  "cameraTransitionReloadsPrimary":"CopyPrimaryTilesetToVram" in transition or "CopyMapTilesetsToVram" in transition,
+                  "mustRetainSamePrimaryLabel":True,"backgroundPaletteRange":[0,12],"doorScratchGraphics":[1016,1023]},
+        "releasedPerMapUsage":map_stats,"connectionStrips":strip_records,
+        "theaterBoundary":{"incomingIds":sorted(incoming_ids),"outgoingIds":sorted(outgoing_ids),
+                           "containsSecondaryOrPrivateIds":any(n>=640 for n in incoming_ids|outgoing_ids),
+                           "allFourDistrictConnectionDirectionsPass":all_pass,
+                           "totalBidirectionalStripCells":sum(item["cells"] for item in strip_records)},
+        "minimalSecondary":{"sceneAndIncomingNeededSourceIds":sorted(needed),
+             "sourceSecondaryPatterns":len(source_secondary_patterns),"theaterPatterns":len(art_patterns),
+             "combinedPatternUnion":len(union),"loadedSlots":theater_manifest["graphics"]["loadedIncludingSheetPadding"],
+             "usableStaticSecondarySlots":376,"actualDefinitionCount":theater_manifest["metatiles"]["secondaryTotal"],
+             "remainingScenePaletteBanks":keep_palettes,"theaterPalette7UnusedByRemainingAndBorrowed":7 not in keep_palettes,
+             "requiredSourceRendersMatchCurrentOldCore":needed_original_equal,
+             "optionalExactReuseOfCurrentNonanimatedPrimary":{"noPrimaryPixelsChanged":True,
+                "sourceSecondaryPatternsAlreadyInPrimary":len(source_secondary_patterns&primary_patterns),
+                "theaterPatternsAlreadyInPrimary":len(art_patterns&primary_patterns),
+                "secondaryPatternsAfterReuse":len(union-primary_patterns),
+                "notNeededForFirstIntegration":True}},
+        "sharedRepackAlternative":{"existingPrimaryAndSecondaryPlusTheaterPatternUnion":len(shared_union),
+             "nonanimatedPrimaryPlusStaticSecondaryMaximum":570+376,
+             "note":"Union alone does not prove a shared allocation: primary General closure, existing palette7 conflicts, metatile capacity and full runtime paths must also fit. A joint RGB palette change would violate exact current rendering without further work.",
+             "recommendedForThisIncrement":False},
+        "unchangedInterfaces":{"door":[12,44],"approach":[12,45],"arrival":[12,47],"exteriorWarpId":2,
+             "candidateOrigin":[4,35],"outsideApprovedCleanupAndInkCellsCompared":outside_matches,
+             "mapleStreet81WordsUnchanged":True,"requiresDoorWarpOrSaveFormatChange":False},
+        "saveCompatibilityCaveat":{"releasedSaveVersion":current_version,"versionAtOrAboveCurrentSkipsUpgrade":"version >= TAICHUNG_SAVE_VERSION" in save_c,
+             "newlyBlockedComparedToRelease":len(new_blocks),"newlyBlockedCells":new_blocks,
+             "graphicsSeamSafetyDoesNotProvePreTheaterContinue":True,
+             "owner":"Main/Root release decision; no save code edited by analysis"},
+        "frozenInputSha256":{path:hashlib.sha256(raw).hexdigest() for path,raw in frozen.cache.items()}}
+
+
+if __name__=="__main__":
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source",type=Path,default=ROOT)
+    parser.add_argument("--output",type=Path,default=ROOT.parents[1]/"artifacts/worktrees/c291d4842985/theater-analysis/cohort-analysis.json")
+    args=parser.parse_args()
+    report=analyze(args.source.resolve())
+    args.output.parent.mkdir(parents=True,exist_ok=True)
+    args.output.write_text(json.dumps(report,indent=2)+"\n")
+    print(json.dumps({"recommendation":report["recommendation"],"theaterBoundary":report["theaterBoundary"],
+                      "minimalSecondary":report["minimalSecondary"],"saveNewlyBlockedCells":report["saveCompatibilityCaveat"]["newlyBlockedComparedToRelease"],"output":str(args.output)},indent=2))
