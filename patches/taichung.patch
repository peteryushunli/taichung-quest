+#!/usr/bin/env python3
+"""Compile the actual current/released money opcode and real gym tracker.
+
+Only GBA data, money services and script-pointer decoding are host stubs. This
+differential check proves the scoped override and preserves the original opcode
+for unrelated trainers, unstarted/mismatched challenges, losses and party types.
+The unchanged native Pay Day/pickup tail is verified separately. No ROM/save/UI
+operation is performed.
+"""
+from pathlib import Path
+import importlib.util
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / 'build/taichung-tests/native-money'
+OUT.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location('money_native_functions', ROOT / 'tools/taichung_gameplay/test-save-facing.py')
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+current = (ROOT / 'src/battle_script_commands.c').read_text()
+old = subprocess.check_output(['git', 'show', '2c48f28b998b67413baf058557752723ea121500:src/battle_script_commands.c'], cwd=ROOT, text=True)
+current_body, _ = extract.definition(current, 'Cmd_getmoneyreward')
+old_body, _ = extract.definition(old, 'Cmd_getmoneyreward')
+old_body = old_body.replace('Cmd_getmoneyreward', 'Baseline_getmoneyreward', 1)
+
+(OUT / 'global.h').write_text('''#ifndef MONEY_HOST_GLOBAL_H
+#define MONEY_HOST_GLOBAL_H
+#define GUARD_GLOBAL_H
+#include <stdint.h>
+#include <stddef.h>
+typedef uint8_t u8; typedef uint16_t u16; typedef uint32_t u32; typedef uint8_t bool8;
+#define TRUE 1
+#define FALSE 0
+#define EWRAM_DATA
+#define VARS_START 0x4000
+struct SaveBlock1 { u16 vars[256]; u32 money; u8 protectedPartyBagIdentity[1200]; };
+extern struct SaveBlock1 *gSaveBlock1Ptr;
+#endif
+''')
+(OUT / 'event_data.h').write_text('#include "global.h"\nbool8 VarSet(u16,u16);\n')
+prefix = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "taichung_gym_progress.h"
+#include "constants/battle.h"
+#include "constants/opponents.h"
+#include "constants/trainers.h"
+struct TrainerMonNoItemDefaultMoves { u8 lvl; };
+struct TrainerMonNoItemCustomMoves { u8 lvl; };
+struct TrainerMonItemDefaultMoves { u8 lvl; };
+struct TrainerMonItemCustomMoves { u8 lvl; };
+struct HostTrainer {
+    u8 partyFlags, partySize, trainerClass;
+    union { const struct TrainerMonNoItemDefaultMoves *NoItemDefaultMoves;
+            const struct TrainerMonNoItemCustomMoves *NoItemCustomMoves;
+            const struct TrainerMonItemDefaultMoves *ItemDefaultMoves;
+            const struct TrainerMonItemCustomMoves *ItemCustomMoves; } party;
+};
+struct HostBattleStruct { u32 moneyMultiplier; };
+struct HostSecretBase { struct { u8 levels[6]; } party; };
+struct HostBattleResources { struct HostSecretBase *secretBase; };
+struct HostMoneyTable { u8 classId, value; };
+static struct SaveBlock1 sSave;
+struct SaveBlock1 *gSaveBlock1Ptr = &sSave;
+static struct HostTrainer gTrainers[NUM_TRAINERS];
+static struct HostBattleStruct sBattle, *gBattleStruct = &sBattle;
+static struct HostSecretBase sBase;
+static struct HostBattleResources sResources = {&sBase}, *gBattleResources = &sResources;
+static const struct HostMoneyTable gTrainerMoneyTable[] = {{1,25},{0xFF,0}};
+static u16 gTrainerBattleOpponent_A;
+static u8 gBattleOutcome;
+static u32 gBattleTypeFlags;
+static u8 gBattleTextBuff1[12];
+static const u8 sScript[10] = {0}, sBaselineSkip[] = {0xAB};
+static const u8 BattleScript_PayDayMoneyAndPickUpItems[] = {0xCD};
+static const u8 *gBattlescriptCurrInstr;
+static unsigned sAddCalls, sLossCalls;
+static u32 sPreparedAmount;
+static const u16 sTrainers[] = {
+ TRAINER_TAICHUNG_STATION_JUN, TRAINER_TAICHUNG_PARK_LIAN,
+ TRAINER_TAICHUNG_MIYAHARA_PEIQI, TRAINER_TAICHUNG_SCIENCE_YICHENG,
+ TRAINER_TAICHUNG_GREENWAY_XINGAN, TRAINER_TAICHUNG_SHEN_JI_AXIU,
+ TRAINER_TAICHUNG_FINE_ARTS_CAINING, TRAINER_TAICHUNG_FENGJIA_JIAHE,
+ TRAINER_TAICHUNG_MAPLE_GARDEN_MUQING, TRAINER_TAICHUNG_THEATER_LING };
+bool8 VarSet(u16 id,u16 value) { sSave.vars[id-VARS_START]=value; return TRUE; }
+static void AddMoney(u32 *money,u32 value) { sAddCalls++; *money += value; }
+static u32 ComputeWhiteOutMoneyLoss(void) { sLossCalls++; return 321; }
+static const u8 *ReadDestination(const u8 *source) { assert(source==sScript+1); return sBaselineSkip; }
+#define T1_READ_PTR(source) ReadDestination(source)
+#define PREPARE_WORD_NUMBER_BUFFER(dest,digits,value) do { (void)(dest); (void)(digits); sPreparedAmount=(value); } while(0)
+'''
+suffix = r'''
+struct Result { u32 money, amount; unsigned adds, losses; const u8 *script; };
+static struct Result Run(void (*command)(void),unsigned gym,unsigned phase,u16 opponent,u8 outcome,u8 flags,bool8 twice,u8 multiplier)
+{
+    struct SaveBlock1 before;
+    static const struct TrainerMonItemCustomMoves party[] = {{50}};
+    memset(&sSave,0xA5,sizeof(sSave));
+    memset(sSave.vars,0,sizeof(sSave.vars));
+    sSave.money=123456; before=sSave;
+    TaichungGymCancelChallenge();
+    if (phase)
+    {
+        u16 prepared=phase==4?sTrainers[(gym+1)%10]:sTrainers[gym];
+        assert(TaichungGymPrepareChallenge(gym,prepared));
+        if (phase!=1) TaichungGymOnTrainerBattleStart(prepared);
+        if (phase==3) TaichungGymCancelChallenge();
+    }
+    gTrainerBattleOpponent_A=opponent; gBattleOutcome=outcome;
+    if (opponent<NUM_TRAINERS)
+    {
+        gTrainers[opponent].partyFlags=flags;
+        gTrainers[opponent].partySize=1; gTrainers[opponent].trainerClass=1;
+        gTrainers[opponent].party.ItemCustomMoves=party;
+    }
+    gBattleTypeFlags=twice?BATTLE_TYPE_DOUBLE:0;
+    gBattleStruct->moneyMultiplier=multiplier; sBase.party.levels[0]=50;
+    gBattlescriptCurrInstr=sScript; sPreparedAmount=0xEEEEEEEE;
+    sAddCalls=sLossCalls=0;
+    command();
+    assert(!memcmp(sSave.vars,before.vars,sizeof(before.vars)));
+    assert(!memcmp(sSave.protectedPartyBagIdentity,before.protectedPartyBagIdentity,sizeof(before.protectedPartyBagIdentity)));
+    { struct Result result={sSave.money,sPreparedAmount,sAddCalls,sLossCalls,gBattlescriptCurrInstr}; return result; }
+}
+int main(void)
+{
+    unsigned gym,phase,flags,outcome,twice,multiplier,cases=0,cashless=0;
+    for (gym=0;gym<10;gym++)
+      for (phase=0;phase<5;phase++)
+       for (flags=0;flags<4;flags++)
+        for (outcome=0;outcome<4;outcome++)
+         for (twice=0;twice<2;twice++)
+          for (multiplier=1;multiplier<=2;multiplier++)
+          {
+            u16 opponent=sTrainers[gym];
+            struct Result baseline=Run(Baseline_getmoneyreward,gym,phase,opponent,outcome,flags,twice,multiplier);
+            struct Result current=Run(Cmd_getmoneyreward,gym,phase,opponent,outcome,flags,twice,multiplier);
+            if (phase==2 && outcome==B_OUTCOME_WON)
+            {
+                assert(current.money==123456 && current.adds==0 && current.losses==0);
+                assert(current.amount==0xEEEEEEEE && current.script==BattleScript_PayDayMoneyAndPickUpItems);
+                assert(baseline.money>current.money && baseline.adds==1 && baseline.script==sScript+5);
+                cashless++;
+            }
+            else
+            {
+                assert(current.money==baseline.money && current.amount==baseline.amount);
+                assert(current.adds==baseline.adds && current.losses==baseline.losses && current.script==baseline.script);
+            }
+            cases++;
+          }
+    for (phase=0;phase<4;phase++)
+      for (outcome=0;outcome<4;outcome++)
+      {
+        u16 opponents[]={TRAINER_YOUNGSTER_BEN,TRAINER_SECRET_BASE};
+        unsigned i;
+        for (i=0;i<2;i++)
+        {
+            struct Result a=Run(Baseline_getmoneyreward,0,phase,opponents[i],outcome,0,FALSE,1);
+            struct Result b=Run(Cmd_getmoneyreward,0,phase,opponents[i],outcome,0,FALSE,1);
+            assert(a.money==b.money && a.amount==b.amount && a.adds==b.adds && a.losses==b.losses && a.script==b.script);
+            cases++;
+        }
+      }
+    printf("PASS:%u actual money-opcode differential cases; %u registered cashless victories; original ordinary/unstarted/mismatch/cancel/loss/secret-base/party-type behavior; protected variables/party/bag/identity.\n",cases,cashless);
+    return 0;
+}
+'''
+source = OUT / 'test.c'
+source.write_text(prefix + '\n' + old_body + '\n' + current_body + '\n' + suffix)
+binary = OUT / 'native-money'
+subprocess.run(['cc', '-std=c99', '-Wall', '-Wextra', '-Werror', '-I'+str(OUT), '-I'+str(ROOT/'include'),
+                str(ROOT/'src/taichung_gym_progress.c'), str(source), '-o', str(binary)], check=True)
+subprocess.run([str(binary)], check=True)
+scripts = (ROOT / 'data/battle_scripts_1.s').read_text()
+baseline_scripts = subprocess.check_output(['git', 'show', '2c48f28:data/battle_scripts_1.s'], cwd=ROOT, text=True)
+def tail(text):
+    return text.split('BattleScript_PayDayMoneyAndPickUpItems::\n', 1)[1].split('\n\n', 1)[0]
+assert tail(scripts) == tail(baseline_scripts)
+assert tail(scripts).split() == ['givepaydaymoney', 'pickup', 'end2']
+print('PASS: original native Pay Day/pickup/end2 tail remains byte-identical.')
