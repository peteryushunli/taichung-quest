+#!/usr/bin/env python3
+"""One progressive, game-scale block study with native indexed roof colorways."""
+import argparse
+from collections import deque
+import json
+from pathlib import Path
+import struct
+
+from PIL import Image,ImageDraw
+
+from color_compile import compile_colorways,color_grid,native_tile_images,save_native
+from library import ROOT,WALK,require
+
+
+def pilot_plan():
+    return dict(schemaVersion=1,status='single unregistered source block study; palette-index colors; not installed in ROM',
+        width=32,height=24,profileId='city-v2-r2-c2',archetype='old-mixed-residential',spawn=[29,14],
+        exits=[[0,13],[31,13],[29,0],[29,23]],
+        groundRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,16,26,23]],
+        protectedRects=[[0,12,31,15],[28,0,30,23],[0,5,18,5],[0,23,31,23],[0,0,0,23],[31,0,31,23]],
+        placements=[
+            dict(id='old-home-a',prefab='building-rowhouse-compact',x=1,y=0,colorway='terracotta',context='residential'),
+            dict(id='old-home-b',prefab='building-rowhouse-compact',x=7,y=0,colorway='source',context='residential'),
+            dict(id='old-home-c',prefab='building-rowhouse-compact',x=13,y=0,colorway='slate',context='residential'),
+            dict(id='old-home-pair',prefab='building-rowhouse-pair',x=1,y=6,colorway='terracotta',context='residential'),
+            dict(id='old-home-d',prefab='building-rowhouse-compact',x=13,y=6,colorway='source',context='residential'),
+            dict(id='new-walkup',prefab='building-walkup-tall',x=21,y=2,colorway='teal',context='residential'),
+            dict(id='shop-corner',prefab='building-corner-store',x=1,y=18,colorway='mustard',context='shopping'),
+            dict(id='shop-wide',prefab='building-shopfront-wide',x=8,y=17,colorway='source',context='shopping'),
+            dict(id='market-a',prefab='stall-market-red',x=17,y=19,colorway='source',context='market'),
+            dict(id='market-b',prefab='stall-market-red',x=22,y=19,colorway='source',context='market'),
+            dict(id='front-lawn-shrub',prefab='prop-shrub',x=19,y=0,context='residential'),
+            dict(id='side-lawn-shrub',prefab='prop-shrub',x=26,y=1,context='residential'),
+            dict(id='front-flowers',prefab='prop-flower-bed',x=19,y=10,context='residential'),
+            dict(id='corner-sign',prefab='prop-sign-board',x=26,y=10,context='street')])
+
+
+def make_pilot(compiled,plan):
+    width,height=plan['width'],plan['height'];base=[0x3001]*(width*height);protected=set()
+    for x0,y0,x1,y1 in plan['groundRects']:
+        for y in range(y0,y1+1):
+            for x in range(x0,x1+1):base[y*width+x]=0x3175
+    for x0,y0,x1,y1 in plan['protectedRects']:
+        protected|={(x,y) for y in range(y0,y1+1) for x in range(x0,x1+1)}
+    source_placements=[{k:v for k,v in p.items() if k!='colorway'} for p in plan['placements']]
+    composed=compiled['library'].compose(width,height,source_placements,base=base,protected_paths=protected)
+    words=color_grid(compiled,composed,plan['placements'])
+    def attr(word):
+        t=word&1023
+        return compiled['library'].attr(t) if t<640 else compiled['attributes'][t-640]
+    def walk(x,y):
