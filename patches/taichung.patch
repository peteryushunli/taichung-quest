+    original_color_manifest = inputs.json(original_color_bank / "compile-manifest.json")
+    fixture_color = pool("existing-generic-color-fixture-snapshot", original_color_bank / "tiles.png",
+                         original_color_manifest["secondaryGraphicsTotal"], [8, 9, 10, 11, 12])
