+#!/usr/bin/env python3
+"""City kit art: the six-lane highway, Xitun's streets and flowing water.
+
+The kit is drawn for the 36 primary tile slots that are free in all three
+private Taichung primaries (tools/taichung/kit/audit_primaries.py). It only
+uses primary palettes 0-5, which are identical in every Taichung primary and
+in General, so a map draws a neighbour's kit cells exactly as the neighbour
+does.
+
+Streets are Xitun's own (tools/taichung/streetscape/xitun_streets.py): flat
+asphalt, a yellow centre dash in the middle of three asphalt cells, white
+crosswalk bars where a sidewalk line crosses the other street, and the
+primary paving metatile 0x175 as the sidewalk, which already exists in every
+primary. The highway is six lanes: a guard rail, three lanes, a double yellow
+median, three lanes and a guard rail. Where the two highways meet, the
+east-west one crosses over the north-south one: its south kerb becomes a
+parapet over the six lanes below, and their first row under the deck lies
+in its shadow.
+
+Water adds no tiles. Its lower layer is General's animated water: the four
+current fields (tiles 434-449, the frames TilesetAnim_General copies every
+16 frames, so they flow) and still pond water (416-419). Banks, canal walls,
+bridge shadows and abutments are an upper-layer overlay with transparent
+pixels. Kit water has behaviour 0, so it is neither surfable nor a current;
+the district maps make it impassable with the collision bit.
+
+Tile-saving choices:
+  - the east half of a north-south highway is the west half turned 180
+    degrees (both flips), and the east-west highway is its transpose;
+  - cars are one top-layer drawing over any lane, red in palette 2, blue in
+    palette 3 and maroon in palette 1;
+  - the uniform highway lane tile (index 5) is the under-deck shadow in
+    palette 1.
+
+  city_kit_art.py --preview DIR     atlas and demo scene PNGs
+"""
+import argparse
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+PRIMARY_PALETTES = ROOT / "data/tilesets/primary/taichung_xitun_private/palettes"
+FIRST_METATILE = 0x063
+# The audit's 36 kit tile slots, ascending; the kit takes them in order.
+TILE_SLOTS = (0x00B, 0x0C4, 0x0CA, 0x0CB, 0x0CC, 0x0CD, 0x0CE, 0x0DA, 0x0DB, 0x0DC, 0x0DD, 0x0DE,
+              0x0EA, 0x0EB, 0x0EC, 0x0ED, 0x0FA, 0x0FB, 0x0FC, 0x0FD, 0x108, 0x109, 0x10A, 0x10B,
+              0x10C, 0x10D, 0x10E, 0x118, 0x119, 0x11A, 0x11B, 0x11C, 0x11D, 0x11E, 0x124, 0x125)
+COVERED = 0x20000000
+# General's animated water: (first tile, palette); each field is 2x2 tiles.
+WATER = {"still": (416, 4), "north": (434, 4), "south": (438, 4), "west": (442, 4), "east": (446, 4)}
+FLOWING = ("north", "south", "east", "west")
+PALETTE_NOTES = {"0": "green cars, the wall's planted bank (General's leaf tiles)",
+                 "1": "road bridge parapet and wall coping, path bridge wood, maroon cars, under-deck and wall shadow, culvert",
+                 "2": "red cars", "3": "water banks, abutments, the retaining wall, bollards, railings and blue cars",
+                 "4": "General's animated water (not redrawn)", "5": "highway and streets"}
+# Existing primary metatiles the kit composes with, identical in all three
+# primaries: Xitun's sidewalk paving and the plain grass.
+SIDEWALK, GRASS = 0x175, 0x001
+# General's dense leaf tiles (the tree fill under metatiles 0x00A-0x00D, palette
+# 0), identical in all three primaries: the retaining wall's planted bank.
+LEAF_TILES = (0x044, 0x045, 0x054, 0x055)
+
+
+def grid(rows):
+    return tuple(tuple(row) for row in rows)
+
+
+def transpose(t):
+    return grid(zip(*t))
+
+
+def uniform(i):
+    return grid([[i] * 8 for _ in range(8)])
+
+
+def drawn(paint):
+    """8x8 tile from paint(x, y)."""
+    return grid([[paint(x, y) for x in range(8)] for y in range(8)])
+
+
+# Palette 5 (highway and streets) indices.
+WHITE, PALE, GREY, ASPHALT, LANE, YELLOW = 1, 2, 3, 4, 5, 10
+# Palette 1 (parapet and wood) indices.
+P_FACE, P_LIGHT, P_TOP, P_STONE, P_DARK = 1, 2, 6, 4, 5
+W_HIGH, W_BOARD, W_RAIL, W_RAIL_DARK, W_GAP, W_EDGE = 9, 10, 11, 12, 13, 14
+# Channel wall profile from the land edge into the water (palette 3), then
+# transparent water.
+BANK = (4, 2, 1, 5, 7, 14, 0, 0)
+# Palette 3 greys, light to dark, and the reflective band (cream, ochre).
+G_WHITE, G_LIGHT, G_MID, G_HATCH, G_STONE, G_DARK, G_DEEP, G_CREAM, G_OCHRE = 1, 2, 3, 4, 5, 6, 7, 8, 9
+# A bollard (palette 3, upper layer) and a railing's two runs: along a cell's
+# north or south edge (front view) and along its west or east edge (from
+# above, posts every 4 px). Digits are palette indices; '.' is transparent.
+BOLLARD = ("........", "........", "..6226..", "..6556..", "..6896..", "..6556..", "..6556..", "...77...")
+RAIL_H = ("........", "22222222", "55555555", ".4...4..", ".4...4..", ".5...5..", "66666666", "........")
+RAIL_V = (".25.....", ".25.....", "6256....", ".25.....", ".25.....", ".25.....", "6256....", ".25.....")
+
+
+def pattern(rows):
+    return grid([[0 if c == "." else int(c, 16) for c in row] for row in rows])
+
+# A car seen from above, front at the bottom: o outline, b body, h roof,
+# g glass, l lamps; '.' is transparent. 10 px wide and 14 long, drawn in the
+# middle of a 16 px lane on the upper layer, so one drawing serves every
+# lane and every palette with these index roles.
+CAR = (".oooooooo.", "obbbbbbbbo", "obggggggbo", "obbbbbbbbo", "obhhhhhhbo", "obhhhhhhbo", "obhhhhhhbo",
+       "obhhhhhhbo", "obbbbbbbbo", "oggggggggo", "obggggggbo", "obbbbbbbbo", "olbbbbbblo", ".oooooooo.")
+CAR_INDEX = {"o": 14, "b": 13, "h": 12, "g": 2, "l": 1, ".": 0}
+CAR_PALETTES = {"red": 2, "blue": 3, "maroon": 1}
+
+
+def car_tiles():
+    """Southbound car, top-left and bottom-left quarters (the right half is
+    the left half mirrored)."""
+    cell = [[0] * 16 for _ in range(16)]
+    for r, line in enumerate(CAR):
+        for c, ch in enumerate(line):
+            cell[1 + r][3 + c] = CAR_INDEX[ch]
+    return grid([row[:8] for row in cell[:8]]), grid([row[:8] for row in cell[8:]])
+
+
+def tiles():
+    """{name: 8x8 palette-index grid}, in slot order."""
+    out = {}
+    # Highway in palette 5, west half of a north-south highway; columns are
+    # 16 px lanes. Guard rail on the outer edge (posts, rail, white line),
+    # white lane dashes 12 px long on the lane boundaries, and one line of
+    # the double yellow median.
+    out["hw-lane"] = uniform(LANE)
+    out["hw-rail-ns"] = drawn(lambda x, y: (GREY if 2 <= y <= 4 else PALE) if x == 0 else PALE if x == 1 else WHITE if x == 2 else LANE)
+    out["hw-dash-ns"] = drawn(lambda x, y: WHITE if x >= 6 and y >= 2 else LANE)
+    out["hw-yellow-ns"] = drawn(lambda x, y: YELLOW if x in (5, 6) else LANE)
+    for name in ("rail", "dash", "yellow"):
+        out[f"hw-{name}-ew"] = transpose(out[f"hw-{name}-ns"])
+
+    # Overpass: the deck's south kerb with parapet posts every 4 px, and the
+    # deck's shadow (palette 1, upper layer) fading out in a dithered band
+    # over the lanes below.
+    out["hw-parapet-ew"] = drawn(lambda x, y: LANE if y < 5 else GREY if x % 4 == 0 else WHITE if y == 5 else PALE)
+    out["hw-shadow-n"] = drawn(lambda x, y: P_DARK if y < 6 or (x + y) % 2 == 0 else 0)
+    out["hw-car-top"], out["hw-car-bottom"] = car_tiles()
+    out["hw-car-left"], out["hw-car-right"] = transpose(out["hw-car-top"]), transpose(out["hw-car-bottom"])
+    # Abutment block (palette 3), symmetric about the diagonal so it serves both highways.
+    out["hw-abutment"] = grid([[2 if min(x, y) == 0 else 6 if max(x, y) == 7 else
+                                3 if (x + y) % 4 else 4 for x in range(8)] for y in range(8)])
+    # Streets in palette 5, pixel for pixel Xitun's: the centre dash is 2 px
+    # wide and 10 long in the middle of the cell, the crosswalk four 2 px
+    # bars 12 px long.
+    out["st-asphalt"] = uniform(ASPHALT)
+    out["st-dash-ns"] = drawn(lambda x, y: YELLOW if x == 7 and y >= 3 else ASPHALT)
+    out["st-dash-ew"] = transpose(out["st-dash-ns"])
+    out["st-crosswalk-ew"] = drawn(lambda x, y: WHITE if x in (1, 2, 5, 6) and y >= 2 else ASPHALT)
+    out["st-crosswalk-ns"] = transpose(out["st-crosswalk-ew"])
+    # Water overlays in palette 3: channel walls along a side, around an
+    # outer corner (land on two sides) and an inner corner (land diagonal).
+    out["wa-bank-h"] = grid([[BANK[y]] * 8 for y in range(8)])
+    out["wa-bank-v"] = transpose(out["wa-bank-h"])
+    out["wa-bank-outer"] = grid([[BANK[min(x, y)] for x in range(8)] for y in range(8)])
+    out["wa-bank-inner"] = grid([[BANK[max(x, y)] for x in range(8)] for y in range(8)])
+    # Road bridge parapet (palette 1) on the outer half of a sidewalk cell:
+    # shadow on the water side, stone, the white coping, its inner face.
+    parapet = (P_DARK, P_STONE, P_TOP, P_TOP, P_FACE, P_LIGHT, P_LIGHT, P_FACE)
+    out["br-rail-v"] = drawn(lambda x, y: P_STONE if x in (2, 3) and y == 0 else parapet[x])
+    out["br-rail-h"] = transpose(out["br-rail-v"])
+    # Path bridge (palette 1): boards across the walking direction, a wooden rail.
+    planks = [W_GAP if y % 4 == 3 else W_HIGH if y % 4 == 0 else W_BOARD for y in range(8)]
+    out["pb-planks-ns"] = grid([[planks[y]] * 8 for y in range(8)])
+    out["pb-planks-ew"] = transpose(out["pb-planks-ns"])
+    out["pb-rail-v"] = grid([[(W_EDGE, W_RAIL_DARK if y == 0 else W_RAIL, W_RAIL_DARK if y == 0 else W_HIGH, W_GAP)[x]
+                              if x < 4 else planks[y] for x in range(8)] for y in range(8)])
+    out["pb-rail-h"] = transpose(out["pb-rail-v"])
+    # Retaining wall on the highway's city side. Its face is the abutment block
+    # under the road bridge parapet's coping, so only the foot is new: a half
+    # course over a dark base (palette 3). The west wall's shadow falls on its
+    # planted bank (palette 1, upper layer, transparent beyond).
+    block = lambda x, y: G_LIGHT if min(x, y) == 0 else G_DARK if max(x, y) == 7 else G_MID if (x + y) % 4 else G_HATCH
+    out["wall-foot"] = drawn(lambda x, y: G_DEEP if y >= 5 else G_DARK if y == 4 else block(x, y))
+    out["wall-shadow-w"] = drawn(lambda x, y: P_DARK if x < 2 or (x < 4 and (x + y) % 2 == 0) else 0)
+
+    # Culvert arch (palette 1): the top-left quarter of a semicircular opening
+    # 16 px wide, a one-pixel ring of light stones, the face beyond; the dark
+    # inside matches the under-deck shadow tile below it.
+    def arch(x, y):
+        d = ((x + 0.5 - 8) ** 2 + (y + 0.5 - 8) ** 2) ** 0.5
+        if d < 7:
+            return P_DARK
+        if d < 8.2:
+            return P_TOP
+        if d < 9:
+            return 8
+        return P_LIGHT if min(x, y) == 0 else 3
+    out["wall-arch"] = drawn(arch)
+    out["st-bollard"] = pattern(BOLLARD)
+    out["st-rail-h"] = pattern(RAIL_H)
+    out["st-rail-v"] = pattern(RAIL_V)
+    return out
+
+
+class Ref:
+    """One quadrant: a kit tile name, an absolute primary tile, or blank."""
+    def __init__(self, tile, palette=0, h=False, v=False):
+        self.tile, self.palette, self.h, self.v = tile, palette, h, v
+
+    def flip(self, h=False, v=False):
+        return Ref(self.tile, self.palette, self.h ^ h, self.v ^ v)
+
+    def word(self, slots):
+        if self.tile is None:
+            return 0
+        index = slots[self.tile] if isinstance(self.tile, str) else self.tile
+        return index | (self.h << 10) | (self.v << 11) | (self.palette << 12)
+
+
+BLANK = Ref(None)
+# The 0x175 paving's quadrants (tiles 0x152, 0x153, 0x162, 0x163 in palette 1).
+PAVING = [Ref(0x152, 1), Ref(0x153, 1), Ref(0x162, 1), Ref(0x163, 1)]
+SHADOW = Ref("hw-lane", 1)
+
+
+def rot(quads):
+    """A metatile layer turned 180 degrees."""
+    tl, tr, bl, br = quads
+    return [br.flip(True, True), bl.flip(True, True), tr.flip(True, True), tl.flip(True, True)]
+
+
+def under_w(quads):
+    """The west half in the shadow of a north-south highway deck."""
+    return [SHADOW, quads[1], SHADOW, quads[3]]
+
+
+def under_n(quads):
+    """The north half in the shadow of an east-west highway deck."""
+    return [SHADOW, SHADOW, quads[2], quads[3]]
+
+
+def metatiles():
+    """Ordered [(name, bottom, top, attribute)]; IDs follow this order from
+    FIRST_METATILE, and new pieces are only ever appended."""
+    out = []
+
+    def add(name, bottom, top=None, covered=False):
+        out.append((name, list(bottom), list(top or [BLANK] * 4), COVERED if covered else 0))
+
+    def h(name):
+        return Ref(name, 5)
+
+    lane = h("hw-lane")
+    # Highway. Lanes 0-5 run west to east (north-south highway) or north to
+    # south (east-west); 0 and 5 carry the guard rails, 2|3 the median.
+    rail, dash, yellow = h("hw-rail-ns"), h("hw-dash-ns"), h("hw-yellow-ns")
+    half = [[rail, dash, rail, dash.flip(v=True)], [lane, dash, lane, dash.flip(v=True)], [lane, yellow, lane, yellow]]
+    columns = half + [rot(q) for q in reversed(half)]
+    rail_e, dash_e, yellow_e = h("hw-rail-ew"), h("hw-dash-ew"), h("hw-yellow-ew")
+    half = [[rail_e, rail_e, dash_e, dash_e.flip(h=True)], [lane, lane, dash_e, dash_e.flip(h=True)], [lane, lane, yellow_e, yellow_e]]
+    rows = half + [rot(q) for q in reversed(half)]
+    for i, quads in enumerate(columns):
+        add(f"hw-ns-{i}", quads)
+    for i, quads in enumerate(rows):
+        add(f"hw-ew-{i}", quads)
+    # Overpass where the highways meet: the east-west highway's south lane
+    # with the parapet over the north-south highway, and the north-south
+    # lanes' first row under the deck in its shadow. These take the IDs of
+    # the merged corner square they replace; its last six IDs are retired
+    # (left as the base primary has them), so no later ID moves.
+    parapet, shadow = h("hw-parapet-ew"), Ref("hw-shadow-n", 1)
+    add("hw-ew-5-parapet", rows[5][:2] + [parapet, parapet])
+    for i, quads in enumerate(columns):
+        add(f"hw-ns-{i}-under-n", quads, [shadow, shadow, BLANK, BLANK], covered=True)
+    out.extend([(None, [BLANK] * 4, [BLANK] * 4, 0)] * 6)
+    # Cars keep right: lanes 0-2 of the north-south highway go south, 3-5
+    # north; lanes 0-2 of the east-west highway go west, 3-5 east.
+    for color, palette in CAR_PALETTES.items():
+        top, bottom = Ref("hw-car-top", palette), Ref("hw-car-bottom", palette)
+        south = [top, top.flip(h=True), bottom, bottom.flip(h=True)]
+        left, right = Ref("hw-car-left", palette), Ref("hw-car-right", palette)
+        east = [left, right, left.flip(v=True), right.flip(v=True)]
+        for i in range(6):
+            add(f"hw-ns-{i}-car-{color}", columns[i], south if i < 3 else rot(south), covered=True)
+        for i in range(6):
+            add(f"hw-ew-{i}-car-{color}", rows[i], rot(east) if i < 3 else east, covered=True)
+
+    def s(name):
+        return Ref(name, 5)
+    asphalt, xw_ew, xw_ns = s("st-asphalt"), s("st-crosswalk-ew"), s("st-crosswalk-ns")
+    dash_ns, dash_ew = s("st-dash-ns"), s("st-dash-ew")
+    streets = {
+        "st-asphalt": [asphalt] * 4,
+        "st-ns-centre": [dash_ns, dash_ns.flip(h=True), dash_ns.flip(v=True), dash_ns.flip(True, True)],
+        "st-ew-centre": [dash_ew, dash_ew.flip(h=True), dash_ew.flip(v=True), dash_ew.flip(True, True)],
+        "st-ns-crosswalk": [xw_ns, xw_ns.flip(h=True), xw_ns, xw_ns.flip(h=True)],
+        "st-ew-crosswalk": [xw_ew, xw_ew, xw_ew.flip(v=True), xw_ew.flip(v=True)],
+    }
+    for name, quads in streets.items():
+        add(name, quads)
+    # Overpass: an east-west street passing under the north-south highway
+    # (first cell east of it) and a north-south street under the east-west one.
+    add("st-ew-sidewalk-under-w", under_w(PAVING))
+    add("st-ew-asphalt-under-w", under_w(streets["st-asphalt"]))
+    add("st-ew-centre-under-w", under_w(streets["st-ew-centre"]))
+    add("st-ns-sidewalk-under-n", under_n(PAVING))
+    add("st-ns-asphalt-under-n", under_n(streets["st-asphalt"]))
+    add("st-ns-centre-under-n", under_n(streets["st-ns-centre"]))
+    # Road bridge: the asphalt cells stay as they are; each sidewalk cell
+    # becomes paving with a parapet on its outer half.
+    rail_v, rail_h = Ref("br-rail-v", 1), Ref("br-rail-h", 1)
+    add("br-ns-sidewalk-w", [rail_v, PAVING[1], rail_v, PAVING[3]])
+    add("br-ns-sidewalk-e", [PAVING[0], rail_v.flip(h=True), PAVING[2], rail_v.flip(h=True)])
+    add("br-ew-sidewalk-n", [rail_h, rail_h, PAVING[2], PAVING[3]])
+    add("br-ew-sidewalk-s", [PAVING[0], PAVING[1], rail_h.flip(v=True), rail_h.flip(v=True)])
+    # Path bridge (palette 1).
+    for axis, flip in (("ns", "h"), ("ew", "v")):
+        deck, rail = Ref(f"pb-planks-{axis}", 1), Ref(f"pb-rail-{'v' if axis == 'ns' else 'h'}", 1)
+        other = rail.flip(**{flip: True})
+        sides = ("w", "e") if axis == "ns" else ("n", "s")
+        if axis == "ns":
+            add(f"pb-{axis}", [deck] * 4)
+            add(f"pb-{axis}-{sides[0]}", [rail, deck, rail, deck])
+            add(f"pb-{axis}-{sides[1]}", [deck, other, deck, other])
+            add(f"pb-{axis}-single", [rail, other, rail, other])
+        else:
+            add(f"pb-{axis}", [deck] * 4)
+            add(f"pb-{axis}-{sides[0]}", [rail, rail, deck, deck])
+            add(f"pb-{axis}-{sides[1]}", [deck, deck, other, other])
+            add(f"pb-{axis}-single", [rail, rail, other, other])
+    # Water: General's animated field below, the channel overlay above.
+    bank_h, bank_v = Ref("wa-bank-h", 3), Ref("wa-bank-v", 3)
+    bo, bi = Ref("wa-bank-outer", 3), Ref("wa-bank-inner", 3)
+    abut = Ref("hw-abutment", 3)
+    B = BLANK
+    shapes = {
+        "body": [B, B, B, B],
+        "bank-n": [bank_h, bank_h, B, B], "bank-s": [B, B, bank_h.flip(v=True), bank_h.flip(v=True)],
+        "bank-w": [bank_v, B, bank_v, B], "bank-e": [B, bank_v.flip(h=True), B, bank_v.flip(h=True)],
+        "outer-nw": [bo, bank_h, bank_v, B], "outer-ne": [bank_h, bo.flip(h=True), B, bank_v.flip(h=True)],
+        "outer-sw": [bank_v, B, bo.flip(v=True), bank_h.flip(v=True)],
+        "outer-se": [B, bank_v.flip(h=True), bank_h.flip(v=True), bo.flip(True, True)],
+        "inner-nw": [bi, B, B, B], "inner-ne": [B, bi.flip(h=True), B, B],
+        "inner-sw": [B, B, bi.flip(v=True), B], "inner-se": [B, B, B, bi.flip(True, True)],
+    }
+    canal = {
+        "canal-ns": [bank_v, bank_v.flip(h=True), bank_v, bank_v.flip(h=True)],
+        "canal-ew": [bank_h, bank_h, bank_h.flip(v=True), bank_h.flip(v=True)],
+        "canal-ne": [bank_v, bi.flip(h=True), bo.flip(v=True), bank_h.flip(v=True)],
+        "canal-nw": [bi, bank_v.flip(h=True), bank_h.flip(v=True), bo.flip(True, True)],
+        "canal-se": [bo, bank_h, bank_v, bi.flip(True, True)],
+        "canal-sw": [bank_h, bo.flip(h=True), bi.flip(v=True), bank_v.flip(h=True)],
+        "canal-t-n": [bank_h, bank_h, bi.flip(v=True), bi.flip(True, True)],
+        "canal-t-s": [bi, bi.flip(h=True), bank_h.flip(v=True), bank_h.flip(v=True)],
+        "canal-t-w": [bank_v, bi.flip(h=True), bank_v, bi.flip(True, True)],
+        "canal-t-e": [bi, bank_v.flip(h=True), bi.flip(v=True), bank_v.flip(h=True)],
+        "canal-x": [bi, bi.flip(h=True), bi.flip(v=True), bi.flip(True, True)],
+        "mouth-n": [bi, bi.flip(h=True), B, B], "mouth-s": [B, B, bi.flip(v=True), bi.flip(True, True)],
+        "mouth-w": [bi, B, bi.flip(v=True), B], "mouth-e": [B, bi.flip(h=True), B, bi.flip(True, True)],
+    }
+    under = {
+        "east": {"body-under-w": [SHADOW, B, SHADOW, B], "bank-n-abut-w": [abut, bank_h, abut, B],
+                 "bank-s-abut-w": [abut, B, abut, bank_h.flip(v=True)]},
+        "north": {"body-under-n": [SHADOW, SHADOW, B, B], "bank-w-abut-n": [abut, abut, bank_v, B],
+                  "bank-e-abut-n": [abut, abut, B, bank_v.flip(h=True)]},
+    }
+    under["west"], under["south"] = under["east"], under["north"]
+    for kind, (first, palette) in WATER.items():
+        field = [Ref(first + i, palette) for i in range(4)]
+        pieces = dict(shapes)
+        if kind in FLOWING:
+            pieces.update(canal)
+            pieces.update(under[kind])
+        for shape, top in pieces.items():
+            add(f"wa-{kind}-{shape}", field, top, covered=shape != "body")
+    # Retaining wall. North wall (rows 1-2 of the world): upper is the coping
+    # over a block course, lower a block course over the foot. West wall
+    # (columns 1-2): blocks on top, then its shadow on the planted bank. The
+    # inner corner is the west wall's top running up to the highway beside the
+    # north wall's face; over the south river the top carries on as the
+    # bridge side, beside wa-<flow>-body-under-w.
+    coping, block, foot = Ref("br-rail-h", 1), Ref("hw-abutment", 3), Ref("wall-foot", 3)
+    leaf = [Ref(tile, 0) for tile in LEAF_TILES]
+    add("wall-n-upper", [coping, coping, block, block])
+    add("wall-n-lower", [block, block, foot, foot])
+    add("wall-w-top", [block] * 4)
+    shade = Ref("wall-shadow-w", 1)
+    add("wall-w-bank", leaf, [shade, B, shade, B])
+    # Culvert where a south-flowing channel two cells wide leaves the north
+    # wall: the arch in the upper row, the dark opening and the water running
+    # out of it (General's south field, in its field position) in the lower.
+    arch, south = Ref("wall-arch", 1), [Ref(WATER["south"][0] + i, WATER["south"][1]) for i in range(4)]
+    add("wall-culvert-nw", [coping, coping, block, arch])
+    add("wall-culvert-ne", [coping, coping, arch.flip(h=True), block])
+    add("wall-culvert-sw", [block, SHADOW, foot, south[3]])
+    add("wall-culvert-se", [SHADOW, block, south[2], foot])
+    # Street ends: the sidewalk paving with two bollards on the side the
+    # asphalt comes from (st-bollards-n ends a street that runs in from the
+    # north). Below the player, who walks between them.
+    post = Ref("st-bollard", 3)
+    add("st-bollards-n", PAVING, [post, post, B, B], covered=True)
+    add("st-bollards-s", PAVING, [B, B, post, post], covered=True)
+    add("st-bollards-w", PAVING, [post, B, post, B], covered=True)
+    add("st-bollards-e", PAVING, [B, post, B, post], covered=True)
+    # Railing on a sidewalk cell whose side (or two sides) meets water. A
+    # railing on a south edge stands in front of the player; the rest lie
+    # below.
+    run, side = Ref("st-rail-h", 3), Ref("st-rail-v", 3)
+    rails = {"n": [run, run, B, B], "s": [B, B, run, run], "w": [side, B, side, B], "e": [B, side.flip(h=True), B, side.flip(h=True)],
+             "nw": [run, run, side, B], "ne": [run, run, B, side.flip(h=True)],
+             "sw": [side, B, run, run], "se": [B, side.flip(h=True), run, run]}
+    for edge, top in rails.items():
+        add(f"st-rail-{edge}", PAVING, top, covered="s" not in edge)
+    # Inner corner, where water touches only the cell's corner (a canal ending
+    # at a crossing sidewalk): a run in that quadrant joins the side rail of
+    # the walk beside the canal to the run across its end.
+    for q, corner in enumerate(("nw", "ne", "sw", "se")):
+        top = [B] * 4
+        top[q] = run
+        add(f"st-rail-inner-{corner}", PAVING, top, covered=corner[0] == "n")
+    return out
+
+
+def palettes():
+    out = []
+    for p in range(16):
+        lines = (PRIMARY_PALETTES / f"{p:02}.pal").read_text().splitlines()[3:]
+        out.append([tuple(map(int, line.split())) for line in lines if line.strip()])
+    return out
+
+
+def ids():
+    return {name: FIRST_METATILE + i for i, (name, *_) in enumerate(metatiles()) if name}
+
+
+def slots():
+    return {name: TILE_SLOTS[i] for i, name in enumerate(tiles())}
+
+
+def encoded():
+    """[(metatile ID, eight words, attribute)] for the installer and guard."""
+    where = slots()
+    return [(FIRST_METATILE + i, [ref.word(where) for ref in bottom + top], attribute)
+            for i, (name, bottom, top, attribute) in enumerate(metatiles()) if name]
+
+
+def renderer(primary_png):
+    """{kit name or 'sidewalk'/'grass': 16x16 RGB image}, drawn from the art
+    and the primary sheet (for previews; the game draws from the bank)."""
+    from PIL import Image
+    sheet = Image.open(primary_png)
+    pals = palettes()
+    art = tiles()
+
+    def pixels(ref):
+        if isinstance(ref.tile, str):
+            t = art[ref.tile]
+            get = lambda x, y: t[y][x]
+        else:
+            n = ref.tile or 0
+            get = lambda x, y: sheet.getpixel((n % 16 * 8 + x, n // 16 * 8 + y))
+        return [[get(7 - x if ref.h else x, 7 - y if ref.v else y) for x in range(8)] for y in range(8)]
+
+    def draw(bottom, top):
+        image = Image.new("RGB", (16, 16))
+        for layer, quads in enumerate((bottom, top)):
+            for q, ref in enumerate(quads):
+                if layer and ref.tile is None:
+                    continue
+                px = pixels(ref)
+                for y in range(8):
+                    for x in range(8):
+                        if px[y][x] or not layer:
+                            image.putpixel((q % 2 * 8 + x, q // 2 * 8 + y), pals[ref.palette][px[y][x]])
+        return image
+
+    rendered = {name: draw(b, t) for name, b, t, _ in metatiles() if name}
+    rendered["sidewalk"] = draw(PAVING, [BLANK] * 4)
+    rendered["grass"] = draw([Ref(0x26E, 0), Ref(0x26F, 0), Ref(0x24C, 0), Ref(0x24D, 0)], [BLANK] * 4)
+    return rendered
+
+
+def preview(directory, primary_png):
+    """Render the kit atlas and a demo scene into directory."""
+    from PIL import Image, ImageDraw
+    rendered = renderer(primary_png)
+    directory.mkdir(parents=True, exist_ok=True)
+    names = [name for name, *_ in metatiles() if name]
+    cols, cell = 12, 40
+    atlas = Image.new("RGB", (cols * (cell + 112), (len(names) + cols - 1) // cols * (cell + 6)), "#f2f2e8")
+    d = ImageDraw.Draw(atlas)
+    for i, name in enumerate(names):
+        x, y = i % cols * (cell + 112), i // cols * (cell + 6)
+        atlas.paste(rendered[name].resize((cell, cell), Image.NEAREST), (x, y))
+        d.text((x + cell + 3, y + 4), f"{FIRST_METATILE + i:03x}", fill="#222")
+        d.text((x + cell + 3, y + 18), name[:19], fill="#444")
+    atlas.save(directory / "city-kit-atlas.png")
+    cells, width, height = demo()
+    scene = Image.new("RGB", (width * 16, height * 16))
+    for y in range(height):
+        for x in range(width):
+            scene.paste(rendered[cells.get((x, y), "grass")], (x * 16, y * 16))
+    scene.resize((scene.width * 3, scene.height * 3), Image.NEAREST).save(directory / "city-kit-demo.png")
+    return rendered
+
+
+def demo():
+    """A small district laid out from kit names only: the highway overpass,
+    a street crossing, overpasses, a river under the highway with a
+    road bridge, a two-wide canal with a path bridge and its mouth, and a
+    pond. 'sidewalk' is the 0x175 paving; unnamed cells are grass."""
+    width, height = 40, 30
+    cells = {}
+
+    def put(x, y, name):
+        cells[(x, y)] = name
+
+    for y in range(6, height):
+        for i in range(6):
+            car = {1: "red", 4: "blue", 2: "maroon", 3: "red"}.get(i)
+            put(i, y, f"hw-ns-{i}-car-{car}" if car and y % 7 == (2 + i) % 7 else f"hw-ns-{i}")
+    for x in range(width):
+        for i in range(6):
+            car = {0: "blue", 1: "red", 4: "maroon", 5: "blue"}.get(i)
+            put(x, i, f"hw-ew-{i}-car-{car}" if car and x % 9 == (3 + 2 * i) % 9 else f"hw-ew-{i}")
+    for x in range(6):
+        put(x, 5, "hw-ew-5-parapet")
+        put(x, 6, f"hw-ns-{x}-under-n")
+    # East-west street: sidewalk row 11, asphalt 12-14 (centre 13), sidewalk 15.
+    profile_ew = ("sidewalk", "st-asphalt", "st-ew-centre", "st-asphalt", "sidewalk")
+    for x in range(6, width):
+        for i, name in enumerate(profile_ew):
+            under = {"sidewalk": "st-ew-sidewalk-under-w", "st-asphalt": "st-ew-asphalt-under-w",
+                     "st-ew-centre": "st-ew-centre-under-w"}[name]
+            put(x, 11 + i, under if x == 6 else name)
+    # North-south street: sidewalk column 19, asphalt 20-22 (centre 21), sidewalk 23.
+    profile_ns = ("sidewalk", "st-asphalt", "st-ns-centre", "st-asphalt", "sidewalk")
+    for y in range(6, height):
+        for i, name in enumerate(profile_ns):
+            under = {"sidewalk": "st-ns-sidewalk-under-n", "st-asphalt": "st-ns-asphalt-under-n",
+                     "st-ns-centre": "st-ns-centre-under-n"}[name]
+            put(19 + i, y, under if y == 6 else name)
+    # The crossing: asphalt core, crosswalks where a sidewalk line crosses asphalt.
+    for x in range(20, 23):
+        for y in range(12, 15):
+            put(x, y, "st-asphalt")
+        put(x, 11, "st-ns-crosswalk"); put(x, 15, "st-ns-crosswalk")
+    for y in range(12, 15):
+        put(19, y, "st-ew-crosswalk"); put(23, y, "st-ew-crosswalk")
+    for x, y in ((19, 11), (23, 11), (19, 15), (23, 15)):
+        put(x, y, "sidewalk")
+    # An east-flowing river under the highway, four cells wide, with a road bridge.
+    for x in range(6, width):
+        top, bottom = ("bank-n-abut-w", "bank-s-abut-w") if x == 6 else ("bank-n", "bank-s")
+        put(x, 24, f"wa-east-{top}"); put(x, 27, f"wa-east-{bottom}")
+        for y in (25, 26):
+            put(x, y, "wa-east-body-under-w" if x == 6 else "wa-east-body")
+    for y in range(24, 28):
+        put(19, y, "br-ns-sidewalk-w"); put(23, y, "br-ns-sidewalk-e")
+        for i, name in enumerate(profile_ns[1:4]):
+            put(20 + i, y, name)
+    # A two-wide canal from the east turns south and joins the river.
+    for x in range(34, width):
+        put(x, 17, "wa-west-bank-n"); put(x, 18, "wa-west-bank-s")
+    put(32, 17, "wa-south-outer-nw"); put(33, 17, "wa-south-bank-n")
+    put(32, 18, "wa-south-bank-w"); put(33, 18, "wa-south-inner-se")
+    for y in range(19, 24):
+        put(32, y, "wa-south-bank-w"); put(33, y, "wa-south-bank-e")
+    put(32, 24, "wa-east-inner-nw"); put(33, 24, "wa-east-inner-ne")
+    for x in (28, 29, 30, 31, 34, 35, 36):
+        put(x, 21, "sidewalk")
+    put(32, 21, "pb-ew-single"); put(33, 21, "pb-ew-single")
+    # A still pond with banks.
+    x0, y0, x1, y1 = 9, 17, 15, 21
+    for y in range(y0, y1 + 1):
+        for x in range(x0, x1 + 1):
+            v = "n" if y == y0 else "s" if y == y1 else ""
+            h = "w" if x == x0 else "e" if x == x1 else ""
+            shape = f"outer-{v}{h}" if v and h else f"bank-{v or h}" if v or h else "body"
+            put(x, y, f"wa-still-{shape}")
+    return cells, width, height
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--preview", type=Path, required=True)
+    args = parser.parse_args()
+    art = tiles()
+    assert len(art) <= len(TILE_SLOTS)
+    print(len(art), "tiles,", len(ids()), "metatiles")
+    preview(args.preview, ROOT / "data/tilesets/primary/taichung_xitun_private/tiles.png")
+    print(args.preview)
