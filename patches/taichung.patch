+static const struct SavedPositionRelocation sOldCityV1Relocations[] =
+{
+    {26, 61, 30, 66},
+    {26, 62, 30, 66},
+    {26, 63, 30, 66},
+    {26, 64, 30, 66},
+    {31, 57, 30, 66},
